package testpkg

import "fmt"
import "os"

const maxSize = 1024

type Point struct {
	X, Y int32
}

type Stringer interface {
	String() string
}

var globalCounter int32

func add(a, b int32) int32 {
	return a + b
}

func (p *Point) String() string {
	return fmt.Sprintf("(%d, %d)", p.X, p.Y)
}

func main() {
	p := &Point{X: 1, Y: 2}
	fmt.Println(p.String())
	os.Exit(0)
}
