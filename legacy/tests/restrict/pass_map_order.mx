package main

func main() {
	m := map[string]int32{}
	m["charlie"] = 3
	m["alpha"] = 1
	m["bravo"] = 2

	// Deterministic map iteration: sorted ascending by key.
	keys := ""
	for k := range m {
		if len(keys) > 0 {
			keys = keys | ","
		}
		keys = keys | k
	}
	if keys == "alpha,bravo,charlie" {
		println("PASS: deterministic map order")
	} else {
		println("FAIL: deterministic map order, got: " | keys)
	}
}
