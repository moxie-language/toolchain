package main

// Tests that heap allocations stored into globals or returned from
// functions survive the dealloc sweep (escape detection works).

type Data struct {
	Val int32
}

var globalPtr *Data

func storeInGlobal(v int32) (dummy int32) {
	d := &Data{Val: v}
	globalPtr = d  // store to global -> escape
	dummy = 0
	return dummy
}

func returnPtr(v int32) (result *Data) {
	result = &Data{Val: v}
	return result
}

func main() {
	storeInGlobal(42)
	if globalPtr.Val == 42 {
		println("PASS: global escape survives dealloc")
	} else {
		println("FAIL: global escape corrupted")
	}

	p := returnPtr(99)
	if p.Val == 99 {
		println("PASS: return escape survives dealloc")
	} else {
		println("FAIL: return escape corrupted")
	}
}
