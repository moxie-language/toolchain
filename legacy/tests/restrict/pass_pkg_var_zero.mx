package main

// Tests that zero-value package vars are accessible.
// Package globals are immutable after init(); main package has no init().
// Zero-value vars can be read but not written outside init().

var x int32

func main() {
	if x == 0 {
		println("PASS: zero-value var is zero")
	} else {
		println("FAIL: zero-value var is not zero")
	}
}
