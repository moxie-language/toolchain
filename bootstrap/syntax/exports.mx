		return 0
	}
	d, ok := f.DeclList[idx].(*FuncDecl)
	if !ok || d.Name == nil {
		return 0
	}
	return copyOut(out, cap, d.Name.Value)
}

//export moxie_file_func_has_body
func moxie_file_func_has_body(h int32, idx int32) int32 {
	f := getFile(h)
	if f == nil || idx < 0 || int(idx) >= len(f.DeclList) {
		return 0
	}
	d, ok := f.DeclList[idx].(*FuncDecl)
	if !ok {
		return 0
	}
	if d.Body != nil {
		return 1
	}
	return 0
}

