package main

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"git.smesh.lol/moxie/pkg/syntax"
	"git.smesh.lol/moxie/pkg/token"
	. "git.smesh.lol/moxie/pkg/types"
)

// checkUseAfterFree: no-op in arena model.
func checkUseAfterFree(f *SSAFunction) {}

func strContains(s, sub string) (ok bool) {
	if len(sub) == 0 {
		return true
	}
	n := int32(len(sub))
	for i := int32(0); i+n <= int32(len(s)); i++ {
		if s[i:i+n] == sub {
			return true
		}
	}
	return false
}

// targetIsMoxieModule reports whether the package being compiled belongs to
// the moxie compiler's own module. Legacy reads this from the target package's
// module (restrict.go isUserPackage: b.pkgModulePath == "git.smesh.lol/moxie").
// The resolved build module cannot stand in for it: a target outside any module
// falls back to MOXIEROOT so that its imports resolve, and inheriting that
// fallback would exempt every out-of-tree user package from the restrictions.
func targetIsMoxieModule() (ok bool) {
	if bst == nil {
		return false
	}
	return bst.rootModPrefix == "git.smesh.lol/moxie"
}

// isUserPackagePath mirrors legacy restrict.go isUserPackage: a package is
// subject to Moxie language restrictions if its import path contains a dot
// (user module paths look like domain paths), except golang.org/x/.
//
// Main packages are user code, always. They were exempt when the target lived
// in the moxie module, which meant the compiler's own source was never checked
// by its own rules - and legacy has always checked it (its isUserPackage
// returns true for "main" unconditionally, and the bootstrap builds
// _mxc_stage4 through it).
//
// A leading vendor/ is stripped first. stage4 compiles stdlib-vendored code
// under the path `vendor/golang.org/x/...`, while legacy's go/types reports the
// import path with vendor/ already removed (`golang.org/x/...`), so the
// exemption missed every vendored package here and the language rules fired on
// them - `golang.org/x/crypto/chacha20poly1305` was rejected for unnamed return
// values the moment that rule landed. Normalising reproduces legacy's view.
func isUserPackagePath(path string) (ok bool) {
	if path == "main" || path == "command-line-arguments" {
		return true
	}
	if mxutil.HasPrefix(path, "vendor/") {
		path = path[7:]
	}
	if mxutil.HasPrefix(path, "golang.org/x/") {
		return false
	}
	for i := int32(0); i < int32(len(path)); i++ {
		if path[i] == '.' {
			return true
		}
	}
	return false
}

// hasSlashPkgSegment reports whether path contains the "/pkg/" segment that
// marks the toolchain's own infrastructure packages.
func hasSlashPkgSegment(path string) (ok bool) {
	for i := int32(0); i+4 <= int32(len(path)); i++ {
		if path[i] == '/' && path[i+1] == 'p' && path[i+2] == 'k' && path[i+3] == 'g' && path[i+4] == '/' {
			return true
		}
	}
	return false
}

// targetIsMainModule reports whether the build target is a program of its own
// rather than the toolchain. Legacy marks the input package's module as Main
// whether or not a manifest exists (loader.go: `if p.Module.Main &&
// p.Module.Path != "git.smesh.lol/moxie"`), so the gate here is the same test
// without a module file: a target that is not the toolchain is the main module.
func targetIsMainModule() (ok bool) {
	if bst == nil {
		return false
	}
	return bst.rootModPrefix != "git.smesh.lol/moxie"
}

// isTargetPkg reports whether a package being compiled is the build target or
// belongs to the repository the target lives in. The '+' text rule applies
// there and nowhere else: a dependency from another repository keeps '+', as
// it does under legacy's Module.Main gate.
func isTargetPkg(pkgPath string) (ok bool) {
	if bst == nil || pkgPath == "" {
		return false
	}
	if pkgPath == bst.targetPkgPath {
		return true
	}
	rp := bst.rootModPrefix
	if rp == "" || rp == "git.smesh.lol/moxie" {
		return false
	}
	return mxutil.HasPrefix(pkgPath, rp|"/")
}

// checkNamedReturns mirrors legacy restrict.go checkASTRestrictions: every
// return value in user code must be named. An unnamed result has no slot the
// relocation pass can write back through, and legacy has always rejected one.
// Same gate, same message, so a function shaped this way fails in both
// compilers rather than only in the bootstrap.
func checkNamedReturns(d *syntax.FuncDecl, pkgPath string) {
	if d == nil || d.Type == nil || d.Name == nil {
		return
	}
	// Compiler-generated builtins are exempt, exactly as in legacy.
	if mxutil.HasPrefix(d.Name.Value, "__moxie_") {
		return
	}
	if !isUserPackagePath(restrictPath(pkgPath)) {
		return
	}
	for _, r := range d.Type.ResultList {
		if r.Name == nil {
			cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
			push(cctx.compileErrors, d.Name.Value | ": unnamed return values are not allowed: name all return values")
			return
		}
	}
}

// checkParenCallTarget mirrors legacy restrict.go checkASTRestrictions:
// `(f)(x)` is not valid Moxie, only a parenthesised type in a conversion like
// `(*byte)(x)` is. Legacy exempts exactly the syntactic type forms, so the
// exemption list below is isTypeExpr's.
func checkParenCallTarget(e *syntax.CallExpr, pkgPath string) {
	if e == nil {
		return
	}
	pe, ok := e.Fun.(*syntax.ParenExpr)
	if !ok || syntaxIsTypeExpr(pe.X) {
		return
	}
	if !isUserPackagePath(restrictPath(pkgPath)) {
		return
	}
	cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
	push(cctx.compileErrors, "parenthesized call target is not allowed: write f(x), not (f)(x)")
}

// checkPackageDecls mirrors the two declaration rules of legacy restrict.go
// checkPackageRestrictions: a package-level var may not carry an initializer
// (declare the zero value, assign in init()), and a named slice or map type is
// not allowed (use []T / map[K]V directly). The gate is the same predicate the
// other restriction checks use, so the same package is checked by both
// compilers rather than only in the bootstrap.
//
// A named type may carry methods, and []T directly cannot; that is the whole
// reason the rule has a cost, and the migration that removes the named types
// turns their methods into free functions.
func checkPackageDecls(files []*syntax.File, pkgPath string) {
	if !isUserPackagePath(restrictPath(pkgPath)) {
		return
	}
	for _, f := range files {
		if f == nil {
			continue
		}
		for _, d := range f.DeclList {
			switch t := d.(type) {
			case *syntax.TypeDecl:
				if t.Name == nil || t.Type == nil {
					continue
				}
				// An alias introduces no new named type: `type X = []T` is
				// another spelling of []T, so the rule does not apply to it.
				if t.Alias {
					continue
				}
				switch t.Type.(type) {
				case *syntax.SliceType:
					declErr("named slice type '" | t.Name.Value | "' is not allowed: use []T directly")
				case *syntax.ArrayType:
					if at := t.Type.(*syntax.ArrayType); at.Len == nil {
						declErr("named slice type '" | t.Name.Value | "' is not allowed: use []T directly")
					}
				case *syntax.MapType:
					declErr("named map type '" | t.Name.Value | "' is not allowed: use map[K]V directly")
				}
			case *syntax.VarDecl:
				if t.Values == nil {
					continue
				}
				// legacy's loader demotes a var whose value is a []byte(...)
				// conversion of a string literal to a constant, and its var
				// rule allows that form. Mirroring it keeps the two compilers
				// agreeing on every input rather than only the common one.
				if demotedStringConst(t.Values) {
					continue
				}
				// Name the offending declaration. Without it the build says only
				// "a package-level var has an initializer" and the reader has to
				// bisect the package to find which one - which is what happened
				// to mls, where the answer was two `var x = T("lit")` label vars
				// in a file already edited for other reasons.
				declErr("package-level var '" | varDeclNames(t) | "' with initializer is not allowed: use zero-value declaration and init()")
			}
		}
	}
}

// varDeclNames renders a var declaration's names for a diagnostic.
func varDeclNames(t *syntax.VarDecl) (s string) {
	if t == nil || len(t.NameList) == 0 {
		return "?"
	}
	for i := 0; i < len(t.NameList); i++ {
		if i > 0 {
			s = s | ", "
		}
		if t.NameList[i] != nil {
			s = s | t.NameList[i].Value
		}
	}
	return s
}

func declErr(msg string) {
	cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
	push(cctx.compileErrors, msg)
}

// demotedStringConst reports whether every value of a var declaration is a
// []byte(...) conversion of a string literal, the form legacy's loader demotes
// to a constant. A multi-value declaration arrives as one ListExpr.
func demotedStringConst(values syntax.Expr) (ok bool) {
	if le, isList := values.(*syntax.ListExpr); isList {
		if len(le.ElemList) == 0 {
			return false
		}
		for _, e := range le.ElemList {
			if !demotedStringConst(e) {
				return false
			}
		}
		return true
	}
	call, isCall := values.(*syntax.CallExpr)
	if !isCall {
		return false
	}
	switch ft := call.Fun.(type) {
	case *syntax.SliceType:
	case *syntax.ArrayType:
		if ft.Len != nil {
			return false
		}
	default:
		return false
	}
	if len(call.ArgList) != 1 {
		return false
	}
	return stringLiteralExpr(call.ArgList[0])
}

// stringLiteralExpr reports whether an expression is a string literal, possibly
// joined with + or | and parenthesized. Mirrors legacy's isStringLiteralExpr.
func stringLiteralExpr(e syntax.Expr) (ok bool) {
	switch t := e.(type) {
	case *syntax.BasicLit:
		return t.Kind == token.StringLit
	case *syntax.Operation:
		return (t.Op == token.Add || t.Op == token.Or) && stringLiteralExpr(t.X) && stringLiteralExpr(t.Y)
	case *syntax.ParenExpr:
		return stringLiteralExpr(t.X)
	}
	return false
}

// syntaxIsTypeExpr reports whether an expression is syntactically a type, the
// forms legacy restrict.go isTypeExpr accepts. stage4 splits Go's ArrayType
// into ArrayType and SliceType, so both appear here.
func syntaxIsTypeExpr(e syntax.Expr) (ok bool) {
	switch t := e.(type) {
	case *syntax.Operation:
		return t.Y == nil && t.Op == token.Mul
	case *syntax.ArrayType:
		return true
	case *syntax.SliceType:
		return true
	case *syntax.MapType:
		return true
	case *syntax.ChanType:
		return true
	case *syntax.FuncType:
		return true
	case *syntax.StructType:
		return true
	case *syntax.InterfaceType:
		return true
	}
	return false
}

// restrictPath maps the synthetic main a test build creates back to the package
// it came from. `moxie test` concatenates the package under test and its test
// files into one `package main` so the harness can link them, and that override
// reached the restriction checks: code a normal build compiles as
// `git.smesh.lol/smesh/pkg/nostr/kind` (exempt - the path contains /pkg/) was
// judged as a fresh user `main`, so a package with a lazily initialised global
// (`ensureKinds`, `ensureKindData`) failed to compile in its own test build and
// nowhere else. The restrictions must judge the package by where it came from.
func restrictPath(path string) (r string) {
	if path == "main" && bst != nil && bst.testSrcPkgPath != "" {
		return bst.testSrcPkgPath
	}
	return path
}

// testWrapsLibrary reports whether this compile is the synthetic main a test
// build creates around a package that is not itself a main package. Such a
// wrapper is named main for the linker, but it is a library, so the rules that
// apply to a program's own main package - init() not allowed, no entry point
// other than main - must not fire on it.
func testWrapsLibrary() (ok bool) {
	if bst == nil || bst.testSrcPkgPath == "" {
		return false
	}
	return bst.testSrcPkgPath != "main" && bst.testSrcPkgPath != "command-line-arguments"
}

// ssaGlobalRoot returns the name of the package-level global an address is
// rooted in, or "" if the address is local or goes THROUGH a global pointer.
// Mirrors legacy restrict.go globalName: a global whose type is a pointer is
// not the storage itself - mutations through it land in the pointed-to
// object (heap-local state). Whole-global stores (depth 0) are always flagged.
func ssaGlobalRoot(v SSAValue, depth int32) (s string) {
	if v == nil || depth > 12 {
		return ""
	}
	switch x := v.(type) {
	case *SSAGlobal:
		if depth > 0 {
			// SSAGlobal.typ is always NewPointer(valueType); the real
			// declared type is on the object. A global whose declared
			// type is a pointer is not the storage itself - field/index
			// mutations through it land in the pointed-to object.
			declTyp := x.typ
			if x.object != nil && x.object.Typ != nil {
				declTyp = x.object.Typ
			}
			if _, isPtr := SafeUnderlying(declTyp).(*Pointer); isPtr {
				return ""
			}
		}
		return x.name
	case *SSAFieldAddr:
		return ssaGlobalRoot(x.X, depth+1)
	case *SSAIndexAddr:
		return ssaGlobalRoot(x.X, depth+1)
	case *SSAUnOp:
		return ssaGlobalRoot(x.X, depth+1)
	case *SSAChangeType:
		return ssaGlobalRoot(x.X, depth+1)
	case *SSAConvert:
		return ssaGlobalRoot(x.X, depth+1)
	}
	return ""
}

// isInitFuncName mirrors legacy restrict.go isInitFunc: package initialization
// code may set globals. The prefix rule is legacy's, kept verbatim so both
// compilers accept exactly the same functions - the constructor an app calls
// to build its state lives in the root arena and is named initState/initX.
func isInitFuncName(name string) (ok bool) {
	if name == "init" {
		return true
	}
	// A monomorphized clone carries its DEFINING package as a path prefix and
	// its type arguments as a "__" suffix (crypto_internal_fips140_ecdsa.
	// initP256__). It is still the initializer it was cloned from, so the
	// mangling must not decide whether its stores to package globals are
	// legal - flagging the clone reported the violation against the package
	// the clone was emitted into.
	for i := int32(len(name)) - 1; i >= 0; i-- {
		if name[i] == '.' {
			name = name[i+1:]
			break
		}
	}
	for i := int32(0); i+1 < int32(len(name)); i++ {
		if name[i] == '_' && name[i+1] == '_' {
			name = resize(name, i)
			break
		}
	}
	if name == "init" {
		return true
	}
	return len(name) > 4 && name[:4] == "init"
}

// checkGlobalMutation rejects stores that mutate package-level globals in
// user code. Globals are initialized by __varinit (package var initializers)
// and immutable afterward. Sovereign self-mutating types are mutated through
// their methods (which borrow the receiver's arena); direct stores bypass
// that and are illegal for every global, sovereign or not.
func checkGlobalMutation(f *SSAFunction) {
	if f == nil || f.Blocks == nil || f.Pkg == nil || f.Pkg.Pkg == nil {
		return
	}
	if !isUserPackagePath(restrictPath(f.Pkg.Pkg.Path)) {
		return
	}
	if f.name == "__varinit" || isInitFuncName(f.name) {
		return
	}
	// Library packages without a real main get their package-var
	// initializers injected into a synthetic main; exempt that case.
	if f.name == "main" && f.Pkg.Pkg.Path != "main" {
		return
	}
	checkGlobalStores(f, 0)
}

// checkGlobalStores walks one function body, descending into function
// literals. A closure is not a package member, so the member loop in
// checkGlobalMutation never reaches its body and a global store inside one
// escaped the check entirely: `f := func() { g = g + 1 }` compiled cleanly
// while the same store in a named function was rejected.
func checkGlobalStores(f *SSAFunction, depth int32) {
	if f == nil || f.Blocks == nil || depth > 32 {
		return
	}
	for _, b := range f.Blocks {
		for _, instr := range b.Instrs {
			switch i := instr.(type) {
			case *SSAStore:
				if ssaGlobalRoot(i.Addr, 0) != "" {
					cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
					push(cctx.compileErrors, f.name | ": package globals are immutable outside init: mutate through the methods of a sovereign self-mutating type")
				}
			case *SSAMapUpdate:
				if ssaGlobalRoot(i.Map, 0) != "" {
					cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
					push(cctx.compileErrors, f.name | ": package globals are immutable outside init: mutate through the methods of a sovereign self-mutating type")
				}
			case *SSAMakeClosure:
				if cf, ok := i.Fn.(*SSAFunction); ok {
					checkGlobalStores(cf, depth+1)
				}
			}
		}
	}
}

// scanWasmSpawnTargets collects the static functions reachable through spawn()
// in one package and assigns each a dispatch index.
//
// The parent passes the index to bridge.spawn_domain and the child's
// __spawn_entry switches on it, so the numbering must be stable across the two
// sides and reproducible between builds: Members is a map, so the walk is
// ordered by name rather than by map iteration.
func scanWasmSpawnTargets(p *SSAPackage) {
	if mxutil.TargetArch() != "wasm" || p == nil {
		return
	}
	p.wasmSpawnIndex = map[string]int32{}
	names := []string{:0:len(p.Members)}
	for name := range p.Members {
		names = mxutil.Ensure(names, 1)
		push(names, name)
	}
	for i := int32(1); i < int32(len(names)); i++ {
		for j := i; j > 0 && names[j] < names[j-1]; j-- {
			names[j], names[j-1] = names[j-1], names[j]
		}
	}
	for _, name := range names {
		f, ok := p.Members[name].(*SSAFunction)
		if !ok || f.Blocks == nil {
			continue
		}
		for _, b := range f.Blocks {
			for _, instr := range b.Instrs {
				c, ok2 := instr.(*SSACall)
				if !ok2 {
					continue
				}
				bi, ok3 := c.Call.Value.(*SSABuiltin)
				if !ok3 || bi.id != BuiltinSpawn || len(c.Call.Args) == 0 {
					continue
				}
				target, ok4 := c.Call.Args[0].(*SSAFunction)
				if !ok4 {
					continue
				}
				if _, seen := p.wasmSpawnIndex[target.name]; seen {
					continue
				}
				t := &wasmSpawnTarget{fn: target, fnIdx: int32(len(p.wasmSpawnTargets))}
				if target.Signature != nil && target.Signature.Params != nil {
					for i := int32(0); i < target.Signature.Params.Len(); i++ {
						pt := target.Signature.Params.At(i).Typ
						if _, isChan := SafeUnderlying(pt).(*TCChan); isChan {
							t.chanParamIdx = mxutil.Ensure(t.chanParamIdx, 1)
							push(t.chanParamIdx, i)
						} else {
							t.scalarIdx = mxutil.Ensure(t.scalarIdx, 1)
							push(t.scalarIdx, i)
						}
					}
				}
				p.wasmSpawnTargets = mxutil.Ensure(p.wasmSpawnTargets, 1)
				push(p.wasmSpawnTargets, t)
				p.wasmSpawnIndex[target.name] = t.fnIdx
			}
		}
	}
}

// checkSovereignLoopDecls rejects variable declarations inside a loop body in
// a self-mutating (sovereign) method. Such declarations allocate per iteration
// into the receiver's sovereign arena, accumulating scratch that is only
// reclaimed at method return. Move the loop scratch into a helper function.
// Applies to all code, the compiler included.
func checkSovereignLoopDecls(p *SSAPackage, files []*syntax.File) {
	if p == nil {
		return
	}
	for _, f := range files {
		if f == nil {
			continue
		}
		for _, d := range f.DeclList {
			fd, ok := d.(*syntax.FuncDecl)
			if !ok || fd.Recv == nil || fd.Body == nil || fd.Name == nil {
				continue
			}
			recvName := ssaRecvTypeName(fd.Recv)
			if recvName == "" {
				continue
			}
			member, ok2 := p.Members["(*" | recvName | ")." | fd.Name.Value]
			if !ok2 {
				member, ok2 = p.Members[recvName | "." | fd.Name.Value]
			}
			fn, ok3 := member.(*SSAFunction)
			if !ok3 || fn.Signature == nil || fn.Signature.Recv == nil || !ssaFuncHasReceiverWrite(fn) {
				continue
			}
			var named *Named
			if ptr, okp := SafeUnderlying(fn.Signature.Recv.Typ).(*Pointer); okp {
				if n, okn := ptr.Base.(*Named); okn {
					named = n
				}
			}
			if named == nil || !ssaIsSovereignNamedType(p, named) {
				continue
			}
			scanSovLoopDecls(fn.name, fd.Body.List, false)
		}
	}
}

func sovLoopErr(name, msg string) {
	cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
	push(cctx.compileErrors, name | ": " | msg)
}

// shadowErr reports a local declaration that reuses a name already visible from
// an enclosing scope. Moxie forbids shadowing - legacy enforces the same rule in
// checkScopeShadowing, and pkg/types.Checker.declare enforces it for the paths
// that go through declare. Function bodies compiled here do not, so a shadow
// used to be accepted silently: the outer binding was overwritten and the body
// then resolved the name to the wrong object, which surfaced much later as
// "cannot resolve type of short var".
func shadowErr(fnName, ident string) {
	cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
	push(cctx.compileErrors, fnName | ": '" | ident | "' shadows declaration in enclosing scope")
}

func scanSovLoopDecls(name string, stmts []syntax.Stmt, inLoop bool) {
	for _, s := range stmts {
		if s == nil {
			continue
		}
		switch st := s.(type) {
		case *syntax.DeclStmt:
			if inLoop {
				for _, d := range st.DeclList {
					if _, ok := d.(*syntax.VarDecl); ok {
						sovLoopErr(name, "variable declaration inside a loop in a self-mutating method is not allowed: move the loop scratch into a helper function")
					}
				}
			}
		case *syntax.AssignStmt:
			if inLoop && st.Op == token.Def {
				sovLoopErr(name, "':=' declaration inside a loop in a self-mutating method is not allowed: move the loop scratch into a helper function")
			}
		case *syntax.ForStmt:
			if st.Body != nil {
				scanSovLoopDecls(name, st.Body.List, true)
			}
		case *syntax.BlockStmt:
			scanSovLoopDecls(name, st.List, inLoop)
		case *syntax.IfStmt:
			if st.Then != nil {
				scanSovLoopDecls(name, st.Then.List, inLoop)
			}
			if st.Else != nil {
				scanSovLoopDecls(name, []syntax.Stmt{st.Else}, inLoop)
			}
		case *syntax.SwitchStmt:
			for _, c := range st.Body {
				if c != nil {
					scanSovLoopDecls(name, c.Body, inLoop)
				}
			}
		case *syntax.SelectStmt:
			for _, c := range st.Body {
				if c != nil {
					scanSovLoopDecls(name, c.Body, inLoop)
				}
			}
		case *syntax.LabeledStmt:
			if st.Stmt != nil {
				scanSovLoopDecls(name, []syntax.Stmt{st.Stmt}, inLoop)
			}
		}
	}
}

// --- position-insensitive shadow checking ----------------------------------
//
// Moxie forbids a declaration in a nested block that reuses a name bound
// anywhere in an enclosing block of the same function, INCLUDING one declared
// LATER in that enclosing block: a name is taken for the whole block it appears
// in. legacy's checkScopeShadowing walks finished go/types scopes and so is
// position-insensitive, while the SSA builder could only check as each
// declaration was built and could not see a binding it had not reached yet. The
// two compilers therefore disagreed about the same source, so the rule is
// enforced here, over the whole body.
//
// Scope model: one name set per block, threaded as a stack. The function's own
// scope holds its receiver, parameters and results; the body is nested inside
// it; each if/for/switch body and each case clause is nested further. Reusing a
// name between SIBLING scopes is legal - two cases of one switch may each
// declare x - so only ancestors are consulted.

func inNameList(names []string, name string) (ok bool) {
	for _, n := range names {
		if n == name {
			return true
		}
	}
	return false
}

func concatNames(a, b []string) (out []string) {
	out = a
	for _, s := range b {
		out = mxutil.Ensure(out, 1)
		out = push(out, s)
	}
	return out
}

// shadowPush opens a nested scope.
func shadowPush(scopes [][]string) (out [][]string) {
	out = mxutil.Ensure(scopes, 1)
	return push(out, []string{})
}

func shadowPop(scopes [][]string) (out [][]string) {
	if len(scopes) > 1 {
		return scopes[:len(scopes)-1]
	}
	return scopes
}

// shadowDeclare records a binding in the innermost scope, reporting the name
// when it is already bound in an enclosing scope, at package level, or in the
// predeclared universe.
func shadowDeclare(fn string, outer []string, scopes [][]string, name string) (out [][]string) {
	if name == "" || name == "_" {
		return scopes
	}
	if inNameList(outer, name) || Universe.Lookup(name) != nil {
		shadowErr(fn, name)
	} else {
		for i := 0; i < len(scopes)-1; i++ {
			if inNameList(scopes[i], name) {
				shadowErr(fn, name)
				break
			}
		}
	}
	top := mxutil.Ensure(scopes[len(scopes)-1], 1)
	top = push(top, name)
	out = mxutil.Ensure(scopes[:len(scopes)-1], 1)
	return push(out, top)
}

func shadowDeclField(fn string, outer []string, scopes [][]string, f *syntax.Field) (out [][]string) {
	if f == nil || f.Name == nil {
		return scopes
	}
	return shadowDeclare(fn, outer, scopes, f.Name.Value)
}

func shadowDeclFields(fn string, outer []string, scopes [][]string, fs []*syntax.Field) (out [][]string) {
	out = scopes
	for _, f := range fs {
		out = shadowDeclField(fn, outer, out, f)
	}
	return out
}

func shadowDeclSig(fn string, outer []string, scopes [][]string, ft *syntax.FuncType) (out [][]string) {
	if ft == nil {
		return scopes
	}
	out = shadowDeclFields(fn, outer, scopes, ft.ParamList)
	return shadowDeclFields(fn, outer, out, ft.ResultList)
}

func shadowDecl(fn string, outer []string, scopes [][]string, d syntax.Decl) (out [][]string) {
	out = scopes
	switch t := d.(type) {
	case *syntax.VarDecl:
		for _, n := range t.NameList {
			if n != nil {
				out = shadowDeclare(fn, outer, out, n.Value)
			}
		}
	case *syntax.ConstDecl:
		for _, n := range t.NameList {
			if n != nil {
				out = shadowDeclare(fn, outer, out, n.Value)
			}
		}
	case *syntax.TypeDecl:
		if t.Name != nil {
			out = shadowDeclare(fn, outer, out, t.Name.Value)
		}
	case *syntax.FuncDecl:
		if t.Name != nil {
			out = shadowDeclare(fn, outer, out, t.Name.Value)
		}
		out = shadowDeclField(fn, outer, out, t.Recv)
		out = shadowPush(out)
		out = shadowDeclSig(fn, outer, out, t.Type)
		if t.Body != nil {
			out = shadowPush(out)
			out = shadowStmts(fn, outer, out, t.Body.List)
			out = shadowPop(out)
		}
		out = shadowPop(out)
	}
	return out
}

func shadowDecls(fn string, outer []string, scopes [][]string, ds []syntax.Decl) (out [][]string) {
	out = scopes
	for _, d := range ds {
		out = shadowDecl(fn, outer, out, d)
	}
	return out
}

func shadowLHS(fn string, outer []string, scopes [][]string, e syntax.Expr) (out [][]string) {
	out = scopes
	if e == nil {
		return out
	}
	if le, ok := e.(*syntax.ListExpr); ok {
		for _, x := range le.ElemList {
			out = shadowLHS(fn, outer, out, x)
		}
		return out
	}
	if n, ok := e.(*syntax.Name); ok {
		return shadowDeclare(fn, outer, out, n.Value)
	}
	return out
}

func shadowSimple(fn string, outer []string, scopes [][]string, sx syntax.SimpleStmt) (out [][]string) {
	out = scopes
	if sx == nil {
		return out
	}
	switch t := sx.(type) {
	case *syntax.AssignStmt:
		if t.Op == token.Def {
			out = shadowLHS(fn, outer, out, t.Lhs)
		}
	case *syntax.RangeClause:
		if t.Def {
			out = shadowLHS(fn, outer, out, t.Lhs)
		}
	}
	return out
}

// shadowDeclStmt declares the bindings a single statement introduces directly
// into the current block, without entering nested blocks.
func shadowDeclStmt(fn string, outer []string, scopes [][]string, st syntax.Stmt) (out [][]string) {
	out = scopes
	if st == nil {
		return out
	}
	switch t := st.(type) {
	case *syntax.DeclStmt:
		return shadowDecls(fn, outer, out, t.DeclList)
	case *syntax.AssignStmt:
		if t.Op == token.Def {
			return shadowLHS(fn, outer, out, t.Lhs)
		}
	case *syntax.LabeledStmt:
		return shadowDeclStmt(fn, outer, out, t.Stmt)
	}
	return out
}

func shadowStmt(fn string, outer []string, scopes [][]string, st syntax.Stmt) (out [][]string) {
	out = scopes
	if st == nil {
		return out
	}
	switch t := st.(type) {
	case *syntax.LabeledStmt:
		out = shadowStmt(fn, outer, out, t.Stmt)
	case *syntax.BlockStmt:
		out = shadowPush(out)
		out = shadowStmts(fn, outer, out, t.List)
		out = shadowPop(out)
	case *syntax.IfStmt:
		out = shadowPush(out)
		out = shadowSimple(fn, outer, out, t.Init)
		if t.Then != nil {
			out = shadowPush(out)
			out = shadowStmts(fn, outer, out, t.Then.List)
			out = shadowPop(out)
		}
		out = shadowStmt(fn, outer, out, t.Else)
		out = shadowPop(out)
	case *syntax.ForStmt:
		out = shadowPush(out)
		out = shadowSimple(fn, outer, out, t.Init)
		if t.Body != nil {
			out = shadowPush(out)
			out = shadowStmts(fn, outer, out, t.Body.List)
			out = shadowPop(out)
		}
		out = shadowPop(out)
	case *syntax.SwitchStmt:
		out = shadowPush(out)
		out = shadowSimple(fn, outer, out, t.Init)
		// A type switch's binding lives in the guard, not in an assignment, so
		// nothing above declares it. `switch x := x.(type)` shadows the outer x
		// and legacy rejects it; without this the two compilers disagree.
		if g, ok := t.Tag.(*syntax.TypeSwitchGuard); ok && g.Lhs != nil {
			out = shadowDeclare(fn, outer, out, g.Lhs.Value)
		}
		for _, c := range t.Body {
			if c == nil {
				continue
			}
			out = shadowPush(out)
			out = shadowStmts(fn, outer, out, c.Body)
			out = shadowPop(out)
		}
		out = shadowPop(out)
	case *syntax.SelectStmt:
		out = shadowPush(out)
		for _, c := range t.Body {
			if c == nil {
				continue
			}
			out = shadowPush(out)
			out = shadowSimple(fn, outer, out, c.Comm)
			out = shadowStmts(fn, outer, out, c.Body)
			out = shadowPop(out)
		}
		out = shadowPop(out)
	}
	return out
}

func shadowStmts(fn string, outer []string, scopes [][]string, ss []syntax.Stmt) (out [][]string) {
	out = scopes
	// A binding is taken for its entire block, not from the point it appears:
	// declare every name this block introduces before walking any nested
	// statement, so a nested declaration that appears textually before a later
	// sibling still collides with it.
	for _, st := range ss {
		out = shadowDeclStmt(fn, outer, out, st)
	}
	for _, st := range ss {
		out = shadowStmt(fn, outer, out, st)
	}
	return out
}

// packageDeclNames collects the names bound at package scope, which enclose
// every function body.
func packageDeclNames(files []*syntax.File) (names []string) {
	for _, f := range files {
		if f == nil {
			continue
		}
		for _, d := range f.DeclList {
			switch t := d.(type) {
			case *syntax.FuncDecl:
				if t.Recv == nil && t.Name != nil {
					names = mxutil.Ensure(names, 1)
					names = push(names, t.Name.Value)
				}
			case *syntax.TypeDecl:
				if t.Name != nil {
					names = mxutil.Ensure(names, 1)
					names = push(names, t.Name.Value)
				}
			case *syntax.VarDecl:
				for _, n := range t.NameList {
					if n != nil {
						names = mxutil.Ensure(names, 1)
						names = push(names, n.Value)
					}
				}
			case *syntax.ConstDecl:
				for _, n := range t.NameList {
					if n != nil {
						names = mxutil.Ensure(names, 1)
						names = push(names, n.Value)
					}
				}
			}
		}
	}
	return names
}

// importNamesOf collects the local names a file's imports bind: the alias when
// present, otherwise the imported package's own name, which is not necessarily
// the path tail. A dot import binds no single name - it binds every exported
// name of the imported package, so each of those is returned. Returning
// nothing for a dot import (as this did) made every name it injects invisible
// to the no-conflict rule.
//
// This is used for the package-wide reserved-name set, where per-file grouping
// does not matter; checkImportConflicts reads pb.segImports instead.
func importNamesOf(f *syntax.File) (names []string) {
	for _, d := range f.DeclList {
		im, ok := d.(*syntax.ImportDecl)
		if !ok || im.Path == nil {
			continue
		}
		path := im.Path.Value
		if len(path) >= 2 && path[0] == '"' {
			path = path[1 : len(path)-1]
		}
		imported := cctx.universe.Registry[path]
		if imported == nil {
			continue
		}
		localName := imported.Name
		if im.LocalPkgName != nil {
			localName = im.LocalPkgName.Value
		}
		if localName == "." {
			names = appendExportedNames(names, imported.Scope)
			continue
		}
		if localName == "" || localName == "_" {
			continue
		}
		names = mxutil.Ensure(names, 1)
		names = push(names, localName)
	}
	return names
}

// appendExportedNames appends the exported names of a package scope. Only
// exported ones: Scope.Names() also holds unexported helpers and the
// __moxie_* builtins injected into the imported package itself, and a dot
// import brings in neither.
func appendExportedNames(names []string, sc *Scope) (out []string) {
	out = names
	if sc == nil {
		return out
	}
	for _, n := range sc.Names() {
		if !isExportedName(n) {
			continue
		}
		out = mxutil.Ensure(out, 1)
		out = push(out, n)
	}
	return out
}

// isExportedName reports whether a package-scope name is one a dot import
// injects. Only the first byte decides it, as in Go.
func isExportedName(n string) (ok bool) {
	if len(n) == 0 {
		return false
	}
	return n[0] >= 'A' && n[0] <= 'Z'
}

// checkImportConflicts is the other half of the no-conflict rule, and like
// checkShadowing it is universal. checkShadowing sees a local binding that
// shadows an import or a package declaration; what nothing saw is two imports
// binding one name in a file (registerImport keeps the first and the second
// vanishes) and a package-level declaration colliding with an import.
//
// It works from pb.segImports, not from the parsed file's import decls: the
// driver concatenates a package's files into one syntax.File with a hoisted
// import block, so grouping by that file puts every source file's imports in
// one scope. That reported `encoding/hex` (event.mx) and `pkg/hex`
// (canonical.mx) as two bindings of one name in one file in nostr/pkg/event -
// they are in different files and were always fine. One concatenation segment
// is one original file.
func (pb *ssaPkgBuilder) checkImportConflicts(files []*syntax.File) {
	pkgNames := packageDeclNames(files)
	for si := 0; si < len(pb.segImports); si++ {
		imp := pb.segImports[si]
		for sj := si + 1; sj < len(pb.segImports); sj++ {
			other := pb.segImports[sj]
			if other.seg != imp.seg || other.path == imp.path {
				continue
			}
			for _, a := range pb.importedNamesOf(imp) {
				for _, b := range pb.importedNamesOf(other) {
					if a == b {
						cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
						push(cctx.compileErrors, "'" | a | "' is imported twice in one file: alias one of the imports")
					}
				}
			}
		}
		for _, n := range pb.importedNamesOf(imp) {
			if inNameList(pkgNames, n) {
				cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
				push(cctx.compileErrors, "'" | n | "' collides with an imported package name: alias the import or rename the declaration")
			}
		}
	}
}

// importedNamesOf returns the names one import binds. A dot import binds no
// single name: it binds every exported name of the imported package, so each
// of those is returned. Returning nothing for a dot import (as the old check
// did) made every name it injects invisible to the conflict rule.
func (pb *ssaPkgBuilder) importedNamesOf(imp segImport) (names []string) {
	if !imp.dot {
		names = mxutil.Ensure(names, 1)
		names = push(names, imp.local)
		return names
	}
	if imp.target == nil || imp.target.Scope == nil {
		return names
	}
	for _, n := range imp.target.Scope.Names() {
		if !isExportedName(n) {
			continue
		}
		names = mxutil.Ensure(names, 1)
		names = push(names, n)
	}
	return names
}

// checkShadowing enforces the naming rule over every function body in the
// package, in one pass, so that a binding is visible to the whole block it sits
// in regardless of where in that block it is written.
func checkShadowing(files []*syntax.File) {
	pkgNames := packageDeclNames(files)
	imports := packageImportNames(files)
	for _, f := range files {
		if f == nil {
			continue
		}
		outer := concatNames(pkgNames, imports)
		for _, d := range f.DeclList {
			fd, ok := d.(*syntax.FuncDecl)
			if !ok || fd.Body == nil || fd.Name == nil {
				continue
			}
			// A function body's top-level bindings share the parameter scope:
			// `r, n := f()` redeclares a named result (or a parameter) rather
			// than shadowing it, which is what the legacy compiler's go/types
			// scopes give. Nested blocks are pushed by shadowStmt.
			scopes := [][]string{[]string{}}
			scopes = shadowDeclField(fd.Name.Value, outer, scopes, fd.Recv)
			scopes = shadowDeclSig(fd.Name.Value, outer, scopes, fd.Type)
			shadowStmts(fd.Name.Value, outer, scopes, fd.Body.List)
		}
	}
}

// checkSubsliceCopyTargets rejects `copy(x[a:b], src)`: copy's destination is a
// write, and into a subslice that write lands in a throwaway copy exactly like
// an assignment through one. `copy(x[1], src)` addresses an element, not a
// subslice, and stays legal.
func checkSubsliceCopyTargets(files []*syntax.File, pkgPath string) {
	if !isUserPackagePath(restrictPath(pkgPath)) {
		return
	}
	for _, f := range files {
		if f == nil {
			continue
		}
		for _, d := range f.DeclList {
			fd, ok := d.(*syntax.FuncDecl)
			if !ok || fd.Body == nil {
				continue
			}
			subsliceCopyStmtList(fd.Body.List)
		}
	}
}

func subsliceCopyStmtList(ss []syntax.Stmt) {
	for _, st := range ss {
		subsliceCopyStmt(st)
	}
}

func subsliceCopyStmt(st syntax.Stmt) {
	if st == nil {
		return
	}
	switch t := st.(type) {
	case *syntax.AssignStmt:
		subsliceCopyExpr(t.Lhs)
		subsliceCopyExpr(t.Rhs)
	case *syntax.ExprStmt:
		subsliceCopyExpr(t.X)
	case *syntax.LabeledStmt:
		subsliceCopyStmt(t.Stmt)
	case *syntax.BlockStmt:
		subsliceCopyStmtList(t.List)
	case *syntax.IfStmt:
		if t.Then != nil {
			subsliceCopyStmtList(t.Then.List)
		}
		subsliceCopyStmt(t.Else)
	case *syntax.ForStmt:
		if t.Body != nil {
			subsliceCopyStmtList(t.Body.List)
		}
	case *syntax.SwitchStmt:
		for _, c := range t.Body {
			if c != nil {
				subsliceCopyStmtList(c.Body)
			}
		}
	case *syntax.SelectStmt:
		for _, c := range t.Body {
			if c != nil {
				subsliceCopyStmtList(c.Body)
			}
		}
	}
}

// subsliceCopyExpr reports a copy call whose destination is a subslice.
func subsliceCopyExpr(e syntax.Expr) {
	if e == nil {
		return
	}
	switch t := e.(type) {
	case *syntax.ListExpr:
		for _, x := range t.ElemList {
			subsliceCopyExpr(x)
		}
	case *syntax.CallExpr:
		if id, ok := t.Fun.(*syntax.Name); ok && id.Value == "copy" && t.ArgList != nil && len(t.ArgList) > 0 {
			dst := t.ArgList[0]
			for {
				if paren, ok2 := dst.(*syntax.ParenExpr); ok2 {
					dst = paren.X
					continue
				}
				break
			}
			if _, isSlice := dst.(*syntax.SliceExpr); isSlice {
				cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
				push(cctx.compileErrors, "a subslice is a copy, so copying into it is not allowed: write the elements or resize the slice")
			}
		}
		for _, a := range t.ArgList {
			subsliceCopyExpr(a)
		}
	}
}

// checkSubsliceStores rejects a store through a subslice in user code. Moxie
// subslicing is ALWAYS a copy, so x[a:b][i] = v writes into a throwaway that has
// no address and the value the programmer meant to change is untouched. The
// rewrite is resize (to move the start) plus push (to write the value).
func checkSubsliceStores(files []*syntax.File, pkgPath string) {
	if !isUserPackagePath(restrictPath(pkgPath)) {
		return
	}
	for _, f := range files {
		if f == nil {
			continue
		}
		for _, d := range f.DeclList {
			fd, ok := d.(*syntax.FuncDecl)
			if !ok || fd.Body == nil {
				continue
			}
			subsliceStmtList(fd.Body.List)
		}
	}
}

func subsliceStmtList(ss []syntax.Stmt) {
	for _, st := range ss {
		subsliceStmt(st)
	}
}

func subsliceStmt(st syntax.Stmt) {
	if st == nil {
		return
	}
	switch t := st.(type) {
	case *syntax.AssignStmt:
		subsliceTargets(t.Lhs)
	case *syntax.LabeledStmt:
		subsliceStmt(t.Stmt)
	case *syntax.BlockStmt:
		subsliceStmtList(t.List)
	case *syntax.IfStmt:
		if t.Then != nil {
			subsliceStmtList(t.Then.List)
		}
		subsliceStmt(t.Else)
	case *syntax.ForStmt:
		if t.Body != nil {
			subsliceStmtList(t.Body.List)
		}
	case *syntax.SwitchStmt:
		for _, c := range t.Body {
			if c != nil {
				subsliceStmtList(c.Body)
			}
		}
	case *syntax.SelectStmt:
		for _, c := range t.Body {
			if c != nil {
				subsliceStmtList(c.Body)
			}
		}
	}
}

func subsliceTargets(e syntax.Expr) {
	if e == nil {
		return
	}
	if le, ok := e.(*syntax.ListExpr); ok {
		for _, x := range le.ElemList {
			subsliceTargets(x)
		}
		return
	}
	if subsliceTarget(e) {
		cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
		push(cctx.compileErrors, "a subslice is a copy, so a write through it is not allowed: resize the slice and push the value")
	}
}

// subsliceTarget reports whether e is a store target whose base is a subslice:
// x[a:b][i], x[a:b].F, and any chain ending in one.
func subsliceTarget(e syntax.Expr) (ok bool) {
	switch t := e.(type) {
	case *syntax.IndexExpr:
		if _, isSlice := t.X.(*syntax.SliceExpr); isSlice {
			return true
		}
		return subsliceTarget(t.X)
	case *syntax.SelectorExpr:
		if _, isSlice := t.X.(*syntax.SliceExpr); isSlice {
			return true
		}
		return subsliceTarget(t.X)
	}
	return false
}

// packageImportNames collects every import binding in the package, deduped.
func packageImportNames(files []*syntax.File) (names []string) {
	for _, f := range files {
		if f == nil {
			continue
		}
		for _, nm := range importNamesOf(f) {
			if !inNameList(names, nm) {
				names = mxutil.Ensure(names, 1)
				names = push(names, nm)
			}
		}
	}
	return names
}

// checkParamMutation rejects stores through function parameters.
// Parameters are borrowed references into the caller's arena. Writing
// through them places callee-arena data in caller-owned storage,
// which dangles when the callee's arena dies. Return values are the
// only way to pass data out.
func checkParamMutation(f *SSAFunction) {
	if true { return }
	if f == nil || f.Blocks == nil {
		return
	}
	// Skip runtime - it manages arenas directly.
	if f.Pkg != nil && f.Pkg.Pkg != nil {
		path := f.Pkg.Pkg.Path
		if path == "runtime" || path == "unsafe" {
			return
		}
	}
	// Pass 1: find allocs that hold parameter values.
	// The SSA builder stores each param into an alloc:
	//   %alloc = alloca T
	//   store T %param, ptr %alloc
	paramAllocs := map[SSAValue]bool{}
	for _, p := range f.Params {
		paramAllocs[SSAValue(p)] = true
	}
	paramHolders := map[SSAValue]bool{}
	for _, b := range f.Blocks {
		for _, instr := range b.Instrs {
			s, ok := instr.(*SSAStore)
			if !ok {
				continue
			}
			if paramAllocs[s.Val] {
				paramHolders[s.Addr] = true
			}
		}
	}
	// Pass 2: check all stores.
	for _, b := range f.Blocks {
		for _, instr := range b.Instrs {
			s, ok := instr.(*SSAStore)
			if !ok {
				continue
			}
			if paramAllocs[s.Val] {
				continue
			}
			if isParamDerivedEx(s.Addr, paramHolders, 0) {
				name := paramRootName(s.Addr, paramHolders, 0)
				cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
				push(cctx.compileErrors, f.name | ": store through borrowed parameter '" | name | "'")
			}
		}
	}
}

func isParamDerivedEx(v SSAValue, holders map[SSAValue]bool, depth int32) (ok bool) {
	if v == nil || depth > 20 {
		return false
	}
	switch x := v.(type) {
	case *SSAParameter:
		return true
	case *SSAFieldAddr:
		return isParamDerivedEx(x.X, holders, depth+1)
	case *SSAIndexAddr:
		return isParamDerivedEx(x.X, holders, depth+1)
	case *SSAUnOp:
		if x.Op == OpMul {
			if holders[x.X] {
				return true
			}
			return isParamDerivedEx(x.X, holders, depth+1)
		}
	case *SSAChangeType:
		return isParamDerivedEx(x.X, holders, depth+1)
	case *SSAConvert:
		return isParamDerivedEx(x.X, holders, depth+1)
	case *SSAPhi:
		for _, edge := range x.Edges {
			if isParamDerivedEx(edge, holders, depth+1) {
				return true
			}
		}
	}
	return false
}

func paramRootName(v SSAValue, holders map[SSAValue]bool, depth int32) (name string) {
	if v == nil || depth > 20 {
		return "?"
	}
	switch x := v.(type) {
	case *SSAParameter:
		return x.SSAName()
	case *SSAFieldAddr:
		return paramRootName(x.X, holders, depth+1)
	case *SSAIndexAddr:
		return paramRootName(x.X, holders, depth+1)
	case *SSAUnOp:
		if x.Op == OpMul {
			return paramRootName(x.X, holders, depth+1)
		}
	case *SSAChangeType:
		return paramRootName(x.X, holders, depth+1)
	case *SSAConvert:
		return paramRootName(x.X, holders, depth+1)
	case *SSAPhi:
		for _, edge := range x.Edges {
			n := paramRootName(edge, holders, depth+1)
			if n != "?" {
				return n
			}
		}
	}
	return "?"
}

// markReturnEscapes promotes stack allocas to heap when their address can
// reach a return value.
func markReturnEscapes(f *SSAFunction) {
	derived := map[SSAValue][]*SSAAlloc{}
	stored := map[*SSAAlloc][]*SSAAlloc{}
	mergeInto := func(dst []*SSAAlloc, srcs []*SSAAlloc) ([]*SSAAlloc, bool) {
		didMerge := false
		for _, s := range srcs {
			if s == nil {
				continue
			}
			found := false
			for _, c := range dst {
				if c == s {
					found = true
					break
				}
			}
			if !found {
				dst = mxutil.Ensure(dst, 1)
				push(dst, s)
				didMerge = true
			}
		}
		return dst, didMerge
	}
	for _, b := range f.Blocks {
		for _, instr := range b.Instrs {
			if a, ok := instr.(*SSAAlloc); ok {
				derived[SSAValue(a)] = []*SSAAlloc{a}
			}
		}
	}
	changed := true
	for changed {
		changed = false
		for _, b := range f.Blocks {
			for _, instr := range b.Instrs {
				var dst SSAValue
				var srcs []*SSAAlloc
				switch i := instr.(type) {
				case *SSASlice:
					dst = i
					srcs = derived[i.X]
				case *SSAFieldAddr:
					dst = i
					srcs = derived[i.X]
				case *SSAIndexAddr:
					dst = i
					srcs = derived[i.X]
				case *SSAChangeType:
					dst = i
					srcs = derived[i.X]
				case *SSAConvert:
					dst = i
					srcs = derived[i.X]
				case *SSAMakeInterface:
					dst = i
					srcs = derived[i.X]
				case *SSAPhi:
					dst = i
					for _, edge := range i.Edges {
						srcs = srcs | derived[edge]
					}
				case *SSAUnOp:
					if i.Op == OpMul {
						dst = i
						for _, a := range derived[i.X] {
							srcs = srcs | stored[a]
						}
					}
				case *SSAStore:
					if d := derived[i.Val]; len(d) > 0 {
						for _, a := range derived[i.Addr] {
							ns, ch := mergeInto(stored[a], d)
							if ch {
								stored[a] = ns
								changed = true
							}
						}
					}
				}
				if dst != nil && len(srcs) > 0 {
					nd, ch := mergeInto(derived[dst], srcs)
					if ch {
						derived[dst] = nd
						changed = true
					}
				}
			}
		}
	}
	for _, b := range f.Blocks {
		for _, instr := range b.Instrs {
			r, ok := instr.(*SSAReturn)
			if !ok {
				continue
			}
			for _, res := range r.Results {
				work := derived[res]
				seen := map[*SSAAlloc]bool{}
				for wi := 0; wi < len(work); wi++ {
					a := work[wi]
					if a == nil {
						continue
					}
					if seen[a] {
						continue
					}
					seen[a] = true
					a.Heap = true
					work = work | stored[a]
				}
			}
		}
	}
}


// checkDuplicateCases reports two case clauses of one switch with the same
// constant value. go/types rejects that on the legacy side; stage4 compiled the
// second clause, which can never run. Applies to every package, like
// checkShadowing, because legacy type-checks the stdlib too.
func checkDuplicateCases(p *SSAPackage, files []*syntax.File) {
	if p == nil || p.Pkg == nil || p.Pkg.Scope == nil {
		return
	}
	for _, f := range files {
		if f == nil {
			continue
		}
		for _, d := range f.DeclList {
			fd, ok := d.(*syntax.FuncDecl)
			if !ok || fd.Body == nil {
				continue
			}
			dupCaseStmts(fd.Body.List, p.Pkg.Scope)
		}
	}
}

func dupCaseStmts(list []syntax.Stmt, scope *Scope) {
	for _, s := range list {
		switch st := s.(type) {
		case *syntax.BlockStmt:
			dupCaseStmts(st.List, scope)
		case *syntax.IfStmt:
			if st.Then != nil {
				dupCaseStmts(st.Then.List, scope)
			}
			if st.Else != nil {
				dupCaseStmts([]syntax.Stmt{st.Else}, scope)
			}
		case *syntax.ForStmt:
			if st.Body != nil {
				dupCaseStmts(st.Body.List, scope)
			}
		case *syntax.SwitchStmt:
			dupCaseClauses(st.Body, scope)
			for _, cc := range st.Body {
				if cc != nil {
					dupCaseStmts(cc.Body, scope)
				}
			}
		case *syntax.SelectStmt:
			for _, cc := range st.Body {
				if cc != nil {
					dupCaseStmts(cc.Body, scope)
				}
			}
		}
	}
}

func dupCaseClauses(clauses []*syntax.CaseClause, scope *Scope) {
	seen := map[string]bool{}
	for _, cc := range clauses {
		if cc == nil {
			continue
		}
		var exprs []syntax.Expr
		if l, ok := cc.Cases.(*syntax.ListExpr); ok {
			exprs = l.ElemList
		} else if cc.Cases != nil {
			exprs = []syntax.Expr{cc.Cases}
		}
		for _, e := range exprs {
			cv := tcEvalConstExpr(e, scope, -1)
			if cv == nil {
				continue
			}
			key := dupCaseKey(cv)
			if key == "" {
				continue
			}
			if seen[key] {
				cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
				push(cctx.compileErrors, "duplicate case in switch")
			}
			seen[key] = true
		}
	}
}

// dupCaseKey canonicalises a constant case value so equal values written
// differently (1 and 0x1) compare equal. Only integers key, which is what
// legacy's go/types flags: it accepts duplicate string and bool cases (e.g.
// `case "a", "a":`), so reporting those would be stricter than the reference
// compiler.
func dupCaseKey(cv ConstVal) (k string) {
	if c, ok := cv.(*ConstInt); ok {
		return "i" | irItoa64(c.V)
	}
	return ""
}

// checkMissingReturn rejects a function with results whose body can fall off
// the end. go/types rejects it on the legacy side ("missing return"); stage4
// compiled it and returned the zero value, so a forgotten return path was
// accepted in silence on one side only.
//
// Applies to every package, the stdlib included: legacy's check lives in
// go/types, which type-checks all of them. The rules are the Go spec's
// terminating statements, mirroring go/types' isTerminating (return.go) so the
// two compilers agree on which bodies are complete. A call to a name spelled
// "panic" is accepted as terminating without resolving it, which can only make
// this check more permissive than go/types, never stricter: a stricter check
// would reject valid stdlib code.
func checkMissingReturn(files []*syntax.File) {
	for _, f := range files {
		if f == nil {
			continue
		}
		decls := f.DeclList
		for _, d := range decls {
			fd, ok := d.(*syntax.FuncDecl)
			if !ok || fd == nil || fd.Body == nil || fd.Type == nil {
				continue
			}
			if len(fd.Type.ResultList) == 0 {
				continue
			}
			if stmtsTerminate(fd.Body.List, "") {
				continue
			}
			where := fd.Name.Value
			if fd.Recv != nil {
				where = where | " (method)"
			}
			cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
			push(cctx.compileErrors, where | ": missing return")
		}
	}
}

// stmtsTerminate reports whether a statement list ends in a terminating
// statement. Trailing empty statements are permitted, as in go/types.
func stmtsTerminate(list []syntax.Stmt, label string) (ok bool) {
	for i := int32(len(list)) - 1; i >= 0; i-- {
		if _, isEmpty := list[i].(*syntax.EmptyStmt); isEmpty {
			continue
		}
		return stmtTerminates(list[i], label)
	}
	return false
}

func stmtTerminates(s syntax.Stmt, label string) (ok bool) {
	switch st := s.(type) {
	case *syntax.LabeledStmt:
		inner := ""
		if st.Label != nil {
			inner = st.Label.Value
		}
		if st.Stmt == nil {
			return false
		}
		return stmtTerminates(st.Stmt, inner)
	case *syntax.ExprStmt:
		call, isCall := st.X.(*syntax.CallExpr)
		if !isCall || call == nil {
			return false
		}
		name, isName := call.Fun.(*syntax.Name)
		return isName && name.Value == "panic"
	case *syntax.ReturnStmt:
		return true
	case *syntax.BranchStmt:
		// Moxie has no fallthrough token, so goto is the only branch that
		// ends a statement list.
		return st.Tok == token.Goto
	case *syntax.BlockStmt:
		return stmtsTerminate(st.List, "")
	case *syntax.IfStmt:
		if st.Then == nil || st.Else == nil {
			return false
		}
		return stmtsTerminate(st.Then.List, "") && stmtTerminates(st.Else, "")
	case *syntax.SwitchStmt:
		return switchTerminates(st.Body, label)
	case *syntax.SelectStmt:
		for _, cc := range st.Body {
			if cc == nil {
				return false
			}
			if !stmtsTerminate(cc.Body, "") || hasBreakList(cc.Body, label, true) {
				return false
			}
		}
		return true
	case *syntax.ForStmt:
		// A range clause is carried as the loop's init, and a range loop
		// always ends, so it is never terminating.
		if _, isRange := st.Init.(*syntax.RangeClause); isRange {
			return false
		}
		if st.Cond != nil || st.Body == nil {
			return false
		}
		return !hasBreakList(st.Body.List, label, true)
	}
	return false
}

// switchTerminates reports whether a switch both covers every value (there is
// a default clause) and leaves no clause able to fall out of it.
func switchTerminates(body []*syntax.CaseClause, label string) (ok bool) {
	hasDefault := false
	for _, cc := range body {
		if cc == nil {
			return false
		}
		if cc.Cases == nil {
			hasDefault = true
		}
		if !stmtsTerminate(cc.Body, "") || hasBreakList(cc.Body, label, true) {
			return false
		}
	}
	return hasDefault
}

// hasBreakList reports whether any statement in list breaks out of the
// breakable statement named label, or (when implicit is set) out of the
// innermost one enclosing it.
func hasBreakList(list []syntax.Stmt, label string, implicit bool) (ok bool) {
	for _, s := range list {
		if hasBreakIn(s, label, implicit) {
			return true
		}
	}
	return false
}

func hasBreakIn(s syntax.Stmt, label string, implicit bool) (ok bool) {
	switch st := s.(type) {
	case *syntax.LabeledStmt:
		if st.Stmt == nil {
			return false
		}
		return hasBreakIn(st.Stmt, label, implicit)
	case *syntax.BranchStmt:
		if st.Tok != token.Break {
			return false
		}
		if st.Label == nil {
			return implicit
		}
		return st.Label.Value == label
	case *syntax.BlockStmt:
		return hasBreakList(st.List, label, implicit)
	case *syntax.IfStmt:
		if st.Then != nil && hasBreakList(st.Then.List, label, implicit) {
			return true
		}
		if st.Else != nil && hasBreakIn(st.Else, label, implicit) {
			return true
		}
		return false
	case *syntax.SwitchStmt:
		// An unlabelled break inside a nested switch belongs to that switch,
		// so it only counts against label when one is being matched.
		if label == "" {
			return false
		}
		for _, cc := range st.Body {
			if cc != nil && hasBreakList(cc.Body, label, false) {
				return true
			}
		}
		return false
	case *syntax.SelectStmt:
		if label == "" {
			return false
		}
		for _, cc := range st.Body {
			if cc != nil && hasBreakList(cc.Body, label, false) {
				return true
			}
		}
		return false
	case *syntax.ForStmt:
		if label == "" || st.Body == nil {
			return false
		}
		return hasBreakList(st.Body.List, label, false)
	}
	return false
}

// checkClosureCaptures rejects a closure that captures an outer variable.
//
// A Moxie closure is a standalone function that receives everything it needs
// through parameters: there is no closure environment and no scope chain, so a
// capture would tie the closure's lifetime to the caller's frame arena. Legacy
// enforces exactly this on ssa.MakeClosure bindings (restrict.go), which also
// makes a bound method value a capture - the receiver is the binding. Reading a
// package-level global is not a capture: globals are not free variables.
//
// Like legacy, this applies to user code only: the stdlib uses captures
// internally (os.ReadFile's method values bind recv, os.Symlink closes over
// its arguments) and legacy exempts those packages, so flagging them would
// reject every program that imports os.
func checkClosureCaptures(p *SSAPackage) {
	if p == nil || p.Pkg == nil {
		return
	}
	if bst != nil && bst.allowCaptures {
		return
	}
	if !isUserPackagePath(restrictPath(p.Pkg.Path)) {
		// A dependency's captures are LEGAL (see above), but -report-closure-
		// captures asks for them anyway: the report is what turned "the stdlib
		// has 13 files with capturing closures" from a claim into a list.
		if bst != nil && bst.reportCaptures {
			reportCapturePackage(p)
		}
		return
	}
	names := []string{:0:len(p.Members)}
	for n := range p.Members {
		names = mxutil.Ensure(names, 1)
		push(names, n)
	}
	for i := int32(1); i < int32(len(names)); i++ {
		for j := i; j > 0 && names[j] < names[j-1]; j-- {
			names[j], names[j-1] = names[j-1], names[j]
		}
	}
	for _, n := range names {
		if f, ok := p.Members[n].(*SSAFunction); ok {
			checkCaptureFunc(f, 0)
		}
	}
}

// reportCapturePackage prints every capturing function in a package to stderr.
// Reporting only: nothing here can fail a build.
func reportCapturePackage(p *SSAPackage) {
	names := []string{:0:len(p.Members)}
	for n := range p.Members {
		names = mxutil.Ensure(names, 1)
		push(names, n)
	}
	for i := int32(1); i < int32(len(names)); i++ {
		for j := i; j > 0 && names[j] < names[j-1]; j-- {
			names[j], names[j-1] = names[j-1], names[j]
		}
	}
	for _, n := range names {
		if f, ok := p.Members[n].(*SSAFunction); ok {
			reportCaptureFunc(f, 0)
		}
	}
}

func reportCaptureFunc(f *SSAFunction, depth int32) {
	if f == nil || depth > 32 {
		return
	}
	captured := ""
	for i := int32(0); i < int32(len(f.FreeVars)); i++ {
		if i > 0 {
			captured = captured | ", "
		}
		captured = captured | f.FreeVars[i].name
	}
	if captured != "" {
		mxutil.WriteStr(2, "capture: " | f.name | " [" | captured | "]\n")
	}
	for _, af := range f.AnonFuncs {
		reportCaptureFunc(af, depth+1)
	}
}

func checkCaptureFunc(f *SSAFunction, depth int32) {
	if f == nil || depth > 32 {
		return
	}
	captured := ""
	for i := int32(0); i < int32(len(f.FreeVars)); i++ {
		if i > 0 {
			captured = captured | ", "
		}
		captured = captured | f.FreeVars[i].name
	}
	if captured != "" {
		cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
		push(cctx.compileErrors, f.name | ": closure captures outer variable(s) [" | captured | "]; pass as explicit parameter(s)")
	}
	for _, af := range f.AnonFuncs {
		checkCaptureFunc(af, depth+1)
	}
}
