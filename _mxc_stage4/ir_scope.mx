package main

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"git.smesh.lol/moxie/pkg/syntax"
	"git.smesh.lol/moxie/pkg/token"
	. "git.smesh.lol/moxie/pkg/types"
)

// checkUseAfterFree: no-op in arena model.
func checkUseAfterFree(f *SSAFunction) {}

func strContains(s, sub string) bool {
	if len(sub) == 0 {
		return true
	}
	n := int32(len(sub))
	for i := int32(0); i+n <= int32(len(s)); i++ {
		if s[i:i+n] == sub {
			return true
		}
	}
	return false
}

// targetIsMoxieModule reports whether the package being compiled belongs to
// the moxie compiler's own module. Legacy reads this from the target package's
// module (restrict.go isUserPackage: b.pkgModulePath == "git.smesh.lol/moxie").
// The resolved build module cannot stand in for it: a target outside any module
// falls back to MOXIEROOT so that its imports resolve, and inheriting that
// fallback would exempt every out-of-tree user package from the restrictions.
func targetIsMoxieModule() bool {
	if bst == nil {
		return false
	}
	return bst.rootModPrefix == "git.smesh.lol/moxie"
}

// isUserPackagePath mirrors legacy restrict.go isUserPackage: a package is
// subject to Moxie language restrictions if its import path contains a dot
// (user module paths look like domain paths), except golang.org/x/ and the
// compiler's own /pkg/ infrastructure. Main packages are user code unless
// the target itself lives in the moxie compiler module.
func isUserPackagePath(path string) bool {
	if path == "main" || path == "command-line-arguments" {
		return !targetIsMoxieModule()
	}
	if mxutil.HasPrefix(path, "golang.org/x/") {
		return false
	}
	if strContains(path, "/pkg/") {
		return false
	}
	for i := int32(0); i < int32(len(path)); i++ {
		if path[i] == '.' {
			return true
		}
	}
	return false
}

// ssaGlobalRoot returns the name of the package-level global an address is
// rooted in, or "" if the address is local or goes THROUGH a global pointer.
// Mirrors legacy restrict.go globalName: a global whose type is a pointer is
// not the storage itself - mutations through it land in the pointed-to
// object (heap-local state). Whole-global stores (depth 0) are always flagged.
func ssaGlobalRoot(v SSAValue, depth int32) (s string) {
	if v == nil || depth > 12 {
		return ""
	}
	switch x := v.(type) {
	case *SSAGlobal:
		if depth > 0 {
			// SSAGlobal.typ is always NewPointer(valueType); the real
			// declared type is on the object. A global whose declared
			// type is a pointer is not the storage itself - field/index
			// mutations through it land in the pointed-to object.
			declTyp := x.typ
			if x.object != nil && x.object.Typ != nil {
				declTyp = x.object.Typ
			}
			if _, isPtr := SafeUnderlying(declTyp).(*Pointer); isPtr {
				return ""
			}
		}
		return x.name
	case *SSAFieldAddr:
		return ssaGlobalRoot(x.X, depth+1)
	case *SSAIndexAddr:
		return ssaGlobalRoot(x.X, depth+1)
	case *SSAUnOp:
		return ssaGlobalRoot(x.X, depth+1)
	case *SSAChangeType:
		return ssaGlobalRoot(x.X, depth+1)
	case *SSAConvert:
		return ssaGlobalRoot(x.X, depth+1)
	}
	return ""
}

// isInitFuncName mirrors legacy restrict.go isInitFunc: package initialization
// code may set globals. The prefix rule is legacy's, kept verbatim so both
// compilers accept exactly the same functions - the constructor an app calls
// to build its state lives in the root arena and is named initState/initX.
func isInitFuncName(name string) bool {
	if name == "init" {
		return true
	}
	return len(name) > 4 && name[:4] == "init"
}

// checkGlobalMutation rejects stores that mutate package-level globals in
// user code. Globals are initialized by __varinit (package var initializers)
// and immutable afterward. Sovereign self-mutating types are mutated through
// their methods (which borrow the receiver's arena); direct stores bypass
// that and are illegal for every global, sovereign or not.
func checkGlobalMutation(f *SSAFunction) {
	if f == nil || f.Blocks == nil || f.Pkg == nil || f.Pkg.Pkg == nil {
		return
	}
	if !isUserPackagePath(f.Pkg.Pkg.Path) {
		return
	}
	if f.name == "__varinit" || isInitFuncName(f.name) {
		return
	}
	// Library packages without a real main get their package-var
	// initializers injected into a synthetic main; exempt that case.
	if f.name == "main" && f.Pkg.Pkg.Path != "main" {
		return
	}
	checkGlobalStores(f, 0)
}

// checkGlobalStores walks one function body, descending into function
// literals. A closure is not a package member, so the member loop in
// checkGlobalMutation never reaches its body and a global store inside one
// escaped the check entirely: `f := func() { g = g + 1 }` compiled cleanly
// while the same store in a named function was rejected.
func checkGlobalStores(f *SSAFunction, depth int32) {
	if f == nil || f.Blocks == nil || depth > 32 {
		return
	}
	for _, b := range f.Blocks {
		for _, instr := range b.Instrs {
			switch i := instr.(type) {
			case *SSAStore:
				if ssaGlobalRoot(i.Addr, 0) != "" {
					cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
					push(cctx.compileErrors, f.name | ": package globals are immutable outside init: mutate through the methods of a sovereign self-mutating type")
				}
			case *SSAMapUpdate:
				if ssaGlobalRoot(i.Map, 0) != "" {
					cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
					push(cctx.compileErrors, f.name | ": package globals are immutable outside init: mutate through the methods of a sovereign self-mutating type")
				}
			case *SSAMakeClosure:
				if cf, ok := i.Fn.(*SSAFunction); ok {
					checkGlobalStores(cf, depth+1)
				}
			}
		}
	}
}

// scanWasmSpawnTargets collects the static functions reachable through spawn()
// in one package and assigns each a dispatch index.
//
// The parent passes the index to bridge.spawn_domain and the child's
// __spawn_entry switches on it, so the numbering must be stable across the two
// sides and reproducible between builds: Members is a map, so the walk is
// ordered by name rather than by map iteration.
func scanWasmSpawnTargets(p *SSAPackage) {
	if mxutil.TargetArch() != "wasm" || p == nil {
		return
	}
	p.wasmSpawnIndex = map[string]int32{}
	names := []string{:0:len(p.Members)}
	for name := range p.Members {
		names = mxutil.Ensure(names, 1)
		push(names, name)
	}
	for i := int32(1); i < int32(len(names)); i++ {
		for j := i; j > 0 && names[j] < names[j-1]; j-- {
			names[j], names[j-1] = names[j-1], names[j]
		}
	}
	for _, name := range names {
		f, ok := p.Members[name].(*SSAFunction)
		if !ok || f.Blocks == nil {
			continue
		}
		for _, b := range f.Blocks {
			for _, instr := range b.Instrs {
				c, ok2 := instr.(*SSACall)
				if !ok2 {
					continue
				}
				bi, ok3 := c.Call.Value.(*SSABuiltin)
				if !ok3 || bi.id != BuiltinSpawn || len(c.Call.Args) == 0 {
					continue
				}
				target, ok4 := c.Call.Args[0].(*SSAFunction)
				if !ok4 {
					continue
				}
				if _, seen := p.wasmSpawnIndex[target.name]; seen {
					continue
				}
				t := &wasmSpawnTarget{fn: target, fnIdx: int32(len(p.wasmSpawnTargets))}
				if target.Signature != nil && target.Signature.Params != nil {
					for i := int32(0); i < target.Signature.Params.Len(); i++ {
						pt := target.Signature.Params.At(i).Typ
						if _, isChan := SafeUnderlying(pt).(*TCChan); isChan {
							t.chanParamIdx = mxutil.Ensure(t.chanParamIdx, 1)
							push(t.chanParamIdx, i)
						} else {
							t.scalarIdx = mxutil.Ensure(t.scalarIdx, 1)
							push(t.scalarIdx, i)
						}
					}
				}
				p.wasmSpawnTargets = mxutil.Ensure(p.wasmSpawnTargets, 1)
				push(p.wasmSpawnTargets, t)
				p.wasmSpawnIndex[target.name] = t.fnIdx
			}
		}
	}
}

// checkSovereignLoopDecls rejects variable declarations inside a loop body in
// a self-mutating (sovereign) method. Such declarations allocate per iteration
// into the receiver's sovereign arena, accumulating scratch that is only
// reclaimed at method return. Move the loop scratch into a helper function.
// Applies to all code, the compiler included.
func checkSovereignLoopDecls(p *SSAPackage, files []*syntax.File) {
	if p == nil {
		return
	}
	for _, f := range files {
		if f == nil {
			continue
		}
		for _, d := range f.DeclList {
			fd, ok := d.(*syntax.FuncDecl)
			if !ok || fd.Recv == nil || fd.Body == nil || fd.Name == nil {
				continue
			}
			recvName := ssaRecvTypeName(fd.Recv)
			if recvName == "" {
				continue
			}
			member, ok2 := p.Members["(*" | recvName | ")." | fd.Name.Value]
			if !ok2 {
				member, ok2 = p.Members[recvName | "." | fd.Name.Value]
			}
			fn, ok3 := member.(*SSAFunction)
			if !ok3 || fn.Signature == nil || fn.Signature.Recv == nil || !ssaFuncHasReceiverWrite(fn) {
				continue
			}
			var named *Named
			if ptr, okp := SafeUnderlying(fn.Signature.Recv.Typ).(*Pointer); okp {
				if n, okn := ptr.Base.(*Named); okn {
					named = n
				}
			}
			if named == nil || !ssaIsSovereignNamedType(p, named) {
				continue
			}
			scanSovLoopDecls(fn.name, fd.Body.List, false)
		}
	}
}

func sovLoopErr(name, msg string) {
	cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
	push(cctx.compileErrors, name | ": " | msg)
}

// shadowErr reports a local declaration that reuses a name already visible from
// an enclosing scope. Moxie forbids shadowing - legacy enforces the same rule in
// checkScopeShadowing, and pkg/types.Checker.declare enforces it for the paths
// that go through declare. Function bodies compiled here do not, so a shadow
// used to be accepted silently: the outer binding was overwritten and the body
// then resolved the name to the wrong object, which surfaced much later as
// "cannot resolve type of short var".
func shadowErr(fnName, ident string) {
	cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
	push(cctx.compileErrors, fnName | ": '" | ident | "' shadows declaration in enclosing scope")
}

func scanSovLoopDecls(name string, stmts []syntax.Stmt, inLoop bool) {
	for _, s := range stmts {
		if s == nil {
			continue
		}
		switch st := s.(type) {
		case *syntax.DeclStmt:
			if inLoop {
				for _, d := range st.DeclList {
					if _, ok := d.(*syntax.VarDecl); ok {
						sovLoopErr(name, "variable declaration inside a loop in a self-mutating method is not allowed: move the loop scratch into a helper function")
					}
				}
			}
		case *syntax.AssignStmt:
			if inLoop && st.Op == token.Def {
				sovLoopErr(name, "':=' declaration inside a loop in a self-mutating method is not allowed: move the loop scratch into a helper function")
			}
		case *syntax.ForStmt:
			if st.Body != nil {
				scanSovLoopDecls(name, st.Body.List, true)
			}
		case *syntax.BlockStmt:
			scanSovLoopDecls(name, st.List, inLoop)
		case *syntax.IfStmt:
			if st.Then != nil {
				scanSovLoopDecls(name, st.Then.List, inLoop)
			}
			if st.Else != nil {
				scanSovLoopDecls(name, []syntax.Stmt{st.Else}, inLoop)
			}
		case *syntax.SwitchStmt:
			for _, c := range st.Body {
				if c != nil {
					scanSovLoopDecls(name, c.Body, inLoop)
				}
			}
		case *syntax.SelectStmt:
			for _, c := range st.Body {
				if c != nil {
					scanSovLoopDecls(name, c.Body, inLoop)
				}
			}
		case *syntax.LabeledStmt:
			if st.Stmt != nil {
				scanSovLoopDecls(name, []syntax.Stmt{st.Stmt}, inLoop)
			}
		}
	}
}

// --- position-insensitive shadow checking ----------------------------------
//
// Moxie forbids a declaration in a nested block that reuses a name bound
// anywhere in an enclosing block of the same function, INCLUDING one declared
// LATER in that enclosing block: a name is taken for the whole block it appears
// in. legacy's checkScopeShadowing walks finished go/types scopes and so is
// position-insensitive, while the SSA builder could only check as each
// declaration was built and could not see a binding it had not reached yet. The
// two compilers therefore disagreed about the same source, so the rule is
// enforced here, over the whole body.
//
// Scope model: one name set per block, threaded as a stack. The function's own
// scope holds its receiver, parameters and results; the body is nested inside
// it; each if/for/switch body and each case clause is nested further. Reusing a
// name between SIBLING scopes is legal - two cases of one switch may each
// declare x - so only ancestors are consulted.

func inNameList(names []string, name string) (ok bool) {
	for _, n := range names {
		if n == name {
			return true
		}
	}
	return false
}

func concatNames(a, b []string) (out []string) {
	out = a
	for _, s := range b {
		out = mxutil.Ensure(out, 1)
		out = push(out, s)
	}
	return out
}

// shadowPush opens a nested scope.
func shadowPush(scopes [][]string) (out [][]string) {
	out = mxutil.Ensure(scopes, 1)
	return push(out, []string{})
}

func shadowPop(scopes [][]string) (out [][]string) {
	if len(scopes) > 1 {
		return scopes[:len(scopes)-1]
	}
	return scopes
}

// shadowDeclare records a binding in the innermost scope, reporting the name
// when it is already bound in an enclosing scope, at package level, or in the
// predeclared universe.
func shadowDeclare(fn string, outer []string, scopes [][]string, name string) (out [][]string) {
	if name == "" || name == "_" {
		return scopes
	}
	if inNameList(outer, name) || Universe.Lookup(name) != nil {
		shadowErr(fn, name)
	} else {
		for i := 0; i < len(scopes)-1; i++ {
			if inNameList(scopes[i], name) {
				shadowErr(fn, name)
				break
			}
		}
	}
	top := mxutil.Ensure(scopes[len(scopes)-1], 1)
	top = push(top, name)
	out = mxutil.Ensure(scopes[:len(scopes)-1], 1)
	return push(out, top)
}

func shadowDeclField(fn string, outer []string, scopes [][]string, f *syntax.Field) (out [][]string) {
	if f == nil || f.Name == nil {
		return scopes
	}
	return shadowDeclare(fn, outer, scopes, f.Name.Value)
}

func shadowDeclFields(fn string, outer []string, scopes [][]string, fs []*syntax.Field) (out [][]string) {
	out = scopes
	for _, f := range fs {
		out = shadowDeclField(fn, outer, out, f)
	}
	return out
}

func shadowDeclSig(fn string, outer []string, scopes [][]string, ft *syntax.FuncType) (out [][]string) {
	if ft == nil {
		return scopes
	}
	out = shadowDeclFields(fn, outer, scopes, ft.ParamList)
	return shadowDeclFields(fn, outer, out, ft.ResultList)
}

func shadowDecl(fn string, outer []string, scopes [][]string, d syntax.Decl) (out [][]string) {
	out = scopes
	switch t := d.(type) {
	case *syntax.VarDecl:
		for _, n := range t.NameList {
			if n != nil {
				out = shadowDeclare(fn, outer, out, n.Value)
			}
		}
	case *syntax.ConstDecl:
		for _, n := range t.NameList {
			if n != nil {
				out = shadowDeclare(fn, outer, out, n.Value)
			}
		}
	case *syntax.TypeDecl:
		if t.Name != nil {
			out = shadowDeclare(fn, outer, out, t.Name.Value)
		}
	case *syntax.FuncDecl:
		if t.Name != nil {
			out = shadowDeclare(fn, outer, out, t.Name.Value)
		}
		out = shadowDeclField(fn, outer, out, t.Recv)
		out = shadowPush(out)
		out = shadowDeclSig(fn, outer, out, t.Type)
		if t.Body != nil {
			out = shadowPush(out)
			out = shadowStmts(fn, outer, out, t.Body.List)
			out = shadowPop(out)
		}
		out = shadowPop(out)
	}
	return out
}

func shadowDecls(fn string, outer []string, scopes [][]string, ds []syntax.Decl) (out [][]string) {
	out = scopes
	for _, d := range ds {
		out = shadowDecl(fn, outer, out, d)
	}
	return out
}

func shadowLHS(fn string, outer []string, scopes [][]string, e syntax.Expr) (out [][]string) {
	out = scopes
	if e == nil {
		return out
	}
	if le, ok := e.(*syntax.ListExpr); ok {
		for _, x := range le.ElemList {
			out = shadowLHS(fn, outer, out, x)
		}
		return out
	}
	if n, ok := e.(*syntax.Name); ok {
		return shadowDeclare(fn, outer, out, n.Value)
	}
	return out
}

func shadowSimple(fn string, outer []string, scopes [][]string, sx syntax.SimpleStmt) (out [][]string) {
	out = scopes
	if sx == nil {
		return out
	}
	switch t := sx.(type) {
	case *syntax.AssignStmt:
		if t.Op == token.Def {
			out = shadowLHS(fn, outer, out, t.Lhs)
		}
	case *syntax.RangeClause:
		if t.Def {
			out = shadowLHS(fn, outer, out, t.Lhs)
		}
	}
	return out
}

// shadowDeclStmt declares the bindings a single statement introduces directly
// into the current block, without entering nested blocks.
func shadowDeclStmt(fn string, outer []string, scopes [][]string, st syntax.Stmt) (out [][]string) {
	out = scopes
	if st == nil {
		return out
	}
	switch t := st.(type) {
	case *syntax.DeclStmt:
		return shadowDecls(fn, outer, out, t.DeclList)
	case *syntax.AssignStmt:
		if t.Op == token.Def {
			return shadowLHS(fn, outer, out, t.Lhs)
		}
	case *syntax.LabeledStmt:
		return shadowDeclStmt(fn, outer, out, t.Stmt)
	}
	return out
}

func shadowStmt(fn string, outer []string, scopes [][]string, st syntax.Stmt) (out [][]string) {
	out = scopes
	if st == nil {
		return out
	}
	switch t := st.(type) {
	case *syntax.LabeledStmt:
		out = shadowStmt(fn, outer, out, t.Stmt)
	case *syntax.BlockStmt:
		out = shadowPush(out)
		out = shadowStmts(fn, outer, out, t.List)
		out = shadowPop(out)
	case *syntax.IfStmt:
		out = shadowPush(out)
		out = shadowSimple(fn, outer, out, t.Init)
		if t.Then != nil {
			out = shadowPush(out)
			out = shadowStmts(fn, outer, out, t.Then.List)
			out = shadowPop(out)
		}
		out = shadowStmt(fn, outer, out, t.Else)
		out = shadowPop(out)
	case *syntax.ForStmt:
		out = shadowPush(out)
		out = shadowSimple(fn, outer, out, t.Init)
		if t.Body != nil {
			out = shadowPush(out)
			out = shadowStmts(fn, outer, out, t.Body.List)
			out = shadowPop(out)
		}
		out = shadowPop(out)
	case *syntax.SwitchStmt:
		out = shadowPush(out)
		out = shadowSimple(fn, outer, out, t.Init)
		for _, c := range t.Body {
			if c == nil {
				continue
			}
			out = shadowPush(out)
			out = shadowStmts(fn, outer, out, c.Body)
			out = shadowPop(out)
		}
		out = shadowPop(out)
	case *syntax.SelectStmt:
		out = shadowPush(out)
		for _, c := range t.Body {
			if c == nil {
				continue
			}
			out = shadowPush(out)
			out = shadowSimple(fn, outer, out, c.Comm)
			out = shadowStmts(fn, outer, out, c.Body)
			out = shadowPop(out)
		}
		out = shadowPop(out)
	}
	return out
}

func shadowStmts(fn string, outer []string, scopes [][]string, ss []syntax.Stmt) (out [][]string) {
	out = scopes
	// A binding is taken for its entire block, not from the point it appears:
	// declare every name this block introduces before walking any nested
	// statement, so a nested declaration that appears textually before a later
	// sibling still collides with it.
	for _, st := range ss {
		out = shadowDeclStmt(fn, outer, out, st)
	}
	for _, st := range ss {
		out = shadowStmt(fn, outer, out, st)
	}
	return out
}

// packageDeclNames collects the names bound at package scope, which enclose
// every function body.
func packageDeclNames(files []*syntax.File) (names []string) {
	for _, f := range files {
		if f == nil {
			continue
		}
		for _, d := range f.DeclList {
			switch t := d.(type) {
			case *syntax.FuncDecl:
				if t.Recv == nil && t.Name != nil {
					names = mxutil.Ensure(names, 1)
					names = push(names, t.Name.Value)
				}
			case *syntax.TypeDecl:
				if t.Name != nil {
					names = mxutil.Ensure(names, 1)
					names = push(names, t.Name.Value)
				}
			case *syntax.VarDecl:
				for _, n := range t.NameList {
					if n != nil {
						names = mxutil.Ensure(names, 1)
						names = push(names, n.Value)
					}
				}
			case *syntax.ConstDecl:
				for _, n := range t.NameList {
					if n != nil {
						names = mxutil.Ensure(names, 1)
						names = push(names, n.Value)
					}
				}
			}
		}
	}
	return names
}

// importNamesOf collects the local name each import binds: the alias when
// present, otherwise the imported package's own name, which is not necessarily
// the path tail.
func importNamesOf(f *syntax.File) (names []string) {
	for _, d := range f.DeclList {
		im, ok := d.(*syntax.ImportDecl)
		if !ok || im.Path == nil {
			continue
		}
		path := im.Path.Value
		if len(path) >= 2 && path[0] == '"' {
			path = path[1 : len(path)-1]
		}
		imported := cctx.universe.Registry[path]
		if imported == nil {
			continue
		}
		localName := imported.Name
		if im.LocalPkgName != nil {
			localName = im.LocalPkgName.Value
		}
		if localName == "" || localName == "_" || localName == "." {
			continue
		}
		names = mxutil.Ensure(names, 1)
		names = push(names, localName)
	}
	return names
}

// checkShadowing enforces the naming rule over every function body in the
// package, in one pass, so that a binding is visible to the whole block it sits
// in regardless of where in that block it is written.
func checkShadowing(files []*syntax.File) {
	pkgNames := packageDeclNames(files)
	imports := packageImportNames(files)
	for _, f := range files {
		if f == nil {
			continue
		}
		outer := concatNames(pkgNames, imports)
		for _, d := range f.DeclList {
			fd, ok := d.(*syntax.FuncDecl)
			if !ok || fd.Body == nil || fd.Name == nil {
				continue
			}
			// A function body's top-level bindings share the parameter scope:
			// `r, n := f()` redeclares a named result (or a parameter) rather
			// than shadowing it, which is what the legacy compiler's go/types
			// scopes give. Nested blocks are pushed by shadowStmt.
			scopes := [][]string{[]string{}}
			scopes = shadowDeclField(fd.Name.Value, outer, scopes, fd.Recv)
			scopes = shadowDeclSig(fd.Name.Value, outer, scopes, fd.Type)
			shadowStmts(fd.Name.Value, outer, scopes, fd.Body.List)
		}
	}
}

// packageImportNames collects every import binding in the package, deduped.
func packageImportNames(files []*syntax.File) (names []string) {
	for _, f := range files {
		if f == nil {
			continue
		}
		for _, nm := range importNamesOf(f) {
			if !inNameList(names, nm) {
				names = mxutil.Ensure(names, 1)
				names = push(names, nm)
			}
		}
	}
	return names
}

// checkParamMutation rejects stores through function parameters.
// Parameters are borrowed references into the caller's arena. Writing
// through them places callee-arena data in caller-owned storage,
// which dangles when the callee's arena dies. Return values are the
// only way to pass data out.
func checkParamMutation(f *SSAFunction) {
	if true { return }
	if f == nil || f.Blocks == nil {
		return
	}
	// Skip runtime - it manages arenas directly.
	if f.Pkg != nil && f.Pkg.Pkg != nil {
		path := f.Pkg.Pkg.Path
		if path == "runtime" || path == "unsafe" {
			return
		}
	}
	// Pass 1: find allocs that hold parameter values.
	// The SSA builder stores each param into an alloc:
	//   %alloc = alloca T
	//   store T %param, ptr %alloc
	paramAllocs := map[SSAValue]bool{}
	for _, p := range f.Params {
		paramAllocs[SSAValue(p)] = true
	}
	paramHolders := map[SSAValue]bool{}
	for _, b := range f.Blocks {
		for _, instr := range b.Instrs {
			s, ok := instr.(*SSAStore)
			if !ok {
				continue
			}
			if paramAllocs[s.Val] {
				paramHolders[s.Addr] = true
			}
		}
	}
	// Pass 2: check all stores.
	for _, b := range f.Blocks {
		for _, instr := range b.Instrs {
			s, ok := instr.(*SSAStore)
			if !ok {
				continue
			}
			if paramAllocs[s.Val] {
				continue
			}
			if isParamDerivedEx(s.Addr, paramHolders, 0) {
				name := paramRootName(s.Addr, paramHolders, 0)
				cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
				push(cctx.compileErrors, f.name | ": store through borrowed parameter '" | name | "'")
			}
		}
	}
}

func isParamDerivedEx(v SSAValue, holders map[SSAValue]bool, depth int32) (ok bool) {
	if v == nil || depth > 20 {
		return false
	}
	switch x := v.(type) {
	case *SSAParameter:
		return true
	case *SSAFieldAddr:
		return isParamDerivedEx(x.X, holders, depth+1)
	case *SSAIndexAddr:
		return isParamDerivedEx(x.X, holders, depth+1)
	case *SSAUnOp:
		if x.Op == OpMul {
			if holders[x.X] {
				return true
			}
			return isParamDerivedEx(x.X, holders, depth+1)
		}
	case *SSAChangeType:
		return isParamDerivedEx(x.X, holders, depth+1)
	case *SSAConvert:
		return isParamDerivedEx(x.X, holders, depth+1)
	case *SSAPhi:
		for _, edge := range x.Edges {
			if isParamDerivedEx(edge, holders, depth+1) {
				return true
			}
		}
	}
	return false
}

func paramRootName(v SSAValue, holders map[SSAValue]bool, depth int32) (name string) {
	if v == nil || depth > 20 {
		return "?"
	}
	switch x := v.(type) {
	case *SSAParameter:
		return x.SSAName()
	case *SSAFieldAddr:
		return paramRootName(x.X, holders, depth+1)
	case *SSAIndexAddr:
		return paramRootName(x.X, holders, depth+1)
	case *SSAUnOp:
		if x.Op == OpMul {
			return paramRootName(x.X, holders, depth+1)
		}
	case *SSAChangeType:
		return paramRootName(x.X, holders, depth+1)
	case *SSAConvert:
		return paramRootName(x.X, holders, depth+1)
	case *SSAPhi:
		for _, edge := range x.Edges {
			n := paramRootName(edge, holders, depth+1)
			if n != "?" {
				return n
			}
		}
	}
	return "?"
}

// markReturnEscapes promotes stack allocas to heap when their address can
// reach a return value.
func markReturnEscapes(f *SSAFunction) {
	derived := map[SSAValue][]*SSAAlloc{}
	stored := map[*SSAAlloc][]*SSAAlloc{}
	mergeInto := func(dst []*SSAAlloc, srcs []*SSAAlloc) ([]*SSAAlloc, bool) {
		didMerge := false
		for _, s := range srcs {
			if s == nil {
				continue
			}
			found := false
			for _, c := range dst {
				if c == s {
					found = true
					break
				}
			}
			if !found {
				dst = mxutil.Ensure(dst, 1)
				push(dst, s)
				didMerge = true
			}
		}
		return dst, didMerge
	}
	for _, b := range f.Blocks {
		for _, instr := range b.Instrs {
			if a, ok := instr.(*SSAAlloc); ok {
				derived[SSAValue(a)] = []*SSAAlloc{a}
			}
		}
	}
	changed := true
	for changed {
		changed = false
		for _, b := range f.Blocks {
			for _, instr := range b.Instrs {
				var dst SSAValue
				var srcs []*SSAAlloc
				switch i := instr.(type) {
				case *SSASlice:
					dst = i
					srcs = derived[i.X]
				case *SSAFieldAddr:
					dst = i
					srcs = derived[i.X]
				case *SSAIndexAddr:
					dst = i
					srcs = derived[i.X]
				case *SSAChangeType:
					dst = i
					srcs = derived[i.X]
				case *SSAConvert:
					dst = i
					srcs = derived[i.X]
				case *SSAMakeInterface:
					dst = i
					srcs = derived[i.X]
				case *SSAPhi:
					dst = i
					for _, edge := range i.Edges {
						srcs = srcs | derived[edge]
					}
				case *SSAUnOp:
					if i.Op == OpMul {
						dst = i
						for _, a := range derived[i.X] {
							srcs = srcs | stored[a]
						}
					}
				case *SSAStore:
					if d := derived[i.Val]; len(d) > 0 {
						for _, a := range derived[i.Addr] {
							ns, ch := mergeInto(stored[a], d)
							if ch {
								stored[a] = ns
								changed = true
							}
						}
					}
				}
				if dst != nil && len(srcs) > 0 {
					nd, ch := mergeInto(derived[dst], srcs)
					if ch {
						derived[dst] = nd
						changed = true
					}
				}
			}
		}
	}
	for _, b := range f.Blocks {
		for _, instr := range b.Instrs {
			r, ok := instr.(*SSAReturn)
			if !ok {
				continue
			}
			for _, res := range r.Results {
				work := derived[res]
				seen := map[*SSAAlloc]bool{}
				for wi := 0; wi < len(work); wi++ {
					a := work[wi]
					if a == nil {
						continue
					}
					if seen[a] {
						continue
					}
					seen[a] = true
					a.Heap = true
					work = work | stored[a]
				}
			}
		}
	}
}


// checkDuplicateCases reports two case clauses of one switch with the same
// constant value. go/types rejects that on the legacy side; stage4 compiled the
// second clause, which can never run. Applies to every package, like
// checkShadowing, because legacy type-checks the stdlib too.
func checkDuplicateCases(p *SSAPackage, files []*syntax.File) {
	if p == nil || p.Pkg == nil || p.Pkg.Scope == nil {
		return
	}
	for _, f := range files {
		if f == nil {
			continue
		}
		for _, d := range f.DeclList {
			fd, ok := d.(*syntax.FuncDecl)
			if !ok || fd.Body == nil {
				continue
			}
			dupCaseStmts(fd.Body.List, p.Pkg.Scope)
		}
	}
}

func dupCaseStmts(list []syntax.Stmt, scope *Scope) {
	for _, s := range list {
		switch st := s.(type) {
		case *syntax.BlockStmt:
			dupCaseStmts(st.List, scope)
		case *syntax.IfStmt:
			if st.Then != nil {
				dupCaseStmts(st.Then.List, scope)
			}
			if st.Else != nil {
				dupCaseStmts([]syntax.Stmt{st.Else}, scope)
			}
		case *syntax.ForStmt:
			if st.Body != nil {
				dupCaseStmts(st.Body.List, scope)
			}
		case *syntax.SwitchStmt:
			dupCaseClauses(st.Body, scope)
			for _, cc := range st.Body {
				if cc != nil {
					dupCaseStmts(cc.Body, scope)
				}
			}
		case *syntax.SelectStmt:
			for _, cc := range st.Body {
				if cc != nil {
					dupCaseStmts(cc.Body, scope)
				}
			}
		}
	}
}

func dupCaseClauses(clauses []*syntax.CaseClause, scope *Scope) {
	seen := map[string]bool{}
	for _, cc := range clauses {
		if cc == nil {
			continue
		}
		var exprs []syntax.Expr
		if l, ok := cc.Cases.(*syntax.ListExpr); ok {
			exprs = l.ElemList
		} else if cc.Cases != nil {
			exprs = []syntax.Expr{cc.Cases}
		}
		for _, e := range exprs {
			cv := tcEvalConstExpr(e, scope, -1)
			if cv == nil {
				continue
			}
			key := dupCaseKey(cv)
			if key == "" {
				continue
			}
			if seen[key] {
				cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
				push(cctx.compileErrors, "duplicate case in switch")
			}
			seen[key] = true
		}
	}
}

// dupCaseKey canonicalises a constant case value so equal values written
// differently (1 and 0x1) compare equal. Only integers key, which is what
// legacy's go/types flags: it accepts duplicate string and bool cases (e.g.
// `case "a", "a":`), so reporting those would be stricter than the reference
// compiler.
func dupCaseKey(cv ConstVal) (k string) {
	if c, ok := cv.(*ConstInt); ok {
		return "i" | irItoa64(c.V)
	}
	return ""
}

// Scope dealloc functions: all no-ops in arena model.
func (e *irEmitter) scopeTrackAlloc(ptrReg string) {}
func (e *irEmitter) scopeBeforeReturn(r *SSAReturn) {}
func (e *irEmitter) emitScopeFreesAt(scopeID int32) {}
func (e *irEmitter) emitScopeRelocateOnStore(s *SSAStore, val, valType string) {}
