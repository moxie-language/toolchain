// -- Terminator instructions --

// Cover.
//
// A statement boundary recorded by -cover: the emitter turns it into a call to
// runtime.coverHit with a site named "pkg.Func@file:line". Statement granularity
// rather than block granularity because a stage4 instruction carries no source
// position while the statement being built does, and block-creation lines label
// a block with the statement that opened it rather than the one it runs.
type SSACoverHit struct {
	ssaInstr
	Line int32
}

func (h *SSACoverHit) InstrPos() (n int32)      { return 0 }
func (h *SSACoverHit) InstrString() (s string)  { return "cover" }

