// ConstMemCpy: fill Dst (pointer to an array) by copying a private
// constant global. Replaces per-element stores for large all-constant
// array literals whose expansion would explode a single basic block
// (e.g. nistec's 88064-byte p256 table).
type SSAConstMemCpy struct {
	ssaInstr
	Dst       SSAValue
	ConstText string // "[N x iK] [iK v, iK v, ...]"
	Bytes     int64
	pos       int32
}

func (m *SSAConstMemCpy) InstrPos() (n int32) { return m.pos }
func (m *SSAConstMemCpy) InstrString() (s string) { return "constmemcpy" }

