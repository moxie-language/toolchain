}

func (f *SSAFieldAddr) InstrPos() (n int32) { return f.pos }
func (f *SSAFieldAddr) InstrString() (s string) { return "fieldaddr" }

// IndexAddr.
type SSAIndexAddr struct {
	ssaRegister
	X     SSAValue
	Index SSAValue
	// accessed is set when this address is used to load or store an element,
	// directly or through a field/element chain. Only then is the index
	// bounds-checked: forming an address is pointer arithmetic (legacy:
	// addressIsElementAccess).
	accessed bool
	// byteStep marks pointer arithmetic that steps one byte per index
	// (unsafe.Add). Its declared result is unsafe.Pointer, whose base type is
	// ArbitraryType/int32, so the emitter cannot derive the byte step from
	// the value type and must not try.
	byteStep bool
}

func (i *SSAIndexAddr) InstrPos() (n int32) { return i.pos }
func (i *SSAIndexAddr) InstrString() (s string) { return "indexaddr" }

