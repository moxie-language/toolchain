// Operator mapping from syntax.Operator to SSAOp.
func syntaxOpToSSAOp(op token.Operator, unary bool) (s SSAOp) {
	if unary {
		switch op {
		case token.Not:
			return OpNot
		case token.Recv:
			return OpArrow
		case token.And:
			return OpAnd
		case token.Mul:
			return OpMul
		case token.Sub:
			return OpSub
		case token.Xor:
			return OpXor
		}
	}
	switch op {
	case token.Add:
		return OpAdd
	case token.Or:
		return OpOr
	case token.Sub:
		return OpSub
	case token.Mul:
		return OpMul
	case token.Div:
		return OpQuo
	case token.Rem:
		return OpRem
	case token.And:
		return OpAnd
	case token.Xor:
		return OpXor
	case token.Shl:
		return OpShl
	case token.Shr:
		return OpShr
	case token.AndNot:
		return OpAndNot
	case token.OrOr:
		return OpLor
	case token.AndAnd:
		return OpLand
	case token.Eql:
		return OpEql
	case token.Neq:
		return OpNeq
	case token.Lss:
		return OpLss
	case token.Leq:
		return OpLeq
	case token.Gtr:
		return OpGtr
	case token.Geq:
		return OpGeq
	}
	return OpIllegal
}

func compoundOp(op token.Operator) (s SSAOp) {
	switch op {
	case token.Add:
		return OpAdd
	case token.Or:
		return OpOr
	case token.Sub:
		return OpSub
	case token.Mul:
		return OpMul
	case token.Div:
		return OpQuo
	case token.Rem:
		return OpRem
	case token.And:
		return OpAnd
	case token.Xor:
		return OpXor
	case token.Shl:
		return OpShl
	case token.Shr:
		return OpShr
	case token.AndNot:
		return OpAndNot
	}
	return OpIllegal
}

func ssaBuiltinID(name string) (id BuiltinID, found bool) {
	switch name {
	case "cap":
		return BuiltinCap, true
	case "clear":
		return BuiltinClear, true
	case "close":
		return BuiltinClose, true
	case "copy":
		return BuiltinCopy, true
	case "delete":
		return BuiltinDelete, true
	case "len":
		return BuiltinLen, true
	case "__slicealloc":
		return BuiltinMake, true
	case "__moxie_append":
		return BuiltinAppend, true
	case "max":
		return BuiltinMax, true
	case "min":
		return BuiltinMin, true
	case "__ptralloc":
		return BuiltinNew, true
	case "panic":
		return BuiltinPanic, true
	case "print":
		return BuiltinPrint, true
	case "println":
		return BuiltinPrintln, true
	case "recover":
		return BuiltinRecover, true
	case "spawn":
		return BuiltinSpawn, true
	case "push":
		return BuiltinPush, true
	case "pop":
		return BuiltinPop, true
	case "resize":
		return BuiltinResize, true
	}
	return 0, false
}

func ssaItoa(n int32) (s string) {
	if n == 0 {
		return "0"
	}
	neg := n < 0
	if neg {
		n = -n
	}
	buf := []byte{:0:20}
	for n > 0 {
		buf = mxutil.Ensure(buf, 1)
		push(buf, byte('0'+n%10))
		n /= 10
	}
	if neg {
		buf = mxutil.Ensure(buf, 1)
		push(buf, '-')
	}
	for i, j := 0, len(buf)-1; i < j; i, j = i+1, j-1 {
		buf[i], buf[j] = buf[j], buf[i]
	}
	return string(buf)
}

// Type helpers for SSA builder.
func ssaElemType(t Type) (tv Type) {
	if t == nil {
		return nil
	}
	switch u := SafeUnderlying(t).(type) {
	case *Slice:
		return u.Elem
	case *Array:
		return u.Elem
	case *TCMap:
		return u.Elem
	case *Pointer:
		return u.Base
	case *Basic:
		if u.Info&IsString != 0 {
			return Typ[Uint8]
		}
	}
	return nil
}

// ssaIndexElemType returns the element type produced by indexing t. For a
// pointer to an array or slice, ssaElemType returns the pointee (the array or
// the slice header) rather than its element, so table[i].field on *[N]T looked
// the field up on the array type and failed - silently, until the selector
// check was added.
func ssaIndexElemType(t Type) (tv Type) {
	if t == nil {
		return nil
	}
	if p, ok := SafeUnderlying(t).(*Pointer); ok {
		switch u := SafeUnderlying(p.Base).(type) {
		case *Array:
			return u.Elem
		case *Slice:
			return u.Elem
		}
	}
	return ssaElemType(t)
}

func ssaChanElemType(t Type) (tv Type) {
	if t == nil {
		return nil
	}
	if ch, ok := SafeUnderlying(t).(*TCChan); ok {
		return ch.Elem
	}
	return nil
}

func ssaIsStringType(t Type) (ok bool) {
	if t == nil {
		return false
	}
	if b, _ := SafeUnderlying(t).(*Basic); b != nil {
		return b.Info&IsString != 0
	}
	return false
}

func ssaSliceOf(t Type) (tv Type) {
	if t == nil {
		return nil
	}
	if b, ok := SafeUnderlying(t).(*Basic); ok && b.Info&IsString != 0 {
		return t
	}
	switch u := SafeUnderlying(t).(type) {
	case *Slice:
		// Slicing a slice keeps its type, named or not: x[1:], where x has a
		// named slice type, still has that type. Returning the underlying
		// slice dropped the name, so a method call on the result resolved to
		// nothing and the caller silently passed one argument fewer.
		return t
	case *Array:
		if b, _ := u.Elem.(*Basic); b != nil && b.Kind == Uint8 {
			return Typ[TCString]
		}
		return NewSlice(u.Elem)
	case *Pointer:
		if u.Base != nil {
			return ssaSliceOf(u.Base)
		}
	}
	return Typ[TCString]
}

func ssaTupleElemType(t Type, i int32) (tv Type) {
	if t == nil {
		return nil
	}
	if tup, ok := t.(*Tuple); ok && i < tup.Len() {
		return tup.At(i).Typ
	}
	return nil
}

func ssaParseInt64(s string) (n int64) {
	for i := 0; i < len(s); i++ {
		c := s[i]
		if c < '0' || c > '9' {
			break
		}
		n = n*10 + int64(c-'0')
	}
	return n
}
