package main

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	. "git.smesh.lol/moxie/pkg/types"
)

func (e *irEmitter) emitMakeInterface(m *SSAMakeInterface) {
	reg := e.regName(m)
	val := e.operand(m.X)
	valType := e.llvmType(m.X.SSAType())
	ity := e.ifaceType()
	if m.IType != nil {
		e.keepIfaceImpls(m.IType)
	}
	if valType == "void" {
		ipt := e.intptrType()
		e.w("  ") ; e.w(reg) ; e.w(" = insertvalue ") ; e.w(ity) ; e.w(" zeroinitializer, " | ipt | " 0, 0\n")
		return
	}
	if _, isAlloc := m.X.(*SSAAlloc); !isAlloc {
		if _, isIA := m.X.(*SSAIndexAddr); !isIA {
			if at, ok := e.allocTypes[m.X]; ok && at != "ptr" && at != "void" {
				valType = at
			}
		}
	}
	if valType == ity {
		tp := e.nextReg2("mi")
		e.w("  ") ; e.w(tp) ; e.w(" = extractvalue ") ; e.w(ity) ; e.w(" ") ; e.w(val) ; e.w(", 0\n")
		dp := e.nextReg2("mi")
		e.w("  ") ; e.w(dp) ; e.w(" = extractvalue ") ; e.w(ity) ; e.w(" ") ; e.w(val) ; e.w(", 1\n")
		t1a := e.nextReg2("mi")
		ipt := e.intptrType()
		e.w("  ") ; e.w(t1a) ; e.w(" = insertvalue ") ; e.w(ity) ; e.w(" undef, " | ipt | " ") ; e.w(tp) ; e.w(", 0\n")
		e.w("  ") ; e.w(reg) ; e.w(" = insertvalue ") ; e.w(ity) ; e.w(" ") ; e.w(t1a) ; e.w(", ptr ") ; e.w(dp) ; e.w(", 1\n")
		return
	}
	var valPtr string
	if valType == "ptr" {
		valPtr = val
	} else if e.isScalarType(valType) && e.ifaceInlineWidth(valType) > 0 && e.ifaceInlineWidth(valType) <= e.intBits(e.intptrType()) {
		// A value that fits in a pointer is stored INLINE in the value
		// slot. The shared codec (codecEncodeValue KindInterface) and the
		// legacy compiler's emitPointerPack both define the representation
		// that way, so boxing here made the codec copy the box pointer as
		// if it were the value: after relocation the interface pointed at
		// a box in the source frame's arena, which then died with it.
		valPtr = e.emitInlineToPtr(valType, val, "mi")
	} else {
		ipt := e.intptrType()
		sz := e.nextReg2("ha")
		e.w("  ") ; e.w(sz) ; e.w(" = ptrtoint ptr getelementptr (") ; e.w(valType) ; e.w(", ptr null, i32 1) to ") ; e.w(ipt) ; e.w("\n")
		valPtr = e.nextReg2("mi")
		e.w("  ") ; e.w(valPtr) ; e.w(" = call ptr @runtime.alloc(") ; e.w(ipt) ; e.w(" ") ; e.w(sz) ; e.w(", ptr null, ptr null)\n")
		e.w("  store ") ; e.w(valType) ; e.w(" ") ; e.w(val) ; e.w(", ptr ") ; e.w(valPtr) ; e.w("\n")
		e.declareRuntime("runtime.alloc", "ptr", ipt | ", ptr")
	}
	typeid := e.typeIDHash(m.X.SSAType())
	t1 := e.nextReg2("mi")
	e.w("  ") ; e.w(t1) ; e.w(" = insertvalue " | e.ifaceType() | " undef, " | e.intptrType() | " ") ; e.w(typeid) ; e.w(", 0\n")
	e.w("  ") ; e.w(reg) ; e.w(" = insertvalue " | e.ifaceType() | " ") ; e.w(t1) ; e.w(", ptr ") ; e.w(valPtr) ; e.w(", 1\n")
}

// ifaceInlineWidth returns the bit width of a concrete value that the
// interface representation stores INLINE in the value slot, or 0 when the
// value is stored out of line behind a pointer. The rule mirrors the
// legacy compiler's emitPointerPack and the shared codec's
// codecEncodeValue KindInterface: anything no wider than a pointer is the
// data itself; pointers pass through unchanged.
func (e *irEmitter) ifaceInlineWidth(lt string) (bits int32) {
	if lt == "float" {
		return 32
	}
	if lt == "double" {
		return 64
	}
	ib := e.intBits(lt)
	return ib
}

// emitInlineToPtr stores an inline concrete value in the interface value
// slot by reinterpreting it as a pointer, exactly as emitPointerPack does.
func (e *irEmitter) emitInlineToPtr(lt, val, prefix string) (reg string) {
	ipt := e.intptrType()
	reg = e.nextReg2(prefix)
	if lt == "float" && e.intBits(ipt) >= 32 {
		ib := e.nextReg2(prefix)
		e.w("  ") ; e.w(ib) ; e.w(" = bitcast float ") ; e.w(val) ; e.w(" to i32\n")
		ext := ib
		if e.intBits(ipt) > 32 {
			ext = e.nextReg2(prefix)
			e.w("  ") ; e.w(ext) ; e.w(" = zext i32 ") ; e.w(ib) ; e.w(" to ") ; e.w(ipt) ; e.w("\n")
		}
		e.w("  ") ; e.w(reg) ; e.w(" = inttoptr ") ; e.w(ipt) ; e.w(" ") ; e.w(ext) ; e.w(" to ptr\n")
		return reg
	}
	if lt == "double" && e.intBits(ipt) >= 64 {
		ib := e.nextReg2(prefix)
		e.w("  ") ; e.w(ib) ; e.w(" = bitcast double ") ; e.w(val) ; e.w(" to ") ; e.w(ipt) ; e.w("\n")
		e.w("  ") ; e.w(reg) ; e.w(" = inttoptr ") ; e.w(ipt) ; e.w(" ") ; e.w(ib) ; e.w(" to ptr\n")
		return reg
	}
	if e.intBits(lt) == e.intBits(ipt) {
		e.w("  ") ; e.w(reg) ; e.w(" = inttoptr ") ; e.w(ipt) ; e.w(" ") ; e.w(val) ; e.w(" to ptr\n")
		return reg
	}
	extw := e.nextReg2(prefix)
	e.w("  ") ; e.w(extw) ; e.w(" = zext ") ; e.w(lt) ; e.w(" ") ; e.w(val) ; e.w(" to ") ; e.w(ipt) ; e.w("\n")
	e.w("  ") ; e.w(reg) ; e.w(" = inttoptr ") ; e.w(ipt) ; e.w(" ") ; e.w(extw) ; e.w(" to ptr\n")
	return reg
}

// emitInlineFromPtr extracts an inline concrete value from an interface
// value slot. The mirror of emitInlineToPtr.
func (e *irEmitter) emitInlineFromPtr(lt, valPtr, prefix string) (s string) {
	ipt := e.intptrType()
	iv := e.nextReg2(prefix)
	e.w("  ") ; e.w(iv) ; e.w(" = ptrtoint ptr ") ; e.w(valPtr) ; e.w(" to ") ; e.w(ipt) ; e.w("\n")
	if lt == "float" && e.intBits(ipt) >= 32 {
		t32 := iv
		if e.intBits(ipt) > 32 {
			t32 = e.nextReg2(prefix)
			e.w("  ") ; e.w(t32) ; e.w(" = trunc ") ; e.w(ipt) ; e.w(" ") ; e.w(iv) ; e.w(" to i32\n")
		}
		s = e.nextReg2(prefix)
		e.w("  ") ; e.w(s) ; e.w(" = bitcast i32 ") ; e.w(t32) ; e.w(" to float\n")
		return s
	}
	if lt == "double" && e.intBits(ipt) >= 64 {
		s = e.nextReg2(prefix)
		e.w("  ") ; e.w(s) ; e.w(" = bitcast ") ; e.w(ipt) ; e.w(" ") ; e.w(iv) ; e.w(" to double\n")
		return s
	}
	if e.intBits(lt) == e.intBits(ipt) {
		return iv
	}
	s = e.nextReg2(prefix)
	e.w("  ") ; e.w(s) ; e.w(" = trunc ") ; e.w(ipt) ; e.w(" ") ; e.w(iv) ; e.w(" to ") ; e.w(lt) ; e.w("\n")
	return s
}

// materializeIfaceValue returns a pointer to the concrete data behind an
// interface value slot. An inline value (fits in a pointer) is unpacked
// into a fresh alloca; anything else already is that pointer.
func (e *irEmitter) materializeIfaceValue(t Type, valPtr string) (reg string) {
	if t == nil {
		return valPtr
	}
	lt := e.llvmType(t)
	w := e.ifaceInlineWidth(lt)
	if w <= 0 || w > e.intBits(e.intptrType()) {
		return valPtr
	}
	v := e.emitInlineFromPtr(lt, valPtr, "ifv")
	reg = e.nextReg2("ifa")
	e.w("  ") ; e.w(reg) ; e.w(" = alloca ") ; e.w(lt) ; e.w("\n")
	e.w("  store ") ; e.w(lt) ; e.w(" ") ; e.w(v) ; e.w(", ptr ") ; e.w(reg) ; e.w("\n")
	return reg
}

// typeIDHash returns the interface type-ID for t: the descriptor pointer
// (as an integer constant) for the type's reflect/types.type: global. The
// arena codec and interface dispatch both interpret the typecode as a
// descriptor pointer, matching the legacy compiler's model.
func (e *irEmitter) typeIDHash(t Type) (s string) {
	if t == nil {
		return e.intptrType() | " 0"
	}
	tail := e.typeDescName(t)
	if _, isIface := t.(*TCInterface); !isIface {
		e.collectTypeDesc(t)
	}
	return "ptrtoint (ptr " | irQuoteName("reflect/types.type:" | tail) | " to " | e.intptrType() | ")"
}

// typeIDHashI64 returns the type-ID as an intptr-typed operand.
func (e *irEmitter) typeIDHashI64(t Type) (s string) {
	return e.typeIDHash(t)
}

// builtinStringerTypes returns the concrete builtin types whose String()
// body the runtime provides: every predeclared basic kind, plus the universe
// named types byte, rune and uintptr.
func builtinStringerTypes() (ts []Type) {
	ts = []Type{
		Typ[Bool],
		Typ[Int8], Typ[Int16], Typ[Int32], Typ[Int64],
		Typ[Uint8], Typ[Uint16], Typ[Uint32], Typ[Uint64],
		Typ[Float32], Typ[Float64],
		Typ[TCString],
	}
	if Universe == nil {
		return ts
	}
	// byte and rune are named aliases of uint8 and int32; uintptr is a named
	// type over the pointer-sized integer. See builtinAliasName.
	for _, n := range []string{"byte", "rune", "uintptr"} {
		obj := Universe.Lookup(n)
		if obj == nil {
			continue
		}
		tn, ok := obj.(*TypeName)
		if !ok || tn.Typ == nil {
			continue
		}
		ts = mxutil.Ensure(ts, 1)
		push(ts, tn.Typ)
	}
	return ts
}

// builtinAliasName returns the name the runtime declares String() under. In
// Go (and therefore in the legacy compiler's go/types) byte and rune are
// aliases of uint8 and int32, so the runtime declares only the underlying
// methods; stage4 models them as named types over the same kinds and maps the
// name here.
func builtinAliasName(name string) (s string) {
	switch name {
	case "byte":
		return "uint8"
	case "rune":
		return "int32"
	}
	return name
}

// builtinStringSig returns the String() signature declared on a builtin
// type's method set, or nil when it declares none.
func builtinStringSig(t Type) (s *Signature) {
	switch tt := t.(type) {
	case *Basic:
		for i := int32(0); i < tt.NumMethods(); i++ {
			if m := tt.Method(i); m.Name == "String" {
				return m.Signature()
			}
		}
	case *Named:
		for i := int32(0); i < tt.NumMethods(); i++ {
			if m := tt.Method(i); m.Name == "String" {
				return m.Signature()
			}
		}
	}
	return nil
}

func normalizePkgPath(pkgPath string) (s string) {
	// Strip module prefix for consistent type IDs.
	// The module root is git.smesh.lol/moxie/ - strip it so paths
	// like "git.smesh.lol/moxie/pkg/types" become "pkg/types".
	prefix := "git.smesh.lol/moxie/"
	if mxutil.HasPrefix(pkgPath, prefix) {
		return pkgPath[len(prefix):]
	}
	return pkgPath
}

func (e *irEmitter) reflectTypeName(t Type) (s string) {
	return "reflect/types.type:" | e.typeDescName(t)
}

// keepIfaceImpls records that a value is being boxed into a non-empty
// interface. Interface dispatch in OTHER modules references this module's
// implementation methods only via extern_weak declarations, and --gc-sections
// drops weak-referenced sections even when this package IS linked - so a
// main-defined concrete type's Read was silently removed and every dispatch
// arm for it fell through to "no impl". Record the interface in a pend list
// (fn-arena) and at module tail emit an llvm.used entry for each matching
// same-module method, keeping it reachable from the GC root.
func (e *irEmitter) keepIfaceImpls(ifaceType Type) {
	it, ok := SafeUnderlying(ifaceType).(*TCInterface)
	if !ok || it.IsEmpty() || it.NumMethods() == 0 {
		return
	}
	e.pendKeepIface = mxutil.Ensure(e.pendKeepIface, 1)
	push(e.pendKeepIface, ifaceType)
}

// emitKeepIfaceUsed writes @llvm.used entries (strong relocations that keep
// sections alive under --gc-sections) for this module's methods that can
// implement any recorded non-empty interface. Runs at module tail with the
// compile arena current, so the map backings are safe.
//
// The match is on SHAPE, not on name. A method implements an interface method
// when it has that method's name AND shape, and the two are independent
// questions; the name-keyed scan this replaces could only answer the first.
// The shape scan keeps a method with the interface method's exact parameter
// and result types whatever it is called.
//
// This is deliberately a superset - a same-shaped method is kept whether or
// not its receiver type is ever boxed into that interface. The cost is a few
// bytes of llvm.used. The alternative, knowing by name which methods
// implement an interface, is the question this pass exists to answer, and a
// missing keep is not a missed optimization: --gc-sections deletes the
// definition, the invoking module's extern_weak reference resolves null, and
// its dispatch arm falls through to the zero-init default - a call that
// silently returns zero values instead of reaching the method.
func (e *irEmitter) emitKeepIfaceUsed() {
	if len(e.keepIfaceTypes) == 0 {
		return
	}
	seenIf := map[string]bool{}
	var sigs []*Signature
	var syms []string
	seenSym := map[string]bool{}
	for _, ift := range e.keepIfaceTypes {
		it, ok := SafeUnderlying(ift).(*TCInterface)
		if !ok || it.IsEmpty() || it.NumMethods() == 0 {
			continue
		}
		key := e.typeDescName(ift)
		if seenIf[key] {
			continue
		}
		seenIf[key] = true
		for mi := int32(0); mi < it.NumMethods(); mi++ {
			im := it.Method(mi)
			if im == nil || im.Sig == nil {
				continue
			}
			sigs = mxutil.Ensure(sigs, 1)
			push(sigs, im.Sig)
		}
	}
	if len(sigs) == 0 {
		return
	}
	for _, mv := range e.pkg.Members {
		fn, isFn := mv.(*SSAFunction)
		if !isFn || fn == nil || fn.Signature == nil {
			continue
		}
		if fn.object == nil {
			continue
		}
		matched := false
		for _, sig := range sigs {
			if e.sigMatchesIfaceMethod(fn.Signature, sig) {
				matched = true
				break
			}
		}
		if !matched {
			continue
		}
		sym := e.funcSymbol(fn)
		if mxutil.HasPrefix(sym, "@__mxc_nil_func") || seenSym[sym] {
			continue
		}
		seenSym[sym] = true
		syms = mxutil.Ensure(syms, 1)
		push(syms, sym)
	}
	if len(syms) == 0 {
		return
	}
	e.w("\n@llvm.used = appending global [" | irItoa(len(syms)) | " x ptr] [")
	for i, s2 := range syms {
		if i > 0 {
			e.w(", ")
		}
		e.w("ptr ") ; e.w(s2)
	}
	e.w("]\n")
}

// sigMatchesIfaceMethod reports whether a member's signature has the shape of
// an interface method's. Parameter counts must agree: the interface method's
// signature has no receiver, and a method's SSA signature does not carry one
// either (emitInvoke receives the receiver as a separate argument). A
// receiver-less function whose parameters happen to match is kept too, which
// is harmless - llvm.used only stops the linker discarding a definition.
func (e *irEmitter) sigMatchesIfaceMethod(cand, sig *Signature) (ok bool) {
	if cand == nil || sig == nil {
		return false
	}
	if e.llvmType(cand.Results) != e.llvmType(sig.Results) {
		return false
	}
	in := int32(0)
	if sig.Params != nil {
		in = int32(sig.Params.Len())
	}
	cn := int32(0)
	if cand.Params != nil {
		cn = int32(cand.Params.Len())
	}
	if cn != in {
		return false
	}
	for pi := int32(0); pi < in; pi++ {
		if e.llvmType(sig.Params.At(pi).Typ) != e.llvmType(cand.Params.At(pi).Typ) {
			return false
		}
	}
	return true
}

func (e *irEmitter) findIfaceImpls(methodName string) (ss []ifaceImpl) {
	var impls []ifaceImpl
	hasType := map[string]bool{}
	var mkeys []string
	for k := range e.pkg.Members {
		mkeys = mxutil.Ensure(mkeys, 1)
		push(mkeys, k)
	}
	for i := 1; i < len(mkeys); i++ {
		for j := i; j > 0 && mkeys[j] < mkeys[j-1]; j-- {
			mkeys[j], mkeys[j-1] = mkeys[j-1], mkeys[j]
		}
	}
	for mki := 0; mki < len(mkeys); mki++ {
		mname := mkeys[mki]
		m := e.pkg.Members[mname]
		fn, ok := m.(*SSAFunction)
		if !ok {
			continue
		}
		dotIdx := -1
		for i := len(mname) - 1; i >= 0; i-- {
			if mname[i] == '.' {
				dotIdx = i
				break
			}
		}
		if dotIdx < 0 {
			continue
		}
		mpart := mname[dotIdx+1:]
		if mpart != methodName {
			continue
		}
		tname := mname[:dotIdx]
		// Handle SSA naming like (*File).Write: extract File from (*File)
		if len(tname) >= 3 && tname[0] == '(' && tname[len(tname)-1] == ')' {
			inner := tname[1 : len(tname)-1]
			if len(inner) >= 1 && inner[0] == '*' {
				tname = inner[1:]
			} else {
				tname = inner
			}
		}
		looked := e.pkg.Pkg.Scope.Lookup(tname)
		if looked == nil {
			continue
		}
		tn, ok2 := looked.(*TypeName)
		if !ok2 || tn.Typ == nil {
			continue
		}
		if gn, okg := tn.Typ.(*Named); okg && len(gn.TParams) > 0 {
			continue
		}
		isPtrRecv := fn.object != nil && fn.object.PtrRecv
		recvT := tn.Typ
		if isPtrRecv {
			recvT = NewPointer(recvT)
		}
		impls = mxutil.Ensure(impls, 1)
		push(impls, ifaceImpl{fn: fn, recvType: recvT, ptrRecv: isPtrRecv})
		if !isPtrRecv {
			// *T's method set includes T's value-receiver methods, and a
			// value boxed for an interface that needs both a value- and a
			// pointer-receiver method (moxie.Codec: EncodeTo/DecodeFrom) is
			// boxed as *T. Without this arm the dispatch falls through to
			// "no impl for EncodeTo". The cross-package scan below adds the
			// same arm for imported types.
			impls = mxutil.Ensure(impls, 1)
			push(impls, ifaceImpl{fn: fn, recvType: NewPointer(tn.Typ), ptrRecv: false})
		} else {
			// Moxie bans value receivers, so pkg/types keeps a
			// pointer-receiver method in T's method set as well as *T's. A
			// value boxed as T (typeID named:...T, an inline scalar in the
			// value slot) must dispatch too, on the copy that
			// materializeIfaceValue materializes out of the slot.
			impls = mxutil.Ensure(impls, 1)
			push(impls, ifaceImpl{fn: fn, recvType: tn.Typ, ptrRecv: false})
		}
		hasType[tname] = true
	}
	scopeNames := e.pkg.Pkg.Scope.Names()
	for sni := 0; sni < len(scopeNames); sni++ {
		sname := scopeNames[sni]
		tn2, ok4 := e.pkg.Pkg.Scope.Lookup(sname).(*TypeName)
		if !ok4 || tn2.Typ == nil {
			continue
		}
		if gn2, okg2 := tn2.Typ.(*Named); okg2 && len(gn2.TParams) > 0 {
			continue
		}
		if hasType[sname] {
			continue
		}
		chain, fn, embedT := e.findEmbedMethod(tn2.Typ, methodName, 0)
		if fn != nil {
			isPtrRecv := fn.object != nil && fn.object.PtrRecv
			impls = mxutil.Ensure(impls, 1)
			push(impls, ifaceImpl{
				fn:         fn,
				recvType:   NewPointer(tn2.Typ),
				ptrRecv:    isPtrRecv,
				embedField: chain[0],
				embedType:  embedT,
				embedChain: chain,
			})
			// The value form is in T's method set either way (pkg/types keeps
			// pointer-receiver methods there too), and materializeIfaceValue
			// hands emitEmbedChainGEP a pointer to a copy of T.
			impls = mxutil.Ensure(impls, 1)
			push(impls, ifaceImpl{
				fn:         fn,
				recvType:   tn2.Typ,
				ptrRecv:    false,
				embedField: chain[0],
				embedType:  embedT,
				embedChain: chain,
			})
			hasType[sname] = true
		} else if chain2, ifaceT2, isig2 := findEmbedIfaceMethod(tn2.Typ, methodName, 0); isig2 != nil {
			impls = mxutil.Ensure(impls, 1)
			push(impls, ifaceImpl{
				recvType:   NewPointer(tn2.Typ),
				ptrRecv:    true,
				embedField: chain2[0],
				embedType:  ifaceT2,
				embedChain: chain2,
				embedIface: true,
				extSig:     isig2,
			})
			impls = mxutil.Ensure(impls, 1)
			push(impls, ifaceImpl{
				recvType:   tn2.Typ,
				ptrRecv:    false,
				embedField: chain2[0],
				embedType:  ifaceT2,
				embedChain: chain2,
				embedIface: true,
				extSig:     isig2,
			})
			hasType[sname] = true
		}
	}
	// Monomorphized METHOD clones: "<defpkg>.(*T).M__<typeargs>", emitted into
	// THIS module as members of this package. The scans above enumerate type
	// DECLARATIONS and skip a generic declaration because its methods are never
	// emitted as standalone symbols, so a value boxed as an instantiation
	// matched no arm at all: the dispatch fell through to the zero value, and
	// the HMAC-DRBG generated 32 zero bytes so randomPoint retried forever.
	// The clone's own signature carries the substituted receiver, recorded in
	// genericMethodInsts when the clone was built.
	for mki2 := 0; mki2 < len(mkeys); mki2++ {
		mname2 := mkeys[mki2]
		fn2, okf := e.pkg.Members[mname2].(*SSAFunction)
		if !okf || fn2 == nil || fn2.Signature == nil || fn2.Signature.Recv == nil {
			continue
		}
		if !strContains(mname2, "." | methodName | "__") {
			continue
		}
		recvT := cctx.genericMethodInsts[e.pkg.Pkg.Path | "|" | mname2]
		if recvT == nil {
			continue
		}
		impls = mxutil.Ensure(impls, 1)
		push(impls, ifaceImpl{fn: fn2, recvType: recvT, ptrRecv: true})
	}
	selfPath := normalizePkgPath(e.pkg.Pkg.Path)
	var importedPkgs []*TCPackage
	seenPkg := map[string]bool{}
	// Explicit import list first: scope scanning misses imports that lost
	// a local-name collision (imports are file-scoped).
	for _, ip := range e.pkg.Pkg.Imports {
		if seenPkg[ip.Path] {
			continue
		}
		importedPkgs = mxutil.Ensure(importedPkgs, 1)
		push(importedPkgs, ip)
		seenPkg[ip.Path] = true
	}
	scopeNames2 := e.pkg.Pkg.Scope.Names()
	for sni2 := 0; sni2 < len(scopeNames2); sni2++ {
		obj := e.pkg.Pkg.Scope.Lookup(scopeNames2[sni2])
		pn, ok := obj.(*PkgName)
		if !ok || pn.Imported == nil || seenPkg[pn.Imported.Path] {
			continue
		}
		importedPkgs = mxutil.Ensure(importedPkgs, 1)
		push(importedPkgs, pn.Imported)
		seenPkg[pn.Imported.Path] = true
	}
	// The build is two-phase: every package in the link set is type-checked
	// (TypeCheckOnly/loadMxh) before any package is emitted, so the registry
	// holds the whole link set here. Scan it all: an interface parameter can
	// receive values of any type in the link, including types from packages
	// downstream of this one (io.ReadFull dispatching Read on a
	// crypto/rand.reader). Cross-package impl symbols are declared
	// extern_weak (see declareExtInvoke): a link reusing this package's
	// cached .bc without some impl's package resolves the weak ref to null,
	// and that dispatch arm is dead there because no make-interface site can
	// produce the matching type-ID without the defining package linked.
	// moxie/runtime/unsafe are runtime-provided (legacy symbol mangling,
	// local linkage) and never linkable.
	var regPaths []string
	for rPath := range cctx.universe.Registry {
		// The mxh-derived index says which packages declare the invoked method.
		// A package that declares none cannot supply an impl, so it is skipped
		// without being materialised. Absent index data - a worker process, or
		// a path that never went through the pre-pass - means no skip, so the
		// scan stays complete wherever the index is not populated.
		if m := cctx.dispMethodsByPkg[rPath]; m != nil && !m[methodName] {
			continue
		}
		regPaths = mxutil.Ensure(regPaths, 1)
		push(regPaths, rPath)
	}
	for i := 1; i < len(regPaths); i++ {
		for j := i; j > 0 && regPaths[j] < regPaths[j-1]; j-- {
			regPaths[j], regPaths[j-1] = regPaths[j-1], regPaths[j]
		}
	}
	for rpi := 0; rpi < len(regPaths); rpi++ {
		rPath := regPaths[rpi]
		rPkg := cctx.universe.Registry[rPath]
		if rPkg == nil || seenPkg[rPath] {
			continue
		}
		if rPath == "runtime" || rPath == "unsafe" {
			continue
		}
		importedPkgs = mxutil.Ensure(importedPkgs, 1)
		push(importedPkgs, rPkg)
	}
	for ipi := 0; ipi < len(importedPkgs); ipi++ {
		ipkg := importedPkgs[ipi]
		fullPath := ipkg.Path
		pkgPath := normalizePkgPath(fullPath)
		if pkgPath == selfPath {
			continue
		}
		if ipkg.Scope == nil {
			continue
		}
		names := ipkg.Scope.Names()
		for ni := 0; ni < len(names); ni++ {
			tname := names[ni]
			tn3, ok7 := ipkg.Scope.Lookup(tname).(*TypeName)
			if !ok7 || tn3.Typ == nil {
				continue
			}
			named3, ok8 := tn3.Typ.(*Named)
			if !ok8 {
				continue
			}
			// Generic types' methods are never emitted as standalone symbols
			// (monomorphization only); a direct extern call would be undefined.
			if len(named3.TParams) > 0 {
				continue
			}
			// The method and its typeID belong to the type's DEFINING
			// package and name, not to the package whose scope spelled it.
			// An alias (`type PathError = fs.PathError`, recorded in the mxh
			// as the target's qualified name) is found in os's scope but is
			// io/fs's type: emitting os.PathError here would reference a
			// descriptor nobody defines and a symbol nobody emits.
			defPath := fullPath
			defName := tname
			if named3.Obj != nil && named3.Obj.Pkg != nil {
				defPath = named3.Obj.Pkg.Path
				defName = named3.Obj.Name
			}
			found := false
			for mi := 0; mi < named3.NumMethods(); mi++ {
				m := named3.Method(mi)
				if m.Name != methodName {
					continue
				}
				isPR := m.PtrRecv
				sym := defPath | ".(*" | defName | ")." | methodName
				normPath := normalizePkgPath(defPath)
				ptid := "reflect/types.type:pointer:named:" | normPath | "." | defName
				vtid := "reflect/types.type:named:" | normPath | "." | defName
				msig := m.Signature()
				// Moxie's all-ptr-receiver ABI: all methods receive a pointer.
				// The interface stores the pointer itself for pointer types, so
				// a pointer-receiver method's recvType must be *T. Handing
				// materializeIfaceValue the value type made it unpack the slot
				// as an inline scalar and truncate the real pointer: a named
				// basic over int32 lost its top 32 bits and the callee read the
				// low half of its own address. A value-receiver method is also
				// in *T's set (Go promotion), and the compiler boxes &v for the
				// Codec interface's EncodeTo.
				impls = mxutil.Ensure(impls, 1)
				push(impls, ifaceImpl{
					recvType:  NewPointer(tn3.Typ),
					ptrRecv:   isPR,
					extSymbol: sym,
					extTypeID: ptid,
					extSig:    msig,
				})
				// The value form. In T's set for a value-receiver method by
				// Go's rules; for a pointer-receiver method because Moxie bans
				// value receivers, so pkg/types keeps the method in the value's
				// set too. The value slot then holds an inline scalar and the
				// callee runs on the copy materializeIfaceValue makes.
				impls = mxutil.Ensure(impls, 1)
				push(impls, ifaceImpl{
					recvType:  tn3.Typ,
					ptrRecv:   false,
					extSymbol: sym,
					extTypeID: vtid,
					extSig:    msig,
				})
				found = true
			}
			if !found {
				// The promoted method is looked up through the type's own
				// package: an alias's embed chain lives in the target type.
				chain, embedSym, embedSig, embedT := findExtEmbedMethod(named3, normalizePkgPath(defPath), defName, methodName, 0)
				if embedSym != "" {
					normDef := normalizePkgPath(defPath)
					ptid := "reflect/types.type:pointer:named:" | normDef | "." | defName
					vid := "reflect/types.type:named:" | normDef | "." | defName
					impls = mxutil.Ensure(impls, 1)
					push(impls, ifaceImpl{
						recvType:   NewPointer(tn3.Typ),
						ptrRecv:    true,
						extSymbol:  embedSym,
						extTypeID:  ptid,
						extSig:     embedSig,
						embedField: chain[0],
						embedType:  embedT,
						embedChain: chain,
					})
					// The promoted method is in T's set as well (see above);
					// the value-form box dispatches on a copy of T.
					impls = mxutil.Ensure(impls, 1)
					push(impls, ifaceImpl{
						recvType:   tn3.Typ,
						ptrRecv:    false,
						extSymbol:  embedSym,
						extTypeID:  vid,
						extSig:     embedSig,
						embedField: chain[0],
						embedType:  embedT,
						embedChain: chain,
					})
				} else if chain2, ifaceT2, isig2 := findEmbedIfaceMethod(tn3.Typ, methodName, 0); isig2 != nil {
					// Promoted from an embedded INTERFACE field: no symbol
					// exists to call, so the arm re-dispatches on the
					// interface value stored in the field.
					normDef := normalizePkgPath(defPath)
					ptid := "reflect/types.type:pointer:named:" | normDef | "." | defName
					vid := "reflect/types.type:named:" | normDef | "." | defName
					impls = mxutil.Ensure(impls, 1)
					push(impls, ifaceImpl{
						recvType:   NewPointer(tn3.Typ),
						ptrRecv:    true,
						extTypeID:  ptid,
						extSig:     isig2,
						embedField: chain2[0],
						embedType:  ifaceT2,
						embedChain: chain2,
						embedIface: true,
					})
					impls = mxutil.Ensure(impls, 1)
					push(impls, ifaceImpl{
						recvType:   tn3.Typ,
						ptrRecv:    false,
						extTypeID:  vid,
						extSig:     isig2,
						embedField: chain2[0],
						embedType:  ifaceT2,
						embedChain: chain2,
						embedIface: true,
					})
				}
			}
		}
	}
	// The builtin types' String() methods (runtime/stringer.mx) are compiled
	// into the runtime, not into the package being built. Register each
	// concrete builtin against its real runtime symbol so a boxed builtin
	// dispatches to the method that formats it.
	if methodName == "String" && buildTagTrue("moxie.stringer") {
		btypes := builtinStringerTypes()
		for bi := 0; bi < len(btypes); bi++ {
			bt := btypes[bi]
			name := typeDeclName(bt)
			sig := builtinStringSig(bt)
			if name == "" || sig == nil {
				continue
			}
			sym := "runtime.(*" | builtinAliasName(name) | ").String"
			e.collectTypeDesc(bt)
			// A value-receiver method is in both T's and *T's method set.
			impls = mxutil.Ensure(impls, 1)
			push(impls, ifaceImpl{recvType: bt, extSymbol: sym, extSig: sig})
			impls = mxutil.Ensure(impls, 1)
			push(impls, ifaceImpl{recvType: NewPointer(bt), extSymbol: sym, extSig: sig})
		}
	}
	// Without the tag (the wasm target) the runtime carries no builtin
	// String() bodies, and every module defines an identity thunk for each
	// builtin instead (emitBasicIdentities). The thunk only means anything
	// for []byte, which String()s to itself; the rest exist so the dispatch
	// table has an arm for every builtin kind a program can box.
	if methodName == "String" && !buildTagTrue("moxie.stringer") {
		basicImpls := [][]string{
			{"bool", "basic:bool.String$identity"},
			{"int8", "basic:int8.String$identity"},
			{"int16", "basic:int16.String$identity"},
			{"int32", "basic:int32.String$identity"},
			{"int64", "basic:int64.String$identity"},
			{"uint8", "basic:uint8.String$identity"},
			{"uint16", "basic:uint16.String$identity"},
			{"uint32", "basic:uint32.String$identity"},
			{"uint64", "basic:uint64.String$identity"},
			{"uintptr", "basic:uintptr.String$identity"},
			{"float32", "basic:float32.String$identity"},
			{"float64", "basic:float64.String$identity"},
			{"bytes", "basic:bytes.String$identity"},
		}
		for bi := 0; bi < len(basicImpls); bi++ {
			bt := basicImpls[bi][0]
			bsym := basicImpls[bi][1]
			if bt == "uintptr" {
				e.collectTypeDesc(Typ[Uintptr])
			} else {
				btBasic := basicFromTail(bt)
				if btBasic != nil && btBasic != Typ[Invalid] {
					e.collectTypeDesc(btBasic)
				}
			}
			impls = mxutil.Ensure(impls, 1)
			push(impls, ifaceImpl{
				recvType:  Typ[TCString],
				ptrRecv:   true,
				extSymbol: bsym,
				extTypeID: "reflect/types.type:basic:" | bt,
				strong:    true,
			})
		}
	}
	for i := 1; i < len(impls); i++ {
		for j := i; j > 0 && impls[j].recvType.String() < impls[j-1].recvType.String(); j-- {
			impls[j], impls[j-1] = impls[j-1], impls[j]
		}
	}
	return impls
}

// pkgDispFingerprint measures a package's interface-dispatch arms: for every
// interface method the package invokes, the sorted identity of every impl the
// arm scan finds. It is the cache-key dependency that replaced the whole link
// set (see pkgHash in main.mx), so it must see exactly what emission sees:
// cctx.universe.Registry, cctx.dispMethodsByPkg and the package's own members
// are the same in both passes.
//
// Measured: 440 of 454 cached packages invoke no interface method at all, so
// their fingerprint is "" - which is what lets those packages share one cached
// object across every link set instead of one per link set (76 copies of `math`
// before this).
//
// The identity of an impl is its type-ID plus its symbol, which is what the
// emitted arm dispatches on and calls. Symbol alone would miss two impls of one
// type differing in receiver form; type-ID alone would miss a type whose method
// comes from an embed while another package supplies a same-named one.
func (e *irEmitter) pkgDispFingerprint() (s string) {
	var methods []string
	seen := map[string]bool{}
	for _, mname := range e.pkg.Members {
		fn, ok := mname.(*SSAFunction)
		if !ok {
			continue
		}
		for bi := 0; bi < len(fn.Blocks); bi++ {
			instrs := fn.Blocks[bi].Instrs
			for ii := 0; ii < len(instrs); ii++ {
				inv, isInv := instrs[ii].(*SSAInvoke)
				if !isInv || inv.MethodName == "" || seen[inv.MethodName] {
					continue
				}
				seen[inv.MethodName] = true
				methods = mxutil.Ensure(methods, 1)
				push(methods, inv.MethodName)
			}
		}
	}
	return e.dispFingerprintForMethods(methods)
}

// dispFingerprintForMethods is the measurement itself: for each method name, the
// sorted identity of every impl the arm scan finds. The names come from a scan
// of the package's source (see measureDispFingerprint in main.mx); the impls come
// from the same registries emission reads, so the fingerprint moves exactly when
// the emitted arms move.
//
// The identity of an impl is its type-ID plus its symbol, which is what the
// emitted arm dispatches on and calls. Symbol alone would miss two impls of one
// type differing in receiver form; type-ID alone would miss a type whose method
// comes from an embed while another package supplies a same-named one.
func (e *irEmitter) dispFingerprintForMethods(methods []string) (s string) {
	if len(methods) == 0 {
		return ""
	}
	for i := 1; i < len(methods); i++ {
		for j := i; j > 0 && methods[j] < methods[j-1]; j-- {
			methods[j], methods[j-1] = methods[j-1], methods[j]
		}
	}
	var acc string
	for mi := 0; mi < len(methods); mi++ {
		impls := e.findIfaceImpls(methods[mi])
		var ids []string
		for ii := 0; ii < len(impls); ii++ {
			ids = mxutil.Ensure(ids, 1)
			push(ids, e.implTypeID(impls[ii]) | " " | e.implFuncSym(impls[ii]))
		}
		for i := 1; i < len(ids); i++ {
			for j := i; j > 0 && ids[j] < ids[j-1]; j-- {
				ids[j], ids[j-1] = ids[j-1], ids[j]
			}
		}
		acc = acc | "|" | methods[mi] | "="
		for ii := 0; ii < len(ids); ii++ {
			acc = acc | ids[ii] | ","
		}
	}
	return fnvHash([]byte(acc))
}

func (e *irEmitter) findEmbedMethod(t Type, methodName string, depth int32) (chain []int32, fn *SSAFunction, embedT Type) {
	if depth > 5 {
		return nil, nil, nil
	}
	st, ok := SafeUnderlying(t).(*TCStruct)
	if !ok {
		return nil, nil, nil
	}
	for fi := 0; fi < st.NumFields(); fi++ {
		f := st.Field(fi)
		if !f.Anonymous {
			continue
		}
		embedType := f.Typ
		embedBase := embedType
		if pt2, isp2 := embedBase.(*Pointer); isp2 && pt2.Base != nil {
			// An embedded pointer (*Inner) promotes Inner's methods just
			// like an embedded value does; skipping it left the outer type
			// with no registered impl, so dispatch called the inner method
			// with the outer receiver.
			embedBase = pt2.Base
		}
		embedName := ""
		if en, ok2 := embedBase.(*Named); ok2 && en.Obj != nil {
			embedName = en.Obj.Name
		}
		if embedName == "" {
			continue
		}
		embedMName := "(*" | embedName | ")." | methodName
		fn2, fok := e.pkg.Members[embedMName].(*SSAFunction)
		if !fok {
			fn2, fok = e.pkg.Members[embedName | "." | methodName].(*SSAFunction)
		}
		if fok {
			return []int32{fi}, fn2, embedType
		}
		sub, fn3, embedT2 := e.findEmbedMethod(embedBase, methodName, depth+1)
		if fn3 != nil {
			return []int32{fi} | sub, fn3, embedT2
		}
	}
	return nil, nil, nil
}

// findEmbedIfaceMethod searches a type's anonymous fields for an embedded
// INTERFACE whose method set carries methodName, returning the field index
// chain, that interface's type and the method's signature. A method promoted
// from an embedded interface has no symbol of its own to call - the arm has to
// re-dispatch on the interface value the field holds - so findEmbedMethod
// (which looks for a concrete method symbol) cannot find it. Without this arm
// net/http.onceCloseListener, which reaches Accept only by embedding
// net.Listener, had no case in the Accept dispatch and every Serve panicked.
func findEmbedIfaceMethod(t Type, methodName string, depth int32) (chain []int32, ifaceT *TCInterface, sig *Signature) {
	if depth > 5 {
		return nil, nil, nil
	}
	st, ok := SafeUnderlying(t).(*TCStruct)
	if !ok {
		return nil, nil, nil
	}
	for fi := 0; fi < st.NumFields(); fi++ {
		f := st.Field(fi)
		if !f.Anonymous {
			continue
		}
		base := f.Typ
		if p, isP := base.(*Pointer); isP && p.Base != nil {
			base = p.Base
		}
		if it, isI := SafeUnderlying(base).(*TCInterface); isI {
			names, sigs := collectIfaceMethodInfo(it, 0)
			for ni := 0; ni < len(names); ni++ {
				if names[ni] == methodName && ni < len(sigs) && sigs[ni] != nil {
					return []int32{fi}, it, sigs[ni]
				}
			}
			continue
		}
		sub, it2, s2 := findEmbedIfaceMethod(base, methodName, depth+1)
		if s2 != nil {
			return []int32{fi} | sub, it2, s2
		}
	}
	return nil, nil, nil
}

// innerIfaceImpls returns the candidate list for a re-dispatch on the
// interface value an embedded interface field holds: the candidates that have
// the method themselves, minus every form of the type whose arm is being
// emitted, so the nested chain cannot recurse on itself.
//
// Candidates that are themselves promoted from an interface are left out. Each
// nesting level inlines a whole chain, so admitting them made the chain's size
// the product of the levels - net/http's module ran clang out of source
// locations. One level covers a value that embeds an interface; a promotion
// reached only through a promotion panics as a missing arm instead of
// returning a wrong value.
func (e *irEmitter) innerIfaceImpls(impls []ifaceImpl, outer ifaceImpl) (ss []ifaceImpl) {
	skip := e.implBaseTypeName(outer)
	for _, impl := range impls {
		if impl.embedIface {
			continue
		}
		if skip != "" {
			if e.implBaseTypeName(impl) == skip {
				continue
			}
		} else if impl.recvType == outer.recvType {
			continue
		}
		ss = mxutil.Ensure(ss, 1)
		push(ss, impl)
	}
	return ss
}

// findExtEmbedMethod searches embedded fields of a cross-package Named type
// for a method with the given name. Returns the field index chain, the
// external symbol for the method, the method signature, and the embed type.
func namedObjName(n *Named) (s string) {
	if n != nil && n.Obj != nil {
		return n.Obj.Name
	}
	return ""
}

func findExtEmbedMethod(named *Named, pkgPath string, outerName string, methodName string, depth int32) (chain []int32, sym string, sig *Signature, embedT Type) {
	if depth > 5 {
		return nil, "", nil, nil
	}
	st, ok := SafeUnderlying(named).(*TCStruct)
	if !ok {
		return nil, "", nil, nil
	}
	for fi := 0; fi < st.NumFields(); fi++ {
		f := st.Field(fi)
		if !f.Anonymous {
			continue
		}
		embedType := f.Typ
		var embedNamed *Named
		if en, ok2 := embedType.(*Named); ok2 {
			embedNamed = en
		} else if p, ok3 := embedType.(*Pointer); ok3 {
			if en2, ok4 := p.Base.(*Named); ok4 {
				embedNamed = en2
			}
		}
		if embedNamed == nil || embedNamed.Obj == nil {
			continue
		}
		embedPkg := pkgPath
		embedName := namedObjName(embedNamed)
		if embedNamed.Obj.Pkg != nil {
			embedPkg = embedNamed.Obj.Pkg.Path
		}
		for mi := 0; mi < embedNamed.NumMethods(); mi++ {
			m := embedNamed.Method(mi)
			if m.Name != methodName {
				continue
			}
			sym2 := embedPkg | ".(*" | embedName | ")." | methodName
			return []int32{fi}, sym2, m.Signature(), embedType
		}
		sub, sym3, sig2, eT := findExtEmbedMethod(embedNamed, embedPkg, embedName, methodName, depth+1)
		if sym3 != "" {
			return []int32{fi} | sub, sym3, sig2, eT
		}
	}
	return nil, "", nil, nil
}

type ifaceImpl struct {
	fn         *SSAFunction
	recvType   Type
	ptrRecv    bool
	embedField int32
	embedType  Type
	embedChain []int32
	// embedIface marks a method promoted from an embedded INTERFACE field.
	// Such a method has no symbol to call: the arm must re-dispatch on the
	// interface value held in the field (net/http.onceCloseListener embeds
	// net.Listener and reaches Accept only by promotion).
	embedIface bool
	extSymbol  string
	extTypeID  string
	extSig     *Signature
	strong     bool // the symbol is defined (internal) in every module; no declaration, no null check
}

func (e *irEmitter) implFuncSym(impl ifaceImpl) (s string) {
	if impl.extSymbol != "" {
		if irNeedsQuote(impl.extSymbol) {
			return irQuoteName(impl.extSymbol)
		}
		return "@" | impl.extSymbol
	}
	if impl.fn == nil {
		// A method promoted from an embedded interface has no symbol: its arm
		// re-dispatches on the embedded value. Give the fingerprint a stable
		// identity for it (the outer type and the field chain walked to the
		// embedded interface) instead of dereferencing a nil function.
		mark := "#iface-embed:" | e.implBaseTypeName(impl) | ":"
		chain := impl.embedChain
		if len(chain) == 0 {
			chain = []int32{impl.embedField}
		}
		for _, idx := range chain {
			mark = mark | irItoa(idx) | ","
		}
		return mark
	}
	return e.funcSymbol(impl.fn)
}

func (e *irEmitter) declareExtInvoke(impl ifaceImpl, inv *SSAInvoke) {
	if impl.extSymbol == "" {
		return
	}
	// A symbol owned by the package being compiled is emitted as a
	// definition in this same module; declaring it extern_weak here would
	// be a redefinition. Cross-package impls of a local type can still be
	// enumerated (registry scans), so filter by ownership.
	if mxutil.HasPrefix(impl.extSymbol, normalizePkgPath(e.pkg.Pkg.Path) | ".") {
		return
	}
	// The basic String() identity wrappers are defined (internal) by
	// emitBasicIdentities in every module; declaring them extern_weak here
	// would collide with that definition.
	if impl.strong {
		return
	}
	sym := e.implFuncSym(impl)
	if _, ok := e.extDecls[sym]; ok {
		return
	}
	for _, p := range e.pendExtDecls {
		if p.k == sym { return }
	}
	// Use the impl's actual return type (not the caller's expected type)
	// so the declaration matches the definition in the defining package.
	retType := e.llvmType(inv.SSAType())
	if impl.fn != nil && impl.fn.Signature != nil && impl.fn.Signature.Results != nil {
		implRet := e.llvmType(impl.fn.Signature.Results)
		if implRet != "" && implRet != "void" {
			retType = implRet
		}
	} else if impl.extSig != nil && impl.extSig.Results != nil {
		implRet := e.llvmType(impl.extSig.Results)
		if implRet != "" && implRet != "void" {
			retType = implRet
		}
	}
	useSret := needsSret(retType)
	// All receivers are ptr in Moxie (no value receivers).
	recvLLVM := "ptr"
	params := ""
	if useSret {
		params = "ptr, "
	}
	var psegs []string
	if params != "" {
		psegs = mxutil.Ensure(psegs, 1)
		push(psegs, params)
	}
	psegs = mxutil.Ensure(psegs, 1)
	push(psegs, recvLLVM)
	var sig *Signature
	if impl.fn != nil && impl.fn.Signature != nil {
		sig = impl.fn.Signature
	} else if impl.extSig != nil {
		sig = impl.extSig
	}
	if sig != nil && sig.Params != nil {
		for i := 0; i < sig.Params.Len(); i++ {
			pt := e.llvmType(sig.Params.At(i).Typ)
			if pt == "void" {
				pt = "ptr"
			}
			psegs = mxutil.Ensure(psegs, 1)
			push(psegs, pt)
		}
	} else {
		for _, arg := range inv.Args {
			argT := e.llvmType(arg.SSAType())
			if argT == "void" {
				argT = "ptr"
			}
			psegs = mxutil.Ensure(psegs, 1)
			push(psegs, argT)
		}
	}
	psegs = mxutil.Ensure(psegs, 1)
	push(psegs, "ptr")
	params = joinStrs(commaSep(psegs))
	// extern_weak: dispatch lists enumerate impls from the whole link set;
	// a link reusing this module's cached .bc without an impl's package
	// resolves the ref to null instead of failing, and the guarded call arm
	// is dead there (no make-interface site can produce the type-ID).
	declRet := retType
	if useSret {
		declRet = "void"
	}
	linkage := "extern_weak "
	if impl.strong {
		linkage = ""
	}
	e.pendExtDecls = mxutil.Ensure(e.pendExtDecls, 1)
	push(e.pendExtDecls, emitKV{sym, linkage | declRet | " " | sym | "(" | params | ")"})
}

func (e *irEmitter) emitExtInvokeCall(reg, retType, funcSym, recvLLVM, recv string, inv *SSAInvoke, isVoid bool, impl ifaceImpl) {
	var casegs []string
	casegs = mxutil.Ensure(casegs, 1)
	push(casegs, recvLLVM | " " | recv)
	var sig *Signature
	if impl.fn != nil {
		sig = impl.fn.Signature
	} else if impl.extSig != nil {
		sig = impl.extSig
	}
	for i, arg := range inv.Args {
		argT := e.llvmType(arg.SSAType())
		if argT == "void" {
			argT = "ptr"
		}
		argVal := e.operand(arg)
		if sig != nil && sig.Params != nil && i < sig.Params.Len() {
			argT, argVal = e.boxConcreteToIfaceParam(sig.Params.At(i).Typ, arg, argT, argVal)
			pt := e.llvmType(sig.Params.At(i).Typ)
			if pt == "void" {
				pt = "ptr"
			}
			if pt != argT && pt != "" {
				e.nextReg++
				tmp := "%eicast" | irItoa(e.nextReg)
				e.w("  ") ; e.w(tmp) ; e.w(" = alloca ") ; e.w(pt) ; e.w("\n")
				e.w("  store ") ; e.w(pt) ; e.w(" zeroinitializer, ptr ") ; e.w(tmp) ; e.w("\n")
				e.w("  store ") ; e.w(argT) ; e.w(" ") ; e.w(argVal) ; e.w(", ptr ") ; e.w(tmp) ; e.w("\n")
				e.nextReg++
				loaded := "%eild" | irItoa(e.nextReg)
				e.w("  ") ; e.w(loaded) ; e.w(" = load ") ; e.w(pt) ; e.w(", ptr ") ; e.w(tmp) ; e.w("\n")
				argT = pt
				argVal = loaded
			}
		}
		casegs = mxutil.Ensure(casegs, 1)
		push(casegs, argT | " " | argVal)
	}
	casegs = mxutil.Ensure(casegs, 1)
	push(casegs, "ptr null")
	callArgs := joinStrs(commaSep(casegs))
	prefix := "  "
	if !isVoid {
		prefix = prefix | reg | " = "
	}
	e.w(prefix | "call " | retType | " ") ; e.w(funcSym) ; e.w("(")
	e.w(callArgs)
	e.w(")\n")
}

func (e *irEmitter) implTypeID(impl ifaceImpl) (s string) {
	if impl.extTypeID != "" {
		if mxutil.HasPrefix(impl.extTypeID, "reflect/types.type:") {
			tail := impl.extTypeID[len("reflect/types.type:"):]
			e.collectTypeDescFromTail(tail)
			return "ptrtoint (ptr " | irQuoteName("reflect/types.type:" | tail) | " to " | e.intptrType() | ")"
		}
		return e.intptrType() | " 0"
	}
	return e.typeIDHash(impl.recvType)
}

// emitIfaceAssertOK emits an i1 that is true when the dynamic type-ID in
// typeID belongs to a type whose method set covers every method of the
// asserted interface. Candidates come from the same whole-link-set scan
// invoke dispatch uses (findIfaceImpls), so assert and invoke agree on
// what implements what. Pointer types carry the full method set; value
// types only value-receiver methods (Go method-set rules).
func (e *irEmitter) emitIfaceAssertOK(ifaceT *TCInterface, typeID string) (s string) {
	mnames, msigs := collectIfaceMethodInfo(ifaceT, 0)
	// The universe error interface carries an implicit String() string so fmt
	// can print errors; concrete error types are not required to declare it.
	// Drop it from the required set whenever Error is present, or no type
	// would ever cover the full set.
	hasError := false
	for mi := 0; mi < len(mnames); mi++ {
		if mnames[mi] == "Error" {
			hasError = true
		}
	}
	if hasError {
		var keepN []string
		var keepS []*Signature
		for mi := 0; mi < len(mnames); mi++ {
			if mnames[mi] != "String" {
				keepN = mxutil.Ensure(keepN, 1)
				push(keepN, mnames[mi])
				keepS = mxutil.Ensure(keepS, 1)
				push(keepS, msigs[mi])
			}
		}
		mnames = keepN
		msigs = keepS
	}
	n := int32(len(mnames))
	allCount := map[string]int32{}
	valCount := map[string]int32{}
	var order []string
	for mi := int32(0); mi < n; mi++ {
		impls := e.findIfaceImpls(mnames[mi])
		seen := map[string]bool{}
		for ii := 0; ii < len(impls); ii++ {
			// An impl must match the interface method's results and parameter
			// types, not merely its name. Cross-package impls arrive as an
			// external symbol with only a signature, so both forms are
			// checked here.
			if msigs[mi] != nil {
				var cand *Signature
				if impls[ii].fn != nil {
					cand = impls[ii].fn.Signature
				} else if impls[ii].extSig != nil {
					cand = impls[ii].extSig
				}
				if cand != nil {
					if e.llvmType(msigs[mi].Results) != e.llvmType(cand.Results) {
						continue
					}
					ifaceParams := int32(0)
					if msigs[mi].Params != nil {
						ifaceParams = int32(msigs[mi].Params.Len())
					}
					implParams := int32(0)
					if cand.Params != nil {
						implParams = int32(cand.Params.Len())
					}
					if ifaceParams != implParams {
						continue
					}
					bad := false
					for pi := int32(0); pi < ifaceParams; pi++ {
						if e.llvmType(msigs[mi].Params.At(pi).Typ) != e.llvmType(cand.Params.At(pi).Typ) {
							bad = true
							break
						}
					}
					if bad {
						continue
					}
				}
			}
			base := e.implBaseTypeName(impls[ii])
			if base == "" {
				continue
			}
			// A type carries up to two arms per method, one per form (the
			// pointer receiver and the value). The assertion set counts each
			// form once per method, so dedupe on (base, form), not on base.
			isPtrForm := false
			if _, isp := impls[ii].recvType.(*Pointer); isp {
				isPtrForm = true
			}
			fkey := base | "#v"
			if isPtrForm {
				fkey = base | "#p"
			}
			if seen[fkey] {
				continue
			}
			seen[fkey] = true
			if _, have := allCount[base]; !have {
				order = mxutil.Ensure(order, 1)
				push(order, base)
			}
			if isPtrForm {
				allCount[base] = allCount[base] + 1
			} else {
				valCount[base] = valCount[base] + 1
			}
		}
	}
	pfx := "reflect/types.type:"
	var tids []string
	for oi := 0; oi < len(order); oi++ {
		base := order[oi]
		if allCount[base] == n {
			tids = mxutil.Ensure(tids, 1)
			push(tids, "ptrtoint (ptr " | irQuoteName(pfx | "pointer:" | base[len(pfx):]) | " to " | e.intptrType() | ")")
		}
		if valCount[base] == n {
			tids = mxutil.Ensure(tids, 1)
			push(tids, "ptrtoint (ptr " | irQuoteName(base) | " to " | e.intptrType() | ")")
		}
	}
	ok := ""
	for ti := 0; ti < len(tids); ti++ {
		// Emit the referenced type descriptor in this module (linkonce_odr)
		// so the ptrtoint compare has a defined global. Candidate impls can
		// come from any package in the link set (whole-link registry), and
		// their descriptors are not otherwise emitted here.
		if dq := irDescriptorGlobalFromTID(tids[ti]); dq != "" {
			e.collectTypeDescFromTail(dq)
		}
		cmp := e.nextReg2("ta")
		e.w("  ") ; e.w(cmp) ; e.w(" = icmp eq " | e.intptrType() | " ") ; e.w(typeID) ; e.w(", ") ; e.w(tids[ti]) ; e.w("\n")
		if ok == "" {
			ok = cmp
		} else {
			acc := e.nextReg2("ta")
			e.w("  ") ; e.w(acc) ; e.w(" = or i1 ") ; e.w(ok) ; e.w(", ") ; e.w(cmp) ; e.w("\n")
			ok = acc
		}
	}
	if ok == "" {
		// no implementer in the link set: the assertion can never succeed
		ok = e.nextReg2("ta")
		e.w("  ") ; e.w(ok) ; e.w(" = icmp eq " | e.intptrType() | " ") ; e.w(typeID) ; e.w(", -1\n")
	}
	return ok
}

// irDescriptorGlobalFromTID extracts the descriptor tail (the part after
// "reflect/types.type:") from a typeID expression like
// 'ptrtoint (ptr @"reflect/types.type:pointer:named:x.Y" to i64)'.
func irDescriptorGlobalFromTID(tid string) (s string) {
	const marker = "@\"reflect/types.type:"
	mi := -1
	for i := int32(0); i+int32(len(marker)) <= int32(len(tid)); i++ {
		if tid[i:i+int32(len(marker))] == marker {
			mi = i + int32(len(marker))
			break
		}
	}
	if mi < 0 {
		return ""
	}
	for j := mi; j < int32(len(tid)); j++ {
		if tid[j] == '"' {
			return tid[mi:j]
		}
	}
	return ""
}

// collectIfaceMethodNames returns the deduplicated method names of an
// interface, walking embedded interfaces when the completed allMethods
// list is unavailable.
func collectIfaceMethodNames(ifaceT *TCInterface, depth int32) (ss []string) {
	names, _ := collectIfaceMethodInfo(ifaceT, depth)
	return names
}

func collectIfaceMethodInfo(ifaceT *TCInterface, depth int32) (ss []string, sigs []*Signature) {
	if ifaceT == nil || depth > 4 {
		return nil, nil
	}
	var names []string
	var sigList []*Signature
	if ifaceT.NumMethods() > 0 {
		for i := int32(0); i < ifaceT.NumMethods(); i++ {
			names = mxutil.Ensure(names, 1)
			push(names, ifaceT.Method(i).Name)
			sigList = mxutil.Ensure(sigList, 1)
			push(sigList, ifaceT.Method(i).Sig)
		}
	} else {
		for i := int32(0); i < ifaceT.NumExplicitMethods(); i++ {
			names = mxutil.Ensure(names, 1)
			push(names, ifaceT.ExplicitMethod(i).Name)
			sigList = mxutil.Ensure(sigList, 1)
			push(sigList, ifaceT.ExplicitMethod(i).Sig)
		}
		for i := int32(0); i < ifaceT.NumEmbeddeds(); i++ {
			if em, ok := SafeUnderlying(ifaceT.EmbeddedType(i)).(*TCInterface); ok {
				en, es := collectIfaceMethodInfo(em, depth+1)
				names = names | en
				sigList = sigList | es
			}
		}
	}
	seen := map[string]bool{}
	var outN []string
	var outS []*Signature
	for i := 0; i < len(names); i++ {
		if seen[names[i]] {
			continue
		}
		seen[names[i]] = true
		outN = mxutil.Ensure(outN, 1)
		push(outN, names[i])
		if i < len(sigList) {
			outS = mxutil.Ensure(outS, 1)
			push(outS, sigList[i])
		} else {
			outS = mxutil.Ensure(outS, 1)
			push(outS, nil)
		}
	}
	return outN, outS
}

// implBaseTypeName returns the reflect name of the impl's receiver base
// (non-pointer) type, used to intersect method coverage across impls.
func (e *irEmitter) implBaseTypeName(impl ifaceImpl) (s string) {
	if impl.extTypeID != "" {
		name := impl.extTypeID
		if mxutil.HasPrefix(name, "reflect/types.type:pointer:") {
			name = "reflect/types.type:" | name[len("reflect/types.type:pointer:"):]
		}
		return name
	}
	rt := impl.recvType
	if pt, isP := rt.(*Pointer); isP {
		rt = pt.Base
	}
	if rt == nil {
		return ""
	}
	return e.reflectTypeName(rt)
}

func (e *irEmitter) emitEmbedChainGEP(impl ifaceImpl, valPtr string) (s string) {
	chain := impl.embedChain
	if len(chain) == 0 {
		chain = []int32{impl.embedField}
	}
	outerType := impl.recvType
	if pt, ok := outerType.(*Pointer); ok {
		outerType = pt.Base
	}
	cur := valPtr
	curType := outerType
	for _, idx := range chain {
		st, ok := SafeUnderlying(curType).(*TCStruct)
		if !ok || idx >= st.NumFields() {
			return cur
		}
		outerLLVM := e.llvmType(curType)
		gep := e.nextReg2("eg")
		e.w("  ") ; e.w(gep) ; e.w(" = getelementptr inbounds ") ; e.w(outerLLVM)
		e.w(", ptr ") ; e.w(cur) ; e.w(", i32 0, i32 ") ; e.w(irItoa(idx)) ; e.w("\n")
		cur = gep
		curType = st.Field(idx).Typ
		// An embedded pointer field IS the receiver: load the stored
		// pointer. Without the load the callee got the address of the
		// field instead of the embedded value, so a struct embedding a
		// pointer dispatched to the right method with a bad receiver.
		if pt, isPtr := curType.(*Pointer); isPtr && pt.Base != nil {
			ld := e.nextReg2("eg")
			e.w("  ") ; e.w(ld) ; e.w(" = load ptr, ptr ") ; e.w(cur) ; e.w("\n")
			cur = ld
			curType = pt.Base
		}
	}
	return cur
}

type invokeArg struct {
	typ string
	val string
}

func (e *irEmitter) prepareInvokeArgs(inv *SSAInvoke, impl ifaceImpl) (ss []invokeArg) {
	var sig *Signature
	if impl.fn != nil {
		sig = impl.fn.Signature
	} else if impl.extSig != nil {
		sig = impl.extSig
	}
	var result []invokeArg
	for i, arg := range inv.Args {
		argT := e.llvmType(arg.SSAType())
		if at, ok := e.allocTypes[arg]; ok && at != "ptr" && at != "void" {
			argT = at
		}
		if argT == "void" {
			argT = "ptr"
		}
		argV := e.operand(arg)
		if sig != nil && sig.Params != nil && i < sig.Params.Len() {
			argT, argV = e.boxConcreteToIfaceParam(sig.Params.At(i).Typ, arg, argT, argV)
			pt := e.llvmType(sig.Params.At(i).Typ)
			if pt != "void" && pt != "ptr" && pt != "" && pt != argT && len(pt) > len(argT) {
				e.nextReg++
				tmp := "%icast" | irItoa(e.nextReg)
				e.w("  ") ; e.w(tmp) ; e.w(" = alloca ") ; e.w(pt) ; e.w("\n")
				e.w("  store ") ; e.w(pt) ; e.w(" zeroinitializer, ptr ") ; e.w(tmp) ; e.w("\n")
				e.w("  store ") ; e.w(argT) ; e.w(" ") ; e.w(argV) ; e.w(", ptr ") ; e.w(tmp) ; e.w("\n")
				e.nextReg++
				loaded := "%icld" | irItoa(e.nextReg)
				e.w("  ") ; e.w(loaded) ; e.w(" = load ") ; e.w(pt) ; e.w(", ptr ") ; e.w(tmp) ; e.w("\n")
				argT = pt
				argV = loaded
			}
		}
		if argT == "void" {
			argT = "ptr"
		}
		result = mxutil.Ensure(result, 1)
		push(result, invokeArg{typ: argT, val: argV})
	}
	return result
}

func (e *irEmitter) emitInvokeArgs(args []invokeArg) {
	for _, a := range args {
		e.w(", ") ; e.w(a.typ) ; e.w(" ") ; e.w(a.val)
	}
}

// boxConcreteToIfaceParam emits interface boxing when a concrete arg is
// passed to an interface-typed method parameter. Without this, the raw
// alloca+store+load cast leaves the typecode zero and the callee's own
// interface dispatch fails ("no impl"). Returns the (type, value) to use
// for the call. When the param is not an interface or the arg is already
// an interface, returns the input unchanged.
func (e *irEmitter) boxConcreteToIfaceParam(paramType Type, arg SSAValue, argT, argV string) (s string, v string) {
	if paramType == nil || arg == nil || arg.SSAType() == nil {
		return argT, argV
	}
	if _, isIface := SafeUnderlying(paramType).(*TCInterface); !isIface {
		return argT, argV
	}
	if _, isIfaceArg := SafeUnderlying(arg.SSAType()).(*TCInterface); isIfaceArg {
		return argT, argV
	}
	ity := e.ifaceType()
	if argT != "ptr" {
		if w := e.ifaceInlineWidth(argT); w > 0 && w <= e.intBits(e.intptrType()) {
			// Fits in a pointer: inline in the value slot.
			argV = e.emitInlineToPtr(argT, argV, "box")
		} else {
			// Wider than a pointer: heap-allocate a copy and box its address.
			ipt := e.intptrType()
			sz := e.nextReg2("boxsz")
			e.w("  ") ; e.w(sz) ; e.w(" = ptrtoint ptr getelementptr (") ; e.w(argT) ; e.w(", ptr null, i32 1) to ") ; e.w(ipt) ; e.w("\n")
			vp := e.nextReg2("boxvp")
			e.w("  ") ; e.w(vp) ; e.w(" = call ptr @runtime.alloc(") ; e.w(ipt) ; e.w(" ") ; e.w(sz) ; e.w(", ptr null, ptr null)\n")
			e.w("  store ") ; e.w(argT) ; e.w(" ") ; e.w(argV) ; e.w(", ptr ") ; e.w(vp) ; e.w("\n")
			e.declareRuntime("runtime.alloc", "ptr", ipt | ", ptr")
			argV = vp
		}
	}
	typeid := e.typeIDHash(arg.SSAType())
	e.nextReg++
	t1 := "%boxc" | irItoa(e.nextReg)
	e.w("  ") ; e.w(t1) ; e.w(" = insertvalue ") ; e.w(ity) ; e.w(" undef, ") ; e.w(e.intptrType()) ; e.w(" ") ; e.w(typeid) ; e.w(", 0\n")
	e.nextReg++
	v = "%boxc" | irItoa(e.nextReg)
	e.w("  ") ; e.w(v) ; e.w(" = insertvalue ") ; e.w(ity) ; e.w(" ") ; e.w(t1) ; e.w(", ptr ") ; e.w(argV) ; e.w(", 1\n")
	return ity, v
}

func (e *irEmitter) emitInvoke(inv *SSAInvoke) {
	reg := e.regName(inv)
	ifaceVal := e.operand(inv.X)
	retSSAType := inv.SSAType()
	if retSSAType == nil && inv.IfaceType != nil {
		for i := 0; i < inv.IfaceType.NumMethods(); i++ {
			m := inv.IfaceType.Method(i)
			if m != nil && m.Name == inv.MethodName && m.Sig != nil {
				if m.Sig.Results != nil && m.Sig.Results.Len() == 1 {
					retSSAType = m.Sig.Results.At(0).Typ
				} else if m.Sig.Results != nil && m.Sig.Results.Len() > 1 {
					retSSAType = m.Sig.Results
				}
				break
			}
		}
	}
	retType := e.llvmType(retSSAType)
	isVoid := retType == "void"

	xtype := inv.X.SSAType()
	concretePtr := false
	if xtype != nil {
		u := SafeUnderlying(xtype)
		if u != nil {
			_, isP := u.(*Pointer)
			_, isI := u.(*TCInterface)
			if isP && !isI {
				concretePtr = true
			}
		}
		}

	tidPtr := e.nextReg2("tid")
	valPtr := e.nextReg2("vp")
	if concretePtr {
		e.w("  ") ; e.w(valPtr) ; e.w(" = bitcast ptr ") ; e.w(ifaceVal) ; e.w(" to ptr\n")
	} else {
		e.w("  ") ; e.w(tidPtr) ; e.w(" = extractvalue " | e.ifaceType() | " ") ; e.w(ifaceVal) ; e.w(", 0\n")
		e.w("  ") ; e.w(valPtr) ; e.w(" = extractvalue " | e.ifaceType() | " ") ; e.w(ifaceVal) ; e.w(", 1\n")
	}

	allImpls := e.findIfaceImpls(inv.MethodName)
	// The method the call actually targets, so an impl can be checked against
	// its real signature rather than its name.
	var ifaceSig *Signature
	if inv.IfaceType != nil {
		for _, im := range inv.IfaceType.AllMethods {
			if im != nil && im.Name == inv.MethodName {
				ifaceSig = im.Sig
				break
			}
		}
	}
	// Filter impls by result and parameter compatibility. A name match alone
	// is not an implementation: poly1305's Sum(*[16]byte) shares a name with
	// hash.Hash's Sum([]byte) []byte but neither its parameters nor its
	// result, and emitting the call with the interface's signature left a
	// declaration that disagreed with the definition at the wasm link.
	nInvokeArgs := int32(len(inv.Args))
	var impls []ifaceImpl
	for _, impl := range allImpls {
		if impl.fn != nil && impl.fn.Signature != nil {
			if e.llvmType(impl.fn.Signature.Results) != retType {
				continue
			}
			// Parameter count must match the invoke arg count.
			implParams := int32(0)
			if impl.fn.Signature.Params != nil {
				implParams = int32(impl.fn.Signature.Params.Len())
			}
			if implParams != nInvokeArgs {
				continue
			}
			if ifaceSig != nil && ifaceSig.Params != nil && impl.fn.Signature.Params != nil {
				if int32(ifaceSig.Params.Len()) != implParams {
					continue
				}
				bad := false
				for pi := int32(0); pi < implParams; pi++ {
					if e.llvmType(ifaceSig.Params.At(pi).Typ) != e.llvmType(impl.fn.Signature.Params.At(pi).Typ) {
						bad = true
						break
					}
				}
				if bad {
					continue
				}
			}
		} else if impl.extSig != nil {
			implParams := int32(0)
			if impl.extSig.Params != nil {
				implParams = int32(impl.extSig.Params.Len())
			}
			if implParams != nInvokeArgs {
				continue
			}
			if e.llvmType(impl.extSig.Results) != retType {
				continue
			}
			if ifaceSig != nil && ifaceSig.Params != nil && impl.extSig.Params != nil {
				if int32(ifaceSig.Params.Len()) != implParams {
					continue
				}
				badExt := false
				for pi := int32(0); pi < implParams; pi++ {
					if e.llvmType(ifaceSig.Params.At(pi).Typ) != e.llvmType(impl.extSig.Params.At(pi).Typ) {
						badExt = true
						break
					}
				}
				if badExt {
					continue
				}
			}
		}
		impls = mxutil.Ensure(impls, 1)
		push(impls, impl)
	}
	for _, impl := range impls {
		e.declareExtInvoke(impl, inv)
	}
	// A method promoted from an embedded interface is reached by dispatching
	// on the interface value the field holds, so its single arm still needs
	// the chain's merge block to define the result.
	forceChain := len(impls) == 1 && impls[0].embedIface
	mergeLabel := e.emitIfaceChain(inv, impls, tidPtr, valPtr, retType, isVoid, reg, forceChain, false)
	if mergeLabel != "" {
		if blk := inv.InstrBlock(); blk != nil {
			e.blockExitLabel[blk.Index] = "%" | mergeLabel
		}
	}
}

// emitIfaceChain emits the type-ID check chain for one interface dispatch and
// returns the label of the block that defines the result (the merge block), or
// "" when the emitted path defines it in place - the zero-impl and single-call
// shapes, which do not branch.
//
// impls are candidates for the interface value in tidPtr/valPtr, already
// filtered by signature. A candidate whose method is promoted from an embedded
// interface is not called: its value is read for the interface it embeds and
// the same chain is emitted on that interface value (nested = true), so a
// promotion is dispatched wherever the promoted method is reached.
func (e *irEmitter) emitIfaceChain(inv *SSAInvoke, impls []ifaceImpl, tidPtr string, valPtr string, retType string, isVoid bool, reg string, forceChain bool, nested bool) (mergeLabel string) {
	if len(impls) == 0 {
		e.w("  ; invoke: no implementations for ") ; e.w(inv.MethodName) ; e.w("\n")
		if !isVoid {
			e.nextReg++
			zp := "%zp" | irItoa(e.nextReg)
			e.w("  ") ; e.w(zp) ; e.w(" = alloca ") ; e.w(retType) ; e.w("\n")
			e.w("  store ") ; e.w(retType) ; e.w(" zeroinitializer, ptr ") ; e.w(zp) ; e.w("\n")
			e.w("  ") ; e.w(reg) ; e.w(" = load ") ; e.w(retType) ; e.w(", ptr ") ; e.w(zp) ; e.w("\n")
		}
		return ""
	}

	if len(impls) == 1 && !forceChain {
		impl := impls[0]
		callRecv := e.materializeIfaceValue(impl.recvType, valPtr)
		if impl.embedType != nil {
			callRecv = e.emitEmbedChainGEP(impl, callRecv)
		}
		// All receivers are ptr in Moxie.
		recvLLVM := "ptr"
		recv := callRecv
		if impl.extSymbol != "" {
			e.emitExtInvokeCall(reg, retType, e.implFuncSym(impl), recvLLVM, recv, inv, isVoid, impl)
		} else {
			prepArgs := e.prepareInvokeArgs(inv, impl)
			prefix := "  "
			if !isVoid {
				prefix = prefix | reg | " = "
			}
			e.w(prefix | "call " | retType | " ") ; e.w(e.implFuncSym(impl)) ; e.w("(")
			e.w(recvLLVM) ; e.w(" ") ; e.w(recv)
			e.emitInvokeArgs(prepArgs)
			e.w(", ptr null)\n")
		}
		return ""
	}

	// Arm the defer frame once before the dispatch. A checkpoint inside a case
	// block would split it from its PHI incoming label at the merge, which LLVM
	// rejects, so suppress the per-call checkpoint for the whole dispatch; the
	// one checkpoint here covers every case call.
	if !nested && e.deferCheckpointOn && e.deferFrame != "" {
		e.emitCallCheckpoint()
	}
	prevNoCheckpoint := e.noCheckpoint
	e.noCheckpoint = true

	baseID := e.nextReg
	mergeLabel = "invoke.merge" | irItoa(baseID)
	var checkLabels []string
	var caseLabels []string
	var callRegs []string
	var phiLabels []string
	for i := range impls {
		checkLabels = mxutil.Ensure(checkLabels, 1)
		push(checkLabels, "invoke.check" | irItoa(baseID) | "." | irItoa(i))
		caseLabels = mxutil.Ensure(caseLabels, 1)
		push(caseLabels, "invoke.case" | irItoa(baseID) | "." | irItoa(i))
		phiLabels = mxutil.Ensure(phiLabels, 1)
		push(phiLabels, caseLabels[len(caseLabels)-1])
		if !isVoid {
			callRegs = mxutil.Ensure(callRegs, 1)
			push(callRegs, e.nextReg2("cr"))
		}
	}
	defaultLabel := "invoke.default" | irItoa(baseID)

	e.w("  br label %") ; e.w(checkLabels[0]) ; e.w("\n")

	for i, impl := range impls {
		nextCheck := defaultLabel
		if i < len(impls)-1 {
			nextCheck = checkLabels[i+1]
		}
		e.w(checkLabels[i]) ; e.w(":\n")
		tidGlobal := e.implTypeID(impl)
		cmpReg := e.nextReg2("cmp")
		e.w("  ") ; e.w(cmpReg) ; e.w(" = icmp eq " | e.intptrType() | " ") ; e.w(tidPtr) ; e.w(", ") ; e.w(tidGlobal) ; e.w("\n")
		e.w("  br i1 ") ; e.w(cmpReg) ; e.w(", label %") ; e.w(caseLabels[i]) ; e.w(", label %") ; e.w(nextCheck) ; e.w("\n")

		e.w(caseLabels[i]) ; e.w(":\n")
		// All receivers are ptr in Moxie.
		callRecv := e.materializeIfaceValue(impl.recvType, valPtr)
		if impl.embedType != nil {
			callRecv = e.emitEmbedChainGEP(impl, callRecv)
		}
		recvLLVM := "ptr"
		recv := callRecv
		if impl.embedIface {
			// The method belongs to the interface embedded in this value, so
			// there is no symbol to call: read the embedded interface and
			// dispatch the same method on it. recv points at the interface
			// slot after the GEP above, not at a receiver.
			e.nextReg++
			iv := "%eiv" | irItoa(e.nextReg)
			e.w("  ") ; e.w(iv) ; e.w(" = load " | e.ifaceType() | ", ptr ") ; e.w(recv) ; e.w("\n")
			e.nextReg++
			itid := "%eit" | irItoa(e.nextReg)
			e.w("  ") ; e.w(itid) ; e.w(" = extractvalue " | e.ifaceType() | " ") ; e.w(iv) ; e.w(", 0\n")
			e.nextReg++
			ivp := "%eip" | irItoa(e.nextReg)
			e.w("  ") ; e.w(ivp) ; e.w(" = extractvalue " | e.ifaceType() | " ") ; e.w(iv) ; e.w(", 1\n")
			creg := ""
			if !isVoid {
				creg = callRegs[i]
			}
			sub := e.emitIfaceChain(inv, e.innerIfaceImpls(impls, impl), itid, ivp, retType, isVoid, creg, true, true)
			if sub != "" {
				phiLabels[i] = sub
			}
		} else if impl.extSymbol != "" && !impl.strong {
			// For extern_weak symbols, check the function pointer is
			// non-null before calling. An unresolved weak symbol resolves
			// to null, which would crash at the call site.
			nullCheck := e.nextReg2("nc")
			e.w("  ") ; e.w(nullCheck) ; e.w(" = icmp ne ptr ") ; e.w(e.implFuncSym(impl)) ; e.w(", null\n")
			callLabel := "invoke.call" | irItoa(baseID) | "." | irItoa(i)
			nextCheck2 := defaultLabel
			if i < len(impls)-1 {
				nextCheck2 = checkLabels[i+1]
			}
			e.w("  br i1 ") ; e.w(nullCheck) ; e.w(", label %") ; e.w(callLabel) ; e.w(", label %") ; e.w(nextCheck2) ; e.w("\n")
			e.w(callLabel) ; e.w(":\n")
			phiLabels[i] = callLabel
			creg := ""
			if !isVoid {
				creg = callRegs[i]
			}
			e.emitExtInvokeCall(creg, retType, e.implFuncSym(impl), recvLLVM, recv, inv, isVoid, impl)
		} else {
			prepArgs := e.prepareInvokeArgs(inv, impl)
			prefix := "  "
			if !isVoid {
				prefix = prefix | callRegs[i] | " = "
			}
			e.w(prefix | "call " | retType | " ") ; e.w(e.implFuncSym(impl)) ; e.w("(")
			e.w(recvLLVM) ; e.w(" ") ; e.w(recv)
			e.emitInvokeArgs(prepArgs)
			e.w(", ptr null)\n")
		}
		e.w("  br label %") ; e.w(mergeLabel) ; e.w("\n")
	}

	e.w(defaultLabel) ; e.w(":\n")
	// A typeID that matches no impl means the dispatch list is incomplete -
	// fail loud instead of executing unreachable-UB with a garbage method.
	{
		sty := e.sliceType()
		// Say how many impls the list holds, not just which method was wanted.
		// "no impl for String" alone cannot distinguish an empty list from one
		// that holds every named type but not the INSTANTIATION being dispatched
		// - and those need different fixes. The full list is unbounded (268
		// entries for String in the compiler itself), so the count is what the
		// message carries.
		msg := "interface dispatch: no impl for " | inv.MethodName | " (" | irItoa(int32(len(impls))) | " impl(s), none matches)"
		idx := e.addStringConst(msg)
		ipt := e.intptrType()
		slen := irItoa64(int64(len(msg)))
		e.w("  call void @runtime._panicstr(") ; e.w(sty) ; e.w(" { ptr ") ; e.w(e.strConstGlobal(idx)) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(slen) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(slen) ; e.w(" }, ptr null)\n")
		e.declareRuntime("runtime._panicstr", "void", sty)
	}
	e.w("  unreachable\n")

	e.w(mergeLabel) ; e.w(":\n")
	if !isVoid {
		e.w("  ") ; e.w(reg) ; e.w(" = phi ") ; e.w(retType) ; e.w(" ")
		for i := range impls {
			if i > 0 { e.w(", ") }
			e.w("[ ") ; e.w(callRegs[i]) ; e.w(", %") ; e.w(phiLabels[i]) ; e.w(" ]")
		}
		e.w("\n")
	}
	e.noCheckpoint = prevNoCheckpoint
	return mergeLabel
}

func (e *irEmitter) emitTypeAssert(t *SSATypeAssert) {
	reg := e.regName(t)
	val := e.operand(t.X)
	if t.AssertedType == nil {
		if t.CommaOk {
			tupType := "{ptr, i1}"
			e.nextReg++
			tmp := "%tas" | irItoa(e.nextReg)
			e.w("  ") ; e.w(tmp) ; e.w(" = alloca ") ; e.w(tupType) ; e.w("\n")
			e.w("  store ") ; e.w(tupType) ; e.w(" zeroinitializer, ptr ") ; e.w(tmp) ; e.w("\n")
			e.w("  ") ; e.w(reg) ; e.w(" = load ") ; e.w(tupType) ; e.w(", ptr ") ; e.w(tmp) ; e.w("\n")
		} else {
			e.w("  ") ; e.w(reg) ; e.w(" = inttoptr " | e.intptrType() | " 0 to ptr\n")
		}
		return
	}
	assertedType := e.llvmType(t.AssertedType)
	voidAssert := assertedType == "void"
	if voidAssert {
		assertedType = "ptr"
	}
	var xType Type
	if t.X != nil {
		xType = t.X.SSAType()
	}
	if xType == nil {
		if t.CommaOk && len(assertedType) > 0 {
			tupType := "{" | assertedType | ", i1}"
			e.nextReg++
			tmp := "%tas" | irItoa(e.nextReg)
			e.w("  ") ; e.w(tmp) ; e.w(" = alloca ") ; e.w(tupType) ; e.w("\n")
			e.w("  store ") ; e.w(tupType) ; e.w(" zeroinitializer, ptr ") ; e.w(tmp) ; e.w("\n")
			e.w("  ") ; e.w(reg) ; e.w(" = load ") ; e.w(tupType) ; e.w(", ptr ") ; e.w(tmp) ; e.w("\n")
		} else if !t.CommaOk {
			e.w("  ") ; e.w(reg) ; e.w(" = inttoptr " | e.intptrType() | " 0 to ptr\n")
		} else {
			e.w("  ; skipped nil X type (commaok)\n")
		}
		return
	}
	inputType := e.llvmType(xType)
	if at, ok := e.allocTypes[t.X]; ok {
		inputType = at
	}
	var valPtr, typePtr string
	if inputType == "ptr" {
		valPtr = val
		typePtr = "null"
	} else {
		valPtr = e.nextReg2("ta")
		e.w("  ") ; e.w(valPtr) ; e.w(" = extractvalue " | e.ifaceType() | " ") ; e.w(val) ; e.w(", 1\n")
		typePtr = e.nextReg2("ta")
		e.w("  ") ; e.w(typePtr) ; e.w(" = extractvalue " | e.ifaceType() | " ") ; e.w(val) ; e.w(", 0\n")
	}
	// Asserting to an interface type: no concrete value ever carries the
	// interface type's own hash, so the check must instead admit the
	// type-ID of any type in the link set whose method set covers the
	// interface (same scan invoke dispatch uses).
	var ifaceT *TCInterface
	if it, okI := SafeUnderlying(t.AssertedType).(*TCInterface); okI && assertedType == e.ifaceType() {
		ifaceT = it
	}
	isIfaceAssert := ifaceT != nil
	if t.CommaOk {
		var ok string
		if isIfaceAssert && typePtr != "null" {
			ok = e.emitIfaceAssertOK(ifaceT, typePtr)
		} else if isIfaceAssert {
			// degenerate concrete-ptr input: statically typed, non-nil check
			ok = e.nextReg2("ta")
			e.w("  ") ; e.w(ok) ; e.w(" = icmp ne ptr ") ; e.w(valPtr) ; e.w(", null\n")
		} else {
			tidGlobal := e.typeIDHash(t.AssertedType)
			ok = e.nextReg2("ta")
			tp := typePtr
			if tp == "null" { tp = "0" }
			e.w("  ") ; e.w(ok) ; e.w(" = icmp eq " | e.intptrType() | " ") ; e.w(tp) ; e.w(", ") ; e.w(tidGlobal) ; e.w("\n")
		}
		// A failed comma-ok assertion must yield the zero value, never the
		// raw interface data reinterpreted as the asserted type.
		var loaded string
		if isIfaceAssert {
			// result keeps the {i64, ptr} interface representation
			tidOut := typePtr
			if typePtr == "null" {
				tidOut = "0"
				if t.X.SSAType() != nil {
					tidOut = e.typeIDHash(t.X.SSAType())
				}
			}
			selTid := e.nextReg2("ta")
			ipt := e.intptrType()
			e.w("  ") ; e.w(selTid) ; e.w(" = select i1 ") ; e.w(ok) ; e.w(", " | ipt | " ") ; e.w(tidOut) ; e.w(", " | ipt | " 0\n")
			selPtr := e.nextReg2("ta")
			e.w("  ") ; e.w(selPtr) ; e.w(" = select i1 ") ; e.w(ok) ; e.w(", ptr ") ; e.w(valPtr) ; e.w(", ptr null\n")
			agg0 := e.nextReg2("ta")
			e.w("  ") ; e.w(agg0) ; e.w(" = insertvalue " | e.ifaceType() | " undef, " | e.intptrType() | " ") ; e.w(selTid) ; e.w(", 0\n")
			loaded = e.nextReg2("ta")
			e.w("  ") ; e.w(loaded) ; e.w(" = insertvalue " | e.ifaceType() | " ") ; e.w(agg0) ; e.w(", ptr ") ; e.w(selPtr) ; e.w(", 1\n")
		} else if assertedType == "ptr" {
			loaded = e.nextReg2("ta")
			e.w("  ") ; e.w(loaded) ; e.w(" = select i1 ") ; e.w(ok) ; e.w(", ptr ") ; e.w(valPtr) ; e.w(", ptr null\n")
		} else if e.isScalarType(assertedType) {
			// Inline representation: unpacking is a bit-cast of the value
			// slot, never a load, so a nil interface or a failed assertion
			// yields zero without touching memory (Go spec: a failed
			// comma-ok assert yields the zero value).
			extracted := e.extractScalarFromIface(valPtr, assertedType)
			zero := "0"
			if assertedType == "float" || assertedType == "double" {
				zero = "0.000000e+00"
			}
			loaded = e.nextReg2("ta")
			e.w("  ") ; e.w(loaded) ; e.w(" = select i1 ") ; e.w(ok) ; e.w(", ") ; e.w(assertedType) ; e.w(" ") ; e.w(extracted) ; e.w(", ") ; e.w(assertedType) ; e.w(" ") ; e.w(zero) ; e.w("\n")
		} else {
			nonnull0 := e.nextReg2("ta")
			e.w("  ") ; e.w(nonnull0) ; e.w(" = icmp ne ptr ") ; e.w(valPtr) ; e.w(", null\n")
			nonnull := e.nextReg2("ta")
			e.w("  ") ; e.w(nonnull) ; e.w(" = and i1 ") ; e.w(ok) ; e.w(", ") ; e.w(nonnull0) ; e.w("\n")
			e.nextReg++
			safeLabel := "ta.safe" | irItoa(e.nextReg)
			e.nextReg++
			zeroLabel := "ta.zero" | irItoa(e.nextReg)
			e.nextReg++
			mergeLabel := "ta.merge" | irItoa(e.nextReg)
			e.w("  br i1 ") ; e.w(nonnull) ; e.w(", label %") ; e.w(safeLabel) ; e.w(", label %") ; e.w(zeroLabel) ; e.w("\n")
			e.w(safeLabel) ; e.w(":\n")
			realLoad := e.nextReg2("ta")
			e.w("  ") ; e.w(realLoad) ; e.w(" = load ") ; e.w(assertedType) ; e.w(", ptr ") ; e.w(valPtr) ; e.w("\n")
			e.w("  br label %") ; e.w(mergeLabel) ; e.w("\n")
			e.w(zeroLabel) ; e.w(":\n")
			e.w("  br label %") ; e.w(mergeLabel) ; e.w("\n")
			e.w(mergeLabel) ; e.w(":\n")
			loaded = e.nextReg2("ta")
			e.w("  ") ; e.w(loaded) ; e.w(" = phi ") ; e.w(assertedType) ; e.w(" [ ") ; e.w(realLoad) ; e.w(", %") ; e.w(safeLabel) ; e.w(" ], [ zeroinitializer, %") ; e.w(zeroLabel) ; e.w(" ]\n")
			if blk := t.InstrBlock(); blk != nil {
				e.blockExitLabel[blk.Index] = "%" | mergeLabel
			}
		}
		tupType := "{" | assertedType | ", i1}"
		t1 := e.nextReg2("ta")
		e.w("  ") ; e.w(t1) ; e.w(" = insertvalue ") ; e.w(tupType) ; e.w(" undef, ") ; e.w(assertedType) ; e.w(" ") ; e.w(loaded) ; e.w(", 0\n")
		e.w("  ") ; e.w(reg) ; e.w(" = insertvalue ") ; e.w(tupType) ; e.w(" ") ; e.w(t1) ; e.w(", i1 ") ; e.w(ok) ; e.w(", 1\n")
		if voidAssert {
			e.allocTypes[t] = tupType
		}
	} else {
		// Single-result assertion: panic on type-ID mismatch (Go semantics).
		// typePtr == "null" means the input was already a concrete pointer,
		// so there is no runtime type information to check.
		if typePtr != "null" {
			var ok string
			if isIfaceAssert {
				ok = e.emitIfaceAssertOK(ifaceT, typePtr)
			} else {
				tidGlobal := e.typeIDHash(t.AssertedType)
				ok = e.nextReg2("ta")
				e.w("  ") ; e.w(ok) ; e.w(" = icmp eq " | e.intptrType() | " ") ; e.w(typePtr) ; e.w(", ") ; e.w(tidGlobal) ; e.w("\n")
			}
			e.nextReg++
			goodLabel := "ta.good" | irItoa(e.nextReg)
			e.nextReg++
			badLabel := "ta.bad" | irItoa(e.nextReg)
			e.w("  br i1 ") ; e.w(ok) ; e.w(", label %") ; e.w(goodLabel) ; e.w(", label %") ; e.w(badLabel) ; e.w("\n")
			e.w(badLabel) ; e.w(":\n")
			sty := e.sliceType()
			msg := "type assertion failed"
			idx := e.addStringConst(msg)
			ipt := e.intptrType()
			slen := irItoa64(int64(len(msg)))
			e.w("  call void @runtime._panicstr(") ; e.w(sty) ; e.w(" { ptr ") ; e.w(e.strConstGlobal(idx)) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(slen) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(slen) ; e.w(" }, ptr null)\n")
			e.declareRuntime("runtime._panicstr", "void", sty)
			e.w("  unreachable\n")
			e.w(goodLabel) ; e.w(":\n")
			if blk := t.InstrBlock(); blk != nil {
				e.blockExitLabel[blk.Index] = "%" | goodLabel
			}
		}
		if isIfaceAssert {
			tidOut := typePtr
			if typePtr == "null" {
				tidOut = "0"
				if t.X.SSAType() != nil {
					tidOut = e.typeIDHash(t.X.SSAType())
				}
			}
			agg0 := e.nextReg2("ta")
			e.w("  ") ; e.w(agg0) ; e.w(" = insertvalue " | e.ifaceType() | " undef, " | e.intptrType() | " ") ; e.w(tidOut) ; e.w(", 0\n")
			e.w("  ") ; e.w(reg) ; e.w(" = insertvalue " | e.ifaceType() | " ") ; e.w(agg0) ; e.w(", ptr ") ; e.w(valPtr) ; e.w(", 1\n")
		} else if assertedType == "ptr" {
			e.w("  ") ; e.w(reg) ; e.w(" = select i1 true, ptr ") ; e.w(valPtr) ; e.w(", ptr null\n")
		} else if e.isScalarType(assertedType) {
			extracted := e.extractScalarFromIface(valPtr, assertedType)
			e.w("  ") ; e.w(reg) ; e.w(" = add ") ; e.w(assertedType) ; e.w(" ") ; e.w(extracted) ; e.w(", 0\n")
		} else {
			e.w("  ") ; e.w(reg) ; e.w(" = load ") ; e.w(assertedType) ; e.w(", ptr ") ; e.w(valPtr) ; e.w("\n")
		}
		if voidAssert {
			e.allocTypes[t] = assertedType
		}
	}
}

func (e *irEmitter) extractScalarFromIface(valPtr string, assertedType string) (s string) {
	// A scalar that fits in a pointer is stored inline in the interface
	// value slot (see emitMakeInterface / boxConcreteToIfaceParam), so the
	// asserted value is that slot reinterpreted, not a load through it.
	// Anything wider than a pointer (i64/double on a 32-bit target) was
	// boxed, so it must be loaded through the value pointer.
	w := e.ifaceInlineWidth(assertedType)
	if w <= 0 || w > e.intBits(e.intptrType()) {
		loaded := e.nextReg2("ta")
		e.w("  ") ; e.w(loaded) ; e.w(" = load ") ; e.w(assertedType) ; e.w(", ptr ") ; e.w(valPtr) ; e.w("\n")
		return loaded
	}
	return e.emitInlineFromPtr(assertedType, valPtr, "ta")
}
