package main

import (
	. "git.smesh.lol/moxie/pkg/types"
)

func (e *irEmitter) chanPanicStr() (s string) {
	msg := "channels not implemented"
	idx := e.addStringConst(msg)
	ipt := e.intptrType()
	slen := irItoa64(int64(len(msg)))
	return "{ ptr " | e.strConstGlobal(idx) | ", " | ipt | " " | slen | ", " | ipt | " " | slen | " }"
}


func (e *irEmitter) chanElemType(chanType Type) (elemT string) {
	if ch, ok := SafeUnderlying(chanType).(*TCChan); ok && ch.Elem != nil {
		et := e.llvmType(ch.Elem)
		if et != "void" && et != "" {
			return et
		}
	}
	return "i8"
}

// chanElemTType returns the element Type of a chan type (not its LLVM string).
func (e *irEmitter) chanElemTType(chanType Type) (t Type) {
	if ch, ok := SafeUnderlying(chanType).(*TCChan); ok {
		return ch.Elem
	}
	return nil
}

// codecIface returns the moxie.Codec interface type. Found by scanning the
// universe registry for a package-scope "Codec" object whose underlying type
// is an interface, so the module path does not matter. A named interface type
// is *Named{Under: *TCInterface}, so unwrap through SafeUnderlying.
//
// The moxie package is registered only when the package being compiled (or
// one of its registered imports) names it, so the scan misses it for a
// package whose chan element type merely has the two Codec methods. Fall
// back to the canonical shape in that case: whether a chan op routes through
// the codec path must not depend on which packages happen to be in the
// registry.
func (e *irEmitter) codecIface() *TCInterface {
	for _, pkg := range cctx.universe.Registry {
		if pkg == nil || pkg.Scope == nil {
			continue
		}
		obj := pkg.Scope.Lookup("Codec")
		if obj == nil {
			continue
		}
		ot := ObjectType(obj)
		if iface, ok := ot.(*TCInterface); ok {
			return iface
		}
		if named, ok := ot.(*Named); ok {
			if iface, ok2 := SafeUnderlying(named).(*TCInterface); ok2 {
				return iface
			}
		}
	}
	return e.synthCodecIface()
}

// synthCodecIface builds moxie.Codec from its fixed shape:
//
//	EncodeTo(w io.Writer) error
//	DecodeFrom(r io.Reader) error
//
// io is always registered when a package can declare these methods (the
// signatures name it), and error lives in the universe.
func (e *irEmitter) synthCodecIface() (iface *TCInterface) {
	ioPkg := cctx.universe.LookupByName("io")
	if ioPkg == nil || ioPkg.Scope == nil {
		return nil
	}
	wObj := ioPkg.Scope.Lookup("Writer")
	rObj := ioPkg.Scope.Lookup("Reader")
	if wObj == nil || rObj == nil || cctx.universe.Error == nil {
		return nil
	}
	wT := ObjectType(wObj)
	rT := ObjectType(rObj)
	errT := ObjectType(cctx.universe.Error)
	if wT == nil || rT == nil || errT == nil {
		return nil
	}
	encSig := NewSignature(nil,
		NewTuple(NewTCVar(nil, "w", wT)),
		NewTuple(NewTCVar(nil, "", errT)), false)
	decSig := NewSignature(nil,
		NewTuple(NewTCVar(nil, "r", rT)),
		NewTuple(NewTCVar(nil, "", errT)), false)
	methods := []*IfaceMethod{:0:2}
	methods = push(methods, NewTCIfaceMethod("EncodeTo", encSig))
	methods = push(methods, NewTCIfaceMethod("DecodeFrom", decSig))
	iface = NewTCInterface(methods, nil)
	iface.Complete()
	return iface
}

// elemImplementsCodec reports whether the chan element type (or *T) satisfies
// moxie.Codec. Mirrors the legacy elemTypeImplementsCodec: value- and
// pointer-receiver method sets both count.
func (e *irEmitter) elemImplementsCodec(t Type) bool {
	if ch, ok := SafeUnderlying(t).(*TCChan); ok {
		t = ch.Elem
	}
	codec := e.codecIface()
	if codec == nil {
		return false
	}
	if Implements(t, codec) {
		return true
	}
	return Implements(NewPointer(t), codec)
}

// emitCodecIface builds a moxie.Codec interface value {*T typecode, &v} and
// returns the LLVM register holding it. valPtr must already be a T* alloca.
func (e *irEmitter) emitCodecIface(elemType Type, valPtr string) (reg string) {
	ity := e.ifaceType()
	typeid := e.typeIDHash(NewPointer(elemType))
	e.nextReg++
	t1 := "%codec" | irItoa(e.nextReg)
	e.w("  ") ; e.w(t1) ; e.w(" = insertvalue ") ; e.w(ity) ; e.w(" undef, ") ; e.w(e.intptrType()) ; e.w(" ") ; e.w(typeid) ; e.w(", 0\n")
	e.nextReg++
	reg = "%codec" | irItoa(e.nextReg)
	e.w("  ") ; e.w(reg) ; e.w(" = insertvalue ") ; e.w(ity) ; e.w(" ") ; e.w(t1) ; e.w(", ptr ") ; e.w(valPtr) ; e.w(", 1\n")
	return reg
}

func (e *irEmitter) emitChanRecv(u *SSAUnOp) {
	if e.elemImplementsCodec(u.X.SSAType()) {
		e.emitCodecChanRecv(u)
		return
	}
	if elemNeedsStructural(chanElemType(u.X.SSAType())) {
		e.emitStructuralChanRecv(u)
		return
	}
	reg := e.regName(u)
	elemType := e.chanElemType(u.X.SSAType())
	ch := e.operand(u.X)
	opType := "{ptr, ptr, i32, ptr}"

	e.nextReg++
	valAlloca := "%chanrv" | irItoa(e.nextReg)
	e.w("  ") ; e.w(valAlloca) ; e.w(" = alloca ") ; e.w(elemType) ; e.w("\n")
	e.w("  store ") ; e.w(elemType) ; e.w(" zeroinitializer, ptr ") ; e.w(valAlloca) ; e.w("\n")

	e.nextReg++
	opAlloca := "%chanrop" | irItoa(e.nextReg)
	e.w("  ") ; e.w(opAlloca) ; e.w(" = alloca ") ; e.w(opType) ; e.w("\n")
	e.w("  store ") ; e.w(opType) ; e.w(" zeroinitializer, ptr ") ; e.w(opAlloca) ; e.w("\n")

	e.nextReg++
	okReg := "%chanrok" | irItoa(e.nextReg)
	e.w("  ") ; e.w(okReg) ; e.w(" = call i1 @runtime.chanRecv(ptr ") ; e.w(ch) ; e.w(", ptr ") ; e.w(valAlloca) ; e.w(", ptr ") ; e.w(opAlloca) ; e.w(", ptr null)\n")
	e.declareRuntime("runtime.chanRecv", "i1", "ptr, ptr, ptr")

	if u.CommaOk {
		e.nextReg++
		loadedVal := "%chanrlv" | irItoa(e.nextReg)
		e.w("  ") ; e.w(loadedVal) ; e.w(" = load ") ; e.w(elemType) ; e.w(", ptr ") ; e.w(valAlloca) ; e.w("\n")

		tupleType := "{" | elemType | ", i1}"
		e.nextReg++
		t1 := "%chanrt1_" | irItoa(e.nextReg)
		e.w("  ") ; e.w(t1) ; e.w(" = insertvalue ") ; e.w(tupleType) ; e.w(" zeroinitializer, ") ; e.w(elemType) ; e.w(" ") ; e.w(loadedVal) ; e.w(", 0\n")
		e.w("  ") ; e.w(reg) ; e.w(" = insertvalue ") ; e.w(tupleType) ; e.w(" ") ; e.w(t1) ; e.w(", i1 ") ; e.w(okReg) ; e.w(", 1\n")
	} else {
		e.w("  ") ; e.w(reg) ; e.w(" = load ") ; e.w(elemType) ; e.w(", ptr ") ; e.w(valAlloca) ; e.w("\n")
	}
}

// chanElemType returns the element type of a channel's static type.
func chanElemType(t Type) Type {
	if ch, ok := SafeUnderlying(t).(*TCChan); ok {
		return ch.Elem
	}
	return nil
}

// elemNeedsStructural reports whether a channel element CANNOT cross a spawn
// boundary as raw bytes.
//
// The spawn boundary copies the element's raw bytes into a shared ring, and the
// receiver is a forked domain: a raw slice/string/map/interface/pointer is an
// address in the SENDER's arena space, so the child reads whatever its own
// copy-on-write view holds at that address. Measured on a runtime-built []byte:
// the child got the right length and the bytes [4, 0, 0, ...] - the push
// allocator's first-batch marker, i.e. allocator metadata, not the payload.
//
// Such an element is encoded with the structural codec instead
// (runtime.ChanSendStructural / ChanRecvStructural). Types that implement
// moxie.Codec keep their own EncodeTo/DecodeFrom path, which is checked first.
// Channels and funcs stay raw: they are handles, not payloads.
func elemNeedsStructural(t Type) (ok bool) {
	if t == nil {
		return false
	}
	u := SafeUnderlying(t)
	if u == nil {
		return true
	}
	switch tt := u.(type) {
	case *Basic:
		return tt.Kind == UnsafePointer
	case *Pointer:
		return true
	case *Slice:
		return true
	case *TCMap:
		return true
	case *TCInterface:
		return true
	case *Array:
		return elemNeedsStructural(tt.Elem)
	case *TCStruct:
		for i := 0; i < tt.NumFields(); i++ {
			if elemNeedsStructural(tt.Field(i).Typ) {
				return true
			}
		}
		return false
	case *Signature:
		return false
	case *TCChan:
		return false
	}
	return true
}

// emitTypeDescFor emits the address of t's type-descriptor global, the *RawType
// the structural codec walks.
func (e *irEmitter) emitTypeDescFor(t Type) (reg string) {
	e.collectTypeDesc(t)
	tn := e.reflectTypeName(t)
	e.nextReg++
	reg = "%chtd" | irItoa(e.nextReg)
	e.w("  ") ; e.w(reg) ; e.w(" = bitcast ptr ") ; e.w(irQuoteName(tn)) ; e.w(" to ptr\n")
	return reg
}

// emitStructuralChanSend is the send for an element that holds pointers: the
// value is handed to the runtime with its type descriptor, and a spawn-bound
// channel encodes it structurally instead of copying an address across.
func (e *irEmitter) emitStructuralChanSend(s *SSASend) {
	elemType := chanElemType(s.Chan.SSAType())
	elemTType := e.chanElemType(s.Chan.SSAType())
	ch := e.operand(s.Chan)
	val := e.operand(s.X)
	opType := "{ptr, ptr, i32, ptr}"

	e.nextReg++
	valAlloca := "%chanssv" | irItoa(e.nextReg)
	e.w("  ") ; e.w(valAlloca) ; e.w(" = alloca ") ; e.w(elemTType) ; e.w("\n")

	valSrcType := e.llvmType(s.X.SSAType())
	resolved := e.resolvedType(s.X, valSrcType)
	if resolved != valSrcType {
		valSrcType = resolved
	}
	if valSrcType == elemTType {
		e.w("  store ") ; e.w(elemTType) ; e.w(" ") ; e.w(val) ; e.w(", ptr ") ; e.w(valAlloca) ; e.w("\n")
	} else {
		e.w("  store ") ; e.w(valSrcType) ; e.w(" ") ; e.w(val) ; e.w(", ptr ") ; e.w(valAlloca) ; e.w("\n")
	}

	td := e.emitTypeDescFor(elemType)

	e.nextReg++
	opAlloca := "%chanssop" | irItoa(e.nextReg)
	e.w("  ") ; e.w(opAlloca) ; e.w(" = alloca ") ; e.w(opType) ; e.w("\n")
	e.w("  store ") ; e.w(opType) ; e.w(" zeroinitializer, ptr ") ; e.w(opAlloca) ; e.w("\n")

	e.w("  call void @runtime.ChanSendStructural(ptr ") ; e.w(ch) ; e.w(", ptr ") ; e.w(td) ; e.w(", ptr ") ; e.w(valAlloca) ; e.w(", ptr ") ; e.w(opAlloca) ; e.w(", ptr null)\n")
	e.declareRuntime("runtime.ChanSendStructural", "void", "ptr, ptr, ptr, ptr")
}

// emitStructuralChanRecv is the recv counterpart: the runtime decodes the frame
// into the receiver's own slot, so a slice arrives with a fresh backing in the
// receiver's arena.
func (e *irEmitter) emitStructuralChanRecv(u *SSAUnOp) {
	reg := e.regName(u)
	elemType := chanElemType(u.X.SSAType())
	elemTType := e.chanElemType(u.X.SSAType())
	ch := e.operand(u.X)
	opType := "{ptr, ptr, i32, ptr}"

	e.nextReg++
	valAlloca := "%chanrsv" | irItoa(e.nextReg)
	e.w("  ") ; e.w(valAlloca) ; e.w(" = alloca ") ; e.w(elemTType) ; e.w("\n")
	e.w("  store ") ; e.w(elemTType) ; e.w(" zeroinitializer, ptr ") ; e.w(valAlloca) ; e.w("\n")

	td := e.emitTypeDescFor(elemType)

	e.nextReg++
	opAlloca := "%chanrsop" | irItoa(e.nextReg)
	e.w("  ") ; e.w(opAlloca) ; e.w(" = alloca ") ; e.w(opType) ; e.w("\n")
	e.w("  store ") ; e.w(opType) ; e.w(" zeroinitializer, ptr ") ; e.w(opAlloca) ; e.w("\n")

	e.nextReg++
	okReg := "%chanrsok" | irItoa(e.nextReg)
	e.w("  ") ; e.w(okReg) ; e.w(" = call i1 @runtime.ChanRecvStructural(ptr ") ; e.w(ch) ; e.w(", ptr ") ; e.w(td) ; e.w(", ptr ") ; e.w(valAlloca) ; e.w(", ptr ") ; e.w(opAlloca) ; e.w(", ptr null)\n")
	e.declareRuntime("runtime.ChanRecvStructural", "i1", "ptr, ptr, ptr, ptr")

	if u.CommaOk {
		e.nextReg++
		loadedVal := "%chanrslv" | irItoa(e.nextReg)
		e.w("  ") ; e.w(loadedVal) ; e.w(" = load ") ; e.w(elemTType) ; e.w(", ptr ") ; e.w(valAlloca) ; e.w("\n")
		tupleType := "{" | elemTType | ", i1}"
		e.nextReg++
		t1 := "%chanrst1_" | irItoa(e.nextReg)
		e.w("  ") ; e.w(t1) ; e.w(" = insertvalue ") ; e.w(tupleType) ; e.w(" zeroinitializer, ") ; e.w(elemTType) ; e.w(" ") ; e.w(loadedVal) ; e.w(", 0\n")
		e.w("  ") ; e.w(reg) ; e.w(" = insertvalue ") ; e.w(tupleType) ; e.w(" ") ; e.w(t1) ; e.w(", i1 ") ; e.w(okReg) ; e.w(", 1\n")
	} else {
		e.w("  ") ; e.w(reg) ; e.w(" = load ") ; e.w(elemTType) ; e.w(", ptr ") ; e.w(valAlloca) ; e.w("\n")
	}
}

func (e *irEmitter) emitChanSend(s *SSASend) {
	if e.elemImplementsCodec(s.Chan.SSAType()) {
		e.emitCodecChanSend(s)
		return
	}
	if elemNeedsStructural(chanElemType(s.Chan.SSAType())) {
		e.emitStructuralChanSend(s)
		return
	}
	elemType := e.chanElemType(s.Chan.SSAType())
	ch := e.operand(s.Chan)
	val := e.operand(s.X)
	opType := "{ptr, ptr, i32, ptr}"

	e.nextReg++
	valAlloca := "%chansv" | irItoa(e.nextReg)
	e.w("  ") ; e.w(valAlloca) ; e.w(" = alloca ") ; e.w(elemType) ; e.w("\n")

	valSrcType := e.llvmType(s.X.SSAType())
	resolved := e.resolvedType(s.X, valSrcType)
	if resolved != valSrcType {
		valSrcType = resolved
	}
	if valSrcType == elemType {
		e.w("  store ") ; e.w(elemType) ; e.w(" ") ; e.w(val) ; e.w(", ptr ") ; e.w(valAlloca) ; e.w("\n")
	} else {
		e.w("  store ") ; e.w(valSrcType) ; e.w(" ") ; e.w(val) ; e.w(", ptr ") ; e.w(valAlloca) ; e.w("\n")
	}

	e.nextReg++
	opAlloca := "%chansop" | irItoa(e.nextReg)
	e.w("  ") ; e.w(opAlloca) ; e.w(" = alloca ") ; e.w(opType) ; e.w("\n")
	e.w("  store ") ; e.w(opType) ; e.w(" zeroinitializer, ptr ") ; e.w(opAlloca) ; e.w("\n")

	e.w("  call void @runtime.chanSend(ptr ") ; e.w(ch) ; e.w(", ptr ") ; e.w(valAlloca) ; e.w(", ptr ") ; e.w(opAlloca) ; e.w(", ptr null)\n")
	e.declareRuntime("runtime.chanSend", "void", "ptr, ptr, ptr")
}

// emitCodecChanRecv emits the dual-path chan recv for a chan whose element
// type implements moxie.Codec. Calls runtime.ChanRecvDual with a Codec
// interface wrapping *T; the runtime dispatches on ch.spawnBound to either
// the ring-codec path or the in-runtime queue.
func (e *irEmitter) emitCodecChanRecv(u *SSAUnOp) {
	reg := e.regName(u)
	elemType := e.chanElemType(u.X.SSAType())
	ch := e.operand(u.X)
	opType := "{ptr, ptr, i32, ptr}"
	ity := e.ifaceType()

	e.nextReg++
	valAlloca := "%chanrv" | irItoa(e.nextReg)
	e.w("  ") ; e.w(valAlloca) ; e.w(" = alloca ") ; e.w(elemType) ; e.w("\n")
	e.w("  store ") ; e.w(elemType) ; e.w(" zeroinitializer, ptr ") ; e.w(valAlloca) ; e.w("\n")

	codecReg := e.emitCodecIface(e.chanElemTType(u.X.SSAType()), valAlloca)

	e.nextReg++
	opAlloca := "%chanrop" | irItoa(e.nextReg)
	e.w("  ") ; e.w(opAlloca) ; e.w(" = alloca ") ; e.w(opType) ; e.w("\n")
	e.w("  store ") ; e.w(opType) ; e.w(" zeroinitializer, ptr ") ; e.w(opAlloca) ; e.w("\n")

	e.nextReg++
	okReg := "%chanrok" | irItoa(e.nextReg)
	e.w("  ") ; e.w(okReg) ; e.w(" = call i1 @runtime.ChanRecvDual(ptr ") ; e.w(ch) ; e.w(", ") ; e.w(ity) ; e.w(" ") ; e.w(codecReg) ; e.w(", ptr ") ; e.w(valAlloca) ; e.w(", ptr ") ; e.w(opAlloca) ; e.w(", ptr null)\n")
	e.declareRuntime("runtime.ChanRecvDual", "i1", "ptr, " | ity | ", ptr, ptr")

	if u.CommaOk {
		e.nextReg++
		loadedVal := "%chanrlv" | irItoa(e.nextReg)
		e.w("  ") ; e.w(loadedVal) ; e.w(" = load ") ; e.w(elemType) ; e.w(", ptr ") ; e.w(valAlloca) ; e.w("\n")

		tupleType := "{" | elemType | ", i1}"
		e.nextReg++
		t1 := "%chanrt1_" | irItoa(e.nextReg)
		e.w("  ") ; e.w(t1) ; e.w(" = insertvalue ") ; e.w(tupleType) ; e.w(" zeroinitializer, ") ; e.w(elemType) ; e.w(" ") ; e.w(loadedVal) ; e.w(", 0\n")
		e.w("  ") ; e.w(reg) ; e.w(" = insertvalue ") ; e.w(tupleType) ; e.w(" ") ; e.w(t1) ; e.w(", i1 ") ; e.w(okReg) ; e.w(", 1\n")
	} else {
		e.w("  ") ; e.w(reg) ; e.w(" = load ") ; e.w(elemType) ; e.w(", ptr ") ; e.w(valAlloca) ; e.w("\n")
	}
}

// emitCodecChanSend emits the dual-path chan send for a chan whose element
// type implements moxie.Codec.
func (e *irEmitter) emitCodecChanSend(s *SSASend) {
	elemType := e.chanElemType(s.Chan.SSAType())
	ch := e.operand(s.Chan)
	val := e.operand(s.X)
	opType := "{ptr, ptr, i32, ptr}"
	ity := e.ifaceType()

	e.nextReg++
	valAlloca := "%chansv" | irItoa(e.nextReg)
	e.w("  ") ; e.w(valAlloca) ; e.w(" = alloca ") ; e.w(elemType) ; e.w("\n")

	valSrcType := e.llvmType(s.X.SSAType())
	resolved := e.resolvedType(s.X, valSrcType)
	if resolved != valSrcType {
		valSrcType = resolved
	}
	if valSrcType == elemType {
		e.w("  store ") ; e.w(elemType) ; e.w(" ") ; e.w(val) ; e.w(", ptr ") ; e.w(valAlloca) ; e.w("\n")
	} else {
		e.w("  store ") ; e.w(valSrcType) ; e.w(" ") ; e.w(val) ; e.w(", ptr ") ; e.w(valAlloca) ; e.w("\n")
	}

	codecReg := e.emitCodecIface(e.chanElemTType(s.Chan.SSAType()), valAlloca)

	e.nextReg++
	opAlloca := "%chansop" | irItoa(e.nextReg)
	e.w("  ") ; e.w(opAlloca) ; e.w(" = alloca ") ; e.w(opType) ; e.w("\n")
	e.w("  store ") ; e.w(opType) ; e.w(" zeroinitializer, ptr ") ; e.w(opAlloca) ; e.w("\n")

	e.w("  call void @runtime.ChanSendDual(ptr ") ; e.w(ch) ; e.w(", ") ; e.w(ity) ; e.w(" ") ; e.w(codecReg) ; e.w(", ptr ") ; e.w(valAlloca) ; e.w(", ptr ") ; e.w(opAlloca) ; e.w(", ptr null)\n")
	e.declareRuntime("runtime.ChanSendDual", "void", "ptr, " | ity | ", ptr, ptr")
}

func (e *irEmitter) emitSelect(s *SSASelect) {
	// A select with no clauses is the one legacy shortcuts in createSelect:
	// select {} blocks forever, which the runtime reports through deadlock()
	// (runtimePanic("deadlock")), and a select whose only clause is default has
	// nothing to do. No channel state, no dispatch, no result registers - the
	// builder emits no consumers for either form.
	if len(s.States) == 0 {
		if s.Blocking {
			e.w("  call void @runtime.deadlock(ptr null)\n")
			e.declareRuntime("runtime.deadlock", "void", "")
		}
		return
	}
	_ = e.regName(s)
	ipt := e.intptrType()
	sty := e.sliceType()
	nStates := int32(len(s.States))
	stateType := "{ptr, ptr}"  // chanSelectState: {ch, value}
	opType := "{ptr, ptr, i32, ptr}" // channelOp

	// Find largest recv element type for recvbuf.
	maxElemType := "i8"
	for _, st := range s.States {
		if st.Dir == SelectDirRecv && st.Chan != nil {
			et := e.chanElemType(st.Chan.SSAType())
			if et != "i8" {
				maxElemType = et
			}
		}
	}

	// Alloca recvbuf.
	e.nextReg++
	recvbuf := "%selrb" | irItoa(e.nextReg)
	e.w("  ") ; e.w(recvbuf) ; e.w(" = alloca ") ; e.w(maxElemType) ; e.w("\n")
	e.w("  store ") ; e.w(maxElemType) ; e.w(" zeroinitializer, ptr ") ; e.w(recvbuf) ; e.w("\n")

	// Alloca states array.
	statesArrayType := "[" | irItoa(nStates) | " x " | stateType | "]"
	e.nextReg++
	statesArr := "%selst" | irItoa(e.nextReg)
	e.w("  ") ; e.w(statesArr) ; e.w(" = alloca ") ; e.w(statesArrayType) ; e.w("\n")
	e.w("  store ") ; e.w(statesArrayType) ; e.w(" zeroinitializer, ptr ") ; e.w(statesArr) ; e.w("\n")

	// Fill each state.
	for i, st := range s.States {
		ch := "null"
		if st.Chan != nil {
			ch = e.operand(st.Chan)
		}
		e.nextReg++
		gep := "%selgep" | irItoa(e.nextReg)
		e.w("  ") ; e.w(gep) ; e.w(" = getelementptr inbounds ") ; e.w(stateType)
		e.w(", ptr ") ; e.w(statesArr) ; e.w(", i32 ") ; e.w(irItoa(int32(i))) ; e.w("\n")

		// Store ch at field 0.
		e.nextReg++
		chGep := "%selch" | irItoa(e.nextReg)
		e.w("  ") ; e.w(chGep) ; e.w(" = getelementptr inbounds ") ; e.w(stateType)
		e.w(", ptr ") ; e.w(gep) ; e.w(", i32 0, i32 0\n")
		e.w("  store ptr ") ; e.w(ch) ; e.w(", ptr ") ; e.w(chGep) ; e.w("\n")

		// Store value at field 1 (nil for recv, ptr for send).
		e.nextReg++
		valGep := "%selval" | irItoa(e.nextReg)
		e.w("  ") ; e.w(valGep) ; e.w(" = getelementptr inbounds ") ; e.w(stateType)
		e.w(", ptr ") ; e.w(gep) ; e.w(", i32 0, i32 1\n")
		if st.Dir == SelectDirSend && st.Send != nil {
			// Alloca for send value.
			sendElemType := e.chanElemType(st.Chan.SSAType())
			sendVal := e.operand(st.Send)
			e.nextReg++
			svAlloca := "%selsv" | irItoa(e.nextReg)
			e.w("  ") ; e.w(svAlloca) ; e.w(" = alloca ") ; e.w(sendElemType) ; e.w("\n")
			e.w("  store ") ; e.w(sendElemType) ; e.w(" ") ; e.w(sendVal) ; e.w(", ptr ") ; e.w(svAlloca) ; e.w("\n")
			e.w("  store ptr ") ; e.w(svAlloca) ; e.w(", ptr ") ; e.w(valGep) ; e.w("\n")
		} else {
			e.w("  store ptr null, ptr ") ; e.w(valGep) ; e.w("\n")
		}
	}

	// Build states slice: {ptr, ipt len, ipt cap}.
	e.nextReg++
	statesSlice := "%selss" | irItoa(e.nextReg)
	nStr := irItoa(nStates)
	e.w("  ") ; e.w(statesSlice) ; e.w(" = insertvalue ") ; e.w(sty) ; e.w(" zeroinitializer, ptr ") ; e.w(statesArr) ; e.w(", 0\n")
	e.nextReg++
	ss2 := "%selss" | irItoa(e.nextReg)
	e.w("  ") ; e.w(ss2) ; e.w(" = insertvalue ") ; e.w(sty) ; e.w(" ") ; e.w(statesSlice) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(nStr) ; e.w(", 1\n")
	e.nextReg++
	ss3 := "%selss" | irItoa(e.nextReg)
	e.w("  ") ; e.w(ss3) ; e.w(" = insertvalue ") ; e.w(sty) ; e.w(" ") ; e.w(ss2) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(nStr) ; e.w(", 2\n")

	// Alloca ops array (only needed for blocking select).
	opsArrayType := "[" | irItoa(nStates) | " x " | opType | "]"
	e.nextReg++
	opsArr := "%selops" | irItoa(e.nextReg)
	if s.Blocking {
		e.w("  ") ; e.w(opsArr) ; e.w(" = alloca ") ; e.w(opsArrayType) ; e.w("\n")
		e.w("  store ") ; e.w(opsArrayType) ; e.w(" zeroinitializer, ptr ") ; e.w(opsArr) ; e.w("\n")
	} else {
		e.w("  ") ; e.w(opsArr) ; e.w(" = alloca ") ; e.w(opType) ; e.w(" ; unused\n")
	}

	// Build ops slice.
	e.nextReg++
	opsSlice := "%selos" | irItoa(e.nextReg)
	if s.Blocking {
		e.w("  ") ; e.w(opsSlice) ; e.w(" = insertvalue ") ; e.w(sty) ; e.w(" zeroinitializer, ptr ") ; e.w(opsArr) ; e.w(", 0\n")
		e.nextReg++
		os2 := "%selos" | irItoa(e.nextReg)
		e.w("  ") ; e.w(os2) ; e.w(" = insertvalue ") ; e.w(sty) ; e.w(" ") ; e.w(opsSlice) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(nStr) ; e.w(", 1\n")
		e.nextReg++
		os3 := "%selos" | irItoa(e.nextReg)
		e.w("  ") ; e.w(os3) ; e.w(" = insertvalue ") ; e.w(sty) ; e.w(" ") ; e.w(os2) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(nStr) ; e.w(", 2\n")
		opsSlice = os3
	} else {
		// Non-blocking: pass empty slice (len=0).
		e.w("  ") ; e.w(opsSlice) ; e.w(" = insertvalue ") ; e.w(sty) ; e.w(" zeroinitializer, ptr null, 0\n")
	}

	// Call runtime.chanSelect(recvbuf ptr, states slice, ops slice) -> {i32, i1}.
	e.nextReg++
	selResult := "%selres" | irItoa(e.nextReg)
	e.w("  ") ; e.w(selResult) ; e.w(" = call {i32, i1} @runtime.chanSelect(ptr ") ; e.w(recvbuf)
	e.w(", ") ; e.w(sty) ; e.w(" ") ; e.w(ss3)
	e.w(", ") ; e.w(sty) ; e.w(" ") ; e.w(opsSlice) ; e.w(", ptr null)\n")
	e.declareRuntime("runtime.chanSelect", "{i32, i1}", "ptr, " | sty | ", " | sty)

	// Extract index and ok from runtime result.
	e.nextReg++
	selIdx := "%selidx" | irItoa(e.nextReg)
	e.w("  ") ; e.w(selIdx) ; e.w(" = extractvalue {i32, i1} ") ; e.w(selResult) ; e.w(", 0\n")
	e.nextReg++
	selOk := "%selok" | irItoa(e.nextReg)
	e.w("  ") ; e.w(selOk) ; e.w(" = extractvalue {i32, i1} ") ; e.w(selResult) ; e.w(", 1\n")

	// Build the SSA result tuple: {i32, i1, recvElem0, recvElem1, ...}.
	// Index 0 = selected index (i32), index 1 = recvOk (i1).
	// Index 2+ = received value for each recv case (loaded from recvbuf).
	tupType := "{i32, i1"
	for _, st := range s.States {
		if st.Dir == SelectDirRecv && st.Chan != nil {
			et := e.chanElemType(st.Chan.SSAType())
			tupType = tupType | ", " | et
		}
	}
	tupType = tupType | "}"

	// Start building tuple.
	e.nextReg++
	tup := "%selt" | irItoa(e.nextReg)
	e.w("  ") ; e.w(tup) ; e.w(" = insertvalue ") ; e.w(tupType) ; e.w(" zeroinitializer, i32 ") ; e.w(selIdx) ; e.w(", 0\n")

	e.nextReg++
	tup2 := "%selt" | irItoa(e.nextReg)
	e.w("  ") ; e.w(tup2) ; e.w(" = insertvalue ") ; e.w(tupType) ; e.w(" ") ; e.w(tup) ; e.w(", i1 ") ; e.w(selOk) ; e.w(", 1\n")
	prev := tup2

	// For each recv state, load from recvbuf and insert at tuple index 2+.
	tupIdx := int32(2)
	for _, st := range s.States {
		if st.Dir == SelectDirRecv && st.Chan != nil {
			et := e.chanElemType(st.Chan.SSAType())
			e.nextReg++
			rv := "%selrv" | irItoa(e.nextReg)
			e.w("  ") ; e.w(rv) ; e.w(" = load ") ; e.w(et) ; e.w(", ptr ") ; e.w(recvbuf) ; e.w("\n")
			e.nextReg++
			next := "%selt" | irItoa(e.nextReg)
			e.w("  ") ; e.w(next) ; e.w(" = insertvalue ") ; e.w(tupType) ; e.w(" ") ; e.w(prev) ; e.w(", ") ; e.w(et) ; e.w(" ") ; e.w(rv) ; e.w(", ") ; e.w(irItoa(tupIdx)) ; e.w("\n")
			prev = next
			tupIdx++
		}
	}

	// Map the select SSA value to the final tuple register.
	e.allocTypes[s] = tupType
	e.valName[s] = prev
}

func (e *irEmitter) emitMakeChan(m *SSAMakeChan) {
	reg := e.regName(m)
	ipt := e.intptrType()
	elemType := "i8"
	if ch, ok := SafeUnderlying(m.SSAType()).(*TCChan); ok && ch.Elem != nil {
		et := e.llvmType(ch.Elem)
		if et != "void" && et != "" {
			elemType = et
		}
	}
	e.nextReg++
	elemSz := "%mc" | irItoa(e.nextReg)
	e.w("  ") ; e.w(elemSz) ; e.w(" = ptrtoint ptr getelementptr (")
	e.w(elemType) ; e.w(", ptr null, i32 1) to ") ; e.w(ipt) ; e.w("\n")
	bufSz := "0"
	if m.Size != nil {
		bufSz = e.sextToIpt(m.Size, e.operand(m.Size))
	}
	e.w("  ") ; e.w(reg) ; e.w(" = call ptr @runtime.chanMake(")
	e.w(ipt) ; e.w(" ") ; e.w(elemSz) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(bufSz) ; e.w(", ptr null)\n")
	e.declareRuntime("runtime.chanMake", "ptr", ipt | ", " | ipt)
	// The channel's storage is the runtime allocator's; the byte size is not
	// known here, so the site is counted with a zero size.
	e.emitLogAlloc("0")
}
