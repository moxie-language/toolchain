	"git.smesh.lol/moxie/pkg/mxutil"
	. "git.smesh.lol/moxie/pkg/types"
)

// buildState holds all build-configuration and persistent state that
// outlives individual package compilations. Allocated once at init and
// never reassigned; fields are mutated through the pointer.
type buildState struct {
	selfHash        string
	buildID         string
	globalModPrefix string
	globalModDir    string
	// rootModPrefix is the module the TARGET lives in ("" when it lives in no
	// module). globalModPrefix is where imports resolve from and falls back to
	// MOXIEROOT for out-of-tree targets; restriction gating must not inherit
	// that fallback or an out-of-tree user package looks like compiler code.
	rootModPrefix  string

	globalReplaces  map[string]string
	buildJobs       int32
	tlsFailed       bool // TLS probe failed: globals shared, workers forced serial
	quietDiscover   bool
	wasmRtPkgs      map[string]bool
	builtinOnly     []string
	pkgKeyMemo      map[string]string
	linkSetKey      string // hash of the whole link set; interface dispatch impls depend on it
	tlsProbeVar     int32

	// extraTags are the -tags values, on top of the target and release tags
	// buildTagTrue already knows.
	extraTags []string
	// allowCaptures relaxes the closure-capture rule for this build. See
	// setAllowCaptures.
	allowCaptures bool
	// printCommands is -x: echo every child process before running it.
	printCommands bool
	// keepWork is -work: keep the build scratch directory and echo its path.
	keepWork bool
	// cover is -cover: emit a coverage hit per basic block and write the site
	// table beside the output.
	cover bool
	// testSrcPkgPath is the import path of the package `moxie test` compiles as
	// main, so the language restrictions judge that code by the package it came
	// from rather than by the synthetic wrapper. See restrictPath.
	testSrcPkgPath string
	// scratchDirs are the build scratch directories this run created; cleanup
	// removes them unless -work keeps them.
	scratchDirs []string
}

var bst *buildState

func initBuildState() {
	if bst == nil {
		bst = &buildState{}
	}
}

