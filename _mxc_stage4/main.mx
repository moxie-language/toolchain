//export mxc_free_mem
func cFreeMem() (n int64)

// workerMemBudget is the estimated peak physical memory per parallel build
// unit: the per-package compile arena dominates (hundreds of MB for ordinary
// packages, more for generated ones), plus the IR emitter and a transient
// clang child. 2GB under-counted the real per-worker peak (~4GB), so
// adaptiveJobs over-subscribed and a full stdlib run could exhaust RAM+swap
// and lock the machine. 4GB keeps concurrent workers within half of
// available memory.
const workerMemBudget = int64(4 * 1024 * 1024 * 1024)

// adaptiveJobs returns the default parallel job count: all online CPUs
// minus one (leave a core for the coordinator/OS), capped so the build
// uses at most half of the currently available physical memory. The -j flag
// overrides; the TLS probe may force it down to 1.
func adaptiveJobs() (n int32) {
	nproc := cNproc()
	if nproc < 1 {
		nproc = 1
	}
	jobs := nproc - 1
	if jobs < 1 {
		jobs = 1
	}
	mem := cFreeMem()
	if mem > 0 {
		memJobs := int32((mem / 2) / workerMemBudget)
		if memJobs < 1 {
			memJobs = 1
		}
		if memJobs < jobs {
			jobs = memJobs
		}
	}
	return jobs
}

// TLS probe: the C side spawns a thread that calls mxc_tls_probe_write,
// then the parent calls mxc_tls_probe_read. If the global is TLS, the
// child's write is invisible to the parent.

//export mxc_tls_probe_write
func tlsProbeWrite() {
	// With TLS globals the probe thread's bst starts nil (zeroed TLS);
	// skip the write so the parent's copy stays 0 and the probe reports
	// TLS-isolation. With shared globals bst is the parent's non-nil
	// instance, so the write lands where the parent reads it.
	if bst != nil {
		bst.tlsProbeVar = 1
	}
}

//export mxc_tls_probe_read
func tlsProbeRead() (n int32) {
	return bst.tlsProbeVar
}

func writeFile(path string, data []byte, mode uint32) {
	mxutil.WriteFile(path, data, mode)
}

func mkdirAll(path string, mode uint32) {
	mxutil.MkdirAll(path, mode)
}

func fatal(msg string) {
	mxutil.WriteStr(2, "mxc: " | msg | "\n")
	exitNow(1)
}

func mem2regBc(bcFile string) {
	tmp := bcFile | ".m2r"
	rc := run([]string{"opt", "-passes=mem2reg", bcFile, "-o", tmp})
	if rc != 0 {
		fatal("opt mem2reg failed for " | bcFile)
	}
	data, ok := mxutil.ReadFile(tmp)
	if ok {
		mxutil.WriteFile(bcFile, data, 0644)
	}
}

func clangCompileToObj(clang, triple, bcFile string) (s string) {
	oFile := bcFile | ".o"
	// Function/data sections so --gc-sections drops unreferenced code -
	// without this, one .bc module becomes one .text section and every
	// extern it declares (e.g. mxutil's host-bridge mxc_* calls) must
	// resolve even when unused.
	rc := run([]string{clang, "--target=" | triple, "-c",
		"-ffunction-sections", "-fdata-sections", bcFile, "-o", oFile})
	if rc != 0 {
		fatal("clang -c failed for " | bcFile)
	}
	return oFile
}

func getenv(name string) (s string) {
	return mxutil.Getenv(name)
}


func listFiles(dir, ext string) (ss []string) {
	return mxutil.ListFiles(dir, ext)
}

func run(args []string) (n int32) {
	if bst.printCommands {
		echoCommand(args)
	}
	argv := []unsafe.Pointer{:len(args) + 1}
	cstrs := [][]byte{:len(args)}
	for i, a := range args {
		b := []byte{:len(a) + 1}
		copy(b, a)
		b[len(a)] = 0
		cstrs[i] = b
		argv[i] = unsafe.Pointer(unsafe.SliceData(b))
	}
	return cRun(unsafe.Pointer(unsafe.SliceData(argv)), int32(len(args)))
}

// runAsync forks+execs args without waiting. Returns child pid, or -1 on
// fork failure. The forked child copies the argv buffers, so parent-side
// lifetimes end at return.
func runAsync(args []string) (pid int32) {
	if bst.printCommands {
		echoCommand(args)
	}
	argv := []unsafe.Pointer{:len(args) + 1}
	cstrs := [][]byte{:len(args)}
	for i, a := range args {
		b := []byte{:len(a) + 1}
		copy(b, a)
		b[len(a)] = 0
		cstrs[i] = b
		argv[i] = unsafe.Pointer(unsafe.SliceData(b))
	}
	return cRunAsync(unsafe.Pointer(unsafe.SliceData(argv)), int32(len(args)))
}

// echoCommand reports a child process as -x asks, on one line.
func echoCommand(args []string) {
	line := ""
	for i, a := range args {
		if i > 0 {
			line = line | " "
		}
		line = line | a
	}
	mxutil.WriteStr(2, line | "\n")
}

// registerScratch records a build scratch directory for cleanup. With -work
// the directory is kept instead, and its path is reported.
func registerScratch(dir string) {
	if bst.keepWork {
		mxutil.WriteStr(1, "WORK=" | dir | "\n")
		return
	}
	bst.scratchDirs = mxutil.Ensure(bst.scratchDirs, 1)
	push(bst.scratchDirs, dir)
}

// cleanupScratch removes every scratch directory this run created. It runs
// from main's defer on completion and from the SIGINT handler, so running it
// twice must be harmless.
func cleanupScratch() {
	for _, d := range bst.scratchDirs {
		os.RemoveAll(d)
	}
	bst.scratchDirs = nil
}

// exitNow leaves with code after cleaning up. os.Exit does not run defers, so
// every exit that can happen with a scratch directory live goes through here.
func exitNow(code int32) {
	cleanupScratch()
	os.Exit(code)
}

// cInstallInterruptHandler asks the runtime to run moxieOnInterrupt when the
// process is interrupted, then leave with the conventional 128+SIGINT status.
//
//export moxie_install_interrupt_handler
func cInstallInterruptHandler()

//export moxie_on_interrupt
func moxieOnInterrupt() {
	cleanupScratch()
}

// runPool runs cmds with at most jobs concurrent children. Returns false if
// any command exits nonzero (remaining in-flight children are drained, no
// new ones are dispatched).
func runPool(cmds [][]string, jobs int32) (ok bool) {
	if jobs < 1 {
		jobs = 1
	}
	next := int32(0)
	running := int32(0)
	failed := false
	for {
		for !failed && running < jobs && next < int32(len(cmds)) {
			pid := runAsync(cmds[next])
			if pid < 0 {
				failed = true
				break
			}
			running++
			next++
		}
		if running == 0 {
			break
		}
		r := cWaitAny()
		if r == -1 {
			return false
		}
		running--
		if r < 0 {
			failed = true
		}
	}
	return !failed
}

func parseInt32(s string) (n int32) {
	v := int32(0)
	for i := int32(0); i < int32(len(s)); i++ {
		if s[i] < '0' || s[i] > '9' {
			return 0
		}
		v = v*10 + int32(s[i]-'0')
	}
	return v
}

func pathBase(path string) (s string) {
	for i := int32(len(path)) - 1; i >= 0; i-- {
		if path[i] == '/' {
			return path[i+1:]
		}
	}
	return path
}

func pathDir(path string) (s string) {
	for i := int32(len(path)) - 1; i >= 0; i-- {
		if path[i] == '/' {
			if i == 0 {
				return "/"
			}
			return path[:i]
		}
	}
	return "."
}

func splitSlash(s string) (ss []string) {
	var parts []string
	start := int32(0)
	for i := int32(0); i < int32(len(s)); i++ {
		if s[i] == '/' {
			parts = mxutil.Ensure(parts, 1)
			push(parts, s[start:i])
			start = i + 1
		}
	}
	parts = mxutil.Ensure(parts, 1)
	push(parts, s[start:])
	return parts
}

func cleanPath(path string) (s string) {
	parts := splitSlash(path)
	var out []string
	for _, p := range parts {
		if p == "." || p == "" {
			continue
		}
		if p == ".." && len(out) > 0 && out[len(out)-1] != ".." {
			out = out[:len(out)-1]
		} else {
			out = mxutil.Ensure(out, 1)
			push(out, p)
		}
	}
	if len(out) == 0 {
		return "."
	}
	result := out[0]
	for i := 1; i < len(out); i++ {
		result = result | "/" | out[i]
	}
	if len(path) > 0 && path[0] == '/' {
		result = "/" | result
	}
	return result
}

func getMoxiePath() (s string) {
	p := getenv("MOXIEPATH")
	if p != "" {
		return p
	}
	home := getenv("HOME")
	if home == "" {
		return "/tmp/moxie"
	}
	return mxutil.JoinPath(home, "moxie")
}

// moxieRoot resolves the module root every command wants: MOXIEROOT when it is
// set, otherwise the conventional install location $HOME/moxie (MOXIEPATH
// overrides the parent, the same default getMoxiePath uses for the package
// cache). Falling back to the current directory made an unset MOXIEROOT read
// whatever checkout happened to be the cwd, which is how a stale installed
// tree silently became the stdlib.
func moxieRoot() (s string) {
	root := getenv("MOXIEROOT")
	if root == "" {
		root = getMoxiePath()
	}
	// Fail loud when the resolved root is not a moxie tree. Without this an
	// unset MOXIEROOT that lands on a directory with no stdlib makes every
	// stdlib import resolve to nothing and the build dies later with
	// unrelated "cannot resolve type of short var" errors instead of naming
	// the root it looked in.
	if !dirExists(mxutil.JoinPath(root, "src")) {
		fatal("MOXIEROOT resolves to " | root | ", which has no src/ directory; set MOXIEROOT to your moxie checkout")
	}
	return root
}

// dirExists reports whether path is an existing directory.
func dirExists(path string) (ok bool) {
	info, err := os.Stat(path)
	if err != nil {
		return false
	}
	return info.IsDir()
}

func mxcVersion() (s string) { return "1.9.11" }


func compilerHash() (s string) {
	if bst.selfHash != "" {
		return bst.selfHash
	}
	// Hash the compiler's own source files, NOT the running binary:
	// hashing /proc/self/exe embeds a different hash every generation and
	// the self-host fixpoint (identical binaries) can never converge.
	// Hash the compiler source under MOXIEROOT (what the build resolves
	// against), falling back to the install path. Without this the hash is
	// "unknown" whenever the source is not at $HOME/moxie, so every compiler
	// revision shares one cache dir and stale .bc files (old type
	// descriptors) poison dispatch.
	srcRoot := getenv("MOXIEROOT")
	if srcRoot == "" {
		srcRoot = getMoxiePath()
	}
	// The runtime sources are part of the key too: every cached object was
	// compiled against the runtime ABI (slice headers, descriptors, arena
	// entry points), so a runtime change that keeps the compiler sources
	// identical still invalidates every cached object. Without this the
	// package cache mixes objects built against different runtimes and the
	// link produces binaries that trap ("interface dispatch: no impl for
	// EncodeTo" out of a channel send, for one).
	dirs := []string{
		mxutil.JoinPath(srcRoot, "_mxc_stage4"),
		mxutil.JoinPath(mxutil.JoinPath(srcRoot, "src"), "runtime"),
	}
	// Read every source once, then concatenate into one exactly-sized buffer.
	// `acc = acc | data` in the read loop allocated a fresh accumulator per
	// file and left every intermediate in the arena: with the compiler's
	// sources that was ~90MB of garbage retained for the process's lifetime
	// (compilerHash is called once, from the cache-dir path, before any
	// package work). The concatenation is byte-identical to the previous
	// result, so cache keys are unchanged.
	var parts [][]byte
	total := int32(0)
	for _, dir := range dirs {
		files := listFiles(dir, ".mx")
		for i := int32(1); i < int32(len(files)); i++ {
			for j := i; j > 0 && files[j] < files[j-1]; j-- {
				files[j], files[j-1] = files[j-1], files[j]
			}
		}
		for _, f := range files {
			if data, ok := mxutil.ReadFile(mxutil.JoinPath(dir, f)); ok {
				parts = mxutil.Ensure(parts, 1)
				parts = push(parts, data)
				total += int32(len(data))
			}
		}
	}
	if total == 0 {
		bst.selfHash = "unknown"
		return bst.selfHash
	}
	acc := []byte{:total}
	off := int32(0)
	for _, part := range parts {
		copy(acc[off:], part)
		off += int32(len(part))
	}
	bst.selfHash = fnvHash(acc)
	return bst.selfHash
}

// compilerBuildID identifies the running binary by content. It is folded into
// the cache DIRECTORY name only, never into generated code, so identical
// self-host generations still emit identical binaries. Without it a binary
// built from older compiler sources, run against a tree whose sources have
// changed, computes the NEW source hash and writes objects the NEW compiler
// then reads - the "stale .bc after adding a struct field" poisoning. The
// binary's own /proc/self/exe is preferred; os.Args[0] is a fallback for
// systems without it.
func compilerBuildID() (s string) {
	if bst.buildID != "" {
		return bst.buildID
	}
	if data, ok := mxutil.ReadFile("/proc/self/exe"); ok && len(data) > 0 {
		bst.buildID = fnvHash(data)
		return bst.buildID
	}
	if len(os.Args) > 0 && os.Args[0] != "" {
		if data, ok := mxutil.ReadFile(os.Args[0]); ok && len(data) > 0 {
			bst.buildID = fnvHash(data)
			return bst.buildID
		}
	}
	bst.buildID = "nobuild"
	return bst.buildID
}

// The cache root is per target. The package key folds the target in too, but a
// key computed while the wrong target was active - a worker reconstructing it
// from an ambiguous triple, a stale environment - writes one target's bitcode
// where another target reads it, and the result is a native binary linked from
// wasm32 objects or an arm64 runtime. One root per target makes the wrong read
// unrepresentable instead of merely unlikely. The running binary's build ID is
// in the directory too: a stale binary must not seed the next compiler's cache.
func moxieCacheDir() (s string) {
	return mxutil.JoinPath(mxutil.JoinPath(getMoxiePath(), "cache"),
		"mxc-" | mxcVersion() | "-" | compilerHash() | "-" | compilerBuildID() | "-" | mxutil.TargetOS() | "-" | mxutil.TargetArch())
}


func parseReplaceLine(line string, baseDir string) (from string, to string, ok bool) {
	arrow := int32(-1)
	for k := int32(0); k < int32(len(line))-1; k++ {
		if line[k] == '=' && line[k+1] == '>' {
			arrow = k
			break
		}
	}
	if arrow < 0 {
		return "", "", false
	}
	from := mxutil.TrimSpace(line[:arrow])
	to := mxutil.TrimSpace(line[arrow+2:])
	for fi := int32(0); fi < int32(len(from)); fi++ {
		if from[fi] == ' ' {
			from = from[:fi]
			break
		}
	}
	if mxutil.HasPrefix(to, "./") || mxutil.HasPrefix(to, "../") || mxutil.HasPrefix(to, "/") {
		to = cleanPath(mxutil.JoinPath(baseDir, to))
	}
	return from, to, true
}

// isDirPath reports whether pkgPath names a directory on disk (and so must
// be resolved through the module root) rather than an import path.
func isDirPath(pkgPath string) (ok bool) {
	if pkgPath == "." || pkgPath == ".." ||
		mxutil.HasPrefix(pkgPath, "./") || mxutil.HasPrefix(pkgPath, "../") ||
		mxutil.HasPrefix(pkgPath, "/") {
		return true
	}
	if pkgPath == "" {
		return false
	}
	return len(listFiles(pkgPath, ".mx")) > 0
}

// ensureModuleRoot resolves the module root once per process, before any
// package discovery. Without it globalModPrefix/globalModDir stay empty and a
// module-internal import (git.smesh.lol/moxie/pkg/mxutil, reached from the
// runtime's errors dependency) cannot be resolved, so the build dies with
// "undefined: mxutil" on some unrelated package. Every command that resolves
// packages must call this after computing root.
func ensureModuleRoot(root string) {
	if bst.globalModPrefix != "" {
		return
	}
	if root == "" {
		root = "."
	}
	prefix, dir := findModuleRoot(root)
	bst.rootModPrefix = prefix
	if prefix == "" {
		// The target may live outside the module (the test harness stages
		// builds under /tmp, so no moxie.mod is reachable by walking up).
		// MOXIEROOT names the module root explicitly; without this a
		// module-internal import cannot be resolved from the module prefix
		// and would be looked up as a filesystem path instead.
		if rt := getenv("MOXIEROOT"); rt != "" {
			if data, ok := mxutil.ReadFile(mxutil.JoinPath(rt, "moxie.mod")); ok {
				if mn := parseModuleName(string(data)); mn != "" {
					prefix, dir = mn, rt
				}
			}
		}
	}
	bst.globalModPrefix, bst.globalModDir = prefix, dir
}

// parseModuleName returns the module path declared in moxie.mod content.
func parseModuleName(data string) (name string) {
	for _, line := range mxutil.SplitLines(data) {
		line = mxutil.TrimSpace(line)
		if mxutil.HasPrefix(line, "module ") {
			return mxutil.TrimSpace(line[7:])
		}
	}
	return ""
}

// runtimeBakePath is where the runtime bitcode bake lives. The bake is
// target-specific: a native bake contains x86 code and a wasm bake contains
// wasm code, and compiling one for the other fails with unsupported
// intrinsics (llvm.returnaddress, llvm.wasm.memory.size). Keeping one shared
// file meant whichever target built last silently broke the other.
func runtimeBakePath(sysroot string) (s string) {
	name := "runtime_go.bc"
	if mxutil.TargetArch() == "wasm" {
		name = "runtime_go_wasm.bc"
	}
	return mxutil.JoinPath(sysroot, name)
}

// ensureRuntimeBake returns the path of the runtime bitcode bake, creating it
// from source when it is missing. The bake is a cache, so it is not shipped:
// the first application build against a fresh tree pays for compiling the
// runtime once, and every later build links the cached blob.
//
// The bake is compiler-specific, so if the compiler changes the existing blob
// is stale - but source changes are what the `-a` flag and `build-runtime`
// address, and detecting staleness here would mean hashing the whole runtime
// tree on every build.
func ensureRuntimeBake(sysroot, root string) (bc string) {
	bc = runtimeBakePath(sysroot)
	if _, ok := mxutil.ReadFile(bc); ok {
		return bc
	}
	mxutil.WriteStr(2, "  runtime bake missing; building it from source\n")
	cmdBuildRuntime()
	if _, ok := mxutil.ReadFile(bc); ok {
		return bc
	}
	fatal("runtime bake failed to produce " | bc)
	return bc
}

func findModuleRoot(startDir string) (modName string, dir string) {
	// "" means "the current directory"; walk from "." so that a relative
	// target like ./pkg still finds the module root next to moxie.mod.
	dir = startDir
	if dir == "" {
		dir = "."
	}
	for {
		data, ok := mxutil.ReadFile(mxutil.JoinPath(dir, "moxie.mod"))
		if ok {
			modName = ""
			bst.globalReplaces = map[string]string{}
			lines := mxutil.SplitLines(string(data))
			inReplace := false
			for _, line := range lines {
				line = mxutil.TrimSpace(line)
				if mxutil.HasPrefix(line, "module ") {
					modName = mxutil.TrimSpace(line[7:])
					continue
				}
				if line == "replace (" {
					inReplace = true
					continue
				}
				if inReplace {
					if line == ")" {
						inReplace = false
						continue
					}
					from, to, ok2 := parseReplaceLine(line, dir)
					if ok2 {
						bst.globalReplaces[from] = to
					}
					continue
				}
				if mxutil.HasPrefix(line, "replace ") {
					from, to, ok2 := parseReplaceLine(line[8:], dir)
					if ok2 {
						bst.globalReplaces[from] = to
					}
				}
			}
			if modName != "" {
				return modName, dir
			}
		}
		parent := pathDir(dir)
		// A relative path bottoms out at "" or "."; that IS the module
		// root candidate, so try it once and then stop.
		if parent == "" || parent == "." {
			if dir == "." {
				break
			}
			dir = "."
			continue
		}
		if parent == dir {
			break
		}
		dir = parent
	}
	return "", ""
}

func mergeModReplaces(dir string) {
	data, ok := mxutil.ReadFile(mxutil.JoinPath(dir, "moxie.mod"))
	if !ok {
		return
	}
	if bst.globalReplaces == nil {
		bst.globalReplaces = map[string]string{}
	}
	inReplace := false
	for _, line := range mxutil.SplitLines(string(data)) {
		line = mxutil.TrimSpace(line)
		if line == "replace (" {
			inReplace = true
			continue
		}
		if inReplace {
			if line == ")" {
				inReplace = false
				continue
			}
			from, to, ok2 := parseReplaceLine(line, dir)
			if ok2 {
				if _, exists := bst.globalReplaces[from]; !exists {
					bst.globalReplaces[from] = to
				}
			}
			continue
		}
		if mxutil.HasPrefix(line, "replace ") {
			from, to, ok2 := parseReplaceLine(line[8:], dir)
			if ok2 {
				if _, exists := bst.globalReplaces[from]; !exists {
					bst.globalReplaces[from] = to
				}
			}
		}
	}
}

type modRequire struct {
	path    string
	version string
}

func parseModRequires(dir string) (modName string, reqs []modRequire, repls map[string]string) {
	data, ok := mxutil.ReadFile(mxutil.JoinPath(dir, "moxie.mod"))
	if !ok {
		return "", nil, nil
	}
	modName = ""
	repls = map[string]string{}
	inRequire := false
	inReplace := false
	for _, line := range mxutil.SplitLines(string(data)) {
		line = mxutil.TrimSpace(line)
		if mxutil.HasPrefix(line, "module ") {
			modName = mxutil.TrimSpace(line[7:])
			continue
		}
		if line == "require (" {
			inRequire = true
			continue
		}
		if inRequire {
			if line == ")" {
				inRequire = false
				continue
			}
			parts := splitBySpace(line)
			if len(parts) >= 2 {
				reqs = mxutil.Ensure(reqs, 1)
				push(reqs, modRequire{path: parts[0], version: parts[1]})
			} else if len(parts) == 1 {
				reqs = mxutil.Ensure(reqs, 1)
				push(reqs, modRequire{path: parts[0], version: ""})
			}
			continue
		}
		if mxutil.HasPrefix(line, "require ") {
			parts := splitBySpace(line[8:])
			if len(parts) >= 2 {
				reqs = mxutil.Ensure(reqs, 1)
				push(reqs, modRequire{path: parts[0], version: parts[1]})
			} else if len(parts) == 1 {
				reqs = mxutil.Ensure(reqs, 1)
				push(reqs, modRequire{path: parts[0], version: ""})
			}
			continue
		}
		if line == "replace (" {
			inReplace = true
			continue
		}
		if inReplace {
			if line == ")" {
				inReplace = false
				continue
			}
			from, to, ok2 := parseReplaceLine(line, dir)
			if ok2 {
				repls[from] = to
			}
			continue
		}
		if mxutil.HasPrefix(line, "replace ") {
			from, to, ok2 := parseReplaceLine(line[8:], dir)
			if ok2 {
				repls[from] = to
			}
		}
	}
	return modName, reqs, repls
}

func isRemotePath(path string) (ok bool) {
	slash := int32(-1)
	for i := int32(0); i < int32(len(path)); i++ {
		if path[i] == '/' {
			slash = i
			break
		}
	}
	if slash < 0 {
		return false
	}
	host := path[:slash]
	for i := int32(0); i < int32(len(host)); i++ {
		if host[i] == '.' {
			return true
		}
	}
	return false
}

func repoLockPath(mpath, repoPath string) (s string) {
	return mxutil.JoinPath(mpath, repoPath | ".lock")
}

func acquireRepoLock(mpath, repoPath string) (ok bool) {
	lp := repoLockPath(mpath, repoPath)
	_, locked := mxutil.ReadFile(lp)
	if locked {
		return false
	}
	mkdirAll(pathDir(lp), 0755)
	writeFile(lp, []byte("1"), 0644)
	return true
}

func releaseRepoLock(mpath, repoPath string) {
	os.Remove(repoLockPath(mpath, repoPath))
}

func autoFetchRepo(pkgPath, version string) (s string) {
	mpath := getMoxiePath()
	repoPath := pkgPath
	for {
		d := mxutil.JoinPath(mpath, repoPath)
		gh := mxutil.JoinPath(d, ".git/HEAD")
		_, ex := mxutil.ReadFile(gh)
		if ex {
			break
		}
		parent := pathDir(repoPath)
		if parent == repoPath || parent == "." || parent == "" {
			break
		}
		parentDest := mxutil.JoinPath(mpath, parent)
		parentGit := mxutil.JoinPath(parentDest, ".git/HEAD")
		_, parentExists := mxutil.ReadFile(parentGit)
		if parentExists {
			repoPath = parent
			break
		}
		repoPath = parent
	}

	if !acquireRepoLock(mpath, repoPath) {
		mxutil.WriteStr(2, "  waiting for lock: " | repoPath | "\n")
		fatal("repo locked: " | repoPath)
	}

	dest := mxutil.JoinPath(mpath, repoPath)
	gitHead := mxutil.JoinPath(dest, ".git/HEAD")
	_, exists := mxutil.ReadFile(gitHead)

	if !exists {
		mkdirAll(pathDir(dest), 0755)
		url := "https://" | repoPath
		mxutil.WriteStr(2, "  auto-fetch " | repoPath | "\n")
		if run([]string{"git", "clone", url, dest}) != 0 {
			releaseRepoLock(mpath, repoPath)
			return ""
		}
	}

	if version != "" && version != "v0.0.0" {
		if run([]string{"git", "-C", dest, "checkout", version}) != 0 {
			run([]string{"git", "-C", dest, "fetch", "--tags"})
			run([]string{"git", "-C", dest, "pull"})
			run([]string{"git", "-C", dest, "checkout", version})
		}
	}

	releaseRepoLock(mpath, repoPath)
	return mxutil.JoinPath(mpath, pkgPath)
}

func gitURLToModPath(url string) (s string) {
	u := url
	// strip scheme
	for _, scheme := range []string{"ssh://", "https://", "http://", "git://"} {
		if mxutil.HasPrefix(u, scheme) {
			u = u[len(scheme):]
			break
		}
	}
	// strip user@
	for i := int32(0); i < int32(len(u)); i++ {
		if u[i] == '@' {
			u = u[i+1:]
			break
		}
		if u[i] == '/' {
			break
		}
	}
	// host:port/path or host:path (scp-style) or host/path
	// extract host, skip port if numeric, keep path
	host := ""
	rest := ""
	for i := int32(0); i < int32(len(u)); i++ {
		if u[i] == ':' {
			host = u[:i]
			after := u[i+1:]
			// skip port (digits until /)
			j := int32(0)
			for j < int32(len(after)) && after[j] >= '0' && after[j] <= '9' {
				j++
			}
			if j > 0 && j < int32(len(after)) && after[j] == '/' {
				rest = after[j+1:]
			} else if j > 0 && j == int32(len(after)) {
				rest = ""
			} else {
				rest = after
			}
			break
		}
		if u[i] == '/' {
			host = u[:i]
			rest = u[i+1:]
			break
		}
	}
	if host == "" {
		return ""
	}
	// strip ~/ prefix from path
	if mxutil.HasPrefix(rest, "~/") {
		rest = rest[2:]
	}
	// strip .git suffix
	if mxutil.HasSuffix(rest, ".git") {
		rest = rest[:len(rest)-4]
	}
	if rest == "" {
		return ""
	}
	return host | "/" | rest
}

func currentBranch(dest string) (s string) {
	data, ok := mxutil.ReadFile(mxutil.JoinPath(dest, ".git/HEAD"))
	if !ok {
		return ""
	}
	line := mxutil.TrimSpace(string(data))
	if !mxutil.HasPrefix(line, "ref: refs/heads/") {
		return ""
	}
	return line[len("ref: refs/heads/"):]
}

func cmdFetch(url string) {
	mpath := getMoxiePath()
	mkdirAll(mpath, 0755)

	rootDir := "."
	if url != "" {
		modPath := gitURLToModPath(url)
		if modPath == "" {
			fatal("cannot derive module path from URL: " | url)
		}
		dest := mxutil.JoinPath(mpath, modPath)
		_, exists := mxutil.ReadFile(mxutil.JoinPath(dest, ".git/HEAD"))
		if exists {
			mxutil.WriteStr(2, modPath | ": fetch\n")
			run([]string{"git", "-C", dest, "remote", "set-url", "origin", url})
			run([]string{"git", "-C", dest, "fetch", "origin"})
			// older clones lack the origin/HEAD symbolic ref; resolve it
			// from the remote before resetting to it
			run([]string{"git", "-C", dest, "remote", "set-head", "origin", "-a"})
			if run([]string{"git", "-C", dest, "reset", "--hard", "origin/HEAD"}) != 0 {
				// server advertises no HEAD (default branch unset);
				// fall back to the upstream of the current branch
				br := currentBranch(dest)
				if br != "" {
					run([]string{"git", "-C", dest, "reset", "--hard", "origin/" | br})
				}
			}
		} else {
			mxutil.WriteStr(2, modPath | ": clone\n")
			mkdirAll(pathDir(dest), 0755)
			if run([]string{"git", "clone", url, dest}) != 0 {
				fatal("clone failed: " | url)
			}
		}
		rootDir = dest
	}

	modName, reqs, repls := parseModRequires(rootDir)
	if modName == "" {
		fatal("no moxie.mod in " | rootDir)
	}
	if url == "" {
		mxutil.WriteStr(2, "module: " | modName | "\n")
	}

	queue := []modRequire{:0:len(reqs)}
	for _, r := range reqs {
		if _, ok := repls[r.path]; ok {
			mxutil.WriteStr(2, "  skip (replaced): " | r.path | "\n")
			continue
		}
		queue = mxutil.Ensure(queue, 1)
		push(queue, r)
	}

	seen := map[string]bool{}
	for len(queue) > 0 {
		req := queue[0]
		queue = queue[1:]
		if seen[req.path] {
			continue
		}
		seen[req.path] = true

		if !acquireRepoLock(mpath, req.path) {
			mxutil.WriteStr(2, "  locked: " | req.path | " (another build in progress)\n")
			fatal("repo locked: " | req.path)
		}

		dest := mxutil.JoinPath(mpath, req.path)
		gitHead := mxutil.JoinPath(dest, ".git/HEAD")
		_, exists := mxutil.ReadFile(gitHead)

		if !exists {
			mkdirAll(pathDir(dest), 0755)
			cloneURL := "https://" | req.path
			mxutil.WriteStr(2, "  clone " | req.path | "\n")
			if run([]string{"git", "clone", cloneURL, dest}) != 0 {
				releaseRepoLock(mpath, req.path)
				mxutil.WriteStr(2, "  FAIL: clone " | req.path | "\n")
				continue
			}
		}

		if req.version != "" && req.version != "v0.0.0" {
			if run([]string{"git", "-C", dest, "checkout", req.version}) != 0 {
				mxutil.WriteStr(2, "  tag " | req.version | " not found, pulling\n")
				run([]string{"git", "-C", dest, "pull"})
				if run([]string{"git", "-C", dest, "checkout", req.version}) != 0 {
					mxutil.WriteStr(2, "  WARN: " | req.version | " unavailable for " | req.path | "\n")
				}
			} else {
				mxutil.WriteStr(2, "  " | req.path | " @ " | req.version | "\n")
			}
		} else if exists {
			mxutil.WriteStr(2, "  pull " | req.path | "\n")
			run([]string{"git", "-C", dest, "pull"})
		} else {
			mxutil.WriteStr(2, "  fetched " | req.path | "\n")
		}

		releaseRepoLock(mpath, req.path)

		_, subReqs, _ := parseModRequires(dest)
		for _, sr := range subReqs {
			if !seen[sr.path] {
				queue = mxutil.Ensure(queue, 1)
				push(queue, sr)
			}
		}
	}

	mxutil.WriteStr(2, "fetch done\n")
}

func joinStrings(ss []string, sep string) (s string) {
	if len(ss) == 0 {
		return ""
	}
	n := int32(0)
	for _, v := range ss {
		n += int32(len(v))
	}
	n += int32(len(sep)) * (int32(len(ss)) - 1)
	buf := []byte{:0:n}
	for i, v := range ss {
		if i > 0 {
			buf = buf | sep
		}
		buf = buf | v
	}
	return string(buf)
}

func appendUniq(ss []string, s string) (ss2 []string) {
	for _, x := range ss {
		if x == s {
			return ss
		}
	}
	ss = mxutil.Ensure(ss, 1)
	push(ss, s)
	return ss
}

func fnvHash(data []byte) (s string) {
	h := uint32(2166136261)
	for i := int32(0); i < int32(len(data)); i++ {
		h ^= uint32(data[i])
		h *= uint32(16777619)
	}
	digits := "0123456789abcdef"
	buf := []byte{:8}
	for i := int32(7); i >= 0; i-- {
		buf[i] = digits[h&0xf]
		h >>= 4
	}
	return string(buf)
}

func pkgCacheDir() (s string) {
	return mxutil.JoinPath(moxieCacheDir(), "pkg")
}

// Scratch directory for one compiler process. A fixed name is a shared mutable
// resource: two builds in the same tree - native beside wasm, relay beside
// bootstrap - overwrite each other's IR and bitcode between clang writing it
// and the read that caches it, so one target's object is cached under the
// other's key and the next build links it. The pid makes the two disjoint.
//
// Every caller removes the directory with defer once the build returns, so a
// successful build leaves nothing behind. A failed build does not run defers
// (fatal exits), which is the point: the IR it names in its error messages is
// still there to read.
func buildScratchDir(base, tag string) (s string) {
	return mxutil.JoinPath(base, tag | "-" | simpleItoa(os.Getpid()))
}

func pkgCacheKey(dir string, files []string) (s string) {
	sorted := []string{:0:len(files)}
	for _, f := range files {
		sorted = mxutil.Ensure(sorted, 1)
		push(sorted, f)
	}
	for i := int32(1); i < int32(len(sorted)); i++ {
		for j := i; j > 0 && sorted[j] < sorted[j-1]; j-- {
			sorted[j], sorted[j-1] = sorted[j-1], sorted[j]
		}
	}
	var all []byte
	for _, f := range sorted {
		p := mxutil.JoinPath(dir, f)
		data, ok := mxutil.ReadFile(p)
		if !ok {
			continue
		}
		nb := []byte{:len(all) + len(data) + 1}
		copy(nb[:len(all)], all)
		copy(nb[len(all):], data)
		nb[len(all)+len(data)] = 0
		all = nb
	}
	// -cover changes the emitted IR of a package without changing which files
	// it contains (no file is behind a `cover` build tag), so the file contents
	// alone do not identify the object. Without this salt a plain build reused
	// the instrumented bitcode (its program dumped counters to stderr) and a
	// cover build could reuse plain bitcode and silently report nothing.
	if bst != nil && bst.cover {
		all = all | []byte{0} | []byte("cover")
	}
	return fnvHash(all)
}

// pkgKeyMemo caches each package's transitive hash by import path. Filled
// in dependency order (resolver emits deps before dependents), so a
// dependent's key always sees its deps' final hashes. Without dep hashes in
// the key, a dependency's layout change would leave a dependent's cached .bc
// reusable with a stale ABI - silent struct-offset corruption at link time.

func pkgHash(p *pkgInfo) (s string) {
	if bst.pkgKeyMemo == nil {
		bst.pkgKeyMemo = map[string]string{}
	}
	if h, ok := bst.pkgKeyMemo[p.path]; ok {
		return h
	}
	sorted := []string{:0:len(p.imports)}
	for _, imp := range p.imports {
		sorted = mxutil.Ensure(sorted, 1)
		push(sorted, imp)
	}
	for i := int32(1); i < int32(len(sorted)); i++ {
		for j := i; j > 0 && sorted[j] < sorted[j-1]; j-- {
			sorted[j], sorted[j-1] = sorted[j-1], sorted[j]
		}
	}
	// The target is part of the key: identical sources compiled for wasm32
	// and for a 64-bit native target produce incompatible bitcode (argument
	// widths differ), and reusing one for the other yields a wasm module
	// with 64-bit signatures that wasm-ld warns about or miscompiles.
	acc := []byte(mxutil.TargetOS() | "/" | mxutil.TargetArch() | "|")
	acc = acc | []byte(pkgCacheKey(p.dir, p.files))
	for _, imp := range sorted {
		if dh, ok := bst.pkgKeyMemo[imp]; ok {
			acc = acc | []byte("|") | dh
		}
	}
	// Interface dispatch tables enumerate impls from the whole link set, so a
	// cached .bc is only valid for the link set it was built against. Fold a
	// hash of the link set into every package key.
	acc = acc | []byte("|L") | []byte(bst.linkSetKey)
	// -print-allocs adds calls to the cached bitcode, so the pattern is part
	// of the key: without it an uninstrumented .bc compiled earlier would be
	// reused for an instrumented build and the sites would never fire.
	acc = acc | []byte("|P") | []byte(mxutil.AllocPattern())
	// Whether captures were allowed changes what the compiler accepts from
	// these sources, so a relaxed build must not satisfy a strict one.
	caps := "0"
	if bst.allowCaptures {
		caps = "1"
	}
	acc = acc | []byte("|C") | []byte(caps)
	hv := fnvHash(acc)
	bst.pkgKeyMemo[p.path] = hv
	return hv
}

// linkSetHash hashes the set of packages (path@version) in a build so cached
// dispatch tables are invalidated when the link set changes.
func linkSetHash(pkgs []*pkgInfo) (h string) {
	names := []string{:0:len(pkgs)}
	for _, p := range pkgs {
		names = mxutil.Ensure(names, 1)
		push(names, p.path | "@" | p.version)
	}
	for i := int32(1); i < int32(len(names)); i++ {
		for j := i; j > 0 && names[j] < names[j-1]; j-- {
			names[j], names[j-1] = names[j-1], names[j]
		}
	}
	var acc []byte
	for _, n := range names {
		acc = acc | []byte(n) | []byte("|")
	}
	return fnvHash(acc)
}

func versionedCacheName(hash, version, ext string) (s string) {
	if version != "" {
		return hash | "_" | version | ext
	}
	return hash | ext
}

func cachedBcPath(cacheBase, pkgPath, hash, version string) (s string) {
	return mxutil.JoinPath(mxutil.JoinPath(cacheBase, safeName(pkgPath)), versionedCacheName(hash, version, ".bc"))
}

func isStdlib(path string) (ok bool) {
	return !mxutil.HasPrefix(path, "/") && !mxutil.HasPrefix(path, "./") && !mxutil.HasPrefix(path, "../")
}


func isBuiltinOnly(path string) (ok bool) {
	for _, b := range bst.builtinOnly {
		if path == b {
			return true
		}
	}
	return false
}

func loadSysroot(path string) {
	data, ok := mxutil.ReadFile(path)
	if !ok {
		return
	}
	for _, line := range mxutil.SplitLines(string(data)) {
		line = mxutil.TrimSpace(line)
		if len(line) == 0 || line[0] == '#' {
			continue
		}
		eq := int32(-1)
		for i := int32(0); i < int32(len(line)); i++ {
			if line[i] == '=' {
				eq = i
				break
			}
		}
		if eq < 0 {
			continue
		}
		key := line[:eq]
		val := line[eq+1:]
		os.Setenv(key, val)
	}
}

func splitBySpace(s string) (ss []string) {
	var result []string
	start := int32(0)
	inWord := false
	for i := int32(0); i < int32(len(s)); i++ {
		if s[i] == ' ' || s[i] == '\t' {
			if inWord {
				result = mxutil.Ensure(result, 1)
				push(result, s[start:i])
				inWord = false
			}
		} else {
			if !inWord {
				start = i
				inWord = true
			}
		}
	}
	if inWord {
		result = mxutil.Ensure(result, 1)
		push(result, s[start:])
	}
	return result
}

func safeName(pkg string) (s string) {
	b := []byte{:len(pkg)}
	for i := int32(0); i < int32(len(pkg)); i++ {
		if pkg[i] == '/' {
			b[i] = '_'
		} else {
			b[i] = pkg[i]
		}
	}
	return string(b)
}

func extractPkgName(data []byte) (s string) {
	for i := int32(0); i < int32(len(data)); i++ {
		if i+8 < int32(len(data)) && string(data[i:i+8]) == "package " {
			j := i + 8
			for j < int32(len(data)) && data[j] != '\n' && data[j] != '\r' && data[j] != ' ' {
				j++
			}
			return string(data[i+8 : j])
		}
		if data[i] == '\n' {
			continue
		}
		if data[i] == '/' && i+1 < int32(len(data)) && data[i+1] == '/' {
			for i < int32(len(data)) && data[i] != '\n' {
				i++
			}
			continue
		}
		// Block comment: skip to closing */ (fmt/doc.mx has its package
		// clause below a /* ... */ doc comment).
		if data[i] == '/' && i+1 < int32(len(data)) && data[i+1] == '*' {
			i += 2
			for i+1 < int32(len(data)) && !(data[i] == '*' && data[i+1] == '/') {
				i++
			}
			i++ // lands on '/', loop increment moves past it
			continue
		}
		if data[i] == ' ' || data[i] == '\t' || data[i] == '\r' {
			continue
		}
		break
	}
	return "main"
}

func extractImports(data []byte) (ss []string) {
	imports := []string{:0:32}
	off := int32(0)
	for off < int32(len(data)) {
		ls := off
		for off < int32(len(data)) && data[off] != '\n' {
			off++
		}
		le := off
		if off < int32(len(data)) {
			off++
		}
		// Trim
		for ls < le && (data[ls] == ' ' || data[ls] == '\t') {
			ls++
		}
		for le > ls && (data[le-1] == ' ' || data[le-1] == '\t' || data[le-1] == '\r') {
			le--
		}
		line := string(data[ls:le])
		if line == "import (" {
			// Scan block
			for off < int32(len(data)) {
				bls := off
				for off < int32(len(data)) && data[off] != '\n' {
					off++
				}
				ble := off
				if off < int32(len(data)) {
					off++
				}
				for bls < ble && (data[bls] == ' ' || data[bls] == '\t') {
					bls++
				}
				for ble > bls && (data[ble-1] == ' ' || data[ble-1] == '\t' || data[ble-1] == '\r') {
					ble--
				}
				bt := string(data[bls:ble])
				if bt == ")" {
					break
				}
				imp := mxutil.ExtractQuoted(bt)
				if imp != "" {
					imports = appendUniq(imports, imp)
				}
			}
			continue
		}
		if mxutil.HasPrefix(line, "import ") {
			imp := mxutil.ExtractQuoted(line[7:])
			if imp != "" {
				imports = appendUniq(imports, imp)
			}
		}
	}
	return imports
}

type srcSpan struct {
	file      string
	outStart  int32
	srcLine   int32
}


func concatLineToFile(concatLine int32) (file string, srcLine int32) {
	if len(cctx.concatSourceMap) == 0 {
		return "", concatLine
	}
	best := int32(0)
	for i, s := range cctx.concatSourceMap {
		if s.outStart <= concatLine {
			best = int32(i)
		}
	}
	sp := cctx.concatSourceMap[best]
	return sp.file, sp.srcLine + (concatLine - sp.outStart)
}

// coverReportFile qualifies a coverage site's file with its package path: a
// package's files are concatenated into one stream and the source map keeps the
// base name, which different packages can share (a/hex.mx and b/hex.mx), so a
// per-file report keyed on the base name would merge unrelated files. The main
// package is the module root, so it takes the module path; that also keeps every
// site of a build under one prefix, which is how the report selects the module
// out of the link set.
func coverReportFile(pkgPath, modPath, file string) (s string) {
	if file == "" {
		return file
	}
	if pkgPath == "" || pkgPath == "main" {
		pkgPath = modPath
	}
	if pkgPath == "" {
		return baseName(file)
	}
	return pkgPath | "/" | baseName(file)
}

// scanFileRegions scans file bytes to find the body start offset and
// extract import specs. No SplitLines, no per-line copies. Returns
// bodyStart (byte offset of first non-package/import line) and the
// source line number of that offset (1-based).
func scanFileRegions(data []byte, imports map[string]bool) (bodyStart int32, bodyLine int32, fimps []string) {
	off := int32(0)
	lineNum := int32(1)
	bodyStart = -1
	seenPkg := false
	for off < int32(len(data)) {
		// Find line extent
		lineStart := off
		for off < int32(len(data)) && data[off] != '\n' {
			off++
		}
		lineEnd := off
		if off < int32(len(data)) {
			off++ // skip \n
		}
		// Trim whitespace for classification
		ls := lineStart
		for ls < lineEnd && (data[ls] == ' ' || data[ls] == '\t') {
			ls++
		}
		le := lineEnd
		for le > ls && (data[le-1] == ' ' || data[le-1] == '\t' || data[le-1] == '\r') {
			le--
		}
		trimmed := data[ls:le]
		if len(trimmed) >= 8 && string(trimmed[:8]) == "package " {
			seenPkg = true
			lineNum++
			continue
		}
		if string(trimmed) == "import (" {
			lineNum++
			// Scan import block
			for off < int32(len(data)) {
				bls := off
				for off < int32(len(data)) && data[off] != '\n' {
					off++
				}
				ble := off
				if off < int32(len(data)) {
					off++
				}
				// Trim
				for bls < ble && (data[bls] == ' ' || data[bls] == '\t') {
					bls++
				}
				for ble > bls && (data[ble-1] == ' ' || data[ble-1] == '\t' || data[ble-1] == '\r') {
					ble--
				}
				bt := data[bls:ble]
				lineNum++
				if string(bt) == ")" {
					break
				}
				if len(bt) > 0 {
					spec := string(bt)
					imports[spec] = true
					fimps = mxutil.Ensure(fimps, 1)
					push(fimps, spec)
				}
			}
			continue
		}
		if len(trimmed) >= 7 && string(trimmed[:7]) == "import " && (len(trimmed) < 8 || trimmed[7] != '(') {
			spec := string(trimmed[7:])
			imports[spec] = true
			fimps = mxutil.Ensure(fimps, 1)
			push(fimps, spec)
			lineNum++
			continue
		}
		// First body line: only after the package clause, so the
		// concatenated body never duplicates the file's own "package "
		// header (a duplicate package clause confuses the parser and
		// drops the following declarations).
		if seenPkg && bodyStart < 0 {
			bodyStart = lineStart
			bodyLine = lineNum
		}
		lineNum++
	}
	if bodyStart < 0 {
		bodyStart = int32(len(data))
		bodyLine = lineNum
	}
	return bodyStart, bodyLine, fimps
}

func concatSources(dir string, files []string) (buf []byte) {
	imports := map[string]bool{}
	pkgName := ""
	// Store body as a byte slice reference into the file data.
	type fileBody struct {
		name      string
		data      []byte // full file data (freed after copy into output)
		bodyStart int32
		bodyLine  int32
		fimps     []string
	}
	var fb []fileBody
	for _, f := range files {
		data, ok := mxutil.ReadFile(mxutil.JoinPath(dir, f))
		if !ok {
			continue
		}
		if pkgName == "" {
			pkgName = extractPkgName(data)
		}
		bs, bl, fimps := scanFileRegions(data, imports)
		fb = mxutil.Ensure(fb, 1)
		push(fb, fileBody{name: f, data: data, bodyStart: bs, bodyLine: bl, fimps: fimps})
	}
	// Estimate total size for pre-allocation
	totalSize := int32(64) // header
	for _, f := range fb {
		totalSize += int32(len(f.data)) - f.bodyStart + 1
	}
	for imp := range imports {
		totalSize += int32(len(imp)) + 2
	}
	var out []byte
	out = out | ("package " | pkgName | "\n")
	if len(imports) > 0 {
		impKeys := []string{:0:len(imports)}
		for imp := range imports {
			impKeys = mxutil.Ensure(impKeys, 1)
			push(impKeys, imp)
		}
		for i := int32(1); i < int32(len(impKeys)); i++ {
			for j := i; j > 0 && impKeys[j] < impKeys[j-1]; j-- {
				impKeys[j], impKeys[j-1] = impKeys[j-1], impKeys[j]
			}
		}
		out = out | "import (\n"
		for _, imp := range impKeys {
			out = out | "\t" | imp | "\n"
		}
		out = out | ")\n"
	}
	cctx.concatSourceMap = nil
	mxutil.ResetConcatImportSegs()
	outLine := int32(1)
	for j := int32(0); j < int32(len(out)); j++ {
		if out[j] == '\n' {
			outLine++
		}
	}
	bodyChunks := [][]byte{:0:len(fb)*2 + 1}
	bodyChunks = mxutil.Ensure(bodyChunks, 1)
	push(bodyChunks, out)
	for i := range fb {
		body := fb[i].data[fb[i].bodyStart:]
		cctx.concatSourceMap = mxutil.Ensure(cctx.concatSourceMap, 1)
		push(cctx.concatSourceMap, srcSpan{
			file:     fb[i].name,
			outStart: outLine,
			srcLine:  fb[i].bodyLine,
		})
		mxutil.AppendConcatImportSeg(mxutil.ImportSeg{
			OutStart: outLine,
			Specs:    fb[i].fimps,
		})
		for j := int32(0); j < int32(len(body)); j++ {
			if body[j] == '\n' {
				outLine++
			}
		}
		outLine++
		bodyChunks = mxutil.Ensure(bodyChunks, 1)
		push(bodyChunks, body)
		bodyChunks = mxutil.Ensure(bodyChunks, 1)
		push(bodyChunks, []byte("\n"))
	}
	return joinChunks(bodyChunks)
}

func fileContainsPart(base string, part string) (ok bool) {
	plen := len(part)
	for i := 0; i <= len(base)-plen; i++ {
		if base[i:i+plen] == part {
			before := i == 0 || base[i-1] == '_'
			after := i+plen == len(base) || base[i+plen] == '_'
			if before && after {
				return true
			}
		}
	}
	return false
}

// shouldSkipFile applies the filename platform rule, which is a fallback for
// files that carry no //:build constraint. The caller checks the constraint
// first and only consults the name when there is none, mirroring Go, where an
// explicit //go:build beats the filename. Getting that order wrong breaks
// src/time/sys_unix.mx, which is tagged 'unix || (js && wasm)' specifically so
// wasm keeps its POSIX wrappers despite the _unix name.
func shouldSkipFile(name string) (ok bool) {
	if mxutil.HasSuffix(name, "_test.mx") {
		return true
	}
	base := name
	if mxutil.HasSuffix(base, ".mx") {
		base = base[:len(base)-3]
	}
	if mxutil.TargetArch() == "wasm" {
		for _, a := range []string{"amd64", "arm64", "386", "linux", "darwin", "posix"} {
			if fileContainsPart(base, a) {
				return true
			}
		}
		return false
	}
	for _, a := range []string{"arm64", "wasm", "386"} {
		if fileContainsPart(base, a) {
			return true
		}
	}
	return false
}


// hasPlatformSuffix reports whether a file name carries a platform suffix
// that the target heuristic would otherwise act on.
func hasPlatformSuffix(base string) (ok bool) {
	for _, a := range []string{"amd64", "arm64", "386", "wasm"} {
		if fileContainsPart(base, a) {
			return true
		}
	}
	for _, s := range []string{"_linux", "_unix", "_darwin", "_posix", "_wasm"} {
		if mxutil.HasSuffix(base, s) {
			return true
		}
	}
	return false
}

// collectAsmFiles lists a package dir's .S assembly files for the
// current target. Plan 9 Go-style .s files are gone from the tree;
// only GNU/LLVM .S assembler is supported (amd64/arm64/wasm32).
func collectAsmFiles(dir string) (ss []string) {
	for _, ext := range []string{".S"} {
		for _, f := range listFiles(dir, ext) {
			base := f
			if len(base) > 2 {
				base = base[:len(base)-2]
			}
			if mxutil.TargetArch() == "wasm" {
				skip := false
				for _, a := range []string{"amd64", "arm64", "386"} {
					if fileContainsPart(base, a) {
						skip = true
					}
				}
				for _, s := range []string{"_linux", "_unix", "_darwin", "_posix"} {
					if mxutil.HasSuffix(base, s) {
						skip = true
					}
				}
				if skip {
					continue
				}
			} else {
				if fileContainsPart(base, "arm64") || fileContainsPart(base, "386") {
					continue
				}
				if mxutil.HasSuffix(base, "_wasm") {
					continue
				}
			}
			ss = mxutil.Ensure(ss, 1)
			push(ss, f)
		}
	}
	return ss
}

func isTagChar(c byte) (ok bool) {
	return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_' || c == '.'
}

func constraintContainsPositive(line string, word string) (ok bool) {
	wl := int32(len(word))
	for i := int32(0); i <= int32(len(line))-wl; i++ {
		if string(line[i:i+wl]) == word {
			if i > 0 && line[i-1] == '!' {
				continue
			}
			after := i + wl
			if after < int32(len(line)) {
				if isTagChar(line[after]) {
					continue
				}
			}
			if i > 0 {
				if isTagChar(line[i-1]) {
					continue
				}
			}
			// check if inside a negated group !(...)
			if isInsideNegatedGroup(line, i) {
				continue
			}
			return true
		}
	}
	return false
}

func isInsideNegatedGroup(line string, pos int32) (result bool) {
	// scan backwards from pos for !(, counting parens
	for j := pos - 1; j >= 1; j-- {
		if line[j] == '(' && line[j-1] == '!' {
			// found !(, now check the matching ) is after pos
			depth := int32(1)
			k := j + 1
			for k < int32(len(line)) && depth > 0 {
				if line[k] == '(' { depth++ }
				if line[k] == ')' { depth-- }
				k++
			}
			if k-1 > pos { // closing ) is after our position
				return true
			}
		}
	}
	return false
}


func hasBuildConstraint(data []byte, forbidden []string) (ok bool) {
	for i := int32(0); i < int32(len(data)) && i < 512; i++ {
		if data[i] == 'p' {
			return false
		}
		skip := int32(0)
		if i+9 < int32(len(data)) && string(data[i:i+9]) == "//:build " {
			skip = 9
		}
		if skip > 0 {
			// Build lines are bounded by the 512-byte scan window.
			buf := []byte{:0:64}
			for j := i + skip; j < int32(len(data)) && data[j] != '\n'; j++ {
				buf = mxutil.Ensure(buf, 1)
				push(buf, data[j])
			}
			line := string(buf)
			if !evalBuildLine(line) {
				return true
			}
			// A forbidden tag excludes the file only when the tag itself is
			// true for this target. Matching textually would forbid any file
			// that merely mentions it - "baremetal || !linux" contains
			// "baremetal" but selects the file everywhere baremetal is false,
			// which is what the stub relies on.
			//
			// evalBuildLine already evaluated the expression, so a forbidden
			// tag can only appear positively on a true line; testing it here
			// is enough.
			for _, f := range forbidden {
				if buildTagTrue(f) {
					return true
				}
			}
			return false
		}
		if data[i] == '\n' {
			continue
		}
		if data[i] == '/' && i+1 < int32(len(data)) && data[i+1] == '/' {
			for i < int32(len(data)) && data[i] != '\n' {
				i++
			}
			continue
		}
	}
	return false
}

// evalBuildLine evaluates a //:build constraint expression for the current
// target. Unknown tags are false; negation of unknown tags is true.
// hasBuildLine reports whether the file states a //:build constraint. Its
// verdict is not inspected here - hasBuildConstraint does that later.
func hasBuildLine(data []byte) (ok bool) {
	for i := int32(0); i < int32(len(data)) && i < 512; i++ {
		if data[i] == 'p' {
			return false
		}
		if i+9 < int32(len(data)) && string(data[i:i+9]) == "//:build " {
			return true
		}
		if data[i] == '\n' {
			continue
		}
		if data[i] == '/' && i+1 < int32(len(data)) && data[i+1] == '/' {
			for i < int32(len(data)) && data[i] != '\n' {
				i++
			}
		}
	}
	return false
}

func evalBuildLine(line string) (ok bool) {
	v, _ := evalBuildOr(line, 0)
	return v
}

func evalBuildOr(line string, pos int32) (val bool, next int32) {
	v, p := evalBuildAnd(line, pos)
	for {
		pp := p
		for pp < int32(len(line)) && (line[pp] == ' ' || line[pp] == '\t') {
			pp++
		}
		if pp+1 < int32(len(line)) && line[pp] == '|' && line[pp+1] == '|' {
			r, np := evalBuildAnd(line, pp+2)
			v = v || r
			p = np
			continue
		}
		return v, pp
	}
}

func evalBuildAnd(line string, pos int32) (val bool, next int32) {
	v, p := evalBuildUnary(line, pos)
	for {
		pp := p
		for pp < int32(len(line)) && (line[pp] == ' ' || line[pp] == '\t') {
			pp++
		}
		if pp+1 < int32(len(line)) && line[pp] == '&' && line[pp+1] == '&' {
			r, np := evalBuildUnary(line, pp+2)
			v = v && r
			p = np
			continue
		}
		return v, pp
	}
}

func evalBuildUnary(line string, pos int32) (val bool, next int32) {
	for pos < int32(len(line)) && (line[pos] == ' ' || line[pos] == '\t') {
		pos++
	}
	if pos < int32(len(line)) && line[pos] == '!' {
		v, np := evalBuildUnary(line, pos+1)
		return !v, np
	}
	if pos < int32(len(line)) && line[pos] == '(' {
		v, np := evalBuildOr(line, pos+1)
		for np < int32(len(line)) && line[np] != ')' {
			np++
		}
		if np < int32(len(line)) {
			np++
		}
		return v, np
	}
	start := pos
	for pos < int32(len(line)) && isTagChar(line[pos]) {
		pos++
	}
	if pos == start {
		// No word: treat as false.
		return false, pos
	}
	return buildTagTrue(line[start:pos]), pos
}

// appendBuildTags parses a -tags value the way legacy's buildutil.TagsFlag
// does: a space-separated (optionally quoted) list when the value contains a
// space or a quote, otherwise a comma-separated list.
func appendBuildTags(v string) {
	if strContains(v, " ") || strContains(v, "'") {
		i := int32(0)
		for i < int32(len(v)) {
			for i < int32(len(v)) && (v[i] == ' ' || v[i] == '\t') {
				i++
			}
			wstart := i
			for i < int32(len(v)) && v[i] != ' ' && v[i] != '\t' {
				i++
			}
			if i == wstart {
				continue
			}
			t := v[wstart:i]
			if len(t) >= 2 && t[0] == '\'' && t[len(t)-1] == '\'' {
				t = t[1 : len(t)-1]
			}
			if len(t) > 0 {
				bst.extraTags = mxutil.Ensure(bst.extraTags, 1)
				push(bst.extraTags, t)
			}
		}
		return
	}
	start := int32(0)
	for j := int32(0); j <= int32(len(v)); j++ {
		if j < int32(len(v)) && v[j] != ',' {
			continue
		}
		t := v[start:j]
		if len(t) > 0 {
			bst.extraTags = mxutil.Ensure(bst.extraTags, 1)
			push(bst.extraTags, t)
		}
		start = j + 1
	}
}

// setPrintAllocs arms -print-allocs. The pattern is validated once here so a
// bad regexp is reported before any package is compiled, and the build is
// forced serial: site ids are handed out in compile order, and parallel
// package compiles would number two packages' sites from the same counter.
// setAllowCaptures turns off the closure-capture rejection.
//
// Moxie closures do not capture: a closure receives what it needs through its
// parameters, and legacy rejects a capturing closure outright. stage4 enforces
// the same rule by default, which is what keeps the two compilers in parity.
// A tree that predates the rule (smesh's UI registers hundreds of handlers
// that close over the enclosing frame) can ask for the relaxation explicitly,
// so the debt is declared in its build files instead of being silent. The flag
// is part of the package cache key, because a package compiled with it must
// not satisfy a build that wants the rule enforced.
func setAllowCaptures() {
	bst.allowCaptures = true
}

func setPrintAllocs(pat string) {
	if perr := mxutil.ResetAllocSites(pat); perr != "" {
		fatal("-print-allocs " | pat | ": " | perr)
	}
	if pat == "" {
		return
	}
	bst.buildJobs = 1
}

// enableCover arms -cover. The site table is reset, the cover build tag is set
// (a program may gate its own code on being instrumented), and the build is
// forced serial for the same reason -print-allocs is: block ids are handed out
// in compile order, and parallel package compiles would number two packages'
// blocks from the same counter.
func enableCover() {
	bst.cover = true
	resetCoverSites()
	appendBuildTags("cover")
	bst.buildJobs = 1
}

// funcRelName is the name -print-allocs matches against: the package path, a
// dot, and the function name. Legacy matches its regexp against
// ssa.Function.RelString(nil), which is the same shape.
func (e *irEmitter) funcRelName() (s string) {
	if e.curFunc == nil {
		return ""
	}
	if e.curFunc.Pkg == nil || e.curFunc.Pkg.Pkg == nil {
		return e.curFunc.name
	}
	p := e.curFunc.Pkg.Pkg.Path
	if p == "" {
		return e.curFunc.name
	}
	return p | "." | e.curFunc.name
}

// emitLogAlloc emits the per-site allocation instrumentation call in front of
// an allocation of sizeReg bytes, when -print-allocs selected this function.
//
// The call is emitted whether or not the alloc_trace tag is selected: without
// it the runtime's logAlloc is a no-op, so the compiler needs no knowledge of
// which runtime files a build chose. The site is recorded for
// <output>.alloc_sites.json.
func (e *irEmitter) emitLogAlloc(sizeReg string) {
	if !mxutil.AllocSitesEnabled() {
		return
	}
	id := mxutil.AddAllocSite(e.funcRelName())
	if id < 0 {
		return
	}
	ipt := e.intptrType()
	e.w("  call void @runtime.logAlloc(i32 ")
	e.w(irItoa(id))
	e.w(", ")
	e.w(ipt)
	e.w(" ")
	e.w(sizeReg)
	e.w(", ptr null)\n")
	e.declareRuntime("runtime.logAlloc", "void", "i32, " | ipt)
}

// writeAllocSites writes the -print-allocs site table beside the output, in
// the same shape legacy writes with encoding/json.
// coverPkg reports whether -cover instruments a package: the module being built
// and any main package. This is deliberately not isUserPackagePath: that rule
// also exempts anything under a "/pkg/" segment, which is the compiler's own
// layout, while a user module may well have one (smesh's relay lives in pkg/).
func coverPkg(path string) (ok bool) {
	if bst == nil || path == "" {
		return false
	}
	if path == "main" || path == "command-line-arguments" {
		return true
	}
	mp := bst.globalModPrefix
	if mp == "" {
		return false
	}
	return path == mp || mxutil.HasPrefix(path, mp|"/")
}

// --- -cover site table ---
//
// One entry per basic block, in emission order, named "pkg.Func@file:line".
// Coverage has no pattern to match, so a site is recorded once -cover is on.
//
// The name array and the name bytes both live in the ROOT arena: the emitter
// builds each name in a package's transient arena, and the table is read again
// after every package has been emitted, so a frame-arena string is a dangling
// reference by then. Reading one crashed the compiler at the end of the first
// -cover build, which is why this table does not follow the alloc-site table's
// plain-slice shape.
var coverNames []string
var coverCount int32

const maxCoverSites = int32(1) << 20

func resetCoverSites() {
	coverCount = 0
}

func addCoverSite(name string) (id int32) {
	a := runtime.RootArena()
	if a == nil || coverCount >= maxCoverSites {
		return -1
	}
	if coverNames == nil {
		coverNames = unsafe.Slice((*string)(unsafe.Pointer(runtime.ArenaAlloc(a, uintptr(maxCoverSites)*unsafe.Sizeof("")))), maxCoverSites)
	}
	id = coverCount
	coverNames[id] = rootCopyString(a, name)
	coverCount++
	return id
}

func coverSiteCount() (n int32) { return coverCount }

func coverSiteName(i int32) (s string) {
	if i < 0 || i >= coverCount {
		return ""
	}
	return coverNames[i]
}

// rootCopyString copies s into the root arena, so it outlives the frame that
// built it.
func rootCopyString(a *runtime.Arena, s string) (r string) {
	n := len(s)
	if n == 0 {
		return ""
	}
	b := unsafe.Slice((*byte)(unsafe.Pointer(runtime.ArenaAlloc(a, uintptr(n)))), n)
	copy(b, s)
	return string(b)
}

// writeCoverSites writes the -cover site table beside the output, in the same
// shape legacy writes with encoding/json: [{"id":N,"name":"pkg.Func@file:line"}].
//
// Built presized through a cursor. A relay-sized build has hundreds of
// thousands of sites, and appending one entry at a time reallocates and copies
// the whole text per site - that is O(n^2) arena and it exhausted the root
// arena's region table on the first real run.
func writeCoverSites(outpath string) {
	if !bst.cover {
		return
	}
	n := coverSiteCount()
	size := int32(2)
	for i := int32(0); i < n; i++ {
		size += int32(len(coverSiteName(i))) + 32
	}
	data := []byte{:size}
	pos := int32(0)
	data[pos] = '['
	pos++
	for i := int32(0); i < n; i++ {
		if i > 0 {
			data[pos] = ','
			pos++
		}
		pos = copyLit(data, pos, "{\"id\":")
		pos = copyLit(data, pos, irItoa(i))
		pos = copyLit(data, pos, ",\"name\":\"")
		pos = copyLit(data, pos, coverSiteName(i))
		pos = copyLit(data, pos, "\"}")
	}
	data[pos] = ']'
	pos++
	mxutil.WriteFile(outpath|".cover_sites.json", data[:pos], 420)
}

// copyLit appends s at pos and returns the new position.
func copyLit(dst []byte, pos int32, s string) (n int32) {
	for i := int32(0); i < int32(len(s)); i++ {
		dst[pos] = s[i]
		pos++
	}
	return pos
}

func writeAllocSites(outpath string) {
	if !mxutil.AllocSitesEnabled() {
		return
	}
	data := []byte("[")
	for i := int32(0); i < mxutil.AllocSiteCount(); i++ {
		if i > 0 {
			data = data | []byte(",")
		}
		data = data | []byte("{\"id\":")
		data = data | []byte(irItoa(i))
		data = data | []byte(",\"name\":\"")
		data = data | []byte(mxutil.AllocSiteName(i))
		data = data | []byte("\"}")
	}
	data = data | []byte("]")
	mxutil.WriteFile(outpath|".alloc_sites.json", data, 420)
}

// buildTagTrue reports whether a build tag is true for the current target.
// Extra tags from -tags win over the target's own: legacy adds them to
// build.Context.BuildTags, which go/build consults before GOOS/GOARCH.
func buildTagTrue(tag string) (ok bool) {
	if bst != nil {
		for i := int32(0); i < int32(len(bst.extraTags)); i++ {
			if bst.extraTags[i] == tag {
				return true
			}
		}
	}
	switch tag {
	case "linux", "amd64":
		// Platform tags belong to the native target only. Enabling them for
		// wasm32 pulls in Linux-only files (e.g. secalloc's mmap-backed
		// guarded arenas) whose syscall constants and mmap/munmap do not
		// exist there.
		return mxutil.TargetArch() != "wasm"
	case "unix":
		// Go's unix tag is a composite of the unix-like GOOS values and is
		// false for js, so syscall's unix files must not be selected for
		// wasm - syscall_js.mx is the implementation there. Files that do
		// want wasm spell it out: src/time/sys_unix.mx is
		// 'unix || (js && wasm)'.
		return mxutil.TargetOS() != "js"
	case "go1.9", "go1.10", "go1.11", "go1.12", "go1.13", "go1.14",
		"go1.15", "go1.16", "go1.17", "go1.18", "go1.19", "go1.20",
		"go1.21", "go1.22", "go1.23", "go1.24",
		"moxie",
		// Matches legacy compileopts.Config.BuildTags so the same source
		// files are selected (pure-Go math/big, no cgo/osusergo paths).
		"purego", "osusergo", "math_big_pure_go", "moxie.unicore":
		return true
	case "wasm", "js", "moxie.wasm":
		return mxutil.TargetArch() == "wasm"
	case "moxie.linux":
		return mxutil.TargetArch() != "wasm"
	case "wasm_unknown":
		return false
	}
	return false
}


// quietDiscover suppresses per-file discovery chatter. Set by build-pkg
// workers, which re-run discovery the orchestrator already printed.

// buildJobs is the max number of concurrent child processes (workers and
// clang) used by build/test. Set by the -j flag; 1 forces the serial path.

// The runtime bake (sysroot/runtime_go.bc) is the runtime compiled to
// bitcode, linked by applications when the runtime is not itself in the build
// closure. The compiler always compiles the runtime from source, so a stale
// bake never affects the bootstrap; `moxie build-runtime` regenerates it, and
// it is created on demand when absent.

type pkgInfo struct {
	path    string
	name    string
	dir     string
	files   []string
	cfiles  []string
	bcfiles []string
	imports []string
	version string
	baked   bool // types preloaded from the sysroot bake; symbols come from runtime_go.bc at link time
}

func discoverPkg(pkgPath, root string) (p *pkgInfo) {
	var dir string
	if pkgPath == "." || pkgPath == ".." || mxutil.HasPrefix(pkgPath, "/") || mxutil.HasPrefix(pkgPath, "./") || mxutil.HasPrefix(pkgPath, "../") {
		dir = pkgPath
	} else if bst.globalReplaces != nil {
		if rdir, ok := bst.globalReplaces[pkgPath]; ok {
			dir = rdir
		}
		if dir == "" {
			for from, to := range bst.globalReplaces {
				if mxutil.HasPrefix(pkgPath, from|"/") {
					rel := pkgPath[len(from)+1:]
					dir = mxutil.JoinPath(to, rel)
					break
				}
			}
		}
	}
	if dir == "" && bst.globalModPrefix != "" && pkgPath == bst.globalModPrefix {
		dir = bst.globalModDir
	}
	if dir == "" && bst.globalModPrefix != "" && mxutil.HasPrefix(pkgPath, bst.globalModPrefix|"/") {
		rel := pkgPath[len(bst.globalModPrefix)+1:]
		dir = mxutil.JoinPath(bst.globalModDir, rel)
	}
	if dir == "" {
		candidate := mxutil.JoinPath(getMoxiePath(), pkgPath)
		mxF := listFiles(candidate, ".mx")
		if len(mxF) > 0 {
			dir = candidate
		}
	}
	if dir == "" {
		// The standard library owns its import paths. Resolve them before the
		// module-relative fallback below, or a nested module whose tree holds
		// a same-named directory captures the stdlib import: building
		// ./web/common/marmot from the smesh root resolved crypto/hkdf to
		// web/common/crypto/hkdf, and that package's own
		// `stdhkdf "crypto/hkdf"` then resolved to itself.
		sd := mxutil.JoinPath(root, mxutil.JoinPath("src", pkgPath))
		mxF := listFiles(sd, ".mx")
		if len(mxF) > 0 {
			dir = sd
		}
	}
	if dir == "" && bst.globalModDir != "" && !isRemotePath(pkgPath) {
		// Module-relative import (e.g. "tests/foo/lib"): the legacy loader
		// accepts these; resolve them under the module root.
		candidate := mxutil.JoinPath(bst.globalModDir, pkgPath)
		mxF := listFiles(candidate, ".mx")
		if len(mxF) > 0 {
			dir = candidate
		}
	}
	if dir == "" && isRemotePath(pkgPath) {
		ver := ""
		if bst.globalModDir != "" {
			_, reqs, _ := parseModRequires(bst.globalModDir)
			for _, r := range reqs {
				if r.path == pkgPath {
					ver = r.version
					break
				}
			}
		}
		fetched := autoFetchRepo(pkgPath, ver)
		if fetched != "" {
			mxF := listFiles(fetched, ".mx")
			if len(mxF) > 0 {
				dir = fetched
			}
		}
	}
	if dir != "" && dir != pkgPath {
		mergeModReplaces(dir)
	}
	if dir == "" {
		dir = mxutil.JoinPath(root, mxutil.JoinPath("src", pkgPath))
		mxf := listFiles(dir, ".mx")
		if len(mxf) == 0 {
			dir = mxutil.JoinPath(root, mxutil.JoinPath("src/vendor", pkgPath))
		}
	}
	mxFiles := listFiles(dir, ".mx")
	bcFiles := listFiles(dir, ".bc")
	allMx := mxFiles
	var forbidden []string
	if mxutil.TargetArch() == "wasm" {
		forbidden = []string{"none", "linux", "unix", "darwin", "amd64", "arm64",
			"ignore", "compiler_bootstrap",
			"scheduler.tasks", "scheduler.cores", "scheduler.asyncify",
			"faketime", "baremetal", "nintendoswitch",
			"boringcrypto", "cgo",
			"runtime_memhash_leveldb", "runtime_memhash_tsip",
			"runtime_asserts", "moxie.stringer"}
	} else {
		forbidden = []string{"none", "wasm", "js", "ignore", "compiler_bootstrap",
			"scheduler.tasks", "scheduler.cores", "scheduler.asyncify",
			"faketime", "baremetal", "nintendoswitch", "boringcrypto", "gc"}
	}
	cFilesAll := listFiles(dir, ".c")
	cFiles := []string{:0:len(cFilesAll)}
	for _, cf := range cFilesAll {
		if mxutil.HasSuffix(cf, "_test.c") {
			continue
		}
		if shouldSkipFile(cf) {
			continue
		}
		cdata, cok := mxutil.ReadFile(mxutil.JoinPath(dir, cf))
		if cok && hasBuildConstraint(cdata, forbidden) {
			continue
		}
		cFiles = mxutil.Ensure(cFiles, 1)
		push(cFiles, cf)
	}
	files := []string{:0:len(allMx)}
	for _, f := range allMx {
		data, ok := mxutil.ReadFile(mxutil.JoinPath(dir, f))
		if !ok {
			continue
		}
		// Go selects on //go:build before the filename. When a file states
		// its own constraint, that constraint is the verdict - it may
		// positively select a platform-suffixed name
		// (src/time/sys_unix.mx: 'unix || (js && wasm)') or negatively
		// select one (src/math/dim_noasm.mx: '!amd64 && !arm64 && !wasm').
		// The filename rule is only a fallback for files with no
		// constraint of their own. hasBuildConstraint below still applies
		// the target's forbidden tags.
		if !hasBuildLine(data) && shouldSkipFile(f) {
			continue
		}
		bc := hasBuildConstraint(data, forbidden)
		if bc {
			if !bst.quietDiscover {
				mxutil.WriteStr(2, "    skip-constraint: " | f | "\n")
			}
			continue
		}
		if !bst.quietDiscover {
			mxutil.WriteStr(2, "    include: " | f | "\n")
		}
		files = mxutil.Ensure(files, 1)
		push(files, f)
	}
	if len(files) == 0 {
		return nil
	}
	allImports := []string{:0:len(files) * 4}
	pkgName := ""
	for _, f := range files {
		data, ok := mxutil.ReadFile(mxutil.JoinPath(dir, f))
		if !ok {
			continue
		}
		if pkgName == "" {
			pkgName = extractPkgName(data)
		}
		for _, imp := range extractImports(data) {
			allImports = appendUniq(allImports, imp)
		}
	}
	if !bst.quietDiscover {
		mxutil.WriteStr(2, "  discover " | pkgPath | " [")
		for fi, ff := range files {
			if fi > 0 {
				mxutil.WriteStr(2, ", ")
			}
			mxutil.WriteStr(2, ff)
		}
		mxutil.WriteStr(2, "]\n")
	}
	version := ""
	if isRemotePath(pkgPath) && bst.globalModDir != "" {
		_, reqs, _ := parseModRequires(bst.globalModDir)
		for _, r := range reqs {
			if r.path == pkgPath || mxutil.HasPrefix(pkgPath, r.path|"/") {
				version = r.version
				break
			}
		}
	}
	return &pkgInfo{
		path:    pkgPath,
		name:    pkgName,
		dir:     dir,
		files:   files,
		cfiles:  cFiles,
		bcfiles: bcFiles,
		imports: allImports,
		version: version,
	}
}

type resolver struct {
	visited map[string]bool
	order   []*pkgInfo
	root    string
	// rootPkg is the package the build was asked for. A dependency that
	// resolves to nothing is skipped (builtin-only and optional packages rely
	// on that), but the requested package resolving to nothing means the path
	// does not exist - the legacy loader reports that as "cannot find package"
	// and this compiler used to link a stub instead.
	rootPkg string
}

func (r *resolver) walk(path string) {
	if r.visited[path] {
		return
	}
	r.visited[path] = true
	if isBuiltinOnly(path) {
		return
	}
	pkg := discoverPkg(path, r.root)
	if pkg == nil {
		if path == r.rootPkg {
			fatal("cannot find package " | path)
		}
		return
	}
	for _, imp := range pkg.imports {
		r.walk(imp)
	}
	r.order = mxutil.Ensure(r.order, 1)
	push(r.order, pkg)
}

func resolveAll(rootPkg string, root string) (ss []*pkgInfo) {
	r := &resolver{
		visited: map[string]bool{},
		order:   []*pkgInfo{:0:64},
		root:    root,
		rootPkg: rootPkg,
	}
	r.walk(rootPkg)
	return r.order
}

func registerBuiltins() {
	for k := range cctx.universe.Registry {
		delete(cctx.universe.Registry, k)
	}

	// unsafe - compiler builtin, no source
	unsafePkg := NewTCPackage("unsafe", "unsafe")
	unsafePkg.Scope.Insert(NewTypeName(unsafePkg, "Pointer", Typ[UnsafePointer]))
	unsafePkg.Scope.Insert(NewTCFunc(unsafePkg, "Sizeof", parseSignatureDesc("__any->int32")))
	unsafePkg.Scope.Insert(NewTCFunc(unsafePkg, "Offsetof", parseSignatureDesc("__any->int32")))
	unsafePkg.Scope.Insert(NewTCFunc(unsafePkg, "Alignof", parseSignatureDesc("__any->int32")))
	unsafePkg.Scope.Insert(NewTCFunc(unsafePkg, "Slice", parseSignatureDesc("ptr,int32->[]uint8")))
	unsafePkg.Scope.Insert(NewTCFunc(unsafePkg, "SliceData", parseSignatureDesc("[]uint8->ptr")))
	unsafePkg.Scope.Insert(NewTCFunc(unsafePkg, "TypeOf", parseSignatureDesc("__any->ptr")))
	cctx.universe.Registry["unsafe"] = unsafePkg

	// runtime - assembly + C, pre-compiled in runtime.bc
	rtPkg := NewTCPackage("runtime", "runtime")
	rtPkg.Scope.Insert(NewTCFunc(rtPkg, "InitCShared", parseSignatureDesc("")))
	rtPkg.Scope.Insert(NewTCFunc(rtPkg, "LockOSThread", parseSignatureDesc("")))
	rtPkg.Scope.Insert(NewTCFunc(rtPkg, "UnlockOSThread", parseSignatureDesc("")))
	rtPkg.Scope.Insert(NewTCFunc(rtPkg, "KeepAlive", parseSignatureDesc("__any")))
	rtPkg.Scope.Insert(NewTCFunc(rtPkg, "GOROOT", parseSignatureDesc("->string")))
	rtPkg.Scope.Insert(NewTCFunc(rtPkg, "Gosched", parseSignatureDesc("")))
	rtPkg.Scope.Insert(NewTCFunc(rtPkg, "Version", parseSignatureDesc("->string")))
	rtPkg.Scope.Insert(NewTCVar(rtPkg, "GOOS", Typ[TCString]))
	rtPkg.Scope.Insert(NewTCVar(rtPkg, "GOARCH", Typ[TCString]))
	rtPkg.Synthetic = true
	cctx.universe.Registry["runtime"] = rtPkg

	// os - builtinOnly: type info for globals/functions used from source
	osPkg := NewTCPackage("os", "os")
	osPkg.Scope.Insert(NewTCVar(osPkg, "Args", NewSlice(Typ[TCString])))
	osPkg.Scope.Insert(NewTCFunc(osPkg, "Exit", parseSignatureDesc("int32")))
	osPkg.Scope.Insert(NewTCFunc(osPkg, "Getenv", parseSignatureDesc("string->string")))
	osPkg.Scope.Insert(NewTCFunc(osPkg, "Setenv", parseSignatureDesc("string,string->int32")))
	osPkg.Scope.Insert(NewTCFunc(osPkg, "Getuid", parseSignatureDesc("->int32")))
	osPkg.Scope.Insert(NewTCFunc(osPkg, "Getpid", parseSignatureDesc("->int32")))
	osPkg.Scope.Insert(NewTCFunc(osPkg, "Open", parseSignatureDesc("string->__any,error")))
	osPkg.Scope.Insert(NewTCFunc(osPkg, "Create", parseSignatureDesc("string->__any,error")))
	osPkg.Scope.Insert(NewTCFunc(osPkg, "ReadFile", parseSignatureDesc("string->string,error")))
	osPkg.Scope.Insert(NewTCFunc(osPkg, "WriteFile", parseSignatureDesc("string,string,uint32->error")))
	osPkg.Scope.Insert(NewTCFunc(osPkg, "MkdirAll", parseSignatureDesc("string,uint32->error")))
	osPkg.Scope.Insert(NewTCFunc(osPkg, "Remove", parseSignatureDesc("string->error")))
	osPkg.Scope.Insert(NewTCFunc(osPkg, "Rename", parseSignatureDesc("string,string->error")))
	osPkg.Scope.Insert(NewTCFunc(osPkg, "Stat", parseSignatureDesc("string->__any,error")))
	osPkg.Scope.Insert(NewTCFunc(osPkg, "Getwd", parseSignatureDesc("->string,error")))
	osPkg.Scope.Insert(NewTCFunc(osPkg, "Chdir", parseSignatureDesc("string->error")))
	osPkg.Scope.Insert(NewTCFunc(osPkg, "Stdin", parseSignatureDesc("->__any")))
	osPkg.Scope.Insert(NewTCFunc(osPkg, "Stdout", parseSignatureDesc("->__any")))
	osPkg.Scope.Insert(NewTCFunc(osPkg, "Stderr", parseSignatureDesc("->__any")))
	osPkg.Synthetic = true
	cctx.universe.Registry["os"] = osPkg
}


func remapErrorLines(msg string) (s string) {
	if len(cctx.concatSourceMap) == 0 {
		return msg
	}
	lines := mxutil.SplitLines(msg)
	var out []string
	for _, line := range lines {
		out = mxutil.Ensure(out, 1)
		push(out, remapOneLine(line))
	}
	return joinStrings(out, "\n")
}

func remapOneLine(line string) (s string) {
	if len(cctx.concatSourceMap) == 0 {
		return line
	}
	colonCount := int32(0)
	firstColon := int32(-1)
	secondColon := int32(-1)
	for i := int32(0); i < int32(len(line)); i++ {
		if line[i] == ':' {
			colonCount++
			if colonCount == 1 {
				firstColon = i
			} else if colonCount == 2 {
				secondColon = i
				break
			}
		}
	}
	if secondColon < 0 {
		return line
	}
	numStr := line[firstColon+1 : secondColon]
	n := int32(0)
	valid := len(numStr) > 0
	for i := int32(0); i < int32(len(numStr)); i++ {
		if numStr[i] < '0' || numStr[i] > '9' {
			valid = false
			break
		}
		n = n*10 + int32(numStr[i]-'0')
	}
	if !valid {
		return line
	}
	file, srcLine := concatLineToFile(n)
	if file == "" {
		return line
	}
	return file | ":" | simpleItoa(srcLine) | line[secondColon:]
}

func compileSource(src []byte, pkgName, triple, pkgDir string) (s string) {
	cctx.compilePkgDir = pkgDir
	ir := CompileToIR(src, pkgName, triple)
	if len(ir) > 0 && ir[0] == ';' {
		mxutil.WriteStr(2, remapErrorLines(ir))
		fatal("compile error for " | pkgName)
	}
	// When streaming (irOutputFile set), IR is written to file directly.
	// Empty ir string is expected - the file has the content.
	if len(ir) == 0 && cctx.irOutputFile == "" {
		fatal("empty IR for " | pkgName)
	}
	return ir
}

// scanPkgGenerics reads a package's sources and records its generic
// declarations. A free function so the source text dies with its frame: the
// build loops called concatSources directly, and the copy stayed live in the
// loop's arena - up to megabytes per package for the generated packages -
// until the whole link returned.
func scanPkgGenerics(dir string, files []string, compilePath string) {
	src := concatSources(dir, files)
	ScanGenericDecls(src, compilePath)
}

// typeCheckPkgSource concatenates a package's sources and type-checks them into
// the registry, creating the cache directory first. Free function for the same
// reason as scanPkgGenerics: only the type graph (root arena) outlives the
// call, not the source text.
func typeCheckPkgSource(cacheBase, dir string, files []string, pkgPath, compilePath, cachedMxh string) {
	src := concatSources(dir, files)
	if len(src) == 0 {
		return
	}
	mkdirAll(mxutil.JoinPath(cacheBase, safeName(pkgPath)), 0755)
	TypeCheckOnly(src, compilePath, cachedMxh)
}

// compilePkgSource concatenates a package's sources and compiles them. Free
// function so the source text - the largest per-package transient - is released
// when the compile returns instead of living in the build loop's arena.
func compilePkgSource(dir string, files []string, compilePath, triple string) (ir string) {
	src := concatSources(dir, files)
	return compileSource(src, compilePath, triple, dir)
}


// mxhBuf accumulates mxh output. Pre-sized buffer with offset write.
// No growth, no abandoned arrays under arena allocation.
type mxhBuf struct {
	data []byte
	off  int32
}

func (b *mxhBuf) w(s string) {
	need := b.off + len(s)
	if need > len(b.data) {
		newCap := int32(len(b.data)) * 2
		if newCap < need {
			newCap = need + 4096
		}
		nd := []byte{:newCap}
		for i := int32(0); i < b.off; i++ {
			nd[i] = b.data[i]
		}
		b.data = nd
	}
	for j := int32(0); j < len(s); j++ {
		b.data[b.off+j] = s[j]
	}
	b.off += len(s)
}

func (b *mxhBuf) nl() {
	if b.off >= len(b.data) {
		b.data = mxutil.Ensure(b.data, 1)
		push(b.data, '\n')
		b.off++
		return
	}
	b.data[b.off] = '\n'
	b.off++
}

// typeDescStr returns the type descriptor for simple/leaf types.
// For compound types that recurse, use typeDescWrite.
func typeDescStr(t Type) (s string) {
	var b mxhBuf
	b.data = []byte{:256}
	typeDescWrite(&b, t)
	return string(b.data[:b.off])
}

// isUnexportedName reports whether an identifier begins with a lowercase
// letter (moxie identifiers follow Go case rules).
func isUnexportedName(name string) (ok bool) {
	if len(name) == 0 {
		return false
	}
	c := name[0]
	return c >= 'a' && c <= 'z'
}

func typeDescWrite(b *mxhBuf, t Type) {
	if t == nil {
		b.w("__any")
		return
	}
	switch v := t.(type) {
	case *Basic:
		if v == nil {

			b.w("int32")
			return
		}
		switch v.Kind {
		case Bool:
			b.w("bool")
		case Int8:
			b.w("int8")
		case Int16:
			b.w("int16")
		case Int32:
			b.w("int32")
		case Int64:
			b.w("int64")
		case Uint8:
			b.w("uint8")
		case Uint16:
			b.w("uint16")
		case Uint32:
			b.w("uint32")
		case Uint64:
			b.w("uint64")
		case Float32:
			b.w("float32")
		case Float64:
			b.w("float64")
		case TCString:
			b.w("string")
		case UnsafePointer:
			b.w("ptr")
		// Untyped kinds keep their own token. Writing them as the default
		// int32 lost the kind entirely: a re-exported `const MaxFloat64 =
		// 0x1p1023 * (...)` came back as an int32 const whose float text
		// parsed to 0, so math.IsInf read `2.1 > MaxFloat64` as true and
		// Ceil/Floor/Trunc/Sqrt returned their argument unchanged.
		case UntypedBool:
			b.w("untyped_bool")
		case UntypedInt:
			b.w("untyped_int")
		case UntypedRune:
			b.w("untyped_rune")
		case UntypedFloat:
			b.w("untyped_float")
		case UntypedString:
			b.w("untyped_string")
		case UntypedNil:
			b.w("untyped_nil")
		default:
			b.w("int32")
		}
	case *Slice:
		if v == nil {

			b.w("[]__any")
			return
		}
		b.w("[]")
		typeDescWrite(b, v.Elem)
	case *Array:
		if v == nil {

			b.w("[0]__any")
			return
		}
		b.w("[")
		b.w(simpleItoa64(v.Len))
		b.w("]")
		typeDescWrite(b, v.Elem)
	case *Pointer:
		if v == nil {

			b.w("*__any")
			return
		}
		b.w("*")
		typeDescWrite(b, v.Base)
	case *TCStruct:
		if v == nil {

			b.w("struct{}")
			return
		}
		b.w("struct{")
		for i := int32(0); i < v.NumFields(); i++ {
			if i > 0 {
				b.w(",")
			}
			f := v.Field(i)
			if f == nil {

				b.w("?")
				continue
			}
			if f.Anonymous {
				b.w("@")
			}
			b.w(f.Name)
			b.w(":")
			typeDescWrite(b, f.Typ)
		}
		b.w("}")
	case *TCInterface:
		if v == nil {

			b.w("__any")
			return
		}
		if v.IsEmpty() {
			b.w("__any")
			return
		}
		hasError := false
		for mi := int32(0); mi < v.NumMethods(); mi++ {
			m := v.Method(mi)
			if m == nil {

				continue
			}
			if m.Name == "Error" {
				hasError = true
				break
			}
		}
		if hasError {
			b.w("error")
		} else {
			b.w("__any")
		}
	case *TCChan:
		if v == nil {

			b.w("chan:__any")
			return
		}
		switch v.Dir {
		case TCSendOnly:
			b.w("chan<-:")
		case TCRecvOnly:
			b.w("<-chan:")
		default:
			b.w("chan:")
		}
		typeDescWrite(b, v.Elem)
	case *TCMap:
		if v == nil {

			b.w("map[__any]__any")
			return
		}
		b.w("map[")
		typeDescWrite(b, v.Key)
		b.w("]")
		typeDescWrite(b, v.Elem)
	case *Signature:
		if v == nil {

			b.w("func()")
			return
		}
		b.w("func(")
		sigDescWrite(b, v)
		b.w(")")
	case *TypeParam:
		b.w("$")
		b.w(v.String())
	case *Named:
		if v == nil {

			b.w("__any")
			return
		}
		if v.Obj != nil {
			// Inline unexported method-less named basic types: struct field
			// descs reference them (Curve.curve curveID) and an importer
			// that cannot resolve the name degrades the field to int32,
			// shifting every following field offset relative to the
			// defining package's layout.
			if isUnexportedName(v.Obj.Name) && v.NumMethods() == 0 {
				if ub, ok := SafeUnderlying(v.Under).(*Basic); ok {
					typeDescWrite(b, ub)
					return
				}
			}
			if cctx.typeDescPkgPath != "" && v.Obj.Pkg != nil && v.Obj.Pkg.Path != cctx.typeDescPkgPath {
				b.w(v.Obj.Pkg.Path)
				b.w(".")
			}
			b.w(v.Obj.Name)
			return
		}
		typeDescWrite(b, v.Under)
	default:
		b.w("__any")
	}
}

func sigDescWrite(b *mxhBuf, sig *Signature) {
	if sig.Params != nil {
		for i := int32(0); i < sig.Params.Len(); i++ {
			if i > 0 {
				b.w(",")
			}
			pt := sig.Params.At(i).Typ
			if sig.Variadic && i == sig.Params.Len()-1 {
				if sl, ok := pt.(*Slice); ok {
					b.w("...")
					typeDescWrite(b, sl.Elem)
					continue
				}
			}
			typeDescWrite(b, pt)
		}
	}
	if sig.Results != nil && sig.Results.Len() > 0 {
		b.w("->")
		for i := int32(0); i < sig.Results.Len(); i++ {
			if i > 0 {
				b.w(",")
			}
			typeDescWrite(b, sig.Results.At(i).Typ)
		}
	}
}

// sigDescStr kept for callers that need a string.
func sigDescStr(sig *Signature) (s string) {
	var b mxhBuf
	b.data = []byte{:256}
	sigDescWrite(&b, sig)
	return string(b.data[:b.off])
}

func generateMxh(pkg *TCPackage) (s string) {
	path := pkg.Path
	name := pkg.Name
	cctx.typeDescPkgPath = path
	var b mxhBuf
	b.data = []byte{:int32(len(pkg.Scope.Names())) * 80 + 4096}
	b.w("package ") ; b.w(path) ; b.w(" ") ; b.w(name) ; b.nl()
	for _, ip := range cctx.universe.DirectImportPaths(pkg) {
		b.w("import ") ; b.w(ip) ; b.nl()
	}
	for _, objName := range pkg.Scope.Names() {
		if len(objName) == 0 {
			continue
		}
		exported := objName[0] >= 'A' && objName[0] <= 'Z'
		obj := pkg.Scope.Lookup(objName)
		if obj == nil {
			continue
		}
		// Unexported *types* are emitted too. Descriptors in this same mxh
		// reference them by name (a struct field, a method result, a slice
		// element), and a reader that cannot resolve the name degrades it to
		// int32, which diverges layouts and signatures from the defining
		// package. Skipping unexported method-less non-struct types was
		// exactly that gap (workerDoneList, proxyInList, encoder, aead,
		// sockaddr, transcriptHash, ...). Unexported funcs/vars/consts stay
		// out: nothing in another package can name them.
		if !exported {
			if _, okType := obj.(*TypeName); !okType {
				continue
			}
		}
		if fn, ok := obj.(*TCFunc); ok {
			sig := fn.Signature()
			if sig != nil {
				b.w("func ") ; b.w(objName) ; b.w(" ")
				sigDescWrite(&b, sig) ; b.nl()
			}
		} else if vr, ok2 := obj.(*TCVar); ok2 {
			if vr == nil || vr.Typ == nil {
				continue
			}
			b.w("var ") ; b.w(objName) ; b.w(" ")
			typeDescWrite(&b, vr.Typ) ; b.nl()
		} else if cn, ok3 := obj.(*TCConst); ok3 {
			if cn == nil || cn.Typ == nil {
				continue
			}
			b.w("const ") ; b.w(objName) ; b.w(" ")
			typeDescWrite(&b, cn.Typ) ; b.w(" ")
			if cn.Val != nil {
				// A float constant exports as its exact rational: the
				// shortest decimal reads back as a different constant, so
				// `math.MaxFloat64 == 1.7976931348623157e308` was true for
				// an importer.
				if cf, isF := cn.Val.(*ConstFloat); isF {
					b.w(cf.MxhText())
				} else {
					b.w(cn.Val.String())
				}
			}
			b.nl()
		} else if tn2, ok4 := obj.(*TypeName); ok4 {
			mxhWriteTypeName(&b, objName, tn2)
		}
	}
	// Generic declarations, so later builds identify them without parsing.
	for _, gn := range cctx.pkgGenerics {
		b.w("gfunc ") ; b.w(gn) ; b.nl()
	}
	return string(b.data[:b.off])
}

func mxhWriteTypeName(b *mxhBuf, objName string, v *TypeName) {
	if v == nil {
		return
	}
	typ := v.Typ
	// An alias: this TypeName points at another type object. Serialize the
	// target, not the target's underlying and methods under this name. Writing
	// it as a `type` line rebuilt the target as a clone in every importer, and
	// a method called through the alias then mangled to the alias's package
	// (crypto/ec.(*FieldVal).Equals against secp256k1's definition).
	if named, isNamed := typ.(*Named); isNamed && named.Obj != v {
		b.w("alias ") ; b.w(objName) ; b.w(" ")
		typeDescWrite(b, named)
		b.nl()
		return
	}
	if named, ok := typ.(*Named); ok {
		if ui, ok2 := named.Under.(*TCInterface); ok2 && !ui.IsEmpty() {
			complete := true
			for mi := int32(0); mi < ui.NumMethods(); mi++ {
				if ui.Method(mi).Sig == nil {
					complete = false
					break
				}
			}
			if complete {
				b.w("iface ") ; b.w(objName)
				mxhWriteTParams(b, named.TParams)
				b.w(" ")
				mxhWriteIfaceMethods(b, ui)
				b.nl()
			}
		} else {
			b.w("type ") ; b.w(objName)
			mxhWriteTParams(b, named.TParams)
			b.w(" ")
			if named.Under != nil {
				typeDescWrite(b, named.Under)
			}
			b.nl()
			if len(named.TParams) == 0 {
				for _, m := range named.Methods {
					msig := m.Signature()
					if msig != nil {
						ptrRecv := "0"
						if m.PtrRecv {
							ptrRecv = "1"
						}
						b.w("method ") ; b.w(objName) ; b.w(" ")
						b.w(m.Name) ; b.w(" ")
						sigDescWrite(b, msig) ; b.w(" ")
						b.w(ptrRecv) ; b.nl()
					}
				}
			}
		}
	} else if iface, ok3 := typ.(*TCInterface); ok3 {
		complete := true
		for mi := int32(0); mi < iface.NumMethods(); mi++ {
			if iface.Method(mi).Sig == nil {
				complete = false
				break
			}
		}
		if complete {
			b.w("iface ") ; b.w(objName) ; b.w(" ")
			mxhWriteIfaceMethods(b, iface)
			b.nl()
		}
	}
}

func mxhWriteTParams(b *mxhBuf, tparams []*TypeParam) {
	if len(tparams) == 0 {
		return
	}
	b.w("[")
	for i, tp := range tparams {
		if i > 0 {
			b.w(",")
		}
		b.w("$")
		b.w(tp.String())
	}
	b.w("]")
}

func mxhWriteIfaceMethods(b *mxhBuf, ui *TCInterface) {
	for mi := int32(0); mi < ui.NumMethods(); mi++ {
		m := ui.Method(mi)
		if mi > 0 {
			b.w(";")
		}
		b.w(m.Name)
		b.w("=")
		sigDescWrite(b, m.Sig)
	}
}

// parseMxhTParams splits "Curve[$P,$Q]" into ("Curve", [TypeParam P, TypeParam Q]).
// For plain names like "Foo" it returns ("Foo", nil).
func parseMxhTParams(raw string) (name string, tparams []*TypeParam) {
	bracketIdx := int32(-1)
	for i := int32(0); i < int32(len(raw)); i++ {
		if raw[i] == '[' {
			bracketIdx = i
			break
		}
	}
	if bracketIdx < 0 {
		return raw, nil
	}
	name = raw[:bracketIdx]
	inner := raw[bracketIdx+1 : int32(len(raw))-1]
	parts := splitCommaBalanced(inner)
	for _, p := range parts {
		if len(p) > 1 && p[0] == '$' {
			tpn := p[1:]
			tparams = mxutil.Ensure(tparams, 1)
			push(tparams, NewTypeParam(NewTypeName(nil, tpn, nil), nil))
		}
	}
	return name, tparams
}

// cacheWrite publishes a cache file atomically: write a per-process temp name
// in the same directory, then rename over the target. A build killed mid-write
// otherwise leaves a truncated .bc/.mxh behind, and a later build reads it -
// which is not hypothetical: after several killed `build -a` runs a compile
// spun at 100% CPU on a torn cache entry and never finished.
func cacheWrite(path string, data []byte) {
	tmp := path | ".tmp" | simpleItoa(os.Getpid())
	writeFile(tmp, data, 0644)
	os.Rename(tmp, path)
}

func loadMxh(path string) (ok bool) {
	data, ok := mxutil.ReadFile(path)
	if !ok {
		return false
	}
	return loadMxhInto(data)
}

// mxh index-walking primitives. All return index pairs into the original
// buffer d. No intermediate string/slice allocations.

// mxhNextLine returns the start and end of the next line at or after pos,
// and the position after the newline. end == start when no content remains.
func mxhNextLine(d string, pos int32) (ls int32, le int32, next int32) {
	ls = pos
	i := pos
	for i < int32(len(d)) && d[i] != '\n' {
		i++
	}
	le = i
	next = i
	if next < int32(len(d)) {
		next++
	}
	return ls, le, next
}

// mxhNextWord returns the start and end of the next whitespace-delimited
// word within d[from:limit]. Returns (limit, limit) when no word found.
func mxhNextWord(d string, from, limit int32) (ws, we int32) {
	i := from
	for i < limit && (d[i] == ' ' || d[i] == '\t') {
		i++
	}
	ws = i
	for i < limit && d[i] != ' ' && d[i] != '\t' {
		i++
	}
	we = i
	return ws, we
}

// mxhHasPrefix checks whether d[start:end] begins with prefix.
func mxhHasPrefix(d string, start, end int32, prefix string) (ok bool) {
	plen := int32(len(prefix))
	if end-start < plen {
		return false
	}
	for i := int32(0); i < plen; i++ {
		if d[start+i] != prefix[i] {
			return false
		}
	}
	return true
}

// mxhEq checks whether d[start:end] equals s.
func mxhEq(d string, start, end int32, s string) (eq bool) {
	if end-start != int32(len(s)) {
		return false
	}
	for i := int32(0); i < end-start; i++ {
		if d[start+i] != s[i] {
			return false
		}
	}
	return true
}

// mxhParseIfaceMethods parses "name1=sig1;name2=sig2" from d[start:end]
// without allocating a []string for the semicolon split.
func mxhParseIfaceMethods(d string, start, end int32) (methods []*IfaceMethod) {
	if start >= end {
		return nil
	}
	// Count methods (semicolon-separated).
	n := int32(1)
	for i := start; i < end; i++ {
		if d[i] == ';' {
			n++
		}
	}
	methods = []*IfaceMethod{:0:n}
	seg := start
	for i := start; i <= end; i++ {
		if i == end || d[i] == ';' {
			eqIdx := int32(-1)
			for k := seg; k < i; k++ {
				if d[k] == '=' {
					eqIdx = k
					break
				}
			}
			if eqIdx > seg {
				mname := string(d[seg:eqIdx])
				msig := parseSignatureDesc(string(d[eqIdx+1 : i]))
				methods = mxutil.Ensure(methods, 1)
				push(methods, NewTCIfaceMethod(mname, msig))
			}
			seg = i + 1
		}
	}
	return methods
}

// mxhCountWords counts space-delimited words in d[from:limit].
func mxhCountWords(d string, from, limit int32) (n int32) {
	i := from
	for i < limit {
		for i < limit && (d[i] == ' ' || d[i] == '\t') {
			i++
		}
		if i >= limit {
			break
		}
		n++
		for i < limit && d[i] != ' ' && d[i] != '\t' {
			i++
		}
	}
	return n
}

// mxhParseConstInt reads a decimal integer constant out of an .mxh line.
// ssaParseInt64 stops at any non-digit, so a "-" prefix read as 0 (every
// negative exported constant, e.g. math.MinInt32, came back 0), and a value
// above int64 wrapped to a negative V without the unsigned mark that makes the
// later divide/remainder folds unsigned (math.MaxUint64 re-exported as -1, so
// uint64(math.MaxUint64) was 0). ConstInt.String now writes the exact unsigned
// value, so the reader has to accept the full 64-bit range.
func mxhParseConstInt(s string) (c ConstVal) {
	neg := false
	if len(s) > 0 && (s[0] == '-' || s[0] == '+') {
		neg = s[0] == '-'
		s = s[1:]
	}
	var u uint64
	for i := 0; i < len(s); i++ {
		ch := s[i]
		if ch < '0' || ch > '9' {
			break
		}
		u = u*10 + uint64(ch-'0')
	}
	if neg {
		return &ConstInt{V: -int64(u)}
	}
	if u > 9223372036854775807 {
		return &ConstInt{V: int64(u), Unsigned: true}
	}
	return &ConstInt{V: int64(u)}
}

// loadMxhData materialises a package's type graph on the root arena: the
// registry keys and names derived from the mxh text must outlive any
// compile/typecheck arena. loadMxhDataIn is the same work with the arena given
// by the caller, so a graph that is only needed for one package's compile can
// be materialised into an arena that is released afterwards.
func loadMxhData(data []byte) (ok bool) {
	return loadMxhDataIn(data, runtime.RootArena())
}

// loadMxhInto materialises a package's graph on the arena the build designated
// (cctx.loadArena) or on the root arena when none is set. A designated arena
// exists so a package no dispatch can reach can be released after its last
// user instead of living as long as the link.
func loadMxhInto(data []byte) (ok bool) {
	if cctx.loadArena != nil {
		return loadMxhDataIn(data, cctx.loadArena)
	}
	return loadMxhData(data)
}

func loadMxhDataIn(data []byte, arena *runtime.Arena) (ok bool) {
	// Types created here must survive on the root arena - they're stored
	// in cctx.universe.Registry which outlives any compile/typecheck arena.
	// Manual-arena mode: FnArenaPush is a no-op, so helper functions
	// (parseTypeDesc, NewNamed, ...) allocate here too instead of in
	// their own transient fn arenas.
	runtime.ManualArenaEnter(arena)
	defer runtime.ManualArenaExit(arena)

	// Copy the mxh bytes into the root arena: every substring derived
	// from d (pkgPath, names, sigs) becomes a registry key and must not
	// point into the transient compile arena.
	var d string
	if len(data) > 0 {
		cpy := []byte{:len(data)}
		copy(cpy, data)
		d = string(cpy)
	}
	dlen := int32(len(d))
	if dlen == 0 {
		return false
	}

	// Parse header: "package <path> <name>"
	ls, le, pos := mxhNextLine(d, 0)
	if !mxhHasPrefix(d, ls, le, "package ") {
		return false
	}
	ws, we := mxhNextWord(d, ls+8, le)
	if ws == we {
		return false
	}
	pkgPath := string(d[ws:we])
	if cctx.mxhLoaded == nil {
		cctx.mxhLoaded = map[string]bool{}
	}
	if cctx.mxhLoaded[pkgPath] {
		// This package's graph is already in the registry from an earlier
		// load in this process. Re-loading it would allocate a second copy of
		// the whole graph in the root arena, which is never released: the
		// serial path loads every package in the whole-link pre-pass and then
		// loads each cached package again, which was ~400MB of duplicate graph
		// on the relay build. One path, one graph.
		return true
	}
	ns, ne := mxhNextWord(d, we, le)
	if ns == ne {
		return false
	}
	pkgName := string(d[ns:ne])

	pkg := NewTCPackage(pkgPath, pkgName)

	// Record generic declarations. An entry exists for every package whose
	// mxh is loaded (possibly empty), so ScanGenericDecls can skip parsing
	// packages the mxh says have no generics.
	if cctx.mxhGenerics == nil {
		cctx.mxhGenerics = map[string]map[string]bool{}
	}
	if cctx.mxhGenerics[pkgPath] == nil {
		cctx.mxhGenerics[pkgPath] = map[string]bool{}
	}
	{
		gpos := pos
		for gpos < dlen {
			gls, gle, gnext := mxhNextLine(d, gpos)
			gpos = gnext
			if mxhHasPrefix(d, gls, gle, "gfunc ") {
				cctx.mxhGenerics[pkgPath][string(d[gls+6:gle])] = true
			}
		}
	}

	// Collect direct imports.
	var dimps []string
	scanPos := pos
	for scanPos < dlen {
		ls2, le2, next2 := mxhNextLine(d, scanPos)
		if mxhHasPrefix(d, ls2, le2, "import ") {
			dimps = mxutil.Ensure(dimps, 1)
			push(dimps, string(d[ls2+7:le2]))
		}
		scanPos = next2
	}
	cctx.universe.DirectImports[pkgPath] = dimps

	oldScope := cctx.parseTypePkgScope
	cctx.parseTypePkgScope = pkg.Scope

	// Pass 1a: register all type and interface names with placeholder types.
	scanPos = pos
	for scanPos < dlen {
		ls2, le2, next2 := mxhNextLine(d, scanPos)
		scanPos = next2
		if mxhHasPrefix(d, ls2, le2, "type ") {
			ws2, we2 := mxhNextWord(d, ls2+5, le2)
			if ws2 < we2 {
				actualName, tparams := parseMxhTParams(string(d[ws2:we2]))
				tn := NewTypeName(pkg, actualName, nil)
				named := NewNamed(tn, nil)
				named.TParams = tparams
				pkg.Scope.Insert(tn)
			}
		} else if mxhHasPrefix(d, ls2, le2, "alias ") {
			ws2, we2 := mxhNextWord(d, ls2+6, le2)
			if ws2 < we2 {
				actualName, tparams := parseMxhTParams(string(d[ws2:we2]))
				tn := NewTypeName(pkg, actualName, nil)
				named := NewNamed(tn, nil)
				named.TParams = tparams
				pkg.Scope.Insert(tn)
			}
		} else if mxhHasPrefix(d, ls2, le2, "iface ") {
			ws2, we2 := mxhNextWord(d, ls2+6, le2)
			if ws2 < we2 {
				actualName, tparams := parseMxhTParams(string(d[ws2:we2]))
				placeholder := NewTCInterface(nil, nil)
				placeholder.Complete()
				tn := NewTypeName(pkg, actualName, nil)
				named := NewNamed(tn, placeholder)
				named.TParams = tparams
				pkg.Scope.Insert(tn)
			}
		}
	}

	// Pass 1b: resolve underlying types and interface methods.
	scanPos = pos
	for scanPos < dlen {
		ls2, le2, next2 := mxhNextLine(d, scanPos)
		scanPos = next2
		if mxhHasPrefix(d, ls2, le2, "type ") {
			ws2, we2 := mxhNextWord(d, ls2+5, le2)
			if ws2 >= we2 {
				continue
			}
			ts, te := mxhNextWord(d, we2, le2)
			actualName, _ := parseMxhTParams(string(d[ws2:we2]))
			obj := pkg.Scope.Lookup(actualName)
			if obj == nil {
				continue
			}
			tn, istn := obj.(*TypeName)
			if !istn {
				continue
			}
			named, isn := tn.Typ.(*Named)
			if !isn {
				continue
			}
			if ts >= te {
				named.Under = NewTCStruct(nil, nil)
			} else {
				named.Under = parseTypeDesc(string(d[ts:te]))
			}
		} else if mxhHasPrefix(d, ls2, le2, "alias ") {
			ws2, we2 := mxhNextWord(d, ls2+6, le2)
			if ws2 >= we2 {
				continue
			}
			ts, te := mxhNextWord(d, we2, le2)
			aliasName, _ := parseMxhTParams(string(d[ws2:we2]))
			obj := pkg.Scope.Lookup(aliasName)
			if obj == nil {
				continue
			}
			tn, istn := obj.(*TypeName)
			if !istn {
				continue
			}
			// Bind to the target type object so alias and target are the same
			// type, exactly as the defining package sees them.
			if ts < te {
				tn.Typ = parseTypeDesc(string(d[ts:te]))
			}
		} else if mxhHasPrefix(d, ls2, le2, "iface ") {
			ws2, we2 := mxhNextWord(d, ls2+6, le2)
			if ws2 >= we2 {
				continue
			}
			ifaceName, _ := parseMxhTParams(string(d[ws2:we2]))
			// Methods descriptor is the second word (may contain semicolons).
			ms, me := mxhNextWord(d, we2, le2)
			methods := mxhParseIfaceMethods(d, ms, me)
			iface := NewTCInterface(methods, nil)
			iface.Complete()
			obj := pkg.Scope.Lookup(ifaceName)
			if obj == nil {
				continue
			}
			if tn, istn := obj.(*TypeName); istn {
				if named, isn := tn.Typ.(*Named); isn {
					named.Under = iface
				} else {
					tn.Typ = iface
				}
			}
		}
	}

	// Pass 2: funcs, methods, vars, consts.
	scanPos = pos
	for scanPos < dlen {
		ls2, le2, next2 := mxhNextLine(d, scanPos)
		scanPos = next2
		if mxhHasPrefix(d, ls2, le2, "func ") {
			ws2, we2 := mxhNextWord(d, ls2+5, le2)
			if ws2 >= we2 {
				continue
			}
			fname := string(d[ws2:we2])
			ss, se := mxhNextWord(d, we2, le2)
			if ss < se {
				sig := parseSignatureDesc(string(d[ss:se]))
				pkg.Scope.Insert(NewTCFunc(pkg, fname, sig))
			} else {
				sig := parseSignatureDesc("")
				pkg.Scope.Insert(NewTCFunc(pkg, fname, sig))
			}
		} else if mxhHasPrefix(d, ls2, le2, "var ") {
			ws2, we2 := mxhNextWord(d, ls2+4, le2)
			if ws2 >= we2 {
				continue
			}
			vname := string(d[ws2:we2])
			ts, te := mxhNextWord(d, we2, le2)
			if ts < te {
				typ := parseTypeDesc(string(d[ts:te]))
				pkg.Scope.Insert(NewTCVar(pkg, vname, typ))
			}
		} else if mxhHasPrefix(d, ls2, le2, "const ") {
			ws2, we2 := mxhNextWord(d, ls2+6, le2)
			if ws2 >= we2 {
				continue
			}
			cname := string(d[ws2:we2])
			ts, te := mxhNextWord(d, we2, le2)
			if ts >= te {
				continue
			}
			typ := parseTypeDesc(string(d[ts:te]))
			// Remaining words after type are the const value.
			vs, ve := mxhNextWord(d, te, le2)
			var val ConstVal
			if vs < ve {
				// Reassemble value from remaining words. Const values
				// may contain spaces (string literals). Walk remaining
				// words and join with space - but use index range to
				// avoid per-word | concat.
				valStart := vs
				valEnd := le2
				// trim trailing whitespace
				for valEnd > valStart && (d[valEnd-1] == ' ' || d[valEnd-1] == '\t') {
					valEnd--
				}
				cval := string(d[valStart:valEnd])
				isNum := true
				for ci := int32(0); ci < int32(len(cval)); ci++ {
					ch := cval[ci]
					if !((ch >= '0' && ch <= '9') || ch == '-' || ch == '+' || ch == 'x' || ch == 'X' || (ch >= 'a' && ch <= 'f') || (ch >= 'A' && ch <= 'F') || ch == ' ') {
						isNum = false
						break
					}
				}
				// The kind decides how the value text is read. A float literal
				// has a '.' or an exponent (math.Pi, math.MaxFloat64), so the
				// integer scan above marks it non-numeric and it used to fall
				// through to ConstInt{0}: every re-exported float constant was
				// zero, so math.IsInf saw 2.1 > MaxFloat64 as true and
				// Ceil/Floor/Trunc/Sqrt answered their argument unchanged.
				// A named string kind (`type Const string`) is not a *Basic:
				// without unwrapping it a re-exported sentinel like
				// fs.ErrNotExist was read back as ConstInt{0}, so every
				// errors.Const comparison against it failed.
				b, isb := SafeUnderlying(typ).(*Basic)
				if isb && (b.Kind == TCString || b.Kind == UntypedString) {
					val = &ConstStr{S: cval}
				} else if isb && (b.Kind == Float32 || b.Kind == Float64 || b.Kind == UntypedFloat) {
					// The text is the exporter's exact spelling ("num/den"
					// for a folded constant, a literal otherwise); keep the
					// rational so a comparison against a literal is exact.
					ex := ExactFloatText(cval)
					if ex != nil {
						f, _ := ex.Float64()
						val = &ConstFloat{V: f, Exact: ex}
					} else {
						val = &ConstFloat{}
					}
				} else if isNum {
					val = mxhParseConstInt(cval)
				} else {
					val = &ConstInt{V: 0}
				}
			} else {
				val = &ConstInt{V: 0}
			}
			pkg.Scope.Insert(NewTCConst(pkg, cname, typ, val))
		} else if mxhHasPrefix(d, ls2, le2, "method ") {
			nwords := mxhCountWords(d, ls2+7, le2)
			if nwords < 3 {
				continue
			}
			w1s, w1e := mxhNextWord(d, ls2+7, le2)
			w2s, w2e := mxhNextWord(d, w1e, le2)
			w3s, w3e := mxhNextWord(d, w2e, le2)
			typeName := string(d[w1s:w1e])
			methodName := string(d[w2s:w2e])
			sigDesc := string(d[w3s:w3e])
			ptrRecv := false
			if nwords >= 4 {
				w4s, w4e := mxhNextWord(d, w3e, le2)
				if mxhEq(d, w4s, w4e, "1") {
					ptrRecv = true
				}
			}
			if nwords == 3 && (sigDesc == "0" || sigDesc == "1") {
				ptrRecv = sigDesc == "1"
				sigDesc = ""
			}
			obj := pkg.Scope.Lookup(typeName)
			if obj == nil {
				continue
			}
			tn, istn := obj.(*TypeName)
			if !istn {
				continue
			}
			named, isn := tn.Typ.(*Named)
			if !isn {
				continue
			}
			sig := parseSignatureDesc(sigDesc)
			var recvType Type = named
			if ptrRecv {
				recvType = NewPointer(named)
			}
			sig = NewSignature(NewTCVar(pkg, "", recvType), sig.Params, sig.Results, sig.Variadic)
			fn := NewTCFunc(pkg, methodName, sig)
			fn.PtrRecv = ptrRecv
			named.AddMethod(fn)
		}
	}

	cctx.parseTypePkgScope = oldScope
	cctx.universe.Registry[pkgPath] = pkg
	cctx.mxhLoaded[pkgPath] = true
	return true
}

func cachedMxhPath(cacheBase, pkgPath, hash, version string) (s string) {
	return mxutil.JoinPath(mxutil.JoinPath(cacheBase, safeName(pkgPath)), versionedCacheName(hash, version, ".mxh"))
}

func removeAll(path string) {
	entries := listFiles(path, "")
	if entries == nil {
		return
	}
	for _, e := range entries {
		os.Remove(mxutil.JoinPath(path, e))
	}
	os.Remove(path)
}

func walkStdlibPkgs(srcDir, prefix string, out []string) (result []string) {
	entries := listFiles(srcDir, "")
	if entries == nil {
		return out
	}
	mxFiles := listFiles(srcDir, ".mx")
	if len(mxFiles) > 0 && prefix != "" {
		out = mxutil.Ensure(out, 1)
		push(out, prefix)
	}
	for _, e := range entries {
		if e[0] == '.' || e[0] == '_' {
			continue
		}
		sub := mxutil.JoinPath(srcDir, e)
		subEntries := listFiles(sub, "")
		if subEntries != nil {
			var subPrefix string
			if prefix == "" {
				subPrefix = e
			} else {
				subPrefix = prefix | "/" | e
			}
			out = walkStdlibPkgs(sub, subPrefix, out)
		}
	}
	return out
}

func cmdCacheWarm() {
	root := moxieRoot()
	ensureModuleRoot(root)
	srcDir := mxutil.JoinPath(root, "src")
	mxutil.WriteStr(2, "warming stdlib cache from " | srcDir | " ...\n")
	pkgPaths := walkStdlibPkgs(srcDir, "", nil)
	if len(pkgPaths) == 0 {
		mxutil.WriteStr(2, "  no stdlib packages found\n")
		return
	}
	triple := "x86_64-unknown-linux-musleabihf"
	clang := "clang-22"
	tmpdir := buildScratchDir("./tmp", "mxc-build")
	mkdirAll(tmpdir, 0755)
	registerScratch(tmpdir)
	cacheBase := pkgCacheDir()
	registerBuiltins()
	compiled := int32(0)
	skipped := int32(0)
	failed := int32(0)
	for _, pkgPath := range pkgPaths {
		if isBuiltinOnly(pkgPath) {
			continue
		}
		pkg := discoverPkg(pkgPath, root)
		if pkg == nil {
			mxutil.WriteStr(2, "  FAIL: " | pkgPath | " (cannot find package)\n")
			failed++
			continue
		}
		hash := pkgHash(pkg)
		cached := cachedBcPath(cacheBase, pkg.path, hash, pkg.version)
		cachedMxh := cachedMxhPath(cacheBase, pkg.path, hash, pkg.version)
		bcOk := mxutil.FileExists(cached)
		mxhOk := mxutil.FileExists(cachedMxh)
		if bcOk && mxhOk {
			skipped++
			continue
		}
		compilePath := pkg.path
		if mxutil.HasPrefix(compilePath, "/") || mxutil.HasPrefix(compilePath, "./") || mxutil.HasPrefix(compilePath, "../") {
			compilePath = pkg.name
		}
		src := concatSources(pkg.dir, pkg.files)
		ir := compileSource(src, compilePath, triple, pkg.dir)
		llFile := mxutil.JoinPath(tmpdir, safeName(pkg.path) | ".ll")
		writeFile(llFile, []byte(ir), 0644)
		bcFile := mxutil.JoinPath(tmpdir, safeName(pkg.path) | ".bc")
		rc := run([]string{clang, "--target=" | triple, "-emit-llvm", "-c", "-Wno-everything", "-Xclang", "-disable-O0-optnone", llFile, "-o", bcFile})
		if rc != 0 {
			mxutil.WriteStr(2, "  FAIL: " | pkg.path | "\n")
			failed++
			continue
		}
		mem2regBc(bcFile)
		cdir := mxutil.JoinPath(cacheBase, safeName(pkg.path))
		mkdirAll(cdir, 0755)
		data, rok := mxutil.ReadFile(bcFile)
		if rok {
			cacheWrite(cached, data)
		}
		if len(cctx.lastMxhData) > 0 {
			cacheWrite(cachedMxh, []byte(cctx.lastMxhData))
			cctx.lastMxhData = ""
		}
		compiled++
		mxutil.WriteStr(2, "  " | pkg.path | "\n")
	}
	mxutil.WriteStr(2, "warm done: " | simpleItoa(compiled) | " compiled, " | simpleItoa(skipped) | " cached, " | simpleItoa(failed) | " failed\n")
}

func printHelp() {
	mxutil.WriteStr(1, "usage: mxc <command> [arguments]\n\ncommands:\n")
	mxutil.WriteStr(1, "  build:   compile packages and dependencies\n")
	mxutil.WriteStr(1, "  run:     compile and run immediately\n")
	mxutil.WriteStr(1, "  test:    test packages\n")
	mxutil.WriteStr(1, "  clean:   empty the cache directory\n")
	mxutil.WriteStr(1, "  targets: list all supported targets\n")
	mxutil.WriteStr(1, "  info:    print target information\n")
	mxutil.WriteStr(1, "  list:    list packages in the current module\n")
	mxutil.WriteStr(1, "  header:  emit a .mxh protocol header for a package\n")
	mxutil.WriteStr(1, "  install: fetch and cache a package\n")
	mxutil.WriteStr(1, "  version: print version information\n")
	mxutil.WriteStr(1, "  env:     print environment information\n")
	mxutil.WriteStr(1, "  fetch:   fetch and cache all dependencies declared in moxie.mod\n")
	mxutil.WriteStr(1, "  cache:   manage the install cache (subcommands: list, clean, warm)\n")
	mxutil.WriteStr(1, "  update:  rebuild cached packages\n")
	mxutil.WriteStr(1, "  build-runtime: build the standalone runtime\n")
	mxutil.WriteStr(1, "  help:    print this help text\n")
}

func printEnv() {
	if mxutil.TargetOS() == "" {
		mxutil.SetTarget("linux", "amd64")
	}
	mxutil.WriteStr(1, "GOOS=\"" | mxutil.TargetOS() | "\"\n")
	mxutil.WriteStr(1, "GOARCH=\"" | mxutil.TargetArch() | "\"\n")
	mxutil.WriteStr(1, "MOXIEROOT=\"" | getenv("MOXIEROOT") | "\"\n")
	mxutil.WriteStr(1, "MOXIEPATH=\"" | getMoxiePath() | "\"\n")
	mxutil.WriteStr(1, "CACHE=\"" | moxieCacheDir() | "\"\n")
}

func printInfo() {
	if mxutil.TargetOS() == "" {
		mxutil.SetTarget("linux", "amd64")
	}
	triple := "x86_64-unknown-linux-musleabihf"
	if mxutil.TargetArch() == "arm64" {
		triple = "aarch64-unknown-linux-musl"
	}
	if mxutil.TargetArch() == "wasm" {
		triple = "wasm32-unknown-wasi"
	}
	mxutil.WriteStr(1, "LLVM triple:       " | triple | "\n")
	mxutil.WriteStr(1, "GOOS:              " | mxutil.TargetOS() | "\n")
	mxutil.WriteStr(1, "GOARCH:            " | mxutil.TargetArch() | "\n")
	mxutil.WriteStr(1, "build tags:        \n")
	mxutil.WriteStr(1, "scheduler:         async\n")
}

func baseName(p string) (b string) {
	for i := len(p) - 1; i >= 0; i-- {
		if p[i] == '/' {
			return p[i+1:len(p)]
		}
	}
	return p
}

func hasMxSuffix(name string) (ok bool) {
	n := len(name)
	if n < 4 {
		return false
	}
	return name[n-3] == '.' && name[n-2] == 'm' && name[n-1] == 'x'
}

func listWalk(dir, prefix string) {
	entries, err := os.ReadDir(dir)
	if err != nil {
		return
	}
	hasMx := false
	var subs []string
	for _, e := range entries {
		name := e.Name()
		if e.IsDir() {
			if name == "vendor" || name == "tmp" || name == "tests" || len(name) > 0 && name[0] == '.' {
				continue
			}
			subs = mxutil.Ensure(subs, 1)
			subs = push(subs, mxutil.JoinPath(dir, name))
			continue
		}
		if hasMxSuffix(name) {
			hasMx = true
		}
	}
	if hasMx {
		mxutil.WriteStr(1, prefix | "\n")
	}
	for _, sd := range subs {
		base := baseName(sd)
		np := base
		if prefix != "" {
			np = prefix | "/" | base
		}
		listWalk(sd, np)
	}
}

func cmdList() {
	_, modDir := findModuleRoot(".")
	if modDir == "" {
		fatal("list: no module file found")
	}
	listWalk(modDir, ".")
}

func printTargets() {
	targets := []string{"darwin/amd64", "darwin/arm64", "js/wasm", "linux/amd64", "linux/arm64"}
	for _, t := range targets {
		mxutil.WriteStr(1, t | "\n")
	}
}

type vendorHash struct {
	path string
	hash string
}

func vendorCopyTree(src, dst string) (hashes []vendorHash) {
	mxutil.MkdirAll(dst, 0755)
	entries, err := os.ReadDir(src)
	if err != nil {
		return hashes
	}
	for _, e := range entries {
		name := e.Name()
		if len(name) == 0 || name[0] == '.' || name[0] == '_' {
			continue
		}
		sp := mxutil.JoinPath(src, name)
		dp := mxutil.JoinPath(dst, name)
		if e.IsDir() {
			for _, h := range vendorCopyTree(sp, dp) {
				hashes = mxutil.Ensure(hashes, 1)
				push(hashes, h)
			}
			continue
		}
		data, ok := mxutil.ReadFile(sp)
		if !ok {
			continue
		}
		mxutil.WriteFile(dp, data, 0644)
		sum := sha256.Sum256(data)
		hashes = mxutil.Ensure(hashes, 1)
		push(hashes, vendorHash{path: dp, hash: "sha256:" | string(hex.EncodeToString(sum[:]))})
	}
	return hashes
}

func cmdVendor() {
	_, modDir := findModuleRoot(".")
	if modDir == "" {
		fatal("vendor: no module file found")
	}
	_, reqs, repls := parseModRequires(modDir)
	if len(reqs) == 0 && len(repls) == 0 {
		mxutil.WriteStr(1, "no dependencies to vendor\n")
		return
	}
	vendorDir := mxutil.JoinPath(modDir, "vendor")
	removeAll(vendorDir)
	mxutil.MkdirAll(vendorDir, 0755)
	var modulesTxt string
	var sumLines []string
	for _, r := range reqs {
		mod := r.path
		srcDir := ""
		if d, ok := repls[mod]; ok {
			srcDir = d
		} else {
			srcDir = mxutil.JoinPath(getMoxiePath(), mod)
		}
		if !mxutil.FileExists(srcDir) {
			fatal("vendor: source not found for " | mod | " at " | srcDir)
		}
		hashes := vendorCopyTree(srcDir, mxutil.JoinPath(vendorDir, mod))
		modulesTxt = modulesTxt | "# " | mod | " " | r.version | "\n## explicit\n"
		for _, h := range hashes {
			sumLines = mxutil.Ensure(sumLines, 1)
			push(sumLines, h.hash | " " | h.path)
		}
	}
	mxutil.WriteFile(mxutil.JoinPath(vendorDir, "modules.txt"), []byte(modulesTxt), 0644)
	for i := int32(1); i < int32(len(sumLines)); i++ {
		for j := i; j > 0 && sumLines[j] < sumLines[j-1]; j-- {
			sumLines[j], sumLines[j-1] = sumLines[j-1], sumLines[j]
		}
	}
	sumContent := ""
	for _, l := range sumLines {
		sumContent = sumContent | l | "\n"
	}
	mxutil.WriteFile(mxutil.JoinPath(vendorDir, "moxie.sum"), []byte(sumContent), 0644)
	mxutil.WriteStr(1, "vendored " | simpleItoa(int32(len(reqs))) | " modules into " | vendorDir | "\n")
}

func hex16(v uint64) (s string) {
	digits := "0123456789abcdef"
	buf := []byte{:0:16}
	for i := int32(0); i < 16; i++ {
		shift := uint64((15 - i) * 4)
		buf = push(buf, digits[(v>>shift)&0xf])
	}
	return string(buf)
}

func tcTypeStr(t Type) (s string) {
	if t == nil {
		return "?"
	}
	switch tt := SafeUnderlying(t).(type) {
	case *Basic:
		return tt.Name
	case *Slice:
		return "[]" | tcTypeStr(tt.Elem)
	case *Array:
		return "[" | simpleItoa(int32(tt.Len)) | "]" | tcTypeStr(tt.Elem)
	case *Pointer:
		return "*" | tcTypeStr(tt.Base)
	case *Named:
		if tt.Obj != nil {
			return tt.Obj.Name
		}
		return "?"
	case *TCStruct:
		return "struct"
	case *TCMap:
		return "map"
	case *TCInterface:
		return "interface"
	}
	return "?"
}

func tcIsVarLen(t Type) (ok bool) {
	switch SafeUnderlying(t).(type) {
	case *Slice, *TCMap:
		return true
	}
	return false
}

func tcHasCodecMethod(t Type) (ok bool) {
	hasEnc := false
	hasDec := false
	switch tt := t.(type) {
	case *Named:
		for _, m := range tt.Methods {
			if m.Name == "EncodeTo" { hasEnc = true }
			if m.Name == "DecodeFrom" { hasDec = true }
		}
	case *Basic:
		for _, m := range tt.Methods {
			if m.Name == "EncodeTo" { hasEnc = true }
			if m.Name == "DecodeFrom" { hasDec = true }
		}
	}
	return hasEnc && hasDec
}

func cmdHeader(pkgName, outdir string) {
	if pkgName == "" {
		fatal("header: package name required")
	}
	ensureModuleRoot(".")
	pkg := discoverPkg(pkgName, ".")
	if pkg == nil {
		fatal("header: package not found: " | pkgName)
	}
	src := concatSources(pkg.dir, pkg.files)
	compilePath := pkg.path
	if compilePath == "." || compilePath == ".." || mxutil.HasPrefix(compilePath, "/") || mxutil.HasPrefix(compilePath, "./") || mxutil.HasPrefix(compilePath, "../") {
		compilePath = pkg.name
	}
	TypeCheckOnly(src, compilePath, "")
	tpkg := cctx.universe.Registry[compilePath]
	if tpkg == nil || tpkg.Scope == nil {
		fatal("header: typecheck failed for " | pkgName)
	}
	body := "// wire: uint32-length-prefixed EncodeTo/DecodeFrom at cross-binary spawn boundaries\n"
	names := tpkg.Scope.Names()
	for i := int32(1); i < int32(len(names)); i++ {
		for j := i; j > 0 && names[j] < names[j-1]; j-- {
			names[j], names[j-1] = names[j-1], names[j]
		}
	}
	for _, name := range names {
		obj := tpkg.Scope.Lookup(name)
		tn, ok := obj.(*TypeName)
		if !ok {
			continue
		}
		t := tn.Typ
		if t == nil {
			continue
		}
		if !tcHasCodecMethod(t) {
			continue
		}
		if _, isIface := SafeUnderlying(t).(*TCInterface); isIface {
			continue
		}
		body = body | "type " | name
		if st, isStruct := SafeUnderlying(t).(*TCStruct); isStruct {
			body = body | " struct {\n"
			for _, f := range st.Fields {
				if !f.Exported() {
					continue
				}
				if tcIsVarLen(f.Typ) {
					fatal("header: variable-length field " | name | "." | f.Name | " cannot appear in .mxh struct layout")
				}
				body = body | "\t" | f.Name | " " | tcTypeStr(f.Typ) | "\n"
			}
			body = body | "}\n"
		} else if !tcIsVarLen(t) {
			body = body | " " | tcTypeStr(t) | "\n"
		} else {
			body = body | " opaque\n"
		}
		body = body | "func (" | name | ") EncodeTo(w io.Writer) error\n"
		body = body | "func (*" | name | ") DecodeFrom(r io.Reader) error\n"
	}
	headerLine := "// mxh v1 " | hex16(fnv1a64(body))
	full := headerLine | "\n" | body
	if outdir == "-" {
		mxutil.WriteStr(1, full)
		return
	}
	mxutil.MkdirAll(outdir, 0755)
	outPath := mxutil.JoinPath(outdir, baseName(pkg.dir) | ".mxh")
	mxutil.WriteFile(outPath, []byte(full), 0644)
	mxutil.WriteStr(2, "header: wrote " | outPath | "\n")
}

func cmdInstall(pkgName string) {
	ensureModuleRoot(".")
	firstSeg := pkgName
	for i := 0; i < len(pkgName); i++ {
		if pkgName[i] == '/' {
			firstSeg = pkgName[:i]
			break
		}
	}
	isRemote := false
	for i := 0; i < len(firstSeg); i++ {
		if firstSeg[i] == '.' {
			isRemote = true
			break
		}
	}
	if isRemote && !mxutil.FileExists(pkgName) {
		cmdFetch(pkgName)
	}
	pkg := discoverPkg(pkgName, ".")
	if pkg == nil {
		fatal("install: package not found: " | pkgName)
	}
	compilePath := pkg.path
	if compilePath == "." || compilePath == ".." || mxutil.HasPrefix(compilePath, "/") || mxutil.HasPrefix(compilePath, "./") || mxutil.HasPrefix(compilePath, "../") {
		compilePath = pkg.name
	}
	src := concatSources(pkg.dir, pkg.files)
	TypeCheckOnly(src, compilePath, "")
	mxutil.WriteStr(2, "install: " | compilePath | " cached\n")
}

func cacheClean() {
	base := pkgCacheDir()
	mxutil.WriteStr(2, "cleaning cache: " | base | "\n")
	entries := listFiles(base, "")
	if entries == nil {
		mxutil.WriteStr(2, "  (empty)\n")
		return
	}
	for _, e := range entries {
		removeAll(mxutil.JoinPath(base, e))
	}
	os.Remove(base)
	mxutil.WriteStr(2, "  done\n")
}



// dispPkgKey is the path a package's mxh header carries and the registry keys
// it under: a local package path (".", "./x", "../x") is recorded by name, not
// by the literal path. The index must use the same key or a comparison against
// the registry reports the main package as index-only for every method it
// defines.
func dispPkgKey(pkg *pkgInfo) (s string) {
	s = pkg.path
	if s == "." || s == ".." || mxutil.HasPrefix(s, "/") || mxutil.HasPrefix(s, "./") || mxutil.HasPrefix(s, "../") {
		s = pkg.name
	}
	return s
}

// copyGenericsToRoot repoints a package's recorded generic-declaration names at
// root-lifetime memory. loadMxhDataIn copies the mxh text into the arena it is
// given, and mxhGenerics keys are substrings of that text; once a package's
// graph is loaded into a transient arena, those keys would dangle for the read
// at ir_typecheck.mx:662 that decides whether to scan a package's generics.
func copyGenericsToRoot(pkgPath string) {
	gens := cctx.mxhGenerics[pkgPath]
	if gens == nil {
		return
	}
	save := runtime.CurrentArena()
	runtime.SetCurrentArena(runtime.RootArena())
	fresh := map[string]bool{}
	for name := range gens {
		c := []byte{:len(name)}
		copy(c, name)
		fresh[string(c)] = true
	}
	runtime.SetCurrentArena(save)
	cctx.mxhGenerics[pkgPath] = fresh
}

// dispIndexCheck loads the link set's mxh - the very cost the index exists to
// avoid - and compares, per interface method, the packages the index attributes
// the method to against the packages the live registry sees. Direct methods
// only: embedded promotion lives in findExtEmbedMethod and is folded in when
// the consumer switches. Registry entries outside the closure (runtime, unsafe,
// os builtins) are ignored on both sides.
func dispIndexCheck(pkgs []*pkgInfo, cacheBase string, ifaceMethods map[string]bool, pkgMethods map[string]map[string]bool) {
	closure := map[string]bool{}
	for _, pkg := range pkgs {
		closure[dispPkgKey(pkg)] = true
	}
	// Rehearsal for per-package isolation: the comparison needs the graphs, the
	// command does not need them afterwards, so they are materialised into an
	// arena this function owns and the registry entries are dropped before it
	// is freed. This is the exact cycle the build path will use for packages
	// that no dispatch can reach.
	arena := runtime.ArenaNew(64 * 1024 * 1024)
	loaded := int32(0)
	for _, pkg := range pkgs {
		hash := pkgHash(pkg)
		if data, ok := mxutil.ReadFile(cachedMxhPath(cacheBase, pkg.path, hash, pkg.version)); ok {
			if loadMxhDataIn(data, arena) {
				loaded++
			}
		}
	}
	regMethods := map[string]map[string]bool{}
	for path, tpkg := range cctx.universe.Registry {
		if !closure[path] || tpkg == nil || tpkg.Scope == nil {
			continue
		}
		names := tpkg.Scope.Names()
		for ni := int32(0); ni < int32(len(names)); ni++ {
			tn, ok := tpkg.Scope.Lookup(names[ni]).(*TypeName)
			if !ok || tn.Typ == nil {
				continue
			}
			named, ok2 := tn.Typ.(*Named)
			if !ok2 || len(named.TParams) > 0 {
				continue
			}
			for mi := int32(0); mi < named.NumMethods(); mi++ {
				mn := named.Method(mi).Name
				m := regMethods[mn]
				if m == nil {
					m = map[string]bool{}
					regMethods[mn] = m
				}
				m[path] = true
			}
		}
	}
	okCount := int32(0)
	badCount := int32(0)
	for name := range ifaceMethods {
		idx := map[string]bool{}
		for path, m := range pkgMethods {
			if m[name] {
				idx[path] = true
			}
		}
		reg := regMethods[name]
		missing := int32(0)
		extra := int32(0)
		for path := range reg {
			if !idx[path] {
				missing++
			}
		}
		for path := range idx {
			if !reg[path] {
				extra++
			}
		}
		if missing == 0 && extra == 0 {
			okCount++
		} else {
			badCount++
			if badCount <= 6 {
				mxutil.WriteStr(1, "  mismatch " | name | ": reg=" | simpleItoa(len(reg)) |
					" idx=" | simpleItoa(len(idx)) | " missing=" | simpleItoa(missing) |
					" extra=" | simpleItoa(extra) | "\n")
				shown := int32(0)
				for path := range idx {
					if !reg[path] && shown < 2 {
						mxutil.WriteStr(1, "    index-only: " | path | "\n")
						shown++
					}
				}
			}
		}
	}
	mxutil.WriteStr(1, "dispindex-check: ifaceMethods=" | simpleItoa(len(ifaceMethods)) |
		" match=" | simpleItoa(okCount) | " mismatch=" | simpleItoa(badCount) |
		" mxhLoaded=" | simpleItoa(loaded) | "\n")
	// Release: drop every entry this call materialised, then the arena. The
	// maps filled from that text (mxhGenerics and friends) are not consulted
	// after this point.
	for _, pkg := range pkgs {
		// Names recorded from the mxh text must survive the arena that held it.
		copyGenericsToRoot(dispPkgKey(pkg))
		delete(cctx.universe.Registry, dispPkgKey(pkg))
	}
	runtime.ArenaFree(arena)
}

// dispParseMethods returns the non-generic method names a package's mxh
// declares. Generic types' methods are never emitted as standalone symbols and
// findIfaceImpls skips them, so the index does too; mxh records the parameters
// in the declaration ("type Array[$T]").
func dispParseMethods(d string) (m map[string]bool) {
	m = map[string]bool{}
	generic := map[string]bool{}
	pos := int32(0)
	for pos < int32(len(d)) {
		ls, le, next := mxhNextLine(d, pos)
		pos = next
		if mxhHasPrefix(d, ls, le, "type ") {
			ws, we := mxhNextWord(d, ls+5, le)
			if ws != we && we < le && d[we] == '[' {
				generic[string(d[ws:we])] = true
			}
		}
	}
	pos = 0
	for pos < int32(len(d)) {
		ls, le, next := mxhNextLine(d, pos)
		pos = next
		if mxhHasPrefix(d, ls, le, "method ") {
			ws, we := mxhNextWord(d, ls+7, le)
			if ws == we {
				continue
			}
			if generic[string(d[ws:we])] {
				continue
			}
			ns, ne := mxhNextWord(d, we, le)
			if ns == ne {
				continue
			}
			m[string(d[ns:ne])] = true
		}
	}
	return m
}

// dispParseIfaceMethods adds every method name declared by an iface line.
func dispParseIfaceMethods(d string, out map[string]bool) {
	pos := int32(0)
	for pos < int32(len(d)) {
		ls, le, next := mxhNextLine(d, pos)
		pos = next
		if !mxhHasPrefix(d, ls, le, "iface ") {
			continue
		}
		ws, we := mxhNextWord(d, ls+6, le)
		if ws == we {
			continue
		}
		i := we
		for i < le {
			if d[i] == '=' {
				j := i - 1
				for j > ws && d[j-1] != ';' && d[j-1] != ' ' {
					j--
				}
				if j < i {
					out[string(d[j:i])] = true
				}
			}
			i++
		}
	}
}

// cmdDispIndex prints the compact dispatch index the per-package isolation work
// needs: which packages in a closure define which methods, and which of those
// methods any interface in the closure declares. It reads the mxh files already
// on disk and materialises no type graph - that is the point, because dispatch
// enumeration is the only reason the whole link set's graphs are retained.
func cmdDispIndex() {
	root := moxieRoot()
	pkgPath := "."
	if len(os.Args) > 2 {
		pkgPath = os.Args[2]
	}
	pkgs := resolveAll(pkgPath, root)
	// pkgHash folds the link set key in, and that is only computed during a
	// build. Without it every mxh path here is a key nobody wrote.
	bst.linkSetKey = linkSetHash(pkgs)
	cacheBase := pkgCacheDir()
	ifaceMethods := map[string]bool{}
	pkgMethods := map[string]map[string]bool{}
	scanned := int32(0)
	methodLines := int32(0)
	for _, pkg := range pkgs {
		hash := pkgHash(pkg)
		mxhPath := cachedMxhPath(cacheBase, pkg.path, hash, pkg.version)
		data, ok := mxutil.ReadFile(mxhPath)
		if !ok {
			continue
		}
		scanned++
		d := string(data)
		m := dispParseMethods(d)
		methodLines += int32(len(m))
		dispParseIfaceMethods(d, ifaceMethods)
		pkgMethods[dispPkgKey(pkg)] = m
	}
	relevant := int32(0)
	methodPackages := map[string]int32{}
	for _, m := range pkgMethods {
		hit := false
		for name := range m {
			methodPackages[name]++
			if ifaceMethods[name] {
				hit = true
			}
		}
		if hit {
			relevant++
		}
	}
	mxutil.WriteStr(1, "dispindex: packages=" | simpleItoa(len(pkgs)) | " mxh=" | simpleItoa(scanned) |
		" methodLines=" | simpleItoa(methodLines) | " methods=" | simpleItoa(len(methodPackages)) |
		" ifaceMethods=" | simpleItoa(len(ifaceMethods)) |
		" dispatchRelevantPkgs=" | simpleItoa(relevant) | "\n")
	for _, name := range []string{"String", "Error", "EncodeTo", "DecodeFrom", "Read", "Write"} {
		mxutil.WriteStr(1, "  " | name | ": iface=")
		if ifaceMethods[name] {
			mxutil.WriteStr(1, "yes")
		} else {
			mxutil.WriteStr(1, "no")
		}
		mxutil.WriteStr(1, " pkgs=" | simpleItoa(methodPackages[name]) | "\n")
	}
	dispIndexCheck(pkgs, cacheBase, ifaceMethods, pkgMethods)

	// planTransientTier simulates the two-tier loading plan on this closure:
	// tier 1 (defines an interface method) is loaded up front for dispatch, tier
	// 2 is loaded at its own turn and released after the package that last needs
	// it. It reports the peak number of tier-2 packages live at once and their
	// share of the closure's mxh bytes, which is the win the loader would buy.
	peakLive := int32(0)
	live := map[string]bool{}
	lastUse := map[string]int32{}
	for i, pkg := range pkgs {
		for _, imp := range pkg.imports {
			lastUse[imp] = int32(i)
		}
	}
	for i, pkg := range pkgs {
		key := dispPkgKey(pkg)
		if !tier1(key, ifaceMethods, pkgMethods) {
			live[key] = true
		}
		if int32(len(live)) > peakLive {
			peakLive = int32(len(live))
		}
		// release every live package whose last use is now
		for k := range live {
			done := true
			if l, ok := lastUse[k]; ok {
				if l > int32(i) {
					done = false
				}
			} else {
				done = false
			}
			if done {
				delete(live, k)
			}
		}
	}
	tier1N := int32(0)
	for _, pkg := range pkgs {
		if tier1(dispPkgKey(pkg), ifaceMethods, pkgMethods) {
			tier1N++
		}
	}
	mxutil.WriteStr(1, "dispindex-plan: tier1=" | simpleItoa(tier1N) |
		" tier2=" | simpleItoa(int32(len(pkgs))-tier1N) |
		" peakTier2Live=" | simpleItoa(peakLive) | "\n")
	// The simpler loader shape: before compiling Q, load Q's transitive tier-2
	// closure and release it after Q. Its peak is max over Q of |closure(Q)|,
	// which decides whether the last-use rule is needed at all.
	byPath := map[string]*pkgInfo{}
	for _, pkg := range pkgs {
		byPath[pkg.path] = pkg
		byPath[dispPkgKey(pkg)] = pkg
	}
	peakPerCompile := int32(0)
	for _, pkg := range pkgs {
		seen := map[string]bool{}
		out := map[string]bool{}
		dispTier2Closure(pkg, byPath, ifaceMethods, pkgMethods, seen, out)
		if int32(len(out)) > peakPerCompile {
			peakPerCompile = int32(len(out))
		}
	}
	mxutil.WriteStr(1, "dispindex-plan2: peakPerCompileTier2=" | simpleItoa(peakPerCompile) | "\n")
}

// dispTier2Closure collects the tier-2 packages in pkg's transitive import
// closure. Free function with explicit parameters: moxie closures do not capture
// outer scope, so recursion needs its state passed in.
func dispTier2Closure(pkg *pkgInfo, byPath map[string]*pkgInfo, ifaceMethods map[string]bool, pkgMethods map[string]map[string]bool, seen map[string]bool, out map[string]bool) {
	for _, imp := range pkg.imports {
		p := byPath[imp]
		if p == nil {
			continue
		}
		key := dispPkgKey(p)
		if seen[key] {
			continue
		}
		seen[key] = true
		if !tier1(key, ifaceMethods, pkgMethods) {
			out[key] = true
		}
		dispTier2Closure(p, byPath, ifaceMethods, pkgMethods, seen, out)
	}
}

// tier1 reports whether a package defines any method an interface in the
// closure declares, i.e. whether a dispatch can reach it.
func tier1(key string, ifaceMethods map[string]bool, pkgMethods map[string]map[string]bool) (b bool) {
	for name := range pkgMethods[key] {
		if ifaceMethods[name] {
			return true
		}
	}
	return false
}

func cmdUpdate(rebuildAll bool) {
	cacheRoot := mxutil.JoinPath(getMoxiePath(), "cache")
	// Cache dirs are named mxc-<version>-<compilerHash>-<os>-<arch>. "Old"
	// means another moxie version: every variant of this version - other
	// compiler hashes, other targets - is current and must survive.
	currentPrefix := "mxc-" | mxcVersion() | "-"
	entries := listFiles(cacheRoot, "")
	if entries == nil {
		mxutil.WriteStr(2, "cache is empty\n")
		return
	}
	for _, e := range entries {
		if mxutil.HasPrefix(e, "mxc-") && !mxutil.HasPrefix(e, currentPrefix) {
			mxutil.WriteStr(2, "  remove old: " | e | "\n")
			fullPath := mxutil.JoinPath(cacheRoot, e)
			pkgEntries := listFiles(fullPath, "")
			if pkgEntries != nil {
				for _, pe := range pkgEntries {
					removeAll(mxutil.JoinPath(fullPath, pe))
				}
			}
			os.Remove(fullPath)
		}
	}
	if !rebuildAll {
		mxutil.WriteStr(2, "update done\n")
		return
	}
	mxutil.WriteStr(2, "rebuilding all cached packages...\n")
	mpath := getMoxiePath()
	root := moxieRoot()
	ensureModuleRoot(root)
	cacheBase := pkgCacheDir()
	pkgDirs := listFiles(cacheBase, "")
	if pkgDirs == nil {
		mxutil.WriteStr(2, "  no packages to rebuild\n")
		return
	}
	triple := "x86_64-unknown-linux-musleabihf"
	clang := "clang-22"
	tmpdir := buildScratchDir("./tmp", "mxc-build")
	mkdirAll(tmpdir, 0755)
	registerScratch(tmpdir)
	registerBuiltins()
	for _, pkgDir := range pkgDirs {
		pkgPath := ""
		for i := 0; i < len(pkgDir); i++ {
			if pkgDir[i] == '_' {
				pkgPath = pkgPath | "/"
			} else {
				pkgPath = pkgPath | string([]byte{pkgDir[i]})
			}
		}
		if len(pkgPath) > 0 && pkgPath[0] == '/' {
			continue
		}
		mxutil.WriteStr(2, "  rebuild " | pkgPath | "\n")
		pkg := discoverPkg(pkgPath, root)
		if pkg == nil {
			candidate := mxutil.JoinPath(mpath, pkgPath)
			mxF := listFiles(candidate, ".mx")
			if len(mxF) > 0 {
				pkg = discoverPkg(pkgPath, root)
			}
		}
		if pkg == nil {
			mxutil.WriteStr(2, "    skip (source not found)\n")
			continue
		}
		compilePath := pkg.path
		if compilePath == "." || compilePath == ".." || mxutil.HasPrefix(compilePath, "/") || mxutil.HasPrefix(compilePath, "./") || mxutil.HasPrefix(compilePath, "../") {
			compilePath = pkg.name
		}
		src := concatSources(pkg.dir, pkg.files)
		ir := compileSource(src, compilePath, triple, pkg.dir)
		llFile := mxutil.JoinPath(tmpdir, safeName(pkg.path) | ".ll")
		writeFile(llFile, []byte(ir), 0644)
		bcFile := mxutil.JoinPath(tmpdir, safeName(pkg.path) | ".bc")
		rc := run([]string{clang, "--target=" | triple, "-emit-llvm", "-c", "-Wno-everything", "-Xclang", "-disable-O0-optnone", llFile, "-o", bcFile})
		if rc != 0 {
			mxutil.WriteStr(2, "    FAIL: clang for " | pkg.path | "\n")
			continue
		}
		mem2regBc(bcFile)
		hash := pkgHash(pkg)
		cached := cachedBcPath(cacheBase, pkg.path, hash, pkg.version)
		cdir := mxutil.JoinPath(cacheBase, safeName(pkg.path))
		mkdirAll(cdir, 0755)
		data, rok := mxutil.ReadFile(bcFile)
		if rok {
			cacheWrite(cached, data)
		}
		if len(cctx.lastMxhData) > 0 {
			cachedMxh := cachedMxhPath(cacheBase, pkg.path, hash, pkg.version)
			cacheWrite(cachedMxh, []byte(cctx.lastMxhData))
			cctx.lastMxhData = ""
		}
	}
	mxutil.WriteStr(2, "rebuild done\n")
}

func scanTestFuncs(data []byte) (ss []string) {
	var funcs []string
	lines := mxutil.SplitLines(string(data))
	for _, line := range lines {
		line = mxutil.TrimSpace(line)
		if !mxutil.HasPrefix(line, "func Test") {
			continue
		}
		paren := int32(-1)
		for i := int32(5); i < int32(len(line)); i++ {
			if line[i] == '(' {
				paren = i
				break
			}
		}
		if paren < 0 {
			continue
		}
		name := line[5:paren] // "func " is 5 chars, so name starts at "Test..."
		if len(name) == 0 {
			continue
		}
		if name[0] < 'A' || name[0] > 'Z' {
			continue
		}
		rest := line[paren:]
		if mxutil.HasPrefix(rest, "(t *testing.T)") {
			funcs = mxutil.Ensure(funcs, 1)
			push(funcs, name)
		}
	}
	return funcs
}

func generateTestMain(pkgName string, testFuncs []string) (buf []byte) {
	var out []byte
	out = out | ("package " | pkgName | "\n\nimport \"testing\"\n\nfunc main() {\n\ttests := []testing.InternalTest{\n")
	for _, name := range testFuncs {
		out = out | ("\t\t{Name: \"" | name | "\", F: " | name | "},\n")
	}
	out = out | "\t}\n\ttesting.Main(tests)\n}\n"
	return out
}

func cmdTest(args []string) {
	pkgPath := ""
	forceRebuild := false
	i := int32(2)
	for i < int32(len(args)) {
		if args[i] == "-a" {
			forceRebuild = true
			i++
		} else if args[i] == "-v" {
			// Test output already streams per test, which is all -v selects
			// in the legacy compiler.
			i++
		} else if args[i] == "-tags" {
			if i+1 >= int32(len(args)) {
				fatal("flag needs an argument: -tags")
			}
			appendBuildTags(args[i+1])
			i += 2
		} else if args[i] == "-print-allocs" {
			if i+1 >= int32(len(args)) {
				fatal("flag needs an argument: -print-allocs")
			}
			setPrintAllocs(args[i+1])
			i += 2
		} else if args[i] == "-cover" {
			enableCover()
			i++
		} else if args[i] == "-allow-closure-captures" {
			setAllowCaptures()
			i++
		} else if args[i] == "-work" {
			bst.keepWork = true
			i++
		} else if mxutil.HasPrefix(args[i], "-") && pkgPath == "" {
			fatal("flag provided but not defined: " | args[i])
		} else {
			pkgPath = args[i]
			i++
		}
	}
	if pkgPath == "" {
		pkgPath = "."
	}
	if mxutil.AllocSitesEnabled() || bst.cover {
		// The site table is built while packages are emitted, so a package
		// taken from the build cache would be missing from it.
		forceRebuild = true
	}

	root := moxieRoot()
	triple := "x86_64-unknown-linux-musleabihf"
	clang := "clang-22"

	// A target that names a directory on disk (./pkg, ../pkg, /abs/pkg, or
	// a bare relative dir like pkg) is resolved through the module root; an
	// import path like "fmt" is not. Missing this leaves globalModDir empty
	// and module-internal imports unresolvable.
	if isDirPath(pkgPath) {
		ensureModuleRoot(pkgPath)
	}

	registerBuiltins()

	var testPkgDir string
	if pkgPath == "." || pkgPath == ".." || mxutil.HasPrefix(pkgPath, "/") || mxutil.HasPrefix(pkgPath, "./") || mxutil.HasPrefix(pkgPath, "../") {
		testPkgDir = pkgPath
	} else {
		testPkgDir = mxutil.JoinPath(root, mxutil.JoinPath("src", pkgPath))
	}

	testFiles := listFiles(testPkgDir, "_test.mx")
	if len(testFiles) == 0 {
		mxutil.WriteStr(2, "no test files found in " | testPkgDir | "\n")
		return
	}

	var allTestFuncs []string
	for _, tf := range testFiles {
		data, ok := mxutil.ReadFile(mxutil.JoinPath(testPkgDir, tf))
		if !ok {
			continue
		}
		funcs := scanTestFuncs(data)
		for _, fn := range funcs {
			allTestFuncs = mxutil.Ensure(allTestFuncs, 1)
			push(allTestFuncs, fn)
		}
	}
	if len(allTestFuncs) == 0 {
		mxutil.WriteStr(2, "no Test* functions found\n")
		return
	}

	mxutil.WriteStr(2, "=== test: " | pkgPath | " ===\n")
	for _, fn := range allTestFuncs {
		mxutil.WriteStr(2, "  found " | fn | "\n")
	}

	pkgName := ""
	for _, tf := range testFiles {
		data, ok := mxutil.ReadFile(mxutil.JoinPath(testPkgDir, tf))
		if ok && pkgName == "" {
			pkgName = extractPkgName(data)
		}
	}
	if pkgName == "" {
		pkgName = "main"
	}

	tmpdir := buildScratchDir("./tmp", "mxc-testbuild")
	mkdirAll(tmpdir, 0755)
	registerScratch(tmpdir)

	testMainSrc := generateTestMain(pkgName, allTestFuncs)
	testMainFile := mxutil.JoinPath(tmpdir, "_testmain.mx")
	writeFile(testMainFile, testMainSrc, 0644)

	pkg := discoverPkg(pkgPath, root)
	if pkg == nil {
		fatal("cannot find package " | pkgPath)
	}

	for _, tf := range testFiles {
		pkg.files = mxutil.Ensure(pkg.files, 1)
		push(pkg.files, tf)
	}
	pkg.files = mxutil.Ensure(pkg.files, 1)
	push(pkg.files, testMainFile)
	// The package under test is linked as main. Record the path a normal build
	// would compile it under before the name is overwritten, so the language
	// restrictions judge this code as the package it came from and not as a
	// fresh user `main` (restrictPath). set before the dispatch index runs:
	// that pass type-checks the package first.
	testPath := pkg.path
	if testPath == "." || testPath == ".." || mxutil.HasPrefix(testPath, "/") || mxutil.HasPrefix(testPath, "./") || mxutil.HasPrefix(testPath, "../") {
		testPath = pkg.name
	}
	bst.testSrcPkgPath = testPath
	pkg.name = "main"

	if !hasImportStr(pkg.imports, "testing") {
		pkg.imports = mxutil.Ensure(pkg.imports, 1)
		push(pkg.imports, "testing")
	}
	// The test files' imports belong to the closure too. A dependency the
	// package itself does not use - bytes, time, fmt in a test - was otherwise
	// never resolved: the type came out invalid, `var b bytes.Buffer` allocated
	// one byte, its method calls were dropped, and the test miscompiled
	// silently until it panicked at "interface dispatch: no impl for Write".
	for _, tf := range testFiles {
		data, dok := mxutil.ReadFile(mxutil.JoinPath(testPkgDir, tf))
		if !dok {
			continue
		}
		for _, imp := range extractImports(data) {
			if hasImportStr(pkg.imports, imp) {
				continue
			}
			pkg.imports = mxutil.Ensure(pkg.imports, 1)
			push(pkg.imports, imp)
		}
	}

	pkgs := resolveTestDeps(pkg, root)

	cacheBase := pkgCacheDir()

	// Every package's cache key carries the link set, because the dispatch arms
	// it emits depend on the closure. A test build has its own closure (the
	// test package as main, testing, the test files' imports), so it has to key
	// the cache separately: without this the test build reused a build's arms
	// and panicked on the first call through an interface -
	// "interface dispatch: no impl for Read" from crypto/rand.
	bst.linkSetKey = linkSetHash(pkgs)

	// A test binary emits dispatch too, so it needs the same index a build
	// gets. The test package itself is type-checked below, under its generated
	// main, and is skipped here.
	prepareDispatchIndex(pkgs, cacheBase, pkg)

	testMxh := ""
	for _, dp := range pkgs {
		compilePath := dp.path
		if compilePath == "." || compilePath == ".." || mxutil.HasPrefix(compilePath, "/") || mxutil.HasPrefix(compilePath, "./") || mxutil.HasPrefix(compilePath, "../") {
			compilePath = dp.name
		}
		if dp == pkg {
			compilePath = "main"
		}
		hash := pkgHash(dp)
		cachedMxh := cachedMxhPath(cacheBase, dp.path, hash, dp.version)
		if mxhOk := mxutil.FileExists(cachedMxh); mxhOk && !forceRebuild && dp != pkg {
			loadMxh(cachedMxh)
			src := concatSources(dp.dir, dp.files)
			ScanGenericDecls(src, compilePath)
		} else {
			var src []byte
			if dp == pkg {
				src = concatTestSources(dp.dir, dp.files, testMainFile)
				// The test package's own methods belong in the dispatch index
				// too: it is compiled as the root, and without its entry every
				// call it makes through an interface looked tier 2 and emitted
				// no arms ("interface dispatch: no impl for Write"). Write its
				// mxh so the same text the index reads exists.
				testMxh = mxutil.JoinPath(tmpdir, "testpkg.mxh")
				TypeCheckOnly(src, compilePath, testMxh)
			} else {
				src = concatSources(dp.dir, dp.files)
				TypeCheckOnly(src, compilePath, "")
			}
		}
	}
	if testMxh != "" {
		if data, tok := mxutil.ReadFile(testMxh); tok {
			d := string(data)
			if cctx.dispMethodsByPkg == nil {
				cctx.dispMethodsByPkg = map[string]map[string]bool{}
			}
			cctx.dispMethodsByPkg[dispPkgKey(pkg)] = dispParseMethods(d)
			dispParseIfaceMethods(d, cctx.dispIfaceMethods)
		}
	}

	var allBcFiles []string
	hasRuntimePkg := false

	for _, dp := range pkgs {
		if dp.path == "runtime" {
			hasRuntimePkg = true
		}
		compilePath := dp.path
		if compilePath == "." || compilePath == ".." || mxutil.HasPrefix(compilePath, "/") || mxutil.HasPrefix(compilePath, "./") || mxutil.HasPrefix(compilePath, "../") {
			compilePath = dp.name
		}
		if dp == pkg {
			compilePath = "main"
		}

		hash := pkgHash(dp)
		cached := cachedBcPath(cacheBase, dp.path, hash, dp.version)
		cachedMxh := cachedMxhPath(cacheBase, dp.path, hash, dp.version)

		if dp != pkg {
			bcOk := mxutil.FileExists(cached)
			mxhOk := mxutil.FileExists(cachedMxh)
			if bcOk && mxhOk && !forceRebuild {
				mxutil.WriteStr(2, "  cached " | dp.path | "\n")
				loadMxh(cachedMxh)
				allBcFiles = mxutil.Ensure(allBcFiles, 1)
				push(allBcFiles, cached)
				for _, cf := range dp.cfiles {
					cPath := mxutil.JoinPath(dp.dir, cf)
					cbcFile := mxutil.JoinPath(tmpdir, safeName(dp.path) | "_" | cf | ".bc")
					crc := run([]string{clang, "--target=" | triple, "-emit-llvm", "-c", cPath, "-o", cbcFile})
					if crc == 0 {
						allBcFiles = mxutil.Ensure(allBcFiles, 1)
						push(allBcFiles, cbcFile)
					}
				}
				for _, bf := range dp.bcfiles {
					allBcFiles = mxutil.Ensure(allBcFiles, 1)
					push(allBcFiles, mxutil.JoinPath(dp.dir, bf))
				}
				continue
			}

			if isStdlib(dp.path) && bcOk && !forceRebuild {
				mxutil.WriteStr(2, "  cached " | dp.path | "\n")
				csrc := concatSources(dp.dir, dp.files)
				cdir := mxutil.JoinPath(cacheBase, safeName(dp.path))
				mkdirAll(cdir, 0755)
				TypeCheckOnly(csrc, compilePath, cachedMxh)
				allBcFiles = mxutil.Ensure(allBcFiles, 1)
				push(allBcFiles, cached)
				continue
			}
		}

		mxutil.WriteStr(2, "  compile " | dp.path | "\n")
		var src []byte
		if dp == pkg {
			src = concatTestSources(dp.dir, dp.files, testMainFile)
		} else {
			src = concatSources(dp.dir, dp.files)
		}
		ir := compileSource(src, compilePath, triple, dp.dir)
		llFile := mxutil.JoinPath(tmpdir, safeName(dp.path) | ".ll")
		writeFile(llFile, []byte(ir), 0644)
		bcFile := mxutil.JoinPath(tmpdir, safeName(dp.path) | ".bc")
		drc := run([]string{clang, "--target=" | triple, "-emit-llvm", "-c", "-Wno-everything", "-Xclang", "-disable-O0-optnone", llFile, "-o", bcFile})
		if drc != 0 {
			fatal("clang failed for " | dp.path)
		}
		mem2regBc(bcFile)
		if dp != pkg {
			cacheDir := mxutil.JoinPath(cacheBase, safeName(dp.path))
			mkdirAll(cacheDir, 0755)
			data, rok := mxutil.ReadFile(bcFile)
			if rok {
				cacheWrite(cached, data)
			}
			if len(cctx.lastMxhData) > 0 {
				cacheWrite(cachedMxh, []byte(cctx.lastMxhData))
				cctx.lastMxhData = ""
			}
		}
		allBcFiles = mxutil.Ensure(allBcFiles, 1)
		push(allBcFiles, bcFile)
		for _, cf := range dp.cfiles {
			cPath := mxutil.JoinPath(dp.dir, cf)
			cbcFile := mxutil.JoinPath(tmpdir, safeName(dp.path) | "_" | cf | ".bc")
			drc = run([]string{clang, "--target=" | triple, "-emit-llvm", "-c", cPath, "-o", cbcFile})
			if drc != 0 {
				fatal("clang failed for " | cf)
			}
			allBcFiles = mxutil.Ensure(allBcFiles, 1)
			push(allBcFiles, cbcFile)
		}
		for _, bf := range dp.bcfiles {
			allBcFiles = mxutil.Ensure(allBcFiles, 1)
			push(allBcFiles, mxutil.JoinPath(dp.dir, bf))
		}
	}

	loadSysroot(mxutil.JoinPath(root, "_sysroot.env"))

	sysroot := mxutil.JoinPath(root, "sysroot")
	runtimeBc := getenv("RUNTIME_BC")
	if runtimeBc == "" {
		runtimeBc = mxutil.JoinPath(sysroot, "runtime.bc")
	}
	muslDir := getenv("MUSL_DIR")
	if muslDir == "" {
		muslDir = mxutil.JoinPath(sysroot, "musl")
	}
	comprtLib := getenv("COMPRT_LIB")
	if comprtLib == "" {
		comprtLib = mxutil.JoinPath(mxutil.JoinPath(sysroot, "compiler-rt"), "lib.a")
	}
	muslLib := getenv("MUSL_LIB")
	if muslLib == "" {
		muslLib = mxutil.JoinPath(mxutil.JoinPath(sysroot, "musl"), "lib.a")
	}

	mxutil.WriteStr(2, "  generate initAll\n")
	// Build a deduped package list with a sorted slice, not a map:
	// the map path is sensitive to hashmap state during bootstrap.
	var syms []string
	var initCalls string
	for _, dp := range pkgs {
		compilePath := dp.path
		if compilePath == "." || compilePath == ".." || mxutil.HasPrefix(compilePath, "/") || mxutil.HasPrefix(compilePath, "./") || mxutil.HasPrefix(compilePath, "../") {
			compilePath = dp.name
		}
		if dp == pkg {
			continue
		}
		initSym := irGlobalSymbol(compilePath, "main")
		syms = mxutil.Ensure(syms, 1)
		push(syms, initSym)
	}
	for si := int32(1); si < int32(len(syms)); si++ {
		for sj := si; sj > 0 && syms[sj] < syms[sj-1]; sj-- {
			syms[sj], syms[sj-1] = syms[sj-1], syms[sj]
		}
	}
	var prevSym string
	for _, sym := range syms {
		if sym == prevSym {
			continue
		}
		prevSym = sym
		initCalls = initCalls | "  call void " | sym | "(ptr null)\n"
	}
	initAllIR := "\ndefine dso_local void @runtime.initAll(ptr %_ctx) {\nentry:\n" | initCalls | "  ret void\n}\n"
	if hasRuntimePkg {
		// Only the source-compiled runtime has a bodyless stacksave();
		// when the prebuilt runtime_go.bc supplies it, skip to avoid a
		// duplicate symbol at link time.
		initAllIR = initAllIR |
			"declare ptr @llvm.stacksave.p0()\n" |
			"define ptr @runtime.stacksave(ptr %_ctx) {\n" |
			"  %1 = call ptr @llvm.stacksave.p0()\n" |
			"  ret ptr %1\n" |
			"}\n"
	}
	declaredPrev := ""
	for _, sym := range syms {
		if sym == declaredPrev {
			continue
		}
		declaredPrev = sym
		initAllIR = initAllIR | "declare void " | sym | "(ptr)\n"
	}
	initAllFile := mxutil.JoinPath(tmpdir, "initall.ll")
	writeFile(initAllFile, []byte(initAllIR), 0644)
	initAllBc := mxutil.JoinPath(tmpdir, "initall.bc")
	rc := run([]string{clang, "--target=" | triple, "-emit-llvm", "-c", initAllFile, "-o", initAllBc})
	if rc != 0 {
		fatal("clang failed for initall")
	}

	mxutil.WriteStr(2, "  compile objects\n")
	var objList []string
	if !hasRuntimePkg {
		runtimeGoBc := ensureRuntimeBake(sysroot, root)
		objList = mxutil.Ensure(objList, 1)
		push(objList, clangCompileToObj(clang, triple, runtimeGoBc))
	}
	if !hasRuntimePkg {
		rtShims := mxutil.JoinPath(sysroot, "rt_shims.bc")
		if _, rsk := mxutil.ReadFile(rtShims); rsk {
			objList = mxutil.Ensure(objList, 1)
			push(objList, clangCompileToObj(clang, triple,rtShims))
		}
	}
	if bst.buildJobs > 1 {
		var objCmds [][]string
		for _, bf := range allBcFiles {
			objCmds = mxutil.Ensure(objCmds, 1)
			push(objCmds, []string{clang, "--target=" | triple,
				"-c", "-O0", "-ffunction-sections", "-fdata-sections", bf, "-o", bf | ".o"})
		}
		if !runPool(objCmds, bst.buildJobs) {
			fatal("clang -c failed")
		}
		for _, bf := range allBcFiles {
			objList = mxutil.Ensure(objList, 1)
			push(objList, bf|".o")
		}
	} else {
		for _, bf := range allBcFiles {
			objList = mxutil.Ensure(objList, 1)
			push(objList, clangCompileToObj(clang, triple,bf))
		}
	}
	objList = mxutil.Ensure(objList, 1)
	push(objList, clangCompileToObj(clang, triple,initAllBc))
	objDir := mxutil.JoinPath(sysroot, "obj")
	objEntries := listFiles(objDir, ".bc")
	if objEntries != nil {
		for _, e := range objEntries {
			objList = mxutil.Ensure(objList, 1)
			push(objList, clangCompileToObj(clang, triple,mxutil.JoinPath(objDir, e)))
		}
	}
	oEntries := listFiles(objDir, ".o")
	if oEntries != nil {
		for _, e := range oEntries {
			objList = mxutil.Ensure(objList, 1)
			push(objList, mxutil.JoinPath(objDir, e))
		}
	}
	outpath := mxutil.JoinPath(tmpdir, "test.bin")
	mxutil.WriteStr(2, "  link\n")
	linker := "ld.lld-22"
	ldArgs := []string{linker, "--gc-sections", "-o", outpath,
		mxutil.JoinPath(muslDir, "crt1.o")}
	for _, o := range objList {
		ldArgs = mxutil.Ensure(ldArgs, 1)
		push(ldArgs, o)
	}
	for _, la := range []string{comprtLib, muslLib, "-z", "stack-size=67108864"} {
		ldArgs = mxutil.Ensure(ldArgs, 1)
		push(ldArgs, la)
	}
	rc = run(ldArgs)
	if rc != 0 {
		fatal("linker failed")
	}

	writeCoverSites(outpath)
	mxutil.WriteStr(2, "  run tests\n")
	rc = run([]string{outpath})
	exitNow(int32(rc))
}

func hasImportStr(imports []string, pkg string) (ok bool) {
	for _, imp := range imports {
		if imp == pkg {
			return true
		}
	}
	return false
}

func resolveTestDeps(testPkg *pkgInfo, root string) (ss []*pkgInfo) {
	r := &resolver{
		visited: map[string]bool{},
		root:    root,
	}
	for _, imp := range testPkg.imports {
		r.walk(imp)
	}
	r.order = mxutil.Ensure(r.order, 1)
	push(r.order, testPkg)
	return r.order
}

// renamePkgMain renames a top-level `func main(` declaration to
// `func __moxie_pkg_main(`. A test build must have exactly one main - the
// generated test runner's - and the package under test is entitled to one of
// its own: a command-line tool does. Only a line that begins with the
// declaration is touched, so a mention in a comment or an expression is left
// alone.
func renamePkgMain(src string) (out string) {
	lines := mxutil.SplitLines(src)
	changed := false
	for i, line := range lines {
		trimmed := mxutil.TrimSpace(line)
		if mxutil.HasPrefix(trimmed, "func main(") {
			lines[i] = "func __moxie_pkg_main(" | trimmed[int32(len("func main(")):]
			changed = true
		}
	}
	if !changed {
		return src
	}
	return joinStrings(lines, "\n")
}

func concatTestSources(dir string, files []string, testMainFile string) (buf []byte) {
	imports := map[string]bool{}
	var bodies [][]byte
	var bodyFiles []string
	var bodyStartLines []int32
	var bodyImports [][]string
	pkgName := "main"

	allFiles := []string{:0:len(files) + 1}
	for _, f := range files {
		if f == testMainFile {
			continue
		}
		allFiles = mxutil.Ensure(allFiles, 1)
		push(allFiles, f)
	}

	for _, f := range allFiles {
		var data []byte
		var ok bool
		if mxutil.HasPrefix(f, "/") {
			data, ok = mxutil.ReadFile(f)
		} else {
			data, ok = mxutil.ReadFile(mxutil.JoinPath(dir, f))
		}
		if !ok {
			continue
		}
		lines := mxutil.SplitLines(string(data))
		var body []string
		var fimps []string
		i := int32(0)
		firstBodyLine := int32(0)
		for i < int32(len(lines)) {
			line := mxutil.TrimSpace(lines[i])
			if mxutil.HasPrefix(line, "package ") {
				i++
				continue
			}
			if line == "import (" {
				i++
				for i < int32(len(lines)) {
					imp := mxutil.TrimSpace(lines[i])
					i++
					if imp == ")" {
						break
					}
					if imp != "" {
						imports[imp] = true
						fimps = mxutil.Ensure(fimps, 1)
						push(fimps, imp)
					}
				}
				continue
			}
			if mxutil.HasPrefix(line, "import ") && !mxutil.HasPrefix(line, "import (") {
				imp := line[7:]
				imports[imp] = true
				fimps = mxutil.Ensure(fimps, 1)
				push(fimps, imp)
				i++
				continue
			}
			if len(body) == 0 {
				firstBodyLine = i + 1
			}
			body = mxutil.Ensure(body, 1)
			push(body, lines[i])
			i++
		}
		bodies = mxutil.Ensure(bodies, 1)
		push(bodies, []byte(renamePkgMain(joinStrings(body, "\n"))))
		bodyFiles = mxutil.Ensure(bodyFiles, 1)
		push(bodyFiles, f)
		bodyStartLines = mxutil.Ensure(bodyStartLines, 1)
		push(bodyStartLines, firstBodyLine)
		bodyImports = mxutil.Ensure(bodyImports, 1)
		push(bodyImports, fimps)
	}

	tmData, tmOk := mxutil.ReadFile(testMainFile)
	if tmOk {
		lines := mxutil.SplitLines(string(tmData))
		var body []string
		var fimps []string
		i := int32(0)
		firstBodyLine := int32(0)
		for i < int32(len(lines)) {
			line := mxutil.TrimSpace(lines[i])
			if mxutil.HasPrefix(line, "package ") {
				i++
				continue
			}
			if line == "import (" {
				i++
				for i < int32(len(lines)) {
					imp := mxutil.TrimSpace(lines[i])
					i++
					if imp == ")" {
						break
					}
					if imp != "" {
						imports[imp] = true
						fimps = mxutil.Ensure(fimps, 1)
						push(fimps, imp)
					}
				}
				continue
			}
			if mxutil.HasPrefix(line, "import ") && !mxutil.HasPrefix(line, "import (") {
				imp := line[7:]
				imports[imp] = true
				fimps = mxutil.Ensure(fimps, 1)
				push(fimps, imp)
				i++
				continue
			}
			if len(body) == 0 {
				firstBodyLine = i + 1
			}
			body = mxutil.Ensure(body, 1)
			push(body, lines[i])
			i++
		}
		bodies = mxutil.Ensure(bodies, 1)
		push(bodies, []byte(joinStrings(body, "\n")))
		bodyFiles = mxutil.Ensure(bodyFiles, 1)
		push(bodyFiles, "_testmain.mx")
		bodyStartLines = mxutil.Ensure(bodyStartLines, 1)
		push(bodyStartLines, firstBodyLine)
		bodyImports = mxutil.Ensure(bodyImports, 1)
		push(bodyImports, fimps)
	}

	var out []byte
	out = out | ("package " | pkgName | "\n")
	if len(imports) > 0 {
		impKeys := []string{:0:len(imports)}
		for imp := range imports {
			impKeys = mxutil.Ensure(impKeys, 1)
			push(impKeys, imp)
		}
		for i := int32(1); i < int32(len(impKeys)); i++ {
			for j := i; j > 0 && impKeys[j] < impKeys[j-1]; j-- {
				impKeys[j], impKeys[j-1] = impKeys[j-1], impKeys[j]
			}
		}
		out = out | "import (\n"
		for _, imp := range impKeys {
			out = out | "\t" | imp | "\n"
		}
		out = out | ")\n"
	}
	cctx.concatSourceMap = nil
	mxutil.ResetConcatImportSegs()
	outLine := int32(1)
	for j := int32(0); j < int32(len(out)); j++ {
		if out[j] == '\n' {
			outLine++
		}
	}
	for i, b := range bodies {
		cctx.concatSourceMap = mxutil.Ensure(cctx.concatSourceMap, 1)
		push(cctx.concatSourceMap, srcSpan{
			file:     bodyFiles[i],
			outStart: outLine,
			srcLine:  bodyStartLines[i],
		})
		mxutil.AppendConcatImportSeg(mxutil.ImportSeg{
			OutStart: outLine,
			Specs:    bodyImports[i],
		})
		for j := int32(0); j < int32(len(b)); j++ {
			if b[j] == '\n' {
				outLine++
			}
		}
		outLine++
		out = out | b
		out = mxutil.Ensure(out, 1)
		push(out, '\n')
		bodies[i] = nil
	}
	bodies = nil
	imports = nil
	return out
}

// resolveTargetFlag scans argv for -target and applies it. It must run before
// the type universe is built: uintptr is sized from TargetArch, so a universe
// built before the target is known bakes 64-bit pointers into every builtin
// type, and a wasm32 build then emits 64-bit signatures for the runtime while
// packages (whose widths come from explicit source types) are 32-bit.
func resolveTargetFlag(args []string) {
	for i := int32(2); i < int32(len(args)); i++ {
		if args[i] == "-target" && i+1 < int32(len(args)) {
			applyTargetFlag(args[i+1])
			return
		}
	}
	applyTargetFlag("")
}

func applyTargetFlag(flag string) {
	mxutil.SetTarget("linux", "amd64")
	if flag == "js/wasm" || flag == "wasm" {
		mxutil.SetTarget("js", "wasm")
	} else if flag == "wasi/wasm" {
		mxutil.SetTarget("wasi", "wasm")
	}
}

// prepareDispatchIndex writes every package's mxh, then fills the dispatch
// index from those files. Both halves matter: the index is what findIfaceImpls
// consults to skip packages that cannot implement the method being dispatched,
// and it is read from the mxh files, so a build that reads the index before
// the files exist indexes nothing, skips nothing, and emits an arm for every
// type in the registry - the same sources then produce different .text
// depending only on cache state (measured on the smesh relay: 12,352 bytes
// across 52 functions). Every build that emits dispatch needs it; a test
// binary built without it took every package for tier 2 and panicked the first
// time a test called through an interface: "interface dispatch: no impl for
// Write". skip is the root package a caller type-checks itself (the test
// package, under its generated main), nil otherwise.
func prepareDispatchIndex(pkgs []*pkgInfo, cacheBase string, skip *pkgInfo) {
	for _, pkg := range pkgs {
		if pkg.baked || pkg == skip {
			continue
		}
		compilePath := pkg.path
		if compilePath == "." || compilePath == ".." || mxutil.HasPrefix(compilePath, "/") || mxutil.HasPrefix(compilePath, "./") || mxutil.HasPrefix(compilePath, "../") {
			compilePath = pkg.name
		}
		hash := pkgHash(pkg)
		cachedMxh := cachedMxhPath(cacheBase, pkg.path, hash, pkg.version)
		if mxutil.FileExists(cachedMxh) {
			// Load the cached mxh, do not merely skip it. Packages are in
			// dependency order, and a later package whose mxh is missing is
			// type-checked below. Skipping its cached imports left them out of
			// the registry, so a type they declare (`*event.E` in a store
			// method signature) resolved to nil, generateMxh wrote `__any` for
			// it, and that poisoned mxh was registered. mxhLoaded then made the
			// correct mxh from the compile pass a no-op, so every caller saw
			// `{ i64, ptr }` where a pointer belonged and clang rejected the
			// IR: `%t73 defined with type '{ i64, ptr }' but expected 'ptr'`.
			loadMxh(cachedMxh)
			continue
		}
		typeCheckPkgSource(cacheBase, pkg.dir, pkg.files, pkg.path, compilePath, cachedMxh)
	}
	cctx.dispIfaceMethods = map[string]bool{}
	if cctx.dispMethodsByPkg == nil {
		cctx.dispMethodsByPkg = map[string]map[string]bool{}
	}
	for _, ipkg := range pkgs {
		if ipkg.baked || ipkg == skip {
			continue
		}
		ihash := pkgHash(ipkg)
		if data, ok := mxutil.ReadFile(cachedMxhPath(cacheBase, ipkg.path, ihash, ipkg.version)); ok {
			d := string(data)
			cctx.dispMethodsByPkg[dispPkgKey(ipkg)] = dispParseMethods(d)
			dispParseIfaceMethods(d, cctx.dispIfaceMethods)
		}
	}
}

func main() {
	// Root arena is the domain root's arena, set up by the runtime.
	// 2GB virtual - pages committed on touch by the MMU.
	initCompileCtx()
	// The target must be known before InitUniverse: uintptr's width depends
	// on it, and InitUniverse builds the type table once per process.
	resolveTargetFlag(os.Args)
	cctx.universe = InitUniverse()
	SetUniverseGlobals(cctx.universe)
	initBuildState()
	// Scratch directories die on completion, from the SIGINT handler, and from
	// exitNow on the paths that need an exit status.
	defer cleanupScratch()
	cInstallInterruptHandler()
	bst.buildJobs = adaptiveJobs()
	if mxutil.TargetArch() == "wasm" {
		// wasm32 has no fork, no threads and no worker fds, so the
		// compiler's parallel package pipeline cannot exist there. Force the
		// serial path rather than letting it reference the worker IPC.
		bst.buildJobs = 1
	}
	bst.wasmRtPkgs = map[string]bool{
		"runtime": true, "runtime/interrupt": true,
		"internal/task": true, "internal/itoa": true,
		"math": true, "math/bits": true,
		"unicode/utf8": true, "strconv": true,
		"errors": true, "io": true, "io/fs": true,
		"os": true, "syscall": true, "time": true,
		"fmt": true, "path": true,
		"internal/bytealg": true, "internal/byteorder": true,
		"internal/goarch": true, "internal/binary": true,
		"internal/gclayout": true, "internal/oserror": true,
		"internal/stringslite": true, "internal/testlog": true,
	}
	bst.builtinOnly = []string{"unsafe"}
	args := os.Args
	if len(args) < 2 {
		mxutil.WriteStr(2, "usage: mxc <build|test|version|cache|fetch|update> ...\n")
		exitNow(1)
	}

	cmd := args[1]
	if cmd == "version" {
		mxutil.WriteStr(1, "mxc " | mxcVersion() | " (" | compilerHash() | ")\n")
		return
	}
	if cmd == "help" {
		printHelp()
		return
	}
	if cmd == "env" {
		printEnv()
		return
	}
	if cmd == "dispindex" {
		cmdDispIndex()
		return
	}
	if cmd == "targets" {
		printTargets()
		return
	}
	if cmd == "info" {
		printInfo()
		return
	}
	if cmd == "list" {
		cmdList()
		return
	}
	if cmd == "clean" {
		cacheRoot := mxutil.JoinPath(getMoxiePath(), "cache")
		mxutil.WriteStr(2, "cleaning cache: " | cacheRoot | "\n")
		removeAll(cacheRoot)
		mxutil.WriteStr(2, "  done\n")
		return
	}
	if cmd == "vendor" {
		cmdVendor()
		return
	}
	if cmd == "header" {
		pkgName := ""
		outdir := "."
		ai := int32(2)
		for ai < int32(len(args)) {
			if args[ai] == "-o" && ai+1 < int32(len(args)) {
				outdir = args[ai+1]
				ai = ai + 2
				continue
			}
			if pkgName == "" {
				pkgName = args[ai]
			}
			ai++
		}
		cmdHeader(pkgName, outdir)
		return
	}
	if cmd == "install" {
		if len(args) < 3 {
			mxutil.WriteStr(2, "usage: mxc install <package>\n")
			exitNow(1)
		}
		cmdInstall(args[2])
		return
	}
	if cmd == "cache" {
		if len(args) >= 3 && args[2] == "clean" {
			cacheClean()
			return
		}
		if len(args) >= 3 && args[2] == "warm" {
			cmdCacheWarm()
			return
		}
		mxutil.WriteStr(2, "usage: mxc cache <clean|warm>\n")
		exitNow(1)
	}
	if cmd == "fetch" {
		fetchURL := ""
		if len(args) >= 3 {
			fetchURL = args[2]
		}
		cmdFetch(fetchURL)
		return
	}
	if cmd == "update" {
		rebuildAll := false
		for ai := int32(2); ai < int32(len(args)); ai++ {
			if args[ai] == "--all" {
				rebuildAll = true
			}
		}
		cmdUpdate(rebuildAll)
		return
	}
	if cmd == "test" {
		cmdTest(args)
		return
	}
	if cmd == "build-runtime" {
		cmdBuildRuntime()
		return
	}
	if cmd != "build" && cmd != "run" {
		mxutil.WriteStr(2, "usage: mxc <build|run|test|version|cache|fetch|update|build-runtime> ...\n")
		exitNow(1)
	}
	runAfter := cmd == "run"

	outpath := ""
	var runArgs []string
	pkgPath := ""
	printIR := false
	forceRebuild := false
	targetFlag := ""
	buildMode := ""
	i := int32(2)
	for i < int32(len(args)) {
		if args[i] == "-o" {
			if i+1 >= int32(len(args)) {
				fatal("flag needs an argument: -o")
			}
			outpath = args[i+1]
			i += 2
		} else if args[i] == "-target" {
			if i+1 >= int32(len(args)) {
				fatal("flag needs an argument: -target")
			}
			targetFlag = args[i+1]
			i += 2
		} else if args[i] == "-print-ir" {
			printIR = true
			i++
		} else if args[i] == "-a" {
			forceRebuild = true
			i++
		} else if args[i] == "-j" {
			if i+1 >= int32(len(args)) {
				fatal("flag needs an argument: -j")
			}
			bst.buildJobs = parseInt32(args[i+1])
			if bst.buildJobs < 1 {
				bst.buildJobs = 1
			}
			i += 2
		} else if args[i] == "-tags" {
			if i+1 >= int32(len(args)) {
				fatal("flag needs an argument: -tags")
			}
			appendBuildTags(args[i+1])
			i += 2
		} else if args[i] == "-print-allocs" {
			if i+1 >= int32(len(args)) {
				fatal("flag needs an argument: -print-allocs")
			}
			setPrintAllocs(args[i+1])
			i += 2
		} else if args[i] == "-cover" {
			enableCover()
			i++
		} else if args[i] == "-allow-closure-captures" {
			setAllowCaptures()
			i++
		} else if args[i] == "-buildmode" {
			if i+1 >= int32(len(args)) {
				fatal("flag needs an argument: -buildmode")
			}
			buildMode = args[i+1]
			i += 2
		} else if mxutil.HasPrefix(args[i], "-buildmode=") {
			buildMode = args[i][int32(len("-buildmode=")):]
			i++
		} else if args[i] == "-x" {
			bst.printCommands = true
			i++
		} else if args[i] == "-work" {
			bst.keepWork = true
			i++
		} else if mxutil.HasPrefix(args[i], "-") && pkgPath == "" {
			// Never drop a flag this compiler does not implement: building
			// something other than what was asked is worse than failing.
			fatal("flag provided but not defined: " | args[i])
		} else if pkgPath == "" {
			pkgPath = args[i]
			i++
		} else {
			runArgs = mxutil.Ensure(runArgs, 1)
			push(runArgs, args[i])
			i++
		}
	}
	if printIR {
		// -print-ir needs the in-process compile path.
		bst.buildJobs = 1
	}
	if buildMode != "" && buildMode != "default" {
		if buildMode != "c-shared" {
			fatal("invalid buildmode option '" | buildMode | "': valid values are default, c-shared")
		}
		// Legacy implements c-shared by building PIC libc, compiler-rt and
		// runtime objects, which this compiler has no path to produce.
		fatal("buildmode c-shared is not implemented by this compiler; only the legacy bootstrap compiler builds shared libraries")
	}
	if mxutil.AllocSitesEnabled() || bst.cover {
		// The site table is built while packages are emitted, so a package
		// taken from the build cache would be missing from it.
		forceRebuild = true
	}
	if pkgPath == "" {
		fatal("no package specified")
	}
	if outpath == "" {
		outpath = pathBase(pkgPath)
	}

	root := moxieRoot()
	applyTargetFlag(targetFlag)
	triple := "x86_64-unknown-linux-musleabihf"
	if mxutil.TargetArch() == "wasm" {
		triple = "wasm32-unknown-wasi"
	}
	isWasm := mxutil.TargetArch() == "wasm"
	clang := "clang-22"

	// A target that names a directory on disk (./pkg, ../pkg, /abs/pkg, or
	// a bare relative dir like pkg) is resolved through the module root; an
	// import path like "fmt" is not. Missing this leaves globalModDir empty
	// and module-internal imports unresolvable.
	if isDirPath(pkgPath) {
		ensureModuleRoot(pkgPath)
	}

	registerBuiltins()
	pkgs := resolveAll(pkgPath, root)
	bst.linkSetKey = linkSetHash(pkgs)
	// Drop duplicate package paths, keeping the resolver's order.
	{
		var deduped []*pkgInfo
		deduped = []*pkgInfo{:0:len(pkgs)}
		var prev string
		for _, p := range pkgs {
			if p.path == prev {
				continue
			}
			prev = p.path
			deduped = mxutil.Ensure(deduped, 1)
			push(deduped, p)
		}
		pkgs = deduped
	}
	cacheBase := pkgCacheDir()
	// wasm: runtime must be compiled from source (no prebuilt runtime.bc)
	if isWasm {
		hasRT := false
		for _, p := range pkgs {
			if p.path == "runtime" {
				hasRT = true
				break
			}
		}
		if !hasRT {
			rtPkgs := resolveAll("runtime", root)
			// prepend runtime deps before user packages
			var merged []*pkgInfo
			seen := map[string]bool{}
			for _, p := range rtPkgs {
				if !seen[p.path] {
					seen[p.path] = true
					merged = mxutil.Ensure(merged, 1)
					push(merged, p)
				}
			}
			for _, p := range pkgs {
				if !seen[p.path] {
					seen[p.path] = true
					merged = mxutil.Ensure(merged, 1)
					push(merged, p)
				}
			}
			pkgs = merged
		}
	} else {
		// Native path: packages baked into sysroot/runtime_go.bc (the
		// runtime's full dependency closure) must not be compiled again -
		// their symbols come from the bake at link time. Only when the app
		// closure does NOT include the runtime (otherwise everything
		// compiles from source and the bake is not linked at all). The
		// baked packages still get TypeCheckOnly so their mxh exports land
		// in the cache (the type accumulator) - parallel workers load them
		// via workerLoadDeps exactly like any other dependency, so a worker
		// resolving chan moxie.X finds the type even though moxie's symbols
		// come from the bake.
		hasRT := false
		for _, p := range pkgs {
			if p.path == "runtime" {
				hasRT = true
				break
			}
		}
		if !hasRT {
			baked := map[string]bool{}
			for _, rp := range []string{"internal/task", "runtime"} {
				for _, bp := range resolveAll(rp, root) {
					baked[bp.path] = true
				}
			}
			var filtered []*pkgInfo
			for _, p := range pkgs {
				if baked[p.path] {
					mxutil.WriteStr(2, "  baked " | p.path | "\n")
					compilePath := p.path
					if compilePath == "." || compilePath == ".." || mxutil.HasPrefix(compilePath, "/") || mxutil.HasPrefix(compilePath, "./") || mxutil.HasPrefix(compilePath, "../") {
						compilePath = p.name
					}
					src := concatSources(p.dir, p.files)
					hash := pkgHash(p)
					cachedMxh := cachedMxhPath(cacheBase, p.path, hash, p.version)
					cdir := mxutil.JoinPath(cacheBase, safeName(p.path))
					mkdirAll(cdir, 0755)
					TypeCheckOnly(src, compilePath, cachedMxh)
					p.baked = true
					filtered = mxutil.Ensure(filtered, 1)
					push(filtered, p)
					continue
				}
				filtered = mxutil.Ensure(filtered, 1)
				push(filtered, p)
			}
			pkgs = filtered
		}
	}
	if len(pkgs) == 0 {
		fatal("no packages to compile")
	}

	tmpdir := buildScratchDir("./tmp", "mxc-build")
	mkdirAll(tmpdir, 0755)
	registerScratch(tmpdir)

	// TLS probe: if this binary's globals aren't thread_local, the parallel
	// path would corrupt shared state. Fall back to serial.
	if bst.buildJobs > 1 && cDetectTLS() == 0 {
		mxutil.WriteStr(2, "  note: globals not TLS-isolated, forcing -j 1 (rebuild with self-compiled mxc for parallel)\n")
		bst.tlsFailed = true
		bst.buildJobs = 1
	}
	// The dispatch index must be complete before anything is emitted: see
	// prepareDispatchIndex.
	prepareDispatchIndex(pkgs, cacheBase, nil)

	// Whole-link registry pre-pass: interface dispatch emits a typeID switch
	// over impls found in cctx.universe.Registry, which is populated in
	// dependency order. A type defined in a downstream package (main) passed
	// into an upstream package's interface param was invisible to the
	// upstream dispatch, which silently called a wrong impl (or hit "no
	// impl"). Typecheck every package in the closure into the registry and
	// write every mxh to the cache before the first emission, so dispatch
	// enumerates the whole link set: serial emission reads the accumulated
	// registry directly, workers load every mxh at startup.
	byPathAll := map[string]*pkgInfo{}
	for _, p := range pkgs {
		byPathAll[p.path] = p
		byPathAll[dispPkgKey(p)] = p
	}
	importsLoaded := map[string]bool{}
	for _, pkg := range pkgs {
		if pkg.baked {
			continue
		}
		compilePath := pkg.path
		if compilePath == "." || compilePath == ".." || mxutil.HasPrefix(compilePath, "/") || mxutil.HasPrefix(compilePath, "./") || mxutil.HasPrefix(compilePath, "../") {
			compilePath = pkg.name
		}
		hash := pkgHash(pkg)
		cachedMxh := cachedMxhPath(cacheBase, pkg.path, hash, pkg.version)
		if mxutil.FileExists(cachedMxh) && !forceRebuild {
			if !tier1(dispPkgKey(pkg), cctx.dispIfaceMethods, cctx.dispMethodsByPkg) {
				// Tier 2 AND already cached: no dispatch can reach it, its mxh
				// is on disk, and the compile loop materialises it lazily into a
				// relessable arena. A package that must be COMPILED still runs
				// TypeCheckOnly below, because a later compile can need its
				// declarations through a path that is not a direct import -
				// mangleGenericName is that path, and skipping it broke the
				// self-host twice.
				continue
			}
			// Record the package's declared methods while its mxh is being
			// read anyway: this is the index findIfaceImpls consults to skip
			// packages that cannot implement the method being dispatched.
			if data, dok := mxutil.ReadFile(cachedMxh); dok {
				// Load this package's direct imports first. A descriptor names
				// types from their packages, and an unresolved qualifier
				// degrades to int32: crypto's `method Hash New ->hash.Hash`
				// became crypto.Hash (int32) because hash was skipped here as
				// tier 2, and every importer then declared an i32 return
				// (LLVM: extractvalue {i64, ptr} on i32).
				for _, imp := range pkg.imports {
					ip := byPathAll[imp]
					if ip == nil || ip.baked || importsLoaded[imp] {
						continue
					}
					importsLoaded[imp] = true
					ih := pkgHash(ip)
					if idata, iok := mxutil.ReadFile(cachedMxhPath(cacheBase, ip.path, ih, ip.version)); iok {
						loadMxhData(idata)
					}
				}
				if cctx.dispMethodsByPkg == nil {
					cctx.dispMethodsByPkg = map[string]map[string]bool{}
				}
				cctx.dispMethodsByPkg[dispPkgKey(pkg)] = dispParseMethods(string(data))
				loadMxhData(data)
			}
			continue
		}
		typeCheckPkgSource(cacheBase, pkg.dir, pkg.files, pkg.path, compilePath, cachedMxh)
	}
	var allBcFiles []string
	var hasRuntimePkg bool
	if bst.buildJobs > 1 {
		a, h := buildPkgsParallel(pkgs, triple, clang, tmpdir, cacheBase, forceRebuild, bst.buildJobs)
		allBcFiles = a
		hasRuntimePkg = h
	} else {
		a, h := buildPkgsSerial(pkgs, triple, clang, tmpdir, cacheBase, forceRebuild, printIR)
		allBcFiles = a
		hasRuntimePkg = h
	}
	// Link order is the resolver's order, which depends only on the package
	// set. Sorting these paths instead mixed two path spaces - a .bc read
	// from the cache against one compiled into the scratch dir - and the
	// linker lays sections out in input order, so a cold and a warm build of
	// the same program differed in section order and padding.

	// Assemble per-package .s/.S files for the current target.
	// The runtime and internal/runtime/syscall assembly is prebuilt in
	// sysroot/obj - assembling it again would duplicate symbols.
	var asmObjs []string
	for _, dp := range pkgs {
		if dp.path == "runtime" || dp.path == "internal/runtime/syscall" {
			continue
		}
		for _, af := range collectAsmFiles(dp.dir) {
			aPath := mxutil.JoinPath(dp.dir, af)
			aoFile := mxutil.JoinPath(tmpdir, safeName(dp.path) | "_" | af | ".o")
			arc := run([]string{clang, "--target=" | triple, "-c", aPath, "-o", aoFile})
			if arc == 0 {
				asmObjs = mxutil.Ensure(asmObjs, 1)
				push(asmObjs, aoFile)
			}
		}
	}
	for mi := int32(1); mi < int32(len(asmObjs)); mi++ {
		for mj := mi; mj > 0 && asmObjs[mj] < asmObjs[mj-1]; mj-- {
			asmObjs[mj], asmObjs[mj-1] = asmObjs[mj-1], asmObjs[mj]
		}
	}
	loadSysroot(mxutil.JoinPath(root, "_sysroot.env"))

	sysroot := mxutil.JoinPath(root, "sysroot")
	runtimeBc := ""
	muslDir := ""
	comprtLib := ""
	muslLib := ""
	if !isWasm {
		runtimeBc = getenv("RUNTIME_BC")
		if runtimeBc == "" {
			runtimeBc = mxutil.JoinPath(sysroot, "runtime.bc")
		}
		muslDir = getenv("MUSL_DIR")
		if muslDir == "" {
			muslDir = mxutil.JoinPath(sysroot, "musl")
		}
		comprtLib = getenv("COMPRT_LIB")
		if comprtLib == "" {
			comprtLib = mxutil.JoinPath(mxutil.JoinPath(sysroot, "compiler-rt"), "lib.a")
		}
		muslLib = getenv("MUSL_LIB")
		if muslLib == "" {
			muslLib = mxutil.JoinPath(mxutil.JoinPath(sysroot, "musl"), "lib.a")
		}
	}

	mxutil.WriteStr(2, "  generate initAll\n")
	// Build a deduped package list with a sorted slice, not a map:
	// the map path is sensitive to hashmap state during bootstrap.
	var syms []string
	for _, pkg := range pkgs {
		compilePath := pkg.path
		if compilePath == "." || compilePath == ".." || mxutil.HasPrefix(compilePath, "/") || mxutil.HasPrefix(compilePath, "./") || mxutil.HasPrefix(compilePath, "../") {
			compilePath = pkg.name
		}
		if compilePath == "main" {
			continue
		}
		initSym := irGlobalSymbol(compilePath, "main")
		syms = mxutil.Ensure(syms, 1)
		push(syms, initSym)
	}
	for ti := int32(1); ti < int32(len(syms)); ti++ {
		for tj := ti; tj > 0 && syms[tj] < syms[tj-1]; tj-- {
			syms[tj], syms[tj-1] = syms[tj-1], syms[tj]
		}
	}
	var initCalls string
	var prevSym string
	for _, sym := range syms {
		if sym == prevSym {
			continue
		}
		prevSym = sym
		initCalls = initCalls | "  call void " | sym | "(ptr null)\n"
	}
	initAllIR := "\ndefine dso_local void @runtime.initAll(ptr %_ctx) {\nentry:\n" | initCalls | "  ret void\n}\n"
	if hasRuntimePkg {
		// Only the source-compiled runtime has a bodyless stacksave();
		// when the prebuilt runtime_go.bc supplies it, skip to avoid a
		// duplicate symbol at link time.
		initAllIR = initAllIR |
			"declare ptr @llvm.stacksave.p0()\n" |
			"define ptr @runtime.stacksave(ptr %_ctx) {\n" |
			"  %1 = call ptr @llvm.stacksave.p0()\n" |
			"  ret ptr %1\n" |
			"}\n"
	}
	declaredPrev := ""
	for _, sym := range syms {
		if sym == declaredPrev {
			continue
		}
		declaredPrev = sym
		initAllIR = initAllIR | "declare void " | sym | "(ptr)\n"
	}
	initAllFile := mxutil.JoinPath(tmpdir, "initall.ll")
	writeFile(initAllFile, []byte(initAllIR), 0644)
	initAllBc := mxutil.JoinPath(tmpdir, "initall.bc")
	rc := run([]string{clang, "--target=" | triple, "-emit-llvm", "-c", initAllFile, "-o", initAllBc})
	if rc != 0 {
		fatal("clang failed for initall")
	}

	if isWasm {
		// wasm: compile each .bc to .o individually, then wasm-ld
		mxutil.WriteStr(2, "  compile objects\n")
		wasmTriple := "wasm32-unknown-wasi"
		var objList []string
		if bst.buildJobs > 1 {
			var objCmds [][]string
			for _, bf := range allBcFiles {
				objCmds = mxutil.Ensure(objCmds, 1)
				push(objCmds, []string{clang, "--target=" | wasmTriple,
					"-c", bf, "-o", bf | ".o"})
			}
			if !runPool(objCmds, bst.buildJobs) {
				fatal("clang -c failed")
			}
			for _, bf := range allBcFiles {
				objList = mxutil.Ensure(objList, 1)
				push(objList, bf|".o")
			}
		} else {
			for _, bf := range allBcFiles {
				objList = mxutil.Ensure(objList, 1)
				push(objList, clangCompileToObj(clang, wasmTriple,bf))
			}
		}
		objList = mxutil.Ensure(objList, 1)
		push(objList, clangCompileToObj(clang, wasmTriple,initAllBc))
		// Stubs for symbols not provided by stage4-compiled runtime
		wasiStubs := mxutil.JoinPath(tmpdir, "wasi_stubs.ll")
		writeFile(wasiStubs, []byte(
			"target datalayout = \"e-m:e-p:32:32-p10:8:8-p20:8:8-i64:64-n32:64-S128-ni:1:10:20\"\n" |
			"target triple = \"wasm32-unknown-wasi\"\n" |
			"declare ptr @llvm.stacksave.p0()\n" |
			"define ptr @runtime.stacksave(ptr %_ctx) {\n" |
			"  %1 = call ptr @llvm.stacksave.p0()\n" |
			"  ret ptr %1\n" |
			"}\n" |
			"define void @moxie_longjmp(ptr %0, ptr %1) {\n" |
			"  call void @llvm.trap()\n" |
			"  unreachable\n" |
			"}\n" |
			"define i32 @\"time.timezoneOffsetMinutes\"(ptr %_ctx) {\n" |
			"  ret i32 0\n" |
			"}\n" |
			"declare ptr @runtime.alloc(i32, ptr, ptr)\n" |
			"define ptr @malloc(i32 %size, ptr %_ctx) {\n" |
			"  %p = call ptr @runtime.alloc(i32 %size, ptr null, ptr null)\n" |
			"  ret ptr %p\n" |
			"}\n" |
			"define i32 @strlen(ptr %s, ptr %_ctx) {\n" |
			"entry:\n" |
			"  br label %loop\n" |
			"loop:\n" |
			"  %i = phi i32 [0, %entry], [%i1, %next]\n" |
			"  %cp = getelementptr i8, ptr %s, i32 %i\n" |
			"  %c = load i8, ptr %cp\n" |
			"  %z = icmp eq i8 %c, 0\n" |
			"  br i1 %z, label %done, label %next\n" |
			"next:\n" |
			"  %i1 = add i32 %i, 1\n" |
			"  br label %loop\n" |
			"done:\n" |
			"  ret i32 %i\n" |
			"}\n" |
			"declare void @llvm.trap()\n"), 0644)
		objList = mxutil.Ensure(objList, 1)
		push(objList, clangCompileToObj(clang, wasmTriple,wasiStubs))
		mxutil.WriteStr(2, "  link\n")
		ldArgs := []string{"wasm-ld", "--export-dynamic", "--allow-undefined",
			"--gc-sections", "-o", outpath}
		for _, o := range objList {
			ldArgs = mxutil.Ensure(ldArgs, 1)
			push(ldArgs, o)
		}
		for _, la := range []string{"-z", "stack-size=67108864"} {
			ldArgs = mxutil.Ensure(ldArgs, 1)
			push(ldArgs, la)
		}
		rc = run(ldArgs)
		if rc != 0 {
			fatal("linker failed")
		}
	} else {
		// native: compile each .bc to .o, then ld.lld
		mxutil.WriteStr(2, "  compile objects\n")
		var objList []string
		if !hasRuntimePkg {
			runtimeGoBc := ensureRuntimeBake(sysroot, root)
			objList = mxutil.Ensure(objList, 1)
			push(objList, clangCompileToObj(clang, triple, runtimeGoBc))
		}
		rtShims := mxutil.JoinPath(sysroot, "rt_shims.bc")
		if _, rsk := mxutil.ReadFile(rtShims); rsk {
			objList = mxutil.Ensure(objList, 1)
			push(objList, clangCompileToObj(clang, triple,rtShims))
		}
		if bst.buildJobs > 1 {
			var objCmds [][]string
			for _, bf := range allBcFiles {
				objCmds = mxutil.Ensure(objCmds, 1)
				push(objCmds, []string{clang, "--target=" | triple,
					"-c", "-O0", "-ffunction-sections", "-fdata-sections", bf, "-o", bf | ".o"})
			}
			if !runPool(objCmds, bst.buildJobs) {
				fatal("clang -c failed")
			}
			for _, bf := range allBcFiles {
				objList = mxutil.Ensure(objList, 1)
				push(objList, bf|".o")
			}
		} else {
			for _, bf := range allBcFiles {
				objList = mxutil.Ensure(objList, 1)
				push(objList, clangCompileToObj(clang, triple,bf))
			}
		}
		objList = mxutil.Ensure(objList, 1)
		push(objList, clangCompileToObj(clang, triple,initAllBc))
		objDir := mxutil.JoinPath(sysroot, "obj")
		objEntries := listFiles(objDir, ".bc")
		if objEntries != nil {
			for _, e := range objEntries {
				objList = mxutil.Ensure(objList, 1)
				push(objList, clangCompileToObj(clang, triple,mxutil.JoinPath(objDir, e)))
			}
		}
		oEntries := listFiles(objDir, ".o")
		if oEntries != nil {
			for _, e := range oEntries {
				objList = mxutil.Ensure(objList, 1)
				push(objList, mxutil.JoinPath(objDir, e))
			}
		}
		for _, ao := range asmObjs {
			objList = mxutil.Ensure(objList, 1)
			push(objList, ao)
		}
		mxutil.WriteStr(2, "  link\n")
		ldArgs := []string{"ld.lld-22", "--gc-sections", "-o", outpath,
			mxutil.JoinPath(muslDir, "crt1.o")}
		for _, o := range objList {
			ldArgs = mxutil.Ensure(ldArgs, 1)
			push(ldArgs, o)
		}
		for _, la := range []string{comprtLib, muslLib, "-z", "stack-size=67108864"} {
			ldArgs = mxutil.Ensure(ldArgs, 1)
			push(ldArgs, la)
		}
		rc = run(ldArgs)
		if rc != 0 {
			fatal("linker failed")
		}
	}
	writeAllocSites(outpath)
	writeCoverSites(outpath)
	mxutil.WriteStr(2, "  -> " | outpath | "\n")
	if runAfter {
		execArgs := []string{outpath}
		for _, a := range runArgs {
			execArgs = mxutil.Ensure(execArgs, 1)
			push(execArgs, a)
		}
		exitNow(run(execArgs))
	}
}

// rssKB reports this process's resident set size in kilobytes. Diagnostic only:
// build-memory attribution reads /proc, which is linux-specific and never
// wanted on a target.
func rssKB() (kb int64) {
	data, rerr := os.ReadFile("/proc/self/statm")
	if rerr != nil {
		return 0
	}
	// Fields: size resident shared text lib data dt. Take the second.
	i := int32(0)
	for i < len(data) && data[i] != ' ' {
		i++
	}
	i++
	var pages int64
	for i < len(data) && data[i] >= '0' && data[i] <= '9' {
		pages = pages*10 + int64(data[i]-'0')
		i++
	}
	return pages * 4 // 4 KiB pages
}

// mapCensus counts this process's virtual memory areas and their total size.
// A mapping count that grows per package with no live structure to match it is
// an arena that was never unmapped; a flat count means the growth is live data.
func mapCensus() (lines int32, totalKB int64) {
	data, merr := os.ReadFile("/proc/self/maps")
	if merr != nil {
		return 0, 0
	}
	i := int32(0)
	for i < len(data) {
		nl := int32(0)
		for i < len(data) && data[i] != '\n' {
			i++
			nl++
		}
		i++
		lines++
		// Each line ends with the mapping size in hex.
		j := i - 1
		if nl > 0 {
			j = i - 2
		}
		hs := j
		for hs > 0 && isHexDigit(data[hs]) {
			hs--
		}
		hs++
		var sz int64
		for k := hs; k <= j; k++ {
			sz = sz*16 + int64(hexVal(data[k]))
		}
		totalKB += sz / 1024
	}
	return lines, totalKB
}

func isHexDigit(c byte) (ok bool) {
	return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
}

func hexVal(c byte) (v int32) {
	if c >= '0' && c <= '9' {
		return int32(c - '0')
	}
	if c >= 'a' && c <= 'f' {
		return int32(c-'a') + 10
	}
	return int32(c-'A') + 10
}

// memLine prints one build-memory attribution line: RSS plus the size of every
// persistent structure the build carries from one package to the next. A
// counter that tracks RSS is the accumulator.
func memLine(tag string) {
	var reg, byname, mxhg, scang, genS, genF, genM, iren int32
	if cctx != nil {
		if cctx.universe != nil {
			if cctx.universe.Registry != nil {
				reg = int32(len(cctx.universe.Registry))
			}
			if cctx.universe.ByName != nil {
				byname = int32(len(cctx.universe.ByName))
			}
		}
		mxhg = int32(len(cctx.mxhGenerics))
		scang = int32(len(cctx.scannedGeneric))
		genS = int32(len(cctx.genericPkgScopes))
		genF = int32(len(cctx.genericFuncDecls))
		genM = int32(len(cctx.genericMethodDecls))
		iren = int32(len(cctx.irResults))
	}
	maps, mapKB := mapCensus()
	mxutil.WriteStr(2, "  mem "|tag|" rss="|simpleItoa(int32(rssKB()/1024))|"MB maps="|simpleItoa(maps)|" mapMB="|simpleItoa(int32(mapKB/1024))|" reg="|simpleItoa(reg)|" byname="|simpleItoa(byname)|" mxhg="|simpleItoa(mxhg)|" scang="|simpleItoa(scang)|" genS="|simpleItoa(genS)|" genF="|simpleItoa(genF)|" genM="|simpleItoa(genM)|" iren="|simpleItoa(iren)|"\n")
}

// buildPkgsSerial type-checks and compiles each package in dependency order
// in a single pass. Each package's working set dies before the next begins.
func buildPkgsSerial(pkgs []*pkgInfo, triple, clang, tmpdir, cacheBase string, forceRebuild, printIR bool) (bcs []string, hasRT bool) {
	var deferredClang [][]string
	isWasmTarget := mxutil.TargetArch() == "wasm"
	if cctx.dispLastUse == nil {
		cctx.dispLastUse = map[string]int32{}
		byPathL := map[string]*pkgInfo{}
		for _, lp := range pkgs {
			byPathL[lp.path] = lp
			byPathL[dispPkgKey(lp)] = lp
		}
		for li, lp := range pkgs {
			seenL := map[string]bool{}
			outL := map[string]bool{}
			dispTier2Closure(lp, byPathL, cctx.dispIfaceMethods, cctx.dispMethodsByPkg, seenL, outL)
			for k := range outL {
				cctx.dispLastUse[k] = int32(li)
			}
		}
	}
	if cctx.dispTier2Arena == nil {
		cctx.dispTier2Arena = map[string]*runtime.Arena{}
	}
	byPathT2 := map[string]*pkgInfo{}
	for _, tp := range pkgs {
		byPathT2[tp.path] = tp
		byPathT2[dispPkgKey(tp)] = tp
	}
	for pi, pkg := range pkgs {
		memLine(pkg.path)
		// Release every transient tier-2 graph whose last transitive user has
		// already been emitted. Releasing here (rather than at the loop's many
		// exit points) keeps every path covered.
		var doneT2 []string
		for k := range cctx.dispTier2Arena {
			if cctx.dispLastUse[k] < pi {
				doneT2 = mxutil.Ensure(doneT2, 1)
				doneT2 = push(doneT2, k)
			}
		}
		for _, k := range doneT2 {
			copyGenericsToRoot(k)
			delete(cctx.universe.Registry, k)
			delete(cctx.mxhLoaded, k)
			runtime.ArenaFree(cctx.dispTier2Arena[k])
			delete(cctx.dispTier2Arena, k)
		}
		pkgKey := dispPkgKey(pkg)
		isTier2 := !tier1(pkgKey, cctx.dispIfaceMethods, cctx.dispMethodsByPkg)
		// Lazily materialise the tier-2 packages this one names, each in its own
		// arena, and give this package's own graph a transient arena too if it
		// is tier 2. Released below once their last user has been emitted.
		if !pkg.baked {
			for _, imp := range pkg.imports {
				ip := byPathT2[imp]
				if ip == nil || ip.baked {
					continue
				}
				ik := dispPkgKey(ip)
				if cctx.dispTier2Arena[ik] != nil || cctx.mxhLoaded[ik] {
					continue
				}
				if tier1(ik, cctx.dispIfaceMethods, cctx.dispMethodsByPkg) {
					continue
				}
				ih := pkgHash(ip)
				if data, ok := mxutil.ReadFile(cachedMxhPath(cacheBase, ip.path, ih, ip.version)); ok {
					// One arena per tier-2 package, sized to the graph it holds
					// (the package's mxh text is a few KB): a flat 32MB per
					// package reserved ~1792MB of mostly-empty mappings by the
					// time the last package emitted. ArenaAlloc chains 64MB
					// regions when a graph genuinely outgrows this.
					ar := runtime.ArenaNew(4 * 1024 * 1024)
					cctx.loadArena = ar
					loadMxhInto(data)
					cctx.loadArena = nil
					cctx.dispTier2Arena[ik] = ar
				}
			}
			if isTier2 && cctx.dispTier2Arena[pkgKey] == nil {
				// Registered here, but NOT made the ambient arena: that is set
				// only around the call that materialises THIS package's graph.
				// Leaving it set would direct every later load into an arena
				// that is freed when this package's last user passes, leaving
				// dangling registry entries behind.
				cctx.dispTier2Arena[pkgKey] = runtime.ArenaNew(4 * 1024 * 1024)
			}
		}
		// Baked packages: types already loaded into the registry by the
		// pre-pass TypeCheckOnly; symbols come from the sysroot bake. Skip.
		if pkg.baked {
			continue
		}
		if pkg.path == "runtime" {
			if !isWasmTarget {
				hasRT = true
			}
		}
		compilePath := pkg.path
		if compilePath == "." || compilePath == ".." || mxutil.HasPrefix(compilePath, "/") || mxutil.HasPrefix(compilePath, "./") || mxutil.HasPrefix(compilePath, "../") {
			compilePath = pkg.name
		}

		hash := pkgHash(pkg)
		cached := cachedBcPath(cacheBase, pkg.path, hash, pkg.version)
		cachedMxh := cachedMxhPath(cacheBase, pkg.path, hash, pkg.version)

		bcOk := mxutil.FileExists(cached)
		mxhOk := mxutil.FileExists(cachedMxh)

		if bcOk && mxhOk && !forceRebuild {
			mxutil.WriteStr(2, "  cached " | pkg.path)
			if pkg.version != "" {
				mxutil.WriteStr(2, " @ " | pkg.version)
			}
			mxutil.WriteStr(2, "\n")
			loadMxh(cachedMxh)
			scanPkgGenerics(pkg.dir, pkg.files, compilePath)
			bcs = mxutil.Ensure(bcs, 1)
			push(bcs, cached)
			for _, cf := range pkg.cfiles {
				cPath := mxutil.JoinPath(pkg.dir, cf)
				cbcFile := mxutil.JoinPath(tmpdir, safeName(pkg.path) | "_" | cf | ".bc")
				crc := run([]string{clang, "--target=" | triple, "-emit-llvm", "-c", cPath, "-o", cbcFile})
				if crc == 0 {
					bcs = mxutil.Ensure(bcs, 1)
					push(bcs, cbcFile)
				}
			}
			for _, bf := range pkg.bcfiles {
				bcs = mxutil.Ensure(bcs, 1)
				push(bcs, mxutil.JoinPath(pkg.dir, bf))
			}
			continue
		}

		if isStdlib(pkg.path) && bcOk && !forceRebuild {
			mxutil.WriteStr(2, "  cached " | pkg.path | "\n")
			cctx.loadArena = cctx.dispTier2Arena[pkgKey]
			typeCheckPkgSource(cacheBase, pkg.dir, pkg.files, pkg.path, compilePath, cachedMxh)
			cctx.loadArena = nil
			if cctx.compileArena != nil {
				runtime.ArenaFree(cctx.compileArena)
				cctx.compileArena = nil
			}
			bcs = mxutil.Ensure(bcs, 1)
			push(bcs, cached)
			continue
		}

		mxutil.WriteStr(2, "  compile " | pkg.path | "\n")
		llFile := mxutil.JoinPath(tmpdir, safeName(pkg.path) | ".ll")
		// Stream IR directly to .ll file to avoid accumulating entire
		// package IR in memory (unicode/tables.mx produces ~10MB IR).
		cctx.irOutputFile = llFile
		cctx.loadArena = cctx.dispTier2Arena[pkgKey]
		ir := compilePkgSource(pkg.dir, pkg.files, compilePath, triple)
		cctx.loadArena = nil
		cctx.irOutputFile = ""
		if printIR && len(ir) > 0 {
			mxutil.WriteStr(1, ir)
		}
		if len(ir) > 0 {
			// Non-streaming fallback (error messages start with ';')
			writeFile(llFile, []byte(ir), 0644)
		}
		bcFile := mxutil.JoinPath(tmpdir, safeName(pkg.path) | ".bc")
		// Defer clang call - collect for parallel execution after all IR emitted.
		deferredClang = mxutil.Ensure(deferredClang, 1)
		push(deferredClang, []string{clang, "--target=" | triple, "-emit-llvm", "-c", "-Wno-everything", "-Xclang", "-disable-O0-optnone", llFile, "-o", bcFile})
		// mxh written inside CompileToIR's arena before it dies.
		if len(cctx.lastMxhData) > 0 {
			cdir := mxutil.JoinPath(cacheBase, safeName(pkg.path))
			mkdirAll(cdir, 0755)
			cacheWrite(cachedMxh, []byte(cctx.lastMxhData))
			cctx.lastMxhData = ""
		}
		bcs = mxutil.Ensure(bcs, 1)
		push(bcs, bcFile)
		for _, cf := range pkg.cfiles {
			cPath := mxutil.JoinPath(pkg.dir, cf)
			cbcFile := mxutil.JoinPath(tmpdir, safeName(pkg.path) | "_" | cf | ".bc")
			deferredClang = mxutil.Ensure(deferredClang, 1)
			push(deferredClang, []string{clang, "--target=" | triple, "-emit-llvm", "-c", cPath, "-o", cbcFile})
			// rc = run(...)  -- deferred
			if false {
				fatal("clang failed for " | cf)
			}
			bcs = mxutil.Ensure(bcs, 1)
			push(bcs, cbcFile)
		}
		for _, bf := range pkg.bcfiles {
			bcs = mxutil.Ensure(bcs, 1)
			push(bcs, mxutil.JoinPath(pkg.dir, bf))
		}
	}
	// Run all deferred clang calls in parallel.
	if len(deferredClang) > 0 {
		// clang subprocesses are safe to parallelize even when the TLS probe
		// forced serial worker compilation (legacy-built bootstrap), so keep
		// the adaptive count there to bound bootstrap time.
		nproc := bst.buildJobs
		if bst.tlsFailed {
			nproc = adaptiveJobs()
		}
		if int32(len(deferredClang)) < nproc {
			nproc = int32(len(deferredClang))
		}
		mxutil.WriteStr(2, "  clang: " | simpleItoa(len(deferredClang)) | " files, " | simpleItoa(nproc) | " parallel\n")
		if !runPool(deferredClang, nproc) {
			fatal("clang failed")
		}
		// Cache the .bc files
		for _, pkg := range pkgs {
			cacheCompiledBc(cacheBase, tmpdir, pkg.path, pkgHash(pkg), pkg.version)
		}
	}
	return bcs, hasRT
}

// cacheCompiledBc runs mem2reg on one package's compiled .bc and copies it
// into the package cache under the same key the reader looks up. A free
// function so the file data dies with its frame: inline in the loop, every
// package's bitcode (megabytes each) stayed live in the caller's arena until
// the whole build returned.
func cacheCompiledBc(cacheBase, tmpdir, pkgPath, hash, version string) {
	bcFile := mxutil.JoinPath(tmpdir, safeName(pkgPath) | ".bc")
	if !mxutil.FileExists(bcFile) {
		return
	}
	mem2regBc(bcFile)
	mkdirAll(mxutil.JoinPath(cacheBase, safeName(pkgPath)), 0755)
	data, rok := mxutil.ReadFile(bcFile)
	if rok {
		cacheWrite(cachedBcPath(cacheBase, pkgPath, hash, version), data)
	}
}

// --- Ring buffer helpers ---

func ringSend(ring unsafe.Pointer, data []byte) (ok bool) {
	var dp unsafe.Pointer
	if len(data) > 0 {
		dp = unsafe.Pointer(unsafe.SliceData(data))
	}
	for {
		rc := cRingSend(ring, dp, int32(len(data)))
		if rc == 0 {
			return true
		}
		if rc < 0 {
			return false
		}
		cUsleep(100) // backpressure
	}
}

func ringRecv(ring unsafe.Pointer) (data []byte, ok bool) {
	for {
		pn := cRingPeekLen(ring)
		if pn > 0 {
			buf := []byte{:pn}
			n := cRingRecv(ring, unsafe.Pointer(unsafe.SliceData(buf)), pn)
			if n > 0 {
				return buf[:n], true
			}
			if n < 0 {
				return nil, false
			}
		}
		if pn < 0 {
			return nil, false
		}
		cUsleep(100)
	}
}

// ringRecvNonblock polls once. Returns (data, true) on message, (nil, true)
// if empty but open, (nil, false) if closed+empty.
// Allocates a buffer of exactly the right size for the message.
func ringRecvNonblock(ring unsafe.Pointer) (data []byte, ok bool) {
	pn := cRingPeekLen(ring)
	if pn == 0 {
		return nil, true // empty but open
	}
	if pn < 0 {
		return nil, false // closed+empty
	}
	buf := []byte{:pn}
	n := cRingRecv(ring, unsafe.Pointer(unsafe.SliceData(buf)), pn)
	if n > 0 {
		return buf[:n], true
	}
	if n < 0 {
		return nil, false
	}
	return nil, true
}

func ringSendInt32(ring unsafe.Pointer, v int32) (ok bool) {
	b := []byte{:4}
	b[0] = byte(v >> 24)
	b[1] = byte(v >> 16)
	b[2] = byte(v >> 8)
	b[3] = byte(v)
	return ringSend(ring, b[:])
}

func ringRecvInt32(ring unsafe.Pointer) (v int32, ok bool) {
	d, rok := ringRecv(ring)
	if !rok || len(d) < 4 {
		return -1, false
	}
	v = int32(d[0])<<24 | int32(d[1])<<16 | int32(d[2])<<8 | int32(d[3])
	return v, true
}

// --- Package metadata serialization ---
// Text format: newline-separated fields. All strings are raw UTF-8.
// Layout:
//   numPkgs\n
//   triple\n targetOS\n targetArch\n clang\n tmpdir\n cacheBase\n root\n modPrefix\n modDir\n rootModPrefix\n
//   for each pkg: path\n name\n dir\n version\n
//     numFiles\n file1\n ... numCfiles\n cf1\n ... numBcfiles\n bf1\n ...
//     numImports\n imp1\n ...

func serializePkgMeta(pkgs []*pkgInfo, triple, clang, tmpdir, cacheBase, root, modPrefix, modDir, rootModPrefix string) (data []byte) {
	var b []byte
	b = b | simpleItoa(len(pkgs))
	b = mxutil.Ensure(b, 1)
	push(b, '\n')
	b = b | triple
	b = mxutil.Ensure(b, 1)
	push(b, '\n')
	// The target rides along as its own fields. The triple cannot stand in for
	// them: both wasm targets share "wasm32-unknown-wasi", so a worker that
	// reconstructed js-vs-wasi from it hashed the same package under two keys.
	b = b | mxutil.TargetOS()
	b = mxutil.Ensure(b, 1)
	push(b, '\n')
	b = b | mxutil.TargetArch()
	b = mxutil.Ensure(b, 1)
	push(b, '\n')
	b = b | clang
	b = mxutil.Ensure(b, 1)
	push(b, '\n')
	b = b | tmpdir
	b = mxutil.Ensure(b, 1)
	push(b, '\n')
	b = b | cacheBase
	b = mxutil.Ensure(b, 1)
	push(b, '\n')
	b = b | root
	b = mxutil.Ensure(b, 1)
	push(b, '\n')
	b = b | modPrefix
	b = mxutil.Ensure(b, 1)
	push(b, '\n')
	b = b | modDir
	b = mxutil.Ensure(b, 1)
	push(b, '\n')
	b = b | rootModPrefix
	b = mxutil.Ensure(b, 1)
	push(b, '\n')
	for _, p := range pkgs {
		b = b | p.path
		b = mxutil.Ensure(b, 1)
		push(b, '\n')
		b = b | p.name
		b = mxutil.Ensure(b, 1)
		push(b, '\n')
		b = b | p.dir
		b = mxutil.Ensure(b, 1)
		push(b, '\n')
		b = b | p.version
		b = mxutil.Ensure(b, 1)
		push(b, '\n')
		b = b | simpleItoa(len(p.files))
		b = mxutil.Ensure(b, 1)
		push(b, '\n')
		for _, f := range p.files {
			b = b | f
			b = mxutil.Ensure(b, 1)
			push(b, '\n')
		}
		b = b | simpleItoa(len(p.cfiles))
		b = mxutil.Ensure(b, 1)
		push(b, '\n')
		for _, f := range p.cfiles {
			b = b | f
			b = mxutil.Ensure(b, 1)
			push(b, '\n')
		}
		b = b | simpleItoa(len(p.bcfiles))
		b = mxutil.Ensure(b, 1)
		push(b, '\n')
		for _, f := range p.bcfiles {
			b = b | f
			b = mxutil.Ensure(b, 1)
			push(b, '\n')
		}
		b = b | simpleItoa(len(p.imports))
		b = mxutil.Ensure(b, 1)
		push(b, '\n')
		for _, im := range p.imports {
			b = b | im
			b = mxutil.Ensure(b, 1)
			push(b, '\n')
		}
	}
	return b
}

// deserLine reads the next line from data[pos:], returns it and advances pos.
func deserLine(data []byte, pos int32) (line string, next int32) {
	start := pos
	for pos < int32(len(data)) && data[pos] != '\n' {
		pos++
	}
	line = string(data[start:pos])
	if pos < int32(len(data)) {
		pos++ // skip \n
	}
	return line, pos
}

func deserInt(data []byte, pos int32) (v int32, next int32) {
	s, np := deserLine(data, pos)
	return parseInt32(s), np
}

type workerMeta struct {
	pkgs       []*pkgInfo
	triple     string
	targetOS   string
	targetArch string
	clang      string
	tmpdir     string
	cacheBase  string
	root       string
	modPrefix  string
	modDir     string
	// rootModPrefix is the target module, distinct from modPrefix (which may
	// be the MOXIEROOT fallback) so workers gate restrictions identically to
	// the parent.
	rootModPrefix string
}

func deserializePkgMeta(data []byte) (m *workerMeta) {
	pos := int32(0)
	numPkgs, pos := deserInt(data, pos)
	m = &workerMeta{}
	m.triple, pos = deserLine(data, pos)
	m.targetOS, pos = deserLine(data, pos)
	m.targetArch, pos = deserLine(data, pos)
	m.clang, pos = deserLine(data, pos)
	m.tmpdir, pos = deserLine(data, pos)
	m.cacheBase, pos = deserLine(data, pos)
	m.root, pos = deserLine(data, pos)
	m.modPrefix, pos = deserLine(data, pos)
	m.modDir, pos = deserLine(data, pos)
	m.rootModPrefix, pos = deserLine(data, pos)
	m.pkgs = []*pkgInfo{:numPkgs}
	for i := int32(0); i < numPkgs; i++ {
		p := &pkgInfo{}
		p.path, pos = deserLine(data, pos)
		p.name, pos = deserLine(data, pos)
		p.dir, pos = deserLine(data, pos)
		p.version, pos = deserLine(data, pos)
		nf, np := deserInt(data, pos)
		pos = np
		if nf > 0 {
			p.files = []string{:nf}
			for j := int32(0); j < nf; j++ {
				p.files[j], pos = deserLine(data, pos)
			}
		}
		nc, npc := deserInt(data, pos)
		pos = npc
		if nc > 0 {
			p.cfiles = []string{:nc}
			for j := int32(0); j < nc; j++ {
				p.cfiles[j], pos = deserLine(data, pos)
			}
		}
		nb, npb := deserInt(data, pos)
		pos = npb
		if nb > 0 {
			p.bcfiles = []string{:nb}
			for j := int32(0); j < nb; j++ {
				p.bcfiles[j], pos = deserLine(data, pos)
			}
		}
		ni, npi := deserInt(data, pos)
		pos = npi
		if ni > 0 {
			p.imports = []string{:ni}
			for j := int32(0); j < ni; j++ {
				p.imports[j], pos = deserLine(data, pos)
			}
		}
		m.pkgs[i] = p
	}
	return m
}

// --- Worker entry (runs in a new thread) ---
// Receives metadata via ringA, then receives job indices. Compiles each
// package, writes .bc + .mxh to cache, sends result on ringB.
// ringA/ringB pointers are passed as a 2-element unsafe.Pointer array.

type workerRings struct {
	ringA unsafe.Pointer // parent -> worker (jobs)
	ringB unsafe.Pointer // worker -> parent (results)
}

//export mxc_worker_entry
func workerEntryExport(arg unsafe.Pointer) {
	// Initialize this thread's heap and package state (TLS globals start zeroed).
	// Must happen before any Moxie allocation. allocateHeap() mmaps a fresh
	// region, initHeap() sets the bump pointer, initAll() runs package inits.
	// Mirrors the parent main() init order: compile ctx, universe, build state.
	runtime.InitCShared()
	initCompileCtx()
	cctx.universe = InitUniverse()
	SetUniverseGlobals(cctx.universe)
	initBuildState()

	wr := (*workerRings)(arg)
	ringA := wr.ringA
	ringB := wr.ringB

	metaData, metaOk := ringRecv(ringA)
	if !metaOk {
		return
	}
	meta := deserializePkgMeta(metaData)
	metaData = nil

	// Set up module context from metadata
	bst.globalModPrefix = meta.modPrefix
	bst.globalModDir = meta.modDir
	bst.rootModPrefix = meta.rootModPrefix
	bst.quietDiscover = true

	// The target comes from the metadata, never from the triple string: both
	// wasm targets share "wasm32-unknown-wasi", and "not wasm" used to mean
	// linux/amd64, so an arm64 worker hashed and cached arm64 bitcode under the
	// amd64 key that the next amd64 build linked.
	mxutil.SetTarget(meta.targetOS, meta.targetArch)

	// Initialize this thread's compiler state (TLS globals are zeroed)
	registerBuiltins()

	// Build idxByPath for this thread's copy
	idxByPath := map[string]int32{}
	for i := int32(0); i < int32(len(meta.pkgs)); i++ {
		idxByPath[meta.pkgs[i].path] = i
	}

	// Compute hashes for all packages (worker's own bst.pkgKeyMemo)
	hashes := []string{:len(meta.pkgs)}
	for i := int32(0); i < int32(len(meta.pkgs)); i++ {
		hashes[i] = pkgHash(meta.pkgs[i])
	}

	// Whole-link registry: dispatch chains must see every type in the link,
	// not just the compiling package's deps.
	if lsErr := workerLoadLinkSet(meta, hashes); lsErr != "" {
		workerSendResult(ringB, -1, lsErr)
		return
	}

	// Work loop: receive job index, compile, send result
	for {
		idx, ok := ringRecvInt32(ringA)
		if !ok {
			break // ring closed, shutdown
		}
		if idx < 0 || idx >= int32(len(meta.pkgs)) {
			workerSendResult(ringB, idx, "invalid package index")
			continue
		}
		pkg := meta.pkgs[idx]
		errMsg := workerCompilePkg(pkg, hashes[idx], meta, idxByPath, hashes)
		workerSendResult(ringB, idx, errMsg)
	}
}

// workerSendResult sends idx + error text on ringB.
// Empty errMsg = success. Non-empty = error description.
// Wire format: [idx:4 BE] [errlen:4 BE] [error text]
func workerSendResult(ring unsafe.Pointer, idx int32, errMsg string) {
	elen := int32(len(errMsg))
	msg := []byte{:8 + elen}
	msg[0] = byte(idx >> 24)
	msg[1] = byte(idx >> 16)
	msg[2] = byte(idx >> 8)
	msg[3] = byte(idx)
	msg[4] = byte(elen >> 24)
	msg[5] = byte(elen >> 16)
	msg[6] = byte(elen >> 8)
	msg[7] = byte(elen)
	for i := int32(0); i < elen; i++ {
		msg[8+i] = errMsg[i]
	}
	ringSend(ring, msg)
}

// workerLoadDeps recursively loads .mxh files for a package's imports,
// ensuring transitive deps are loaded before the package that references them.
func workerLoadDeps(pkg *pkgInfo, meta *workerMeta, idxByPath map[string]int32, hashes []string) (errMsg string) {
	for _, imp := range pkg.imports {
		di, ok := idxByPath[imp]
		if !ok {
			continue
		}
		dep := meta.pkgs[di]
		compilePath := dep.path
		if compilePath == "." || compilePath == ".." || mxutil.HasPrefix(compilePath, "/") || mxutil.HasPrefix(compilePath, "./") || mxutil.HasPrefix(compilePath, "../") {
			compilePath = dep.name
		}
		if existing := cctx.universe.Registry[compilePath]; existing != nil && !existing.Synthetic {
			continue
		}
		// Recursively load this dep's deps first
		if depErr := workerLoadDeps(dep, meta, idxByPath, hashes); depErr != "" {
			return depErr
		}
		depHash := hashes[di]
		cachedMxh := cachedMxhPath(meta.cacheBase, dep.path, depHash, dep.version)
		if !loadMxh(cachedMxh) {
			return "missing dep .mxh for " | dep.path
		}
		src := concatSources(dep.dir, dep.files)
		ScanGenericDecls(src, compilePath)
	}
	return ""
}

// workerLoadLinkSet loads every package's .mxh into the worker registry once,
// before any job runs. Interface dispatch emits a typeID switch over the
// registry, so a package's dispatch must enumerate the whole link set - the
// same invariant the serial path gets from its whole-link pre-pass. Loading
// only a package's own deps leaves downstream types invisible, which makes a
// spawn-channel Codec dispatch fall through to "no impl" depending on which
// worker happened to compile the runtime. The set is fixed at startup, so
// this is deterministic, not scheduling-dependent.
func workerLoadLinkSet(meta *workerMeta, hashes []string) (errMsg string) {
	for i := int32(0); i < int32(len(meta.pkgs)); i++ {
		dep := meta.pkgs[i]
		compilePath := dep.path
		if compilePath == "." || compilePath == ".." || mxutil.HasPrefix(compilePath, "/") || mxutil.HasPrefix(compilePath, "./") || mxutil.HasPrefix(compilePath, "../") {
			compilePath = dep.name
		}
		if existing := cctx.universe.Registry[compilePath]; existing != nil && !existing.Synthetic {
			continue
		}
		cachedMxh := cachedMxhPath(meta.cacheBase, dep.path, hashes[i], dep.version)
		if !mxutil.FileExists(cachedMxh) {
			continue
		}
		if !loadMxh(cachedMxh) {
			return "missing link-set .mxh for " | dep.path
		}
		src := concatSources(dep.dir, dep.files)
		ScanGenericDecls(src, compilePath)
	}
	return ""
}

// workerCompilePkg compiles one package in the worker thread. All deps must
// already have .mxh in cache. Returns empty string on success, error text on failure.
func workerCompilePkg(pkg *pkgInfo, hash string, meta *workerMeta, idxByPath map[string]int32, hashes []string) (errMsg string) {
	// The whole link set is already loaded (workerLoadLinkSet at startup);
	// reloading the deps is a no-op that keeps a lone worker correct.
	if loadErr := workerLoadDeps(pkg, meta, idxByPath, hashes); loadErr != "" {
		return loadErr
	}

	compilePath := pkg.path
	if compilePath == "." || compilePath == ".." || mxutil.HasPrefix(compilePath, "/") || mxutil.HasPrefix(compilePath, "./") || mxutil.HasPrefix(compilePath, "../") {
		compilePath = pkg.name
	}

	mxutil.WriteStr(2, "  compile " | pkg.path | "\n")
	src := concatSources(pkg.dir, pkg.files)
	cctx.compilePkgDir = pkg.dir
	ir := CompileToIR(src, compilePath, meta.triple)
	if len(ir) > 0 && ir[0] == ';' {
		return remapErrorLines(ir)
	}
	if len(ir) == 0 {
		return "empty IR for " | pkg.path
	}

	llFile := mxutil.JoinPath(meta.tmpdir, safeName(pkg.path) | ".ll")
	writeFile(llFile, []byte(ir), 0644)

	bcFile := mxutil.JoinPath(meta.tmpdir, safeName(pkg.path) | ".bc")
	rc := run([]string{meta.clang, "--target=" | meta.triple, "-emit-llvm", "-c", "-Wno-everything", "-Xclang", "-disable-O0-optnone", llFile, "-o", bcFile})
	if rc != 0 {
		return "clang failed for " | pkg.path
	}
	mem2regBc(bcFile)

	// Cache .bc
	cacheDir := mxutil.JoinPath(meta.cacheBase, safeName(pkg.path))
	mkdirAll(cacheDir, 0755)
	cached := cachedBcPath(meta.cacheBase, pkg.path, hash, pkg.version)
	bcData, rok := mxutil.ReadFile(bcFile)
	if rok {
		cacheWrite(cached, bcData)
	}

	// Cache .mxh (already generated inside CompileToIR's arena)
	if len(cctx.lastMxhData) > 0 {
		cachedMxh := cachedMxhPath(meta.cacheBase, pkg.path, hash, pkg.version)
		cacheWrite(cachedMxh, []byte(cctx.lastMxhData))
		cctx.lastMxhData = ""
	}

	// Compile C files
	for _, cf := range pkg.cfiles {
		cPath := mxutil.JoinPath(pkg.dir, cf)
		cbcFile := mxutil.JoinPath(meta.tmpdir, safeName(pkg.path) | "_" | cf | ".bc")
		rc = run([]string{meta.clang, "--target=" | meta.triple, "-emit-llvm", "-c", cPath, "-o", cbcFile})
		if rc != 0 {
			return "clang failed for " | cf
		}
	}

	return ""
}

// --- Worker info for the orchestrator ---

type workerInfo struct {
	ringA    unsafe.Pointer // parent -> worker
	ringB    unsafe.Pointer // worker -> parent
	handle   uint64
	status   uint64
	busy     bool
	busyIdx  int32
}

// buildPkgsParallel spawns worker threads with ring buffer IPC. Workers
// receive package metadata at startup, then job indices. Each worker
// independently loads deps from cache, compiles, writes .bc + .mxh to cache.
// No shared mutable state - this IS the Moxie spawn model.
func buildPkgsParallel(pkgs []*pkgInfo, triple, clang, tmpdir, cacheBase string, forceRebuild bool, jobs int32) (bcs []string, hasRT bool) {
	n := int32(len(pkgs))
	done := []bool{:n}
	needBuild := []bool{:n}
	idxByPath := map[string]int32{}
	for i := int32(0); i < n; i++ {
		idxByPath[pkgs[i].path] = i
	}

	// Phase 1: check cache
	for i := int32(0); i < n; i++ {
		pkg := pkgs[i]
		// Baked packages: types come from the pre-pass TypeCheckOnly cache
		// write; symbols come from the sysroot bake. Already done - the
		// workers only load their .mxh via workerLoadDeps, never compile.
		if pkg.baked {
			done[i] = true
			continue
		}
		hash := pkgHash(pkg)
		cached := cachedBcPath(cacheBase, pkg.path, hash, pkg.version)
		cachedMxh := cachedMxhPath(cacheBase, pkg.path, hash, pkg.version)
		bcOk := mxutil.FileExists(cached)
		mxhOk := mxutil.FileExists(cachedMxh)
		if bcOk && mxhOk && !forceRebuild {
			done[i] = true
			mxutil.WriteStr(2, "  cached " | pkg.path)
			if pkg.version != "" {
				mxutil.WriteStr(2, " @ " | pkg.version)
			}
			mxutil.WriteStr(2, "\n")
		} else {
			needBuild[i] = true
		}
	}

	// Phase 1b: compute transitive dep indices for dispatch readiness.
	// A package is ready when ALL transitive deps (not just direct) are done.
	transDeps := [][]int32{:n}
	for i := int32(0); i < n; i++ {
		visited := map[int32]bool{}
		stack := []int32{:0:8}
		for _, imp := range pkgs[i].imports {
			if j, ok := idxByPath[imp]; ok {
				stack = mxutil.Ensure(stack, 1)
				push(stack, j)
			}
		}
		for len(stack) > 0 {
			top := stack[len(stack)-1]
			stack = stack[:len(stack)-1]
			if visited[top] {
				continue
			}
			visited[top] = true
			for _, imp := range pkgs[top].imports {
				if j, ok := idxByPath[imp]; ok && !visited[j] {
					stack = mxutil.Ensure(stack, 1)
					push(stack, j)
				}
			}
		}
		td := []int32{:0:len(visited)}
		for j := range visited {
			td = mxutil.Ensure(td, 1)
			push(td, j)
		}
		transDeps[i] = td
	}

	// Phase 2: serialize metadata and spawn workers
	root := moxieRoot()
	meta := serializePkgMeta(pkgs, triple, clang, tmpdir, cacheBase, root,
		bst.globalModPrefix, bst.globalModDir, bst.rootModPrefix)

	workers := []*workerInfo{:jobs}
	for wi := int32(0); wi < jobs; wi++ {
		w := &workerInfo{}
		w.ringA = cRingCreate(262144) // 256KB jobs+metadata
		w.ringB = cRingCreate(262144) // 256KB results+errors
		if w.ringA == nil || w.ringB == nil {
			fatal("ring_create failed for worker " | simpleItoa(wi))
		}

		// Pack rings into arg struct (lives until thread reads it)
		wr := &workerRings{ringA: w.ringA, ringB: w.ringB}

		rc := cSpawnWorker(unsafe.Pointer(wr), unsafe.Pointer(&w.handle), unsafe.Pointer(&w.status))
		if rc != 0 {
			fatal("spawn_worker failed for worker " | simpleItoa(wi))
		}

		// Send metadata to worker via ringA
		if !ringSend(w.ringA, meta) {
			fatal("failed to send metadata to worker " | simpleItoa(wi))
		}

		workers[wi] = w
	}
	meta = nil

	// Phase 3: three-check dispatch loop
	failed := false
	for {
		allDone := true
		for i := int32(0); i < n; i++ {
			if needBuild[i] && !done[i] {
				allDone = false
				break
			}
		}
		if allDone {
			break
		}

		// On failure: close all ringAs to signal workers to stop, drain busy
		if failed {
			for wi := int32(0); wi < int32(len(workers)); wi++ {
				w := workers[wi]
				if w != nil {
					cRingClose(w.ringA) // idempotent
				}
			}
			anyBusy := false
			for wi := int32(0); wi < int32(len(workers)); wi++ {
				w := workers[wi]
				if w != nil && w.busy {
					anyBusy = true
					break
				}
			}
			if !anyBusy {
				break
			}
			// Fall through to collection to drain in-flight results
		}

		if !failed {
			// Check 1: death check
			for wi := int32(0); wi < int32(len(workers)); wi++ {
				w := workers[wi]
				if w == nil {
					continue
				}
				alive := cThreadAlive(unsafe.Pointer(&w.status))
				if alive < 0 {
					if w.busy {
						mxutil.WriteStr(2, "  CRASHED worker " | simpleItoa(wi) | " compiling " | pkgs[w.busyIdx].path | "\n")
					} else {
						mxutil.WriteStr(2, "  CRASHED worker " | simpleItoa(wi) | "\n")
					}
					failed = true
					workers[wi] = nil
				}
			}

			// Check 2: dispatch jobs to idle workers
			if !failed {
				for wi := int32(0); wi < int32(len(workers)); wi++ {
					w := workers[wi]
					if w == nil || w.busy {
						continue
					}
					// Find a dispatchable package
					di := int32(-1)
					for i := int32(0); i < n; i++ {
						if done[i] || !needBuild[i] {
							continue
						}
						// Check not already in flight
						inFlight := false
						for wj := int32(0); wj < int32(len(workers)); wj++ {
							wk := workers[wj]
							if wk != nil && wk.busy && wk.busyIdx == i {
								inFlight = true
								break
							}
						}
						if inFlight {
							continue
						}
						// Check all transitive deps done
						ready := true
						for _, j := range transDeps[i] {
							if !done[j] {
								ready = false
								break
							}
						}
						if ready {
							di = i
							break
						}
					}
					if di < 0 {
						continue
					}
					// Dispatch
					if !ringSendInt32(w.ringA, di) {
						mxutil.WriteStr(2, "  dispatch failed for " | pkgs[di].path | "\n")
						failed = true
						break
					}
					w.busy = true
					w.busyIdx = di
				}
			}
		}

		// Check 3: collect results from busy workers (always runs - drains on failure)
		progress := false
		for wi := int32(0); wi < int32(len(workers)); wi++ {
			w := workers[wi]
			if w == nil || !w.busy {
				continue
			}
			rd, rok := ringRecvNonblock(w.ringB)
			if rd == nil {
				if !rok {
					mxutil.WriteStr(2, "  worker " | simpleItoa(wi) | " ringB closed\n")
					failed = true
				}
				continue
			}
			if len(rd) < 8 {
				continue
			}
			ridx := int32(rd[0])<<24 | int32(rd[1])<<16 | int32(rd[2])<<8 | int32(rd[3])
			elen := int32(rd[4])<<24 | int32(rd[5])<<16 | int32(rd[6])<<8 | int32(rd[7])
			w.busy = false
			progress = true
			if elen > 0 && int32(len(rd)) >= 8+elen {
				errText := string(rd[8 : 8+elen])
				mxutil.WriteStr(2, errText)
				mxutil.WriteStr(2, "mxc: compile error for " | pkgs[ridx].path | "\n")
				failed = true
			} else if elen > 0 {
				mxutil.WriteStr(2, "mxc: compile error for " | pkgs[ridx].path | "\n")
				failed = true
			} else {
				done[ridx] = true
			}
		}

		// Join point
		if !progress {
			cUsleep(1000)
		}
	}

	// Phase 4: shutdown - close rings, join threads
	for wi := int32(0); wi < int32(len(workers)); wi++ {
		w := workers[wi]
		if w == nil {
			continue
		}
		cRingClose(w.ringA)
		cThreadJoin(unsafe.Pointer(&w.handle), unsafe.Pointer(&w.status))
		cRingDestroy(w.ringA)
		cRingDestroy(w.ringB)
	}
	workers = nil

	if failed {
		fatal("parallel build failed")
	}
	for i := int32(0); i < n; i++ {
		if needBuild[i] && !done[i] {
			fatal("dependency cycle: cannot schedule " | pkgs[i].path)
		}
	}

	// Phase 5: assemble .bc list
	for i := int32(0); i < n; i++ {
		pkg := pkgs[i]
		if pkg.baked {
			// Baked: symbols come from runtime_go.bc at link time. Nothing
			// to add here - the link already includes the sysroot bake.
			continue
		}
		if pkg.path == "runtime" {
			hasRT = true
		}
		if needBuild[i] {
			bcs = mxutil.Ensure(bcs, 1)
			push(bcs, mxutil.JoinPath(tmpdir, safeName(pkg.path) | ".bc"))
			for _, cf := range pkg.cfiles {
				bcs = mxutil.Ensure(bcs, 1)
				push(bcs, mxutil.JoinPath(tmpdir, safeName(pkg.path) | "_" | cf | ".bc"))
			}
		} else {
			hash := pkgHash(pkg)
			bcs = mxutil.Ensure(bcs, 1)
			push(bcs, cachedBcPath(cacheBase, pkg.path, hash, pkg.version))
			for _, cf := range pkg.cfiles {
				cPath := mxutil.JoinPath(pkg.dir, cf)
				cbcFile := mxutil.JoinPath(tmpdir, safeName(pkg.path) | "_" | cf | ".bc")
				rc := run([]string{clang, "--target=" | triple, "-emit-llvm", "-c", cPath, "-o", cbcFile})
				if rc == 0 {
					bcs = mxutil.Ensure(bcs, 1)
					push(bcs, cbcFile)
				}
			}
		}
		for _, bf := range pkg.bcfiles {
			bcs = mxutil.Ensure(bcs, 1)
			push(bcs, mxutil.JoinPath(pkg.dir, bf))
		}
	}
	return bcs, hasRT
}

func cmdBuildRuntime() {
	root := moxieRoot()
	ensureModuleRoot(root)
	// The bake follows the target in effect for this invocation: main
	// resolves -target before anything else, and ensureRuntimeBake calls
	// this when an application needs a bake that does not exist yet.
	triple := "x86_64-unknown-linux-musleabihf"
	if mxutil.TargetArch() == "wasm" {
		triple = "wasm32-unknown-wasi"
	}
	clang := "clang-22"
	sysroot := mxutil.JoinPath(root, "sysroot")
	tmpdir := buildScratchDir("/tmp", "mxc-rt-build")
	mkdirAll(tmpdir, 0755)
	registerScratch(tmpdir)

	registerBuiltins()

	rtPkgs := []string{"internal/task", "runtime"}
	// Resolve the full dependency closure of the runtime, then COMPILE the
	// whole closure into the bake (not just the two root packages - the
	// app link resolves runtime's references to math/bits etc. against
	// this file, and the app's own closure does not include them).
	var rtClosure []*pkgInfo
	{
		var all []*pkgInfo
		for _, rp := range rtPkgs {
			deps := resolveAll(rp, root)
			for _, dp := range deps {
				found := false
				for _, ex := range all {
					if ex.path == dp.path {
						found = true
						break
					}
				}
				if !found {
					all = mxutil.Ensure(all, 1)
					push(all, dp)
				}
			}
		}
		for _, dp := range all {
			compilePath := dp.path
			if compilePath == "." || compilePath == ".." || mxutil.HasPrefix(compilePath, "/") || mxutil.HasPrefix(compilePath, "./") || mxutil.HasPrefix(compilePath, "../") {
				compilePath = dp.name
			}
			src := concatSources(dp.dir, dp.files)
			TypeCheckOnly(src, compilePath, "")
			rtClosure = mxutil.Ensure(rtClosure, 1)
			push(rtClosure, dp)
		}
	}
	var bcFiles []string
	for _, dp := range rtClosure {
		mxutil.WriteStr(2, "  compile " | dp.path | "\n")
		compilePath := dp.path
		if compilePath == "." || compilePath == ".." || mxutil.HasPrefix(compilePath, "/") || mxutil.HasPrefix(compilePath, "./") || mxutil.HasPrefix(compilePath, "../") {
			compilePath = dp.name
		}
		src := concatSources(dp.dir, dp.files)
		ir := compileSource(src, compilePath, triple, dp.dir)
		llFile := mxutil.JoinPath(tmpdir, safeName(dp.path) | ".ll")
		writeFile(llFile, []byte(ir), 0644)
		bcFile := mxutil.JoinPath(tmpdir, safeName(dp.path) | ".bc")
		rc := run([]string{clang, "--target=" | triple, "-emit-llvm", "-c", "-Wno-everything", "-Xclang", "-disable-O0-optnone", llFile, "-o", bcFile})
		if rc != 0 {
			fatal("clang failed for " | dp.path)
		}
		mem2regBc(bcFile)
		bcFiles = mxutil.Ensure(bcFiles, 1)
		push(bcFiles, bcFile)
		for _, cf := range dp.cfiles {
			cPath := mxutil.JoinPath(dp.dir, cf)
			cbcFile := mxutil.JoinPath(tmpdir, safeName(dp.path) | "_" | cf | ".bc")
			crc := run([]string{clang, "--target=" | triple, "-emit-llvm", "-c", cPath, "-o", cbcFile})
			if crc == 0 {
				bcFiles = mxutil.Ensure(bcFiles, 1)
				push(bcFiles, cbcFile)
			}
		}
		for _, bf := range dp.bcfiles {
			bcFiles = mxutil.Ensure(bcFiles, 1)
			push(bcFiles, mxutil.JoinPath(dp.dir, bf))
		}
	}
	if len(bcFiles) == 0 {
		fatal("no runtime packages compiled")
	}
	// The runtime declares stacksave() bodyless; app links that use the
	// prebuilt bake expect the definition here (the app build only shims
	// it when compiling the runtime from source). Separate module - clang
	// rejects declare+define of the same function in one .ll file.
	{
		ssFile := mxutil.JoinPath(tmpdir, "rt_stacksave.ll")
		writeFile(ssFile, []byte(
			"declare ptr @llvm.stacksave.p0()\n" |
			"define ptr @runtime.stacksave(ptr %_ctx) {\n" |
			"  %1 = call ptr @llvm.stacksave.p0()\n" |
			"  ret ptr %1\n" |
			"}\n"), 0644)
		ssBc := mxutil.JoinPath(tmpdir, "rt_stacksave.bc")
		rc := run([]string{clang, "--target=" | triple, "-emit-llvm", "-c", ssFile, "-o", ssBc})
		if rc != 0 {
			fatal("clang failed for rt_stacksave")
		}
		bcFiles = mxutil.Ensure(bcFiles, 1)
		push(bcFiles, ssBc)
	}
	outBc := runtimeBakePath(sysroot)
	if len(bcFiles) == 1 {
		data, ok := mxutil.ReadFile(bcFiles[0])
		if !ok {
			fatal("cannot read " | bcFiles[0])
		}
		writeFile(outBc, data, 0644)
	} else {
		linkArgs := []string{"llvm-link-22", "-o", outBc}
		for _, bf := range bcFiles {
			linkArgs = mxutil.Ensure(linkArgs, 1)
			push(linkArgs, bf)
		}
		rc := run(linkArgs)
		if rc != 0 {
			fatal("llvm-link failed merging runtime")
		}
	}
	mxutil.WriteStr(2, "  -> " | outBc | "\n")
}
