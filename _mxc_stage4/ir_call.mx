package main

import (
	"moxielang.dev/pkg/mxutil"
	. "moxielang.dev/pkg/types"
)

func (e *irEmitter) emitUnOp(u *SSAUnOp) {
	reg := e.regName(u)
	if u.Op == OpMul {
		loadType := e.llvmType(u.SSAType())
		if loadType == "void" {
			if at, ok := e.allocTypes[u.X]; ok {
				loadType = at
			} else if a, ok2 := u.X.(*SSAAlloc); ok2 {
				loadType = e.inferAllocTypeFromStores(a)
			} else {
				loadType = "ptr"
			}
			e.allocTypes[u] = loadType
		}
		if loadType == "ptr" {
			if ia, ok := u.X.(*SSAIndexAddr); ok {
				baseU := SafeUnderlying(ia.X.SSAType())
				if sl, ok3 := baseU.(*Slice); ok3 && sl.Elem != nil {
					et := e.llvmType(sl.Elem)
					if et != "void" && et != "ptr" {
						loadType = et
					}
				} else if b, ok4 := baseU.(*Basic); ok4 && b.Info&IsString != 0 {
					loadType = "i8"
				} else {
					et := e.llvmType(ia.SSAType())
					if p2, ok5 := SafeUnderlying(ia.SSAType()).(*Pointer); ok5 && p2.Base != nil {
						et = e.llvmType(p2.Base)
					}
					if et == "void" {
						et = "i8"
					}
					if et != "ptr" {
						loadType = et
					}
				}
			}
			if fa, ok := u.X.(*SSAFieldAddr); ok {
				baseType := e.resolveFieldAddrBase(fa)
				ft := extractTupleField(baseType, fa.Field)
				if ft != "" && ft != "ptr" && ft != "void" {
					loadType = ft
				}
			}
		}
		if _, isIA := u.X.(*SSAIndexAddr); isIA && len(loadType) > 0 && loadType[0] == '[' {
			if at, ok2 := e.allocTypes[u.X]; ok2 && at != loadType {
				loadType = at
				e.allocTypes[u] = loadType
			}
		}
		isGlobalLoad := false
		if g, ok := u.X.(*SSAGlobal); ok {
			loadType = e.resolveGlobalDeclType(g)
			isGlobalLoad = true
		}
		if !isGlobalLoad {
			if at, ok := e.allocTypes[u.X]; ok && at != "ptr" && at != "void" && at != loadType {
				bothScalar := len(loadType) > 0 && loadType[0] == 'i' && len(at) > 0 && at[0] == 'i'
				isArrayElem := len(at) > 0 && at[0] == '[' && len(loadType) > 0 && loadType[0] != '{' && loadType != at
				bothAgg := len(loadType) > 0 && loadType[0] == '{' && len(at) > 0 && at[0] == '{'
				isAggToScalar := len(loadType) > 0 && loadType[0] == '{' && len(at) > 0 && (at[0] == 'i' || at == "double" || at == "float")
				if !bothScalar && !isArrayElem && !bothAgg && !isAggToScalar {
					loadType = at
					e.allocTypes[u] = loadType
				}
			}
		}
		addr := e.operand(u.X)
		e.w("  ")
		e.w(reg)
		e.w(" = load ")
		e.w(loadType)
		e.w(", ptr ")
		e.w(addr)
		e.w("\n")
		e.setRegType(u, reg, loadType)
		return
	}
	valType := e.llvmType(u.X.SSAType())
	resolved := e.resolvedType(u.X, valType)
	if resolved != valType {
		valType = resolved
	}
	if valType == "void" || valType == "" {
		resType := e.llvmType(u.SSAType())
		if resType != "void" && resType != "" {
			valType = resType
		} else {
			valType = "i32"
		}
	}
	val := e.operand(u.X)
	if u.Op == OpSub {
		isFloat := false
		if b, ok := SafeUnderlying(u.X.SSAType()).(*Basic); ok {
			isFloat = b.Info&IsFloat != 0
		}
		if !isFloat && (valType == "double" || valType == "float") {
			isFloat = true
		}
		if !isFloat && isConstOperand(val) && looksLikeFloat(val) {
			isFloat = true
			resType := e.llvmType(u.SSAType())
			if resType == "float" || resType == "double" {
				valType = resType
			} else {
				valType = "double"
			}
		}
		e.w("  ")
		e.w(reg)
		if isFloat {
			e.w(" = fneg ")
			e.w(valType)
			e.w(" ")
			e.w(val)
			e.w("\n")
			e.setRegType(u, reg, valType)
		} else {
			e.w(" = sub ")
			e.w(valType)
			e.w(" 0, ")
			e.w(val)
			e.w("\n")
		}
		return
	}
	if u.Op == OpNot || u.Op == OpXor {
		e.w("  ")
		e.w(reg)
		e.w(" = xor ")
		e.w(valType)
		e.w(" ")
		e.w(val)
		e.w(", -1\n")
		return
	}
	if u.Op == OpArrow {
		e.emitChanRecv(u)
		return
	}
	e.w("  ; unsupported unop op=")
	e.w(u.Op.String())
	e.w("\n")
}

func (e *irEmitter) callArgType(arg SSAValue, sig *Signature, i int32) (s string) {
	if _, isFreeVar := arg.(*SSAFreeVar); isFreeVar {
		return "ptr"
	}
	if _, isIA := arg.(*SSAIndexAddr); isIA {
		return "ptr"
	}
	if _, isG := arg.(*SSAGlobal); isG {
		// A global operand is emitted as its address (@pkg.name).
		return "ptr"
	}
	t := e.llvmType(arg.SSAType())
	if _, isAlloc := arg.(*SSAAlloc); !isAlloc {
		resolved := e.resolvedType(arg, t)
		if resolved != t {
			t = resolved
		}
	}
	// Integer constants take the signature's param width: an untyped const
	// defaults to i32, and passing "i32 -1" to an i64 param silently zeroes
	// the high half at the ABI boundary.
	if k, isConst := arg.(*SSAConst); isConst && sig != nil && sig.Params != nil {
		if _, isInt := k.val.(*ConstInt); isInt {
			sigIdx := i
			if sig.Recv != nil {
				sigIdx = i - 1
			}
			if sigIdx >= 0 && sigIdx < sig.Params.Len() {
				sigT := e.llvmType(sig.Params.At(sigIdx).Typ)
				if e.intBits(sigT) > 0 {
					return sigT
				}
			}
		}
	}
	if (t == "ptr" || t == "i1") && sig != nil && sig.Params != nil {
		_, isCall := arg.(*SSACall)
		_, isAlloc := arg.(*SSAAlloc)
		if !isCall && !isAlloc {
			sigIdx := i
			if sig.Recv != nil {
				sigIdx = i - 1
			}
			if sigIdx >= 0 && sigIdx < sig.Params.Len() {
				sigT := e.llvmType(sig.Params.At(sigIdx).Typ)
				if sigT != "ptr" && sigT != "void" && sigT != "i1" && sigT != "" {
					return sigT
				}
			}
		}
	}
	if t == "ptr" || t == "i1" {
		if load, ok := arg.(*SSAUnOp); ok && load.Op == OpMul {
			if g, ok2 := load.X.(*SSAGlobal); ok2 {
				if gt, ok3 := e.globalTypes[e.globalName(g)]; ok3 {
					return gt
				}
			}
		}
	}
	if t != "void" {
		return t
	}
	if sig != nil && sig.Params != nil {
		sigIdx := i
		if sig.Recv != nil {
			sigIdx = i - 1
		}
		if sigIdx >= 0 && sigIdx < sig.Params.Len() {
			return e.llvmType(sig.Params.At(sigIdx).Typ)
		}
	}
	return "ptr"
}

// callParamType returns the LLVM type of parameter i of sig, accounting for the
// receiver slot a method call passes first.
func (e *irEmitter) callParamType(sig *Signature, i int32) (s string) {
	if sig == nil || sig.Params == nil {
		return ""
	}
	sigIdx := i
	if sig.Recv != nil {
		sigIdx = i - 1
	}
	if sigIdx < 0 || sigIdx >= sig.Params.Len() {
		return ""
	}
	return e.llvmType(sig.Params.At(sigIdx).Typ)
}

// coerceIntArg widens or narrows an integer operand to the parameter's width.
// The argument's own type is whatever the builder computed it at, which for an
// untyped constant is the default width: `id(-42)` lowers the negation to
// `sub i32 0, 42`, and passing an i32 where the signature declares i64 lets the
// ABI zero-extend it, so -42 arrived as 4294967254. The extension follows the
// argument's own signedness, as at every other widening site; a narrowing is a
// trunc.
func (e *irEmitter) coerceIntArg(arg SSAValue, at, pt, av string) (out string) {
	if at == "" || pt == "" || at == "void" || pt == "void" || at == "i1" || pt == "i1" {
		return av
	}
	sb := e.intBits(at)
	db := e.intBits(pt)
	if sb <= 0 || db <= 0 || sb == db {
		return av
	}
	op := "sext"
	if b, ok := SafeUnderlying(arg.SSAType()).(*Basic); ok && b.Info&IsUnsigned != 0 {
		op = "zext"
	}
	if sb > db {
		op = "trunc"
	}
	e.nextReg++
	r := "%ca" | irItoa(e.nextReg)
	e.w("  ") ; e.w(r) ; e.w(" = ") ; e.w(op) ; e.w(" ") ; e.w(at) ; e.w(" ") ; e.w(av) ; e.w(" to ") ; e.w(pt) ; e.w("\n")
	return r
}

// callArgTexts renders a call's argument list as one "type value" string per
// argument, with the integer-width conversion an argument needs emitted before
// the call. Rendering the whole list first also keeps operand materialisation
// out of the middle of the call instruction, which is where a conversion would
// otherwise land.
func (e *irEmitter) callArgTexts(args []SSAValue, sig *Signature) (out []string) {
	out = []string{:0:len(args)}
	for i := int32(0); i < int32(len(args)); i++ {
		arg := args[i]
		if arg == nil {
			push(out, "ptr null")
			continue
		}
		at := e.callArgType(arg, sig, i)
		av := e.operand(arg)
		if pt := e.callParamType(sig, i); pt != "" && at != pt && e.intBits(at) > 0 && e.intBits(pt) > 0 {
			av = e.coerceIntArg(arg, at, pt, av)
			at = pt
		}
		if av == "null" && at != "ptr" {
			av = "zeroinitializer"
		}
		push(out, at | " " | av)
	}
	return
}

func (e *irEmitter) callSig(c *SSACall) (s *Signature) {
	if fn, ok := c.Call.Value.(*SSAFunction); ok && fn.Signature != nil {
		return fn.Signature
	}
	if sig, ok := SafeUnderlying(c.Call.Value.SSAType()).(*Signature); ok {
		return sig
	}
	return nil
}

func (e *irEmitter) emitCall(c *SSACall) {
	if e.tailRecursive && e.tailCalls != nil && e.tailCalls[c] {
		return
	}
	if b, ok := c.Call.Value.(*SSABuiltin); ok {
		e.emitBuiltinCall(c, b)
		return
	}
	reg := e.regName(c)
	retType := e.llvmType(c.SSAType())
	isVoid := retType == "void"
	sig := e.callSig(c)

	// Mirror legacy: runtime.supportsRecover is a compile-time constant.
	// The runtime source declares it as false for archs without recover
	// support; the compiler substitutes true on supported archs.
	if fn, ok := c.Call.Value.(*SSAFunction); ok && fn.Pkg != nil && fn.Pkg.Pkg != nil && fn.Pkg.Pkg.Path == "runtime" && fn.name == "supportsRecover" {
		e.w("  ") ; e.w(reg) ; e.w(" = or i1 0, 1\n")
		e.setRegType(c, reg, "i1")
		return
	}

	if fn, ok := c.Call.Value.(*SSAFunction); ok {
		if !e.isPkgFunc(fn) {
			e.declareExternalFunc(fn)
		}
		useSret2 := needsSret(retType)
		sretTmp2 := ""
		if useSret2 {
			e.nextReg++
			sretTmp2 = "%sret." | irItoa(e.nextReg)
			e.w("  ") ; e.w(sretTmp2) ; e.w(" = alloca ") ; e.w(retType) ; e.w("\n")
		}
		// Render every argument first: an argument whose width differs from its
		// parameter's needs a conversion instruction in front of the call, not
		// in the middle of it.
		argTexts := e.callArgTexts(c.Call.Args, sig)
		if useSret2 {
			e.w("  call void ")
		} else {
			// Emit "  [reg = ]call RET " as one segment: the defer checkpoint
			// is inserted by w() when a segment starts the line, so a
			// fragmented prefix leaves the frame unarmed and a panic would
			// longjmp to a null JumpPC.
			prefix := "  "
			if !isVoid {
				prefix = prefix | reg | " = "
			}
			e.w(prefix | "call " | retType | " ")
		}
		e.w(e.funcSymbol(fn))
		e.w("(")
		np := 0
		if useSret2 {
			e.w("ptr sret(") ; e.w(retType) ; e.w(") ") ; e.w(sretTmp2)
			np++
		}
		sym := e.funcSymbol(fn)
		isIntrinsic := mxutil.HasPrefix(sym, "@llvm.") || mxutil.HasPrefix(sym, "@\"llvm.")
		isExport := fn.externalSymbol != ""
		for i := int32(0); i < int32(len(argTexts)); i++ {
			if np > 0 { e.w(", ") }
			e.w(argTexts[i])
			np++
		}
		skipCtx := isIntrinsic || isExport
		if !skipCtx && len(cctx.wasmImportMap) > 0 {
			wsym := sym
			if len(wsym) > 0 && wsym[0] == '@' { wsym = wsym[1:] }
			if len(wsym) >= 2 && wsym[0] == '"' && wsym[len(wsym)-1] == '"' { wsym = wsym[1 : len(wsym)-1] }
			if _, wok := cctx.wasmImportMap[wsym]; wok {
				skipCtx = true
			}
		}
		if !skipCtx {
			if np > 0 { e.w(", ") }
			e.w("ptr null")
		}
		e.w(")\n")
		if useSret2 {
			e.w("  ") ; e.w(reg) ; e.w(" = load ") ; e.w(retType) ; e.w(", ptr ") ; e.w(sretTmp2) ; e.w("\n")
		}
		return
	}

	funcVal := e.operand(c.Call.Value)
	_, isClosure := c.Call.Value.(*SSAMakeClosure)
	needsExtract := isClosure
	if !needsExtract {
		if st := c.Call.Value.SSAType(); st != nil {
			if _, isSig := SafeUnderlying(st).(*Signature); isSig {
				needsExtract = true
			}
		}
	}
	var funcPtr, ctxReg string
	if needsExtract {
		funcPtr = e.nextReg2("fp")
		ctxReg = e.nextReg2("fp")
		e.w("  ") ; e.w(funcPtr) ; e.w(" = extractvalue {ptr, ptr} ") ; e.w(funcVal) ; e.w(", 1\n")
		e.w("  ") ; e.w(ctxReg) ; e.w(" = extractvalue {ptr, ptr} ") ; e.w(funcVal) ; e.w(", 0\n")
	} else {
		funcPtr = funcVal
		ctxReg = "null"
	}
	useSret := needsSret(retType)
	sretTmp := ""
	// Arguments first, for the same reason as the direct-call branch.
	argTexts2 := e.callArgTexts(c.Call.Args, sig)
	if useSret {
		e.nextReg++
		sretTmp = "%sret." | irItoa(e.nextReg)
		e.w("  ") ; e.w(sretTmp) ; e.w(" = alloca ") ; e.w(retType) ; e.w("\n")
		e.w("  call void ") ; e.w(funcPtr) ; e.w("(ptr sret(") ; e.w(retType) ; e.w(") ") ; e.w(sretTmp)
	} else {
		prefix := "  "
		if !isVoid {
			prefix = prefix | reg | " = "
		}
		e.w(prefix | "call " | retType | " ") ; e.w(funcPtr) ; e.w("(")
	}
	np2 := 0
	if useSret { np2++ }
	for i := int32(0); i < int32(len(argTexts2)); i++ {
		if np2 > 0 { e.w(", ") }
		e.w(argTexts2[i])
		np2++
	}
	if np2 > 0 { e.w(", ") }
	e.w("ptr ") ; e.w(ctxReg)
	e.w(")\n")
	if useSret {
		e.w("  ") ; e.w(reg) ; e.w(" = load ") ; e.w(retType) ; e.w(", ptr ") ; e.w(sretTmp) ; e.w("\n")
	}
}

func (e *irEmitter) emitBuiltinCall(c *SSACall, b *SSABuiltin) {
	reg := e.regName(c)
	name := b.SSAName()
	ipt := e.intptrType()
	sty := e.sliceType()
	if name == "len" {
		if len(c.Call.Args) == 1 {
			arg := e.operand(c.Call.Args[0])
			u := SafeUnderlying(c.Call.Args[0].SSAType())
			if u == nil { u = c.Call.Args[0].SSAType() }
			if arr, ok := u.(*Array); ok {
				rt1 := e.llvmType(c.SSAType())
				e.w("  ") ; e.w(reg) ; e.w(" = add ") ; e.w(rt1) ; e.w(" ") ; e.w(irItoa(int32(arr.Len))) ; e.w(", 0\n")
				_ = arg
				return
			}
			if p, ok := u.(*Pointer); ok && p.Base != nil {
				if arr, ok2 := SafeUnderlying(p.Base).(*Array); ok2 {
					rt2 := e.llvmType(c.SSAType())
					e.w("  ") ; e.w(reg) ; e.w(" = add ") ; e.w(rt2) ; e.w(" ") ; e.w(irItoa(int32(arr.Len))) ; e.w(", 0\n")
					_ = arg
					return
				}
			}
			_, isSlice := u.(*Slice)
			_, isMap := u.(*TCMap)
			isStr := e.isStringLike(c.Call.Args[0].SSAType())
			if !isSlice && !isMap && !isStr {
				argLT := e.llvmType(c.Call.Args[0].SSAType())
				if argLT == sty || argLT == e.ifaceType() {
					isSlice = true
				}
			}
			if isMap {
				rt3 := e.llvmType(c.SSAType())
				e.nextReg++
				tmp := "%bl" | irItoa(e.nextReg)
				e.w("  ") ; e.w(tmp) ; e.w(" = call ") ; e.w(ipt) ; e.w(" @runtime.hashmapLen(ptr ") ; e.w(arg) ; e.w(", ptr null)\n")
				if rt3 != ipt {
					e.w("  ") ; e.w(reg) ; e.w(" = trunc ") ; e.w(ipt) ; e.w(" ") ; e.w(tmp) ; e.w(" to ") ; e.w(rt3) ; e.w("\n")
				} else {
					e.w("  ") ; e.w(reg) ; e.w(" = add ") ; e.w(ipt) ; e.w(" ") ; e.w(tmp) ; e.w(", 0\n")
				}
				e.declareRuntime("runtime.hashmapLen", ipt, "ptr")
				return
			}
			if isSlice || isStr {
				rtSlice := e.llvmType(c.SSAType())
				if rtSlice != ipt {
					e.nextReg++
					tmp := "%bl" | irItoa(e.nextReg)
					e.w("  ") ; e.w(tmp) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(arg) ; e.w(", 1\n")
					e.w("  ") ; e.w(reg) ; e.w(" = trunc ") ; e.w(ipt) ; e.w(" ") ; e.w(tmp) ; e.w(" to ") ; e.w(rtSlice) ; e.w("\n")
				} else {
					e.w("  ") ; e.w(reg) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(arg) ; e.w(", 1\n")
				}
				return
			}
			// A channel reports the ring's occupancy, matching legacy's
			// runtime.chanLen. Returning zero made every len(chan) wrong.
			if _, isChan := u.(*TCChan); isChan {
				rtC := e.llvmType(c.SSAType())
				e.nextReg++
				tmpC := "%cl" | irItoa(e.nextReg)
				e.w("  ") ; e.w(tmpC) ; e.w(" = call i32 @runtime.chanLen(ptr ") ; e.w(arg) ; e.w(", ptr null)\n")
				if rtC != "i32" {
					e.w("  ") ; e.w(reg) ; e.w(" = trunc i32 ") ; e.w(tmpC) ; e.w(" to ") ; e.w(rtC) ; e.w("\n")
				} else {
					e.w("  ") ; e.w(reg) ; e.w(" = add i32 ") ; e.w(tmpC) ; e.w(", 0\n")
				}
				e.declareRuntime("runtime.chanLen", "i32", "ptr")
				return
			}
			// Not a slice, map, or string: return zero
			rt4 := e.llvmType(c.SSAType())
			if rt4 == "void" || rt4 == "" {
				rt4 = "i32"
			}
			e.w("  ") ; e.w(reg) ; e.w(" = add ") ; e.w(rt4) ; e.w(" 0, 0\n")
			return
		}
	} else if name == "cap" {
		if len(c.Call.Args) == 1 {
			arg := e.operand(c.Call.Args[0])
			uc := SafeUnderlying(c.Call.Args[0].SSAType())
			if uc == nil { uc = c.Call.Args[0].SSAType() }
			// Fixed extent: an array's capacity is NEGATIVE, and that sign is the
			// sentinel that says the extent cannot change - it is what
			// mxutil.capFixed tests, so every growth guard answers "no room"
			// without a special case. cap(arr[:]) is the same storage with the
			// sign flipped, so a slice of an array stays length-changeable. This
			// is the array-ABI convention W7 builds on, and legacy's go/types
			// patch has to produce the same number (build/patch-gotypes.go).
			if arr, ok := uc.(*Array); ok {
				rt5 := e.llvmType(c.SSAType())
				e.w("  ") ; e.w(reg) ; e.w(" = add ") ; e.w(rt5) ; e.w(" ") ; e.w(irItoa(-int32(arr.Len))) ; e.w(", 0\n")
				_ = arg
				return
			}
			if p, ok := uc.(*Pointer); ok && p.Base != nil {
				if arr, ok2 := SafeUnderlying(p.Base).(*Array); ok2 {
					rt6 := e.llvmType(c.SSAType())
					e.w("  ") ; e.w(reg) ; e.w(" = add ") ; e.w(rt6) ; e.w(" ") ; e.w(irItoa(-int32(arr.Len))) ; e.w(", 0\n")
					_ = arg
					return
				}
			}
			_, isSlice := uc.(*Slice)
			isStr := e.isStringLike(c.Call.Args[0].SSAType())
			if isSlice || isStr {
				rt7 := e.llvmType(c.SSAType())
				// cap must never show the linkdata sentinel: a caller doing
				// s[:cap(s)] or cap-len arithmetic assumes 0 <= len <= cap.
				// The all-ones capacity means "foreign, fixed length", so cap
				// reports len there; push/pop/resize still see the sentinel and
				// panic. One compare and one select, no call.
				e.nextReg++
				lenReg := "%cl" | irItoa(e.nextReg)
				e.w("  ") ; e.w(lenReg) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(arg) ; e.w(", 1\n")
				e.nextReg++
				capReg := "%cc" | irItoa(e.nextReg)
				e.w("  ") ; e.w(capReg) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(arg) ; e.w(", 2\n")
				e.nextReg++
				extReg := "%ce" | irItoa(e.nextReg)
				e.w("  ") ; e.w(extReg) ; e.w(" = icmp eq ") ; e.w(ipt) ; e.w(" ") ; e.w(capReg) ; e.w(", -1\n")
				e.nextReg++
				capVal := "%cv" | irItoa(e.nextReg)
				e.w("  ") ; e.w(capVal) ; e.w(" = select i1 ") ; e.w(extReg) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(lenReg) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(capReg) ; e.w("\n")
				if rt7 != ipt {
					e.w("  ") ; e.w(reg) ; e.w(" = trunc ") ; e.w(ipt) ; e.w(" ") ; e.w(capVal) ; e.w(" to ") ; e.w(rt7) ; e.w("\n")
				} else {
					e.w("  ") ; e.w(reg) ; e.w(" = add ") ; e.w(ipt) ; e.w(" ") ; e.w(capVal) ; e.w(", 0\n")
				}
				return
			}
			// Capacity comes from the channel ring, matching legacy's
			// runtime.chanCap; returning zero made every cap(chan) wrong.
			if _, isChan := uc.(*TCChan); isChan {
				rtC := e.llvmType(c.SSAType())
				e.nextReg++
				tmpC := "%cc" | irItoa(e.nextReg)
				e.w("  ") ; e.w(tmpC) ; e.w(" = call i32 @runtime.chanCap(ptr ") ; e.w(arg) ; e.w(", ptr null)\n")
				if rtC != "i32" {
					e.w("  ") ; e.w(reg) ; e.w(" = trunc i32 ") ; e.w(tmpC) ; e.w(" to ") ; e.w(rtC) ; e.w("\n")
				} else {
					e.w("  ") ; e.w(reg) ; e.w(" = add i32 ") ; e.w(tmpC) ; e.w(", 0\n")
				}
				e.declareRuntime("runtime.chanCap", "i32", "ptr")
				return
			}
		}
	} else if name == "push" {
		// legacy rejects `push` on anything but a slice: a slice contributes
		// its element type, a basic does too (a string is []byte here), and
		// anything else is "push on non-slice type". stage4 hardcoded the
		// slice type and emitted extractvalue against whatever it was handed,
		// so `*s = push(*s, v)` on a struct produced IR clang refuses instead
		// of the error legacy gives - which is how pkg/grapevine's and
		// pkg/crawler's tests looked like an IR-emit bug.
		if len(c.Call.Args) == 0 || c.Call.Args[0] == nil {
			e.emitZeroReg(e.regName(c), c.SSAType())
			return
		}
		at := SafeUnderlying(c.Call.Args[0].SSAType())
		_, isSlArg := at.(*Slice)
		_, isBasicArg := at.(*Basic)
		if !isSlArg && !isBasicArg {
			cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
			push(cctx.compileErrors, "push on non-slice type")
			e.emitZeroReg(e.regName(c), c.SSAType())
			return
		}
		if len(c.Call.Args) == 1 {
			src := e.operand(c.Call.Args[0])
			p := e.nextReg2("ap")
			e.w("  ") ; e.w(p) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(src) ; e.w(", 0\n")
			l := e.nextReg2("ap")
			e.w("  ") ; e.w(l) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(src) ; e.w(", 1\n")
			ca := e.nextReg2("ap")
			e.w("  ") ; e.w(ca) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(src) ; e.w(", 2\n")
			s1 := e.nextReg2("ap")
			e.w("  ") ; e.w(s1) ; e.w(" = insertvalue ") ; e.w(sty) ; e.w(" undef, ptr ") ; e.w(p) ; e.w(", 0\n")
			s2 := e.nextReg2("ap")
			e.w("  ") ; e.w(s2) ; e.w(" = insertvalue ") ; e.w(sty) ; e.w(" ") ; e.w(s1) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(l) ; e.w(", 1\n")
			e.w("  ") ; e.w(reg) ; e.w(" = insertvalue ") ; e.w(sty) ; e.w(" ") ; e.w(s2) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(ca) ; e.w(", 2\n")
			return
		}
		if len(c.Call.Args) > 2 {
			src := e.operand(c.Call.Args[0])
			elemType := ""
			if sl, ok := SafeUnderlying(c.Call.Args[0].SSAType()).(*Slice); ok {
				elemType = e.llvmType(sl.Elem)
			}
			if sl, ok := c.Call.Args[0].SSAType().(*Slice); ok && (elemType == "" || elemType == "void") {
				elemType = e.llvmType(sl.Elem)
			}
			if elemType == "" || elemType == "void" {
				et := e.llvmType(c.Call.Args[1].SSAType())
				if et != "" && et != "void" {
					elemType = et
				} else {
					elemType = "i8"
				}
			}
			nElems := len(c.Call.Args) - 1
			arrAlloca := e.nextReg2("ap")
			arrTy := "[" | irItoa(nElems) | " x " | elemType | "]"
			e.w("  ") ; e.w(arrAlloca) ; e.w(" = alloca ") ; e.w(arrTy) ; e.w("\n")
			for j := 1; j < len(c.Call.Args); j++ {
				elemVal := e.operand(c.Call.Args[j])
				argLLT := e.llvmType(c.Call.Args[j].SSAType())
				if len(argLLT) > 1 && argLLT[0] == 'i' && len(elemType) > 1 && elemType[0] == 'i' && argLLT != elemType {
					aw := irParseIntWidth(argLLT)
					ew := irParseIntWidth(elemType)
					if ew > 0 && aw > ew {
						tr := e.nextReg2("ap")
						e.w("  ") ; e.w(tr) ; e.w(" = trunc ") ; e.w(argLLT) ; e.w(" ") ; e.w(elemVal) ; e.w(" to ") ; e.w(elemType) ; e.w("\n")
						elemVal = tr
					}
				}
				gep := e.nextReg2("ap")
				e.w("  ") ; e.w(gep) ; e.w(" = getelementptr inbounds ") ; e.w(arrTy)
				e.w(", ptr ") ; e.w(arrAlloca) ; e.w(", i32 0, i32 ") ; e.w(irItoa(j-1)) ; e.w("\n")
				e.w("  store ") ; e.w(elemType) ; e.w(" ") ; e.w(elemVal) ; e.w(", ptr ") ; e.w(gep) ; e.w("\n")
			}
			srcBuf := e.nextReg2("ap")
			e.w("  ") ; e.w(srcBuf) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(src) ; e.w(", 0\n")
			srcLen := e.nextReg2("ap")
			e.w("  ") ; e.w(srcLen) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(src) ; e.w(", 1\n")
			srcCap := e.nextReg2("ap")
			e.w("  ") ; e.w(srcCap) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(src) ; e.w(", 2\n")
			elemSz := e.nextReg2("ap")
			e.w("  ") ; e.w(elemSz)
			e.w(" = ptrtoint ptr getelementptr (") ; e.w(elemType)
			e.w(", ptr null, i32 1) to ") ; e.w(e.intptrType()) ; e.w("\n")
			retTy := e.sliceType()
			result := e.nextReg2("ap")
			e.w("  ") ; e.w(result)
			e.w(" = call ") ; e.w(retTy) ; e.w(" @runtime.slicePush(ptr ")
			e.w(srcBuf)
			e.w(", ") ; e.w(e.intptrType()) ; e.w(" ") ; e.w(srcLen)
			e.w(", ") ; e.w(e.intptrType()) ; e.w(" ") ; e.w(srcCap)
			e.w(", ") ; e.w(e.intptrType()) ; e.w(" ") ; e.w(irItoa(nElems))
			e.w(", ") ; e.w(e.intptrType()) ; e.w(" ") ; e.w(elemSz)
			e.w(", ptr null)\n")
			newPtr := e.nextReg2("ap")
			e.w("  ") ; e.w(newPtr) ; e.w(" = extractvalue ") ; e.w(retTy) ; e.w(" ") ; e.w(result) ; e.w(", 0\n")
			newLen := e.nextReg2("ap")
			e.w("  ") ; e.w(newLen) ; e.w(" = extractvalue ") ; e.w(retTy) ; e.w(" ") ; e.w(result) ; e.w(", 1\n")
			newCap := e.nextReg2("ap")
			e.w("  ") ; e.w(newCap) ; e.w(" = extractvalue ") ; e.w(retTy) ; e.w(" ") ; e.w(result) ; e.w(", 2\n")
			dstPtr := e.nextReg2("ap")
			e.w("  ") ; e.w(dstPtr) ; e.w(" = getelementptr inbounds ") ; e.w(elemType) ; e.w(", ptr ") ; e.w(newPtr) ; e.w(", ") ; e.w(e.intptrType()) ; e.w(" ") ; e.w(srcLen) ; e.w("\n")
			nBytes := e.nextReg2("ap")
			e.w("  ") ; e.w(nBytes) ; e.w(" = mul ") ; e.w(e.intptrType()) ; e.w(" ") ; e.w(irItoa(nElems)) ; e.w(", ") ; e.w(elemSz) ; e.w("\n")
			e.w("  call void @runtime.memmove(ptr ") ; e.w(dstPtr) ; e.w(", ptr ") ; e.w(arrAlloca) ; e.w(", ") ; e.w(e.intptrType()) ; e.w(" ") ; e.w(nBytes) ; e.w(", ptr null)\n")
			s1 := e.nextReg2("ap")
			e.w("  ") ; e.w(s1) ; e.w(" = insertvalue ") ; e.w(sty) ; e.w(" undef, ptr ") ; e.w(newPtr) ; e.w(", 0\n")
			s2 := e.nextReg2("ap")
			e.w("  ") ; e.w(s2) ; e.w(" = insertvalue ") ; e.w(sty) ; e.w(" ") ; e.w(s1) ; e.w(", ") ; e.w(e.intptrType()) ; e.w(" ") ; e.w(newLen) ; e.w(", 1\n")
			e.w("  ") ; e.w(reg) ; e.w(" = insertvalue ") ; e.w(sty) ; e.w(" ") ; e.w(s2) ; e.w(", ") ; e.w(e.intptrType()) ; e.w(" ") ; e.w(newCap) ; e.w(", 2\n")
			e.declareRuntime("runtime.slicePush", retTy, "ptr, " | e.intptrType() | ", " | e.intptrType() | ", " | e.intptrType() | ", " | e.intptrType())
			e.declareRuntime("runtime.memmove", "void", "ptr, ptr, " | e.intptrType())
			return
		}
		if len(c.Call.Args) == 2 {
			src := e.operand(c.Call.Args[0])
			elems := e.operand(c.Call.Args[1])
			elemType := ""
			arg0t := c.Call.Args[0].SSAType()
			if sl, ok := SafeUnderlying(arg0t).(*Slice); ok {
				elemType = e.llvmType(sl.Elem)
			}
			if sl, ok := arg0t.(*Slice); ok && (elemType == "" || elemType == "void") {
				elemType = e.llvmType(sl.Elem)
			}
			if elemType == "" || elemType == "void" {
				// A spread source's ELEMENT type is the destination's element
				// type - the builder has already checked assignability - so for
				// push(dst, src...) it, and never the source's own type, is the
				// only sound fallback. The destination expression can reach here
				// with an SSA type that has no element under it:
				// push(priv.mlkem.Encapsulator().Bytes(), ecdhShares[0].data...)
				// fell through with the destination unresolved, so the element
				// type became the SOURCE SLICE type (24 bytes), slicePush grew
				// to 1184*24 bytes and the memmove landed at newPtr+28416
				// instead of newPtr+1184. The 32-byte X25519 share arrived as
				// zeros and every post-quantum handshake died with "tls: invalid
				// client key share" (open-work.md round 268, W9).
				fallback := ""
				if c.Call.HasDots {
					if sl1, ok1 := SafeUnderlying(c.Call.Args[1].SSAType()).(*Slice); ok1 {
						fallback = e.llvmType(sl1.Elem)
					}
				} else {
					fallback = e.llvmType(c.Call.Args[1].SSAType())
				}
				if fallback != "" && fallback != "void" {
					elemType = fallback
				} else {
					elemType = "i8"
				}
			}
			srcBuf := e.nextReg2("ap")
			e.w("  ") ; e.w(srcBuf) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(src) ; e.w(", 0\n")
			srcLen := e.nextReg2("ap")
			e.w("  ") ; e.w(srcLen) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(src) ; e.w(", 1\n")
			srcCap := e.nextReg2("ap")
			e.w("  ") ; e.w(srcCap) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(src) ; e.w(", 2\n")
			var elemsBuf, elemsLen string
			arg1IsSlice := c.Call.HasDots
			if !arg1IsSlice && c.Call.Args[1] != nil {
				arg1t := c.Call.Args[1].SSAType()
				if arg1t != nil {
					arg1LT := e.llvmType(arg1t)
					if arg1LT == e.sliceType() && elemType != e.sliceType() {
						arg1IsSlice = true
					}
				}
				if !arg1IsSlice {
					arg0t2 := c.Call.Args[0].SSAType()
					if arg0t2 != nil && arg1t != nil {
						if Identical(arg0t2, arg1t) {
							if _, ok := SafeUnderlying(arg0t2).(*Slice); ok {
								arg1IsSlice = true
							}
						}
					}
				}
			}
			if arg1IsSlice {
				elemsBuf = e.nextReg2("ap")
				e.w("  ") ; e.w(elemsBuf) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(elems) ; e.w(", 0\n")
				elemsLen = e.nextReg2("ap")
				e.w("  ") ; e.w(elemsLen) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(elems) ; e.w(", 1\n")
			} else {
				alloca := e.nextReg2("ap")
				e.w("  ") ; e.w(alloca) ; e.w(" = alloca ") ; e.w(elemType) ; e.w("\n")
				e.w("  store ") ; e.w(elemType) ; e.w(" ") ; e.w(elems) ; e.w(", ptr ") ; e.w(alloca) ; e.w("\n")
				elemsBuf = alloca
				elemsLen = "1"
			}
			elemSz := e.nextReg2("ap")
			e.w("  ") ; e.w(elemSz)
			e.w(" = ptrtoint ptr getelementptr (") ; e.w(elemType)
			e.w(", ptr null, i32 1) to ") ; e.w(e.intptrType()) ; e.w("\n")
			retTy := e.sliceType()
			result := e.nextReg2("ap")
			e.w("  ") ; e.w(result)
			e.w(" = call ") ; e.w(retTy) ; e.w(" @runtime.slicePush(ptr ")
			e.w(srcBuf)
			e.w(", ") ; e.w(e.intptrType()) ; e.w(" ") ; e.w(srcLen)
			e.w(", ") ; e.w(e.intptrType()) ; e.w(" ") ; e.w(srcCap)
			e.w(", ") ; e.w(e.intptrType()) ; e.w(" ") ; e.w(elemsLen)
			e.w(", ") ; e.w(e.intptrType()) ; e.w(" ") ; e.w(elemSz)
			e.w(", ptr null)\n")
			newPtr := e.nextReg2("ap")
			e.w("  ") ; e.w(newPtr) ; e.w(" = extractvalue ") ; e.w(retTy) ; e.w(" ") ; e.w(result) ; e.w(", 0\n")
			newLen := e.nextReg2("ap")
			e.w("  ") ; e.w(newLen) ; e.w(" = extractvalue ") ; e.w(retTy) ; e.w(" ") ; e.w(result) ; e.w(", 1\n")
			newCap := e.nextReg2("ap")
			e.w("  ") ; e.w(newCap) ; e.w(" = extractvalue ") ; e.w(retTy) ; e.w(" ") ; e.w(result) ; e.w(", 2\n")
			dstPtr := e.nextReg2("ap")
			e.w("  ") ; e.w(dstPtr) ; e.w(" = getelementptr inbounds ") ; e.w(elemType) ; e.w(", ptr ") ; e.w(newPtr) ; e.w(", ") ; e.w(e.intptrType()) ; e.w(" ") ; e.w(srcLen) ; e.w("\n")
			nBytes := e.nextReg2("ap")
			e.w("  ") ; e.w(nBytes) ; e.w(" = mul ") ; e.w(e.intptrType()) ; e.w(" ") ; e.w(elemsLen) ; e.w(", ") ; e.w(elemSz) ; e.w("\n")
			e.w("  call void @runtime.memmove(ptr ") ; e.w(dstPtr) ; e.w(", ptr ") ; e.w(elemsBuf) ; e.w(", ") ; e.w(e.intptrType()) ; e.w(" ") ; e.w(nBytes) ; e.w(", ptr null)\n")
			s1 := e.nextReg2("ap")
			e.w("  ") ; e.w(s1) ; e.w(" = insertvalue ") ; e.w(sty) ; e.w(" undef, ptr ") ; e.w(newPtr) ; e.w(", 0\n")
			s2 := e.nextReg2("ap")
			e.w("  ") ; e.w(s2) ; e.w(" = insertvalue ") ; e.w(sty) ; e.w(" ") ; e.w(s1) ; e.w(", ") ; e.w(e.intptrType()) ; e.w(" ") ; e.w(newLen) ; e.w(", 1\n")
			e.w("  ") ; e.w(reg) ; e.w(" = insertvalue ") ; e.w(sty) ; e.w(" ") ; e.w(s2) ; e.w(", ") ; e.w(e.intptrType()) ; e.w(" ") ; e.w(newCap) ; e.w(", 2\n")
			e.declareRuntime("runtime.slicePush", retTy, "ptr, " | e.intptrType() | ", " | e.intptrType() | ", " | e.intptrType() | ", " | e.intptrType())
			e.declareRuntime("runtime.memmove", "void", "ptr, ptr, " | e.intptrType())
			return
		}
	} else if name == "copy" {
		if len(c.Call.Args) == 2 {
			dst := e.operand(c.Call.Args[0])
			src := e.operand(c.Call.Args[1])
			elemType := "i8"
			if sl, ok := SafeUnderlying(c.Call.Args[0].SSAType()).(*Slice); ok {
				elemType = e.llvmType(sl.Elem)
			}
			dstBuf := e.nextReg2("cp")
			e.w("  ") ; e.w(dstBuf) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(dst) ; e.w(", 0\n")
			dstLen := e.nextReg2("cp")
			e.w("  ") ; e.w(dstLen) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(dst) ; e.w(", 1\n")
			srcBuf := e.nextReg2("cp")
			e.w("  ") ; e.w(srcBuf) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(src) ; e.w(", 0\n")
			srcLen := e.nextReg2("cp")
			e.w("  ") ; e.w(srcLen) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(src) ; e.w(", 1\n")
			elemSz := e.nextReg2("cp")
			e.w("  ") ; e.w(elemSz)
			e.w(" = ptrtoint ptr getelementptr (") ; e.w(elemType)
			e.w(", ptr null, i32 1) to ") ; e.w(e.intptrType()) ; e.w("\n")
			callReg := e.nextReg2("cp")
			e.w("  ") ; e.w(callReg)
			e.w(" = call ") ; e.w(e.intptrType()) ; e.w(" @runtime.sliceCopy(ptr ")
			e.w(dstBuf) ; e.w(", ptr ") ; e.w(srcBuf)
			e.w(", ") ; e.w(e.intptrType()) ; e.w(" ") ; e.w(dstLen)
			e.w(", ") ; e.w(e.intptrType()) ; e.w(" ") ; e.w(srcLen)
			e.w(", ") ; e.w(e.intptrType()) ; e.w(" ") ; e.w(elemSz)
			e.w(", ptr null)\n")
			rt8 := e.llvmType(c.SSAType())
			if rt8 != e.intptrType() {
				e.w("  ") ; e.w(reg) ; e.w(" = trunc ") ; e.w(e.intptrType()) ; e.w(" ") ; e.w(callReg) ; e.w(" to ") ; e.w(rt8) ; e.w("\n")
			} else {
				e.w("  ") ; e.w(reg) ; e.w(" = add ") ; e.w(e.intptrType()) ; e.w(" ") ; e.w(callReg) ; e.w(", 0\n")
			}
			e.declareRuntime("runtime.sliceCopy", e.intptrType(), "ptr, ptr, " | e.intptrType() | ", " | e.intptrType() | ", " | e.intptrType())
			return
		}
	} else if name == "clear" {
		if len(c.Call.Args) == 1 {
			arg := e.operand(c.Call.Args[0])
			at := c.Call.Args[0].SSAType()
			u := SafeUnderlying(at)
			if u == nil {
				u = at
			}
			if _, isMap := u.(*TCMap); isMap {
				e.w("  call void @runtime.hashmapClear(ptr ") ; e.w(arg) ; e.w(", ptr null)\n")
				e.declareRuntime("runtime.hashmapClear", "void", "ptr")
				return
			}
			sl, isSlice := u.(*Slice)
			if isSlice && sl.Elem != nil {
				buf := e.nextReg2("cl")
				e.w("  ") ; e.w(buf) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(arg) ; e.w(", 0\n")
				ln := e.nextReg2("cl")
				e.w("  ") ; e.w(ln) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(arg) ; e.w(", 1\n")
				esz := e.nextReg2("cl")
				e.w("  ") ; e.w(esz) ; e.w(" = ptrtoint ptr getelementptr (") ; e.w(e.llvmType(sl.Elem)) ; e.w(", ptr null, i32 1) to ") ; e.w(ipt) ; e.w("\n")
				nb := e.nextReg2("cl")
				e.w("  ") ; e.w(nb) ; e.w(" = mul ") ; e.w(ipt) ; e.w(" ") ; e.w(ln) ; e.w(", ") ; e.w(esz) ; e.w("\n")
				e.w("  call void @llvm.memset.p0.") ; e.w(ipt) ; e.w("(ptr ") ; e.w(buf)
				e.w(", i8 0, ") ; e.w(ipt) ; e.w(" ") ; e.w(nb) ; e.w(", i1 false)\n")
				e.declareIntrinsic("llvm.memset.p0." | ipt, "void", "ptr, i8, " | ipt | ", i1")
				return
			}
			// Legacy rejects clear on anything but a slice or a map. Dropping
			// the call silently is what hid the missing lowering in the first
			// place, so say so instead.
			tn := "unknown"
			if at != nil {
				tn = at.String()
			}
			reportCompileError("unsupported type in clear builtin: " | tn)
			cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
			push(cctx.compileErrors, "unsupported type in clear builtin: " | tn)
			return
		}
	} else if name == "print" || name == "println" {
		e.w("  call void @runtime.printlock(ptr null)\n")
		for i, arg := range c.Call.Args {
			if i > 0 && b.id == BuiltinPrintln {
				e.w("  call void @runtime.printspace(ptr null)\n")
			}
			av := e.operand(arg)
			at := arg.SSAType()
			e.emitPrintArg(av, at)
		}
		if b.id == BuiltinPrintln {
			e.w("  call void @runtime.printnl(ptr null)\n")
			e.declareRuntime("runtime.printnl", "void", "")
		}
		e.w("  call void @runtime.printunlock(ptr null)\n")
		e.declareRuntime("runtime.printlock", "void", "")
		e.declareRuntime("runtime.printunlock", "void", "")
		if b.id == BuiltinPrintln && len(c.Call.Args) > 1 {
			e.declareRuntime("runtime.printspace", "void", "")
		}
		return
	} else if name == "delete" {
		if len(c.Call.Args) == 2 {
			mapVal := e.operand(c.Call.Args[0])
			keyVal := e.operand(c.Call.Args[1])
			mt, _ := SafeUnderlying(c.Call.Args[0].SSAType()).(*TCMap)
			keyType := "i32"
			if mt != nil {
				keyType = e.llvmType(mt.Key)
			} else if c.Call.Args[1].SSAType() != nil {
				keyType = e.llvmType(c.Call.Args[1].SSAType())
			}
			if mt != nil && e.isStringLike(mt.Key) {
				// Key by value as a string: see ir_map.mx emitSet.
				e.w("  call void @runtime.hashmapContentDelete(ptr ") ; e.w(mapVal)
				e.w(", ") ; e.w(e.sliceType()) ; e.w(" ") ; e.w(keyVal)
				e.w(", ptr null)\n")
				e.declareRuntime("runtime.hashmapContentDelete", "void", "ptr, " | e.sliceType())
			} else {
				keyAlloca := e.nextReg2("dl")
				e.w("  ") ; e.w(keyAlloca) ; e.w(" = alloca ") ; e.w(keyType) ; e.w("\n")
				e.w("  store ") ; e.w(keyType) ; e.w(" ") ; e.w(keyVal) ; e.w(", ptr ") ; e.w(keyAlloca) ; e.w("\n")
				e.w("  call void @runtime.hashmapBinaryDelete(ptr ") ; e.w(mapVal)
				e.w(", ptr ") ; e.w(keyAlloca) ; e.w(", ptr null)\n")
				e.declareRuntime("runtime.hashmapBinaryDelete", "void", "ptr, ptr")
			}
			return
		}
	} else if name == "close" {
		if len(c.Call.Args) == 1 {
			e.w("  call void @runtime.chanClose(ptr ")
			e.w(e.operand(c.Call.Args[0]))
			e.w(", ptr null)\n")
			e.declareRuntime("runtime.chanClose", "void", "ptr")
			return
		}
	} else if name == "min" || name == "max" {
		if len(c.Call.Args) >= 2 {
			rt9 := e.llvmType(c.SSAType())
			if rt9 == "" || rt9 == "void" {
				rt9 = "i32"
			}
			a := e.operand(c.Call.Args[0])
			b2 := e.operand(c.Call.Args[1])
			cmpOp := "slt"
			if b.id == BuiltinMax {
				cmpOp = "sgt"
			}
			u := SafeUnderlying(c.SSAType())
			if bb, ok := u.(*Basic); ok && bb.Info&IsUnsigned != 0 {
				cmpOp = "ult"
				if b.id == BuiltinMax {
					cmpOp = "ugt"
				}
			}
			e.nextReg++
			cmpReg := "%mm" | irItoa(e.nextReg)
			e.w("  ") ; e.w(cmpReg) ; e.w(" = icmp ") ; e.w(cmpOp) ; e.w(" ") ; e.w(rt9) ; e.w(" ") ; e.w(a) ; e.w(", ") ; e.w(b2) ; e.w("\n")
			e.w("  ") ; e.w(reg) ; e.w(" = select i1 ") ; e.w(cmpReg) ; e.w(", ") ; e.w(rt9) ; e.w(" ") ; e.w(a) ; e.w(", ") ; e.w(rt9) ; e.w(" ") ; e.w(b2) ; e.w("\n")
			return
		}
	} else if name == "spawn" {
		e.emitSpawnCall(c)
		return
	} else if name == "__shutdown" {
		// The termination channel belongs to the runtime, created in the root
		// arena at startup; the word only names it.
		e.w("  ") ; e.w(reg) ; e.w(" = call ptr @runtime.ShutdownChan(ptr null)\n")
		e.declareRuntime("runtime.ShutdownChan", "ptr", "")
		return
	} else if name == "pop" {
		if len(c.Call.Args) == 1 {
			src := e.operand(c.Call.Args[0])
			p := e.nextReg2("po")
			e.w("  ") ; e.w(p) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(src) ; e.w(", 0\n")
			l := e.nextReg2("po")
			e.w("  ") ; e.w(l) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(src) ; e.w(", 1\n")
			ca := e.nextReg2("po")
			e.w("  ") ; e.w(ca) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(src) ; e.w(", 2\n")
			e.w("  call void @runtime.sliceCheckPop(") ; e.w(ipt) ; e.w(" ") ; e.w(l) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(ca) ; e.w(", ptr null)\n")
			e.declareRuntime("runtime.sliceCheckPop", "void", ipt | ", " | ipt)
			li := e.nextReg2("po")
			e.w("  ") ; e.w(li) ; e.w(" = sub ") ; e.w(ipt) ; e.w(" ") ; e.w(l) ; e.w(", 1\n")
			var elemType string
			if sl, ok := SafeUnderlying(c.Call.Args[0].SSAType()).(*Slice); ok {
				elemType = e.llvmType(sl.Elem)
			} else {
				elemType = "i8"
			}
			ep := e.nextReg2("po")
			e.w("  ") ; e.w(ep) ; e.w(" = getelementptr inbounds ") ; e.w(elemType) ; e.w(", ptr ") ; e.w(p) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(li) ; e.w("\n")
			e.w("  ") ; e.w(reg) ; e.w(" = load ") ; e.w(elemType) ; e.w(", ptr ") ; e.w(ep) ; e.w("\n")
		}
		return
	} else if name == "resize" {
		if len(c.Call.Args) == 2 {
			src := e.operand(c.Call.Args[0])
			sp := e.nextReg2("rs")
			e.w("  ") ; e.w(sp) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(src) ; e.w(", 0\n")
			curLen := e.nextReg2("rs")
			e.w("  ") ; e.w(curLen) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(src) ; e.w(", 1\n")
			ca := e.nextReg2("rs")
			e.w("  ") ; e.w(ca) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(src) ; e.w(", 2\n")
			newLen := e.operand(c.Call.Args[1])
			lt := e.llvmType(c.Call.Args[1].SSAType())
			var nlVal string
			if lt != ipt {
				// The slice length field is uintptr-width, so this argument is
				// widened - and on a 32-bit target a 64-bit one must be
				// NARROWED, which is a trunc. A blanket sext made the whole
				// module invalid there:
				//   net_http_internal.ll:233:16: error: invalid cast opcode
				//   for cast from 'i64' to 'i32'
				//   %rs51 = sext i64 %t82 to i32
				// It cannot happen natively, where uintptr is i64 and no
				// conversion is emitted at all, which is why only the wasm
				// sweep saw it.
				nlVal = e.nextReg2("rs")
				srcBits := e.intBits(lt)
				dstBits := e.intBits(ipt)
				op := "zext"
				if srcBits > dstBits {
					op = "trunc"
				}
				e.w("  ") ; e.w(nlVal) ; e.w(" = ") ; e.w(op) ; e.w(" ") ; e.w(lt) ; e.w(" ") ; e.w(newLen) ; e.w(" to ") ; e.w(ipt) ; e.w("\n")
			} else {
				nlVal = newLen
			}
			e.w("  call void @runtime.sliceCheckResize(") ; e.w(ipt) ; e.w(" ") ; e.w(nlVal) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(curLen) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(ca) ; e.w(", ptr null)\n")
			e.declareRuntime("runtime.sliceCheckResize", "void", ipt | ", " | ipt | ", " | ipt)
			s1 := e.nextReg2("rs")
			e.w("  ") ; e.w(s1) ; e.w(" = insertvalue ") ; e.w(sty) ; e.w(" undef, ptr ") ; e.w(sp) ; e.w(", 0\n")
			s2 := e.nextReg2("rs")
			e.w("  ") ; e.w(s2) ; e.w(" = insertvalue ") ; e.w(sty) ; e.w(" ") ; e.w(s1) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(nlVal) ; e.w(", 1\n")
			e.w("  ") ; e.w(reg) ; e.w(" = insertvalue ") ; e.w(sty) ; e.w(" ") ; e.w(s2) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(ca) ; e.w(", 2\n")
		}
		return
	}
	e.w("  ; unhandled builtin: ")
	e.w(name)
	e.w("\n")
	rt10 := e.llvmType(c.SSAType())
	if rt10 != "void" && rt10 != "" {
		if rt10 == "ptr" || e.intBits(rt10) > 0 || rt10 == "i1" {
			e.emitZeroReg(reg, c.SSAType())
		} else {
			e.nextReg++
			tmp := "%ub" | irItoa(e.nextReg)
			e.w("  ") ; e.w(tmp) ; e.w(" = alloca ") ; e.w(rt10) ; e.w("\n")
			e.w("  ") ; e.w(reg) ; e.w(" = load ") ; e.w(rt10) ; e.w(", ptr ") ; e.w(tmp) ; e.w("\n")
			e.allocTypes[c] = rt10
		}
	}
}

func (e *irEmitter) emitPrintArg(val string, t Type) {
	if t == nil {
		return
	}
	sty := e.sliceType()
	switch u := SafeUnderlying(t).(type) {
	case *Basic:
		switch {
		case u.Info&IsString != 0:
			e.w("  call void @runtime.printstring(") ; e.w(sty) ; e.w(" ") ; e.w(val) ; e.w(", ptr null)\n")
			e.declareRuntime("runtime.printstring", "void", sty)
		case u.Kind == Bool || u.Kind == UntypedBool:
			e.w("  call void @runtime.printbool(i1 ") ; e.w(val) ; e.w(", ptr null)\n")
			e.declareRuntime("runtime.printbool", "void", "i1")
		case u.Kind == Float32:
			e.w("  call void @runtime.printfloat32(float ") ; e.w(val) ; e.w(", ptr null)\n")
			e.declareRuntime("runtime.printfloat32", "void", "float")
		case u.Kind == Float64 || u.Kind == UntypedFloat:
			e.w("  call void @runtime.printfloat64(double ") ; e.w(val) ; e.w(", ptr null)\n")
			e.declareRuntime("runtime.printfloat64", "void", "double")
		case u.Info&IsUnsigned != 0:
			lt := e.llvmType(t)
			fname := "runtime.printuint" | lt[1:]
			e.w("  call void @") ; e.w(fname) ; e.w("(") ; e.w(lt) ; e.w(" ") ; e.w(val) ; e.w(", ptr null)\n")
			e.declareRuntime(fname, "void", lt)
		case u.Info&IsInteger != 0:
			lt := e.llvmType(t)
			fname := "runtime.printint" | lt[1:]
			e.w("  call void @") ; e.w(fname) ; e.w("(") ; e.w(lt) ; e.w(" ") ; e.w(val) ; e.w(", ptr null)\n")
			e.declareRuntime(fname, "void", lt)
		}
	case *Pointer:
		ipt := e.intptrType()
		e.nextReg++
		tmp := "%pr" | irItoa(e.nextReg)
		e.w("  ") ; e.w(tmp) ; e.w(" = ptrtoint ptr ") ; e.w(val) ; e.w(" to ") ; e.w(ipt) ; e.w("\n")
		e.w("  call void @runtime.printptr(") ; e.w(ipt) ; e.w(" ") ; e.w(tmp) ; e.w(", ptr null)\n")
		e.declareRuntime("runtime.printptr", "void", ipt)
	case *Slice:
		if b, ok := u.Elem.(*Basic); ok && (b.Kind == Uint8 || b.Kind == Int8) {
			e.w("  call void @runtime.printbytes(") ; e.w(sty) ; e.w(" ") ; e.w(val) ; e.w(", ptr null)\n")
			e.declareRuntime("runtime.printbytes", "void", sty)
		} else {
			e.w("  call void @runtime.printstring(") ; e.w(sty) ; e.w(" ") ; e.w(val) ; e.w(", ptr null)\n")
			e.declareRuntime("runtime.printstring", "void", sty)
		}
	case *TCMap:
		e.w("  call void @runtime.printmap(ptr ") ; e.w(val) ; e.w(", ptr null)\n")
		e.declareRuntime("runtime.printmap", "void", "ptr")
	}
}

// emitSpawnCall emits the native spawn(fn, args...) builtin. Mirrors the
// legacy compiler's createSpawn: pack the data args into a struct buffer,
// emit a goroutine-start wrapper that unpacks them and calls the target,
// call runtime.spawnDomain, mark each channel arg pipe-bound on the parent
// side, wait for the child to be ready, and return the lifecycle channel.
// isSpawnTargetSig reports whether sig is the declared shape of a spawned
// function: exactly one result, NAMED `closed`, of type chan []byte. That result
// is the domain's breaker - the same channel spawn returns - and its name and
// type together are what mark the function as a spawn target.
func isSpawnTargetSig(sig *Signature) (ok bool) {
	if sig == nil || sig.Results == nil || sig.Results.Len() != 1 {
		return false
	}
	r := sig.Results.At(0)
	if r == nil || r.Typ == nil {
		return false
	}
	// The result must be NAMED `closed`, and it must be the only one. That name
	// is the entry point's whole contract: `closed` is the predeclared word a
	// spawn target selects on, and the runtime binds the domain's breaker into
	// it. Matching the shape alone made every ordinary function that happens to
	// return a `chan []byte` a spawn target, so calling it directly died in its
	// prologue with "spawn target called directly".
	if r.Name != "closed" && !sig.TargetDeclared {
		return false
	}
	ch, ok := SafeUnderlying(r.Typ).(*TCChan)
	if !ok || ch.Dir != TCSendRecv {
		return false
	}
	// The breaker is a signal, so its element is the empty struct: nothing is
	// ever sent on it, and a close is the whole message.
	st, okSt := SafeUnderlying(ch.Elem).(*TCStruct)
	return okSt && st != nil && st.NumFields() == 0
}

// terminationConsumed reports whether fn consumes a termination signal from
// chanVal, or - when wantShutdown is set - from the shutdown builtin's channel.
//
// A select arm is the intended shape, but a SINGLE-ARM select is lowered by the
// builder into a plain receive, so requiring an SSASelect instruction would
// refuse correct code that this compiler itself produced. The rule is about the
// signal being consumed, and either shape satisfies it.
func terminationConsumed(fn *SSAFunction, chanVal SSAValue, wantShutdown bool) (ok bool) {
	if fn == nil || len(fn.Blocks) == 0 {
		return true
	}
	for _, blk := range fn.Blocks {
		for _, instr := range blk.Instrs {
			switch in := instr.(type) {
			case *SSASelect:
				for _, st := range in.States {
					if termChannelMatches(st.Chan, chanVal, wantShutdown) {
						return true
					}
				}
			case *SSAUnOp:
				if in.Op == OpArrow && termChannelMatches(in.X, chanVal, wantShutdown) {
					return true
				}
			}
		}
	}
	return false
}

// termChannelMatches reports whether ch names the termination channel.
func termChannelMatches(ch, chanVal SSAValue, wantShutdown bool) (ok bool) {
	if wantShutdown {
		c, isCall := ch.(*SSACall)
		if !isCall {
			return false
		}
		bi, isBuiltin := c.Call.Value.(*SSABuiltin)
		return isBuiltin && bi.SSAName() == "__shutdown"
	}
	if ch == chanVal {
		return true
	}
	if u, isUnop := ch.(*SSAUnOp); isUnop && u.X == chanVal {
		return true
	}
	return false
}

// targetSelectsOnClosed reports whether a spawn target consumes its own closed
// breaker's termination signal: the target's named result IS that breaker, and
// the operand is a load of it.
func targetSelectsOnClosed(fn *SSAFunction) (ok bool) {
	if fn == nil || len(fn.Blocks) == 0 {
		return true
	}
	if !isSpawnTargetSig(fn.Signature) || len(fn.NamedResults) == 0 {
		return false
	}
	return terminationConsumed(fn, fn.NamedResults[0], false)
}

// checkTerminationSelects enforces the two entry-point rules on a package's
// SSA, after the whole package has been built and before the emission gate:
//
//   - the PROGRAM entry (the main function of the package named main) selects
//     on shutdown, because a program that cannot be told to stop has to be killed;
//   - every function passed to spawn selects on its closed breaker, because a
//     spawned domain must stop when its parent closes the breaker, not when its
//     next message happens to arrive.
//
// It runs here rather than at emission because an error recorded during
// emission is printed after the package has already been judged compilable -
// the errors list is read exactly once, before the emitter runs.
func checkTerminationSelects(pkg *SSAPackage) {
	if pkg == nil || pkg.Members == nil {
		return
	}
	for _, m := range pkg.Members {
		fn, isFn := m.(*SSAFunction)
		if !isFn {
			continue
		}
		if fn.name == "main" && pkg.Pkg != nil && pkg.Pkg.Name == "main" && !terminationConsumed(fn, nil, true) {
			reportCompileError("main must select on shutdown: add a `case <-shutdown:` arm to its select (or a non-blocking one at entry for a batch program), because a program that cannot be told to stop has to be killed")
		}
		checkSpawnCalls(fn)
	}
}

// checkSpawnCalls walks one function body for spawn calls and checks each static
// target: it must select on its closed breaker, and it must not reach a channel
// through a package global (the channels of a spawned domain are its
// parameters).
func checkSpawnCalls(fn *SSAFunction) {
	if fn == nil {
		return
	}
	for _, blk := range fn.Blocks {
		for _, instr := range blk.Instrs {
			c, isCall := instr.(*SSACall)
			if !isCall {
				continue
			}
			bi, isBuiltin := c.Call.Value.(*SSABuiltin)
			if !isBuiltin || bi.SSAName() != "spawn" || len(c.Call.Args) == 0 {
				continue
			}
			target, isFn := c.Call.Args[0].(*SSAFunction)
			if !isFn || target == nil {
				continue
			}
			if !targetSelectsOnClosed(target) {
				reportCompileError("spawn: " | target.name | " never selects on its closed breaker; a spawned domain must handle termination, so its loop selects on <-closed and returns the breaker")
				continue
			}
			if gname, found := spawnTargetChannelGlobal(target); found {
				reportCompileError("spawn: " | target.name | " reads channel global " | gname | "; a spawned domain's channels must be its parameters, so pass it through the spawn call")
			}
			if mxutil.TargetArch() == "wasm" {
				checkWasmSpawnValueParams(target)
			}
		}
	}
}

// checkWasmSpawnValueParams refuses a value parameter whose bytes carry a
// pointer or a slice header on the wasm target. A wasm domain has its own
// linear memory, so such a value would cross as an address into the parent's
// memory, which the child cannot read. The native path copies the graph through
// the codec and decodes it on the child side; that decode does not exist on the
// wasm boundary yet, so the compiler refuses rather than handing the child a
// dangling header.
//
// Checked here, with the rest of the spawn rules, because the compiler reads
// its error list once, right after the SSA build: an error recorded while the
// wasm call is emitted is printed after the package was already accepted.
func checkWasmSpawnValueParams(target *SSAFunction) {
	if target == nil || target.Signature == nil || target.Signature.Params == nil {
		return
	}
	for pi := int32(0); pi < target.Signature.Params.Len(); pi++ {
		pt := target.Signature.Params.At(pi).Typ
		if pt == nil {
			continue
		}
		if _, isChan := SafeUnderlying(pt).(*TCChan); isChan {
			continue
		}
		if typeNeedsCodec(pt) {
			reportCompileError("spawn: wasm value parameter " | irItoa(pi+1) | " of " | target.name | " carries pointers or slices, which the wasm boundary cannot copy yet; pass it through a spawn channel")
		}
	}
}

// spawnTargetChannelGlobal reports the first channel-typed package global the
// target's body reads.
func spawnTargetChannelGlobal(fn *SSAFunction) (name string, found bool) {
	for _, blk := range fn.Blocks {
		for _, instr := range blk.Instrs {
			u, isUnop := instr.(*SSAUnOp)
			if !isUnop {
				continue
			}
			g, isGlobal := u.X.(*SSAGlobal)
			if !isGlobal {
				continue
			}
			if _, isChan := SafeUnderlying(g.typ).(*TCChan); isChan {
				return g.name, true
			}
		}
	}
	return "", false
}

// checkSpawnTarget enforces the spawn ABI: a parameter is either a channel (the
// domain's only route to another domain) or a static startup value frozen at the
// spawn call, and the function must not return a value - its termination breaker
// is the channel spawn returns. A channel reached through a package global is
// refused too: the channels of a spawned domain must be its parameters.
func (e *irEmitter) checkSpawnTarget(fn *SSAFunction) (ok bool) {
	if fn == nil || fn.Signature == nil {
		return true
	}
	sig := fn.Signature
	if !isSpawnTargetSig(sig) {
		reportCompileError("spawn: " | fn.name | " must be declared with exactly one result, (closed chan struct{}), which is the domain's breaker; a function without it cannot be spawned")
		return false
	}
	for _, blk := range fn.Blocks {
		for _, instr := range blk.Instrs {
			u, isUnop := instr.(*SSAUnOp)
			if !isUnop {
				continue
			}
			g, isGlobal := u.X.(*SSAGlobal)
			if !isGlobal {
				continue
			}
			if _, isChan := SafeUnderlying(g.typ).(*TCChan); isChan {
				reportCompileError("spawn: " | fn.name | " reads channel global " | g.name | "; a spawned domain's channels must be its parameters, so pass it through the spawn call")
				return false
			}
		}
	}
	if !targetSelectsOnClosed(fn) {
		reportCompileError("spawn: " | fn.name | " never selects on its closed breaker; a spawned domain must handle termination, so its loop selects on <-closed and returns the breaker")
		return false
	}
	return true
}

// spawnArgCopy hands one value parameter across the spawn boundary as a frozen
// copy: the runtime encodes it against the budget the compiler's cap-tag walk
// computes - the same walk that sizes a spawn channel's ring - panics if it does
// not fit, and decodes it into the root arena, so the child's slices and
// pointers do not point into this frame. Returns the value loaded out of the
// copy, which is what the startup bundle carries.
func (e *irEmitter) spawnArgCopy(t Type, val string) (reg string) {
	lt := e.llvmType(t)
	e.nextReg++
	alloca := "%spawnarg" | irItoa(e.nextReg)
	e.w("  ") ; e.w(alloca) ; e.w(" = alloca ") ; e.w(lt) ; e.w("\n")
	e.w("  store ") ; e.w(lt) ; e.w(" ") ; e.w(val) ; e.w(", ptr ") ; e.w(alloca) ; e.w("\n")
	budget := e.frameBudget(t, nil, 0)
	note := e.frameNote(t, "", "")
	notePtr := "ptr null"
	noteLen := "0"
	if len(note) > 0 {
		notePtr = "ptr " | e.strConstGlobal(e.addStringConst(note))
		noteLen = irItoa64(int64(len(note)))
	}
	desc := e.emitTypeDescFor(t)
	e.nextReg++
	copyReg := "%spawnargc" | irItoa(e.nextReg)
	e.w("  ") ; e.w(copyReg) ; e.w(" = call ptr @runtime.SpawnArgCopy(ptr ")
	e.w(alloca) ; e.w(", ptr ") ; e.w(desc) ; e.w(", i32 ") ; e.w(irItoa(budget))
	e.w(", ") ; e.w(notePtr) ; e.w(", i64 ") ; e.w(noteLen) ; e.w(", ptr null)\n")
	e.declareRuntime("runtime.SpawnArgCopy", "ptr", "ptr, ptr, i32, ptr, i64")
	e.nextReg++
	reg = "%spawnargv" | irItoa(e.nextReg)
	e.w("  ") ; e.w(reg) ; e.w(" = load ") ; e.w(lt) ; e.w(", ptr ") ; e.w(copyReg) ; e.w("\n")
	return reg
}

func (e *irEmitter) emitSpawnCall(c *SSACall) {
	if e.ptrBits == 32 {
		e.emitWasmSpawnCall(c)
		return
	}
	ipt := e.intptrType()
	targetFn, ok := c.Call.Args[0].(*SSAFunction)
	if !ok {
		e.emitZeroReg(e.regName(c), c.SSAType())
		return
	}
	if !e.checkSpawnTarget(targetFn) {
		e.emitZeroReg(e.regName(c), c.SSAType())
		return
	}
	if !e.isPkgFunc(targetFn) {
		e.declareExternalFunc(targetFn)
	}

	var argTypes []string
	var argVals []string
	var chanIdxs []int32
	nChans := int32(0)
	for i := 1; i < len(c.Call.Args); i++ {
		arg := c.Call.Args[i]
		lt := e.llvmType(arg.SSAType())
		if lt == "" || lt == "void" {
			lt = "ptr"
		}
		argTypes = mxutil.Ensure(argTypes, 1)
		push(argTypes, lt)
		argVals = mxutil.Ensure(argVals, 1)
		if _, isChan := SafeUnderlying(arg.SSAType()).(*TCChan); isChan {
			// Channels are shared: the child gets the same ring.
			push(argVals, e.operand(arg))
			chanIdxs = mxutil.Ensure(chanIdxs, 1)
			push(chanIdxs, int32(i-1))
			nChans++
		} else {
			// Values are copied: the runtime freezes the whole graph into the
			// root arena, refusing to if it does not fit its declared budget.
			push(argVals, e.spawnArgCopy(arg.SSAType(), e.operand(arg)))
		}
	}

	structTy := "{"
	for i, lt := range argTypes {
		if i > 0 {
			structTy = structTy | ", "
		}
		structTy = structTy | lt
	}
	structTy = structTy | "}"

	buf := e.nextReg2("sp")
	e.w("  ") ; e.w(buf) ; e.w(" = alloca ") ; e.w(structTy) ; e.w("\n")
	for i, av := range argVals {
		g := e.nextReg2("sp")
		e.w("  ") ; e.w(g) ; e.w(" = getelementptr inbounds ") ; e.w(structTy) ; e.w(", ptr ") ; e.w(buf) ; e.w(", i32 0, i32 ") ; e.w(irItoa(int32(i))) ; e.w("\n")
		e.w("  store ") ; e.w(argTypes[i]) ; e.w(" ") ; e.w(av) ; e.w(", ptr ") ; e.w(g) ; e.w("\n")
	}

	wrapperSym := e.emitSpawnWrapper(targetFn, argTypes, structTy, chanIdxs)

	// Note each channel's ring slot before the domain exists: spawnDomain sizes
	// each ring pair from the channel's declared depth and its compiler-computed
	// frame budget, both of which travel on the handle.
	for ci, ai := range chanIdxs {
		e.w("  call void @runtime.NoteSpawnChan(i32 ") ; e.w(irItoa(ci)) ; e.w(", ptr ") ; e.w(argVals[ai]) ; e.w(", ptr null)\n")
		e.declareRuntime("runtime.NoteSpawnChan", "void", "i32, ptr")
	}

	fnPtr := e.nextReg2("sp")
	e.w("  ") ; e.w(fnPtr) ; e.w(" = ptrtoint ptr ") ; e.w(wrapperSym) ; e.w(" to ") ; e.w(ipt) ; e.w("\n")
	e.w("  call void @runtime.spawnDomain(") ; e.w(ipt) ; e.w(" ") ; e.w(fnPtr)
	e.w(", ptr ") ; e.w(buf) ; e.w(", i32 ") ; e.w(irItoa(nChans)) ; e.w(", ptr null)\n")
	e.declareRuntime("runtime.spawnDomain", "void", ipt | ", ptr, i32")

	for ci, ai := range chanIdxs {
		e.w("  call void @runtime.MarkParentPipeChannel(ptr ") ; e.w(argVals[ai]) ; e.w(", i16 ") ; e.w(irItoa(int32(ci)+1)) ; e.w(", ptr null)\n")
		e.declareRuntime("runtime.MarkParentPipeChannel", "void", "ptr, i16")
	}

	e.w("  call i1 @runtime.PipeWaitChildReady(ptr null)\n")
	e.declareRuntime("runtime.PipeWaitChildReady", "i1", "")

	reg := e.regName(c)
	e.w("  ") ; e.w(reg) ; e.w(" = call ptr @runtime.SpawnLifecycleChannel(ptr null)\n")
	e.declareRuntime("runtime.SpawnLifecycleChannel", "ptr", "")
}

// emitSpawnWrapper emits (once) the goroutine-start wrapper for a spawn
// target: void @sym$gowrapper(ptr %args) that loads each packed arg, marks
// each channel arg child-side (MarkChildPipeChannel), signals ready
// (PipeChildReady), and calls the target with a null context. Returns the
// wrapper symbol. chanIdxs are the indices (into the arg list) of channel
// args in parameter order; chanID = position+1, matching the parent side.
func (e *irEmitter) emitSpawnWrapper(targetFn *SSAFunction, argTypes []string, structTy string, chanIdxs []int32) (sym string) {
	sym = irSymbolSuffix(e.funcSymbol(targetFn), "$gowrapper")
	if e.spawnWrappers[sym] {
		return sym
	}
	e.spawnWrappers[sym] = true

	// Generate the wrapper body into a scratch buffer and stash it for
	// package-tail emission: a `define` must not nest inside the caller's
	// body, and emitSpawnCall runs mid-function.
	savedSegs := e.segs
	savedBuf := e.buf
	e.segs = nil
	e.buf = nil

	e.w("\ndefine linkonce_odr void ") ; e.w(sym) ; e.w("(ptr %args) {\nentry:\n")
	var loaded []string
	for i, lt := range argTypes {
		g := e.nextReg2("gw")
		e.w("  ") ; e.w(g) ; e.w(" = getelementptr inbounds ") ; e.w(structTy) ; e.w(", ptr %args, i32 0, i32 ") ; e.w(irItoa(int32(i))) ; e.w("\n")
		ld := e.nextReg2("gw")
		e.w("  ") ; e.w(ld) ; e.w(" = load ") ; e.w(lt) ; e.w(", ptr ") ; e.w(g) ; e.w("\n")
		loaded = mxutil.Ensure(loaded, 1)
		push(loaded, ld)
	}

	// Child-side marks: bind each channel arg to its shared ring pair, then
	// signal the parent that the child is ready. These run in the child
	// process (the wrapper is only ever invoked by spawnDomain's child
	// branch); MarkChildPipeChannel no-ops when childSpawnTarget is false.
	for ci, ai := range chanIdxs {
		if ai < 0 || ai >= int32(len(loaded)) {
			continue
		}
		e.w("  call void @runtime.MarkChildPipeChannel(ptr ") ; e.w(loaded[ai]) ; e.w(", i16 ") ; e.w(irItoa(int32(ci)+1)) ; e.w(", ptr null)\n")
		e.declareRuntime("runtime.MarkChildPipeChannel", "void", "ptr, i16")
	}
	e.w("  call void @runtime.PipeChildReady(ptr null)\n")
	e.declareRuntime("runtime.PipeChildReady", "void", "")

	retType := e.funcRetType(targetFn)
	if retType == "" || retType == "void" {
		e.w("  call void ") ; e.w(e.funcSymbol(targetFn)) ; e.w("(")
	} else {
		callReg := e.nextReg2("gw")
		e.w("  ") ; e.w(callReg) ; e.w(" = call ") ; e.w(retType) ; e.w(" ") ; e.w(e.funcSymbol(targetFn)) ; e.w("(")
	}
	for i, ld := range loaded {
		if i > 0 { e.w(", ") }
		e.w(argTypes[i]) ; e.w(" ") ; e.w(ld)
	}
	if len(loaded) > 0 { e.w(", ") }
	e.w("ptr null)\n")
	e.w("  ret void\n}\n")

	e.assembleSegs()
	e.pendSpawnWrappers = mxutil.Ensure(e.pendSpawnWrappers, 1)
	push(e.pendSpawnWrappers, string(e.buf))
	e.buf = savedBuf
	e.segs = savedSegs
	return sym
}

// emitSpawnWrappers writes out all collected spawn wrapper IR. Called once
// at the package tail after emitTypeDescs, so the linkonce_odr defines sit
// outside every function body.
func (e *irEmitter) emitSpawnWrappers() {
	for _, text := range e.spawnWrapperTexts {
		e.w(text)
	}
}
