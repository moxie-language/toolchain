package main

import (
	. "git.smesh.lol/moxie/pkg/types"
)

// typeNeedsCopy reports whether a value of type t may contain pointers to
// arena-allocated data that would need relocation across an arena boundary.
func typeNeedsCopy(t Type) (ok bool) {
	return typeNeedsCopyDepth(t, 0)
}

func typeNeedsCopyDepth(t Type, depth int32) (ok bool) {
	if t == nil || depth > 20 {
		return false
	}
	u := SafeUnderlying(t)
	if u == nil {
		return false
	}
	switch tt := u.(type) {
	case *Pointer:
		return true
	case *Slice:
		return true
	case *Basic:
		return tt.Kind == TCString || tt.Kind == UntypedString
	case *TCMap:
		return true
	case *TCChan:
		return true
	case *Signature:
		return true
	case *TCInterface:
		return true
	case *TCStruct:
		for i := int32(0); i < tt.NumFields(); i++ {
			if typeNeedsCopyDepth(tt.Field(i).Typ, depth+1) {
				return true
			}
		}
	case *Array:
		return typeNeedsCopyDepth(tt.Elem, depth+1)
	}
	return false
}

func (e *irEmitter) funcNeedsArenaCopy(f *SSAFunction) (ok bool) {
	if f == nil || f.Blocks == nil {
		return false
	}
	if f.Pkg != nil && f.Pkg.Pkg != nil {
		path := f.Pkg.Pkg.Path
		if path == "runtime" || path == "unsafe" {
			return false
		}
	}
	if f.Signature == nil || f.Signature.Results == nil || f.Signature.Results.Len() == 0 {
		return false
	}
	for i := int32(0); i < int32(f.Signature.Results.Len()); i++ {
		if typeNeedsCopy(f.Signature.Results.At(i).Typ) {
			return true
		}
	}
	return false
}

// --- Arena prologue ---

func (e *irEmitter) emitArenaPrologue() (ok bool) {
	if !e.funcNeedsArenaCopy(e.curFunc) {
		return false
	}
	ipt := e.intptrType()
	e.w("  %fn_arena = call ptr @runtime.FnArenaPush(" | ipt | " 65536, ptr null)\n")
	e.w("  %fn_mark = call " | ipt | " @runtime.ArenaMark(ptr null)\n")
	e.declareRuntime("runtime.FnArenaPush", "ptr", ipt)
	e.declareRuntime("runtime.ArenaMark", ipt, "")
	e.arenaActive = true
	return true
}

// --- Return with three-pass mark-compact ---

func (e *irEmitter) emitRetWithArenaCopy(llvmType string, val string) {
	if !e.arenaActive {
		if llvmType == "void" {
			e.w("  ret void\n")
		} else {
			e.w("  ret " | llvmType | " " | val | "\n")
		}
		return
	}

	needsCopy := false
	if val != "zeroinitializer" && llvmType != "void" {
		sig := e.curFunc.Signature
		if sig != nil && sig.Results != nil {
			for i := int32(0); i < int32(sig.Results.Len()); i++ {
				if typeNeedsCopy(sig.Results.At(i).Typ) {
					needsCopy = true
					break
				}
			}
		}
	}
	if !needsCopy {
		e.w("  call void @runtime.FnArenaPopFree(ptr null)\n")
		e.declareRuntime("runtime.FnArenaPopFree", "void", "")
		if llvmType == "void" {
			e.w("  ret void\n")
		} else {
			e.w("  ret " | llvmType | " " | val | "\n")
		}
		return
	}

	ipt := e.intptrType()
	rsType := e.relocStateType()

	// RelocState is 5 words - stack alloca is fine.
	e.nextReg++
	rs := "%rs" | irItoa(e.nextReg)
	e.w("  " | rs | " = alloca " | rsType | "\n")
	e.w("  store " | rsType | " zeroinitializer, ptr " | rs | "\n")

	// Init: captures source region, bump-allocates entry array from fn_arena.
	e.w("  call void @runtime.RelocInit(ptr " | rs | ", ptr %fn_arena, " | ipt | " %fn_mark, ptr null)\n")
	e.declareRuntime("runtime.RelocInit", "void", "ptr, ptr, " | ipt)

	// ---- Pass 1: Mark ----
	// Walk return value roots, call RelocMark for each reachable object.
	e.relocMarkVisited = map[string]bool{}
	results := e.curFunc.Signature.Results
	for i := int32(0); i < int32(results.Len()); i++ {
		rt := results.At(i).Typ
		if !typeNeedsCopy(rt) {
			continue
		}
		var rootReg string
		if results.Len() == 1 {
			rootReg = val
		} else {
			e.nextReg++
			rootReg = "%p1ext" | irItoa(e.nextReg)
			e.w("  " | rootReg | " = extractvalue " | llvmType | " " | val | ", " | irItoa(i) | "\n")
		}
		// If root is a struct, store to temp so emitRelocMark gets a pointer.
		u := SafeUnderlying(rt)
		if _, isSt := u.(*TCStruct); isSt {
			slt := e.llvmType(rt)
			e.nextReg++
			tmp := "%m1rt" | irItoa(e.nextReg)
			e.w("  " | tmp | " = alloca " | slt | "\n")
			e.w("  store " | slt | " " | rootReg | ", ptr " | tmp | "\n")
			rootReg = tmp
		}
		e.emitRelocMark(rootReg, rt, rs)
	}

	// ---- Pass 2: Forward ----
	// Pop fn_arena from stack. Caller's arena is now top-of-stack.
	// fn_arena stays mapped - compact needs the source data.
	e.nextReg++
	popIgn := "%popign" | irItoa(e.nextReg)
	e.w("  " | popIgn | " = call ptr @runtime.FnArenaPop(ptr null)\n")
	e.declareRuntime("runtime.FnArenaPop", "ptr", "")
	e.w("  call void @runtime.RelocForward(ptr " | rs | ", ptr null)\n")
	e.declareRuntime("runtime.RelocForward", "void", "ptr")

	// ---- Pass 3: Compact + Fixup ----
	// Copy all objects to destinations.
	e.w("  call void @runtime.RelocCompact(ptr " | rs | ", ptr null)\n")
	e.declareRuntime("runtime.RelocCompact", "void", "ptr")
	e.w("  call void @runtime.RelocFixupAll(ptr " | rs | ", ptr null)\n")
	e.declareRuntime("runtime.RelocFixupAll", "void", "ptr")

	// Fixup: rewrite return value's own pointer/slice fields.
	// Also rewrite the return value's own pointer/slice fields.
	e.relocFixupVisited = map[string]bool{}
	cur := val
	for i := int32(0); i < int32(results.Len()); i++ {
		rt := results.At(i).Typ
		if !typeNeedsCopy(rt) {
			continue
		}
		var fixReg string
		if results.Len() == 1 {
			fixReg = val
		} else {
			e.nextReg++
			fixReg = "%p3ext" | irItoa(e.nextReg)
			e.w("  " | fixReg | " = extractvalue " | llvmType | " " | cur | ", " | irItoa(i) | "\n")
		}
		newReg := e.emitRelocFixup(fixReg, rt, rs)
		if results.Len() == 1 {
			cur = newReg
		} else if newReg != fixReg {
			elt := e.llvmType(rt)
			e.nextReg++
			ins := "%p3ins" | irItoa(e.nextReg)
			e.w("  " | ins | " = insertvalue " | llvmType | " " | cur | ", " | elt | " " | newReg | ", " | irItoa(i) | "\n")
			cur = ins
		}
	}

	// Fixup internal pointers of each forwarded object.
	// Walk the forwarding table; for each entry, apply type-specific fixup.
	// This is done by the per-result fixup above which walks recursively.

	// Free source arena.
	e.w("  call void @runtime.ArenaRelease(ptr %fn_arena, ptr null)\n")
	e.declareRuntime("runtime.ArenaRelease", "void", "ptr")
	e.w("  ret " | llvmType | " " | cur | "\n")
}

func (e *irEmitter) relocStateType() (s string) {
	ipt := e.intptrType()
	// Matches runtime.RelocState: {arena ptr, mark uintptr, first ptr, count i32}
	return "{ptr, " | ipt | ", ptr, i32}"
}

// --- Pass 1 codegen: Mark ---

func (e *irEmitter) emitRelocMark(reg string, t Type, rs string) {
	if t == nil || !typeNeedsCopy(t) {
		return
	}
	u := SafeUnderlying(t)
	if u == nil {
		return
	}
	ipt := e.intptrType()
	switch tt := u.(type) {
	case *Pointer:
		lt := e.llvmType(tt.Base)
		if lt == "void" || lt == "" {
			lt = "i8"
		}
		e.nextReg++
		sz := "%m1sz" | irItoa(e.nextReg)
		e.w("  " | sz | " = ptrtoint ptr getelementptr (" | lt | ", ptr null, i32 1) to " | ipt | "\n")
		fixupArg := ipt | " 0"
		if st, isSt := SafeUnderlying(tt.Base).(*TCStruct); isSt {
			fixupSym := e.getOrEmitRelocFixupFn(st)
			if fixupSym != "" {
				fixupArg = ipt | " ptrtoint (ptr " | fixupSym | " to " | ipt | ")"
			}
		}
		e.nextReg++
		isNew := "%m1n" | irItoa(e.nextReg)
		e.w("  " | isNew | " = call i1 @runtime.RelocMark(ptr " | rs | ", ptr " | reg | ", " | ipt | " " | sz | ", " | fixupArg | ", ptr null)\n")
		e.declareRuntime("runtime.RelocMark", "i1", "ptr, ptr, " | ipt | ", " | ipt)
		if typeNeedsCopy(tt.Base) {
			e.nextReg++
			lNew := "m1r" | irItoa(e.nextReg)
			e.nextReg++
			lSkip := "m1s" | irItoa(e.nextReg)
			e.w("  br i1 " | isNew | ", label %" | lNew | ", label %" | lSkip | "\n")
			e.w(lNew | ":\n")
			e.emitRelocMarkFields(reg, tt.Base, rs)
			e.w("  br label %" | lSkip | "\n")
			e.w(lSkip | ":\n")
		}
	case *Slice, *Basic:
		st := e.sliceType()
		e.nextReg++
		dp := "%m1d" | irItoa(e.nextReg)
		e.w("  " | dp | " = extractvalue " | st | " " | reg | ", 0\n")
		e.nextReg++
		ln := "%m1l" | irItoa(e.nextReg)
		e.w("  " | ln | " = extractvalue " | st | " " | reg | ", 1\n")
		elemType := "i8"
		if sl, ok := u.(*Slice); ok && sl.Elem != nil {
			elemType = e.llvmType(sl.Elem)
		}
		e.nextReg++
		esz := "%m1e" | irItoa(e.nextReg)
		e.w("  " | esz | " = ptrtoint ptr getelementptr (" | elemType | ", ptr null, i32 1) to " | ipt | "\n")
		e.nextReg++
		blen := "%m1b" | irItoa(e.nextReg)
		e.w("  " | blen | " = mul " | ipt | " " | ln | ", " | esz | "\n")
		e.w("  call i1 @runtime.RelocMark(ptr " | rs | ", ptr " | dp | ", " | ipt | " " | blen | ", " | ipt | " 0, ptr null)\n")
		e.declareRuntime("runtime.RelocMark", "i1", "ptr, ptr, " | ipt | ", " | ipt)
	case *TCMap:
		e.nextReg++
		sz := "%m1m" | irItoa(e.nextReg)
		e.w("  " | sz | " = ptrtoint ptr getelementptr ({ptr}, ptr null, i32 1) to " | ipt | "\n")
		e.w("  call i1 @runtime.RelocMark(ptr " | rs | ", ptr " | reg | ", " | ipt | " " | sz | ", " | ipt | " 0, ptr null)\n")
		e.declareRuntime("runtime.RelocMark", "i1", "ptr, ptr, " | ipt | ", " | ipt)
	case *TCStruct:
		// reg must be a pointer to the struct (GEP result or alloca'd temp).
		e.emitRelocMarkStructFields(reg, tt, rs)
	}
}

func (e *irEmitter) emitRelocMarkFields(ptrReg string, t Type, rs string) {
	u := SafeUnderlying(t)
	if u == nil {
		return
	}
	st, ok := u.(*TCStruct)
	if !ok {
		return
	}
	e.emitRelocMarkStructFields(ptrReg, st, rs)
}

func (e *irEmitter) emitRelocMarkStructFields(ptrReg string, st *TCStruct, rs string) {
	key := e.llvmStructType(st)
	if e.relocMarkVisited[key] {
		return
	}
	e.relocMarkVisited[key] = true
	lt := key
	for i := int32(0); i < st.NumFields(); i++ {
		ft := st.Field(i).Typ
		if !typeNeedsCopy(ft) {
			continue
		}
		e.nextReg++
		gep := "%m1f" | irItoa(e.nextReg)
		e.w("  " | gep | " = getelementptr " | lt | ", ptr " | ptrReg | ", i32 0, i32 " | irItoa(i) | "\n")
		u := SafeUnderlying(ft)
		if _, isSt := u.(*TCStruct); isSt {
			e.emitRelocMark(gep, ft, rs)
		} else {
			flt := e.llvmType(ft)
			e.nextReg++
			fval := "%m1f" | irItoa(e.nextReg)
			e.w("  " | fval | " = load " | flt | ", ptr " | gep | "\n")
			e.emitRelocMark(fval, ft, rs)
		}
	}
	e.relocMarkVisited[key] = false
}

// --- Pass 3 codegen: Fixup ---

func (e *irEmitter) emitRelocFixup(reg string, t Type, rs string) (newReg string) {
	if t == nil || !typeNeedsCopy(t) {
		return reg
	}
	u := SafeUnderlying(t)
	if u == nil {
		return reg
	}
	switch tt := u.(type) {
	case *Pointer:
		e.nextReg++
		r := "%p3p" | irItoa(e.nextReg)
		e.w("  " | r | " = call ptr @runtime.RelocLookup(ptr " | rs | ", ptr " | reg | ", ptr null)\n")
		e.declareRuntime("runtime.RelocLookup", "ptr", "ptr, ptr")
		// Per-type fixup (RelocFixupAll) handles internal field fixup.
		return r
	case *Slice, *Basic:
		st := e.sliceType()
		e.nextReg++
		dp := "%p3s" | irItoa(e.nextReg)
		e.w("  " | dp | " = extractvalue " | st | " " | reg | ", 0\n")
		e.nextReg++
		ndp := "%p3s" | irItoa(e.nextReg)
		e.w("  " | ndp | " = call ptr @runtime.RelocLookup(ptr " | rs | ", ptr " | dp | ", ptr null)\n")
		e.declareRuntime("runtime.RelocLookup", "ptr", "ptr, ptr")
		e.nextReg++
		result := "%p3s" | irItoa(e.nextReg)
		e.w("  " | result | " = insertvalue " | st | " " | reg | ", ptr " | ndp | ", 0\n")
		return result
	case *TCMap:
		e.nextReg++
		r := "%p3m" | irItoa(e.nextReg)
		e.w("  " | r | " = call ptr @runtime.hashmapCopy(ptr " | reg | ", ptr null)\n")
		e.declareRuntime("runtime.hashmapCopy", "ptr", "ptr")
		return r
	case *TCStruct:
		return e.emitRelocFixupStruct(reg, tt, rs)
	}
	return reg
}

func (e *irEmitter) emitRelocFixupFields(ptrReg string, t Type, rs string) {
	u := SafeUnderlying(t)
	st, ok := u.(*TCStruct)
	if !ok {
		return
	}
	key := e.llvmStructType(st)
	if e.relocFixupVisited[key] {
		return
	}
	e.relocFixupVisited[key] = true
	lt := key
	for i := int32(0); i < st.NumFields(); i++ {
		ft := st.Field(i).Typ
		if !typeNeedsCopy(ft) {
			continue
		}
		e.nextReg++
		gep := "%p3ff" | irItoa(e.nextReg)
		e.w("  " | gep | " = getelementptr " | lt | ", ptr " | ptrReg | ", i32 0, i32 " | irItoa(i) | "\n")
		fu := SafeUnderlying(ft)
		switch fu.(type) {
		case *Pointer:
			e.w("  call void @runtime.RelocFixupPtr(ptr " | rs | ", ptr " | gep | ", ptr null)\n")
			e.declareRuntime("runtime.RelocFixupPtr", "void", "ptr, ptr")
		case *Slice, *Basic:
			e.w("  call void @runtime.RelocFixupSlice(ptr " | rs | ", ptr " | gep | ", ptr null)\n")
			e.declareRuntime("runtime.RelocFixupSlice", "void", "ptr, ptr")
		case *TCMap:
			e.nextReg++
			old := "%p3ff" | irItoa(e.nextReg)
			e.w("  " | old | " = load ptr, ptr " | gep | "\n")
			e.nextReg++
			nw := "%p3ff" | irItoa(e.nextReg)
			e.w("  " | nw | " = call ptr @runtime.hashmapCopy(ptr " | old | ", ptr null)\n")
			e.declareRuntime("runtime.hashmapCopy", "ptr", "ptr")
			e.w("  store ptr " | nw | ", ptr " | gep | "\n")
		case *TCStruct:
			e.emitRelocFixupFields(gep, ft, rs)
		}
	}
	e.relocFixupVisited[key] = false
}

func (e *irEmitter) emitRelocFixupStruct(reg string, st *TCStruct, rs string) (newReg string) {
	key := e.llvmStructType(st)
	if e.relocFixupVisited[key] {
		return reg
	}
	e.relocFixupVisited[key] = true
	lt := key
	e.nextReg++
	tmp := "%p3st" | irItoa(e.nextReg)
	e.w("  " | tmp | " = alloca " | lt | "\n")
	e.w("  store " | lt | " " | reg | ", ptr " | tmp | "\n")

	for i := int32(0); i < st.NumFields(); i++ {
		ft := st.Field(i).Typ
		if !typeNeedsCopy(ft) {
			continue
		}
		e.nextReg++
		gep := "%p3st" | irItoa(e.nextReg)
		e.w("  " | gep | " = getelementptr " | lt | ", ptr " | tmp | ", i32 0, i32 " | irItoa(i) | "\n")
		fu := SafeUnderlying(ft)
		switch fu.(type) {
		case *Pointer:
			e.w("  call void @runtime.RelocFixupPtr(ptr " | rs | ", ptr " | gep | ", ptr null)\n")
			e.declareRuntime("runtime.RelocFixupPtr", "void", "ptr, ptr")
		case *Slice, *Basic:
			e.w("  call void @runtime.RelocFixupSlice(ptr " | rs | ", ptr " | gep | ", ptr null)\n")
			e.declareRuntime("runtime.RelocFixupSlice", "void", "ptr, ptr")
		case *TCMap:
			e.nextReg++
			old := "%p3st" | irItoa(e.nextReg)
			e.w("  " | old | " = load ptr, ptr " | gep | "\n")
			e.nextReg++
			nw := "%p3st" | irItoa(e.nextReg)
			e.w("  " | nw | " = call ptr @runtime.hashmapCopy(ptr " | old | ", ptr null)\n")
			e.declareRuntime("runtime.hashmapCopy", "ptr", "ptr")
			e.w("  store ptr " | nw | ", ptr " | gep | "\n")
		case *TCStruct:
			e.emitRelocFixupFields(gep, ft, rs)
		}
	}
	e.nextReg++
	result := "%p3st" | irItoa(e.nextReg)
	e.w("  " | result | " = load " | lt | ", ptr " | tmp | "\n")
	e.relocFixupVisited[key] = false
	return result
}

// --- Per-type fixup functions ---

func relocFixupSymbol(lt string) (sym string) {
	h := uint32(0x811c9dc5)
	for i := int32(0); i < len(lt); i++ {
		h = h ^ uint32(lt[i])
		h = h * 0x01000193
	}
	return "@__reloc_fixup_" | irItoa(int32(h & 0x7fffffff))
}

// getOrEmitRelocFixupFn returns the symbol for a per-type fixup function.
// One function per struct type. Fixes pointer/slice/map fields in ONE instance.
// No recursion - each marked object has its own forwarding entry and fixup.
func (e *irEmitter) getOrEmitRelocFixupFn(st *TCStruct) (sym string) {
	lt := e.llvmStructType(st)
	if lt == "" {
		return ""
	}
	// Key by Moxie type (not LLVM type) - different Moxie types can share
	// the same LLVM layout ({ptr, ptr}) but need different fixup logic.
	sym = relocFixupSymbol(st.String())
	// Check if already emitted (definedSyms is compile-arena resident).
	bareSym := sym
	if len(bareSym) > 0 && bareSym[0] == '@' {
		bareSym = bareSym[1:]
	}
	for di := int32(0); di < len(e.definedSyms); di++ {
		ds := e.definedSyms[di]
		if len(ds) == len(bareSym) {
			match := true
			for bi := int32(0); bi < len(ds); bi++ {
				if ds[bi] != bareSym[bi] {
					match = false
					break
				}
			}
			if match {
				return sym
			}
		}
	}
	// Also check pending (not yet merged to definedSyms).
	for pi := int32(0); pi < len(e.pendRelocFixupDefs); pi++ {
		ps := e.pendRelocFixupDefs[pi]
		if len(ps) == len(bareSym) {
			match := true
			for bi := int32(0); bi < len(ps); bi++ {
				if ps[bi] != bareSym[bi] {
					match = false
					break
				}
			}
			if match {
				return sym
			}
		}
	}
	push(e.pendRelocFixupDefs, bareSym)
	// Ensure runtime functions used by fixup are declared.
	e.declareRuntime("runtime.RelocFixupPtr", "void", "ptr, ptr")
	e.declareRuntime("runtime.RelocFixupSlice", "void", "ptr, ptr")
	e.declareRuntime("runtime.hashmapCopy", "ptr", "ptr")
	var fb []string
	push(fb, "\ndefine linkonce_odr void " | sym | "(ptr %obj, ptr %rs, ptr %ctx) {\nentry:\n")
	regN := int32(0)
	for i := int32(0); i < st.NumFields(); i++ {
		ft := st.Field(i).Typ
		if !typeNeedsCopy(ft) {
			continue
		}
		regN++
		gep := "%fg" | irItoa(regN)
		push(fb, "  " | gep | " = getelementptr " | lt | ", ptr %obj, i32 0, i32 " | irItoa(i) | "\n")
		fu := SafeUnderlying(ft)
		switch fu.(type) {
		case *Pointer:
			push(fb, "  call void @runtime.RelocFixupPtr(ptr %rs, ptr " | gep | ", ptr null)\n")
		case *Slice, *Basic:
			push(fb, "  call void @runtime.RelocFixupSlice(ptr %rs, ptr " | gep | ", ptr null)\n")
		case *TCMap:
			regN++
			old := "%fg" | irItoa(regN)
			push(fb, "  " | old | " = load ptr, ptr " | gep | "\n")
			regN++
			chk := "%fg" | irItoa(regN)
			regN++
			ldo := "fgdo" | irItoa(regN)
			regN++
			lsk := "fgsk" | irItoa(regN)
			push(fb, "  " | chk | " = icmp ne ptr " | old | ", null\n")
			push(fb, "  br i1 " | chk | ", label %" | ldo | ", label %" | lsk | "\n")
			push(fb, ldo | ":\n")
			regN++
			nw := "%fg" | irItoa(regN)
			push(fb, "  " | nw | " = call ptr @runtime.hashmapCopy(ptr " | old | ", ptr null)\n")
			push(fb, "  store ptr " | nw | ", ptr " | gep | "\n")
			push(fb, "  br label %" | lsk | "\n")
			push(fb, lsk | ":\n")
		case *TCStruct:
			// Nested struct: inline its field fixups (one level only).
			if innerSt, ok2 := fu.(*TCStruct); ok2 {
				innerLt := e.llvmStructType(innerSt)
				for j := int32(0); j < innerSt.NumFields(); j++ {
					jft := innerSt.Field(j).Typ
					if !typeNeedsCopy(jft) {
						continue
					}
					regN++
					igep := "%fg" | irItoa(regN)
					push(fb, "  " | igep | " = getelementptr " | innerLt | ", ptr " | gep | ", i32 0, i32 " | irItoa(j) | "\n")
					jfu := SafeUnderlying(jft)
					switch jfu.(type) {
					case *Pointer:
						push(fb, "  call void @runtime.RelocFixupPtr(ptr %rs, ptr " | igep | ", ptr null)\n")
					case *Slice, *Basic:
						push(fb, "  call void @runtime.RelocFixupSlice(ptr %rs, ptr " | igep | ", ptr null)\n")
					case *TCMap:
						regN++
						io := "%fg" | irItoa(regN)
						push(fb, "  " | io | " = load ptr, ptr " | igep | "\n")
						regN++
						ichk := "%fg" | irItoa(regN)
						regN++
						ildo := "fgdo" | irItoa(regN)
						regN++
						ilsk := "fgsk" | irItoa(regN)
						push(fb, "  " | ichk | " = icmp ne ptr " | io | ", null\n")
						push(fb, "  br i1 " | ichk | ", label %" | ildo | ", label %" | ilsk | "\n")
						push(fb, ildo | ":\n")
						regN++
						inw := "%fg" | irItoa(regN)
						push(fb, "  " | inw | " = call ptr @runtime.hashmapCopy(ptr " | io | ", ptr null)\n")
						push(fb, "  store ptr " | inw | ", ptr " | igep | "\n")
						push(fb, "  br label %" | ilsk | "\n")
						push(fb, ilsk | ":\n")
					}
				}
			}
		}
	}
	push(fb, "  ret void\n}\n")
	// Write directly to output file (bypasses segment/arena lifetime issues).
	if e.outFile != nil {
		for _, s := range fb {
			e.outFile.Write([]byte(s))
		}
	}
	return sym
}

// --- Legacy compat (emit loop calls these) ---

type deepCopyEntry struct {
	sym string
	typ Type
}

func (e *irEmitter) getOrCreateDeepCopyFn(t Type) (sym string) {
	return "@__dcopy_opaque"
}

func typeKeyForDeepCopy(t Type) (s string) {
	if t == nil {
		return "<nil>"
	}
	return t.String()
}

func (e *irEmitter) emitDeepCopyFunctions() {
	// Mark-compact handles relocation inline. No per-type functions needed.
}

func (e *irEmitter) visitedType() (s string) {
	return "{i32, [256 x [2 x ptr]]}"
}

func (e *irEmitter) emitDeepCopyTupleValue(reg string, llvmType string, results *Tuple, visited string) (newReg string) {
	return reg
}
