package main

import (
	"moxielang.dev/pkg/mxutil"
	. "moxielang.dev/pkg/types"
)

func typeNeedsCodec(t Type) (ok bool) {
	return typeNeedsCodecDepth(t, 0)
}

func typeNeedsCodecDepth(t Type, depth int32) (ok bool) {
	if t == nil || depth > 20 {
		return false
	}
	u := SafeUnderlying(t)
	if u == nil {
		return false
	}
	switch tt := u.(type) {
	case *Pointer:
		return true
	case *Slice:
		return true
	case *Basic:
		return tt.Kind == TCString || tt.Kind == UntypedString
	case *TCMap:
		return true
	case *TCChan:
		return true
	case *Signature:
		return true
	case *TCInterface:
		return true
	case *TCStruct:
		for i := int32(0); i < tt.NumFields(); i++ {
			if typeNeedsCodecDepth(tt.Field(i).Typ, depth+1) {
				return true
			}
		}
	case *Array:
		return typeNeedsCodecDepth(tt.Elem, depth+1)
	}
	return false
}

func (e *irEmitter) funcNeedsCodec(f *SSAFunction) (ok bool) {
	if f == nil || f.Blocks == nil {
		return false
	}
	if f.Pkg != nil && f.Pkg.Pkg != nil {
		path := f.Pkg.Pkg.Path
		if path == "runtime" || path == "unsafe" || path == "syscall" || path == "os" ||
			path == "main" ||
			mxutil.HasPrefix(path, "moxielang.dev/pkg/") {
			return false
		}
	}
	if f.Signature == nil || f.Signature.Results == nil || f.Signature.Results.Len() == 0 {
		return false
	}
	for i := int32(0); i < int32(f.Signature.Results.Len()); i++ {
		if typeNeedsCodec(f.Signature.Results.At(i).Typ) {
			return true
		}
	}
	return false
}

// recvNamedType returns the named type a method's receiver denotes. The
// declared receiver may be a value (a named slice/map, passed as a reference),
// while Params[0] is always *T; unwrapping the PARAM keeps the sovereign
// classification identical for both receiver spellings.
func (e *irEmitter) recvNamedType() (named *Named) {
	if e.curFunc == nil || e.curFunc.Signature == nil || e.curFunc.Signature.Recv == nil || len(e.curFunc.Params) == 0 {
		return nil
	}
	t := e.curFunc.Signature.Recv.Typ
	if p, isP := SafeUnderlying(t).(*Pointer); isP {
		t = p.Base
	}
	n, isN := t.(*Named)
	if !isN {
		return nil
	}
	return n
}

func (e *irEmitter) isSovereignNamedType(named *Named) (ok bool) {
	return ssaIsSovereignNamedType(e.pkg, named)
}

// ssaIsSovereignNamedType reports whether named is a self-mutating (sovereign)
// type: a named type that needs a codec and has at least one method that
// writes the receiver. The language has no named slice or map types
// (ir_scope.mx checkPackageDecls refuses `type S []T`), so a receiver with a
// non-struct descriptor can only be an ALIAS of a slice/map - `type S = []T`
// introduces no new type - and the runtime then roots compaction at the
// receiver value itself (sovFullMark/sovRebaseRoots). The syntax package and
// the compiler's main package are excluded (mirrors the legacy compiler).
func ssaIsSovereignNamedType(p *SSAPackage, named *Named) (ok bool) {
	if named == nil || named.Obj == nil {
		return false
	}
	if named.Obj.Pkg != nil {
		pp := named.Obj.Pkg.Path
		if pp == "main" || pp == "moxielang.dev/pkg/syntax" || pp == "syntax" {
			return false
		}
	}
	if !typeNeedsCodec(named) {
		return false
	}
	mangledPrefix := "(*" | named.Obj.Name | ")."
	for mname, member := range p.Members {
		if !mxutil.HasPrefix(mname, mangledPrefix) {
			continue
		}
		fn, ok3 := member.(*SSAFunction)
		if !ok3 || fn.Blocks == nil {
			continue
		}
		if ssaFuncHasReceiverWrite(fn) {
			return true
		}
	}
	return false
}

func ssaFuncHasReceiverWrite(fn *SSAFunction) (ok bool) {
	return ssaFuncHasReceiverWriteSeen(fn, map[*SSAFunction]bool{}, 0)
}

// ssaFuncHasReceiverWriteDirectly is the direct-only query. The loop-scratch
// restriction still asks THIS question, not the transitive one the prologue
// asks: seeing delegation would put every method that mutates by calling
// g.advance(...) under the restriction, and each one then needs its loop
// scratch moved into a helper. That port is a pass of its own - the sites found
// so far are bufio's collectFragments, cryptobyte's readBase128Int, dnsmessage's
// four All* readers, net.Buffers, x509's AppendCertsFromPEM, tls's
// writeRecordLocked and loadSession, filter.F.Marshal and store/sorted's
// File.Get/GetPrefix/Last/lowerBound - and it continues from there.
// Mirrors legacy ssaFuncWritesReceiverDirectly.
func ssaFuncHasReceiverWriteDirectly(fn *SSAFunction) (ok bool) {
	return ssaFuncHasDirectReceiverWrite(fn)
}

// ssaFuncHasDirectReceiverWrite is the direct scan the transitive walk performs
// at each level.
func ssaFuncHasDirectReceiverWrite(fn *SSAFunction) (ok bool) {
	if fn == nil || fn.Signature == nil || fn.Signature.Recv == nil || len(fn.Params) == 0 {
		return false
	}
	recvParam := fn.Params[0]
	localStore := map[SSAValue]SSAValue{}
	for _, block := range fn.Blocks {
		for _, instr := range block.Instrs {
			store, ok2 := instr.(*SSAStore)
			if !ok2 {
				continue
			}
			if _, isAlloc := store.Addr.(*SSAAlloc); !isAlloc {
				continue
			}
			localStore[store.Addr] = store.Val
		}
	}
	for _, block := range fn.Blocks {
		for _, instr := range block.Instrs {
			if mu, ok3 := instr.(*SSAMapUpdate); ok3 {
				if mu.Map != nil && ssaRecvRooted(mu.Map, recvParam, localStore) {
					return true
				}
				continue
			}
			store, ok2 := instr.(*SSAStore)
			if !ok2 {
				continue
			}
			if _, isAlloc := store.Addr.(*SSAAlloc); isAlloc {
				continue
			}
			if ssaRecvRooted(store.Addr, recvParam, localStore) {
				return true
			}
		}
	}
	return false
}

// ssaFuncHasReceiverWriteSeen is ssaFuncHasReceiverWrite with the call chain
// that reached fn. A cycle (a method calling another method of the same type
// that calls back) is cut by the seen set: the inner visit answers false,
// which is conservative for the cycle and exact for every acyclic path.
func ssaFuncHasReceiverWriteSeen(fn *SSAFunction, seen map[*SSAFunction]bool, depth int32) (ok bool) {
	if fn == nil || fn.Signature == nil || fn.Signature.Recv == nil || len(fn.Params) == 0 || depth > 8 {
		return false
	}
	if seen[fn] {
		return false
	}
	seen[fn] = true
	recvParam := fn.Params[0]
	// The stage4 SSA spills the receiver and locals into allocas and reloads
	// them. Map each alloca to the value stored into it so the walk can follow
	// a load back to its source (e.g. xLimbs := x.limbs[:size]).
	localStore := map[SSAValue]SSAValue{}
	for _, block := range fn.Blocks {
		for _, instr := range block.Instrs {
			store, ok2 := instr.(*SSAStore)
			if !ok2 {
				continue
			}
			if _, isAlloc := store.Addr.(*SSAAlloc); !isAlloc {
				continue
			}
			localStore[store.Addr] = store.Val
		}
	}
	for _, block := range fn.Blocks {
		for _, instr := range block.Instrs {
			// A map update through the receiver is a receiver write even
			// though no Store instruction carries it: it mutates the map's
			// storage (and a push into a value can reallocate its backing).
			// Missing this classified a method whose only mutation is a map
			// update as READ-ONLY, so it pushed its own frame arena instead of
			// borrowing the receiver's - mime's setExtensionType stored parsed
			// lines into the package store and every key and value pointed at
			// a frame that was released when the loader returned.
			if mu, ok3 := instr.(*SSAMapUpdate); ok3 {
				if mu.Map != nil && ssaRecvRooted(mu.Map, recvParam, localStore) {
					return true
				}
				continue
			}
			// A method call ON the receiver mutates it exactly as a field
			// store does: the callee borrows the same object and stores
			// through it. Missing this classified a method whose only
			// mutation is `g.advanceAfterOwnCommit(...)` as READ-ONLY, so it
			// pushed a frame arena instead of borrowing the receiver's, and
			// the callee's store-back left the receiver's fields pointing
			// into that frame. Measured on mls.(*Group).CreateWelcome: the
			// group context hash and confirmed transcript hash dangled as
			// soon as it returned and the next Marshal dereferenced a
			// released arena.
			if call, okC := instr.(*SSACall); okC {
				if ssaCallHasReceiverWrite(call, recvParam, localStore, seen, depth) {
					return true
				}
				continue
			}
			store, ok2 := instr.(*SSAStore)
			if !ok2 {
				continue
			}
			if _, isAlloc := store.Addr.(*SSAAlloc); isAlloc {
				continue
			}
			if ssaRecvRooted(store.Addr, recvParam, localStore) {
				return true
			}
		}
	}
	return false
}

// ssaCallHasReceiverWrite reports whether a call in fn mutates fn's receiver by
// calling a method on it.
func ssaCallHasReceiverWrite(call *SSACall, recvParam SSAValue, localStore map[SSAValue]SSAValue, seen map[*SSAFunction]bool, depth int32) (ok bool) {
	if call == nil || recvParam == nil || len(call.Call.Args) == 0 {
		return false
	}
	if !ssaRecvRooted(call.Call.Args[0], recvParam, localStore) {
		return false
	}
	callee, okF := call.Call.Value.(*SSAFunction)
	if !okF || callee == nil || callee.Signature == nil || callee.Signature.Recv == nil {
		return false
	}
	if !sameRecvType(recvParam.SSAType(), callee.Params) {
		return false
	}
	return ssaFuncHasReceiverWriteSeen(callee, seen, depth+1)
}

// sameRecvType reports whether a receiver parameter's type names the same
// object type as the callee's receiver parameter, ignoring the pointer.
func sameRecvType(recvType Type, calleeParams []*SSAParameter) (ok bool) {
	if recvType == nil || len(calleeParams) == 0 || calleeParams[0] == nil {
		return false
	}
	a := recvType
	if pa, isP := SafeUnderlying(a).(*Pointer); isP {
		a = pa.Base
	}
	b := calleeParams[0].SSAType()
	if pb, isP := SafeUnderlying(b).(*Pointer); isP {
		b = pb.Base
	}
	return a == b
}

// recvWalkItem is one node of the receiver-derivation walk with its depth, so
// the walk can be iterative: recursion needs a closure, and a Moxie function
// value carries no environment for that closure to read.
type recvWalkItem struct {
	v     SSAValue
	depth int32
}

// ssaRecvRooted reports whether v derives from the receiver param through
// field/index/slice operations, resolving loads of local allocas to the value
// stored into them.
//
// Iterative with an explicit worklist. It used to be a recursive closure
// capturing seen, recvParam, walk and localStore, which was the last closure
// capture in the compiler's own source (the -report-closure-captures run lists
// it): the compiler must obey the rule it enforces. Reachability is the same
// question either way - the first node popped that IS the receiver param
// answers it - and seen keeps the worklist bounded.
func ssaRecvRooted(v SSAValue, recvParam SSAValue, localStore map[SSAValue]SSAValue) (ok bool) {
	if v == nil {
		return false
	}
	seen := map[SSAValue]bool{}
	work := []recvWalkItem{:0:16}
	work = push(work, recvWalkItem{v: v, depth: 0})
	for i := int32(0); i < len(work); i++ {
		x := work[i].v
		depth := work[i].depth + 1
		if x == nil || depth > 64 || seen[x] {
			continue
		}
		seen[x] = true
		if x == recvParam {
			return true
		}
		switch vv := x.(type) {
		case *SSAFieldAddr:
			work = mxutil.Ensure(work, 1)
			work = push(work, recvWalkItem{v: vv.X, depth: depth})
		case *SSAIndexAddr:
			work = mxutil.Ensure(work, 1)
			work = push(work, recvWalkItem{v: vv.X, depth: depth})
		case *SSASlice:
			work = mxutil.Ensure(work, 1)
			work = push(work, recvWalkItem{v: vv.X, depth: depth})
		case *SSAUnOp:
			next := vv.X
			if vv.Op == OpMul {
				if sv, has := localStore[vv.X]; has && sv != nil {
					next = sv
				}
			}
			work = mxutil.Ensure(work, 1)
			work = push(work, recvWalkItem{v: next, depth: depth})
		case *SSAMakeInterface:
			work = mxutil.Ensure(work, 1)
			work = push(work, recvWalkItem{v: vv.X, depth: depth})
		}
	}
	return false
}

func (e *irEmitter) emitArenaPrologue() (ok bool) {
	// Sovereign arena prologue: borrow the receiver's arena instead of
	// FnArenaPush. This is decided before the codec gate below: that gate asks
	// whether the *return values* need relocating, but a mutating method that
	// returns nothing (or only an error) still fills receiver fields, and those
	// allocations must land in the receiver's arena rather than in whatever
	// frame happens to be current - otherwise the caller's frame is released
	// while the receiver still points into it. The legacy compiler checks the
	// sovereign case first for the same reason.
	// Only methods that actually write to receiver fields borrow; read-only
	// methods get a regular per-function arena so their scratch is cleared at
	// return.
	if e.curFunc.Signature != nil && e.curFunc.Signature.Recv != nil && len(e.curFunc.Params) > 0 &&
		ssaFuncHasReceiverWrite(e.curFunc) {
		named := e.recvNamedType()
		if named != nil {
			if e.isSovereignNamedType(named) {
				recvName := e.operand(e.curFunc.Params[0])
				// Acquire the receiver's sovereign group (root-arena
				// hashmap keyed by receiver address), register its data
				// arena as stable, open an allocation batch, and borrow the
				// data arena as this method's working arena. Allocations
				// land there and are recorded; codecSovereignEndCall at
				// return reclaims the batch.
				// The receiver's own type descriptor is required by the
				// runtime: sovFullMark and sovRebaseRoots walk the
				// receiver's fields (or the receiver value itself when the
				// descriptor is not a struct - an alias of a slice) as the
				// compaction roots, and without the descriptor every block
				// is unreachable, so compaction empties the arena and the
				// receiver's fields keep pointing into the unmapped old
				// region.
				e.collectTypeDesc(named)
				e.nextReg++
				group := "%sov_group"
				group = group | irItoa(e.nextReg)
				e.w("  ") ; e.w(group) ; e.w(" = call ptr @runtime.codecSovereignArena(ptr ") ; e.w(recvName) ; e.w(", ptr ") ; e.w(irQuoteName(e.reflectTypeName(named))) ; e.w(", ptr null)\n")
				e.declareRuntime("runtime.codecSovereignArena", "ptr", "ptr, ptr")
				e.nextReg++
				parentArena := "%sov_parent"
				parentArena = parentArena | irItoa(e.nextReg)
				e.w("  ") ; e.w(parentArena) ; e.w(" = call ptr @runtime.CurrentArena(ptr null)\n")
				e.declareRuntime("runtime.CurrentArena", "ptr", "")
				e.nextReg++
				dataArena := "%sov_data"
				dataArena = dataArena | irItoa(e.nextReg)
				e.w("  ") ; e.w(dataArena) ; e.w(" = call ptr @runtime.sovDataArena(ptr ") ; e.w(group) ; e.w(", ptr null)\n")
				e.declareRuntime("runtime.sovDataArena", "ptr", "ptr")
				e.w("  call void @runtime.SovereignRegStable(ptr ") ; e.w(dataArena) ; e.w(", ptr null)\n")
				e.declareRuntime("runtime.SovereignRegStable", "void", "ptr")
				e.w("  call void @runtime.codecSovereignEnter(ptr ") ; e.w(group) ; e.w(", ptr null)\n")
				e.declareRuntime("runtime.codecSovereignEnter", "void", "ptr")
				e.w("  call void @runtime.SovereignSetArena(ptr ") ; e.w(dataArena) ; e.w(", ptr null)\n")
				e.declareRuntime("runtime.SovereignSetArena", "void", "ptr")
				e.sovereignGroupReg = group
				e.parentArenaReg = parentArena
				e.arenaActive = true
				e.arenaBorrowed = true
				e.stableReg = true
				return true
			}
		}
	}
	if e.funcNeedsCodec(e.curFunc) {
		ipt := e.intptrType()
		e.w("  %fn_arena = call ptr @runtime.FnArenaPush(")
		e.w(ipt)
		e.w(" 65536, ptr null)\n")
		e.declareRuntime("runtime.FnArenaPush", "ptr", ipt)
		// Read-only method of a sovereign type: register the receiver's arena
		// as stable so returned views into receiver data stay views, while the
		// method's own scratch lives in this fn arena and is freed at return.
		if named := e.recvNamedType(); named != nil && e.isSovereignNamedType(named) && !ssaFuncHasReceiverWrite(e.curFunc) {
			recvName := e.operand(e.curFunc.Params[0])
			e.w("  call void @runtime.codecRegStable(ptr ") ; e.w(recvName) ; e.w(", ptr null)\n")
			e.declareRuntime("runtime.codecRegStable", "void", "ptr")
			e.stableReg = true
		}
		e.arenaActive = true
	}
	// Initialisation code that writes a package global allocates in the ROOT
	// arena, not in whatever frame happens to be current. The restriction pass
	// permits global stores in any init-named function, but a lazy `initFoo`
	// called from deep inside a frame allocated into that frame's arena: the
	// global then dangled as soon as the caller returned and the next reader saw
	// a recycled block. ecdsa's `_p256Cached` was built by initP256 lazily
	// during GenerateKey (whose arena is then reused) and read as garbage during
	// Sign. The package's real init() has always run this way - it pushes no
	// frame arena, so the current arena is the root - and the switch gives every
	// initialiser the same target. Restored at every return, before the return
	// encode, so the encode buffer still lands in the frame arena.
	if (e.curFunc.name == "__varinit" || isInitFuncName(e.curFunc.name)) && ssaFuncStoresGlobal(e.curFunc) {
		e.nextReg++
		e.initArenaNum = e.nextReg
		e.w("  %init_arena") ; e.w(irItoa(e.initArenaNum)) ; e.w(" = call ptr @runtime.CurrentArena(ptr null)\n")
		e.declareRuntime("runtime.CurrentArena", "ptr", "")
		e.nextReg++
		rootNum := e.nextReg
		e.w("  %init_root") ; e.w(irItoa(rootNum)) ; e.w(" = call ptr @runtime.RootArena(ptr null)\n")
		e.declareRuntime("runtime.RootArena", "ptr", "")
		e.w("  call void @runtime.SetCurrentArena(ptr %init_root") ; e.w(irItoa(rootNum)) ; e.w(", ptr null)\n")
		e.declareRuntime("runtime.SetCurrentArena", "void", "ptr")
	}
	return e.arenaActive
}

// ssaFuncStoresGlobal reports whether f stores into a package-level global,
// directly or through a field or index path rooted at one. Such a store is only
// legal in initialisation code (checkGlobalMutation enforces that), and the
// memory it stores must outlive every frame.
func ssaFuncStoresGlobal(f *SSAFunction) (ok bool) {
	if f == nil || f.Blocks == nil {
		return false
	}
	for _, b := range f.Blocks {
		for _, instr := range b.Instrs {
			if st, ok2 := instr.(*SSAStore); ok2 && ssaGlobalRoot(st.Addr, 0) != "" {
				return true
			}
		}
	}
	return false
}

// emitSovereignCleanup hands the receiver's borrowed data arena back, marking
// this call's batch dead so the receiver-rooted mark-compact at region
// exhaustion reclaims the dead blocks. EVERY return path out of a mutating
// method on a sovereign receiver must run it: the borrow occupies a slot on the
// runtime's fn-stack, and leaving it there keeps the group's arena marked
// borrowed for the life of the process, which makes the group permanently
// un-compactable - its arena then grows without bound, which is exactly what
// the pending-compaction queue exists to prevent.
func (e *irEmitter) emitSovereignCleanup() {
	e.w("  call void @runtime.codecSovereignEndCall(ptr ") ; e.w(e.sovereignGroupReg) ; e.w(", ptr null)\n")
	e.declareRuntime("runtime.codecSovereignEndCall", "void", "ptr")
	e.w("  call void @runtime.SovereignRegRestore(ptr null)\n")
	e.declareRuntime("runtime.SovereignRegRestore", "void", "")
	e.w("  call void @runtime.SovereignRestoreArena(ptr ") ; e.w(e.parentArenaReg) ; e.w(", ptr null)\n")
	e.declareRuntime("runtime.SovereignRestoreArena", "void", "ptr")
}

// emitArenaExit releases whatever arena this frame pushed, without relocating a
// return value. Used by return paths that carry no value of their own - the
// recover block of a function without named results. Mirrors legacy
// emitArenaEpilogue's zero-result branch.
func (e *irEmitter) emitArenaExit() {
	if !e.arenaActive {
		return
	}
	if e.arenaBorrowed {
		e.emitSovereignCleanup()
		return
	}
	if e.stableReg {
		e.w("  call void @runtime.SovereignRegRestore(ptr null)\n")
		e.declareRuntime("runtime.SovereignRegRestore", "void", "")
	}
	e.w("  call void @runtime.FnArenaPopFree(ptr null)\n")
	e.declareRuntime("runtime.FnArenaPopFree", "void", "")
}

func (e *irEmitter) emitSovereignEpilogue(llvmType string, val string) {
	if llvmType == "void" || e.curFunc.Signature.Results == nil || int32(e.curFunc.Signature.Results.Len()) == 0 {
		e.emitSovereignCleanup()
		e.w("  ret void\n")
		return
	}

	needsCodec := false
	sig := e.curFunc.Signature
	if sig != nil && sig.Results != nil {
		for i := int32(0); i < int32(sig.Results.Len()); i++ {
			if typeNeedsCodec(sig.Results.At(i).Typ) {
				needsCodec = true
				break
			}
		}
	}
	if !needsCodec {
		e.w("  call void @runtime.SovereignRegRestore(ptr null)\n")
		e.declareRuntime("runtime.SovereignRegRestore", "void", "")
		e.w("  call void @runtime.SovereignRestoreArena(ptr ") ; e.w(e.parentArenaReg) ; e.w(", ptr null)\n")
		e.declareRuntime("runtime.SovereignRestoreArena", "void", "ptr")
		e.w("  ret ") ; e.w(llvmType) ; e.w(" ") ; e.w(val) ; e.w("\n")
		return
	}

	ipt := e.intptrType()
	st := e.sliceType()
	// The codec buffer's layout, spelled exactly as llvmStructType spells every
// other struct: no space after the opening brace, ", " between fields. The
// previous "{ " | st | ", i32 }" put a space after the brace, so the buffer's
// local was a DIFFERENT LLVM type from the one the codec descriptor and the
// extractvalue/insertvalue code around it used - clang reported it as
// "invalid cast opcode for cast from '{ {ptr, i32, i32}, i32 }' to
// '{ptr, i32, i32}'", and the extra layer was nothing but whitespace.
	codecBufType := "{" | st | ", i32}"

	// Encode with relocate mode.

	e.nextReg++
	cb := "%cb" ; cb = cb | irItoa(e.nextReg)
	e.w("  ") ; e.w(cb) ; e.w(" = alloca ") ; e.w(codecBufType) ; e.w("\n")
	e.w("  store ") ; e.w(codecBufType) ; e.w(" zeroinitializer, ptr ") ; e.w(cb) ; e.w("\n")

	e.nextReg++
	ss := "%ss" ; ss = ss | irItoa(e.nextReg)
	e.w("  ") ; e.w(ss) ; e.w(" = alloca [64 x ptr]\n")
	e.w("  store [64 x ptr] zeroinitializer, ptr ") ; e.w(ss) ; e.w("\n")

	e.w("  call void @runtime.codecBufInit(ptr ") ; e.w(cb) ; e.w(", ptr null)\n")
	e.declareRuntime("runtime.codecBufInit", "void", "ptr")
	e.w("  call void @runtime.codecSeenInit(ptr ") ; e.w(ss) ; e.w(", ptr null)\n")
	e.declareRuntime("runtime.codecSeenInit", "void", "ptr")
	// Return-value encode: only the callee's own fn arena is transient so
	// pointers into ancestor arenas (e.g. the caller's locals used as
	// chained method receivers) keep identity instead of being copied.
	e.w("  call void @runtime.codecSetRetTransient(i1 true, ptr null)\n")
	e.declareRuntime("runtime.codecSetRetTransient", "void", "i1")

	for i := int32(0); i < int32(e.curFunc.Signature.Results.Len()); i++ {
		rt := e.curFunc.Signature.Results.At(i).Typ
		if !typeNeedsCodec(rt) {
			continue
		}
		var rootReg string
		if e.curFunc.Signature.Results.Len() == 1 {
			rootReg = val
		} else {
			e.nextReg++
			rootReg = "%cext" ; rootReg = rootReg | irItoa(e.nextReg)
			e.w("  ") ; e.w(rootReg) ; e.w(" = extractvalue ") ; e.w(llvmType) ; e.w(" ") ; e.w(val) ; e.w(", ") ; e.w(irItoa(i)) ; e.w("\n")
		}
		e.emitCodecEncode(rootReg, rt, cb, ss)
	}
	e.w("  call void @runtime.codecSetRetTransient(i1 false, ptr null)\n")

	// Save CodecBuf data pointer and position.
	e.nextReg++
	cl := "%cbl" ; cl = cl | irItoa(e.nextReg)
	e.w("  ") ; e.w(cl) ; e.w(" = load ") ; e.w(codecBufType) ; e.w(", ptr ") ; e.w(cb) ; e.w("\n")
	e.nextReg++
	sd := "%csd" ; sd = sd | irItoa(e.nextReg)
	e.w("  ") ; e.w(sd) ; e.w(" = extractvalue ") ; e.w(codecBufType) ; e.w(" ") ; e.w(cl) ; e.w(", 0\n")
	e.nextReg++
	sp := "%csp" ; sp = sp | irItoa(e.nextReg)
	e.w("  ") ; e.w(sp) ; e.w(" = extractvalue ") ; e.w(st) ; e.w(" ") ; e.w(sd) ; e.w(", 1\n")

	// Restore the caller's arena for the decode phase. The data arena is
	// borrowed, not freed.
	e.w("  call void @runtime.SovereignRestoreArena(ptr ") ; e.w(e.parentArenaReg) ; e.w(", ptr null)\n")
	e.declareRuntime("runtime.SovereignRestoreArena", "void", "ptr")
	e.w("  call void @runtime.SovereignRegRestore(ptr null)\n")
	e.declareRuntime("runtime.SovereignRegRestore", "void", "")

	e.nextReg++
	cb2 := "%dcb" ; cb2 = cb2 | irItoa(e.nextReg)
	e.w("  ") ; e.w(cb2) ; e.w(" = alloca ") ; e.w(codecBufType) ; e.w("\n")
	// The buffer is rebuilt from the saved encode data below, so legacy builds
	// it by storing a constructed CodecBuf rather than calling codecBufInit -
	// which would allocate a 256-byte buffer this code immediately discards,
	// once per call that returns a pointer-containing value.

	e.nextReg++
	cd := "%dcd" ; cd = cd | irItoa(e.nextReg)
	e.w("  ") ; e.w(cd) ; e.w(" = extractvalue ") ; e.w(st) ; e.w(" ") ; e.w(sd) ; e.w(", 0\n")
	e.nextReg++
	cdp := "%dcp" ; cdp = cdp | irItoa(e.nextReg)
	e.w("  ") ; e.w(cdp) ; e.w(" = insertvalue ") ; e.w(st) ; e.w(" zeroinitializer, ptr ") ; e.w(cd) ; e.w(", 0\n")
	e.nextReg++
	cf := "%dcf" ; cf = cf | irItoa(e.nextReg)
	e.w("  ") ; e.w(cf) ; e.w(" = insertvalue ") ; e.w(st) ; e.w(" ") ; e.w(cdp) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(sp) ; e.w(", 1\n")
	e.nextReg++
	cg := "%dcg" ; cg = cg | irItoa(e.nextReg)
	e.w("  ") ; e.w(cg) ; e.w(" = insertvalue ") ; e.w(st) ; e.w(" ") ; e.w(cf) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(sp) ; e.w(", 2\n")

	e.nextReg++
	cl2 := "%dbl" ; cl2 = cl2 | irItoa(e.nextReg)
	e.w("  ") ; e.w(cl2) ; e.w(" = load ") ; e.w(codecBufType) ; e.w(", ptr ") ; e.w(cb2) ; e.w("\n")
	e.nextReg++
	ci := "%dci" ; ci = ci | irItoa(e.nextReg)
	e.w("  ") ; e.w(ci) ; e.w(" = insertvalue ") ; e.w(codecBufType) ; e.w(" ") ; e.w(cl2) ; e.w(", ") ; e.w(st) ; e.w(" ") ; e.w(cg) ; e.w(", 0\n")
	e.nextReg++
	cj := "%dcj" ; cj = cj | irItoa(e.nextReg)
	e.w("  ") ; e.w(cj) ; e.w(" = insertvalue ") ; e.w(codecBufType) ; e.w(" ") ; e.w(ci) ; e.w(", i32 0, 1\n")
	e.w("  store ") ; e.w(codecBufType) ; e.w(" ") ; e.w(cj) ; e.w(", ptr ") ; e.w(cb2) ; e.w("\n")

	e.nextReg++
	ds := "%cds" ; ds = ds | irItoa(e.nextReg)
	e.w("  ") ; e.w(ds) ; e.w(" = alloca [64 x ptr]\n")
	e.w("  call void @runtime.codecDecodeSeenInit(ptr ") ; e.w(ds) ; e.w(", ptr null)\n")
	e.declareRuntime("runtime.codecDecodeSeenInit", "void", "ptr")

	cur := val
	for i := int32(0); i < int32(e.curFunc.Signature.Results.Len()); i++ {
		rt := e.curFunc.Signature.Results.At(i).Typ
		if !typeNeedsCodec(rt) {
			continue
		}
		var fixReg string
		if e.curFunc.Signature.Results.Len() == 1 {
			fixReg = val
		} else {
			e.nextReg++
			fixReg = "%cdext" ; fixReg = fixReg | irItoa(e.nextReg)
			e.w("  ") ; e.w(fixReg) ; e.w(" = extractvalue ") ; e.w(llvmType) ; e.w(" ") ; e.w(cur) ; e.w(", ") ; e.w(irItoa(i)) ; e.w("\n")
		}
		newReg := e.emitCodecDecode(fixReg, rt, cb2, ds)
		if e.curFunc.Signature.Results.Len() == 1 {
			cur = newReg
		} else if newReg != fixReg {
			e.nextReg++
			ins := "%cdins" ; ins = ins | irItoa(e.nextReg)
			e.w("  ") ; e.w(ins) ; e.w(" = insertvalue ") ; e.w(llvmType) ; e.w(" ") ; e.w(cur) ; e.w(", ") ; e.w(e.llvmType(rt)) ; e.w(" ") ; e.w(newReg) ; e.w(", ") ; e.w(irItoa(i)) ; e.w("\n")
			cur = ins
		}
	}

	e.w("  ret ") ; e.w(llvmType) ; e.w(" ") ; e.w(cur) ; e.w("\n")
}

func (e *irEmitter) emitRetWithCodec(llvmType string, val string) {
	if !e.arenaActive {
		if llvmType == "void" {
			e.w("  ret void\n")
		} else {
			e.w("  ret ") ; e.w(llvmType) ; e.w(" ") ; e.w(val) ; e.w("\n")
		}
		return
	}

	if e.arenaBorrowed {
		e.emitSovereignEpilogue(llvmType, val)
		return
	}

	needsCodec := false
	if val != "zeroinitializer" && llvmType != "void" {
		sig := e.curFunc.Signature
		if sig != nil && sig.Results != nil {
			for i := int32(0); i < int32(sig.Results.Len()); i++ {
				if typeNeedsCodec(sig.Results.At(i).Typ) {
					needsCodec = true
					break
				}
			}
		}
	}
	if !needsCodec {
		if e.stableReg {
			e.w("  call void @runtime.SovereignRegRestore(ptr null)\n")
			e.declareRuntime("runtime.SovereignRegRestore", "void", "")
		}
		e.w("  call void @runtime.FnArenaPopFree(ptr null)\n")
		e.declareRuntime("runtime.FnArenaPopFree", "void", "")
		if llvmType == "void" {
			e.w("  ret void\n")
		} else {
			e.w("  ret ") ; e.w(llvmType) ; e.w(" ") ; e.w(val) ; e.w("\n")
		}
		return
	}

	// Fast path: a single result whose every pointer is already stable needs no
	// relocation. See codecRetStable.
	if e.curFunc.Signature != nil && e.curFunc.Signature.Results != nil && e.curFunc.Signature.Results.Len() == 1 {
		rt := e.curFunc.Signature.Results.At(0).Typ
		if typeNeedsCodec(rt) {
			elt := e.llvmType(rt)
			e.nextReg++
			hold := "%ffh" ; hold = hold | irItoa(e.nextReg)
			e.w("  ") ; e.w(hold) ; e.w(" = alloca ") ; e.w(elt) ; e.w("\n")
			e.w("  store ") ; e.w(elt) ; e.w(" ") ; e.w(val) ; e.w(", ptr ") ; e.w(hold) ; e.w("\n")
			e.collectTypeDesc(rt)
			tn := e.reflectTypeName(rt)
			e.nextReg++
			ff := "%ffr" ; ff = ff | irItoa(e.nextReg)
			e.w("  ") ; e.w(ff) ; e.w(" = call i1 @runtime.codecRetStable(ptr ") ; e.w(hold) ; e.w(", ptr ") ; e.w(irQuoteName(tn)) ; e.w(", ptr null)\n")
			e.declareRuntime("runtime.codecRetStable", "i1", "ptr, ptr")
			ffid := irItoa(e.nextReg)
			fastLbl := "ff.fast" | ffid
			slowLbl := "ff.slow" | ffid
			e.w("  br i1 ") ; e.w(ff) ; e.w(", label %") ; e.w(fastLbl) ; e.w(", label %") ; e.w(slowLbl) ; e.w("\n")
			e.w(fastLbl) ; e.w(":\n")
			if e.stableReg {
				e.w("  call void @runtime.SovereignRegRestore(ptr null)\n")
				e.declareRuntime("runtime.SovereignRegRestore", "void", "")
			}
			e.w("  call void @runtime.FnArenaPopFree(ptr null)\n")
			e.declareRuntime("runtime.FnArenaPopFree", "void", "")
			e.w("  ret ") ; e.w(llvmType) ; e.w(" ") ; e.w(val) ; e.w("\n")
			e.w(slowLbl) ; e.w(":\n")
		}
	}
	ipt := e.intptrType()
	st := e.sliceType()
	// The codec buffer's layout, spelled exactly as llvmStructType spells every
// other struct: no space after the opening brace, ", " between fields. The
// previous "{ " | st | ", i32 }" put a space after the brace, so the buffer's
// local was a DIFFERENT LLVM type from the one the codec descriptor and the
// extractvalue/insertvalue code around it used - clang reported it as
// "invalid cast opcode for cast from '{ {ptr, i32, i32}, i32 }' to
// '{ptr, i32, i32}'", and the extra layer was nothing but whitespace.
	codecBufType := "{" | st | ", i32}"

	// Encode phase (allocations in fn_arena)
	e.nextReg++
	cb := "%cb" ; cb = cb | irItoa(e.nextReg)
	e.w("  ") ; e.w(cb) ; e.w(" = alloca ") ; e.w(codecBufType) ; e.w("\n")
	e.w("  store ") ; e.w(codecBufType) ; e.w(" zeroinitializer, ptr ") ; e.w(cb) ; e.w("\n")

	e.nextReg++
	ss := "%ss" ; ss = ss | irItoa(e.nextReg)
	e.w("  ") ; e.w(ss) ; e.w(" = alloca [64 x ptr]\n")
	e.w("  store [64 x ptr] zeroinitializer, ptr ") ; e.w(ss) ; e.w("\n")

	e.w("  call void @runtime.codecBufInit(ptr ") ; e.w(cb) ; e.w(", ptr null)\n")
	e.declareRuntime("runtime.codecBufInit", "void", "ptr")
	e.w("  call void @runtime.codecSeenInit(ptr ") ; e.w(ss) ; e.w(", ptr null)\n")
	e.declareRuntime("runtime.codecSeenInit", "void", "ptr")
	// Return-value encode: only the callee's own fn arena is transient so
	// pointers into ancestor arenas (e.g. the caller's locals used as
	// chained method receivers) keep identity instead of being copied.
	e.w("  call void @runtime.codecSetRetTransient(i1 true, ptr null)\n")
	e.declareRuntime("runtime.codecSetRetTransient", "void", "i1")

	for i := int32(0); i < int32(e.curFunc.Signature.Results.Len()); i++ {
		rt := e.curFunc.Signature.Results.At(i).Typ
		if !typeNeedsCodec(rt) {
			continue
		}
		var rootReg string
		if e.curFunc.Signature.Results.Len() == 1 {
			rootReg = val
		} else {
			e.nextReg++
			rootReg = "%cext" ; rootReg = rootReg | irItoa(e.nextReg)
			e.w("  ") ; e.w(rootReg) ; e.w(" = extractvalue ") ; e.w(llvmType) ; e.w(" ") ; e.w(val) ; e.w(", ") ; e.w(irItoa(i)) ; e.w("\n")
		}
		e.emitCodecEncode(rootReg, rt, cb, ss)
	}
	e.w("  call void @runtime.codecSetRetTransient(i1 false, ptr null)\n")

	// Save CodecBuf data pointer and position (scalars survive FnArenaPop)
	e.nextReg++
	cl := "%cbl" ; cl = cl | irItoa(e.nextReg)
	e.w("  ") ; e.w(cl) ; e.w(" = load ") ; e.w(codecBufType) ; e.w(", ptr ") ; e.w(cb) ; e.w("\n")
	e.nextReg++
	sd := "%csd" ; sd = sd | irItoa(e.nextReg)
	e.w("  ") ; e.w(sd) ; e.w(" = extractvalue ") ; e.w(codecBufType) ; e.w(" ") ; e.w(cl) ; e.w(", 0\n")
	e.nextReg++
	sp := "%csp" ; sp = sp | irItoa(e.nextReg)
	e.w("  ") ; e.w(sp) ; e.w(" = extractvalue ") ; e.w(st) ; e.w(" ") ; e.w(sd) ; e.w(", 1\n")

	// Reclaim fn arena position
	e.nextReg++
	fn := "%cfn" ; fn = fn | irItoa(e.nextReg)
	e.w("  ") ; e.w(fn) ; e.w(" = call ptr @runtime.FnArenaPop(ptr null)\n")
	e.declareRuntime("runtime.FnArenaPop", "ptr", "")

	// Decode phase: build cb2 from saved data
	e.nextReg++
	cb2 := "%dcb" ; cb2 = cb2 | irItoa(e.nextReg)
	e.w("  ") ; e.w(cb2) ; e.w(" = alloca ") ; e.w(codecBufType) ; e.w("\n")
	// The buffer is rebuilt from the saved encode data below, so legacy builds
	// it by storing a constructed CodecBuf rather than calling codecBufInit -
	// which would allocate a 256-byte buffer this code immediately discards,
	// once per call that returns a pointer-containing value.

	e.nextReg++
	cd := "%dcd" ; cd = cd | irItoa(e.nextReg)
	e.w("  ") ; e.w(cd) ; e.w(" = extractvalue ") ; e.w(st) ; e.w(" ") ; e.w(sd) ; e.w(", 0\n")
	e.nextReg++
	cdp := "%dcp" ; cdp = cdp | irItoa(e.nextReg)
	e.w("  ") ; e.w(cdp) ; e.w(" = insertvalue ") ; e.w(st) ; e.w(" zeroinitializer, ptr ") ; e.w(cd) ; e.w(", 0\n")
	e.nextReg++
	cf := "%dcf" ; cf = cf | irItoa(e.nextReg)
	e.w("  ") ; e.w(cf) ; e.w(" = insertvalue ") ; e.w(st) ; e.w(" ") ; e.w(cdp) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(sp) ; e.w(", 1\n")
	e.nextReg++
	cg := "%dcg" ; cg = cg | irItoa(e.nextReg)
	e.w("  ") ; e.w(cg) ; e.w(" = insertvalue ") ; e.w(st) ; e.w(" ") ; e.w(cf) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(sp) ; e.w(", 2\n")

	e.nextReg++
	cl2 := "%dbl" ; cl2 = cl2 | irItoa(e.nextReg)
	e.w("  ") ; e.w(cl2) ; e.w(" = load ") ; e.w(codecBufType) ; e.w(", ptr ") ; e.w(cb2) ; e.w("\n")
	e.nextReg++
	ci := "%dci" ; ci = ci | irItoa(e.nextReg)
	e.w("  ") ; e.w(ci) ; e.w(" = insertvalue ") ; e.w(codecBufType) ; e.w(" ") ; e.w(cl2) ; e.w(", ") ; e.w(st) ; e.w(" ") ; e.w(cg) ; e.w(", 0\n")
	e.nextReg++
	cj := "%dcj" ; cj = cj | irItoa(e.nextReg)
	e.w("  ") ; e.w(cj) ; e.w(" = insertvalue ") ; e.w(codecBufType) ; e.w(" ") ; e.w(ci) ; e.w(", i32 0, 1\n")
	e.w("  store ") ; e.w(codecBufType) ; e.w(" ") ; e.w(cj) ; e.w(", ptr ") ; e.w(cb2) ; e.w("\n")

	e.nextReg++
	ds := "%cds" ; ds = ds | irItoa(e.nextReg)
	e.w("  ") ; e.w(ds) ; e.w(" = alloca [64 x ptr]\n")
	e.w("  call void @runtime.codecDecodeSeenInit(ptr ") ; e.w(ds) ; e.w(", ptr null)\n")
	e.declareRuntime("runtime.codecDecodeSeenInit", "void", "ptr")

	cur := val
	for i := int32(0); i < int32(e.curFunc.Signature.Results.Len()); i++ {
		rt := e.curFunc.Signature.Results.At(i).Typ
		if !typeNeedsCodec(rt) {
			continue
		}
		var fixReg string
		if e.curFunc.Signature.Results.Len() == 1 {
			fixReg = val
		} else {
			e.nextReg++
			fixReg = "%cdext" ; fixReg = fixReg | irItoa(e.nextReg)
			e.w("  ") ; e.w(fixReg) ; e.w(" = extractvalue ") ; e.w(llvmType) ; e.w(" ") ; e.w(cur) ; e.w(", ") ; e.w(irItoa(i)) ; e.w("\n")
		}
		newReg := e.emitCodecDecode(fixReg, rt, cb2, ds)
		if e.curFunc.Signature.Results.Len() == 1 {
			cur = newReg
		} else if newReg != fixReg {
			elt := e.llvmType(rt)
			e.nextReg++
			ins := "%cdins" ; ins = ins | irItoa(e.nextReg)
			e.w("  ") ; e.w(ins) ; e.w(" = insertvalue ") ; e.w(llvmType) ; e.w(" ") ; e.w(cur) ; e.w(", ") ; e.w(elt) ; e.w(" ") ; e.w(newReg) ; e.w(", ") ; e.w(irItoa(i)) ; e.w("\n")
			cur = ins
		}
	}

	// A pointer that escaped into the returned graph from the fn arena must
	// stay alive for the caller: leak the arena instead of releasing it to the
	// pool when the codec saw an escape. Mirrors legacy/compiler/compiler.go
	// (codecEscapeOccurred), which has always done this - without it stage4
	// released the frame the return value still pointed into and the caller
	// read freed memory (SIGSEGV in main after filter.UnmarshalFilters).
	esc := e.nextReg2("cesc")
	e.w("  ") ; e.w(esc) ; e.w(" = call i1 @runtime.codecEscapeOccurred(ptr null)\n")
	e.declareRuntime("runtime.codecEscapeOccurred", "i1", "")
	escCmp := e.nextReg2("cesccmp")
	e.w("  ") ; e.w(escCmp) ; e.w(" = icmp eq i1 ") ; e.w(esc) ; e.w(", false\n")
	id := irItoa(e.nextReg)
	relLbl := "rel.release" | id
	leakLbl := "rel.leak" | id
	joinLbl := "rel.join" | id
	e.w("  br i1 ") ; e.w(escCmp) ; e.w(", label %") ; e.w(relLbl) ; e.w(", label %") ; e.w(leakLbl) ; e.w("\n")
	e.w(relLbl) ; e.w(":\n")
	e.w("  call void @runtime.ArenaRelease(ptr ") ; e.w(fn) ; e.w(", ptr null)\n")
	e.declareRuntime("runtime.ArenaRelease", "void", "ptr")
	e.w("  br label %") ; e.w(joinLbl) ; e.w("\n")
	e.w(leakLbl) ; e.w(":\n")
	e.w("  br label %") ; e.w(joinLbl) ; e.w("\n")
	e.w(joinLbl) ; e.w(":\n")
	if e.stableReg {
		e.w("  call void @runtime.SovereignRegRestore(ptr null)\n")
		e.declareRuntime("runtime.SovereignRegRestore", "void", "")
	}
	e.w("  ret ") ; e.w(llvmType) ; e.w(" ") ; e.w(cur) ; e.w("\n")
}

// emitCodecEncode generates code to encode a value into the CodecBuf.
func (e *irEmitter) collectAllTypeDescs(t Type, seen map[string]bool) {
	if t == nil { return }
	u := SafeUnderlying(t)
	if u == nil { return }
	tail := e.typeDescName(t)
	if seen[tail] { return }
	seen[tail] = true
	if e.pendTypeDescs == nil { e.pendTypeDescs = map[string]Type{} }
	e.pendTypeDescs[tail] = t
	switch tt := u.(type) {
	case *Pointer:
		e.collectAllTypeDescs(tt.Base, seen)
	case *Slice:
		e.collectAllTypeDescs(tt.Elem, seen)
	case *TCMap:
		e.collectAllTypeDescs(tt.Key, seen)
		e.collectAllTypeDescs(tt.Elem, seen)
	case *TCChan:
		e.collectAllTypeDescs(tt.Elem, seen)
	case *TCStruct:
		for i := int32(0); i < tt.NumFields(); i++ {
			e.collectAllTypeDescs(tt.Field(i).Typ, seen)
		}
	case *TCInterface:
	}
}

func (e *irEmitter) emitCodecEncode(reg string, t Type, cb string, ss string) {
	if t == nil || !typeNeedsCodec(t) {
		return
	}
	lt := e.llvmType(t)
	e.nextReg++
	tmp := "%cet" ; tmp = tmp | irItoa(e.nextReg)
	e.w("  ") ; e.w(tmp) ; e.w(" = alloca ") ; e.w(lt) ; e.w("\n")
	e.w("  store ") ; e.w(lt) ; e.w(" ") ; e.w(reg) ; e.w(", ptr ") ; e.w(tmp) ; e.w("\n")
	e.collectTypeDesc(t)
	tn := e.reflectTypeName(t)
	e.w("  call void @runtime.codecEncodeValue(ptr ") ; e.w(cb) ; e.w(", ptr ") ; e.w(ss)
	e.w(", ptr ") ; e.w(tmp) ; e.w(", ptr ") ; e.w(irQuoteName(tn)) ; e.w(", ptr null)\n")
	e.declareRuntime("runtime.codecEncodeValue", "void", "ptr, ptr, ptr, ptr")
}

func (e *irEmitter) emitCodecDecode(reg string, t Type, cb string, ds string) (newReg string) {
	if t == nil || !typeNeedsCodec(t) {
		return reg
	}
	lt := e.llvmType(t)
	tn := e.reflectTypeName(t)
	e.nextReg++
	dec := "%cdv" ; dec = dec | irItoa(e.nextReg)
	e.w("  ") ; e.w(dec) ; e.w(" = call ptr @runtime.codecDecodeValue(ptr ") ; e.w(cb)
	e.w(", ptr ") ; e.w(ds) ; e.w(", ptr ") ; e.w(irQuoteName(tn)) ; e.w(", ptr null)\n")
	e.declareRuntime("runtime.codecDecodeValue", "ptr", "ptr, ptr, ptr")
	e.nextReg++
	res := "%cdl" ; res = res | irItoa(e.nextReg)
	e.w("  ") ; e.w(res) ; e.w(" = load ") ; e.w(lt) ; e.w(", ptr ") ; e.w(dec) ; e.w("\n")
	return res
}

func isStringLike(t Type) (ok bool) {
	if t == nil {
		return false
	}
	if b, isB := t.(*Basic); isB {
		return b.Kind == TCString || b.Kind == UntypedString
	}
	return false
}


