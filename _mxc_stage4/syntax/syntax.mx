package syntax

import (
	"unsafe"
	"errors"
	"mxc/token"
	"io"
	"os"
)

type Mode uint32

const (
	CheckBranches Mode = 1 << iota
)

type Error struct {
	Pos token.Pos
	Msg string
}

func (err Error) Error() (s string) {
	return err.Pos.String() | ": " | err.Msg
}

func (err Error) String() (s string) { return err.Error() }

var CompileExportMap map[string]string

type ErrorHandler func(err error)

type Pragma unsafe.Pointer

type PragmaHandler func(pos token.Pos, blank bool, text string, current Pragma) Pragma

func Parse(base *token.PosBase, src io.Reader, errh ErrorHandler, pragh PragmaHandler, mode Mode) (_ *File, first error) {
	defer func() {
		if p := recover(); p != "" {
			first = errors.New(p)
		}
	}()

	var p Parser
	p.init(base, src, errh, pragh, mode)
	p.Next()
	return p.fileOrNil(), p.First
}

func ParseBytes(base *token.PosBase, src []byte, errh ErrorHandler, pragh PragmaHandler, mode Mode) (_ *File, first error) {
	var parseFirst error
	defer func() {
		if p := recover(); p != "" {
			parseFirst = errors.New(p)
			first = errors.New(p)
		}
	}()

	var p Parser
	p.initBytes(base, src, errh, pragh, mode)
	p.Next()
	f := p.fileOrNil()
	_ = parseFirst
	return f, p.First
}

func ParseFile(filename string, errh ErrorHandler, pragh PragmaHandler, mode Mode) (r0 *File, r1 error) {
	f, err := os.Open(filename)
	if err != nil {
		if errh != nil {
			errh(err)
		}
		return nil, err
	}
	defer f.Close()
	return Parse(token.NewFileBase(filename), f, errh, pragh, mode)
}
