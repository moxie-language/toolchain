package main

import (
	"github.com/moxie-language/toolchain/pkg/mxutil"
	. "github.com/moxie-language/toolchain/pkg/types"
)

func structPtrFieldIdx(t string) (idx int32, ftype string) {
	if len(t) < 2 || t[0] != '{' {
		return 0, t
	}
	depth := 0
	fields := []string{:0:4}
	start := int32(-1)
	for i := int32(0); i < int32(len(t)); i++ {
		if t[i] == '{' {
			depth++
			if depth == 1 {
				start = i + 1
				for start < int32(len(t)) && t[start] == ' ' {
					start++
				}
			}
		} else if t[i] == '}' {
			depth--
			if depth == 0 {
				field := mxutil.TrimSpace(t[start:i])
				fields = mxutil.Ensure(fields, 1)
				push(fields, field)
				break
			}
		} else if t[i] == ',' && depth == 1 {
			field := mxutil.TrimSpace(t[start:i])
			fields = mxutil.Ensure(fields, 1)
			push(fields, field)
			start = i + 1
			for start < int32(len(t)) && t[start] == ' ' {
				start++
			}
		}
	}
	for fi, ft := range fields {
		if ft == "ptr" {
			return int32(fi), ft
		}
	}
	return 0, fields[0]
}

// emitShift materializes Go's shift rule for a shift whose operands are
// already at the result width (resT). Go defines a shift count >= the operand
// width as zero, and an arithmetic right shift by such a count as the sign bit
// replicated. LLVM treats an out-of-range shl/ashr/lshr count as poison and the
// x86 backend masks the count, so a runtime count of 64 became a shift by 0 -
// strconv's maxVal := uint64(1)<<uint32(bitSize) computed 0 for bitSize 64 and
// every digit tripped the range check. A constant count is folded here; a
// dynamic count gets an explicit overshift select, with the signed-right case
// capping the count at width-1 (ashr by width-1 is the required sign fill).
func (e *irEmitter) emitShift(b *SSABinOp, reg, resT, lv, rv string) {
	width := e.intBits(resT)
	op := e.llvmBinOp(b.Op, b.X.SSAType())
	if isNumericLiteral(rv) {
		if n, ok := floatLitToInt(rv); ok {
			if n >= int64(width) || n < 0 {
				if op == "ashr" {
					e.nextReg++
					fill := "%sh" | irItoa(e.nextReg)
					e.w("  ") ; e.w(fill) ; e.w(" = ashr ") ; e.w(resT) ; e.w(" ") ; e.w(lv) ; e.w(", ") ; e.w(irItoa(width-1)) ; e.w("\n")
					e.w("  ") ; e.w(reg) ; e.w(" = add ") ; e.w(resT) ; e.w(" ") ; e.w(fill) ; e.w(", 0\n")
				} else {
					e.w("  ") ; e.w(reg) ; e.w(" = add ") ; e.w(resT) ; e.w(" 0, 0\n")
				}
				e.setRegType(b, reg, resT)
				return
			}
		}
	}
	if op == "ashr" {
		e.nextReg++
		over := "%sh" | irItoa(e.nextReg)
		e.w("  ") ; e.w(over) ; e.w(" = icmp uge ") ; e.w(resT) ; e.w(" ") ; e.w(rv) ; e.w(", ") ; e.w(irItoa(width)) ; e.w("\n")
		e.nextReg++
		off := "%sh" | irItoa(e.nextReg)
		e.w("  ") ; e.w(off) ; e.w(" = select i1 ") ; e.w(over) ; e.w(", ") ; e.w(resT) ; e.w(" ") ; e.w(irItoa(width-1)) ; e.w(", ") ; e.w(resT) ; e.w(" ") ; e.w(rv) ; e.w("\n")
		e.w("  ") ; e.w(reg) ; e.w(" = ashr ") ; e.w(resT) ; e.w(" ") ; e.w(lv) ; e.w(", ") ; e.w(off) ; e.w("\n")
	} else {
		e.nextReg++
		over := "%sh" | irItoa(e.nextReg)
		e.w("  ") ; e.w(over) ; e.w(" = icmp uge ") ; e.w(resT) ; e.w(" ") ; e.w(rv) ; e.w(", ") ; e.w(irItoa(width)) ; e.w("\n")
		e.nextReg++
		shifted := "%sh" | irItoa(e.nextReg)
		e.w("  ") ; e.w(shifted) ; e.w(" = ") ; e.w(op) ; e.w(" ") ; e.w(resT) ; e.w(" ") ; e.w(lv) ; e.w(", ") ; e.w(rv) ; e.w("\n")
		e.w("  ") ; e.w(reg) ; e.w(" = select i1 ") ; e.w(over) ; e.w(", ") ; e.w(resT) ; e.w(" 0, ") ; e.w(resT) ; e.w(" ") ; e.w(shifted) ; e.w("\n")
	}
	e.setRegType(b, reg, resT)
}

// widerIntType returns the wider of an instruction's two integer operands,
// falling back to def. An untyped constant is materialised at the narrowest
// type that holds its exact value - i64 for a value >= 2^63, which carries the
// unsigned mark - and Go evaluates an operation with an untyped operand at that
// width rather than at the untyped 32-bit default.
// intConstToFloat renders an integer constant operand as an LLVM double
// literal. A constant whose exact value is >= 2^63 carries the unsigned mark
// and V holds its low bits, so the signed decimal text flips the sign:
// `yi >= 1 << 63` compiled to `yi >= -9223372036854775808.0`, true for every
// value, and math.Pow took its overflow branch for every integer exponent.
// ConstInt.String prints the exact unsigned decimal for those.
func intConstToFloat(v SSAValue, text string) (s string) {
	if k, ok := v.(*SSAConst); ok {
		if ci, ok2 := k.val.(*ConstInt); ok2 && ci.Unsigned {
			return ensureFloatLit(ci.String())
		}
	}
	return ensureFloatLit(text)
}

func (e *irEmitter) widerIntType(b *SSABinOp, def string) (w string) {
	w = def
	if b.X != nil && b.X.SSAType() != nil {
		if at := e.resolvedType(b.X, e.llvmType(b.X.SSAType())); e.intBits(at) > e.intBits(w) {
			w = at
		}
	}
	if b.Y != nil && b.Y.SSAType() != nil {
		if at := e.resolvedType(b.Y, e.llvmType(b.Y.SSAType())); e.intBits(at) > e.intBits(w) {
			w = at
		}
	}
	return w
}

func (e *irEmitter) emitBinOp(b *SSABinOp) {
	if b.X == nil || b.X.SSAType() == nil {
		recov := false
		if b.X == nil {
			for _, blk := range e.curFunc.Blocks {
				for i, inst := range blk.Instrs {
					if inst == b && i > 0 {
						if prev, ok := blk.Instrs[i-1].(*SSAUnOp); ok && prev.Op == OpMul {
							b.X = prev
							recov = true
						}
					}
				}
				if recov { break }
			}
		}
		if !recov && b.X != nil {
			rt2 := e.resolvedType(b.X, "i32")
			if rt2 != "i32" && rt2 != "" && !(len(rt2) > 0 && rt2[0] == '{') {
				reg2 := e.regName(b)
				lv2 := e.operand(b.X)
				rv2 := e.operand(b.Y)
				isNullRecov := (b.Op == OpEql || b.Op == OpNeq) && (rv2 == "null" || rv2 == "zeroinitializer" || lv2 == "null" || lv2 == "zeroinitializer")
				if isNullRecov && len(rt2) > 0 && rt2[0] == '{' {
					aggVal := lv2
					if lv2 == "null" || lv2 == "zeroinitializer" { aggVal = rv2 }
					fi, ft := structPtrFieldIdx(rt2)
					e.nextReg++
					extReg := "%ne" | irItoa(e.nextReg)
					e.w("  ") ; e.w(extReg) ; e.w(" = extractvalue ") ; e.w(rt2) ; e.w(" ") ; e.w(aggVal) ; e.w(", ") ; e.w(irItoa(fi)) ; e.w("\n")
					curVal := extReg
					if ft != "ptr" {
						if e.intBits(ft) > 0 {
							e.nextReg++
							castReg := "%ne" | irItoa(e.nextReg)
							e.w("  ") ; e.w(castReg) ; e.w(" = inttoptr ") ; e.w(ft) ; e.w(" ") ; e.w(curVal) ; e.w(" to ptr\n")
							curVal = castReg
						}
						ft = "ptr"
					}
					cmpOp := "icmp eq"
					if b.Op == OpNeq { cmpOp = "icmp ne" }
					e.w("  ") ; e.w(reg2) ; e.w(" = ") ; e.w(cmpOp) ; e.w(" ") ; e.w(ft) ; e.w(" ") ; e.w(curVal) ; e.w(", null\n")
					e.setRegType(b, reg2, "i1")
					return
				}
				op2 := e.llvmBinOp(b.Op, nil)
				e.w("  ") ; e.w(reg2) ; e.w(" = ") ; e.w(op2) ; e.w(" ") ; e.w(rt2) ; e.w(" ") ; e.w(lv2) ; e.w(", ") ; e.w(rv2) ; e.w("\n")
				e.setRegType(b, reg2, rt2)
				return
			}
		}
		if !recov {
			e.emitZeroReg(e.regName(b), b.SSAType())
			return
		}
	}
	reg := e.regName(b)
	lt := e.llvmType(b.X.SSAType())
	if lt == "void" && b.Y != nil {
		lt = e.llvmType(b.Y.SSAType())
	}
	if _, xIsIA := b.X.(*SSAIndexAddr); !xIsIA {
		if at, ok := e.allocTypes[b.X]; ok && at != "ptr" && at != "void" && at != lt {
			isScalarToAgg := len(lt) > 0 && (lt[0] == 'i' || lt == "double" || lt == "float") && len(at) > 0 && at[0] == '{'
			isAggToScalar := len(lt) > 0 && lt[0] == '{' && len(at) > 0 && (at[0] == 'i' || at == "double" || at == "float")
			if !isScalarToAgg && !isAggToScalar {
				lt = at
			}
		}
	}
	lv := e.operand(b.X)
	rv := e.operand(b.Y)
	// One interface and one concrete operand. Go's type-checker converts the
	// concrete side to the interface before comparing, and legacy inherits
	// that from go/ssa; stage4's builder leaves the pair mixed. Do this
	// before the string/slice/null paths, which would otherwise treat the
	// interface as a concrete string (`errors.Const sentinel == err`) or
	// compare the interface's data slot against the address of a freshly
	// boxed copy (always false: syscall.Errno against a non-blocking
	// connect's EINPROGRESS). Box the concrete side into the interface
	// representation and delegate to the runtime's kind-aware comparison.
	if (b.Op == OpEql || b.Op == OpNeq) && b.X != nil && b.X.SSAType() != nil && b.Y != nil && b.Y.SSAType() != nil {
		xIfaceCmp := false
		yIfaceCmp := false
		_, xIfaceCmp = SafeUnderlying(b.X.SSAType()).(*TCInterface)
		_, yIfaceCmp = SafeUnderlying(b.Y.SSAType()).(*TCInterface)
		isNullCmpEarly := rv == "null" || rv == "zeroinitializer" || lv == "null" || lv == "zeroinitializer"
		if xIfaceCmp != yIfaceCmp && !isNullCmpEarly {
			var cmpIfaceLLVM string
			var cmpIfaceVal string
			var cmpConc SSAValue
			var cmpConcT string
			var cmpConcV string
			if xIfaceCmp {
				cmpIfaceLLVM = lt
				cmpIfaceVal = lv
				cmpConc = b.Y
				cmpConcT = e.llvmType(b.Y.SSAType())
				cmpConcV = rv
			} else {
				cmpIfaceLLVM = e.llvmType(b.Y.SSAType())
				cmpIfaceVal = rv
				cmpConc = b.X
				cmpConcT = e.llvmType(b.X.SSAType())
				cmpConcV = lv
			}
			if at, ok := e.allocTypes[cmpConc]; ok && at != "" && at != "void" {
				cmpConcT = at
			}
			if cmpIfaceLLVM == e.ifaceType() && cmpConcT != "" && cmpConcT != e.ifaceType() && cmpConcT != "{ptr, ptr}" {
				var cmpIfaceSSA Type
				if xIfaceCmp {
					cmpIfaceSSA = b.X.SSAType()
				} else {
					cmpIfaceSSA = b.Y.SSAType()
				}
				bxT, bxV := e.boxConcreteToIfaceParam(cmpIfaceSSA, cmpConc, cmpConcT, cmpConcV)
				if bxT == e.ifaceType() {
					iaP := e.ifacePtrPair(cmpIfaceVal)
					ibP := e.ifacePtrPair(bxV)
					if b.Op == OpEql {
						e.w("  ") ; e.w(reg) ; e.w(" = call i1 @runtime.interfaceEqual({ptr, ptr} ") ; e.w(iaP)
						e.w(", {ptr, ptr} ") ; e.w(ibP) ; e.w(", ptr null)\n")
					} else {
						e.nextReg++
						iNq := "%ineq" | irItoa(e.nextReg)
						e.w("  ") ; e.w(iNq) ; e.w(" = call i1 @runtime.interfaceEqual({ptr, ptr} ") ; e.w(iaP)
						e.w(", {ptr, ptr} ") ; e.w(ibP) ; e.w(", ptr null)\n")
						e.w("  ") ; e.w(reg) ; e.w(" = xor i1 ") ; e.w(iNq) ; e.w(", true\n")
					}
					e.declareRuntime("runtime.interfaceEqual", "i1", "{ptr, ptr}, {ptr, ptr}")
					return
				}
			}
		}
	}
	if (b.Op == OpAdd || b.Op == OpOr) && b.X.SSAType() != nil {
		if sl, ok := SafeUnderlying(b.X.SSAType()).(*Slice); ok {
			e.emitSliceConcat(reg, sl, lv, rv)
			return
		}
		if e.isStringLike(b.X.SSAType()) {
			e.emitSliceConcat(reg, NewSlice(Typ[Uint8]), lv, rv)
			return
		}
	}
	if b.X.SSAType() != nil && e.isStringLike(b.X.SSAType()) && (lt == e.sliceType() || lt == "ptr" || lt == "void") {
		isActuallyIface := false
		if at, ok := e.allocTypes[b.X]; ok && at == e.ifaceType() {
			isActuallyIface = true
		}
		rvOK := true
		if b.Y != nil {
			rvType := e.llvmType(b.Y.SSAType())
			rvResolved := e.resolvedType(b.Y, rvType)
			if load, ok := b.Y.(*SSAUnOp); ok && load.Op == OpMul {
				if g, ok2 := load.X.(*SSAGlobal); ok2 {
					if gt, ok3 := e.globalTypes[e.globalName(g)]; ok3 {
						rvResolved = gt
					}
				}
			}
			if e.intBits(rvResolved) > 0 {
				rvOK = false
			}
		}
		if !isActuallyIface && rvOK {
			e.emitStringCompare(reg, b.Op, lv, rv)
			return
		}
	}
	// `lt == sliceType()` says "this is a 3-word {ptr, len, cap}", which a
	// []string satisfies just as a string does. Only the Moxie type can tell
	// the text case apart, and routing a []string here compared two slice
	// headers as if they were characters. A nil type keeps the old reading -
	// the callers that pass one are the text paths.
	isStringOp := lt == e.sliceType()
	if b.X.SSAType() != nil && !textSlice(b.X.SSAType()) {
		isStringOp = false
	}
	// Fallback: if RV looks like a string aggregate but LV has a mismatched
	// type, bitcast LV to string type. An interface LV must NOT take this
	// path: reloading the first 24 bytes of an {i64, ptr} interface as a
	// {ptr, i64, i64} string compares the type-ID and data pointer as if they
	// were the string header. `switch target { case oserror.ErrNotExist }`
	// (errors.Const is a string-kind named type) silently never matched,
	// which broke errors.Is / os.IsNotExist in every binary built here. The
	// dedicated interface comparison below extracts the data pointer and
	// compares the boxed string instead.
	lvIsIface := lt == e.ifaceType()
	if !lvIsIface && b.X != nil && b.X.SSAType() != nil {
		if _, ok := SafeUnderlying(b.X.SSAType()).(*TCInterface); ok {
			lvIsIface = true
		}
	}
	if !isStringOp && !lvIsIface && (b.Op == OpEql || b.Op == OpNeq) {
		rvIsStr := len(rv) > 6 && rv[0] == '{' && rv[2] == 'p' && rv[3] == 't' && rv[4] == 'r'
		if rvIsStr {
			sty := e.sliceType()
			if lt != sty && lt != "void" && len(lt) > 0 && lt[0] == '{' {
				e.nextReg++
				cast := "%sbc" | irItoa(e.nextReg)
				e.w("  ") ; e.w(cast) ; e.w(" = alloca ") ; e.w(sty) ; e.w("\n")
				e.nextReg++
				tmp := "%sbc" | irItoa(e.nextReg)
				e.w("  ") ; e.w(tmp) ; e.w(" = alloca ") ; e.w(lt) ; e.w("\n")
				e.w("  store ") ; e.w(lt) ; e.w(" ") ; e.w(lv) ; e.w(", ptr ") ; e.w(tmp) ; e.w("\n")
				e.nextReg++
				reloaded := "%sbc" | irItoa(e.nextReg)
				e.w("  ") ; e.w(reloaded) ; e.w(" = load ") ; e.w(sty) ; e.w(", ptr ") ; e.w(tmp) ; e.w("\n")
				lv = reloaded
			}
			lt = sty
			isStringOp = true
		}
	}
	if isStringOp {
		rvOK2 := true
		if b.Y != nil {
			if load, ok := b.Y.(*SSAUnOp); ok && load.Op == OpMul {
				if g, ok2 := load.X.(*SSAGlobal); ok2 {
					if gt, ok3 := e.globalTypes[e.globalName(g)]; ok3 && e.intBits(gt) > 0 {
						rvOK2 = false
					}
				}
			}
		}
		if rvOK2 {
			e.emitStringCompare(reg, b.Op, lv, rv)
			return
		}
	}
	isNullCmp := (b.Op == OpEql || b.Op == OpNeq) && (rv == "null" || rv == "zeroinitializer" || lv == "null" || lv == "zeroinitializer")
	if isNullCmp && len(lt) > 0 && lt[0] == '{' && lt != "{ptr, ptr}" && lt != e.sliceType() && lt != e.ifaceType() {
		aggVal := lv
		if lv == "null" || lv == "zeroinitializer" {
			aggVal = rv
		}
		curType := lt
		curVal := aggVal
		for len(curType) > 0 && curType[0] == '{' {
			e.nextReg++
			extReg := "%ne" | irItoa(e.nextReg)
			e.w("  ") ; e.w(extReg) ; e.w(" = extractvalue ") ; e.w(curType) ; e.w(" ") ; e.w(curVal) ; e.w(", 0\n")
			curVal = extReg
			curType = e.structField0Type(curType)
		}
		if curType != "ptr" {
			curType = "ptr"
		}
		cmpOp := "icmp eq"
		if b.Op == OpNeq {
			cmpOp = "icmp ne"
		}
		e.w("  ") ; e.w(reg) ; e.w(" = ") ; e.w(cmpOp) ; e.w(" ") ; e.w(curType) ; e.w(" ") ; e.w(curVal) ; e.w(", null\n")
		return
	}
	if isNullCmp && b.X.SSAType() != nil {
		u := SafeUnderlying(b.X.SSAType())
		_, isIface := u.(*TCInterface)
		_, isSlice := u.(*Slice)
		_, isSig := u.(*Signature)
		_, isPtr := u.(*Pointer)
		if !isPtr {
			if b2, ok2 := u.(*Basic); ok2 && b2.Kind == UnsafePointer {
				isPtr = true
			}
		}
		_, isMap := u.(*TCMap)
		_, isChan := u.(*TCChan)
		if !isIface && !isSlice && !isSig && !isPtr && u == nil && (lt == "{ptr, ptr}" || lt == e.ifaceType() || lt == "{ptr, " | e.intptrType() | "}") {
			isIface = true
		}
		if isSig {
			e.nextReg++
			extReg := "%ne" | irItoa(e.nextReg)
			aggVal := lv
			if lv == "null" || lv == "zeroinitializer" {
				aggVal = rv
			}
			e.w("  ") ; e.w(extReg) ; e.w(" = extractvalue ") ; e.w(lt) ; e.w(" ") ; e.w(aggVal) ; e.w(", 1\n")
			cmpOp := "icmp eq"
			if b.Op == OpNeq {
				cmpOp = "icmp ne"
			}
			e.w("  ") ; e.w(reg) ; e.w(" = ") ; e.w(cmpOp) ; e.w(" ptr ") ; e.w(extReg) ; e.w(", null\n")
			return
		}
		if (isMap || isChan) && lt == "ptr" {
			isPtr = true
		}
		if isIface || isSlice || ((isMap || isChan) && lt != "ptr") || e.isStringLike(b.X.SSAType()) {
			e.nextReg++
			extReg := "%ne" | irItoa(e.nextReg)
			aggVal := lv
			if lv == "null" || lv == "zeroinitializer" {
				aggVal = rv
			}
			e.w("  ") ; e.w(extReg) ; e.w(" = extractvalue ") ; e.w(lt) ; e.w(" ") ; e.w(aggVal) ; e.w(", 0\n")
			cmpOp := "icmp eq"
			if b.Op == OpNeq {
				cmpOp = "icmp ne"
			}
			if lt == e.ifaceType() {
				e.w("  ") ; e.w(reg) ; e.w(" = ") ; e.w(cmpOp) ; e.w(" " | e.intptrType() | " ") ; e.w(extReg) ; e.w(", 0\n")
			} else {
				e.w("  ") ; e.w(reg) ; e.w(" = ") ; e.w(cmpOp) ; e.w(" ptr ") ; e.w(extReg) ; e.w(", null\n")
			}
			return
		}
		if isPtr {
			cmpOp := "icmp eq"
			if b.Op == OpNeq {
				cmpOp = "icmp ne"
			}
			ptrVal := lv
			if lv == "null" || lv == "zeroinitializer" {
				ptrVal = rv
			}
			e.w("  ") ; e.w(reg) ; e.w(" = ") ; e.w(cmpOp) ; e.w(" ptr ") ; e.w(ptrVal) ; e.w(", null\n")
			return
		}
	}
	if (b.Op == OpEql || b.Op == OpNeq) && b.X.SSAType() != nil {
		if st, ok := SafeUnderlying(b.X.SSAType()).(*TCStruct); ok && len(lt) > 0 && lt[0] == '{' {
			slt := e.llvmStructType(st)
			e.emitStructCompare(reg, b.Op, st, slt, lv, rv)
			return
		}
		if ar, ok := SafeUnderlying(b.X.SSAType()).(*Array); ok && len(lt) > 0 && lt[0] == '[' {
			e.emitArrayCompare(reg, b.Op, ar, lt, lv, rv)
			return
		}
		// A slice of anything but text is still a slice: element-wise, via the
		// runtime. Text is the same shape and has already been handled above.
		if sl, ok := SafeUnderlying(b.X.SSAType()).(*Slice); ok && !textSlice(b.X.SSAType()) {
			if lt != e.sliceType() {
				e.w("  ; unsupported slice compare\n")
				return
			}
			e.emitValueCompare(reg, b.Op, sl, lt, lv, rv, false)
			return
		}
		u2 := SafeUnderlying(b.X.SSAType())
