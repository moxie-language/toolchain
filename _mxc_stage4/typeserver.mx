package main

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"runtime"
	"unsafe"
	. "git.smesh.lol/moxie/pkg/types"
)

type tsPkgEntry struct {
	pkg   *TCPackage
	pkgID int32
}

type tsTypeEntry struct {
	typ    Type
	name   string
	pkgID  int32
}

func serveTypes(reqFd int32, respFd int32) {
	tsArena := runtime.ArenaNew(256 * 1024 * 1024)
	runtime.SetCurrentArena(tsArena)
	initCompileCtx()
	cctx.universe = InitUniverse()
	SetUniverseGlobals(cctx.universe)

	pkgs := map[string]tsPkgEntry{}
	typeByID := map[int32]tsTypeEntry{}
	typeByName := map[string]int32{}
	nextPkgID := int32(1)
	nextTypeID := int32(1)

	for {
		line := fdReadLine(reqFd)
		if line == "" { break }
		seq, op, args := parseMsg(line)
		if op == "" {
			sendLine(respFd, formatERR(seq, "empty request"))
			continue
		}
		var result string
		var errmsg string
		switch op {
		case "REG_PKG":
			if len(args) < 2 {
				errmsg = "REG_PKG needs path and name"
			} else {
				id := nextPkgID
				nextPkgID++
				pkg := NewTCPackage(args[0], args[1])
				pkgs[args[0]] = tsPkgEntry{pkg: pkg, pkgID: id}
				result = tsItoa(id)
			}
		case "REG_TYPE":
			if len(args) < 2 {
				errmsg = "REG_TYPE needs pkgID and name"
			} else {
				id := nextTypeID
				nextTypeID++
				pkgID := tsAtoi(args[0])
				tn := NewTypeName(nil, args[1], nil)
				named := NewNamed(tn, nil)
				typeByID[id] = tsTypeEntry{typ: named, name: args[1], pkgID: pkgID}
				var pkgPath string
				for path, pe := range pkgs {
					if pe.pkgID == pkgID {
						pkgPath = path
						break
					}
				}
				typeByName[pkgPath | "." | args[1]] = id
				result = tsItoa(id)
			}
		case "SET_UNDER":
			if len(args) < 2 {
				errmsg = "SET_UNDER needs typeID and desc"
			} else {
				tid := tsAtoi(args[0])
				if te, ok := typeByID[tid]; ok {
					if n, ok2 := te.typ.(*Named); ok2 {
						n.Under = parseTypeDesc(args[1])
						typeByID[tid] = te
					}
				}
			}
		case "ADD_METHOD":
			if len(args) < 4 {
				errmsg = "ADD_METHOD needs typeID, name, sigDesc, ptrRecv"
			} else {
				tid := tsAtoi(args[0])
				ptrRecv := args[3] == "1"
				if te, ok := typeByID[tid]; ok {
					if n, ok2 := te.typ.(*Named); ok2 {
						sig := parseSignatureDesc(args[2])
						recvType := Type(n)
						if ptrRecv {
							recvType = NewPointer(n)
						}
						sig = NewSignature(NewTCVar(nil, "", recvType), sig.Params, sig.Results, sig.Variadic)
						fn := NewTCFunc(nil, args[1], sig)
						fn.PtrRecv = ptrRecv
						n.AddMethod(fn)
					}
				}
				result = ""
			}
		case "NUM_METHODS":
			if len(args) < 1 {
				errmsg = "NUM_METHODS needs typeID"
			} else {
				tid := tsAtoi(args[0])
				n := int32(0)
				if te, ok := typeByID[tid]; ok {
					if named, ok2 := te.typ.(*Named); ok2 {
						n = named.NumMethods()
					}
				}
				result = tsItoa(n)
			}
		case "HAS_METHODS":
			if len(args) < 1 {
				errmsg = "HAS_METHODS needs typeID"
			} else {
				tid := tsAtoi(args[0])
				has := int32(0)
				if te, ok := typeByID[tid]; ok {
					if named, ok2 := te.typ.(*Named); ok2 {
						if named.NumMethods() > 0 {
							has = 1
						}
					}
				}
				result = tsItoa(has)
			}
		case "GET_DESC":
			if len(args) < 1 {
				errmsg = "GET_DESC needs typeID"
			} else {
				tid := tsAtoi(args[0])
				desc := ""
				if te, ok := typeByID[tid]; ok {
					if named, ok2 := te.typ.(*Named); ok2 && named.Under != nil {
						var b mxhBuf
						typeDescWrite(&b, named.Under)
						desc = string(b.data[:b.off])
					}
				}
				result = desc
			}
		case "GET_METHOD":
			if len(args) < 2 {
				errmsg = "GET_METHOD needs typeID and index"
			} else {
				tid := tsAtoi(args[0])
				idx := tsAtoi(args[1])
				name := ""
				sigDesc := ""
				ptrRecvStr := "0"
				if te, ok := typeByID[tid]; ok {
					if named, ok2 := te.typ.(*Named); ok2 {
						m := named.Method(idx)
						if m != nil {
							name = m.Name
							sig := m.Signature()
							if sig != nil {
								sigDesc = sigDescStr(sig)
							}
							if m.PtrRecv {
								ptrRecvStr = "1"
							}
						}
					}
				}
				result = name | "|" | sigDesc | "|" | ptrRecvStr
			}
		case "LOOKUP":
			if len(args) < 2 {
				errmsg = "LOOKUP needs pkgPath and name"
			} else {
				id, ok := typeByName[args[0] | "." | args[1]]
				if ok {
					result = tsItoa(id)
				} else {
					result = "0"
				}
			}
		default:
			errmsg = "unknown op: " | op
		}
		if errmsg != "" {
			sendLine(respFd, formatERR(seq, errmsg))
		} else {
			sendLine(respFd, formatOK(seq, result))
		}
	}
}

func fdReadLine(fd int32) (s string) {
	if fd < 0 { return "" }
	var buf []byte
	scratch := []byte{0}
	for {
		n := runtime.MoxieRead(fd, unsafe.Pointer(&scratch[0]), 1)
		if n <= 0 {
			break
		}
		if scratch[0] == '\n' {
			break
		}
		if len(buf) >= cap(buf) { buf = mxutil.GrowCap(buf) }
		push(buf, scratch[0])
	}
	return string(buf)
}

func sendLine(fd int32, line string) {
	data := []byte(line)
	if len(data) > 0 {
		runtime.MoxieWrite(fd, unsafe.Pointer(&data[0]), int32(len(data)))
	}
}
