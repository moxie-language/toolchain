package main

import (
	"runtime"
	"unsafe"
)

type TypeClient struct {
	seq    int32
	reqFd  int32
	respFd int32
}

func (c *TypeClient) doReq(op string, args ...string) (result string) {
	if c == nil || c.reqFd <= 0 || c.respFd <= 0 {
		return ""
	}
	c.seq++
	msg := "REQ|" | tsItoa(c.seq) | "|" | op
	for _, a := range args {
		msg = msg | "|" | a
	}
	msg = msg | "\n"
	data := []byte(msg)
	if len(data) > 0 {
		runtime.moxie_write(c.reqFd, unsafe.Pointer(&data[0]), int32(len(data)))
	}
	return parseOK(fdReadLine(c.respFd))
}

func (c *TypeClient) doReqMulti(op string, args ...string) (results []string) {
	if c.reqFd <= 0 || c.respFd <= 0 {
		return nil
	}
	c.seq++
	msg := "REQ|" | tsItoa(c.seq) | "|" | op
	for _, a := range args {
		msg = msg | "|" | a
	}
	msg = msg | "\n"
	data := []byte(msg)
	if len(data) > 0 {
		runtime.moxie_write(c.reqFd, unsafe.Pointer(&data[0]), int32(len(data)))
	}
	return parseOKMulti(fdReadLine(c.respFd))
}

func (c *TypeClient) RegisterPackage(path, name string) (id int32) {
	r := c.doReq("REG_PKG", path, name)
	return tsAtoi(r)
}

func (c *TypeClient) RegisterType(pkgID int32, name string) (typeID int32) {
	r := c.doReq("REG_TYPE", tsItoa(pkgID), name)
	return tsAtoi(r)
}

func (c *TypeClient) SetUnderlying(typeID int32, desc string) {
	c.doReq("SET_UNDER", tsItoa(typeID), desc)
}

func (c *TypeClient) AddMethod(typeID int32, name string, sigDesc string, ptrRecv bool) {
	pr := "0"
	if ptrRecv {
		pr = "1"
	}
	c.doReq("ADD_METHOD", tsItoa(typeID), name, sigDesc, pr)
}

func (c *TypeClient) NumMethods(typeID int32) (n int32) {
	r := c.doReq("NUM_METHODS", tsItoa(typeID))
	return tsAtoi(r)
}

func (c *TypeClient) HasMethods(typeID int32) (ok bool) {
	r := c.doReq("HAS_METHODS", tsItoa(typeID))
	return r != "0"
}

func (c *TypeClient) GetDesc(typeID int32) (desc string) {
	return c.doReq("GET_DESC", tsItoa(typeID))
}

func (c *TypeClient) GetMethod(typeID int32, i int32) (name, sigDesc string, ptrRecv bool) {
	r := c.doReq("GET_METHOD", tsItoa(typeID), tsItoa(i))
	parts := splitMsg(r)
	if len(parts) >= 3 {
		return parts[0], parts[1], parts[2] == "1"
	}
	return "", "", false
}

func (c *TypeClient) Lookup(pkgPath string, name string) (typeID int32) {
	r := c.doReq("LOOKUP", pkgPath, name)
	return tsAtoi(r)
}
