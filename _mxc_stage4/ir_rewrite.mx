package main

import (
	"git.smesh.lol/moxie/pkg/mxutil"
)

// joinChunks concatenates a slice of byte slices in one allocation.
// Uses byte-by-byte copy because s[off:] creates a copy under
// subslice-copies semantics, so copy(s[off:], src) writes to a
// temporary instead of s.
func joinChunks(chunks [][]byte) (r []byte) {
	n := int32(0)
	for _, c := range chunks {
		n += len(c)
	}
	out := []byte{:n}
	off := int32(0)
	for _, c := range chunks {
		for j := int32(0); j < len(c); j++ {
			out[off+j] = c[j]
		}
		off += len(c)
	}
	return out
}

// commaSep interleaves ", " between segments.
func commaSep(segs []string) (r []string) {
	var out []string
	for i, s := range segs {
		if i > 0 {
			out = mxutil.Ensure(out, 1)
			push(out, ", ")
		}
		out = mxutil.Ensure(out, 1)
		push(out, s)
	}
	return out
}

// joinStrs concatenates string segments in one allocation.
// Replaces Schlemiel x = x | y loops.
func joinStrs(segs []string) (r string) {
	n := int32(0)
	for _, s := range segs {
		n += len(s)
	}
	out := []byte{:n}
	off := int32(0)
	for _, s := range segs {
		for j := int32(0); j < len(s); j++ {
			out[off+j] = s[j]
		}
		off += len(s)
	}
	return string(out)
}

// srcTrimStart returns index of first non-whitespace byte in src[from:to].
func srcTrimStart(src []byte, from, to int32) (s int32) {
	s = from
	for s < to && (src[s] == ' ' || src[s] == '\t' || src[s] == '\r') {
		s++
	}
	return s
}

// srcTrimEnd returns index one past last non-whitespace byte in src[from:to].
func srcTrimEnd(src []byte, from, to int32) (e int32) {
	e = to
	for e > from && (src[e-1] == ' ' || src[e-1] == '\t' || src[e-1] == '\r') {
		e--
	}
	return e
}

// srcHasPrefix checks whether src[start:end] begins with prefix.
func srcHasPrefix(src []byte, start, end int32, prefix []byte) (ok bool) {
	plen := int32(len(prefix))
	if end-start < plen {
		return false
	}
	for i := int32(0); i < plen; i++ {
		if src[start+i] != prefix[i] {
			return false
		}
	}
	return true
}

// srcFindByte finds byte c in src[from:to], returns index or -1.
func srcFindByte(src []byte, from, to int32, c byte) (idx int32) {
	for i := from; i < to; i++ {
		if src[i] == c {
			return i
		}
	}
	return -1
}

func scanEmbedPragmas(src []byte, pkgDir string) {
	cctx.embedVars = map[string]*embedInfo{}
	embedPrefix := []byte("//moxie:embed_le ")
	embedPrefix2 := []byte("//:embed ")
	varPrefix := []byte("var ")
	commentPrefix := []byte("//")
	pendingPath := ""
	slen := int32(len(src))
	i := int32(0)
	for i < slen {
		// Find line boundaries without subslicing.
		le := srcFindByte(src, i, slen, '\n')
		if le < 0 {
			le = slen
		}
		ts := srcTrimStart(src, i, le)
		te := srcTrimEnd(src, i, le)
		tlen := te - ts
		if len(pendingPath) > 0 {
			if tlen == 0 || srcHasPrefix(src, ts, te, commentPrefix) {
				if le < slen {
					i = le + 1
				} else {
					i = slen
				}
				continue
			}
			if srcHasPrefix(src, ts, te, varPrefix) {
				rs := ts + 4
				sp := srcFindByte(src, rs, te, ' ')
				if sp > rs {
					varName := string(src[rs:sp])
					vs := srcTrimStart(src, sp+1, te)
					ve := srcTrimEnd(src, vs, te)
					typeStr := string(src[vs:ve])
					cctx.embedVars[varName] = &embedInfo{path: pendingPath, elemType: typeStr}
				}
			}
			pendingPath = ""
		} else if srcHasPrefix(src, ts, te, embedPrefix) {
			ps := srcTrimStart(src, ts+int32(len(embedPrefix)), te)
			pe := srcTrimEnd(src, ps, te)
			if pe > ps {
				pendingPath = string(src[ps:pe])
				if pkgDir != "" {
					pendingPath = mxutil.JoinPath(pkgDir, pendingPath)
				}
			}
		} else if srcHasPrefix(src, ts, te, embedPrefix2) {
			ps := srcTrimStart(src, ts+int32(len(embedPrefix2)), te)
			pe := srcTrimEnd(src, ps, te)
			if pe > ps {
				pendingPath = string(src[ps:pe])
				if pkgDir != "" {
					pendingPath = mxutil.JoinPath(pkgDir, pendingPath)
				}
			}
		}
		if le < slen {
			i = le + 1
		} else {
			i = slen
		}
	}
}

func scanExportPragmas(src []byte) (m map[string]string) {
	result := map[string]string{}
	exportPrefix := []byte("//export ")
	wasmPrefix := []byte("//:wasmexport ")
	funcPrefix := []byte("func ")
	commentPrefix := []byte("//")
	pendingExport := ""
	slen := int32(len(src))
	i := int32(0)
	for i < slen {
		le := srcFindByte(src, i, slen, '\n')
		if le < 0 {
			le = slen
		}
		ts := srcTrimStart(src, i, le)
		te := srcTrimEnd(src, i, le)
		tlen := te - ts
		if len(pendingExport) > 0 {
			if tlen == 0 || srcHasPrefix(src, ts, te, commentPrefix) {
				if le < slen { i = le + 1 } else { i = slen }
				continue
			}
			if srcHasPrefix(src, ts, te, funcPrefix) {
				rs := ts + 5
				paren := srcFindByte(src, rs, te, '(')
				if paren > rs {
					ns := srcTrimStart(src, rs, paren)
					ne := srcTrimEnd(src, ns, paren)
					if ne > ns {
						result[string(src[ns:ne])] = pendingExport
					}
				}
			}
			pendingExport = ""
		} else if srcHasPrefix(src, ts, te, exportPrefix) {
			ps := srcTrimStart(src, ts+9, te)
			pe := srcTrimEnd(src, ps, te)
			if pe > ps {
				pendingExport = string(src[ps:pe])
			}
		} else if srcHasPrefix(src, ts, te, wasmPrefix) {
			// //:wasmexport NAME exports the function under NAME instead of
			// its package-mangled symbol, and it is called from JavaScript
			// with the declared parameters only (no trailing context
			// pointer), exactly like //export.
			ps := srcTrimStart(src, ts+14, te)
			pe := srcTrimEnd(src, ps, te)
			if pe > ps {
				pendingExport = string(src[ps:pe])
			}
		}
		if le < slen { i = le + 1 } else { i = slen }
	}
	return result
}

// scanExternGlobals maps a package-level variable name to the C symbol named
// by the //:extern pragma directly above its declaration:
//
//	//:extern environ
//	var environ *unsafe.Pointer
//
// Such a global must be declared external, never defined: defining it shadows
// the real libc object with a zeroed variable and SIGSEGVs on first read.
func scanExternGlobals(src []byte) (m map[string]string) {
	m = map[string]string{}
	slen := int32(len(src))
	pending := ""
	i := int32(0)
	for i < slen {
		le := srcFindByte(src, i, slen, '\n')
		if le < 0 {
			le = slen
		}
		ts := srcTrimStart(src, i, le)
		te := srcTrimEnd(src, i, le)
		if srcHasPrefix(src, ts, te, []byte("//:extern ")) {
			rs := srcTrimStart(src, ts+10, te)
			re := srcTrimEnd(src, rs, te)
			if re > rs {
				pending = string(src[rs:re])
			}
		} else if te > ts {
			if pending != "" && srcHasPrefix(src, ts, te, []byte("var ")) {
				vs := srcTrimStart(src, ts+4, te)
				ve := vs
				for ve < te {
					c := src[ve]
					if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' {
						ve++
						continue
					}
					break
				}
				if ve > vs {
					m[string(src[vs:ve])] = pending
				}
			}
			pending = ""
		}
		if le < slen {
			i = le + 1
		} else {
			i = slen
		}
	}
	return m
}

// scanLinkdataPragmas collects //:linkdata bindings: a package-level byte
// slice whose data pointer is an external symbol instead of storage this
// package defines.
//
//	//:linkdata <len> <symbol>
//	var name []byte
//
// The symbol is declared extern_weak, so a build with no producer of it links
// and leaves the slice's data pointer null while len and cap keep the declared
// length. The declaration is `[len x i8]` in every package that binds it, so
// the modules merge at llvm-link.
func scanLinkdataPragmas(src []byte) {
	cctx.linkDataVars = map[string]*linkDataInfo{}
	pragmaPrefix := []byte("//:linkdata ")
	varPrefix := []byte("var ")
	slen := int32(len(src))
	i := int32(0)
	pending := ""
	var pendingLen int32
	for i < slen {
		le := srcFindByte(src, i, slen, '\n')
		if le < 0 {
			le = slen
		}
		ts := srcTrimStart(src, i, le)
		te := srcTrimEnd(src, i, le)
		tlen := te - ts
		if len(pending) > 0 {
			// The pragma belongs to the next var declaration; comments and blank
			// lines between them are fine.
			if tlen == 0 || srcHasPrefix(src, ts, te, []byte("//")) {
				if le < slen {
					i = le + 1
				} else {
					i = slen
				}
				continue
			}
			if srcHasPrefix(src, ts, te, varPrefix) {
				rs := ts + int32(len(varPrefix))
				sp := srcFindByte(src, rs, te, ' ')
				if sp > rs {
					varName := string(src[rs:sp])
					info := &linkDataInfo{target: pending, length: pendingLen}
					cctx.linkDataVars[varName] = info
				}
			}
			pending = ""
			pendingLen = 0
		} else if srcHasPrefix(src, ts, te, pragmaPrefix) {
			args := srcTrimStart(src, ts+int32(len(pragmaPrefix)), te)
			ae := srcTrimEnd(src, args, te)
			sp := srcFindByte(src, args, ae, ' ')
			if sp > args {
				lenStr := string(src[args:sp])
				symStart := srcTrimStart(src, sp+1, ae)
				symEnd := srcTrimEnd(src, symStart, ae)
				if symEnd > symStart {
					pending = string(src[symStart:symEnd])
					pendingLen = parseInt32(lenStr)
				}
			}
		}
		if le < slen {
			i = le + 1
		} else {
			i = slen
		}
	}
}

func scanLinknameMap(src []byte) (m map[string]string) {
	result := map[string]string{}
	prefix := []byte("//:linkname ")
	slen := int32(len(src))
	i := int32(0)
	for i < slen {
		le := srcFindByte(src, i, slen, '\n')
		if le < 0 {
			le = slen
		}
		ts := srcTrimStart(src, i, le)
		te := srcTrimEnd(src, i, le)
		if srcHasPrefix(src, ts, te, prefix) {
			rs := srcTrimStart(src, ts+12, te)
			re := srcTrimEnd(src, rs, te)
			if re > rs {
				// Find space between localName and targetName.
				sp := srcFindByte(src, rs, re, ' ')
				if sp < 0 {
					sp = srcFindByte(src, rs, re, '\t')
				}
				if sp > rs {
					localName := string(src[rs:sp])
					ts2 := srcTrimStart(src, sp+1, re)
					if ts2 < re {
						targetName := string(src[ts2:re])
						result[localName] = targetName
					}
				}
			}
		}
		if le < slen { i = le + 1 } else { i = slen }
	}
	return result
}


// wasmImportMap maps IR symbol (e.g. "time.timezoneOffsetMinutes") -> [module, import_name].
// Populated from //:wasmimport pragmas.

// scanWasmImportMap scans source for //:wasmimport <module> <name> pragmas.
// The pragma applies to the next function declaration (body-less).
// pkgPath is the package import path used to construct full IR symbols.
func scanWasmImportMap(src []byte, pkgPath string) (m map[string][]string) {
	if !mxutil.HasPrefix(cctx.compileTargetTriple, "wasm32") {
		return nil
	}
	result := map[string][]string{}
	wasmPrefix := []byte("//:wasmimport ")
	funcPrefix := []byte("func ")
	slen := int32(len(src))
	i := int32(0)
	for i < slen {
		le := srcFindByte(src, i, slen, '\n')
		if le < 0 {
			le = slen
		}
		ts := srcTrimStart(src, i, le)
		te := srcTrimEnd(src, i, le)
		if !srcHasPrefix(src, ts, te, wasmPrefix) {
			if le < slen { i = le + 1 } else { i = slen }
			continue
		}
		// Parse module and import name from pragma line.
		rs := ts + int32(len(wasmPrefix))
		sp := srcFindByte(src, rs, te, ' ')
		if sp < 0 {
			sp = srcFindByte(src, rs, te, '\t')
		}
		if sp < 0 {
			if le < slen { i = le + 1 } else { i = slen }
			continue
		}
		mod := string(src[rs:sp])
		ns := srcTrimStart(src, sp+1, te)
		ne := srcTrimEnd(src, ns, te)
		impName := string(src[ns:ne])
		// Find next func declaration.
		j := le
		if j < slen { j++ }
		for j < slen {
			fle := srcFindByte(src, j, slen, '\n')
			if fle < 0 {
				fle = slen
			}
			fts := srcTrimStart(src, j, fle)
			fte := srcTrimEnd(src, j, fle)
			if !srcHasPrefix(src, fts, fte, funcPrefix) {
				if fle < slen { j = fle + 1 } else { j = slen }
				continue
			}
			// Extract function name from "func NAME(" or "func (recv) NAME("
			rs2 := fts + 5
			if rs2 < fte && src[rs2] == '(' {
				depth := int32(1)
				k := rs2 + 1
				for k < fte && depth > 0 {
					if src[k] == '(' { depth++ }
					if src[k] == ')' { depth-- }
					k++
				}
				rs2 = srcTrimStart(src, k, fte)
			}
			paren := srcFindByte(src, rs2, fte, '(')
			if paren < 0 {
				break
			}
			fns := srcTrimStart(src, rs2, paren)
			fne := srcTrimEnd(src, fns, paren)
			if fne > fns {
				funcName := string(src[fns:fne])
				sym := pkgPath | "." | funcName
				result[sym] = []string{mod, impName}
			}
			break
		}
		if le < slen { i = le + 1 } else { i = slen }
	}
	if len(result) == 0 {
		return nil
	}
	return result
}


func stripDuplicatePackageClauses2(src []byte) (buf []byte) {
	// Fast path: count package clauses. If only one, return src unchanged.
	count := int32(0)
	for i := int32(0); i < len(src); i++ {
		if i == 0 || src[i-1] == '\n' {
			j := i
			for j < len(src) && (src[j] == ' ' || src[j] == '\t') {
				j++
			}
			if len(src)-j >= 8 && src[j] == 'p' && src[j+1] == 'a' && src[j+2] == 'c' && src[j+3] == 'k' && src[j+4] == 'a' && src[j+5] == 'g' && src[j+6] == 'e' && src[j+7] == ' ' {
				count++
			}
		}
	}
	if count <= 1 {
		return src
	}
	// Multiple package clauses: copy src, blank out duplicates in-place.
	out := []byte{:len(src)}
	copy(out, src)
	found := false
	for i := int32(0); i < len(out); i++ {
		if i == 0 || out[i-1] == '\n' {
			ls := i
			for ls < len(out) && (out[ls] == ' ' || out[ls] == '\t') {
				ls++
			}
			if len(out)-ls >= 8 && out[ls] == 'p' && out[ls+1] == 'a' && out[ls+2] == 'c' && out[ls+3] == 'k' && out[ls+4] == 'a' && out[ls+5] == 'g' && out[ls+6] == 'e' && out[ls+7] == ' ' {
				if found {
					// Blank out this line.
					for k := i; k < len(out) && out[k] != '\n'; k++ {
						out[k] = ' '
					}
				}
				found = true
			}
		}
	}
	return out
}

func rewriteSliceMakeLiterals(src []byte) (buf []byte) {
	chunks := [][]byte{:0:len(src)/2 + 8}
	i := 0
	for i < len(src) {
		start := lIndex(src[i:], []byte("{:"))
		if start < 0 {
			chunks = mxutil.Ensure(chunks, 1)
			push(chunks, src[i:])
			break
		}
		start = start + i
		lbrack := findSliceTypeStart(src, start)
		if lbrack < 0 {
			chunks = mxutil.Ensure(chunks, 1)
			push(chunks, src[i:start+2])
			i = start + 2
			continue
		}
		closeIdx := findMatchingBrace(src, start)
		if closeIdx < 0 {
			chunks = mxutil.Ensure(chunks, 1)
			push(chunks, src[i:start+2])
			i = start + 2
			continue
		}
		inner := src[start+2 : closeIdx]
		colonIdx := lIndexByte(inner, ':')
		typeText := src[lbrack:start]
		chunks = mxutil.Ensure(chunks, 1)
		push(chunks, src[i:lbrack])
		if colonIdx < 0 {
			chunks = mxutil.Ensure(chunks, 1)
			push(chunks, []byte("__slicealloc("))
			chunks = mxutil.Ensure(chunks, 1)
			push(chunks, typeText)
			chunks = mxutil.Ensure(chunks, 1)
			push(chunks, []byte(", "))
			chunks = mxutil.Ensure(chunks, 1)
			push(chunks, lTrimSpace(inner))
			chunks = mxutil.Ensure(chunks, 1)
			push(chunks, []byte(")"))
		} else {
			lenExpr := lTrimSpace(inner[:colonIdx])
			capExpr := lTrimSpace(inner[colonIdx+1:])
			chunks = mxutil.Ensure(chunks, 1)
			push(chunks, []byte("__slicealloc("))
			chunks = mxutil.Ensure(chunks, 1)
			push(chunks, typeText)
			chunks = mxutil.Ensure(chunks, 1)
			push(chunks, []byte(", "))
			chunks = mxutil.Ensure(chunks, 1)
			push(chunks, lenExpr)
			chunks = mxutil.Ensure(chunks, 1)
			push(chunks, []byte(", "))
			chunks = mxutil.Ensure(chunks, 1)
			push(chunks, capExpr)
			chunks = mxutil.Ensure(chunks, 1)
			push(chunks, []byte(")"))
		}
		i = closeIdx + 1
	}
	if len(chunks) == 0 {
		return src
	}
	return joinChunks(chunks)
}

func isIdentByteAt(src []byte, k int32) (r bool) {
	if k < 0 {
		return false
	}
	ch := src[k]
	return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_' || ch == '.'
}

// followsConstruct reports whether the identifier at start is the result type
// of a construct whose text continues leftward, in which case a space before it
// is inside the type rather than a boundary: `func() int32` and `map[K]V` end in
// `)` / `]`, while `chan int32` and friends end in a bare type keyword.
func followsConstruct(src []byte, start int32) (r bool) {
	k := start - 1
	for k >= 0 && (src[k] == ' ' || src[k] == '\t') {
		k--
	}
	if k < 0 {
		return false
	}
	if src[k] == ')' || src[k] == ']' {
		return true
	}
	for _, kw := range []string{"chan", "map", "func", "struct", "interface"} {
		if wordEndsAt(src, k+1, kw) {
			return true
		}
	}
	return false
}

// wordEndsAt reports whether word occupies src[end-len(word):end] as a whole
// word (not as the tail of a longer identifier).
func wordEndsAt(src []byte, end int32, word string) (r bool) {
	n := int32(len(word))
	if end < n {
		return false
	}
	for i := int32(0); i < n; i++ {
		if src[end-n+i] != word[i] {
			return false
		}
	}
	return !isIdentByteAt(src, end-n-1)
}

func findSliceTypeStart(src []byte, braceIdx int32) (n int32) {
	j := braceIdx - 1
	for j >= 0 && (src[j] == ' ' || src[j] == '\t' || src[j] == '\n') {
		j--
	}
	if j < 0 {
		return -1
	}
	depth := 0
	parenDepth := 0
	// braceDepth tracks the TYPE's own braces: `[]struct{ n int32 }{:2}` must
	// scan back over `struct{ n int32 }` as one unit. Without it the `}` of the
	// struct was treated as a boundary and the type text came out as
	// `int32 }`, which the parser then rejected with "unexpected :". inTag
	// skips a backquoted struct tag, whose contents may hold braces or colons.
	braceDepth := 0
	inTag := false
	candidate := -1
	identStart := -1
	for j >= 0 {
		ch := src[j]
		if ch == '`' {
			inTag = !inTag
			j--
			continue
		}
		if inTag {
			j--
			continue
		}
		if ch == '}' {
			braceDepth++
			j--
			continue
		}
		if ch == '{' {
			if braceDepth > 0 {
				braceDepth--
			}
			j--
			continue
		}
		if braceDepth > 0 {
			j--
			continue
		}
		if ch == ')' {
			parenDepth++
		} else if ch == '(' {
			if parenDepth > 0 {
				parenDepth--
			} else {
				if candidate >= 0 {
					return candidate
				}
				if identStart >= 0 {
					return identStart
				}
				return -1
			}
		} else if parenDepth > 0 {
			j--
			continue
		}
		if ch == ']' {
			depth++
		} else if ch == '[' {
			depth--
			if depth == 0 && !isIdentByteAt(src, j-1) {
				// A balanced pair starts the type only when nothing names it:
				// the `[` of `map[K]V` or of a generic `List[T]` is preceded by
				// an identifier and must not be mistaken for the slice's `[`.
				candidate = j
			}
		} else if depth == 0 && parenDepth == 0 {
			if candidate >= 0 {
				return candidate
			}
			if ch == ' ' || ch == '\t' || ch == '\n' {
				// A space after a type name ends the type: `return nat{:1}`
				// must not scan back into the `return` keyword. Spaces
				// before any type char (e.g. `[]byte {`) are skipped.
				if identStart >= 0 && !followsConstruct(src, identStart) {
					return identStart
				}
				j--
				continue
			}
			if ch == '*' || ch == '(' || ch == ')' {
				j--
				continue
			}
			if (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_' || ch == '.' {
				// A bare type name (buffer{:0:64}) has no brackets to mark
				// its start; record the leftmost identifier byte and return
				// it when a real boundary follows.
				identStart = j
				j--
				continue
			}
			if identStart >= 0 {
				return identStart
			}
			return -1
		}
		j--
	}
	if candidate >= 0 {
		return candidate
	}
	if identStart >= 0 {
		return identStart
	}
	return -1
}

func findMatchingBrace(src []byte, openIdx int32) (n int32) {
	depth := 1
	for i := openIdx + 1; i < len(src); i++ {
		if src[i] == '{' {
			depth++
		} else if src[i] == '}' {
			depth--
			if depth == 0 {
				return i
			}
		}
	}
	return -1
}

func rewriteChanMakeLiterals(src []byte) (buf []byte) {
	chanKw := []byte("chan ")
	var chunks [][]byte
	started := false
	i := 0
	for i < len(src) {
		idx := lIndex(src[i:], chanKw)
		if idx < 0 {
			if started {
				chunks = mxutil.Ensure(chunks, 1)
				push(chunks, src[i:])
			}
			break
		}
		idx = idx + i
		j := idx + 5
		for j < len(src) && (src[j] == ' ' || src[j] == '\t') {
			j++
		}
		if j >= len(src) {
			if started {
				chunks = mxutil.Ensure(chunks, 1)
				push(chunks, src[i:])
			}
			break
		}
		if src[j] == '<' && j+1 < len(src) && src[j+1] == '-' {
			if started {
				chunks = mxutil.Ensure(chunks, 1)
				push(chunks, src[i:j+2])
			}
			i = j + 2
			continue
		}
		for j < len(src) && (src[j] != '{' && src[j] != '\n' && src[j] != ';' && src[j] != '(' && src[j] != ')') {
			if src[j] == ' ' || src[j] == '\t' {
				break
			}
			j++
		}
		if j >= len(src) || src[j] != '{' {
			if !started {
				i = idx + 4
			} else {
				chunks = mxutil.Ensure(chunks, 1)
				push(chunks, src[i:idx+4])
				i = idx + 4
			}
			continue
		}
		braceOpen := j
		endsStruct := braceOpen >= 6 && string(src[braceOpen-6:braceOpen]) == "struct"
		endsIface := braceOpen >= 9 && string(src[braceOpen-9:braceOpen]) == "interface"
		if endsStruct || endsIface {
			typeClose := findMatchingBrace(src, braceOpen)
			if typeClose < 0 {
				if !started {
					i = idx + 4
				} else {
					chunks = mxutil.Ensure(chunks, 1)
					push(chunks, src[i:idx+4])
					i = idx + 4
				}
				continue
			}
			k := typeClose + 1
			if k >= len(src) || src[k] != '{' {
				if !started {
					i = typeClose + 1
				} else {
					chunks = mxutil.Ensure(chunks, 1)
					push(chunks, src[i:typeClose+1])
					i = typeClose + 1
				}
				continue
			}
			braceOpen = k
		}
		closeIdx := findMatchingBrace(src, braceOpen)
		if closeIdx < 0 {
			if !started {
				i = idx + 4
			} else {
				chunks = mxutil.Ensure(chunks, 1)
				push(chunks, src[i:idx+4])
				i = idx + 4
			}
			continue
		}
		inner := lTrimSpace(src[braceOpen+1 : closeIdx])
		// chan T{:n} is the capacity-only form (a channel has no length
		// separate from its capacity): the allocator takes the number.
		if len(inner) > 0 && inner[0] == ':' {
			inner = lTrimSpace(inner[1:])
		}
		chanType := src[idx : braceOpen]
		for len(chanType) > 0 && (chanType[len(chanType)-1] == ' ' || chanType[len(chanType)-1] == '\t') {
			chanType = resize(chanType, len(chanType)-1)
		}
		if !started {
			chunks = mxutil.Ensure(chunks, 1)
			push(chunks, src[:idx])
			started = true
		} else {
			chunks = mxutil.Ensure(chunks, 1)
			push(chunks, src[i:idx])
		}
		// Unspecified capacity is ONE slot. A Moxie domain has one thread, so an
		// unbuffered channel would have no possible listener; one slot is the
		// mailbox the event-loop model needs - the first send never blocks, and
		// the second waits until the receiver has taken the first.
		if len(inner) == 0 {
			inner = []byte("1")
		}
		chunks = mxutil.Ensure(chunks, 1)
		push(chunks, []byte("__slicealloc("))
		chunks = mxutil.Ensure(chunks, 1)
		push(chunks, chanType)
		chunks = mxutil.Ensure(chunks, 1)
		push(chunks, []byte(", "))
		chunks = mxutil.Ensure(chunks, 1)
		push(chunks, inner)
		chunks = mxutil.Ensure(chunks, 1)
		push(chunks, []byte(")"))
		i = closeIdx + 1
	}
	if !started {
		return src
	}
	return joinChunks(chunks)
}
