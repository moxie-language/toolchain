package main

import (
	"git.smesh.lol/moxie/pkg/mxutil"
)

// joinChunks concatenates a slice of byte slices in one allocation.
func joinChunks(chunks [][]byte) (r []byte) {
	n := int32(0)
	for _, c := range chunks {
		n += len(c)
	}
	out := []byte{:0:n}
	for _, c := range chunks {
		off := len(out)
		out = out[:off+len(c)]
		copy(out[off:], c)
	}
	return out
}

func scanEmbedPragmas(src []byte, pkgDir string) {
	cctx.embedVars = map[string]*embedInfo{}
	// Two accepted forms: //:embed (canonical, see src/embed) and
	// //moxie:embed_le (explicit little-endian element interpretation).
	embedPrefix := []byte("//moxie:embed_le ")
	embedPrefix2 := []byte("//:embed ")
	varPrefix := []byte("var ")
	commentPrefix := []byte("//")
	pendingPath := ""
	i := 0
	for i < len(src) {
		nlIdx := lIndexByte(src[i:], '\n')
		var line []byte
		var lineEnd int32
		if nlIdx < 0 {
			line = src[i:]
			lineEnd = len(src)
		} else {
			line = src[i : i+nlIdx]
			lineEnd = i + nlIdx + 1
		}
		trimmed := lTrimSpace(line)
		if len(pendingPath) > 0 {
			if len(trimmed) == 0 || lHasPrefix(trimmed, commentPrefix) {
				i = lineEnd
				continue
			}
			if lHasPrefix(trimmed, varPrefix) {
				rest := trimmed[4:]
				spIdx := lIndexByte(rest, ' ')
				if spIdx > 0 {
					varName := string(rest[:spIdx])
					typeStr := string(lTrimSpace(rest[spIdx+1:]))
					cctx.embedVars[varName] = &embedInfo{path: pendingPath, elemType: typeStr}
				}
			}
			pendingPath = ""
		} else if lHasPrefix(trimmed, embedPrefix) {
			pendingPath = string(lTrimSpace(trimmed[len(embedPrefix):]))
			if len(pendingPath) > 0 && pkgDir != "" {
				pendingPath = mxutil.JoinPath(pkgDir, pendingPath)
			}
		} else if lHasPrefix(trimmed, embedPrefix2) {
			pendingPath = string(lTrimSpace(trimmed[len(embedPrefix2):]))
			if len(pendingPath) > 0 && pkgDir != "" {
				pendingPath = mxutil.JoinPath(pkgDir, pendingPath)
			}
		}
		i = lineEnd
	}
}

func scanExportPragmas(src []byte) (m map[string]string) {
	result := map[string]string{}
	exportPrefix := []byte("//export ")
	funcPrefix := []byte("func ")
	commentPrefix := []byte("//")
	pendingExport := ""
	i := 0
	for i < len(src) {
		nlIdx := lIndexByte(src[i:], '\n')
		var line []byte
		var lineEnd int32
		if nlIdx < 0 {
			line = src[i:]
			lineEnd = len(src)
		} else {
			line = src[i : i+nlIdx]
			lineEnd = i + nlIdx + 1
		}
		trimmed := lTrimSpace(line)
		if len(pendingExport) > 0 {
			if len(trimmed) == 0 || lHasPrefix(trimmed, commentPrefix) {
				i = lineEnd
				continue
			}
			if lHasPrefix(trimmed, funcPrefix) {
				rest := trimmed[5:]
				paren := lIndexByte(rest, '(')
				if paren > 0 {
					funcName := string(lTrimSpace(rest[:paren]))
					result[funcName] = pendingExport
				}
			}
			pendingExport = ""
		} else if lHasPrefix(trimmed, exportPrefix) {
			pendingExport = string(lTrimSpace(trimmed[9:]))
		}
		i = lineEnd
	}
	return result
}

func scanLinknameMap(src []byte) (m map[string]string) {
	result := map[string]string{}
	prefix := []byte("//:linkname ")
	i := 0
	for i < len(src) {
		nlIdx := lIndexByte(src[i:], '\n')
		var line []byte
		var lineEnd int32
		if nlIdx < 0 {
			line = src[i:]
			lineEnd = len(src)
		} else {
			line = src[i : i+nlIdx]
			lineEnd = i + nlIdx + 1
		}
		trimmed := lTrimSpace(line)
		if lHasPrefix(trimmed, prefix) {
			rest := string(lTrimSpace(trimmed[12:]))
			sp := 0
			for sp < len(rest) && rest[sp] != ' ' && rest[sp] != '\t' {
				sp++
			}
			if sp < len(rest) {
				localName := rest[:sp]
				targetName := ""
				for j := sp + 1; j < len(rest); j++ {
					if rest[j] != ' ' && rest[j] != '\t' {
						targetName = rest[j:]
						break
					}
				}
				if targetName != "" {
					result[localName] = targetName
				}
			}
		}
		i = lineEnd
	}
	return result
}


// wasmImportMap maps IR symbol (e.g. "time.timezoneOffsetMinutes") -> [module, import_name].
// Populated from //:wasmimport pragmas.

// scanWasmImportMap scans source for //:wasmimport <module> <name> pragmas.
// The pragma applies to the next function declaration (body-less).
// pkgPath is the package import path used to construct full IR symbols.
func scanWasmImportMap(src []byte, pkgPath string) (m map[string][2]string) {
	if !mxutil.HasPrefix(cctx.compileTargetTriple, "wasm32") {
		return nil
	}
	m := map[string][2]string{}
	lines := mxutil.SplitLines(string(src))
	for i := int32(0); i < int32(len(lines)); i++ {
		ln := mxutil.TrimSpace(lines[i])
		if !mxutil.HasPrefix(ln, "//:wasmimport ") {
			continue
		}
		parts := ln[len("//:wasmimport "):]
		sp := int32(-1)
		for j := int32(0); j < int32(len(parts)); j++ {
			if parts[j] == ' ' || parts[j] == '\t' {
				sp = j
				break
			}
		}
		if sp < 0 {
			continue
		}
		mod := mxutil.TrimSpace(string(parts[:sp]))
		impName := mxutil.TrimSpace(string(parts[sp+1:]))
		// Find next func declaration
		for j := i + 1; j < int32(len(lines)); j++ {
			fl := mxutil.TrimSpace(lines[j])
			if !mxutil.HasPrefix(fl, "func ") {
				continue
			}
			// extract function name from "func NAME(" or "func (recv) NAME("
			rest := fl[5:]
			// skip receiver if present
			if len(rest) > 0 && rest[0] == '(' {
				depth := int32(1)
				k := int32(1)
				for k < int32(len(rest)) && depth > 0 {
					if rest[k] == '(' { depth++ }
					if rest[k] == ')' { depth-- }
					k++
				}
				rest = mxutil.TrimSpace(string(rest[k:]))
			}
			// now rest starts with funcName(
			paren := int32(-1)
			for k := int32(0); k < int32(len(rest)); k++ {
				if rest[k] == '(' {
					paren = k
					break
				}
			}
			if paren < 0 {
				break
			}
			funcName := mxutil.TrimSpace(string(rest[:paren]))
			sym := pkgPath | "." | funcName
			m[sym] = [2]string{mod, impName}
			break
		}
	}
	if len(m) == 0 {
		return nil
	}
	return m
}

func stripDuplicatePackageClauses(src []byte) (buf []byte) {
	found := false
	var out []byte
	i := 0
	for i < len(src) {
		nlIdx := lIndexByte(src[i:], '\n')
		var line []byte
		var lineEnd int32
		if nlIdx < 0 {
			line = src[i:]
			lineEnd = len(src)
		} else {
			line = src[i : i+nlIdx]
			lineEnd = i + nlIdx + 1
		}
		trimmed := lTrimSpace(line)
		if lHasPrefix(trimmed, "package ") {
			if found {
				if out == nil {
					out = []byte{:len(src)}
					copy(out, src)
				}
				for k := i; k < i+len(line); k++ {
					out[k] = ' '
				}
				i = lineEnd
				continue
			}
			found = true
		}
		i = lineEnd
	}
	if out == nil {
		return src
	}
	return out
}

func stripDuplicatePackageClauses2(src []byte) (buf []byte) {
	// Fast path: count package clauses. If only one, return src unchanged.
	count := int32(0)
	for i := int32(0); i < len(src); i++ {
		if i == 0 || src[i-1] == '\n' {
			j := i
			for j < len(src) && (src[j] == ' ' || src[j] == '\t') {
				j++
			}
			if len(src)-j >= 8 && src[j] == 'p' && src[j+1] == 'a' && src[j+2] == 'c' && src[j+3] == 'k' && src[j+4] == 'a' && src[j+5] == 'g' && src[j+6] == 'e' && src[j+7] == ' ' {
				count++
			}
		}
	}
	if count <= 1 {
		return src
	}
	// Multiple package clauses: copy src, blank out duplicates in-place.
	out := []byte{:len(src)}
	copy(out, src)
	found := false
	for i := int32(0); i < len(out); i++ {
		if i == 0 || out[i-1] == '\n' {
			ls := i
			for ls < len(out) && (out[ls] == ' ' || out[ls] == '\t') {
				ls++
			}
			if len(out)-ls >= 8 && out[ls] == 'p' && out[ls+1] == 'a' && out[ls+2] == 'c' && out[ls+3] == 'k' && out[ls+4] == 'a' && out[ls+5] == 'g' && out[ls+6] == 'e' && out[ls+7] == ' ' {
				if found {
					// Blank out this line.
					for k := i; k < len(out) && out[k] != '\n'; k++ {
						out[k] = ' '
					}
				}
				found = true
			}
		}
	}
	return out
}

func rewriteSliceMakeLiterals(src []byte) (buf []byte) {
	var chunks [][]byte
	i := 0
	for i < len(src) {
		start := lIndex(src[i:], []byte("{:"))
		if start < 0 {
			chunks = append(chunks, src[i:])
			break
		}
		start = start + i
		lbrack := findSliceTypeStart(src, start)
		if lbrack < 0 {
			chunks = append(chunks, src[i:start+2])
			i = start + 2
			continue
		}
		closeIdx := findMatchingBrace(src, start)
		if closeIdx < 0 {
			chunks = append(chunks, src[i:start+2])
			i = start + 2
			continue
		}
		inner := src[start+2 : closeIdx]
		colonIdx := lIndexByte(inner, ':')
		typeText := src[lbrack:start]
		chunks = append(chunks, src[i:lbrack])
		if colonIdx < 0 {
			chunks = append(chunks, []byte("__slicealloc("))
			chunks = append(chunks, typeText)
			chunks = append(chunks, []byte(", "))
			chunks = append(chunks, lTrimSpace(inner))
			chunks = append(chunks, []byte(")"))
		} else {
			lenExpr := lTrimSpace(inner[:colonIdx])
			capExpr := lTrimSpace(inner[colonIdx+1:])
			chunks = append(chunks, []byte("__slicealloc("))
			chunks = append(chunks, typeText)
			chunks = append(chunks, []byte(", "))
			chunks = append(chunks, lenExpr)
			chunks = append(chunks, []byte(", "))
			chunks = append(chunks, capExpr)
			chunks = append(chunks, []byte(")"))
		}
		i = closeIdx + 1
	}
	if len(chunks) == 0 {
		return src
	}
	return joinChunks(chunks)
}

func findSliceTypeStart(src []byte, braceIdx int32) (n int32) {
	j := braceIdx - 1
	for j >= 0 && (src[j] == ' ' || src[j] == '\t' || src[j] == '\n') {
		j--
	}
	if j < 0 {
		return -1
	}
	depth := 0
	parenDepth := 0
	candidate := -1
	for j >= 0 {
		ch := src[j]
		if ch == ')' {
			parenDepth++
		} else if ch == '(' {
			if parenDepth > 0 {
				parenDepth--
			} else {
				if candidate >= 0 {
					return candidate
				}
				return -1
			}
		} else if parenDepth > 0 {
			j--
			continue
		}
		if ch == ']' {
			depth++
		} else if ch == '[' {
			depth--
			if depth == 0 {
				candidate = j
			}
		} else if depth == 0 && parenDepth == 0 {
			if candidate >= 0 {
				return candidate
			}
			if ch == ' ' || ch == '\t' || ch == '\n' || ch == '*' || ch == '(' || ch == ')' {
				j--
				continue
			}
			if (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_' || ch == '.' {
				j--
				continue
			}
			return -1
		}
		j--
	}
	if candidate >= 0 {
		return candidate
	}
	return -1
}

func findMatchingBrace(src []byte, openIdx int32) (n int32) {
	depth := 1
	for i := openIdx + 1; i < len(src); i++ {
		if src[i] == '{' {
			depth++
		} else if src[i] == '}' {
			depth--
			if depth == 0 {
				return i
			}
		}
	}
	return -1
}

func rewriteChanMakeLiterals(src []byte) (buf []byte) {
	chanKw := []byte("chan ")
	var chunks [][]byte
	started := false
	i := 0
	for i < len(src) {
		idx := lIndex(src[i:], chanKw)
		if idx < 0 {
			if started {
				chunks = append(chunks, src[i:])
			}
			break
		}
		idx = idx + i
		j := idx + 5
		for j < len(src) && (src[j] == ' ' || src[j] == '\t') {
			j++
		}
		if j >= len(src) {
			if started {
				chunks = append(chunks, src[i:])
			}
			break
		}
		if src[j] == '<' && j+1 < len(src) && src[j+1] == '-' {
			if started {
				chunks = append(chunks, src[i:j+2])
			}
			i = j + 2
			continue
		}
		for j < len(src) && (src[j] != '{' && src[j] != '\n' && src[j] != ';' && src[j] != '(' && src[j] != ')') {
			if src[j] == ' ' || src[j] == '\t' {
				break
			}
			j++
		}
		if j >= len(src) || src[j] != '{' {
			if !started {
				i = idx + 4
			} else {
				chunks = append(chunks, src[i:idx+4])
				i = idx + 4
			}
			continue
		}
		braceOpen := j
		endsStruct := braceOpen >= 6 && string(src[braceOpen-6:braceOpen]) == "struct"
		endsIface := braceOpen >= 9 && string(src[braceOpen-9:braceOpen]) == "interface"
		if endsStruct || endsIface {
			typeClose := findMatchingBrace(src, braceOpen)
			if typeClose < 0 {
				if !started {
					i = idx + 4
				} else {
					chunks = append(chunks, src[i:idx+4])
					i = idx + 4
				}
				continue
			}
			k := typeClose + 1
			if k >= len(src) || src[k] != '{' {
				if !started {
					i = typeClose + 1
				} else {
					chunks = append(chunks, src[i:typeClose+1])
					i = typeClose + 1
				}
				continue
			}
			braceOpen = k
		}
		closeIdx := findMatchingBrace(src, braceOpen)
		if closeIdx < 0 {
			if !started {
				i = idx + 4
			} else {
				chunks = append(chunks, src[i:idx+4])
				i = idx + 4
			}
			continue
		}
		inner := lTrimSpace(src[braceOpen+1 : closeIdx])
		chanType := src[idx : braceOpen]
		for len(chanType) > 0 && (chanType[len(chanType)-1] == ' ' || chanType[len(chanType)-1] == '\t') {
			chanType = chanType[:len(chanType)-1]
		}
		if !started {
			chunks = append(chunks, src[:idx])
			started = true
		} else {
			chunks = append(chunks, src[i:idx])
		}
		if len(inner) == 0 {
			chunks = append(chunks, []byte("__slicealloc("))
			chunks = append(chunks, chanType)
			chunks = append(chunks, []byte(")"))
		} else {
			chunks = append(chunks, []byte("__slicealloc("))
			chunks = append(chunks, chanType)
			chunks = append(chunks, []byte(", "))
			chunks = append(chunks, inner)
			chunks = append(chunks, []byte(")"))
		}
		i = closeIdx + 1
	}
	if !started {
		return src
	}
	return joinChunks(chunks)
}
