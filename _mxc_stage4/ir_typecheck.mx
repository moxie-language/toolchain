package main

import (
	"os"
	"runtime"
	"git.smesh.lol/moxie/pkg/syntax"
	"git.smesh.lol/moxie/pkg/mxutil"
	"git.smesh.lol/moxie/pkg/token"
	. "git.smesh.lol/moxie/pkg/types"
)

func silentErrh(err error) {}

func collectParseError(err error) {
	cctx.parseErrors = mxutil.Ensure(cctx.parseErrors, 1)
	push(cctx.parseErrors, err.Error())
}

// parseErrorReport renders the collected parse errors, so a failed parse names
// the syntax error instead of leaving the reader with the unrelated symptoms of
// a partial tree.
func parseErrorReport() (s string) {
	var errSegs []string
	errSegs = mxutil.Ensure(errSegs, 1)
	push(errSegs, "; parse error parseErrs=")
	errSegs = mxutil.Ensure(errSegs, 1)
	push(errSegs, simpleItoa(len(cctx.parseErrors)))
	errSegs = mxutil.Ensure(errSegs, 1)
	push(errSegs, "\n")
	for _, pe := range cctx.parseErrors {
		errSegs = mxutil.Ensure(errSegs, 1)
		push(errSegs, "; ")
		errSegs = mxutil.Ensure(errSegs, 1)
		push(errSegs, pe)
		errSegs = mxutil.Ensure(errSegs, 1)
		push(errSegs, "\n")
	}
	return joinStrs(errSegs)
}

type embedInfo struct {
	path     string
	elemType string
}

// compileCtx holds all per-package compilation state and cross-package
// generic declaration state. Allocated once at init and never reassigned;
// fields are mutated through the pointer.
type compileCtx struct {
	parseErrors          []string
	compileErrors        []string
	constValMap          map[string]int64
	embedVars            map[string]*embedInfo
	linknameMap          map[string]string
	externGlobals        map[string]string // local var name -> C symbol from //:extern
	wasmImportMap        map[string][]string
	tcPkgSrc             []byte
	compilePkgDir        string
	compileTargetTriple  string
	concatSourceMap      []srcSpan
	genericPkgLocalDecls map[string]*syntax.FuncDecl
	mxhGenerics          map[string]map[string]bool // pkgPath -> generic decl names (from mxh)
	pkgGenerics          []string                   // generic decl names collected for the current package
	genericPkgScopes     map[string]*Scope
	// sigDeclPkgImports: the import list of the package whose generic signature
	// is being resolved. A qualified type in that signature must resolve through
	// THESE imports. The package being compiled is not in Universe.Registry (only
	// its dependencies are), so Registry[pkgPath] is nil for it - that is why the
	// first attempt at this was inert. crypto/ecdsa imports
	// crypto/internal/fips140/ecdsa, also named `ecdsa`, and the global
	// LookupByName map then decided between them by map iteration order.
	sigDeclPkgImports    []*TCPackage
	typeDescPkgPath      string
	parseTypePkgScope    *Scope
	genericFuncDecls     map[string]*syntax.FuncDecl
	genericMethodDecls   map[string]*syntax.FuncDecl
	irResults            []string
	compileExportMap     map[string]string
	compileArena         *runtime.Arena
	parseArena           *runtime.Arena
	genericArena         *runtime.Arena
	scannedGeneric       map[string]bool
	// mxhLoaded records packages whose graph was already materialized from mxh
	// in this process. loadMxhData allocates on the root arena, which is never
	// released, so loading the same package twice keeps two copies of its whole
	// graph for the life of the build - which the serial path did for every
	// package (whole-link pre-pass, then again per package).
	mxhLoaded            map[string]bool
	// dispMethodsByPkg is the mxh-derived dispatch index: package key -> the
	// non-generic method names its mxh declares. findIfaceImpls uses it to skip
	// packages that cannot contribute an impl of the method being dispatched.
	dispMethodsByPkg     map[string]map[string]bool
	// dispIfaceMethods: the closure's interface-method universe (tier-1 test).
	// dispLastUse: for each tier-2 package, the last package index that uses it
	// (transitively) in emission order - the release point.
	// dispTier2Arena: the arena each tier-2 package's graph currently lives in.
	dispIfaceMethods     map[string]bool
	dispLastUse          map[string]int32
	dispTier2Arena       map[string]*runtime.Arena
	// dispIfaceMethods is the closure's interface-method universe (tier-1
	// classification), and loadArena is the arena a package's graph should be
	// materialised on when the build wants it releasable rather than resident
	// for the whole link. nil means the root arena, i.e. today's behaviour.
	loadArena            *runtime.Arena
	universe             *UniverseState
	irOutputFile         string
	curPkgPath           string
	lastMxhData          string
}

// wasmSpawnTarget is one function reachable through spawn() on the wasm
// target. The compiler assigns fnIdx; the parent passes it to
// bridge.spawn_domain and the child's __spawn_entry switches on it. The list
// lives on the SSAPackage, not on the compile context, so its lifetime is the
// package's: the per-package arena is bulk-freed after compilation.
type wasmSpawnTarget struct {
	fn           *SSAFunction
	fnIdx        int32
	chanParamIdx []int32 // parameter positions that are channels
	scalarIdx    []int32 // parameter positions that are packed scalars
}

var cctx *compileCtx

func initCompileCtx() {
	if cctx == nil {
		cctx = &compileCtx{}
	}
}

// stripUnusedConsts removes const declarations from source whose names
// don't appear anywhere else in the source. Pre-parse dead constant
// elimination - avoids parsing/type-checking thousands of unreferenced
// constants (e.g., syscall error tables).
func stripUnusedConsts(src []byte) (out []byte) {
	// A const is referenced by any identifier that is not the name its own
	// declaration introduces, anywhere in the source: a function body, a
	// package-level var initializer, a type declaration. Scanning only function
	// bodies stripped a const used solely by a var initializer
	// (web/wasm/app's orlyRelay), and locating the declared name by position is
	// what makes "anywhere else" exact - the name itself is the only occurrence
	// that does not count.
	refs := map[string]bool{}
	i := int32(0)
	for i < len(src) {
		// The name a single-line "const NAME" declares is not a reference.
		declStart := int32(-1)
		declEnd := int32(-1)
		ls := i
		for ls < len(src) && (src[ls] == ' ' || src[ls] == '\t') {
			ls++
		}
		if ls+6 <= len(src) && src[ls] == 'c' && src[ls+1] == 'o' && src[ls+2] == 'n' && src[ls+3] == 's' && src[ls+4] == 't' && src[ls+5] == ' ' {
			ns := ls + 6
			for ns < len(src) && (src[ns] == ' ' || src[ns] == '\t') {
				ns++
			}
			ne := ns
			for ne < len(src) && isIdentCont(src[ne]) {
				ne++
			}
			if ne > ns {
				declStart = ns
				declEnd = ne
			}
		}
		for i < len(src) && src[i] != '\n' {
			if isIdentStart(src[i]) {
				j := i + 1
				for j < len(src) && isIdentCont(src[j]) {
					j++
				}
				if !(i == declStart && j == declEnd) {
					refs[string(src[i:j])] = true
				}
				i = j
				continue
			}
			i++
		}
		if i < len(src) {
			i++
		}
	}

	// Pass 2: filter const declarations. Keep only those whose names
	// appear somewhere other than their own declaration. Scan for "const " or "const(" patterns.
	// For simplicity, only strip individual const lines (not grouped).
	// This handles the bulk of zerrors/zsysnum generated constants.
	out = []byte{:0:len(src)}
	i = 0
	for i < len(src) {
		// Look for "const " at line start (after optional whitespace/tab).
		ls := i
		for ls < len(src) && (src[ls] == ' ' || src[ls] == '\t') {
			ls++
		}
		if ls+6 < len(src) && src[ls] == 'c' && src[ls+1] == 'o' && src[ls+2] == 'n' && src[ls+3] == 's' && src[ls+4] == 't' && src[ls+5] == ' ' {
			// Found "const ". Extract the const name.
			ns := ls + 6
			for ns < len(src) && (src[ns] == ' ' || src[ns] == '\t') {
				ns++
			}
			ne := ns
			for ne < len(src) && isIdentCont(src[ne]) {
				ne++
			}
			if ne > ns {
				cname := string(src[ns:ne])
				exported := cname[0] >= 'A' && cname[0] <= 'Z'
				if !refs[cname] && !exported && constLineIsComplete(src, ls, ne) {
					// Blank the line rather than deleting it. The declaration
					// is provably contained in this one line, and the
					// diagnostic remapper maps concatenated line numbers back
					// to file:line - so dropping a line moved every LATER
					// position and a parse error was reported against the wrong
					// file entirely (net/http's blocker was blamed on clone.mx
					// and was really elsewhere). Exported consts are kept:
					// importers may use them (sha256.BlockSize as an array
					// length).
					out = mxutil.Ensure(out, 1)
					push(out, '/')
					out = mxutil.Ensure(out, 1)
					push(out, '/')
					for i < len(src) && src[i] != '\n' {
						i++
					}
					if i < len(src) {
						out = mxutil.Ensure(out, 1)
						push(out, '\n')
						i++
					}
					continue
				}
			}
		}
		// Copy line through.
		for i < len(src) && src[i] != '\n' {
			out = mxutil.Ensure(out, 1)
			push(out, src[i])
			i++
		}
		if i < len(src) {
			out = mxutil.Ensure(out, 1)
			push(out, '\n')
			i++
		}
	}
	return out
}

// constLineIsComplete reports whether a single-line "const NAME = value"
// declaration is wholly contained in its line. The stripper removes one LINE
// per unreferenced constant, so a declaration whose value continues on the next
// line must be left alone: removing "const c =" left the value behind and the
// parser then reported "non-declaration statement outside function body" (the
// generator tables in x/net/idna are 525 such lines, and it blocked net/http).
// A line is complete when it has seen an '=' after the name and ends in
// something that can end an expression rather than a continuation operator.
func constLineIsComplete(src []byte, lineStart, nameEnd int32) (ok bool) {
	le := lineStart
	for le < len(src) && src[le] != '\n' {
		le++
	}
	// A trailing line comment is not part of the declaration: x/net/idna's
	// 'const mappings = "" + // Size: 6704 bytes' ends its LINE with the word
	// "bytes", and a last-character test that saw that would call a 525-line
	// declaration complete and strip its first line.
	end := le
	inStr := false
	var quote byte = 0
	depth := int32(0)
	for k := lineStart; k+1 < le; k++ {
		c := src[k]
		if inStr {
			if c == '\\' {
				k++
				continue
			}
			if c == quote {
				inStr = false
			}
			continue
		}
		if c == '"' || c == '\'' || c == '`' {
			inStr = true
			quote = c
			continue
		}
		if c == '/' && src[k+1] == '/' {
			end = k
			break
		}
		if c == '(' || c == '[' || c == '{' {
			depth++
		} else if c == ')' || c == ']' || c == '}' {
			if depth > 0 {
				depth--
			}
		}
	}
	// A bracketed value left open at end of line continues on the next line
	// (const x = []T{ / ( / foo( ...); stripping its first line left the rest
	// behind for the parser. Same for an unterminated string.
	if depth != 0 || inStr {
		return false
	}
	last := end
	for last > nameEnd && (src[last-1] == ' ' || src[last-1] == '\t' || src[last-1] == '\r') {
		last--
	}
	if last <= nameEnd {
		return false
	}
	sawAssign := false
	for k := nameEnd; k < last; k++ {
		if src[k] == '=' {
			sawAssign = true
			break
		}
	}
	if !sawAssign {
		return false
	}
	switch src[last-1] {
	case '=', '+', '-', '*', '/', '%', '|', '&', '^', '<', '>', '(', '[', '{', ',', '.', ':', '!':
		return false
	}
	return true
}

func isIdentStart(c byte) (ok bool) {
	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

func isIdentCont(c byte) (ok bool) {
	return isIdentStart(c) || (c >= '0' && c <= '9')
}

func typeCheckPkg(src []byte, name string, arena *runtime.Arena) (pkg *TCPackage, file *syntax.File) {

	shortName := name
	for i := len(name) - 1; i >= 0; i-- {
		if name[i] == '/' {
			shortName = name[i+1:]
			break
		}
	}
	pkg := newTCPackageWithUniverse(name, shortName)
	scope := pkg.Scope
	src = stripUnusedConsts(src)
	rw := rewriteSliceMakeLiterals(src)
	src = rewriteChanMakeLiterals(rw)
	src = stripDuplicatePackageClauses2(src)

	if len(src) == 0 {
		return nil, nil
	}

	cctx.parseErrors = nil
	cctx.pkgGenerics = nil
	cctx.constValMap = nil
	cctx.tcPkgSrc = []byte{:len(src)}; copy(cctx.tcPkgSrc, src)
	cctx.compileExportMap = scanExportPragmas(cctx.tcPkgSrc)
	syntax.CompileExportMap = cctx.compileExportMap
	file, _ := syntax.ParseBytesArena(token.NewFileBase(name|".mx"), src, collectParseError, nil, 0, arena)
	// A parse error leaves a partial tree - the parser recovers and returns a
	// file - so stop whenever the parse reported anything. Continuing produced
	// "unnamed return values" for `func F() err error`, whose real defect is
	// the missing parentheses, and an AST whose body declarations had landed
	// at package scope. Everything downstream of a partial tree is a guess.
	// The loop this replaces counted the errors into an empty body and
	// returned, so even a hard parse failure surfaced as whatever unrelated
	// symptom came next.
	if file == nil || len(cctx.parseErrors) > 0 {
		return nil, nil
	}
	// The package name is the clause name from the source, not the import
	// path tail - they differ for packages like crypto/ec (package btcec).
	// The name flows into the mxh and importer PkgName registration.
	if file.PkgName != nil && file.PkgName.Value != "" {
		pkg.Name = file.PkgName.Value
	}
	for _, d := range file.DeclList {
		switch dd := d.(type) {
		case *syntax.ImportDecl:
			if dd.Path == nil {
				continue
			}
			path := dd.Path.Value
			if len(path) >= 2 && path[0] == '"' {
				path = path[1 : len(path)-1]
			}
			imported := cctx.universe.Registry[path]
			if imported == nil {
				continue
			}
			localName := imported.Name
			if dd.LocalPkgName != nil {
				localName = dd.LocalPkgName.Value
			}
			if localName == "." {
				if imported.Scope != nil {
					for _, n := range imported.Scope.Names() {
						obj := imported.Scope.Lookup(n)
						if obj != nil {
							scope.Insert(obj)
						}
					}
				}
				continue
			}
			scope.Insert(NewPkgName(pkg, localName, imported))
		case *syntax.VarDecl:
			for _, n := range dd.NameList {
				scope.Insert(NewTCVar(pkg, n.Value, nil))
			}
		case *syntax.FuncDecl:
			if dd.Recv == nil && dd.Name != nil && dd.Name.Value != "init" {
				scope.Insert(NewTCFunc(pkg, dd.Name.Value, nil))
			}
		case *syntax.TypeDecl:
			tn := NewTypeName(pkg, dd.Name.Value, nil)
			scope.Insert(tn)
			NewNamed(tn, nil)
		case *syntax.ConstDecl:
			for _, n := range dd.NameList {
				scope.Insert(NewTCConst(pkg, n.Value, nil, nil))
			}
		}
	}
	// Bind aliases before the declarations that name them resolve. `type A = B`
	// must reach B's type object, or A and B are distinct types and
	// `var y B = anA` is rejected. Interface targets keep the Named form: the
	// SSA builder's interface call/return typing depends on Named-ness
	// (ConstVal = interface{ String() string }). Cross-package targets bind too;
	// the mxh writer emits an `alias` line for them so importers get the same
	// type object instead of a clone carrying the target's methods.
	boundAlias := map[string]bool{}
	for pass := int32(0); pass < 8; pass++ {
		progress := false
		for _, d := range file.DeclList {
			td, ok := d.(*syntax.TypeDecl)
			if !ok || td.Name == nil || !td.Alias || td.Type == nil || boundAlias[td.Name.Value] {
				continue
			}
			obj := scope.Lookup(td.Name.Value)
			tn, ok2 := obj.(*TypeName)
			if !ok2 || tn == nil {
				continue
			}
			target := resolveTypeExprWithSubst(td.Type, nil, scope)
			if target == nil {
				continue
			}
			if _, isIface := SafeUnderlying(target).(*TCInterface); isIface {
				continue
			}
			tn.Typ = target
			boundAlias[td.Name.Value] = true
			progress = true
		}
		if !progress {
			break
		}
	}
	for _, d := range file.DeclList {
		if td, ok := d.(*syntax.TypeDecl); ok {
			if td.Alias && boundAlias[td.Name.Value] {
				continue
			}
			obj := scope.Lookup(td.Name.Value)
			if tn, ok2 := obj.(*TypeName); ok2 && tn != nil {
				if n, ok3 := tn.Typ.(*Named); ok3 && n != nil && n.Under == nil {
					if td.Type != nil {
						under := resolveTypeExprWithSubst(td.Type, nil, scope)
						if under != nil {
							n.Under = under
						}
					}
				}
			}
		}
	}

	var curConstGroup *syntax.Group
	var prevConstValues syntax.Expr
	var prevConstType syntax.Expr
	iotaVal := int64(-1)
	for constPass := int32(0); constPass < 2; constPass++ {
		curConstGroup = nil
		prevConstValues = nil
		prevConstType = nil
		iotaVal = int64(-1)
		for _, d := range file.DeclList {
			if cd, ok := d.(*syntax.ConstDecl); ok {
				if cd.Group == nil || cd.Group != curConstGroup {
					curConstGroup = cd.Group
					iotaVal = int64(0)
					prevConstValues = nil
					prevConstType = nil
				} else {
					iotaVal++
				}
				valExpr := cd.Values
				typeExpr := cd.Type
				if valExpr == nil {
					valExpr = prevConstValues
					if typeExpr == nil {
						typeExpr = prevConstType
					}
				}
				if cd.Values != nil {
					prevConstValues = cd.Values
				}
				if cd.Type != nil {
					prevConstType = cd.Type
				}
				typ := tcResolveNameInline(typeExpr, scope)
				if typ == nil && valExpr != nil {
					// A re-exported constant (`ErrNotExist =
					// oserror.ErrNotExist`) takes the imported constant's own
					// type; inferring it from the value alone records the
					// untyped default and the sentinel stops comparing equal.
					if c := tcSelectorConst(valExpr, scope); c != nil && c.Typ != nil {
						typ = c.Typ
					}
				}
				if typ == nil && valExpr != nil {
					typ = tcInferConstTypeFromExpr(valExpr, scope)
				}
				var val ConstVal
				if valExpr != nil {
					val = tcEvalConstExpr(valExpr, scope, iotaVal)
				}
				if typ == nil && val != nil {
					typ = UntypedTypeOfCV(val)
				}
				for _, n := range cd.NameList {
					if val != nil {
						if ci, ok2 := val.(*ConstInt); ok2 {
							// The map is read later by ScanGenericDecls of
							// OTHER packages (array lengths resolving
							// through tcEvalConstExpr), so its buckets must
							// outlive this package's typecheck arena:
							// create and grow in the root arena.
							saved := runtime.CurrentArena()
							runtime.SetCurrentArena(runtime.RootArena())
							if cctx.constValMap == nil {
								cctx.constValMap = map[string]int64{}
							}
							cctx.constValMap[n.Value] = ci.V
							runtime.SetCurrentArena(saved)
						}
					}
					obj := scope.Lookup(n.Value)
					if obj != nil {
						if c, ok3 := obj.(*TCConst); ok3 {
							if constPass == 0 || c.Val == nil {
								// Apply the declared type NOW, not when the SSA member is built.
								// Keeping the untyped value made every later constant expression
								// that used this name promote to float (EvalBinaryLocal promotes
								// when either operand is a ConstFloat), so `absoluteToUnix =
								// absoluteToInternal + internalToUnix` folded in float64 and
								// time.Date/time.Parse were wrong by 2^8 at ~9.2e18.
								if typ != nil && val != nil {
									val = ConvertConstLocal(val, typ)
								}
								c.Typ = typ
								c.Val = val
							}
						}
					}
				}
			}
		}
	}
	for _, d := range file.DeclList {
		if td, ok := d.(*syntax.TypeDecl); ok {
			if td.Alias && boundAlias[td.Name.Value] {
				continue
			}
			// Generic type decls resolve in a child scope holding their type
			// params, so fields like newPoint func() P keep a TypeParam that
			// monomorphized bodies substitute via fb.typeSubst.
			tScope := scope
			obj := scope.Lookup(td.Name.Value)
			if obj != nil {
				if tn, ok2 := obj.(*TypeName); ok2 {
					named, ok3 := tn.Typ.(*Named)
					if ok3 {
						if len(td.TParamList) > 0 {
							tScope = NewScope(scope)
							for _, tp := range td.TParamList {
								if tp.Name != nil && tp.Name.Value != "" {
									tpv := NewTypeParam(NewTypeName(pkg, tp.Name.Value, nil), nil)
									tScope.Insert(NewTypeName(pkg, tp.Name.Value, tpv))
									if len(named.TParams) < len(td.TParamList) {
										named.TParams = mxutil.Ensure(named.TParams, 1)
										push(named.TParams, tpv)
									}
								}
							}
						}
						typ := tcResolveNameInline(td.Type, tScope)
						if typ != nil {
							named.Under = typ
						}
					}
				}
			}
		}
	}
	for _, d := range file.DeclList {
		if td, ok := d.(*syntax.TypeDecl); ok {
			if td.Alias && boundAlias[td.Name.Value] {
				continue
			}
			obj := scope.Lookup(td.Name.Value)
			if obj != nil {
				if tn, ok2 := obj.(*TypeName); ok2 {
					if named, ok3 := tn.Typ.(*Named); ok3 {
						if iface, ok4 := named.Underlying().(*TCInterface); ok4 && len(iface.Embeds) > 0 {
							iface.Completed = false
							iface.AllMethods = nil
							iface.Complete()
						}
					}
				}
			}
		}
	}
	for _, d := range file.DeclList {
		switch dd := d.(type) {
		case *syntax.VarDecl:
			typ := tcResolveNameInline(dd.Type, scope)
			if arr, ok := typ.(*Array); ok && arr.Len < 0 && dd.Values != nil {
				if cl, ok2 := dd.Values.(*syntax.CompositeLit); ok2 {
					typ = NewArray(arr.Elem, int64(len(cl.ElemList)))
				}
			}
			if typ == nil && dd.Values != nil {
				typ = tcInferTypeFromExpr(dd.Values, scope)
			}
			for _, n := range dd.NameList {
				obj := scope.Lookup(n.Value)
				if obj != nil {
					if v, ok := obj.(*TCVar); ok {
						v.Typ = typ
					}
				}
			}
		case *syntax.FuncDecl:
			if dd.Recv == nil && dd.Name.Value != "init" {
				if len(dd.TParamList) > 0 {
					// Generic functions are registered by ScanGenericDecls
					// in the outer arena. Do not register here - this runs
					// in the per-compilation arena which gets freed. Record
					// the name for the mxh so later builds can identify this
					// package's generics without re-parsing.
					cctx.pkgGenerics = mxutil.Ensure(cctx.pkgGenerics, 1)
					push(cctx.pkgGenerics, dd.Name.Value)
					continue
				}
				sig := tcResolveFuncInline(dd.Type, scope)
				obj := scope.Lookup(dd.Name.Value)
				if obj != nil {
					if fn, ok := obj.(*TCFunc); ok && sig != nil {
						fn.Typ = sig
					}
				}
			}
		}
	}
	// Methods must be allocated on root arena - Named types in the registry
	// outlive the typecheck arena.
	tcMethodSaved := runtime.CurrentArena()
	runtime.SetCurrentArena(runtime.RootArena())
	for _, d := range file.DeclList {
		if fd, ok := d.(*syntax.FuncDecl); ok && fd.Recv != nil {
			if recvTypeHasIndex(fd.Recv.Type) {
				rn := genericRecvTypeName(fd.Recv.Type)
				if rn != "" {
					cctx.pkgGenerics = mxutil.Ensure(cctx.pkgGenerics, 1)
					push(cctx.pkgGenerics, rn | "." | fd.Name.Value)
				}
			}
			recvType := tcResolveRecvType(fd.Recv, scope)
			if recvType == nil {
				continue
			}
			sig := tcResolveFuncInlineWithRecv(fd.Type, fd.Recv, scope)
			fn := NewTCFunc(pkg, fd.Name.Value, sig)
			isPtr := false
			var named *Named
			if pt, ok2 := recvType.(*Pointer); ok2 {
				named, _ = pt.Base.(*Named)
				isPtr = true
			} else {
				named, _ = recvType.(*Named)
			}
			if named != nil {
				// A universe type's method set is fixed by pkg/types: a
				// file that declares func (b byte) String() is naming the
				// method the universe already carries, not adding one. The
				// SSA builder registers the definition; attaching a second
				// TCFunc here would duplicate the entry (byte would have
				// two String methods).
				if named.Obj != nil && named.Obj.Pkg == nil {
					continue
				}
				if isPtr {
					fn.PtrRecv = true
				}
				named.AddMethod(fn)
			}
		}
	}
	runtime.SetCurrentArena(tcMethodSaved)
	for _, d := range file.DeclList {
		if vd, ok := d.(*syntax.VarDecl); ok {
			for _, n := range vd.NameList {
				obj := scope.Lookup(n.Value)
				if obj == nil {
					continue
				}
				v, ok2 := obj.(*TCVar)
				if !ok2 || v.Typ != nil {
					continue
				}
				if vd.Values != nil {
					v.Typ = tcInferTypeFromExpr(vd.Values, scope)
				}
			}
		}
	}

	return pkg, file
}

func scanParse(src []byte, name string, arena *runtime.Arena) (file *syntax.File) {
	rw := rewriteSliceMakeLiterals(src)
	rw = rewriteChanMakeLiterals(rw)
	rw = stripDuplicatePackageClauses2(rw)
	if len(rw) == 0 {
		return nil
	}
	f, _ := syntax.ParseBytesArena(token.NewFileBase(name|".mx"), rw, silentErrh, nil, 0, arena)
	return f
}

func fileHasGeneric(file *syntax.File) (ok bool) {
	for _, d := range file.DeclList {
		fd, isFn := d.(*syntax.FuncDecl)
		if !isFn {
			continue
		}
		if fd.Recv == nil && fd.Name != nil && fd.Name.Value != "init" && len(fd.TParamList) > 0 {
			return true
		}
		if fd.Recv != nil && recvTypeHasIndex(fd.Recv.Type) {
			return true
		}
	}
	return false
}

func ScanGenericDecls(src []byte, name string) {
	if cctx.scannedGeneric == nil {
		cctx.scannedGeneric = map[string]bool{}
	}
	// A package is scanned in the whole-link pre-pass and again in the compile
	// pass; the genericArena is never freed, so a second parse would retain a
	// duplicate AST. Scan each package once.
	if cctx.scannedGeneric[name] {
		return
	}
	cctx.scannedGeneric[name] = true
	// The mxh records whether a package declares generics. When it is loaded
	// and says none, skip the probe parse entirely - most packages have no
	// generics, so this avoids parsing the whole package just to find out.
	if cctx.mxhGenerics != nil {
		gens := cctx.mxhGenerics[name]
		if gens != nil && len(gens) == 0 {
			return
		}
	}
	if cctx.genericArena == nil {
		cctx.genericArena = runtime.ArenaNew(64 * 1024 * 1024)
	}
	// First pass in a scratch arena: detect whether the package declares any
	// generics. Only generic packages' ASTs are retained (their FuncDecl nodes
	// are referenced later by monomorphization), so the never-freed
	// genericArena stays bounded to the handful of packages that need it
	// instead of accumulating every package's parsed source.
	scan := runtime.ArenaNew(uintptr(len(src))*200 + 4*1024*1024)
	runtime.ManualArenaEnter(scan)
	probe := scanParse(src, name, scan)
	hasGeneric := probe != nil && fileHasGeneric(probe)
	runtime.ManualArenaExit(scan)
	runtime.ArenaFree(scan)
	if !hasGeneric {
		return
	}
	// Re-parse into the persistent arena so the AST outlives this call. Do
	// NOT enter manual-arena mode: nested calls must get their own
	// freed-at-return arenas so only the AST is retained, not the whole parse
	// trace (the parser is a self-mutating type and its scratch is large).
	saveArena := runtime.CurrentArena()
	runtime.SetCurrentArena(cctx.genericArena)
	defer runtime.SetCurrentArena(saveArena)
	file := scanParse(src, name, cctx.genericArena)
	if file == nil {
		return
	}
	shortName := name
	for i := len(name) - 1; i >= 0; i-- {
		if name[i] == '/' {
			shortName = name[i+1:]
			break
		}
	}
	thePkg := newTCPackageWithUniverse(name, shortName)
	scope := thePkg.Scope
	for _, d := range file.DeclList {
		if id, ok := d.(*syntax.ImportDecl); ok {
			if id.Path == nil {
				continue
			}
			path := id.Path.Value
			if len(path) >= 2 && path[0] == '"' {
				path = path[1 : len(path)-1]
			}
			imported := cctx.universe.Registry[path]
			if imported == nil {
				continue
			}
			localName := imported.Name
			if id.LocalPkgName != nil {
				localName = id.LocalPkgName.Value
			}
			if localName == "." {
				if imported.Scope != nil {
					for _, n := range imported.Scope.Names() {
						obj := imported.Scope.Lookup(n)
						if obj != nil && scope.Lookup(n) == nil {
							scope.Insert(obj)
						}
					}
				}
				continue
			}
			if scope.Lookup(localName) == nil {
				scope.Insert(NewPkgName(thePkg, localName, imported))
			}
		}
	}
	// The package's own registered scope (mxh-loaded or freshly compiled)
	// carries real types with method sets and real signatures; synthetic
	// nil-typed stand-ins are only a fallback for unexported decls. Without
	// this, method calls on package types inside monomorphized bodies
	// silently resolve to nothing.
	regPkg := cctx.universe.Registry[name]
	for _, d := range file.DeclList {
		switch dd := d.(type) {
		case *syntax.FuncDecl:
			if dd.Recv == nil && dd.Name != nil && dd.Name.Value != "init" {
				if len(dd.TParamList) > 0 {
					if cctx.genericFuncDecls == nil {
						cctx.genericFuncDecls = map[string]*syntax.FuncDecl{}
					}
					cctx.genericFuncDecls[name+"."+dd.Name.Value] = dd
				} else {
					if cctx.genericPkgLocalDecls == nil {
						cctx.genericPkgLocalDecls = map[string]*syntax.FuncDecl{}
					}
					cctx.genericPkgLocalDecls[name+"."+dd.Name.Value] = dd
				}
			}
			if dd.Recv != nil && dd.Name != nil && recvTypeHasIndex(dd.Recv.Type) {
				rn := genericRecvTypeName(dd.Recv.Type)
				if rn != "" {
					if cctx.genericMethodDecls == nil {
						cctx.genericMethodDecls = map[string]*syntax.FuncDecl{}
					}
					cctx.genericMethodDecls[name+"."+rn+"."+dd.Name.Value] = dd
				}
			}
			if dd.Recv == nil && dd.Name != nil {
				if scope.Lookup(dd.Name.Value) == nil {
					if ro := regScopeLookup(regPkg,dd.Name.Value); ro != nil {
						scope.Insert(ro)
					} else {
						scope.Insert(NewTCFunc(thePkg, dd.Name.Value, nil))
					}
				}
			}
		case *syntax.TypeDecl:
			existing := scope.Lookup(dd.Name.Value)
			if existing == nil {
				if ro := regScopeLookup(regPkg,dd.Name.Value); ro != nil {
					scope.Insert(ro)
					continue
				}
				tn := NewTypeName(thePkg, dd.Name.Value, nil)
				named := NewNamed(tn, nil)
				if dd.Type != nil {
					under := resolveTypeExprWithSubst(dd.Type, nil, scope)
					if under != nil {
						named.Under = under
					}
				}
				scope.Insert(tn)
			} else if tn, ok := existing.(*TypeName); ok {
				if n, ok2 := tn.Typ.(*Named); ok2 && n.Under == nil {
					if dd.Type != nil {
						under := resolveTypeExprWithSubst(dd.Type, nil, scope)
						if under != nil {
							n.Under = under
						}
					}
				}
			}
		case *syntax.ConstDecl:
			for _, cn := range dd.NameList {
				if scope.Lookup(cn.Value) == nil {
					if ro := regScopeLookup(regPkg,cn.Value); ro != nil {
						scope.Insert(ro)
					} else {
						scope.Insert(NewTCConst(thePkg, cn.Value, nil, nil))
					}
				}
			}
		case *syntax.VarDecl:
			// Resolve the declared type from source when the registry
			// package is unavailable (its own compile in progress) or the
			// var is unexported and absent from the mxh export. Without
			// this, unexported vars referenced from a monomorphized body
			// (e.g. ecdsa's _p256Cached *Curve[*nistec.P256Point]) get a
			// nil-typed synthetic object and degrade to the __any
			// interface, emitting a {i64, ptr} load where the store wrote
			// a plain ptr.
			var declType Type
			if dd.Type != nil {
				declType = resolveTypeExprWithSubst(dd.Type, nil, scope)
			}
			for _, vn := range dd.NameList {
				if scope.Lookup(vn.Value) == nil {
					if ro := regScopeLookup(regPkg, vn.Value); ro != nil {
						scope.Insert(ro)
					} else if declType != nil {
						scope.Insert(NewTCVar(thePkg, vn.Value, declType))
					} else {
						scope.Insert(NewTCVar(thePkg, vn.Value, nil))
					}
				}
			}
		}
	}
	if cctx.genericPkgScopes == nil {
		cctx.genericPkgScopes = map[string]*Scope{}
	}
	cctx.genericPkgScopes[name] = scope
}

// recvTypeHasIndex reports whether a receiver type expression contains an
// IndexExpr (a generic receiver like Array[T]).
func recvTypeHasIndex(t syntax.Expr) (ok bool) {
	switch tt := t.(type) {
	case *syntax.Operation:
		if tt.Y == nil {
			return recvTypeHasIndex(tt.X)
		}
	case *syntax.IndexExpr:
		return true
	case *syntax.ListExpr:
		for _, e := range tt.ElemList {
			if recvTypeHasIndex(e) {
				return true
			}
		}
	}
	return false
}

// genericRecvTypeName extracts the base type name from a receiver type
// expression, unwrapping pointers and generic instantiations.
func genericRecvTypeName(t syntax.Expr) (name string) {
	switch tt := t.(type) {
	case *syntax.Operation:
		if tt.Y == nil {
			return genericRecvTypeName(tt.X)
		}
	case *syntax.IndexExpr:
		return genericRecvTypeName(tt.X)
	case *syntax.Name:
		return tt.Value
	}
	return ""
}

func regScopeLookup(regPkg *TCPackage, n string) (o Object) {
	if regPkg == nil || regPkg.Scope == nil {
		return nil
	}
	return regPkg.Scope.Lookup(n)
}

// TypeCheckOnly typechecks src, serializes exports to mxhPath (if non-empty),
// and populates the registry via loadMxh. The type graph never leaves the
// typecheck arena - only the refined mxh text touches disk.
func TypeCheckOnly(src []byte, name string, mxhPath string) {
	memLine("   tc-in "|name)
	arenaSize := uintptr(len(src)) * 50
	if arenaSize < 4*1024*1024 {
		arenaSize = 4 * 1024 * 1024
	}
	arena := runtime.ArenaNew(arenaSize)
	// Borrow semantics: push a new frame, never overwrite the caller's
	// slot. fnStack[0] stays the root arena, so sovGroup bookkeeping lands
	// in root-lifetime memory. The typecheck arena's contents - and any
	// sovereign groups whose receivers live in it - die together at
	// ArenaFree below (sovInvalidateArena sweep).
	runtime.ManualArenaEnter(arena)
	pkg, file := typeCheckPkg(src, name, arena)
	if pkg != nil && file != nil {
		mxhData := generateMxh(pkg)
		runtime.ManualArenaExit(arena)
		// mxh text must land in the caller's (persistent) arena so the
		// registry survives ArenaFree.
		if mxhPath != "" {
			writeFile(mxhPath, []byte(mxhData), 0644)
		}
		loadMxhInto([]byte(mxhData))
	} else {
		runtime.ManualArenaExit(arena)
	}
	ScanGenericDecls(src, name)
	runtime.ArenaFree(arena)
	memLine("   tc-out "|name)
}



func CompileToIR(src []byte, name string, triple string) (s string) {
	cctx.compileTargetTriple = triple
	cctx.curPkgPath = name
	scanEmbedPragmas(src, cctx.compilePkgDir)
	cctx.linknameMap = scanLinknameMap(src)
	cctx.externGlobals = scanExternGlobals(src)
	cctx.wasmImportMap = scanWasmImportMap(src, name)

	// Arena sized from source. Virtual address space is free - pages commit
	// on touch. 1000x covers generated-table-heavy packages like syscall and
	// unicode; the arena appends 64MB chain regions if a package exceeds it,
	// so the reservation is an optimisation and never a requirement - which
	// is why it can be capped. The largest generated source in the tree asked
	// for ~6.7GB of address space for a single package; that reservation (and
	// its guard pages) costs address-space accounting and page-table work even
	// where nothing is touched, so bound it and let the chain regions cover
	// anything larger.
	compileArenaSize := uintptr(len(src)) * 1000
	if compileArenaSize < 64*1024*1024 {
		compileArenaSize = 64 * 1024 * 1024
	}
	if compileArenaSize > 512*1024*1024 {
		compileArenaSize = 512 * 1024 * 1024
	}
	// Scan generic decls in the caller's arena: the resulting AST nodes
	// and generic scopes are referenced by later package compiles and
	// must outlive this package's compile arena.
	ScanGenericDecls(src, name)

	memLine("   ci-pre "|name)
	arena := runtime.ArenaNew(compileArenaSize)
	runtime.ManualArenaEnter(arena)

	pkg, file := typeCheckPkg(src, name, arena)
	memLine("   ci-tc "|name)

	// Generate mxh inside compile arena - type graph is alive.
	// Serialize exports before any arena switch. Then load the
	// serialized text on the root arena. No cross-arena graph copy.
	if pkg != nil && file != nil {
		mxhData := generateMxh(pkg)
		runtime.ManualArenaExit(arena)
		loadMxhInto([]byte(mxhData))
		// Copy mxh text to root arena so it survives ArenaFree.
		mxhCopy := []byte{:len(mxhData)}
		copy(mxhCopy, mxhData)
		cctx.lastMxhData = string(mxhCopy)
		runtime.ManualArenaEnter(arena)
	}

	runtime.ManualArenaExit(arena)

	if file == nil {
		res := parseErrorReport()
		resCopy := []byte{:len(res)}
		copy(resCopy, res)
		runtime.ArenaFree(arena)
		cctx.compileArena = nil
		return string(resCopy)
	}

	// Re-enter compilation arena for SSA + IR emit.
	runtime.ManualArenaEnter(arena)

	mxutil.WriteStr(2, "    SSA build\n")
	prog := NewSSAProgram()
	ssaPkg := prog.CreatePackage(pkg, []*syntax.File{file}, nil)
	if len(cctx.compileErrors) > 0 {
		// Restriction violations recorded during SSA build fail the package.
		var errSegs []string
		for _, ce := range cctx.compileErrors {
			errSegs = mxutil.Ensure(errSegs, 1)
			push(errSegs, "; " | ce | "\n")
		}
		cctx.compileErrors = cctx.compileErrors[:0]
		res := joinStrs(errSegs)
		runtime.ManualArenaExit(arena)
		resCopy := []byte{:len(res)}
		copy(resCopy, res)
		runtime.ArenaFree(arena)
		cctx.compileArena = nil
		return string(resCopy)
	}
	emitter := newIREmitter(ssaPkg, triple, int32(len(cctx.tcPkgSrc)))
	mxutil.WriteStr(2, "    IR emit\n")
	if cctx.irOutputFile != "" {
		// Create file on outer arena (os.File must outlive inner arena).
		runtime.ManualArenaExit(arena)
		f, ferr := os.Create(cctx.irOutputFile)
		runtime.ManualArenaEnter(arena)
		if ferr == nil {
			emitter.outFile = f
		} else {
			mxutil.WriteStr(2, "IR FILE CREATE FAILED: " | ferr.Error() | "\n")
		}
	}
	ir := emitter.emit()
	if emitter.outFile != nil {
		emitter.outFile.Close()
		emitter.outFile = nil
	}


	// Copy IR to outer arena before inner arena dies.
	runtime.ManualArenaExit(arena)
	var result string
	if len(ir) > 0 {
		heapIR := []byte{:len(ir)}
		copy(heapIR, ir)
		result = string(heapIR)
	}

	// Bulk reclaim: reset arena for next compilation.
	runtime.ArenaFree(arena)
	cctx.compileArena = nil
	memLine("   ci-free "|name)
	return result
}

func tcInferTypeFromExpr(e syntax.Expr, scope *Scope) (t Type) {
	switch ex := e.(type) {
	case *syntax.BasicLit:
		switch ex.Kind {
		case token.StringLit:
			return Typ[TCString]
		case token.IntLit:
			return Typ[Int32]
		case token.FloatLit:
			return Typ[Float64]
		}
	case *syntax.Name:
		if ex.Value == "true" || ex.Value == "false" {
			return Typ[Bool]
		}
		return tcResolveNameInline(ex, scope)
	case *syntax.CallExpr:
		resolved := tcResolveNameInline(ex.Fun, scope)
		if resolved != nil {
			return resolved
		}
		return tcResolveFuncReturn(ex.Fun, scope)
	case *syntax.CompositeLit:
		tt := tcResolveNameInline(ex.Type, scope)
		if arr, ok := tt.(*Array); ok && arr.Len < 0 {
			return NewArray(arr.Elem, int64(len(ex.ElemList)))
		}
		return tt
	case *syntax.Operation:
		if ex.Y == nil && ex.Op == token.And {
			return NewPointer(tcInferTypeFromExpr(ex.X, scope))
		}
	}
	return nil
}

// tcInferConstTypeFromExpr is tcInferTypeFromExpr for a constant declaration.
// An untyped literal must keep its untyped type: `const BlockSize = 16` with
// the default int32 became a typed constant that beat a typed sibling, so
// `BlockSize - remainder` (remainder uint64) was int32 and could not pass to a
// uint64 parameter. Untyped constants take the type their context gives them.
func tcInferConstTypeFromExpr(e syntax.Expr, scope *Scope) (t Type) {
	if bl, ok := e.(*syntax.BasicLit); ok {
		switch bl.Kind {
		case token.IntLit:
			return Typ[UntypedInt]
		case token.FloatLit:
			return Typ[UntypedFloat]
		}
	}
	if n, ok := e.(*syntax.Name); ok && (n.Value == "true" || n.Value == "false") {
		return Typ[UntypedBool]
	}
	// A reference to another constant takes THAT constant's recorded type. The
	// declared type is applied when the declaration is processed (see c.Typ =
	// typ below), so a chain keeps it only if a reference reads it back:
	//   Nanosecond  Duration = 1
	//   Microsecond          = 1000 * Nanosecond
	//   Second               = 1000 * Millisecond
	// Without this arm every spec after the first fell through to
	// UntypedTypeOfCV, so time.Second was untyped, `5 * time.Second` defaulted
	// to int32, and net/http failed with "cannot use 5000000000 as int32 value
	// ... (overflows int32)". Verified: with the fix a depth-1 expression is
	// typed and rejected against int32, and before it even depth 1 was lost.
	if n, ok2 := e.(*syntax.Name); ok2 && scope != nil {
		if _, obj := scope.LookupParent(n.Value); obj != nil {
			if c, isC := obj.(*TCConst); isC && c.Typ != nil {
				return c.Typ
			}
		}
	}
	if _, ok3 := e.(*syntax.SelectorExpr); ok3 {
		if c := tcSelectorConst(e, scope); c != nil && c.Typ != nil {
			return c.Typ
		}
	}
	// A binary constant expression takes the type of its TYPED operand: Go's
	// rule is that an untyped constant combines with a typed one and the
	// result keeps the typed operand's type. Without this the expression had
	// no inferred type, the constant fell back to UntypedTypeOfCV, and
	// `const c = uintptr(64) * 1024 * 1024` became an untyped int: `x := c`
	// then took the int32 default representation, so src/runtime's
	// `newCap := arenaDefaultRegion` was int32 and the arena's region
	// capacity arithmetic (cap*2, size rounding, sysMap's uintptr parameter)
	// ran in 32 bits. Comparisons and logical operators are excluded: they
	// yield an untyped bool whatever the operands are, so they fall through to
	// the value-based fallback.
	if op, ok := e.(*syntax.Operation); ok && op.Y != nil {
		switch op.Op {
		case token.Eql, token.Neq, token.Lss, token.Leq, token.Gtr, token.Geq, token.OrOr, token.AndAnd:
			return nil
		}
		xt := tcInferConstTypeFromExpr(op.X, scope)
		yt := tcInferConstTypeFromExpr(op.Y, scope)
		xtu := !constTypeIsTyped(xt)
		ytu := !constTypeIsTyped(yt)
		if !xtu && ytu {
			return xt
		}
		if !ytu && xtu {
			return yt
		}
		if !xtu && !ytu {
			return xt
		}
		return nil
	}
	return tcInferTypeFromExpr(e, scope)
}

// constTypeIsTyped reports whether an inferred constant type is a real type
// rather than an untyped constant kind or an unknown.
func constTypeIsTyped(t Type) (ok bool) {
	if t == nil {
		return false
	}
	if b, isB := SafeUnderlying(t).(*Basic); isB && b.Info&IsUntyped != 0 {
		return false
	}
	return true
}

func tcResolveFuncReturn(e syntax.Expr, scope *Scope) (t Type) {
	var obj Object
	switch ex := e.(type) {
	case *syntax.Name:
		if scope != nil {
			_, obj = scope.LookupParent(ex.Value)
		}
	case *syntax.SelectorExpr:
		pkgName, ok1 := ex.X.(*syntax.Name)
		if !ok1 {
			return nil
		}
		if scope != nil {
			_, pkgObj := scope.LookupParent(pkgName.Value)
			if pn, ok2 := pkgObj.(*PkgName); ok2 && pn.Imported != nil {
				obj = pn.Imported.Scope.Lookup(ex.Sel.Value)
			}
		}
		if obj == nil {
			if imp := cctx.universe.LookupByName(pkgName.Value); imp != nil {
				obj = imp.Scope.Lookup(ex.Sel.Value)
			}
		}
	}
	if obj == nil {
		return nil
	}
	if c, okc := obj.(*TCConst); okc {
		if c.Typ != nil {
			return c.Typ
		}
		if c.Val != nil {
			return UntypedTypeOfCV(c.Val)
		}
		return nil
	}
	fn, ok := obj.(*TCFunc)
	if !ok {
		return nil
	}
	sig, ok := fn.Typ.(*Signature)
	if !ok || sig.Results == nil || sig.Results.Len() == 0 {
		return nil
	}
	// A result slot can hold a nil *TCVar - the count alone does not prove the
	// element is there, and dereferencing it took the compiler down with a nil
	// panic while type-checking. Report "unknown" instead.
	if sig.Results.Len() == 1 {
		if v := sig.Results.At(0); v != nil {
			return v.Typ
		}
		return nil
	}
	for i := int32(0); i < sig.Results.Len(); i++ {
		if sig.Results.At(i) == nil {
			return nil
		}
	}
	return NewTuple(sig.Results.Vars...)
}

func compileTargetArch() (s string) {
	if mxutil.HasPrefix(cctx.compileTargetTriple, "x86_64") {
		return "amd64"
	}
	if mxutil.HasPrefix(cctx.compileTargetTriple, "aarch64") {
		return "arm64"
	}
	if mxutil.HasPrefix(cctx.compileTargetTriple, "wasm32") {
		return "wasm"
	}
	return "amd64"
}

func compileTargetOS() (s string) {
	if lIndexByte(cctx.compileTargetTriple, '-') >= 0 {
		rest := cctx.compileTargetTriple[lIndexByte(cctx.compileTargetTriple, '-')+1:]
		if lIndexByte(rest, '-') >= 0 {
			osName := rest[lIndexByte(rest, '-')+1:]
			if mxutil.HasPrefix(osName, "linux") {
				return "linux"
			}
			if mxutil.HasPrefix(osName, "darwin") {
				return "darwin"
			}
			if mxutil.HasPrefix(osName, "js") || mxutil.HasPrefix(osName, "wasi") {
				return "js"
			}
		}
	}
	return "linux"
}

func resolveArrayLenFromSrc(p token.Pos, cmap map[string]int64) (n int64) {
	line := p.Line()
	col := p.Col()
	if line == 0 || col == 0 || cctx.tcPkgSrc == nil {
		return -1
	}
	off := 0
	curLine := uint32(1)
	for off < len(cctx.tcPkgSrc) && curLine < line {
		if cctx.tcPkgSrc[off] == '\n' {
			curLine++
		}
		off++
	}
	off += int32(col) - 1
	if off >= len(cctx.tcPkgSrc) || cctx.tcPkgSrc[off] != '[' {
		return -1
	}
	off++
	for off < len(cctx.tcPkgSrc) && cctx.tcPkgSrc[off] == ' ' {
		off++
	}
	start := off
	for off < len(cctx.tcPkgSrc) {
		c := cctx.tcPkgSrc[off]
		if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' {
			off++
		} else {
			break
		}
	}
	if off == start {
		return -1
	}
	name := string(cctx.tcPkgSrc[start:off])
	if v, ok := cmap[name]; ok {
		if off < len(cctx.tcPkgSrc) && cctx.tcPkgSrc[off] == '+' {
			off++
			for off < len(cctx.tcPkgSrc) && cctx.tcPkgSrc[off] == ' ' {
				off++
			}
			numStart := off
			for off < len(cctx.tcPkgSrc) && cctx.tcPkgSrc[off] >= '0' && cctx.tcPkgSrc[off] <= '9' {
				off++
			}
			if off > numStart {
				addend := int64(0)
				for i := numStart; i < off; i++ {
					addend = addend*10 + int64(cctx.tcPkgSrc[i]-'0')
				}
				return v + addend
			}
		}
		return v
	}
	n := int64(0)
	isNum := true
	for i := start; i < off; i++ {
		c := cctx.tcPkgSrc[i]
		if c >= '0' && c <= '9' {
			n = n*10 + int64(c-'0')
		} else {
			isNum = false
			break
		}
	}
	if isNum && off > start {
		for off < len(cctx.tcPkgSrc) && (cctx.tcPkgSrc[off] == ' ' || cctx.tcPkgSrc[off] == '\t') {
			off++
		}
		if off+2 < len(cctx.tcPkgSrc) && cctx.tcPkgSrc[off] == '<' && cctx.tcPkgSrc[off+1] == '<' {
			off += 2
			for off < len(cctx.tcPkgSrc) && (cctx.tcPkgSrc[off] == ' ' || cctx.tcPkgSrc[off] == '\t') {
				off++
			}
			shiftVal := resolveLocalConst(cctx.tcPkgSrc, off, cmap)
			if shiftVal >= 0 {
				return n << uint32(shiftVal)
			}
		}
		return n
	}
	return -1
}

func resolveLocalConst(src []byte, off int32, cmap map[string]int64) (n int64) {
	start := off
	for off < len(src) && ((src[off] >= 'a' && src[off] <= 'z') || (src[off] >= 'A' && src[off] <= 'Z') || (src[off] >= '0' && src[off] <= '9') || src[off] == '_') {
		off++
	}
	if off == start {
		return -1
	}
	name := string(src[start:off])
	if v, ok := cmap[name]; ok {
		return v
	}
	n := int64(0)
	isNum := true
	for i := start; i < off; i++ {
		if src[i] >= '0' && src[i] <= '9' {
			n = n*10 + int64(src[i]-'0')
		} else {
			isNum = false
			break
		}
	}
	if isNum {
		return n
	}
	cname := "const " | name | " = "
	cb := []byte(cname)
	for i := int32(0); i <= int32(len(src))-int32(len(cb)); i++ {
		if string(src[i:i+int32(len(cb))]) == cname {
			valOff := i + int32(len(cb))
			val := int64(0)
			found := false
			for valOff < int32(len(src)) && src[valOff] >= '0' && src[valOff] <= '9' {
				val = val*10 + int64(src[valOff]-'0')
				valOff++
				found = true
			}
			if found {
				return val
			}
		}
	}
	return -1
}


// tcConstExprBasic resolves the basic type of a constant expression in the
// emitter's scope-based evaluator, mirroring Checker.constExprBasic.
func tcConstExprBasic(e syntax.Expr, scope *Scope) (b *Basic) {
	switch ex := e.(type) {
	case *syntax.Name:
		if scope != nil {
			_, obj := scope.LookupParent(ex.Value)
			if k, ok := obj.(*TCConst); ok && k.Typ != nil {
				if bb, ok2 := SafeUnderlying(k.Typ).(*Basic); ok2 {
					return bb
				}
			}
		}
	case *syntax.ParenExpr:
		return tcConstExprBasic(ex.X, scope)
	case *syntax.CallExpr:
		if t := tcResolveNameInline(ex.Fun, scope); t != nil {
			if bb, ok := SafeUnderlying(t).(*Basic); ok {
				return bb
			}
		}
	case *syntax.Operation:
		if bb := tcConstExprBasic(ex.X, scope); bb != nil && bb.Info&IsUntyped == 0 {
			return bb
		}
		if ex.Y != nil {
			return tcConstExprBasic(ex.Y, scope)
		}
	}
	return nil
}

func tcEvalConstExpr(e syntax.Expr, scope *Scope, iotaVal int64) (c ConstVal) {
	if e == nil {
		return nil
	}
	switch ex := e.(type) {
	case *syntax.BasicLit:
		return EvalBasicLitLocal(ex)
	case *syntax.Name:
		if ex.Value == "iota" && iotaVal >= 0 {
			return &ConstInt{V:iotaVal}
		}
		if scope != nil {
			_, obj := scope.LookupParent(ex.Value)
			if k, ok := obj.(*TCConst); ok && k.Val != nil {
				return k.Val
			}
		}
		if cctx.constValMap != nil {
			if v, ok := cctx.constValMap[ex.Value]; ok {
				return &ConstInt{V:v}
			}
		}
	case *syntax.Operation:
		if ex.Y == nil {
			xr := tcEvalConstExpr(ex.X, scope, iotaVal)
			if xr == nil {
				return nil
			}
			r := EvalUnaryLocal(ex.Op, xr)
			// Mask ^x to the typed operand's width (see evalConstOp).
			if r != nil && ex.Op == token.Xor {
				if b := tcConstExprBasic(ex.X, scope); b != nil {
					r = MaskConstToBasic(r, b)
				}
			}
			return r
		}
		xr2 := tcEvalConstExpr(ex.X, scope, iotaVal)
		yr := tcEvalConstExpr(ex.Y, scope, iotaVal)
		if xr2 == nil || yr == nil {
			return nil
		}
		return EvalBinaryLocal(ex.Op, xr2, yr)
	case *syntax.ParenExpr:
		return tcEvalConstExpr(ex.X, scope, iotaVal)
	case *syntax.CallExpr:
		if id, ok := ex.Fun.(*syntax.Name); ok && id.Value == "len" && len(ex.ArgList) == 1 {
			if lit, ok2 := ex.ArgList[0].(*syntax.BasicLit); ok2 && lit.Kind == token.StringLit {
				lv := EvalBasicLitLocal(lit)
				if cs, ok3 := lv.(*ConstStr); ok3 {
					return &ConstInt{V:int64(len(cs.S))}
				}
			}
			inner := tcEvalConstExpr(ex.ArgList[0], scope, iotaVal)
			if cs, ok2 := inner.(*ConstStr); ok2 {
				return &ConstInt{V:int64(len(cs.S))}
			}
		}
		if sel, ok := ex.Fun.(*syntax.SelectorExpr); ok {
			if pg, ok2 := sel.X.(*syntax.Name); ok2 && pg.Value == "unsafe" {
				switch sel.Sel.Value {
				case "Sizeof", "Alignof", "Offsetof":
					return &ConstInt{V:8}
				}
			}
		}
		if len(ex.ArgList) != 1 {
			return nil
		}
		inner2 := tcEvalConstExpr(ex.ArgList[0], scope, iotaVal)
		if inner2 == nil {
			return nil
		}
		targetType := tcResolveNameInline(ex.Fun, scope)
		if targetType == nil {
			return inner2
		}
		return ConvertConstLocal(inner2, targetType)
	case *syntax.SelectorExpr:
		pkgName, ok := ex.X.(*syntax.Name)
		if !ok {
			return nil
		}
		if pkgName.Value == "runtime" {
			if ex.Sel.Value == "GOARCH" {
				return &ConstStr{S:compileTargetArch()}
			}
			if ex.Sel.Value == "GOOS" {
				return &ConstStr{S:compileTargetOS()}
			}
		}
		var imported *TCPackage
		if scope != nil {
			_, obj := scope.LookupParent(pkgName.Value)
			if pn, ok2 := obj.(*PkgName); ok2 && pn.Imported != nil {
				imported = pn.Imported
			}
		}
		if imported == nil {
			imported = cctx.universe.Registry[pkgName.Value]
		}
		if imported == nil {
			return nil
		}
		member := imported.Scope.Lookup(ex.Sel.Value)
		if member == nil {
			return nil
		}
		if k, ok2 := member.(*TCConst); ok2 && k.Val != nil {
			return k.Val
		}
		return nil
	}
	return nil
}

// tcSelectorConst resolves `pkg.Name` to the imported package's constant
// object, so a re-exported constant can take that constant's type instead of
// an untyped default.
func tcSelectorConst(e syntax.Expr, scope *Scope) (c *TCConst) {
	sel, ok := e.(*syntax.SelectorExpr)
	if !ok {
		return nil
	}
	id, ok2 := sel.X.(*syntax.Name)
	if !ok2 {
		return nil
	}
	if scope != nil {
		_, obj := scope.LookupParent(id.Value)
		if pn, ok3 := obj.(*PkgName); ok3 && pn.Imported != nil && pn.Imported.Scope != nil {
			if k, ok4 := pn.Imported.Scope.Lookup(sel.Sel.Value).(*TCConst); ok4 {
				return k
			}
		}
	}
	if imp := cctx.universe.LookupByName(id.Value); imp != nil && imp.Scope != nil {
		if k, ok5 := imp.Scope.Lookup(sel.Sel.Value).(*TCConst); ok5 {
			return k
		}
	}
	return nil
}

// typeExprName renders a type expression for a diagnostic: `pkg.Sel` for a
// qualified type, `Name` for a bare one, and the empty string when it has
// neither shape (then the caller's message is just "undefined: ").
func typeExprName(e syntax.Expr) (s string) {
	switch x := e.(type) {
	case *syntax.Name:
		return x.Value
	case *syntax.SelectorExpr:
		if n, ok := x.X.(*syntax.Name); ok {
			return n.Value | "." | x.Sel.Value
		}
	}
	return ""
}

func tcResolveNameInline(e syntax.Expr, scope *Scope) (t Type) {
	if e == nil {
		return nil
	}
	switch ex := e.(type) {
	case *syntax.Name:
		var obj Object
		if scope != nil {
			_, obj = scope.LookupParent(ex.Value)
		} else {
			_, obj = Universe.LookupParent(ex.Value)
		}
		if obj != nil {
			if tn, ok := obj.(*TypeName); ok {
				return tn.Typ
			}
		}
	case *syntax.SelectorExpr:
		pkgName, ok := ex.X.(*syntax.Name)
		if ok && scope != nil {
			_, pkgObj := scope.LookupParent(pkgName.Value)
			if pn, ok2 := pkgObj.(*PkgName); ok2 && pn.Imported != nil {
				typeObj := pn.Imported.Scope.Lookup(ex.Sel.Value)
				if typeObj != nil {
					if tn, ok3 := typeObj.(*TypeName); ok3 {
						return tn.Typ
					}
				}
			}
		}
		// Fallback: look up by short package name via index. It is load-bearing
		// for legitimate code - removing it made the element type of
		// `...fmt.Stringer` come back nil in a file that DOES import fmt (the
		// scope handed to this resolver does not always carry the binding), and
		// the slice construction then computed a garbage element size and
		// panicked the compiler. An unresolvable type is caught by name at the
		// DotsType/parameter sites instead.
		if pkgName2, ok2 := ex.X.(*syntax.Name); ok2 {
			if imp := cctx.universe.LookupByName(pkgName2.Value); imp != nil {
				typeObj := imp.Scope.Lookup(ex.Sel.Value)
				if typeObj != nil {
					if tn, ok3 := typeObj.(*TypeName); ok3 {
						return tn.Typ
					}
				}
			}
		}
	case *syntax.IndexExpr:
		// Generic instantiation Curve[T]: carry the type args on a shallow
		// Named copy so var/field/return types keep their instantiation
		// (e.g. _p224Cached *Curve[*nistec.P224Point] must not collapse to
		// the bare generic Curve, which breaks type-arg inference).
		base := tcResolveNameInline(ex.X, scope)
		if named, ok := base.(*Named); ok && named.TArgs == nil && ex.Index != nil {
			var args []Type
			if le, ok2 := ex.Index.(*syntax.ListExpr); ok2 {
				for _, te := range le.ElemList {
					ta := tcResolveNameInline(te, scope)
					if ta == nil {
						return base
					}
					push(args, ta)
				}
			} else {
				ta := tcResolveNameInline(ex.Index, scope)
				if ta == nil {
					return base
				}
				push(args, ta)
			}
			if len(args) > 0 {
				return &Named{Obj: named.Obj, Under: named.Under, Methods: named.Methods, TParams: named.TParams, TArgs: args}
			}
		}
		return base
	case *syntax.Operation:
		if ex.Y == nil && ex.Op == token.Mul {
			base := tcResolveNameInline(ex.X, scope)
			if base == nil {
				return nil
			}
			return NewPointer(base)
		}
	case *syntax.SliceType:
		elem := tcResolveNameInline(ex.Elem, scope)
		if elem != nil {
			if b, ok := elem.(*Basic); ok && b.Kind == Uint8 {
				return Typ[TCString]
			}
			return NewSlice(elem)
		}
	case *syntax.ArrayType:
		elem := tcResolveNameInline(ex.Elem, scope)
		if elem != nil {
			n := int64(-1)
			if lit, ok := ex.Len.(*syntax.BasicLit); ok {
				n = irParseInt64(lit.Value)
			} else if ex.Len != nil {
				cv := tcEvalConstExpr(ex.Len, scope, -1)
				if cv != nil {
					if ci, ok4 := cv.(*ConstInt); ok4 {
						n = ci.V
					}
				}
				if n == -1 && cctx.constValMap != nil {
					epos := ex.Pos()
					n = resolveArrayLenFromSrc(epos, cctx.constValMap)
				}
			}
			return NewArray(elem, n)
		}
	case *syntax.MapType:
		key := tcResolveNameInline(ex.Key, scope)
		val := tcResolveNameInline(ex.Value, scope)
		if key != nil && val != nil {
			return NewTCMap(key, val)
		}
	case *syntax.StructType:
		var fields []*TCVar
		var tags []string
		for i, field := range ex.FieldList {
			typ := tcResolveNameInline(field.Type, scope)
			fname := ""
			if field.Name != nil {
				fname = field.Name.Value
			} else {
				fname = EmbeddedFieldName(field.Type)
				if fname == "" {
					fname = TypeBaseName(typ)
				}
			}
			fields = mxutil.Ensure(fields, 1)
			push(fields, NewTCField(nil, fname, typ, field.Name == nil))
			tag := ""
			if i < len(ex.TagList) && ex.TagList[i] != nil {
				tag = TagText(ex.TagList[i].Value)
			}
			tags = mxutil.Ensure(tags, 1)
			push(tags, tag)
		}
		return NewTCStruct(fields, tags)
	case *syntax.FuncType:
		return tcResolveFuncInline(ex, scope)
	case *syntax.InterfaceType:
		return tcResolveInterfaceInline(ex, scope)
	case *syntax.ChanType:
		elem := tcResolveNameInline(ex.Elem, scope)
		if elem != nil {
			dir := TCSendRecv
			if ex.Dir == syntax.SendOnly {
				dir = TCSendOnly
			} else if ex.Dir == syntax.RecvOnly {
				dir = TCRecvOnly
			}
			return NewTCChan(dir, elem)
		}
	case *syntax.DotsType:
		elem := tcResolveNameInline(ex.Elem, scope)
		if elem != nil {
			if b, ok := elem.(*Basic); ok && b.Kind == Uint8 {
				return Typ[TCString]
			}
			return NewSlice(elem)
		}
		// A variadic parameter whose element type does not resolve used to fall
		// through to nil. The parameter type then became `void` while the
		// variadic flag stayed true (it is read from the AST), so a caller built
		// a slice and passed it to a void parameter:
		//     call void @main.f(void %t3, ptr null)
		// which clang rejects - or, when the scope happened to carry the
		// binding, computed a garbage element size and panicked the compiler
		// with "alloc: implausible size". Name the type instead.
		push(cctx.compileErrors, "undefined: " | typeExprName(ex.Elem))
		return nil
	}
	return nil
}

func tcResolveInterfaceInline(e *syntax.InterfaceType, scope *Scope) (t *TCInterface) {
	var methods []*IfaceMethod
	var embeds []Type
	for _, f := range e.MethodList {
		if f.Name == nil {
			typ := tcResolveNameInline(f.Type, scope)
			if typ != nil {
				embeds = mxutil.Ensure(embeds, 1)
				push(embeds, typ)
			}
			continue
		}
		ft, ok := f.Type.(*syntax.FuncType)
		if !ok {
			continue
		}
		sig := tcResolveFuncInline(ft, scope)
		if sig != nil {
			methods = mxutil.Ensure(methods, 1)
			push(methods, NewTCIfaceMethod(f.Name.Value, sig))
		}
	}
	iface := NewTCInterface(methods, embeds)
	iface.Complete()
	return iface
}

func tcResolveRecvType(recv *syntax.Field, scope *Scope) (t Type) {
	if recv == nil {
		return nil
	}
	return tcResolveNameInline(recv.Type, scope)
}

func tcResolveFuncInlineWithRecv(ft *syntax.FuncType, recv *syntax.Field, scope *Scope) (s *Signature) {
	if ft == nil {
		return nil
	}
	var recvVar *TCVar
	if recv != nil {
		recvTyp := tcResolveNameInline(recv.Type, scope)
		recvName := ""
		if recv.Name != nil {
			recvName = recv.Name.Value
		}
		recvVar = NewTCVar(nil, recvName, recvTyp)
	}
	params := tcResolveFieldList(ft.ParamList, scope)
	results := tcResolveFieldList(ft.ResultList, scope)
	variadic := false
	if len(ft.ParamList) > 0 {
		lastP := ft.ParamList[len(ft.ParamList)-1]
		if lastP.Type != nil {
			if _, ok := lastP.Type.(*syntax.DotsType); ok {
				variadic = true
			}
		}
	}
	return NewSignature(recvVar, params, results, variadic)
}

func tcResolveFieldList(fields []*syntax.Field, scope *Scope) (t *Tuple) {
	if len(fields) == 0 {
		return nil
	}
	var vars []*TCVar
	for _, f := range fields {
		typ := tcResolveNameInline(f.Type, scope)
		pname := ""
		if f.Name != nil {
			pname = f.Name.Value
		}
		vars = mxutil.Ensure(vars, 1)
		push(vars, NewTCVar(nil, pname, typ))
	}
	return NewTuple(vars...)
}

func tcResolveFuncInline(ft *syntax.FuncType, scope *Scope) (s *Signature) {
	if ft == nil || scope == nil {
		return nil
	}
	var params []*TCVar
	for _, p := range ft.ParamList {
		if p == nil {
			continue
		}
		typ := tcResolveNameInline(p.Type, scope)
		pname := ""
		if p.Name != nil {
			pname = p.Name.Value
		}
		params = mxutil.Ensure(params, 1)
		push(params, NewTCVar(nil, pname, typ))
	}
	var results []*TCVar
	for _, r := range ft.ResultList {
		if r == nil {
			continue
		}
		typ := tcResolveNameInline(r.Type, scope)
		if typ == nil && r.Type != nil {
			if _, ok1 := r.Type.(*syntax.Name); ok1 {
			} else if op, ok2 := r.Type.(*syntax.Operation); ok2 && op.Op == token.Mul && op.Y == nil {
				if _, ok3 := op.X.(*syntax.Name); ok3 {
				} else if _, ok4 := op.X.(*syntax.SelectorExpr); ok4 {
				}
			} else if _, ok5 := r.Type.(*syntax.SelectorExpr); ok5 {
				_ = ok5
			}
		}
		rname := ""
		if r.Name != nil {
			rname = r.Name.Value
		}
		results = mxutil.Ensure(results, 1)
		push(results, NewTCVar(nil, rname, typ))
	}
	variadic := false
	if len(ft.ParamList) > 0 {
		lastP := ft.ParamList[len(ft.ParamList)-1]
		if lastP.Type != nil {
			if _, ok := lastP.Type.(*syntax.DotsType); ok {
				variadic = true
			}
		}
	}
	var pTuple *Tuple
	if len(params) > 0 {
		pTuple = NewTuple(params...)
	}
	var rTuple *Tuple
	if len(results) > 0 {
		rTuple = NewTuple(results...)
	}
	return NewSignature(nil, pTuple, rTuple, variadic)
}
