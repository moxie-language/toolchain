package main

import (
	"math"
	"os"
	"runtime"
	"unsafe"
	"moxielang.dev/pkg/mxutil"
	. "moxielang.dev/pkg/types"
)

// kv is a key-value pair for accumulating cross-function map products.
type emitKV struct{ k, v string }
// emitKVI is a key-int32 pair for accumulating type ID products.
type emitKVI struct{ k string; v int32 }

type irEmitter struct {
	members    []SSAMember // the package's members, built once by emitIR
	segs       []string // accumulated segments; joined in flush()
	segBytes   int32    // diagnostic: total text bytes pushed into segs
	buf        []byte   // assembled output (only during flush/return)
	outFile    *os.File // streaming output; nil = accumulate in buf
	operandBuf []SSAValue // scratch buffer for instrOperands
	spawnWrappers map[string]bool // dedup of emitted spawn $gowrapper functions
	spawnWrapperTexts []string    // compiled spawn wrapper IR, emitted at package tail
	pendSpawnWrappers []string    // per-function accumulator for wrapper IR
	// wasmSpawnTargets/wasmSpawnIndex mirror the package's spawn dispatch
	// table for the package this emitter is compiling.
	wasmSpawnTargets []*wasmSpawnTarget
	wasmSpawnIndex   map[string]int32
	pendKeepIface []Type // fn-arena: interfaces boxed during the current function
	keepIfaceTypes []Type // compile-arena: merged; module-tail llvm.used
	triple     string
	ptrBits    int32
	pkg        *SSAPackage
	valName    map[SSAValue]string
	nextReg    int32
	extDecls   map[string]string
	extGlobals map[string]string
	strConst     []string
	strMap       map[string]int32
	// strLitIndex maps a string CONSTANT VALUE to its .str global, so one literal
	// occurrence is one mutable object and two occurrences of the same text stay
	// two objects. Keyed by the SSA constant, never by its text: content dedup
	// made two unrelated literals share their bytes, so writing through
	// `b := []byte("abc")` changed a `c := []byte("abc")` elsewhere in the
	// program. Legacy's createConst cache uses the same key.
	strLitIndex map[*SSAConst]int32
	strPushCount  int32 // diagnostic: distinct constants pushed into .str
	strStaleCount int32 // diagnostic: memo hits naming another constant's text
	arrConsts    []string // constant array global bodies (compile arena)
	pendArrConsts []string // fn-arena pending, merged by mergeAccumulators
	curFunc    *SSAFunction
	typeIDs      map[string]int32
	typeIDNext   int32
	extTypeIDs   map[string]bool
	localTypeIDs map[string]bool
	allocTypes  map[SSAValue]string
	regTypes    map[string]string
	hoisted     map[SSAValue]bool
	wasmAttrID  int32
	wasmAttrs   [][]string
	blockExitLabel map[int32]string
	nameUsed   map[string]bool
	missingStores map[SSAValue]SSAValue
	globalTypes     map[string]string
	globalDeclTypes map[string]string
	loadToGlobal    map[string]*SSAGlobal
	allocBlock      map[SSAValue]int32
	storedTo        map[string]bool
	usedAs          map[string]bool
	// Per-function indexes for emitAlloc's field-layout inference.
	// inferAllocTypeFromFieldAddrs used to scan every instruction of the
	// function for every field address of every alloc it was asked about -
	// O(instructions^3) - and each iteration called SSAName/llvmType, whose
	// string results are copies. strconv.initPow10, one block with a table
	// initialiser, turned that into 2 GB. Built once per function instead; the
	// scan ORDER is unchanged, so the inference is identical.
	faByBase   map[string][]*SSAFieldAddr
	mulByBase  map[string][]string
	devByAddr  map[string][]*SSAStore
	ldByName   map[string][]*SSAUnOp
	deferList  []*SSADefer
	deferID    int32
	deferFrame string    // deferFrame alloca reg for functions with defers
	deferLanding string  // landing pad label
	deferCheckpointOn bool
	noCheckpoint bool // suppress per-call checkpoints inside a lowered dispatch
	// fingerprintOnly marks an emitter built only to measure a package's
	// interface dispatch arms for its cache key (see pkgDispFingerprint). The
	// measurement calls the same arm scan emission uses, and that scan registers
	// the type descriptors of the impls it walks; registering them from a
	// measurement would leak a set computed for a package that is about to be
	// taken from the cache into the module the build actually emits. In this
	// mode the collectors record nothing.
	fingerprintOnly bool
	blockDead  bool
	currentEmitBlock *SSABasicBlock
	sretType    string
	pendingPhiTruncs []phiTrunc
	// Per-function accumulators for cross-function state.
	// Written during function emission, merged by caller after flush.
	// All accumulator contents die with the function arena.
	pendExtDecls      []emitKV
	pendExtGlobals    []emitKV
	pendStrConsts     []string
	pendTypeIDs       []emitKVI
	pendLocalTypeIDs  []string
	pendGlobalDeclTypes []emitKV
	pendWasmAttrs     [][]string
	definedSyms   []string // symbols that got `define` in this package
	// accOut accumulates flushed buffers when outFile is nil (non-streaming
	// mode). Lives in the compile arena - survives per-function resets.
	accOut []byte
	// Arena codec state (compileArena lifetime)
	arenaActive   bool
	arenaBorrowed bool       // true when method borrows receiver's sovereign arena
	stableReg     bool       // true when this frame registered the receiver's arena as stable
	sovereignGroupReg   string // LLVM register holding the receiver's sovGroup
	parentArenaReg      string // LLVM register holding the caller's arena for restore
	initArenaNum        int32  // register number holding an initialiser's saved arena (0 = none)
	sovereignTypes map[string]bool // lazy-init: which named types are sovereign
	typeCache     map[Type]string
	pendTypeDescs     map[string]Type
	emittedPkgpaths   map[string]bool
	emittedTails      []string
	compileArena      *runtime.Arena
	tailRecursive    bool
	tailReturnBlocks map[int32]*SSACall
	tailCalls        map[*SSACall]bool
}

type phiTrunc struct {
	rawReg string
	dstReg string
	from   string
	to     string
}

func newIREmitter(pkg *SSAPackage, triple string, srcLen int32) (p *irEmitter) {
	// A nil package is allowed: the dispatch fingerprint measurement builds an
	// emitter with no package, because it measures the arm set for method names
	// scanned out of the source rather than for a package's own call sites.
	// The package's field-access scan (findIfaceImpls) reads e.pkg.Pkg.Scope
	// unconditionally, so the stand-in carries a real empty TCPackage with an
	// empty scope - a bare SSAPackage left Pkg nil and the measurement
	// segfaulted inside findIfaceImpls on the first package that called a
	// method (measured: main).
	if pkg == nil {
		pkg = &SSAPackage{Pkg: NewTCPackage("", ""), Members: map[string]SSAMember{}}
	}
	ptrBits := 64
	if len(triple) >= 4 && triple[:4] == "wasm" {
		ptrBits = 32
	}
	return &irEmitter{
		segs:     []string{:0:1024},
		triple:   triple,
		ptrBits:  ptrBits,
		pkg:      pkg,
		wasmSpawnTargets: pkg.wasmSpawnTargets,
		wasmSpawnIndex:   pkg.wasmSpawnIndex,
		valName:  map[SSAValue]string{},
		extDecls:     map[string]string{},
		extGlobals:   map[string]string{},
		strMap:       map[string]int32{},
		strLitIndex: map[*SSAConst]int32{},
		typeIDs:      map[string]int32{},
		localTypeIDs: map[string]bool{},
		globalDeclTypes:   map[string]string{},
		allocTypes: map[SSAValue]string{},
		regTypes:   map[string]string{},
		blockExitLabel: map[int32]string{},
		nameUsed:   map[string]bool{},
		compileArena: runtime.CurrentArena(),
		sovereignTypes: map[string]bool{},
		typeCache:      map[Type]string{},
		spawnWrappers: map[string]bool{},
		wasmAttrID: 99,
	}
}

func (e *irEmitter) w(s string) {
	if e.deferCheckpointOn && !e.noCheckpoint && e.deferFrame != "" && (mxutil.HasPrefix(s, "  call ") || (len(s) >= 8 && mxutil.HasPrefix(s, "  %") && segHasCall(s))) {
		e.emitCallCheckpoint()
	}
	push(e.segs, s)
	e.segBytes += int32(len(s))
	// Fork C: the emit's own growth inside one member. `(*irEmitter).emitBinOp`
	// leaves the body build at 17MB and reaches 305MB by the end of its emit,
	// and the stalled run never reaches its EAFU line, so this profile is the
	// only way to see which of the emitter's accumulators holds those 288MB.
	if len(e.segs)%8192 == 0 {
		cnts, _ := runtime.AllocHistogram()
		hc := ""
		for bi := int32(5); bi <= 12; bi++ {
			hc = hc | " " | mxutil.SimpleItoa(bi) | ":" | mxutil.SimpleItoa(int32(cnts[bi]))
		}
		// The three most frequent EXACT allocation sizes so far, which is what
		// identifies the ~1KB-per-fragment scratch inside one coarse bin.
		lim := uint32(0xffffff)
		top := ""
		for rank := int32(0); rank < 3; rank++ {
			bs := int32(0)
			bc := uint32(0)
			for n := int32(1); n <= 192; n++ {
				c := runtime.FineAllocAt(n)
				if c <= lim && c > bc {
					bc = c
					bs = n
				}
			}
			if bc == 0 {
				break
			}
			top = top | " " | mxutil.SimpleItoa(bs) | ":" | mxutil.SimpleItoa(int32(bc))
			lim = bc - 1
		}
		mxutil.WriteStr(2, "    W segs="|mxutil.SimpleItoa(int32(len(e.segs)))|" text="|mxutil.SimpleItoa(e.segBytes>>10)|"KB farena="|mxutil.SimpleItoa(int32(runtime.ArenaUsed(runtime.CurrentArena())>>20))|"MB vn="|mxutil.SimpleItoa(int32(len(e.valName)))|" rt="|mxutil.SimpleItoa(int32(len(e.regTypes)))|" at="|mxutil.SimpleItoa(int32(len(e.allocTypes)))|" tc="|mxutil.SimpleItoa(int32(len(e.typeCache)))|" st="|mxutil.SimpleItoa(int32(len(e.storedTo)))|" ua="|mxutil.SimpleItoa(int32(len(e.usedAs)))|" ln="|mxutil.SimpleItoa(int32(len(e.ldByName)))|" dv="|mxutil.SimpleItoa(int32(len(e.devByAddr)))|" fb="|mxutil.SimpleItoa(int32(len(e.faByBase)))|" ho="|mxutil.SimpleItoa(int32(len(e.hoisted)))|" hb="|mxutil.SimpleItoa(int32(len(e.blockExitLabel)))|" cnt"|hc|" top"|top|"\n")
	}
}

// appendEmitKV grows the pending-extern-decl accumulator explicitly
// (no auto-grow) and pushes one entry.
func (e *irEmitter) appendEmitKV(kv emitKV) {
	push(e.pendExtDecls, kv)
}

// appendEmitKVPend grows the pending-extern-global accumulator explicitly.
func (e *irEmitter) appendEmitKVPend(kv emitKV) {
	push(e.pendExtGlobals, kv)
}

// segHasCall reports whether an IR segment contains " = call ".
func segHasCall(s string) (ok bool) {
	for i := 0; i+7 <= len(s); i++ {
		if s[i] == ' ' && s[i+1] == '=' && s[i+2] == ' ' && s[i+3] == 'c' && s[i+4] == 'a' && s[i+5] == 'l' && s[i+6] == 'l' && s[i+7] == ' ' {
			return true
		}
	}
	return false
}

// emitCallCheckpoint emits the setjmp-like checkpoint before a call in a
// function with a defer frame. Mirrors legacy createCheckpoint (x86_64):
// stores the PC just past the asm into the frame's JumpPC slot. Returns 0 on
// normal flow; after a longjmp the return value is non-zero and control
// branches to the landing pad.
func (e *irEmitter) emitCallCheckpoint() {
	if !e.deferCheckpointOn || e.deferFrame == "" {
		return
	}
	e.deferCheckpointOn = false
	e.nextReg++
	ck := "%ckpt" | irItoa(e.nextReg)
	e.nextReg++
	eq := "%ckp" | irItoa(e.nextReg)
	cont := "ck.cont" | irItoa(e.nextReg)
	if e.ptrBits == 32 {
		// wasm32: there is no resume PC to record. moxie_longjmp_arch traps
		// rather than jumping, so the checkpoint only ever returns 0 and the
		// landing branch is unreachable. Calling a runtime helper keeps the
		// x86 register-constraint asm out of the module, where clang cannot
		// allocate {rax} and refuses to compile it at all.
		e.w("  ") ; e.w(ck) ; e.w(" = call i64 @runtime.moxie_longjmp_checkpoint(ptr ") ; e.w(e.deferFrame) ; e.w(")\n")
		e.declareRuntime("runtime.moxie_longjmp_checkpoint", "i64", "ptr")
	} else {
		e.w("  ") ; e.w(ck) ; e.w(` = call i64 asm sideeffect "leaq 1f(%rip), %rax\0Amovq %rax, 8($1)\0Axorq %rax, %rax\0A1:", "={rax},{rbx},~{rbx},~{rcx},~{rdx},~{rsi},~{rdi},~{rbp},~{r8},~{r9},~{r10},~{r11},~{r12},~{r13},~{r14},~{r15},~{xmm0},~{xmm1},~{xmm2},~{xmm3},~{xmm4},~{xmm5},~{xmm6},~{xmm7},~{xmm8},~{xmm9},~{xmm10},~{xmm11},~{xmm12},~{xmm13},~{xmm14},~{xmm15},~{fpsr},~{fpcr},~{flags},~{dirflag},~{memory}"(ptr `) ; e.w(e.deferFrame) ; e.w(")\n")
	}
	e.w("  ") ; e.w(eq) ; e.w(" = icmp eq i64 ") ; e.w(ck) ; e.w(", 0\n")
	e.w("  br i1 ") ; e.w(eq) ; e.w(", label %") ; e.w(cont) ; e.w(", label %") ; e.w(e.deferLanding) ; e.w("\n")
	e.w(cont) ; e.w(":\n")
	// The block's exit is now the continuation, not its header: PHI nodes in
	// successor blocks must reference the continuation label.
	if e.currentEmitBlock != nil {
		e.blockExitLabel[e.currentEmitBlock.Index] = "%" | cont
	}
	e.deferCheckpointOn = true
}

// assembleSegs joins all segments into e.buf in one allocation.
// After this, e.segs is reset and e.buf holds the assembled output.
func (e *irEmitter) assembleSegs() {
	n := int32(0)
	for _, s := range e.segs {
		n += len(s)
	}
	e.buf = []byte{:n}
	off := int32(0)
	for _, s := range e.segs {
		for j := int32(0); j < len(s); j++ {
			e.buf[off+j] = s[j]
		}
		off += len(s)
	}
	e.segs = resize(e.segs, 0)
}

// flush assembles segments, writes to output file, resets.
func (e *irEmitter) flush() {
	e.assembleSegs()
	if e.outFile != nil && len(e.buf) > 0 {
		n, werr := e.outFile.Write(e.buf)
		if werr != nil || n != len(e.buf) {
			mxutil.WriteStr(2, "DBG flush write n=" | ssaItoa(n) | " want=" | ssaItoa(len(e.buf)) | " err=" | werr.Error() | "\n")
		}
	} else if e.outFile == nil && len(e.buf) > 0 {
		cur := len(e.accOut)
		need := cur + len(e.buf)
		if need > cap(e.accOut) {
			nc := cap(e.accOut) * 2
			if nc < need {
				nc = need
			}
			if nc < 4096 {
				nc = 4096
			}
			// accOut must outlive the per-function arena resets:
			// allocate the new backing array in the compile arena.
			fnArena := runtime.CurrentArena()
			runtime.SetCurrentArena(e.compileArena)
			nb := []byte{:cur:nc}
			copy(nb, e.accOut)
			runtime.SetCurrentArena(fnArena)
			e.accOut = nb
		}
		e.accOut = resize(e.accOut, need)
		mxutil.CopyRange(e.accOut, cur, e.buf, 0, need-cur)
	}
	e.buf = nil
}

// flushDedup assembles segments, deduplicates declare lines, writes to file.
func (e *irEmitter) flushDedup() {
	e.assembleSegs()
	if e.outFile == nil || len(e.buf) == 0 {
		e.buf = nil
		return
	}
	// Scan for declare lines and remove duplicates.
	var seen []string
	out := []byte{:0:len(e.buf)}
	ls := int32(0)
	n := int32(len(e.buf))
	for ls < n {
		le := ls
		for le < n && e.buf[le] != '\n' {
			le++
		}
		if le < n {
			le++
		}
		line := string(e.buf[ls:le])
		// Dedup declare lines.
		isDeclare := len(line) > 8 && line[0] == 'd' && line[1] == 'e' && line[2] == 'c' && line[3] == 'l' && line[4] == 'a' && line[5] == 'r' && line[6] == 'e' && line[7] == ' '
		// Dedup define lines (for per-type fixup functions).
		isDefine := len(line) > 7 && line[0] == 'd' && line[1] == 'e' && line[2] == 'f' && line[3] == 'i' && line[4] == 'n' && line[5] == 'e' && line[6] == ' '
		// Dedup type descriptor globals (linkonce_odr constants).
		isDesc := len(line) > 22 && line[0] == '@' && line[1] == '"' && line[2] == 'r' && line[3] == 'e' && line[4] == 'f' && line[5] == 'l' && line[6] == 'e' && line[7] == 'c' && line[8] == 't' && line[9] == '/' && line[10] == 't' && line[11] == 'y' && line[12] == 'p' && line[13] == 'e' && line[14] == 's' && line[15] == '.'
		if isDeclare || isDefine || isDesc {
			dup := false
			lineName := line
			if isDesc {
				nameEnd := int32(0)
				for bi := int32(0); bi < len(line); bi++ {
					if line[bi] == ' ' {
						nameEnd = bi
						break
					}
				}
				if nameEnd > 0 {
					lineName = string(line[:nameEnd])
				}
			}
			for si := int32(0); si < len(seen); si++ {
				s := seen[si]
				if len(s) == len(lineName) {
					match := true
					for bi := int32(0); bi < len(s); bi++ {
						if s[bi] != lineName[bi] {
							match = false
							break
						}
					}
					if match {
						dup = true
						break
					}
				}
			}
			if dup {
				if isDefine {
					// Skip entire function body until closing }.
					for ls < n {
						if e.buf[ls] == '}' {
							ls++
							if ls < n && e.buf[ls] == '\n' {
								ls++
							}
							break
						}
						ls++
					}
				} else {
					ls = le
				}
				continue
			}
			push(seen, lineName)
		}
		for j := ls; j < le; j++ {
			push(out, e.buf[j])
		}
		ls = le
	}
	e.outFile.Write(out)
	e.buf = nil
}

// hoistAllocaText assembles segments from start onward, moves alloca lines
// to _entry top, stores result as single segment. Segments before start
// are left intact (parent function already processed).
func (e *irEmitter) hoistAllocaText(start int32) {
	// Assemble only segments from start to end.
	n := int32(0)
	for i := start; i < int32(len(e.segs)); i++ {
		n += len(e.segs[i])
	}
	body := []byte{:n}
	off := int32(0)
	for i := start; i < int32(len(e.segs)); i++ {
		s := e.segs[i]
		for j := int32(0); j < len(s); j++ {
			body[off+j] = s[j]
		}
		off += len(s)
	}
	e.segs = resize(e.segs, start)
	marker := "bb.entry:\n"
	mlen := int32(len(marker))
	insert := int32(-1)
	for i := int32(0); i+mlen <= int32(len(body)); i++ {
		match := true
		for k := int32(0); k < mlen; k++ {
			if body[i+k] != marker[k] {
				match = false
				break
			}
		}
		if match && (i == 0 || body[i-1] == '\n') {
			insert = i + mlen
			break
		}
	}
	if insert < 0 {
		push(e.segs, string(body))
		return
	}
	// Pass 1: count alloca bytes vs rest bytes.
	blen := int32(len(body))
	allocaBytes := int32(0)
	moved := false
	ls := insert
	for ls < blen {
		le := ls
		for le < blen && body[le] != '\n' {
			le++
		}
		if le < blen {
			le++
		}
		lineLen := le - ls
		if lineLen > 13 && body[ls] == ' ' && body[ls+1] == ' ' && body[ls+2] == '%' {
			for k := ls + 3; k+10 <= le; k++ {
				if body[k] == ' ' && body[k+1] == '=' && body[k+2] == ' ' &&
					body[k+3] == 'a' && body[k+4] == 'l' && body[k+5] == 'l' &&
					body[k+6] == 'o' && body[k+7] == 'c' && body[k+8] == 'a' &&
					body[k+9] == ' ' {
					allocaBytes += lineLen
					moved = true
					break
				}
			}
		}
		ls = le
	}
	if !moved {
		push(e.segs, string(body))
		return
	}
	// Pass 2: build output - prefix, then allocas, then rest.
	out := []byte{:int32(len(body))}
	for i := int32(0); i < insert; i++ {
		out[i] = body[i]
	}
	wp := insert                      // write pointer for allocas
	wr := insert + allocaBytes        // write pointer for rest
	ls = insert
	for ls < blen {
		le := ls
		for le < blen && body[le] != '\n' {
			le++
		}
		if le < blen {
			le++
		}
		lineLen := le - ls
		isAlloca := false
		if lineLen > 13 && body[ls] == ' ' && body[ls+1] == ' ' && body[ls+2] == '%' {
			for k := ls + 3; k+10 <= le; k++ {
				if body[k] == ' ' && body[k+1] == '=' && body[k+2] == ' ' &&
					body[k+3] == 'a' && body[k+4] == 'l' && body[k+5] == 'l' &&
					body[k+6] == 'o' && body[k+7] == 'c' && body[k+8] == 'a' &&
					body[k+9] == ' ' {
					isAlloca = true
					break
				}
			}
		}
		if isAlloca {
			for j := int32(0); j < lineLen; j++ {
				out[wp+j] = body[ls+j]
			}
			wp += lineLen
		} else {
			for j := int32(0); j < lineLen; j++ {
				out[wr+j] = body[ls+j]
			}
			wr += lineLen
		}
		ls = le
	}
	push(e.segs, string(out))
}

func (e *irEmitter) regName(v SSAValue) (s string) {
	if v == nil {
		e.nextReg++
		return "%r" | irItoa(e.nextReg)
	}
	if nm, ok := e.valName[v]; ok {
		return nm
	}
	name := safeSSAName(v)
	if name == "" {
		e.nextReg++
		name = "r" | irItoa(e.nextReg)
	}
	n := "%" | name
	for e.nameUsed[n] {
		e.nextReg++
		n = "%r" | irItoa(e.nextReg)
	}
	e.valName[v] = n
	e.nameUsed[n] = true
	return n
}

func (e *irEmitter) setRegType(v SSAValue, reg string, typ string) {
	e.allocTypes[v] = typ
	if len(reg) > 0 && reg[0] == '%' {
		e.regTypes[reg] = typ
	}
}

func (e *irEmitter) nextReg2(prefix string) (s string) {
	e.nextReg++
	return "%" | prefix | irItoa(e.nextReg)
}

func (e *irEmitter) declareRuntime(name, retType, params string) {
	if params != "" {
		params = params | ", ptr"
	} else {
		params = "ptr"
	}
	e.appendEmitKV(emitKV{name, retType | " @" | name | "(" | params | ")"})
}


func (e *irEmitter) declareIntrinsic(name, retType, params string) {
	e.appendEmitKV(emitKV{name, retType | " @" | name | "(" | params | ")"})
}

// emitZeroInit zero-fills the memory at reg (a pointer to at) using
// llvm.memset. A single aggregate `store zeroinitializer` is expanded by
// the backend into one store per 8 bytes; for large arrays that is
// thousands of instructions, whereas memset lowers to a loop/rep stosb.
func (e *irEmitter) emitZeroInit(reg, at string) {
	ipt := e.intptrType()
	fn := "llvm.memset.p0." | ipt
	e.nextReg++
	sz := "%zi" | irItoa(e.nextReg)
	e.w("  ") ; e.w(sz) ; e.w(" = ptrtoint ptr getelementptr (") ; e.w(at) ; e.w(", ptr null, i32 1) to ") ; e.w(ipt) ; e.w("\n")
	e.w("  call void @") ; e.w(fn) ; e.w("(ptr ") ; e.w(reg) ; e.w(", i8 0, ") ; e.w(ipt) ; e.w(" ") ; e.w(sz) ; e.w(", i1 false)\n")
	e.declareIntrinsic(fn, "void", "ptr, i8, " | ipt | ", i1")
}


func (e *irEmitter) declareExternalGlobal(g *SSAGlobal) {
	if g.pkg == nil || g.pkg == e.pkg {
		return
	}
	name := e.globalName(g)
	if _, ok := e.extGlobals[name]; ok {
		return
	}
	for _, p := range e.pendExtGlobals {
		if p.k == name { return }
	}
	typ := e.llvmType(g.typ)
	if p, ok := SafeUnderlying(g.typ).(*Pointer); ok {
		if p.Base != nil {
			typ = e.llvmType(p.Base)
		} else {
			typ = "ptr"
		}
	}
	if typ == "void" {
		typ = "i1"
	}
	e.appendEmitKVPend(emitKV{name, typ})
}

// externDropsCtx reports whether a call to fn omits the hidden context
// argument, which is the C ABI rule for an exported symbol. The CALL site
// decides this from fn.externalSymbol; the declaration must decide it the same
// way, and it did not, so one symbol could carry two signatures:
//
//	declare i64 @strlen(ptr, ptr)      ; in the runtime package's IR
//	call    i64 @strlen(ptr nonnull)   ; at every call site
//
// Native links are quiet about it because libc defines strlen and the
// declaration is only a name. wasm-ld compares the definition it synthesises
// from that declaration against the calls and replaces every mismatched callee
// with a three-byte trap named `signature_mismatch:strlen` - which is how
// encoding/asn1 died on wasm (round 332). The name is looked up in the export
// map as well as on the function because the declaration is sometimes emitted
// from a function object built before the map was consulted.
func (e *irEmitter) externDropsCtx(fn *SSAFunction) (ok bool) {
	if fn == nil {
		return false
	}
	if fn.externalSymbol != "" {
		return true
	}
	if cctx.compileExportMap == nil {
		return false
	}
	if _, hit := cctx.compileExportMap[fn.name]; hit {
		return true
	}
	// The declaration is also emitted for a synthetic function built from the
	// symbol alone, whose "name" is the mangled symbol rather than the source
	// name, so the exported NAME is matched too.
	sym := e.funcSymbol(fn)
	if len(sym) > 0 && sym[0] == '@' {
		sym = sym[1:]
	}
	if len(sym) >= 2 && sym[0] == '"' && sym[len(sym)-1] == '"' {
		sym = sym[1 : len(sym)-1]
	}
	for k, v := range cctx.compileExportMap {
		_ = k
		if v == sym {
			return true
		}
	}
	return false
}

func (e *irEmitter) declareExternalFunc(fn *SSAFunction) {
	if fn == nil || len(fn.Blocks) > 0 {
		return
	}
	sym := e.funcSymbol(fn)
	if _, ok := e.extDecls[sym]; ok {
		return
	}
	for _, p := range e.pendExtDecls {
		if p.k == sym { return }
	}
	retType := e.funcRetType(fn)
	useSret := needsSret(retType)
	isIntrinsic := mxutil.HasPrefix(sym, "@llvm.") || mxutil.HasPrefix(sym, "@\"llvm.")
	isExport := e.externDropsCtx(fn)
	skipCtx := isIntrinsic || isExport
	params := ""
	if useSret {
		params = "ptr"
	}
	var psegs []string
	if params != "" {
		push(psegs, params)
	}
	hasRecv := fn.Signature != nil && fn.Signature.Recv != nil
	if hasRecv {
		push(psegs, "ptr")
	}
	if fn.Signature != nil && fn.Signature.Params != nil {
		for i := 0; i < fn.Signature.Params.Len(); i++ {
			pt := e.llvmType(fn.Signature.Params.At(i).Typ)
			if pt == "" || pt == "void" {
				mxutil.WriteStr(2, "BUG-DECL: empty param type in " | sym | " param " | irItoa(int32(i)) | "\n")
				pt = "ptr"
			}
			push(psegs, pt)
		}
	}
	if !skipCtx {
		push(psegs, "ptr")
	}
	params = joinStrs(commaSep(psegs))
	if useSret {
		e.appendEmitKV(emitKV{sym, "void " | sym | "(" | params | ")"})
	} else {
		e.appendEmitKV(emitKV{sym, retType | " " | sym | "(" | params | ")"})
	}
}

func (e *irEmitter) addStringConst(s string) (n int32) {
	if existing, ok := e.strMap[s]; ok {
		return existing
	}
	// Check pending list (not yet merged).
	base := len(e.strConst)
	for i, ps := range e.pendStrConsts {
		if ps == s {
			return int32(base + i)
		}
	}
	idx := int32(base + len(e.pendStrConsts))
	push(e.pendStrConsts, s)
	return idx
}

// stringConstOperand is the LLVM operand for a string CONSTANT VALUE and its
// global. One constant value is one object; a second occurrence of the same
// text is a second object. addStringConst is not used here because it folds
// equal text together, which made two unrelated literals the same mutable bytes.
//
// Only the INDEX is memoised. The operand text is rebuilt per call because it is
// assembled with `|` in whatever arena is current, which during function emit is
// the fn arena: caching the text handed later functions a header whose bytes the
// flush had already reclaimed.
func (e *irEmitter) stringConstOperand(c *SSAConst, s string) (txt string) {
	idx, ok := e.strLitIndex[c]
	if !ok {
		idx = int32(len(e.strConst) + len(e.pendStrConsts))
		push(e.pendStrConsts, s)
		e.strLitIndex[c] = idx
		e.strPushCount++
		if e.strPushCount%20000 == 0 {
			mxutil.WriteStr(2, "  STRPUSH n=" | mxutil.SimpleItoa(e.strPushCount) | " pend=" | mxutil.SimpleItoa(int32(len(e.pendStrConsts))) | " strconst=" | mxutil.SimpleItoa(int32(len(e.strConst))) | "\n")
		}
	} else if have, ok2 := e.strConstTextAt(idx); ok2 && have != s {
		// A memo hit whose index no longer names this constant's own text is
		// the stale-key defect: the SSAConst pointer was reused after the arena
		// that held the first one was reset.
		e.strStaleCount++
		if e.strStaleCount < 8 || e.strStaleCount%4096 == 0 {
			mxutil.WriteStr(2, "  STRSTALE n=" | mxutil.SimpleItoa(e.strStaleCount) | " idx=" | irItoa(idx) | " want=[" | s | "] have=[" | have | "]\n")
		}
	}
	ipt := e.intptrType()
	slen := irItoa64(int64(len(s)))
	return "{ ptr " | e.strConstGlobal(idx) | ", " | ipt | " " | slen | ", " | ipt | " " | slen | " }"
}

func (e *irEmitter) strConstGlobal(idx int32) (s string) {
	return "@.str." | irItoa(idx)
}

// strConstTextAt reads back the text a .str index names right now: below
// len(strConst) it is a merged entry, above it a pending one. Used only by the
// stale-key diagnostic in stringConstOperand.
func (e *irEmitter) strConstTextAt(idx int32) (s string, ok bool) {
	if idx < 0 {
		return s, false
	}
	if idx < int32(len(e.strConst)) {
		return e.strConst[idx], true
	}
	j := idx - int32(len(e.strConst))
	if j < int32(len(e.pendStrConsts)) {
		return e.pendStrConsts[j], true
	}
	return s, false
}

func (e *irEmitter) resolveAllNamedTypes() {
	if e.pkg == nil || e.pkg.Pkg == nil || e.pkg.Pkg.Scope == nil {
		return
	}
	scope := e.pkg.Pkg.Scope
	for _, name := range scope.Names() {
		obj := scope.Lookup(name)
		if obj == nil {
			continue
		}
		tn, ok := obj.(*TypeName)
		if !ok || tn == nil {
			continue
		}
		named, ok2 := tn.Typ.(*Named)
		if !ok2 || named == nil {
			continue
		}
		if named.Under != nil {
			continue
		}
		u := SafeUnderlying(named)
		if u != nil && u != Type(named) {
			named.Under = u
		}
	}
}

// emitAllFunctions builds and flushes every function body into e.
//
// This is a FREE function on purpose. `emit` is a method of a self-mutating
// type, so its own frame is live for the whole package and a group with a live
// frame is never compacted - nothing the emitter allocates can be reclaimed
// while `emit` runs. From here each `e.emitFunction(m)` borrows and pops at its
// return, so between two functions the group has no live frame and
// SovDrainCompactions can reclaim the per-instruction scratch. Measured before
// this: ~1.6 MB retained per IR instruction, and `mxregexp` alone reached 2.9 GB
// inside one package's emit.
// emitNextMemberName returns the lexicographically smallest member of e that is
// an SSA function and has not been emitted yet, or "" when none is left.
//
// A free function, for the same reason emitAllFunctions is: it runs between two
// body builds, and a method frame would keep the emitter's sovereign group live
// across the boundary where it is compacted.
func emitNextMemberName(e *irEmitter, emitted map[string]bool) (name string) {
	for k, m := range e.pkg.Members {
		if emitted[k] {
			continue
		}
		if _, ok := m.(*SSAFunction); !ok {
			continue
		}
		if name == "" || k < name {
			name = k
		}
	}
	return name
}

// ssaValTag names the concrete kind of an SSA value for MX_EMIT_TRACE.
func ssaValTag(v SSAValue) (s string) {
	switch v.(type) {
	case *SSAConst:
		return "const"
	case *SSAGlobal:
		return "global"
	case *SSAFunction:
		return "func"
	case *ssaRegister:
		return "reg"
	case *SSAParameter:
		return "param"
	case *SSAFreeVar:
		return "free"
	case *SSABuiltin:
		return "builtin"
	}
	return "other"
}

// emitBuiltMember emits one member whose body already exists and lives in the
// CURRENT arena, clearing the per-function scratch afterwards. Monomorphised
// clones are built while another member is being built, so their bodies belong
// to that member's arena and must be emitted before it is reset.
func emitBuiltMember(e *irEmitter, fn *SSAFunction) {
	// strLitIndex is keyed by the SSA constant, and it belongs with the
	// accumulators cleared at the end of this function for exactly their
	// reason: the body, and so the SSAConst objects it is built from, live in
	// the per-function arena the caller resets after this returns. Keeping one
	// map across members made a later member's constant - allocated at a freed
	// body's address - hit the dead pointer's entry, so the operand took the
	// right length from its own constant and a foreign address from the stale
	// index: `cmd == "build"` compiled to a five-byte compare against an
	// unrelated IR-template literal, and the stage4-built compiler did not
	// recognise its own argv.
	//
	// It is made fresh HERE rather than with the resets at the end because the
	// map must belong to the arena of the member that uses it: one created at
	// the end of the previous member is freed by that member's ArenaReset
	// before this member's first constant looks it up (measured: SIGSEGV in
	// (*parser).parseAtom's emit).
	e.strLitIndex = map[*SSAConst]int32{}
	emitFunctionOf(e, fn)
	emitAnonFuncsOf(e, fn)
	e.flush()
	e.segs = nil
	e.segBytes = 0
	e.buf = nil
	e.operandBuf = nil
	e.valName = nil
	e.nameUsed = map[string]bool{}
	e.allocTypes = nil
	e.regTypes = nil
	e.blockExitLabel = nil
	e.typeCache = nil
	e.hoisted = nil
	e.pendingPhiTruncs = nil
	e.deferList = nil
	e.allocBlock = nil
	e.storedTo = nil
	e.usedAs = nil
	e.faByBase = nil
	e.mulByBase = nil
	e.devByAddr = nil
	e.ldByName = nil
	e.missingStores = nil
	fn.Blocks = nil
	fn.Locals = nil
	fn.Params = nil
	fn.FreeVars = nil
	fn.NamedResults = nil
	fn.vars = nil
}

// emitAllFunctions builds and flushes every function body into e.
//
// One member at a time: the body is built, the checks that read it run, it is
// emitted, and it is dropped - all inside a per-function arena pushed before
// the build. The next member starts from an empty arena. This is the unit Go
// gets from its per-package process and its per-function work list; here the
// arena is the unit, because there is no process per package.
//
// This is a FREE function on purpose. `emit` is a method of a self-mutating
// type, so its own frame is live for the whole package and a group with a live
// frame is never compacted - nothing the emitter allocates can be reclaimed
// while `emit` runs. From here each `e.emitFunction(m)` borrows and pops at its
// return, so between two functions the group has no live frame and
// SovDrainCompactions can reclaim the per-instruction scratch. Measured before
// this: ~1.6 MB retained per IR instruction, and `mxregexp` alone reached 2.9 GB
// inside one package's emit.
func emitAllFunctions(e *irEmitter, compileArena *runtime.Arena) {
	// The floor this package's emit starts from, split into the terms that can
	// be acted on separately: the retained package graphs, the root arena, and
	// whatever is left in the arena ledger (the compile arena and the pool).
	// Without the split, `acap` during emit is one number and the next fix is a
	// guess - which is how "the emit wall" stayed unnamed for two rounds.
	gcap := uint64(0)
	gn := int32(0)
	if cctx.dispTier2Arena != nil {
		for _, ga := range cctx.dispTier2Arena {
			if ga == nil {
				continue
			}
			gn++
			gcap += runtime.ArenaUsed(ga)
		}
	}
	rnreg, rbytes := runtime.ArenaRootUsage()
	cau, cac := uint64(0), uint64(0)
	if cctx.compileArena != nil {
		cau = runtime.ArenaUsed(cctx.compileArena)
		cac = runtime.ArenaCap(cctx.compileArena)
	}
	mxutil.WriteStr(2, "    EAF0 enter n="|mxutil.SimpleItoa(int32(len(e.members)))|" rss="|mxutil.SimpleItoa(int32(rssKB()/1024))|"MB acap="|mxutil.SimpleItoa(int32(runtime.LiveArenaCap()>>20))|"MB cau="|mxutil.SimpleItoa(int32(cau>>20))|"MB cac="|mxutil.SimpleItoa(int32(cac>>20))|"MB graphs="|mxutil.SimpleItoa(gn)|"/"|mxutil.SimpleItoa(int32(gcap>>20))|"MB root="|mxutil.SimpleItoa(int32(rnreg))|"/"|mxutil.SimpleItoa(int32(rbytes>>20))|"MB\n")
	// The floor's composition with names. `acap` is a total; this list says
	// which arenas make it up, so "the emit floor is 490MB" becomes "the
	// compile arena holds X of it" and the next fix has a target.
	mxutil.WriteStr(2, "    EAF0top\n"|string(runtime.LiveArenaTop(12)))
	mxutil.WriteStr(2, "    EAF0cen "|string(runtime.LiveArenaCensus()))
	// The same floor, but by ALLOCATION SIZE: everything of 64KiB or more that
	// typecheck + SSA asked for in this package, with its scope. A large `mb=`
	// with a large `n=` is an allocation VOLUME defect; a single big `size=` is
	// one buffer that could be presized. The two have different fixes.
	mxutil.WriteStr(2, "    EAF0big\n"|string(runtime.BigAllocReport()))
	// Which generic packages are being retained, and is their last use still
	// ahead of this package? A retained graph whose last instantiation point has
	// passed is 100MB of permanent arena held for nothing; one whose last use is
	// ahead is the price of generics and no release can touch it at this point.
	genN := int32(0)
	for gn2, _ := range cctx.genericPkgScopes {
		if genN >= 8 {
			break
		}
		genN++
		lu, ok := cctx.dispLastUse[gn2]
		if !ok {
			lu = -1
		}
		mxutil.WriteStr(2, "    EAF0gen pkg="|gn2|" lastuse="|mxutil.SimpleItoa(lu)|" cur="|mxutil.SimpleItoa(cctx.curPkgIdx)|"\n")
	}
	runtime.ResetBigAllocs()
	prevFnScope := runtime.SetArenaScope(43)
	fnArena := runtime.ArenaNew(8 * 1024 * 1024)
	runtime.SetArenaScope(prevFnScope)
	mxutil.WriteStr(2, "    EAF0 arena ok\n")
	nf := int32(0)
	emitted := map[string]bool{}
	uP3Prev := uint64(0)
	// The loop covers every function member, not only the ones with a declared
	// body: a bodyless member still needs its `declare`. A member whose body is
	// planned is built here; one that arrived already built (a monomorphised
	// clone) is emitted in the same arena that built it, below.
	for {
		// The selection ranges the member map, and a range over a map calls
		// hashmapNext, whose first call allocates a sorted buffer of every key
		// (keySize*n). Run it INSIDE the member arena so that buffer dies with
		// the member: outside it the current arena is the package arena, where
		// the buffer is retained for the life of the package. Measured on
		// `runtime` (866 members): 156MB retained, which is the whole of Step
		// 2's unmet cau clause - the emit floor is 40MB and the EAF lines showed
		// it climbing to 155MB, none of it from the member's own build, checks
		// or emit.
		runtime.ManualArenaEnter(fnArena)
		name := emitNextMemberName(e, emitted)
		runtime.ManualArenaExit(fnArena)
		uI := uint64(0)
		if cctx.compileArena != nil {
			uI = runtime.ArenaUsed(cctx.compileArena)
		}
		if name == "" {
			break
		}
		emitted[name] = true
		uJ := uint64(0)
		if cctx.compileArena != nil {
			uJ = runtime.ArenaUsed(cctx.compileArena)
		}
		fn := e.pkg.Func(name)
		if fn == nil {
			continue
		}
		// Fork C: split the loop-back from the previous member's tail print.
		uH := uint64(0)
		if cctx.compileArena != nil {
			uH = runtime.ArenaUsed(cctx.compileArena)
		}
		nf++
		tM0 := runtime.NowNano()
		// PUSH the per-function arena, do not just name it current.
		// `alloc` hands out from domainRoot.fnStack[fnTop]; it never reads
		// the SetCurrentArena override, so an earlier pair of SetCurrentArena
		// calls here changed nothing and every emitter allocation went to
		// whatever arena was pushed around the package - the compile arena,
		// or a sovereign borrow. That is why `EAFU used=0MB` printed at the
		// end of every function while the compile arena grew to 536MB on
		// `runtime`: the per-function arena was never on the stack at all.
		runtime.ManualArenaEnter(fnArena)
		// The package arena is registered stable for the duration. The codec's
		// return rule treats only the TOP manual arena as stable, so with the
		// function arena current a type living in the package arena came back
		// from every resolution deep-copied - and a `[]T` parameter and a `[]T`
		// result of ONE signature then held two different Named objects.
		// This is a statement of fact, not a guard: the package arena outlives
		// the body, and saying so is what keeps the type graph one graph.
		runtime.SovereignRegStable(compileArena)
		// The BODY, its checks and its emitted text all live in fnArena now:
		// step 2's unit of work and step 4's unit of reclamation are the same
		// function, which is why they are one push.
		d0 := runtime.FnStackDepth()
		m0 := runtime.ManualFrameDepth()
		cctx.memberArena = fnArena
		// Fork C: the compile arena's fill before this member, so the EAFU line
		// can split the per-member growth into build+checks and emit+merge.
		uA := uint64(0)
		if cctx.compileArena != nil {
			uA = runtime.ArenaUsed(cctx.compileArena)
		}
		mxutil.WriteStr(2, "    PH4 nf="|mxutil.SimpleItoa(nf)|" sel="|mxutil.SimpleItoa64((int64(uI)-int64(uP3Prev))>>10)|"KB mark="|mxutil.SimpleItoa64((int64(uJ)-int64(uI))>>10)|"KB fsel="|mxutil.SimpleItoa64((int64(uH)-int64(uJ))>>10)|"KB enter="|mxutil.SimpleItoa64((int64(uA)-int64(uH))>>10)|"KB\n")
		e.pkg.BuildBody(name)
		// A build opens and closes its own durable scopes; an unbalanced one
		// leaves a package-arena frame on the fn stack, and then the codec sees
		// the wrong phase arena for the rest of the package and deep-copies the
		// body graph (silently: the first symptom is a codec tag desync in an
		// unrelated function). Name it here instead.
		if cur := runtime.CurrentArena(); cur != fnArena {
			d1 := runtime.FnStackDepth()
			m1 := runtime.ManualFrameDepth()
			which := "unknown"
			if cur == nil {
				which = "nil"
			}
			if cctx.compileArena != nil && cur == cctx.compileArena {
				which = "compileArena"
			}
			if cur == runtime.RootArena() {
				which = "rootArena"
			}
			mxutil.WriteStr(2, "  LEAK build left a frame open for " | name | " current=" | which | " used=" | mxutil.SimpleItoa(int32(runtime.ArenaUsed(cur)>>20)) | "MB cap=" | mxutil.SimpleItoa(int32(runtime.ArenaCap(cur)>>20)) | "MB d=" | mxutil.SimpleItoa64(int64(uintptr(unsafe.Pointer(cur))-uintptr(unsafe.Pointer(fnArena)))>>20) | "MB scope=" | mxutil.SimpleItoa(runtime.ArenaScopeOf(cur)) | " depth " | mxutil.SimpleItoa(d0) | "->" | mxutil.SimpleItoa(d1) | " manual " | mxutil.SimpleItoa(m0) | "->" | mxutil.SimpleItoa(m1) | "\n")

			base := uintptr(unsafe.Pointer(fnArena))
			// Which arena is in the slot, named by identity: the scope tag
			// alone cannot tell one 8MB frame arena from another, and the
			// question is whether the slot holds the package arena or a frame.
			if cctx.compileArena != nil {
				b := int64(base)
				ca := (int64(uintptr(unsafe.Pointer(cctx.compileArena))) - b) >> 20
				ea := (int64(uintptr(unsafe.Pointer(e.compileArena))) - b) >> 20
				cu := (int64(uintptr(unsafe.Pointer(cur))) - b) >> 20
				d5 := (int64(runtime.SovereignSlotArena(d0-1)) - b) >> 20
				d6 := (int64(runtime.SovereignSlotArena(d0)) - b) >> 20
				mxutil.WriteStr(2, "    ids cctxCA=" | mxutil.SimpleItoa64(ca) | "MB/" | mxutil.SimpleItoa(runtime.ArenaScopeOf(cctx.compileArena)) | " eCA=" | mxutil.SimpleItoa64(ea) | "MB/" | mxutil.SimpleItoa(runtime.ArenaScopeOf(e.compileArena)) | " cur=" | mxutil.SimpleItoa64(cu) | "MB/" | mxutil.SimpleItoa(runtime.ArenaScopeOf(cur)) | " d5=" | mxutil.SimpleItoa64(d5) | "MB d6=" | mxutil.SimpleItoa64(d6) | "MB\n")
			}
			swN := runtime.CurSwitchCount()
			swK := swN - 24
			if swK < 0 {
				swK = 0
			}
			for k := swK; k < swN; k++ {
				so, sn, sd, sk := runtime.CurSwitchAt(k)
				sc := int32(0)
				if sn != 0 {
					sc = runtime.ArenaScopeOf((*runtime.Arena)(unsafe.Pointer(sn)))
				}
				mxutil.WriteStr(2, "    ev#" | mxutil.SimpleItoa(k) | " k=" | mxutil.SimpleItoa(int32(sk)) | " d=" | mxutil.SimpleItoa(sd) | " old=" | mxutil.SimpleItoa64(int64(so-base)>>20) | "MB new=" | mxutil.SimpleItoa64(int64(sn-base)>>20) | "MB s=" | mxutil.SimpleItoa(sc) | "\n")
			}
		}
		// The global-type scan is per body now: it refines the declared type of
		// a package global from the stores and loads that reach it, and it used
		// to be a whole-package loop that required every body to exist.
		// Fork C: the member arena after the BODY is built, before its checks
		// and its emit. This is the number that says whether a big member's
		// 305MB is the body graph (Step 4/5) or the emitter's scratch.
		fB := uint64(0)
		if fnArena != nil {
			fB = runtime.ArenaUsed(fnArena)
		}
		scanGlobalTypesOf(e, fn)
		// Checks whose subject is this body. They used to run over the whole
		// package after every body existed, which is why all bodies had to
		// exist at once; the package-wide checks (the AST ones) stay in
		// CreatePackage, at declaration granularity.
		checkGlobalMutation(fn)
		checkClosureCaptureOf(e.pkg, fn)
		checkDuplicateCasesOf(e.pkg, fn)
		if mxutil.TargetArch() == "wasm" {
			scanWasmSpawnTarget(e.pkg, fn)
		}
		checkUseAfterFree(fn)
		checkParamMutation(fn)
		// The deferred interface-assignment verdict belongs to this body: its
		// recorded values and types were built in this member's arena and do not
		// outlive it. The method sets it needs are complete because
		// CreatePackage recorded every declaration before the first body.
		checkIfaceAssignments()
		cau2, cac2 := uint64(0), uint64(0)
		if cctx.compileArena != nil {
			cau2 = runtime.ArenaUsed(cctx.compileArena)
			cac2 = runtime.ArenaCap(cctx.compileArena)
		}
		cnts, byts := runtime.AllocHistogram()
		hist := ""
		totAlloc := int32(0)
		for bi := int32(0); bi < int32(len(byts)); bi++ {
			totAlloc += int32(cnts[bi])
			if bi >= 12 && bi < 21 {
				hist = hist | " " | mxutil.SimpleItoa(bi) | ":" | mxutil.SimpleItoa(int32((byts[bi] >> 20)))
			}
		}
		mxutil.WriteStr(2, "    EAF nf="|mxutil.SimpleItoa(nf)|" in rss="|mxutil.SimpleItoa(int32(rssKB()/1024))|"MB cau="|mxutil.SimpleItoa(int32(cau2>>20))|"MB cac="|mxutil.SimpleItoa(int32(cac2>>20))|"MB net="|mxutil.SimpleItoa(int32(runtime.SysMapNet()>>20))|"MB acap="|mxutil.SimpleItoa(int32(runtime.LiveArenaCap()>>20))|"MB na="|mxutil.SimpleItoa(int32(totAlloc/1000))|"k hist"|hist|" durN="|mxutil.SimpleItoa(cctx.durScopes)|" dur="|mxutil.SimpleItoa(int32(cctx.durBytes>>20))|"MB ptd="|mxutil.SimpleItoa(int32(len(e.pendTypeDescs)))|" dsym="|mxutil.SimpleItoa(int32(len(e.definedSyms)))|" arr="|mxutil.SimpleItoa(int32(len(e.arrConsts)))|" kif="|mxutil.SimpleItoa(int32(len(e.keepIfaceTypes)))|" smap="|mxutil.SimpleItoa(int32(len(e.strMap)))|" edecl="|mxutil.SimpleItoa(int32(len(e.extDecls)))|" eglob="|mxutil.SimpleItoa(int32(len(e.extGlobals)))|" tid="|mxutil.SimpleItoa(int32(len(e.typeIDs)))|" fb="|mxutil.SimpleItoa(int32(fB>>20))|"MB fn="|fn.name|" blocks="|mxutil.SimpleItoa(int32(len(fn.Blocks)))|"\n")
		// Fork C: the durable counters cover the member that was just built plus
		// whatever the previous member's emit opened; printed here and zeroed so
		// the next line reports its own member instead of a running total.
		cctx.durScopes = 0
		cctx.durBytes = 0
		if rssPeak("emit " | fn.name) {
			mxutil.WriteStr(2, "    NEWPEAK rss=" | mxutil.SimpleItoa(int32(cctx.peakRSSKB/1024)) | "MB at emit " | fn.name | " pool=" | mxutil.SimpleItoa(e.strPoolBytes()>>10) | "KB nstr=" | mxutil.SimpleItoa(int32(len(e.strConst)+len(e.pendStrConsts))) | "\n")
		}
		tM1 := runtime.NowNano()
		emitBuiltMember(e, fn)
		tM2 := runtime.NowNano()
		if nf <= 24 || nf%64 == 0 {
			mxutil.WriteStr(2, "    TIME nf=" | mxutil.SimpleItoa(nf) | " build=" | mxutil.SimpleItoa(int32((tM1-tM0)/1000000)) | "ms emit=" | mxutil.SimpleItoa(int32((tM2-tM1)/1000000)) | "ms\n")
		}
		// Clones this build created have their bodies in THIS arena; emit them
		// before the reset, or the reset frees a body that was never written.
		for {
			built := ""
			for k, m := range e.pkg.Members {
				if emitted[k] {
					continue
				}
				f, okf := m.(*SSAFunction)
				if !okf || f.Blocks == nil {
					continue
				}
				if built == "" || k < built {
					built = k
				}
			}
			if built == "" {
				break
			}
			emitted[built] = true
			bf := e.pkg.Func(built)
			nf++
			emitBuiltMember(e, bf)
		}
		// Fork C: the member arena after the emit, before the reset.
		fE := uint64(0)
		if fnArena != nil {
			fE = runtime.ArenaUsed(fnArena)
		}
		runtime.SovereignRegRestore()
		runtime.ManualArenaExit(fnArena)
		e.mergeAccumulators()
		uE := uint64(0)
		if cctx.compileArena != nil {
			uE = runtime.ArenaUsed(cctx.compileArena)
		}
		// The scratch high-water mark for this function, read before the
		// reset that reclaims it. This is the number that says whether the
		// per-function cost is real or is a 64MB segment grabbed for a few
		// megabytes: `acap` cannot tell those apart, `used` can.
		mxutil.WriteStr(2, "    EAFU nf="|mxutil.SimpleItoa(nf)|" used="|mxutil.SimpleItoa(int32(runtime.ArenaUsed(fnArena)>>20))|"MB pre="|mxutil.SimpleItoa64(int64(uA)>>10)|"KB bc="|mxutil.SimpleItoa64((int64(cau2)-int64(uA))>>10)|"KB em="|mxutil.SimpleItoa64((int64(uE)-int64(cau2))>>10)|"KB fe="|mxutil.SimpleItoa(int32(fE>>20))|"MB\n")
		uP2 := uint64(0)
		if cctx.compileArena != nil {
			uP2 = runtime.ArenaUsed(cctx.compileArena)
		}
		// Experiment A (skip the reset) ran here and answered its question:
		// with the reset skipped, the build no longer crashes at strconv but
		// hangs at the same boundary one member later (math, after ilogb,
		// 10+ minutes at 99% CPU with no output). A hang and a crash at the
		// same boundary are one defect, so the reset is not what is broken:
		// something allocated in this arena is still referenced afterwards.
		// The reset stays.
		runtime.ArenaReset(fnArena)
		// Fork C: split the loop tail's compile-arena growth (measured as a
		// constant ~138KB per member) between the reset and the checkpoint.
		uF := uint64(0)
		if cctx.compileArena != nil {
			uF = runtime.ArenaUsed(cctx.compileArena)
		}
		// The safe point between two function bodies: the select answers
		// ctrl-c (a build that cannot be stopped is a build nobody can
		// interrupt - it also cannot reclaim, because the drain only runs
		// where no frame borrows the group) and the drain reclaims the
		// scratch the function just abandoned. A deep call chain has no
		// such boundary, which is why emit is a free function looping over
		// members with a checkpoint per member.
		if runtime.SovCheckpoint() {
			interruptNow()
		}
		uG := uint64(0)
		if cctx.compileArena != nil {
			uG = runtime.ArenaUsed(cctx.compileArena)
		}
		uP3 := uint64(0)
		if cctx.compileArena != nil {
			uP3 = runtime.ArenaUsed(cctx.compileArena)
		}
		uP3Prev = uP3
		mxutil.WriteStr(2, "    PH2 nf="|mxutil.SimpleItoa(nf)|" eafu="|mxutil.SimpleItoa64((int64(uP2)-int64(uE))>>10)|"KB reset="|mxutil.SimpleItoa64((int64(uF)-int64(uP2))>>10)|"KB chk="|mxutil.SimpleItoa64((int64(uG)-int64(uF))>>10)|"KB ph2="|mxutil.SimpleItoa64((int64(uP3)-int64(uG))>>10)|"KB\n")
	}
	mxutil.WriteStr(2, "    EAF1big nf="|mxutil.SimpleItoa(nf)|"\n"|string(runtime.BigAllocReport()))
	runtime.ArenaFree(fnArena)
}

// emitIR is the package's whole emission. It is a FREE function on purpose:
// every `e.something()` it calls borrows the emitter's sovereign arena and pops
// at its return, so between two calls the group has no live frame and
// emitAllFunctions can compact what the last function left behind. As a method,
// emit's own frame was live for the entire package, so nothing the emitter
// allocated was ever reclaimable - measured as ~1.6 MB retained per IR
// instruction and 2.9 GB inside one package.
// scanGlobalTypesOf records, for one function body, the declared LLVM type of
// every package global the body stores to or loads from, and the load-to-global
// map those decisions are matched through. It used to be one loop over every
// member of the package before the first emit; with per-member building it runs
// on the body that was just built, in that body's arena, so its scratch dies
// with the body instead of accumulating for the whole package.
func scanGlobalTypesOf(e *irEmitter, fn *SSAFunction) {
	if fn == nil || fn.Blocks == nil {
		return
	}
		for _, b := range fn.Blocks {
			for _, instr := range b.Instrs {
				if st, okSt := instr.(*SSAStore); okSt && st.Addr != nil && st.Val != nil {
					if g, ok3 := st.Addr.(*SSAGlobal); ok3 {
						vt := e.llvmType(st.Val.SSAType())
						if vt != "ptr" && vt != "void" && vt != "i1" && vt != "" {
							name := e.globalName(g)
							gt := ""
							if p, ok4 := SafeUnderlying(g.typ).(*Pointer); ok4 {
								gt = e.llvmType(p.Base)
							}
							if gt != "" && gt != "ptr" && gt != "i8" && gt[0] == '{' && vt[0] != '{' {
								vt = gt
							}
							e.globalTypes[name] = vt
						}
					}
				}
			}
		}
		e.loadToGlobal = map[string]*SSAGlobal{}
		for _, b := range fn.Blocks {
			for _, instr := range b.Instrs {
				load, okUn := instr.(*SSAUnOp)
				if !okUn || load.Op != OpMul { continue }
				g, ok3 := load.X.(*SSAGlobal)
				if !ok3 { continue }
				e.loadToGlobal[load.SSAName()] = g
			}
		}
		for _, b := range fn.Blocks {
			for _, instr := range b.Instrs {
				if ret, okRet := instr.(*SSAReturn); okRet {
					if fn.Signature == nil { continue }
					rets := fn.Signature.Results
					if rets == nil || rets.Len() == 0 { continue }
					for i, res := range ret.Results {
						if i >= rets.Len() { break }
						if g, ok3 := e.loadToGlobal[res.SSAName()]; ok3 {
							rt := rets.At(i)
							if rt == nil { continue }
							expectType := e.llvmType(rt.Typ)
							if expectType != "ptr" && expectType != "void" && expectType != "i1" && expectType != "" {
								name := e.globalName(g)
								if _, exists := e.globalTypes[name]; !exists {
									e.globalTypes[name] = expectType
								}
							}
						}
					}
				}
				call, okCall := instr.(*SSACall)
				if !okCall { continue }
				callee := call.Call.Value
				if callee == nil { continue }
				var sig *Signature
				if cfn, ok3 := callee.(*SSAFunction); ok3 && cfn.Signature != nil {
					sig = cfn.Signature
				} else {
					ct := callee.SSAType()
					if ct != nil {
						sig, _ = SafeUnderlying(ct).(*Signature)
					}
				}
				if sig == nil { continue }
				params := sig.Params
				if params == nil || params.Len() == 0 { continue }
				recvOff := 0
				if sig.Recv != nil {
					recvOff = 1
				}
				for i, arg := range call.Call.Args {
					if arg == nil { continue }
					sigIdx := i - recvOff
					if sigIdx < 0 || sigIdx >= params.Len() { continue }
					pt := params.At(sigIdx)
					if pt == nil { continue }
					g, found := e.loadToGlobal[arg.SSAName()]
					if !found { continue }
					expectType := e.llvmType(pt.Typ)
					name := e.globalName(g)
					if expectType != "void" && expectType != "i1" && expectType != "" {
						if _, exists := e.globalTypes[name]; !exists {
							e.globalTypes[name] = expectType
						}
					}
				}
			}
		}
		for _, b := range fn.Blocks {
			for _, instr := range b.Instrs {
				if rng, okRng := instr.(*SSARange); okRng && rng.X != nil {
					if g, ok3 := e.loadToGlobal[rng.X.SSAName()]; ok3 {
						name := e.globalName(g)
						if _, exists := e.globalTypes[name]; !exists {
							e.globalTypes[name] = "ptr"
						}
					}
				}
				if mu, okMu := instr.(*SSAMapUpdate); okMu && mu.Map != nil {
					if g, ok3 := e.loadToGlobal[mu.Map.SSAName()]; ok3 {
						name := e.globalName(g)
						if _, exists := e.globalTypes[name]; !exists {
							e.globalTypes[name] = "ptr"
						}
					}
				}
				if lu, okLu := instr.(*SSALookup); okLu && lu.X != nil {
					if g, ok3 := e.loadToGlobal[lu.X.SSAName()]; ok3 {
						name := e.globalName(g)
						if _, exists := e.globalTypes[name]; !exists {
							e.globalTypes[name] = "ptr"
						}
					}
				}
				bop, okBop := instr.(*SSABinOp)
				if !okBop { continue }
				if bop.X == nil || bop.Y == nil { continue }
				gx, xIsGlobal := e.loadToGlobal[bop.X.SSAName()]
				gy, yIsGlobal := e.loadToGlobal[bop.Y.SSAName()]
				if xIsGlobal {
					yt := e.llvmType(bop.Y.SSAType())
					if yt != "ptr" && yt != "void" && yt != "i1" && yt != "" {
						name := e.globalName(gx)
						if _, exists := e.globalTypes[name]; !exists {
							e.globalTypes[name] = yt
						}
					}
				}
				if yIsGlobal {
					xt := e.llvmType(bop.X.SSAType())
					if xt != "ptr" && xt != "void" && xt != "i1" && xt != "" {
						name := e.globalName(gy)
						if _, exists := e.globalTypes[name]; !exists {
							e.globalTypes[name] = xt
						}
					}
				}
			}
		}
	// Every e.*() call in the scans above borrows the emitter's sovereign
	// arena and pops at its return, so between two functions the group has
	// no live frame and what the scan abandoned is reclaimable. The scan runs
	// over every instruction of the function, and `strconv` alone reached
	// 3.3 GB before this drain existed.
	runtime.SovDrainCompactions(8)
}

func emitIR(e *irEmitter) (s string) {
	// Built once, in place. Nothing returns the member slice: see buildMembers.
	buildMembers(e)
	mxutil.WriteStr(2, "    EM1 members n="|mxutil.SimpleItoa(int32(len(e.members)))|" rss="|mxutil.SimpleItoa(int32(rssKB()/1024))|"MB\n")
	dl := e.dataLayout()
	if dl != "" {
		e.w("target datalayout = \"")
		e.w(dl)
		e.w("\"\n")
	}
	e.w("target triple = \"")
	e.w(e.triple)
	e.w("\"\n\n")

	mxutil.WriteStr(2, "    EM2 triple rss="|mxutil.SimpleItoa(int32(rssKB()/1024))|"MB\n")
	e.resolveAllNamedTypes()
	mxutil.WriteStr(2, "    EM3 named types rss="|mxutil.SimpleItoa(int32(rssKB()/1024))|"MB\n")

	e.pendTypeDescs = map[string]Type{}
	for _, m := range e.members {
		fn, ok := m.(*SSAFunction)
		if ok && e.pkg.HasBody(fn.name) && fn.Signature != nil {
			if fn.Signature.Results != nil {
				for i := int32(0); i < int32(fn.Signature.Results.Len()); i++ {
					e.collectAllTypeDescs(fn.Signature.Results.At(i).Typ, map[string]bool{})
				}
			}
			if fn.Signature.Recv != nil {
				e.collectAllTypeDescs(fn.Signature.Recv.Typ, map[string]bool{})
			}
		}
		g, ok2 := m.(*SSAGlobal)
		if ok2 && g.typ != nil {
			e.collectAllTypeDescs(g.typ, map[string]bool{})
		}
	}
	mxutil.WriteStr(2, "    EM4 descs n="|mxutil.SimpleItoa(int32(len(e.pendTypeDescs)))|" rss="|mxutil.SimpleItoa(int32(rssKB()/1024))|"MB\n")
	// Also declare type descriptors for this package's own named types,
	// since interface dispatch may reference them. Deterministic per
	// package: parallel workers compile packages in arbitrary order with
	// per-thread registries, so the descriptor set must not depend on
	// which packages happen to be loaded. Every package emits its own
	// types; linkonce_odr dedups at link time.
	if e.pkg != nil && e.pkg.Pkg != nil && e.pkg.Pkg.Scope != nil {
		scope := e.pkg.Pkg.Scope
		names := scope.Names()
		for _, name := range names {
			obj := scope.Lookup(name)
			if obj == nil {
				continue
			}
			tn, ok := obj.(*TypeName)
			if !ok || tn.Typ == nil {
				continue
			}
			path := normalizePkgPath(e.pkg.Pkg.Path)
			tail := "named:" | path | "." | name
			if _, exists := e.pendTypeDescs[tail]; !exists {
				e.pendTypeDescs[tail] = Typ[Invalid]
			}
			tailPtr := "pointer:" | tail
			if _, exists := e.pendTypeDescs[tailPtr]; !exists {
				e.pendTypeDescs[tailPtr] = Typ[Invalid]
			}
		}
	}
	// Also declare basic type descriptors from the universe scope. The
	// canonical descriptor spelling comes from the kind (uint8, int32,
	// bytes), not from the universe name: `byte`, `rune` and `string` are
	// named types, so poking `basic:byte` here only created a descriptor
	// that no reference could match.
	if cctx.universe != nil && cctx.universe.Scope != nil {
		for _, name := range cctx.universe.Scope.Names() {
			tn, isTN := cctx.universe.Scope.Lookup(name).(*TypeName)
			if !isTN || tn.Typ == nil {
				continue
			}
			b, isBasic := SafeUnderlying(tn.Typ).(*Basic)
			if !isBasic || b == nil {
				continue
			}
			tail := "basic:" | basicTypeDescName(b.Kind)
			if _, exists := e.pendTypeDescs[tail]; !exists {
				e.pendTypeDescs[tail] = Typ[Invalid]
			}
			ptail := "pointer:" | tail
			if _, exists := e.pendTypeDescs[ptail]; !exists {
				e.pendTypeDescs[ptail] = Typ[Invalid]
			}
		}
	}

	if !buildTagTrue("moxie.stringer") {
		e.emitBasicIdentities()
	}

	e.globalTypes = map[string]string{}
	e.globalDeclTypes = map[string]string{}

	mxutil.WriteStr(2, "    M1 header done rss="|mxutil.SimpleItoa(int32(rssKB()/1024))|"MB\n")
	e.flush()
	mxutil.WriteStr(2, "    M2 flush done rss="|mxutil.SimpleItoa(int32(rssKB()/1024))|"MB\n")
	compileArena := runtime.CurrentArena()
	// Deep copy state lives in compileArena, survives per-function resets.
	// Pre-collect symbols that will get `define`. `HasBody` replaces
	// `Blocks != nil`: with per-member building no body exists yet, and the
	// list decides `declare` vs `define` for every call in the package. A
	// monomorphised clone created later still emits its own `define`, and a
	// forward `declare` of it is legal IR.
	// Done in compile arena so the slice survives fn arena resets.
	for _, member := range e.members {
		if f, ok := member.(*SSAFunction); ok && e.pkg.HasBody(f.name) {
			defSym := e.funcSymbol(f)
			if len(defSym) > 0 && defSym[0] == '@' {
				defSym = defSym[1:]
			}
			push(e.definedSyms, defSym)
		}
	}
	mxutil.WriteStr(2, "    M4 syms done rss="|mxutil.SimpleItoa(int32(rssKB()/1024))|"MB\n")
	emitAllFunctions(e, compileArena)
	mxutil.WriteStr(2, "    M5 functions done rss="|mxutil.SimpleItoa(int32(rssKB()/1024))|"MB strpush="|mxutil.SimpleItoa(e.strPushCount)|" strstale="|mxutil.SimpleItoa(e.strStaleCount)|" strconst="|mxutil.SimpleItoa(int32(len(e.strConst)+len(e.pendStrConsts)))|"\n")
	// Globals are emitted AFTER the functions, not before them. Their declared
	// type is refined by scanGlobalTypesOf from how each body stores to or
	// loads from them, and that knowledge now arrives one body at a time. The
	// text order changed; the IR does not: llvm-as accepts a global that a
	// function names before its definition, and the cached object for a
	// package is produced from this same text every time.
	e.segs = []string{:0:256}
	for _, member := range e.members {
		switch m := member.(type) {
		case *SSAGlobal:
			if m.name != "_" {
				e.emitGlobal(m)
			}
		}
	}
	e.flush()
	mxutil.WriteStr(2, "    M3 globals done rss="|mxutil.SimpleItoa(int32(rssKB()/1024))|"MB\n")
	// Fresh segs for trailing declarations.
	e.segs = []string{:0:256}
	// Merge pending declares/globals.
	e.mergeAccumulators()
	e.emitLibMain()
	for i, sc := range e.strConst {
		e.w(e.strConstGlobal(i))
		// Moxie: string=[]byte means string literals are mutable; keep
		// them in .data, not .rodata, so slice writes work.
		e.w(" = private global [")
		e.w(irItoa(len(sc)))
		e.w(" x i8] c\"")
		e.w(irEscapeString(sc))
		e.w("\"\n")
	}
	if len(e.arrConsts) > 0 {
		e.w("\ndeclare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)\n")
		for i, ac := range e.arrConsts {
			e.w("@.arr." | irItoa(i) | " = private constant " | ac | "\n")
		}
	}
	e.emitKeepIfaceUsed()


	if len(e.extDecls) > 0 {
		e.w("\n")
		var edKeys []string
		for k := range e.extDecls {
			push(edKeys, k)
		}
		for i := 1; i < len(edKeys); i++ {
			for j := i; j > 0 && edKeys[j] < edKeys[j-1]; j-- {
				edKeys[j], edKeys[j-1] = edKeys[j-1], edKeys[j]
			}
		}
		for _, k := range edKeys {
			decl := e.extDecls[k]
			if decl == "" {
				continue
			}
			if e.isPkgFuncDefined(k) {
				continue
			}
			e.w("declare ")
			e.w(decl)
			// Check for wasm import attributes
			if len(cctx.wasmImportMap) > 0 {
				sym := k
				if len(sym) > 0 && sym[0] == '@' {
					sym = sym[1:]
				}
				if len(sym) >= 2 && sym[0] == '"' && sym[len(sym)-1] == '"' {
					sym = sym[1 : len(sym)-1]
				}
				if wi, ok := cctx.wasmImportMap[sym]; ok {
					e.wasmAttrID++
					aid := e.wasmAttrID
					e.w(" #" | simpleItoa(aid))
					push(e.wasmAttrs, []string{simpleItoa(aid), wi[0], wi[1]})
				}
			}
			e.w("\n")
		}
	}

	if len(e.extGlobals) > 0 {
		e.w("\n")
		var egKeys []string
		for name := range e.extGlobals {
			push(egKeys, name)
		}
		for i := 1; i < len(egKeys); i++ {
			for j := i; j > 0 && egKeys[j] < egKeys[j-1]; j-- {
				egKeys[j], egKeys[j-1] = egKeys[j-1], egKeys[j]
			}
		}
		for _, name := range egKeys {
			e.w(name)
			e.w(" = ")
			e.w(e.tlsExternalPrefix())
			e.w(e.extGlobals[name])
			e.w("\n")
		}
	}
	e.emitTypeDescs()
	e.emitSpawnWrappers()
	e.emitWasmSpawnEntry()
	// Emit wasm import attribute groups
	for _, wa := range e.wasmAttrs {
		e.w("attributes #" | wa[0] | " = { \"wasm-import-module\"=\"" | wa[1] | "\" \"wasm-import-name\"=\"" | wa[2] | "\" }\n")
	}

	if e.outFile != nil {
		e.flushDedup()
		return ""
	}
	e.assembleSegs()
	if len(e.accOut) > 0 {
		need := len(e.accOut) + len(e.buf)
		full := []byte{:need}
		copy(full, e.accOut)
		if len(e.buf) > 0 {
			mxutil.CopyRange(full, len(e.accOut), e.buf, 0, len(e.buf))
		}
		e.buf = full
	}
	e.dedupBuf()
	result := string(e.buf)
	e.buf = nil
	return result
}

// dedupBuf removes duplicate declare/define/descriptor lines from e.buf.
func (e *irEmitter) dedupBuf() {
	if len(e.buf) == 0 {
		return
	}
	var seen []string
	out := []byte{:0:len(e.buf)}
	ls := int32(0)
	n := int32(len(e.buf))
	for ls < n {
		le := ls
		for le < n && e.buf[le] != '\n' {
			le++
		}
		if le < n {
			le++
		}
		line := string(e.buf[ls:le])
		isDeclare := len(line) > 8 && line[0] == 'd' && line[1] == 'e' && line[2] == 'c' && line[3] == 'l' && line[4] == 'a' && line[5] == 'r' && line[6] == 'e' && line[7] == ' '
		isDefine := len(line) > 7 && line[0] == 'd' && line[1] == 'e' && line[2] == 'f' && line[3] == 'i' && line[4] == 'n' && line[5] == 'e' && line[6] == ' '
		isDesc := len(line) > 22 && line[0] == '@' && line[1] == '"' && line[2] == 'r' && line[3] == 'e' && line[4] == 'f' && line[5] == 'l' && line[6] == 'e' && line[7] == 'c' && line[8] == 't' && line[9] == '/' && line[10] == 't' && line[11] == 'y' && line[12] == 'p' && line[13] == 'e' && line[14] == 's' && line[15] == '.'
		dup := false
		lineName := line
		if isDeclare || isDefine || isDesc {
			if isDesc {
				nameEnd := int32(0)
				for bi := int32(0); bi < len(line); bi++ {
					if line[bi] == ' ' {
						nameEnd = bi
						break
					}
				}
				if nameEnd > 0 {
					lineName = string(line[:nameEnd])
				}
			}
			for si := int32(0); si < len(seen); si++ {
				s := seen[si]
				if len(s) == len(lineName) {
					match := true
					for bi := int32(0); bi < len(s); bi++ {
						if s[bi] != lineName[bi] {
							match = false
							break
						}
					}
					if match {
						dup = true
						break
					}
				}
			}
		}
		if dup {
			ls = le
			continue
		}
		if isDeclare || isDefine || isDesc {
			seen = mxutil.Ensure(seen, 1)
			seen = push(seen, lineName)
		}
		out = mxutil.Ensure(out, len(line))
		out = push(out, line...)
		ls = le
	}
	e.buf = out
}


// copyStr deep-copies a string's backing bytes into the current arena.
// Without this, string headers in compile-arena maps would point to
// fn-arena bytes that die at ArenaReset.
func copyStr(s string) (r string) {
	if len(s) == 0 {
		return ""
	}
	buf := []byte{:len(s)}
	copy(buf, s)
	return string(buf)
}

// strPoolBytes is the LIVE text of the string-constant pool: one string per
// occurrence, because strings are mutable and two literals must not share
// bytes. Printing it at each new RSS peak is what tests the claim that this
// pool is the accumulator - if it stays small while RSS climbs, the growth is
// somewhere else and the previous conclusion was wrong.
func (e *irEmitter) strPoolBytes() (n int32) {
	for _, s := range e.strConst {
		n += len(s)
	}
	for _, s := range e.pendStrConsts {
		n += len(s)
	}
	return n
}

// mergeAccumulators deep-copies per-function products into compile-arena maps.
// Called on the compile arena after function emit + flush.
// All accumulator string bytes are in the fn arena and must be copied.
func (e *irEmitter) mergeAccumulators() {
	for _, p := range e.pendExtDecls {
		e.extDecls[copyStr(p.k)] = copyStr(p.v)
	}
	e.pendExtDecls = nil
	for _, p := range e.pendExtGlobals {
		e.extGlobals[copyStr(p.k)] = copyStr(p.v)
	}
	e.pendExtGlobals = nil
	for _, s := range e.pendStrConsts {
		cs := copyStr(s)
		// Always append: a pending entry's index was handed out as
		// len(strConst)+its position when the operand was emitted, so skipping a
		// duplicate here would shift every later .str index onto the wrong bytes.
		// strMap only records the FIRST index for a text, for addStringConst.
		//
		// Sharing the FIRST entry's bytes instead was measured and REJECTED:
		// strings are MUTABLE in Moxie, so two table slots pointing at one text
		// let a rewrite through either corrupt the other. The compiler caught it
		// at link with "unknown special variable with appending linkage: @0".
		if _, ok := e.strMap[cs]; !ok {
			e.strMap[cs] = len(e.strConst)
		}
		push(e.strConst, cs)
	}
	e.pendStrConsts = nil
	for _, a := range e.pendArrConsts {
		push(e.arrConsts, copyStr(a))
	}
	e.pendArrConsts = nil
	for _, it := range e.pendKeepIface {
		push(e.keepIfaceTypes, it)
	}
	e.pendKeepIface = nil
	for _, p := range e.pendTypeIDs {
		ck := copyStr(p.k)
		if _, ok := e.typeIDs[ck]; !ok {
			e.typeIDs[ck] = p.v
		}
	}
	e.pendTypeIDs = nil
	for _, k := range e.pendLocalTypeIDs {
		e.localTypeIDs[copyStr(k)] = true
	}
	e.pendLocalTypeIDs = nil
	for _, p := range e.pendGlobalDeclTypes {
		e.globalDeclTypes[copyStr(p.k)] = copyStr(p.v)
	}
	e.pendGlobalDeclTypes = nil
	for _, wa := range e.pendWasmAttrs {
		push(e.wasmAttrs, []string{copyStr(wa[0]), copyStr(wa[1]), copyStr(wa[2])})
	}
	e.pendWasmAttrs = nil
	for _, s := range e.pendSpawnWrappers {
		push(e.spawnWrapperTexts, copyStr(s))
	}
	e.pendSpawnWrappers = nil

}

// Members never cross a function boundary. `[]SSAMember` is a slice of
// interfaces, so RETURNING it makes the return protocol codec-encode the value
// graph - every member reaches its block, its instructions and its types, and
// that is the whole package. Measured: a member accessor returning e.members
// cost one full package encode per call, five calls per package, 28-deep
// codecEncodeValue; and growing the slice through mxutil.Ensure paid the same
// walk at every doubling. That walk is what stalled `math` (272 members) inside
// the member builder: the emitter sat in codecSeenLookup <- codecEncodeValue
// for minutes per call even though the map lookups themselves were instant.
//
// So the member slice lives in the receiver, is filled by a function that
// returns nothing, and is read as a field. A field read copies a 16-byte
// interface header and reaches nothing.
//
// It is a FREE function for the allocation's sake: a method of the emitter
// borrows the sovereign arena, so the slice would be allocated there and was
// dangling by the time emitAllFunctions walked it (SIGSEGV in
// main[emitAllFunctions]). As a free function the allocation lands in the
// compile arena it is called from, which is where every other emitter
// accumulator written by emitIR lives.
func buildMembers(e *irEmitter) {
	e.members = nil
	keys := sortedMemberKeys(e)
	n := int32(0)
	for _, k := range keys {
		if e.pkg.Members[k] != nil {
			n++
		}
	}
	e.members = []SSAMember{:n}
	j := int32(0)
	for _, k := range keys {
		m := e.pkg.Members[k]
		if m != nil {
			e.members[j] = m
			j++
		}
	}
}

// sortedMemberKeys returns the package's member names in lexicographic order so
// emission does not depend on hash order. A free function, so the key list's
// growth garbage dies with its frame; the []string return is deep-copied by the
// return protocol, but a name is a few bytes and reaches nothing.
func sortedMemberKeys(e *irEmitter) (keys []string) {
	keys = []string{:int32(len(e.pkg.Members))}
	n := int32(0)
	for k := range e.pkg.Members {
		keys[n] = k
		n++
	}
	for i := int32(1); i < n; i++ {
		for j := i; j > 0 && keys[j] < keys[j-1]; j-- {
			keys[j], keys[j-1] = keys[j-1], keys[j]
		}
	}
	return keys
}

func (e *irEmitter) emitGlobal(g *SSAGlobal) {
	name := e.globalName(g)
	if cctx.externGlobals != nil {
		if _, ok := cctx.externGlobals[g.name]; ok {
			// Extern global: reference the C runtime's symbol. A definition
			// here would shadow it with a zeroed (and thread-local) object,
			// so the first read sees nil instead of environ/__ehdr_start.
			e.w(name)
			e.w(" = external global ")
			e.w(e.resolveGlobalDeclType(g))
			e.w("\n")
			return
		}
	}
	if ld, ok := cctx.linkDataVars[g.name]; ok {
		e.emitLinkDataGlobal(g, name, ld)
		return
	}
	if ei, ok := cctx.embedVars[g.name]; ok {
		e.emitEmbedGlobal(g, name, ei)
		return
	}
	typ := e.resolveGlobalDeclType(g)
	e.w(name)
	e.w(" = hidden ")
	e.w(e.tlsPrefix())
	e.w(typ)
	e.w(" zeroinitializer\n")
}

// emitLinkDataGlobal binds a package-level byte slice to an external symbol.
// The header is a normal slice - len and cap are the declared length - and the
// data pointer is the symbol itself, declared extern_weak so that a build
// without a producer of it still links (and leaves the pointer null).
func (e *irEmitter) emitLinkDataGlobal(g *SSAGlobal, name string, ld *linkDataInfo) {
	// A global's type is the pointer to its storage; the slice is the pointee.
	gt := g.typ
	if p, ok := SafeUnderlying(gt).(*Pointer); ok && p.Base != nil {
		gt = p.Base
	}
	elemSize := int32(0)
	if sl, ok := SafeUnderlying(gt).(*Slice); ok && sl.Elem != nil {
		elemSize = typeDescSize(sl.Elem)
	}
	if elemSize != 1 || ld.length <= 0 {
		addCompileError("linkdata: " | g.name | " must be a slice of one-byte elements with a positive length")
		e.w(name | " = hidden " | e.tlsPrefix() | e.sliceType() | " zeroinitializer\n")
		return
	}
	blobName := irQuoteName(ld.target)
	e.w(blobName | " = extern_weak global [" | irItoa(ld.length) | " x i8], align 1\n")
	// len is the imported length; cap is -1, which marks storage that is not
	// ours to grow. `push` compares len against cap and fails loud, so a write
	// that would need room beyond the imported blob dies with "push past end
	// of slice capacity" instead of scribbling past the symbol.
	ipt := e.intptrType()
	e.w(name | " = hidden " | e.tlsPrefix() | "{ptr, " | ipt | ", " | ipt | "} {ptr " | blobName |
		", " | ipt | " " | irItoa(ld.length) | ", " | ipt | " -1}\n")
}

func (e *irEmitter) emitEmbedGlobal(g *SSAGlobal, name string, ei *embedInfo) {
	data, ok := mxutil.ReadFile(ei.path)
	if !ok {
		// Fail loud: a zeroinitializer embed global is a nil slice at runtime
		// and SIGSEGVs far from the cause.
		addCompileError("embed: file not found: "|ei.path)
		e.w(name | " = hidden " | e.tlsPrefix() | e.sliceType() | " zeroinitializer\n")
		return
	}
	elemSize := e.embedElemSize(ei.elemType)
	if elemSize <= 0 {
		addCompileError("embed: unknown element type: "|ei.elemType|" for "|ei.path)
		e.w(name | " = hidden " | e.tlsPrefix() | e.sliceType() | " zeroinitializer\n")
		return
	}
	count := int32(len(data)) / elemSize
	// name may be quoted (@"pkg/path.var"); the .data suffix must land
	// inside the quotes or the symbol is malformed IR.
	constName := name | ".data"
	if len(name) > 0 && name[len(name)-1] == '"' {
		constName = name[:len(name)-1] | ".data\""
	}
	e.w(constName | " = private constant [" | irItoa(int32(len(data))) | " x i8] c\"")
	hexDigit := "0123456789ABCDEF"
	hexBuf := []byte{:int32(len(data)) * 3}
	for i := int32(0); i < int32(len(data)); i++ {
		b := data[i]
		hexBuf[i*3] = '\\'
		hexBuf[i*3+1] = hexDigit[b>>4]
		hexBuf[i*3+2] = hexDigit[b&0x0f]
	}
	e.w(string(hexBuf))
	e.w("\"\n")
	ipt := e.intptrType()
	e.w(name | " = hidden " | e.tlsPrefix() | "{ptr, " | ipt | ", " | ipt | "} {ptr " | constName | ", " | ipt | " " | irItoa(count) | ", " | ipt | " " | irItoa(count) | "}\n")
}

func (e *irEmitter) embedElemSize(elemType string) (sz int32) {
	if elemType == "[]Range16" {
		return 6
	}
	if elemType == "[]Range32" {
		return 12
	}
	if elemType == "[]CaseRange" {
		return 20
	}
	if elemType == "[]foldPair" {
		return 8
	}
	if elemType == "[]uint8" || elemType == "[]byte" {
		return 1
	}
	if elemType == "[]uint16" {
		return 2
	}
	if elemType == "[]uint32" || elemType == "[]int32" {
		return 4
	}
	if elemType == "[]uint64" || elemType == "[]int64" {
		return 8
	}
	return 0
}

func (e *irEmitter) globalName(g *SSAGlobal) (s string) {
	if cctx.externGlobals != nil {
		if tgt, ok := cctx.externGlobals[g.name]; ok {
			if irNeedsQuote(tgt) {
				return irQuoteName(tgt)
			}
			return "@" | tgt
		}
	}
	pkg := e.pkg.Pkg.Path
	if g.pkg != nil {
		pkg = g.pkg.Pkg.Path
	}
	return irGlobalSymbol(pkg, g.name)
}

func (e *irEmitter) isPkgFuncDefined(name string) (ok bool) {
	// Check if we emitted a define for this symbol during this package's emit.
	for di := int32(0); di < len(e.definedSyms); di++ {
		ds := e.definedSyms[di]
		if len(ds) == len(name) {
			match := true
			for bi := int32(0); bi < len(ds); bi++ {
				if ds[bi] != name[bi] {
					match = false
					break
				}
			}
			if match {
				return true
			}
		}
	}
	return false
}


func (e *irEmitter) funcSymbol(f *SSAFunction) (s string) {
	if f == nil {
		return "@__mxc_nil_func"
	}
	if f.externalSymbol != "" {
		sym := f.externalSymbol
		if irNeedsQuote(sym) {
			return irQuoteName(sym)
		}
		return "@" | sym
	}
	if cctx.linknameMap != nil {
		if target, ok := cctx.linknameMap[f.name]; ok {
			if irNeedsQuote(target) {
				return irQuoteName(target)
			}
			return "@" | target
		}
	}
	pkg := e.pkg.Pkg.Path
	if f.Pkg != nil {
		pkg = f.Pkg.Pkg.Path
	}
	return irGlobalSymbol(pkg, f.name)
}

func (e *irEmitter) isPkgFunc(f *SSAFunction) (ok bool) {
	if f == nil {
		return false
	}
	if f.Pkg == e.pkg {
		return true
	}
	if f.parent != nil {
		return e.isPkgFunc(f.parent)
	}
	return false
}

// emitAnonFuncs is free for the same reason as emitFunctionOf: as a method its
// borrow was live across every nested function's whole emit.
func emitAnonFuncsOf(e *irEmitter, f *SSAFunction) {
	for _, af := range f.AnonFuncs {
		emitFunctionOf(e, af)
		emitAnonFuncsOf(e, af)
		af.Blocks = nil
		af.Locals = nil
		af.Params = nil
		af.FreeVars = nil
		af.NamedResults = nil
		af.vars = nil
	}
	f.AnonFuncs = nil
}

func (e *irEmitter) emitLibMain() {
	pkgPath := e.pkg.Pkg.Path
	if pkgPath == "main" || pkgPath == "command-line-arguments" {
		return
	}
	hasMain := false
	if m := e.pkg.Members["main"]; m != nil {
		if fn, ok := m.(*SSAFunction); ok && fn.externalSymbol == "" {
			hasMain = true
		}
	}
	if hasMain {
		return
	}
	sym := irGlobalSymbol(pkgPath, "main")
	e.w("\ndefine void ")
	e.w(sym)
	e.w("(ptr %_ctx) {\nbb.entry:\n  ret void\n}\n")
}

// bigAggregateElems is the array size above which a function that CARRIES the
// array by value is emitted `noinline optnone`.
//
// An array is an inline aggregate in this IR, so a generated data table -
// x/text/unicode/norm's `_decomps` returns [19105]byte, `_nfkcValues`
// [6208]uint16, and there are five more - is loaded and returned as one SSA
// aggregate value. SROA scalarizes that value into one element per instruction
// and the next pass then works on a basic block of 38,000 instructions: the
// -O2 pipeline peaked at 10 GB of RSS and ran for minutes on that ONE package,
// which is not a build a 16 GB machine can run (measured with
// `-opt-bisect-limit`: the blow-up is inside `cgscc(function(sroa,early-cse))`
// on `norm._decomps`).
//
// Such a function is cold, generated, and already a memcpy of constant data, so
// there is nothing for the optimizer to win: skipping it costs nothing and
// bounds the compile. `noinline` is part of the same decision - inlining a
// 19 KB aggregate into its callers is what made the optimized module 6 MB from
// a 730 KB input.
const bigAggregateElems = int64(512)

// typeBigArray reports whether t is an array (or an array of arrays) with at
// least bigAggregateElems elements. Slices and pointers do NOT count: their
// storage is behind a pointer, which is not carried by value.
func typeBigArray(t Type, depth int32) (ok bool) {
	if t == nil || depth > 3 {
		return false
	}
	switch u := SafeUnderlying(t).(type) {
	case *Array:
		if u.Len >= bigAggregateElems {
			return true
		}
		return typeBigArray(u.Elem, depth+1)
	}
	return false
}

// fnCarriesBigAggregate reports whether f's signature or any of its locals
// carries a table-sized array by value.
func fnCarriesBigAggregate(f *SSAFunction) (ok bool) {
	if f.Signature != nil {
		if r := f.Signature.Results; r != nil {
			for i := int32(0); i < r.Len(); i++ {
				if typeBigArray(r.At(i).Typ, 0) {
					return true
				}
			}
		}
		if p := f.Signature.Params; p != nil {
			for i := int32(0); i < p.Len(); i++ {
				if typeBigArray(p.At(i).Typ, 0) {
					return true
				}
			}
		}
	}
	for _, a := range f.Locals {
		if typeBigArray(a.SSAType(), 0) {
			return true
		}
	}
	return false
}

// emitFunctionOf is a FREE function on purpose, like emitIR and
// emitAllFunctions. `emitFunction` was a method, so the emitter's sovereign
// arena was borrowed for the WHOLE function and nothing allocated under that
// borrow - including the decode copies of every string an accessor returns
// (`x.SSAName()` on any SSAValue) - could be compacted until the function
// ended. Measured on `strconv`: 4.5M sovAddRec records and a 219 MB record
// table inside one function's emit, 1.2 GB -> 3.3 GB.
func emitFunctionOf(e *irEmitter, f *SSAFunction) {
	e.w("; [emit] " | f.name | "\n")
	sym := e.funcSymbol(f)
	if len(sym) > 5 && (mxutil.HasPrefix(sym, "@llvm.") || mxutil.HasPrefix(sym, "@\"llvm.")) {
		e.emitFuncDecl(f)
		return
	}
	if len(f.Blocks) == 0 {
		// If function has a linkname, the declare uses the target symbol
		// but consuming packages reference the original fully-qualified name.
		// Emit a forwarding wrapper so the linker can resolve both.
		if cctx.linknameMap != nil {
			if target, ok := cctx.linknameMap[f.name]; ok {
				pkg := e.pkg.Pkg.Path
				if f.Pkg != nil {
					pkg = f.Pkg.Pkg.Path
				}
				pkgDot := pkg | "."
				origSym := irGlobalSymbol(pkg, f.name)
				tgtSym := sym // already the linkname target from funcSymbol
				if !mxutil.HasPrefix(target, pkgDot) {
					e.emitFuncDecl(f)
					if origSym != tgtSym {
						e.emitLinknameForwarder(f, origSym, tgtSym)
					}
					return
				}
				if origSym == tgtSym {
					// Self-referential linkname: the target is this
					// declaration's own fully-qualified name and the body
					// lives in another package, so declare it.
					e.emitFuncDecl(f)
					return
				}
				// Same-package foreign spelling (net/url.URL.setPath): the
				// body is emitted under the Moxie name, and nothing in Moxie
				// links against the foreign spelling, so leave it empty.
				return
			}
		}
		e.emitFuncDecl(f)
		return
	}
	e.curFunc = f
	markIndexAccesses(f)
	e.arenaActive = false
	e.arenaBorrowed = false
	// Per-frame arena state must be cleared for every function: the prologue
	// emitters set it and the epilogue reads it, so a set flag leaking into
	// the next function makes it pop a stable-arena registration it never
	// made. The Ensure instantiation for []*K emitted SovereignRegRestore
	// with no matching SovereignRegStable, clearing the receiver's
	// registration on the first helper call so every later element
	// relocation fell back to a deep copy.
	e.stableReg = false
	e.sovereignGroupReg = ""
	e.parentArenaReg = ""
	e.initArenaNum = 0
	markReturnEscapes(f)
	e.nextReg = 0
	e.deferList = nil
	e.deferID = 0
	e.deferFrame = ""
	e.deferLanding = ""
	e.deferCheckpointOn = false
	e.valName = map[SSAValue]string{}
	e.nameUsed = map[string]bool{}
	e.allocTypes = map[SSAValue]string{}
	e.regTypes = map[string]string{}
	e.blockExitLabel = map[int32]string{}
	e.typeCache = map[Type]string{}
	usedNames := map[string]int32{}
	for i, p := range f.Params {
		pname := p.SSAName()
		if pname == "" {
			pname = "p" | irItoa(i)
		}
		if cnt, ok := usedNames[pname]; ok {
			pname = pname | "." | irItoa(cnt)
		}
		usedNames[p.SSAName()]++
		e.valName[p] = "%" | pname
		e.nameUsed["%" | pname] = true
	}

	e.w("\ndefine ")
	// Legacy hides every function that is not explicitly exported: hidden
	// symbols are not part of the dynamic symbol table, so --gc-sections is
	// free to drop them and wasm-ld's --export-dynamic sees only the intended
	// export surface. Without this every function survives and every symbol
	// name is exported, which is both a size and an interface leak.
	if f.parent != nil || f.externalSymbol == "" {
		e.w("hidden ")
	}
	retType := e.funcRetType(f)
	useSret := needsSret(retType)
	e.sretType = ""
	if useSret {
		e.w("void ")
		e.sretType = retType
	} else {
		e.w(retType)
		e.w(" ")
	}
	e.w(e.funcSymbol(f))
	e.w("(")
	nParam := 0
	if useSret {
		e.w("ptr sret(") ; e.w(retType) ; e.w(") %retval")
		nParam++
	}
	isExport := f.externalSymbol != ""
	for _, p := range f.Params {
		if nParam > 0 { e.w(", ") }
		pt := e.llvmType(p.SSAType())
		if pt == "void" {
			pt = "ptr"
		}
		e.w(pt)
		e.w(" ")
		e.w(e.regName(p))
		nParam++
	}
	if !isExport {
		if nParam > 0 { e.w(", ") }
		e.w("ptr %_ctx")
	}
	e.w(")")
	// A function that carries a generated data table BY VALUE is kept out of
	// the optimizer. See bigAggregateElems.
	if fnCarriesBigAggregate(f) {
		e.w(" noinline optnone")
	}
	e.w(" {\n")
	fnBodyStart := int32(len(e.segs)) // segment index where this function's body starts

	// Pre-scan: set allocTypes, detect cross-block alloca references
	e.allocBlock = map[SSAValue]int32{}
	for _, b := range f.Blocks {
		for _, instr := range b.Instrs {
			if n, ok := instr.(*SSANext); ok {
				if ri, ok2 := n.Iter.(*SSARange); ok2 {
					if arr, ok3 := SafeUnderlying(ri.X.SSAType()).(*Array); ok3 {
						elemType := e.llvmType(arr.Elem)
						e.allocTypes[n] = "{i1, i32, " | elemType | "}"
					} else if sl, ok3b := SafeUnderlying(ri.X.SSAType()).(*Slice); ok3b {
						elemType := e.llvmType(sl.Elem)
						e.allocTypes[n] = "{i1, i32, " | elemType | "}"
					}
				}
			}
			if c, ok := instr.(*SSACall); ok {
				if b2, ok2 := c.Call.Value.(*SSABuiltin); ok2 && b2.SSAName() == "recover" {
					e.allocTypes[c] = e.ifaceType()
				}
			}
			if a, ok := instr.(*SSAAlloc); ok {
				e.allocBlock[a] = b.Index
			}
		}
	}
	hoistAllocs := map[SSAValue]bool{}
	for _, b := range f.Blocks {
		for _, instr := range b.Instrs {
			e.instrOperands(instr)
			for _, ref := range e.operandBuf {
				if ab, ok := e.allocBlock[ref]; ok && ab != 0 && ab != b.Index {
					hoistAllocs[ref] = true
				}
			}
		}
	}
	e.hoisted = hoistAllocs
	// Heap allocas must stay where they are declared: they emit a
	// runtime.alloc call, so hoisting one to the entry block reorders a side
	// effect ahead of everything that precedes its declaration. runtime.main
	// takes the address of its rlimit buffer, and hoisting that allocation
	// ran it before initDomain ("alloc: domainRoot not initialized"). The
	// legacy compiler emits the same allocation at its declaration point.
	hoisted := map[SSAValue]bool{}
	for _, hb := range f.Blocks {
		for _, hinstr := range hb.Instrs {
			if a, ok := hinstr.(*SSAAlloc); ok && hoistAllocs[a] && !a.Heap {
				hoisted[a] = true
			}
		}
	}
	e.hoisted = hoisted
	e.missingStores = nil
	// MX_EMIT_TRACE=<member>: name every operand of one body as it is visited,
	// before it is hashed. A dangling SSA name crashes the hash below, and the
	// last line printed is the operand that carried it.
	traceFn := getenv("MX_EMIT_TRACE")
	tr := traceFn != "" && traceFn == f.name
	if tr {
		n := int32(0)
		for _, tb := range f.Blocks {
			for _, ti := range tb.Instrs {
				e.instrOperands(ti)
				for j, to := range e.operandBuf {
					if to == nil {
						continue
					}
					mxutil.WriteStr(2, "TRO i=" | mxutil.SimpleItoa(n) | " op=" | mxutil.SimpleItoa(j) | " k=" | ssaValTag(to) | "\n")
				}
				n++
			}
		}
	}
	e.storedTo = map[string]bool{}
	for _, b := range f.Blocks {
		for _, instr := range b.Instrs {
			if s, ok := instr.(*SSAStore); ok && s.Addr != nil {
				if tr {
					mxutil.WriteStr(2, "TRS " | s.Addr.SSAName() | "\n")
				}
				e.storedTo[s.Addr.SSAName()] = true
			}
		}
	}
	e.usedAs = map[string]bool{}
	instrNo := int32(0)
	e.faByBase = map[string][]*SSAFieldAddr{}
	e.mulByBase = map[string][]string{}
	e.devByAddr = map[string][]*SSAStore{}
	e.ldByName = map[string][]*SSAUnOp{}
	for _, b := range f.Blocks {
		for _, instr := range b.Instrs {
			e.instrOperands(instr)
			for j, ref := range e.operandBuf {
				if ref != nil {
					if tr {
						mxutil.WriteStr(2, "TRU i=" | mxutil.SimpleItoa(instrNo) | " op=" | mxutil.SimpleItoa(j) | " k=" | ssaValTag(ref) | " n=" | ref.SSAName() | "\n")
					}
					e.usedAs[ref.SSAName()] = true
				}
			}
			instrNo++
			switch i := instr.(type) {
			case *SSAFieldAddr:
				if i.X != nil {
					k := i.X.SSAName()
					sl := e.faByBase[k]
					push(sl, i)
					e.faByBase[k] = sl
				}
			case *SSAUnOp:
				if i.Op == OpMul && i.X != nil {
					k := i.X.SSAName()
					sl := e.mulByBase[k]
					push(sl, i.SSAName())
					e.mulByBase[k] = sl
				}
				ln := i.SSAName()
				ls := e.ldByName[ln]
				push(ls, i)
				e.ldByName[ln] = ls
			case *SSAStore:
				if i.Addr != nil {
					k := i.Addr.SSAName()
					sl := e.devByAddr[k]
					push(sl, i)
					e.devByAddr[k] = sl
				}
			}
		}
	}
	for _, b := range f.Blocks {
		for i := 0; i+1 < len(b.Instrs); i++ {
			load, isLoad := b.Instrs[i].(*SSAUnOp)
			if !isLoad || load.Op != OpMul {
				continue
			}
			alloc, isAlloc := b.Instrs[i+1].(*SSAAlloc)
			if !isAlloc {
				continue
			}
			if !e.usedAs[load.SSAName()] && !e.storedTo[alloc.SSAName()] && hoistAllocs[alloc] {
				srcAlloc, isSrcAlloc := load.X.(*SSAAlloc)
				if !isSrcAlloc {
					continue
				}
				srcType := e.llvmType(srcAlloc.SSAType())
				if p, ok := SafeUnderlying(srcAlloc.SSAType()).(*Pointer); ok && p.Base != nil {
					srcType = e.llvmType(p.Base)
				}
				if len(srcType) > 0 && srcType[0] == '[' {
					if e.missingStores == nil {
						e.missingStores = map[SSAValue]SSAValue{}
					}
					e.missingStores[load] = alloc
					e.allocTypes[alloc] = srcType
				}
			}
		}
	}
	// Presized, then written through a cursor. Growing this with
	// `hoistList = mxutil.Ensure(hoistList, 1); push(...)` was quadratic:
	// Ensure RETURNS []*SSAAlloc, and a returned slice of pointers is deep-copied
	// by the return protocol - every element reaches its block, its function and
	// through that the package - so each push copied the whole list. Measured:
	// `math.Erfinv`, 22 blocks, 2 GB inside one function's emit.
	hoistN := int32(0)
	for _, hb := range f.Blocks {
		for _, hinstr := range hb.Instrs {
			if a, ok := hinstr.(*SSAAlloc); ok && hoisted[a] {
				hoistN++
			}
		}
	}
	hoistList := []*SSAAlloc{:hoistN}
	hoistI := int32(0)
	// Collect allocas deterministically: iterate blocks/instructions in order
	// (both are slices). Using hoisted map only as a set membership check.
	for _, hb := range f.Blocks {
		for _, hinstr := range hb.Instrs {
			if a, ok := hinstr.(*SSAAlloc); ok && hoisted[a] {
				hoistList[hoistI] = a
				hoistI++
			}
		}
	}
	for i := 1; i < len(hoistList); i++ {
		for j := i; j > 0 && hoistList[j].SSAName() < hoistList[j-1].SSAName(); j-- {
			hoistList[j], hoistList[j-1] = hoistList[j-1], hoistList[j]
		}
	}
	// Same presize rule as hoistList: a returned []*SSADefer reaches the whole
	// function graph.
	deferN := int32(0)
	for _, b := range f.Blocks {
		for _, instr := range b.Instrs {
			if _, ok := instr.(*SSADefer); ok {
				deferN++
			}
		}
	}
	e.deferList = []*SSADefer{:deferN}
	deferI := int32(0)
	for _, b := range f.Blocks {
		for _, instr := range b.Instrs {
			if d, ok := instr.(*SSADefer); ok {
				e.deferList[deferI] = d
				deferI++
			}
		}
	}
	for _, b := range f.Blocks {
		if b.Index == 0 {
			e.w("bb.entry:\n")
			e.currentEmitBlock = b
			for _, a := range hoistList {
				e.emitAlloc(a)
			}
			if len(e.deferList) > 0 {
				e.w("  %deferPtr = alloca ptr\n")
				e.w("  store ptr null, ptr %deferPtr\n")
				e.emitDeferFrameSetup()
			}
			if len(e.curFunc.FreeVars) > 0 {
				e.emitFreeVarUnpack(e.curFunc)
			}
			e.emitArenaPrologue()
			e.deferCheckpointOn = e.deferFrame != ""
			for _, instr := range b.Instrs {
				e.emitInstr(instr)
			}
			e.deferCheckpointOn = false
			e.flushPhiTruncs()
		} else {
			emitBlockOf(e, b)
		}
		// Between two blocks the emitter's group has no live frame (each e.*
		// call borrows and pops), so what the block abandoned is reclaimable
		// here. Without this the group is drained once per function, and a
		// function is where `strconv` spent 3.3 GB.
		runtime.SovDrainCompactions(8)
	}
	e.hoisted = nil
	e.hoistAllocaText(fnBodyStart)

	if e.deferFrame != "" && e.curFunc.Recover != nil {
		// Landing pad: runs the defers after a panic, then returns the
		// named results through the recover block.
		e.deferCheckpointOn = false
		e.w(e.deferLanding)
		e.w(":\n")
		e.emitRunDefers()
		e.w("  br label ")
		e.w(e.blockLabel(e.curFunc.Recover))
		e.w("\n")
	}

	e.w("}\n")
	// The per-function scratch high-water mark, read in the arena the emit loop
	// made current for this function (fnArena). This is the number that says
	// whether an 80MB capacity spike is data or a segment grabbed for a little:
	// `acap` cannot tell those apart, `used` can.
	if getenv("MOXIE_EMIT_USED") != "" {
		nins := int32(0)
		for _, b := range f.Blocks {
			if b != nil {
				nins += int32(len(b.Instrs))
			}
		}
		mxutil.WriteStr(2, "    EMITUSED fn=" | f.name | " used=" | mxutil.SimpleItoa(int32(runtime.ArenaUsed(runtime.CurrentArena())>>10)) | "KB instrs=" | mxutil.SimpleItoa(nins) | "\n")
	}
}

func (e *irEmitter) emitFuncDecl(f *SSAFunction) {
	sym := e.funcSymbol(f)
	bareKey := sym
	if len(bareKey) > 0 && bareKey[0] == '@' {
		bareKey = bareKey[1:]
	}
	if _, ok := e.extDecls[bareKey]; ok {
		return
	}
	for _, p := range e.pendExtDecls {
		if p.k == bareKey { return }
	}
	retType := e.funcRetType(f)
	useSret := needsSret(retType)
	decl := ""
	if useSret {
		decl = "void "
	} else {
		decl = retType | " "
	}
	decl = decl | sym | "("
	n := 0
	if useSret {
		decl = decl | "ptr"
		n++
	}
	isIntrinsic := mxutil.HasPrefix(sym, "@llvm.") || mxutil.HasPrefix(sym, "@\"llvm.")
	hasRecv := f.Signature != nil && f.Signature.Recv != nil
	if hasRecv {
		if n > 0 { decl = decl | ", " }
		decl = decl | "ptr"
		n++
	}
	if f.Signature != nil && f.Signature.Params != nil {
		for i := 0; i < f.Signature.Params.Len(); i++ {
			if n > 0 {
				decl = decl | ", "
			}
			pt := e.llvmType(f.Signature.Params.At(i).Typ)
			if pt == "" || pt == "void" {
				pt = "ptr"
			}
			decl = decl | pt
			n++
		}
	}
	// An exported symbol is C ABI: no hidden context argument. This is the
	// declaration every bodyless function gets, and it is where the extra
	// parameter came from:
	//
	//	declare i64 @strlen(ptr, ptr)      ; here
	//	call    i64 @strlen(ptr nonnull)   ; at every call site
	//
	// Native is quiet about it (libc defines strlen and the declaration is
	// only a name); wasm-ld compares the definition it synthesises from this
	// declaration with the calls and replaces each mismatched callee with a
	// trap named `signature_mismatch:strlen`.
	if !isIntrinsic && !e.externDropsCtx(f) {
		if n > 0 { decl = decl | ", " }
		decl = decl | "ptr"
	}
	decl = decl | ")"
	bareKey := sym
	if len(bareKey) > 0 && bareKey[0] == '@' {
		bareKey = bareKey[1:]
	}
	e.appendEmitKV(emitKV{bareKey, decl})
}

// emitLinknameForwarder emits a thin wrapper definition with origSym that
// calls tgtSym. This allows consuming packages (which reference origSym)
// to resolve to the linkname target (tgtSym) at link time.
func (e *irEmitter) emitLinknameForwarder(f *SSAFunction, origSym, tgtSym string) {
	retType := e.funcRetType(f)
	useSret := needsSret(retType)
	// Build parameter list with names
	var paramTypes []string
	var paramArgs []string
	idx := int32(0)
	if useSret {
		pn := "%sret"
		push(paramTypes, "ptr " | pn)
		push(paramArgs, "ptr " | pn)
		idx++
	}
	hasRecv := f.Signature != nil && f.Signature.Recv != nil
	if hasRecv {
		pn := "%p" | irItoa(idx)
		push(paramTypes, "ptr " | pn)
		push(paramArgs, "ptr " | pn)
		idx++
	}
	if f.Signature != nil && f.Signature.Params != nil {
		for i := 0; i < f.Signature.Params.Len(); i++ {
			pt := e.llvmType(f.Signature.Params.At(i).Typ)
			if pt == "" || pt == "void" { pt = "ptr" }
			pn := "%p" | irItoa(idx)
			push(paramTypes, pt | " " | pn)
			push(paramArgs, pt | " " | pn)
			idx++
		}
	}
	// context pointer
	ctxPN := "%p" | irItoa(idx)
	push(paramTypes, "ptr " | ctxPN)
	push(paramArgs, "ptr " | ctxPN)
	// Emit define
	e.w("\ndefine ")
	if useSret {
		e.w("void ")
	} else {
		e.w(retType) ; e.w(" ")
	}
	e.w(origSym) ; e.w("(")
	for i, pt := range paramTypes {
		if i > 0 { e.w(", ") }
		e.w(pt)
	}
	e.w(") {\n")
	if useSret || retType == "void" {
		e.w("  call void ") ; e.w(tgtSym) ; e.w("(")
		for i, pa := range paramArgs {
			if i > 0 { e.w(", ") }
			e.w(pa)
		}
		e.w(")\n  ret void\n")
	} else {
		e.w("  %fwd = call ") ; e.w(retType) ; e.w(" ") ; e.w(tgtSym) ; e.w("(")
		for i, pa := range paramArgs {
			if i > 0 { e.w(", ") }
			e.w(pa)
		}
		e.w(")\n  ret ") ; e.w(retType) ; e.w(" %fwd\n")
	}
	e.w("}\n")
}

// emitCoverHitLine emits the -cover hit for a statement: one counter, labelled
// "pkg.Func@file:line" in the site table the compiler writes beside the output
// (writeCoverSites). Emitted from the SSACoverHit instruction the builder
// places at each statement, so the label is the statement's own line. Without
// -cover it emits nothing.
//
// Only user packages are instrumented: stdlib and runtime code is not what a
// coverage run is measuring, and instrumenting the runtime's own coverHit would
// have it call itself.
func (e *irEmitter) emitCoverHitLine(line int32) {
	if bst == nil || !bst.cover {
		return
	}
	if e.curFunc == nil || e.curFunc.Pkg == nil || e.curFunc.Pkg.Pkg == nil {
		return
	}
	if !coverPkg(e.curFunc.Pkg.Pkg.Path) {
		return
	}
	file, srcLine := concatLineToFile(line)
	file = coverReportFile(e.curFunc.Pkg.Pkg.Path, coverModPrefix(), file)
	siteName := e.funcRelName() | "@" | file | ":" | irItoa(srcLine)
	id := addCoverSite(siteName)
	if id < 0 {
		return
	}
	e.w("  call void @runtime.coverHit(i32 ")
	e.w(irItoa(id))
	e.w(", ptr null)\n")
	e.declareRuntime("runtime.coverHit", "void", "i32")
}

// emitBlockOf is free like emitFunctionOf: as a method its borrow was live for
// the whole block, so nothing the block's instructions allocated could be
// compacted until it returned - and one block of `math.Erfinv` is enough to
// exhaust the box.
func emitBlockOf(e *irEmitter, b *SSABasicBlock) {
	// A dotted label cannot collide with a source identifier: LLVM gives
	// blocks and values one namespace, so a parameter named `b1` used to
	// clash with generated block `b1` and clang rejected the module
	// ("'%b1' is not a basic block").
	label := "bb." | irItoa(b.Index)
	if b.Index == 0 {
		label = "bb.entry"
	}
	e.w(label)
	e.w(":\n")
	e.blockExitLabel[b.Index] = "%" | label
	e.currentEmitBlock = b

	if b.Index == 0 && len(e.curFunc.FreeVars) > 0 {
		e.emitFreeVarUnpack(e.curFunc)
	}

	e.blockDead = false
	e.deferCheckpointOn = e.deferFrame != "" && (e.curFunc.Recover == nil || b != e.curFunc.Recover)
	phiFlushed := false
	// A block is where an emit cost hides: `strconv.initPow10` puts 7025
	// instructions in ONE block, so a per-function report shows only the total
	// and cannot say what the instructions spent it on. Every 1000 instructions
	// the live scratch and the cumulative size histogram are printed, so two
	// consecutive lines differ by exactly what those 1000 instructions
	// allocated - and the bins name the shape of the allocation.
	nInstr := int32(0)
	for _, instr := range b.Instrs {
		if e.blockDead { break }
		nInstr++
		if len(b.Instrs) > 1500 && nInstr%1000 == 0 {
			cnts, byts := runtime.AllocHistogram()
			hs := ""
			for bi := int32(12); bi < int32(21) && bi < int32(len(byts)); bi++ {
				hs = hs | " " | mxutil.SimpleItoa(bi) | ":" | mxutil.SimpleItoa(int32(byts[bi] >> 20))
			}
			mxutil.WriteStr(2, "    BLOCKSTEP fn="|e.funcRelName()|" n="|mxutil.SimpleItoa(nInstr)|" scratch="|mxutil.SimpleItoa(int32(runtime.ArenaUsed(runtime.CurrentArena())>>20))|"MB hist"|hs|"\n")
		}
		if !phiFlushed {
			if _, isPhi := instr.(*SSAPhi); !isPhi {
				phiFlushed = true
				e.flushPhiTruncs()
			}
		}
		e.emitInstr(instr)
		if e.missingStores != nil {
			if v, ok2 := instr.(SSAValue); ok2 {
				if dst, ok3 := e.missingStores[v]; ok3 {
					loadReg := e.regName(v)
					dstReg := e.regName(dst)
					arrType := e.allocTypes[dst]
					e.w("  store ") ; e.w(arrType) ; e.w(" ") ; e.w(loadReg) ; e.w(", ptr ") ; e.w(dstReg) ; e.w("\n")
				}
			}
		}
	}
	e.deferCheckpointOn = false

	e.flushPhiTruncs()
	hasTerminator := e.blockDead
	if !hasTerminator {
		if n := len(b.Instrs); n > 0 {
			switch b.Instrs[n-1].(type) {
			case *SSAJump, *SSAIf, *SSAReturn:
				hasTerminator = true
			}
		}
	}
	if !hasTerminator {
		e.w("  unreachable\n")
	}
}

func (e *irEmitter) blockLabel(b *SSABasicBlock) (s string) {
	if b.Index == 0 {
		return "%bb.entry"
	}
	return "%bb." | irItoa(b.Index)
}

func (e *irEmitter) emitInstr(instr SSAInstruction) {
	switch i := instr.(type) {
	case *SSAAlloc:
		if e.hoisted != nil && e.hoisted[i] {
			break
		}
		e.emitAlloc(i)
		e.bindSpawnClosed(i)
	case *SSACoverHit:
		e.emitCoverHitLine(i.Line)
	case *SSAStore:
		e.emitStore(i)
	case *SSABinOp:
		if !i.absorbed {
			e.emitBinOp(i)
		}
	case *SSAUnOp:
		e.emitUnOp(i)
	case *SSACall:
		e.emitCall(i)
	case *SSAPhi:
		e.emitPhi(i)
	case *SSAReturn:
		e.emitReturn(i)
	case *SSAJump:
		e.emitJump(i)
	case *SSAIf:
		e.emitIf(i)
	case *SSAConvert:
		e.emitConvert(i)
	case *SSAChangeType:
		e.emitChangeType(i)
	case *SSATypeDesc:
		e.emitTypeDescAddr(i)
	case *SSAFieldAddr:
		e.emitFieldAddr(i)
	case *SSAIndexAddr:
		e.emitIndexAddr(i)
	case *SSAExtract:
		e.emitExtract(i)
	case *SSAMakeSlice:
		e.emitMakeSlice(i)
	case *SSAConstMemCpy:
		e.emitConstMemCpy(i)
	case *SSASlice:
		e.emitSliceOp(i)
	case *SSAMakeInterface:
		e.emitMakeInterface(i)
	case *SSAInvoke:
		e.emitInvoke(i)
	case *SSATypeAssert:
		e.emitTypeAssert(i)
	case *SSAMakeMap:
		e.emitMakeMap(i)
	case *SSAMapUpdate:
		e.emitMapUpdate(i)
	case *SSALookup:
		e.emitLookup(i)
	case *SSAMakeClosure:
		e.emitMakeClosure(i)
	case *SSAPanic:
		e.emitPanic(i)
	case *SSARunDefers:
		e.emitRunDefers()
	case *SSADefer:
		e.emitDefer(i)
	case *SSASend:
		e.emitChanSend(i)
	case *SSASelect:
		e.emitSelect(i)
	case *SSARootLoad:
		e.emitRootLoad(i)
	case *SSARange:
		e.emitRange(i)
	case *SSANext:
		e.emitNext(i)
	case *SSAMakeChan:
		e.emitMakeChan(i)
	case *SSAMakeEdge:
		e.emitMakeEdge(i)
	}
}

func (e *irEmitter) emitStore(s *SSAStore) {
	if s.Val == nil || s.Addr == nil {
		e.w("  ; store with nil val/addr\n")
		return
	}
	valType := e.llvmType(s.Val.SSAType())
	val := e.operand(s.Val)
	if load, ok := s.Val.(*SSAUnOp); ok && load.Op == OpMul {
		if g, ok2 := load.X.(*SSAGlobal); ok2 {
			valType = e.resolveGlobalDeclType(g)
		}
	}
	_, isStoreAlloc := s.Val.(*SSAAlloc)
	_, isStoreIA := s.Val.(*SSAIndexAddr)
	if !isStoreAlloc && !isStoreIA {
		if at, ok := e.allocTypes[s.Val]; ok && at != valType {
			bothScalar := len(valType) > 0 && valType[0] == 'i' && len(at) > 0 && at[0] == 'i'
			if !bothScalar {
				valType = at
				if val == "null" && valType != "ptr" {
					val = "zeroinitializer"
				}
			} else if irParseIntWidth(at) > irParseIntWidth(valType) {
				valType = at
			}
		}
	}
	if len(valType) > 0 && (valType[0] == '[' || valType[0] == '{') {
		if addrAt, ok := e.allocTypes[s.Addr]; ok && addrAt != valType {
			if len(valType) >= len(addrAt) || (valType[0] == '[' && addrAt[0] == '{') {
				e.allocTypes[s.Addr] = valType
			}
		}
	}
	if valType == "void" {
		if at, ok := e.allocTypes[s.Addr]; ok && at != "ptr" && at != "void" {
			valType = at
			if val == "null" && valType != "ptr" {
				val = "zeroinitializer"
			}
		}
	} else if valType == "ptr" {
		if uop, ok := s.Val.(*SSAUnOp); ok && uop.Op == OpMul {
			if at, ok2 := e.allocTypes[s.Addr]; ok2 && at != "ptr" && at != "void" {
				valType = at
				if val == "null" && valType != "ptr" {
					val = "zeroinitializer"
				}
			}
		}
	}
	if valType == "void" {
		if _, isFV := s.Addr.(*SSAFreeVar); isFV {
			valType = e.llvmType(s.Addr.SSAType())
		} else if p, ok := SafeUnderlying(s.Addr.SSAType()).(*Pointer); ok {
			valType = e.llvmType(p.Base)
		}
		if valType == "void" {
			valType = "ptr"
		}
		if val == "null" && valType != "ptr" {
			val = "zeroinitializer"
		}
	}
	addr := e.operand(s.Addr)
	if at, ok := e.allocTypes[s.Addr]; ok && (at == "double" || at == "float") && len(valType) > 0 && valType[0] == 'i' {
		if isConstOperand(val) {
			val = ensureFloatLit(val)
		} else {
			e.nextReg++
			conv := "%si2f" | irItoa(e.nextReg)
			e.w("  ") ; e.w(conv) ; e.w(" = sitofp ") ; e.w(valType) ; e.w(" ") ; e.w(val) ; e.w(" to ") ; e.w(at) ; e.w("\n")
			val = conv
		}
		valType = at
	}
	if at, ok2 := e.allocTypes[s.Addr]; ok2 && len(at) > 0 && at[0] == '{' && len(valType) > 0 && valType[0] == 'i' {
		if val == "0" || val == "zeroinitializer" {
			val = "zeroinitializer"
			valType = at
		}
	}
	if at, ok2 := e.allocTypes[s.Addr]; ok2 && len(at) > 0 && at[0] == 'i' && len(valType) > 0 && valType[0] == '{' {
		valType = at
		val = "zeroinitializer"
	}
	if p, ok := SafeUnderlying(s.Addr.SSAType()).(*Pointer); ok {
		elemT := e.llvmType(p.Base)
		if len(elemT) > 1 && elemT[0] == 'i' && len(valType) > 1 && valType[0] == 'i' && elemT != valType {
			vw := irParseIntWidth(valType)
			ew := irParseIntWidth(elemT)
			if ew > 0 && vw > ew {
				e.nextReg++
				trunc := "%tr" | irItoa(e.nextReg)
				e.w("  ")
				e.w(trunc)
				e.w(" = trunc ")
				e.w(valType)
				e.w(" ")
				e.w(val)
				e.w(" to ")
				e.w(elemT)
				e.w("\n")
				val = trunc
				valType = elemT
			} else if ew > 0 && vw > 0 && vw < ew {
				if c, ok2 := s.Val.(*SSAConst); ok2 {
					if ci, ok3 := c.val.(*ConstInt); ok3 {
						val = irItoa64(ci.V)
						valType = elemT
					} else {
						valType = elemT
					}
				} else {
					e.nextReg++
					ext := "%se" | irItoa(e.nextReg)
					// Source signedness decides the extension (Go semantics).
					extOp := "sext"
					if b, ok4 := SafeUnderlying(s.Val.SSAType()).(*Basic); ok4 && b.Info&IsUnsigned != 0 {
						extOp = "zext"
					}
					e.w("  ")
					e.w(ext)
					e.w(" = ") ; e.w(extOp) ; e.w(" ")
					e.w(valType)
				e.w("  ")
					e.w(val)
					e.w(" to ")
					e.w(elemT)
					e.w("\n")
					val = ext
					valType = elemT
				}
			}
		}
	}
	// A zero store of an AGGREGATE is a memset, exactly like a zeroed alloca.
	// One `store {big} zeroinitializer` is expanded by the backend into one
	// store per 8 bytes; for flate.Writer that is ~80k stores on a 640KB
	// object, and clang's DAG combiner segfaulted in
	// SelectionDAG::ReplaceAllUsesWith on it. emitZeroInit already exists for
	// this reason (see its comment); an explicit zero store is no different.
	if val == "zeroinitializer" && len(valType) > 0 && (valType[0] == '{' || valType[0] == '[') {
		e.emitZeroInit(addr, valType)
		return
	}
	e.w("  store ")
	e.w(valType)
	e.w(" ")
	e.w(val)
	e.w(", ptr ")
	e.w(addr)
	e.w("\n")
}

func (e *irEmitter) emitPhi(p *SSAPhi) {
	reg := e.regName(p)
	typ := e.llvmType(p.SSAType())
	blk := e.currentEmitBlock
	if blk == nil {
		return
	}
	// Collect operands and check for i1/i32 mismatch.
	ops := []string{:len(p.Edges):len(p.Edges)}
	widen := false
	if typ == "i1" {
		for i, edge := range p.Edges {
			ops[i] = e.operand(edge)
			if !widen && len(ops[i]) > 0 && ops[i][0] == '%' {
				if rt, ok := e.regTypes[ops[i]]; ok && rt == "i32" {
					widen = true
				}
			}
		}
	}
	if !widen {
		// Normal path: emit phi as-is.
		for i, edge := range p.Edges {
			if ops[i] == "" {
				ops[i] = e.operand(edge)
			}
		}
		e.w("  ") ; e.w(reg) ; e.w(" = phi ") ; e.w(typ) ; e.w(" ")
		for i, op := range ops {
			if i > 0 { e.w(", ") }
			e.w("[") ; e.w(op) ; e.w(", ")
			e.emitPhiPred(blk, i)
			e.w("]")
		}
		e.w("\n")
		return
	}
	// Widen i1 phi to i32 to match edge types, trunc after all phis.
	rawReg := e.nextReg2("phw")
	e.w("  ") ; e.w(rawReg) ; e.w(" = phi i32 ")
	for i, op := range ops {
		if i > 0 { e.w(", ") }
		e.w("[")
		if op == "false" { op = "0" }
		if op == "true" { op = "1" }
		e.w(op) ; e.w(", ")
		e.emitPhiPred(blk, i)
		e.w("]")
	}
	e.w("\n")
	push(e.pendingPhiTruncs, phiTrunc{rawReg, reg, "i32", "i1"})
}

func (e *irEmitter) emitPhiPred(blk *SSABasicBlock, i int32) {
	if i < len(blk.Preds) {
		pred := blk.Preds[i]
		if pred != nil {
			if exitLbl, ok := e.blockExitLabel[pred.Index]; ok {
				e.w(exitLbl)
			} else {
				e.w(e.blockLabel(pred))
			}
			return
		}
	}
	e.w("%unknown")
}

func (e *irEmitter) flushPhiTruncs() {
	for _, pt := range e.pendingPhiTruncs {
		e.w("  ") ; e.w(pt.dstReg) ; e.w(" = trunc ") ; e.w(pt.from) ; e.w(" ") ; e.w(pt.rawReg) ; e.w(" to ") ; e.w(pt.to) ; e.w("\n")
	}
	e.pendingPhiTruncs = resize(e.pendingPhiTruncs, 0)
}

// returnOperand coerces a return value to the declared result type, converting
// width, pointer/int and zero mismatches. Same conversions the single-result
// return path applies.
func (e *irEmitter) returnOperand(res SSAValue, expectType string) (val string) {
	typ := e.llvmType(res.SSAType())
	val = e.operand(res)
	if typ == "void" {
		typ = expectType
	}
	if expectType == "void" {
		expectType = typ
	}
	if val == "null" && expectType != "ptr" {
		return "zeroinitializer"
	}
	val = e.coerceInt(val, typ, expectType, e.isUnsignedType(res.SSAType()))
	if typ != expectType && val != "zeroinitializer" {
		if expectType == "ptr" && e.intBits(typ) > 0 {
			e.nextReg++
			rc := "%rc" | irItoa(e.nextReg)
			e.w("  ") ; e.w(rc) ; e.w(" = inttoptr ") ; e.w(typ) ; e.w(" ") ; e.w(val) ; e.w(" to ptr\n")
			return rc
		}
		if typ == "ptr" && e.intBits(expectType) > 0 {
			e.nextReg++
			rc := "%rc" | irItoa(e.nextReg)
			e.w("  ") ; e.w(rc) ; e.w(" = ptrtoint ptr ") ; e.w(val) ; e.w(" to ") ; e.w(expectType) ; e.w("\n")
			return rc
		}
		if !(e.intBits(typ) > 0 && e.intBits(expectType) > 0) {
			return "zeroinitializer"
		}
	}
	return val
}

// bindSpawnClosed binds the domain's breaker to a spawn target's `closed`
// result and asserts it: a target called directly has no breaker, and a nil one
// would disable the select's closed arm and run its loop forever.
func (e *irEmitter) bindSpawnClosed(a *SSAAlloc) {
	f := e.curFunc
	if f == nil || !isSpawnTargetSig(f.Signature) || len(f.NamedResults) == 0 {
		return
	}
	if f.NamedResults[0] != a {
		return
	}
	reg := e.nextReg2("brk")
	e.w("  ") ; e.w(reg) ; e.w(" = call ptr @runtime.ClosedBreakerChan(ptr null)\n")
	e.declareRuntime("runtime.ClosedBreakerChan", "ptr", "")
	as := e.nextReg2("brk")
	e.w("  ") ; e.w(as) ; e.w(" = call ptr @runtime.AssertBreaker(ptr ") ; e.w(reg) ; e.w(", ptr null)\n")
	e.declareRuntime("runtime.AssertBreaker", "ptr", "ptr")
	e.w("  store ptr ") ; e.w(as) ; e.w(", ptr ") ; e.w(e.regName(a)) ; e.w("\n")
}

func (e *irEmitter) emitReturn(r *SSAReturn) {
	isRecoverBlock := e.curFunc.Recover != nil && e.currentEmitBlock == e.curFunc.Recover
	// No breaker is closed here. A frame returning is not the owner deciding a
	// domain is finished: the function may be handing the breaker to its caller,
	// which is what a worker-pool constructor does, and closing it there killed
	// the worker microseconds after its thread started. The owner ends a domain
	// with close(breaker); main returning ends every domain with the process.
	e.deferCheckpointOn = false
	// `return expr` with named results assigns the result slots, runs the
	// defers, and returns the slots - the order Go uses. Returning the
	// expression registers directly lost every deferred write to a named
	// result (`defer func(){ n = n + 6 }(); return n` returned the pre-defer
	// value) and left the slot reading as zero inside the defer itself.
	savedIntoResults := false
	if len(e.curFunc.NamedResults) > 0 && !isRecoverBlock && len(r.Results) == len(e.curFunc.NamedResults) {
		for i, res := range r.Results {
			nr := e.curFunc.NamedResults[i]
			nrt := e.namedResultType(nr)
			val := e.returnOperand(res, nrt)
			e.w("  store ") ; e.w(nrt) ; e.w(" ") ; e.w(val) ; e.w(", ptr ") ; e.w(e.regName(nr)) ; e.w("\n")
		}
		savedIntoResults = true
	}
	if len(e.deferList) > 0 && !isRecoverBlock {
		e.emitRunDefers()
	}
	if e.deferFrame != "" {
		e.w("  call void @runtime.destroyDeferFrame(ptr ")
		e.w(e.deferFrame)
		e.w(", ptr null)\n")
		e.declareRuntime("runtime.destroyDeferFrame", "void", "ptr")
	}
	if e.initArenaNum != 0 {
		// Hand the caller's arena back before the return encode: the
		// initialiser ran with the root as its allocation target, and the encode
		// buffer must still be allocated in this frame's arena so it dies with
		// the frame.
		e.w("  call void @runtime.InitArenaRestore(ptr %init_arena") ; e.w(irItoa(e.initArenaNum)) ; e.w(", ptr null)\n")
		e.declareRuntime("runtime.InitArenaRestore", "void", "ptr")
	}
	frt := e.funcRetType(e.curFunc)
	if len(r.Results) == 0 || savedIntoResults {
		rt := e.funcRetType(e.curFunc)
		if rt == "void" {
			// Route through the epilogue: a void method can still be a
			// mutating method on a sovereign receiver, whose prologue borrowed
			// the receiver's data arena and must restore it here.
			e.emitRetWithCodec("void", "")
		} else if len(e.curFunc.NamedResults) > 0 && !isRecoverBlock {
			if len(e.curFunc.NamedResults) == 1 {
				nr := e.curFunc.NamedResults[0]
				nrt := e.namedResultType(nr)
				e.nextReg++
				tmp := "%nr" | irItoa(e.nextReg)
				e.w("  ") ; e.w(tmp) ; e.w(" = load ") ; e.w(nrt) ; e.w(", ptr ") ; e.w(e.regName(nr)) ; e.w("\n")
				if e.sretType != "" {
					e.w("  store ") ; e.w(nrt) ; e.w(" ") ; e.w(tmp) ; e.w(", ptr %retval\n")
					e.w("  ret void\n")
				} else {
					e.emitRetWithCodec(nrt, tmp)
				}
			} else {
				aggRT := rt
				e.nextReg++
				agg := "%nr" | irItoa(e.nextReg)
				e.w("  ") ; e.w(agg) ; e.w(" = alloca ") ; e.w(aggRT) ; e.w("\n")
				e.w("  store ") ; e.w(aggRT) ; e.w(" zeroinitializer, ptr ") ; e.w(agg) ; e.w("\n")
				for i, nr := range e.curFunc.NamedResults {
					nrt := e.namedResultType(nr)
					e.nextReg++
					tmp := "%nr" | irItoa(e.nextReg)
					e.w("  ") ; e.w(tmp) ; e.w(" = load ") ; e.w(nrt) ; e.w(", ptr ") ; e.w(e.regName(nr)) ; e.w("\n")
					e.nextReg++
					gep := "%nr" | irItoa(e.nextReg)
					e.w("  ") ; e.w(gep) ; e.w(" = getelementptr ") ; e.w(aggRT) ; e.w(", ptr ") ; e.w(agg) ; e.w(", i32 0, i32 ") ; e.w(irItoa(i)) ; e.w("\n")
					e.w("  store ") ; e.w(nrt) ; e.w(" ") ; e.w(tmp) ; e.w(", ptr ") ; e.w(gep) ; e.w("\n")
				}
				e.nextReg++
				rv := "%nr" | irItoa(e.nextReg)
				e.w("  ") ; e.w(rv) ; e.w(" = load ") ; e.w(aggRT) ; e.w(", ptr ") ; e.w(agg) ; e.w("\n")
				if e.sretType != "" {
					e.w("  store ") ; e.w(aggRT) ; e.w(" ") ; e.w(rv) ; e.w(", ptr %retval\n")
					e.w("  ret void\n")
				} else {
					e.emitRetWithCodec(aggRT, rv)
				}
			}
		} else {
			// A function whose declared result is non-void but whose return
			// carries no SSA values: the recover block of a function without
			// named results, reached because a panic unwound out of this frame.
			// The arena this frame pushed still has to be handed back, or a
			// mutating method on a sovereign receiver leaks its borrow for the
			// life of the process and the group's arena can never be compacted.
			// Mirrors legacy emitArenaEpilogue's zero-result branch.
			e.emitArenaExit()
			if e.sretType != "" {
				e.w("  store ") ; e.w(rt) ; e.w(" zeroinitializer, ptr %retval\n")
				e.w("  ret void\n")
			} else {
				e.w("  ret ") ; e.w(rt) ; e.w(" zeroinitializer\n")
			}
		}
		return
	}
	sig := e.curFunc.Signature
	if len(r.Results) == 1 {
		typ := e.llvmType(r.Results[0].SSAType())
		val := e.operand(r.Results[0])
		expectType := typ
		if sig != nil && sig.Results != nil && sig.Results.Len() == 1 {
			expectType = e.llvmType(sig.Results.At(0).Typ)
		}
		if typ == "void" { typ = frt }
		if expectType == "void" { expectType = frt }
		if val == "null" && expectType != "ptr" {
			val = "zeroinitializer"
		} else {
			val = e.coerceInt(val, typ, expectType, e.isUnsignedType(r.Results[0].SSAType()))
		}
		if typ != expectType && val != "zeroinitializer" {
			if expectType == "ptr" && e.intBits(typ) > 0 {
				e.nextReg++
				rc := "%rc" | irItoa(e.nextReg)
				e.w("  ") ; e.w(rc) ; e.w(" = inttoptr ") ; e.w(typ) ; e.w(" ") ; e.w(val) ; e.w(" to ptr\n")
				val = rc
				typ = "ptr"
			} else if typ == "ptr" && e.intBits(expectType) > 0 {
				e.nextReg++
				rc := "%rc" | irItoa(e.nextReg)
				e.w("  ") ; e.w(rc) ; e.w(" = ptrtoint ptr ") ; e.w(val) ; e.w(" to ") ; e.w(expectType) ; e.w("\n")
				val = rc
				typ = expectType
			}
			// coerceInt already handled int-width mismatches (a numeric
			// literal is type-flexible in LLVM, and a register gets a
			// sext/trunc). Only zero for genuinely incompatible types.
			if typ != expectType && !(e.intBits(typ) > 0 && e.intBits(expectType) > 0) {
				val = "zeroinitializer"
			}
		}
		if e.sretType != "" {
			e.w("  store ") ; e.w(expectType) ; e.w(" ") ; e.w(val) ; e.w(", ptr %retval\n")
			e.w("  ret void\n")
		} else {
			e.emitRetWithCodec(expectType, val)
		}
		return
	}
	var expectTypes []string
	if sig != nil && sig.Results != nil {
		for i := 0; i < sig.Results.Len(); i++ {
			push(expectTypes, e.resolveResultType(sig.Results.At(i).Typ))
		}
	}
	rtSegs := []string{"{"}
	for i := 0; i < len(r.Results); i++ {
		res := r.Results[i]
		if i > 0 {
			push(rtSegs, ", ")
		}
		if i < len(expectTypes) {
			push(rtSegs, expectTypes[i])
		} else {
			push(rtSegs, e.llvmType(res.SSAType()))
		}
	}
	push(rtSegs, "}")
	retType := joinStrs(rtSegs)
	prev := "undef"
	for i := 0; i < len(r.Results); i++ {
		res := r.Results[i]
		valType := e.llvmType(res.SSAType())
		valOp := e.operand(res)
		elemType := valType
		if i < len(expectTypes) {
			elemType = expectTypes[i]
			if valType != elemType && len(valType) > 0 && valType[0] == '{' {
				e.nextReg++
				ex := "%rv" | irItoa(e.nextReg)
				e.w("  ") ; e.w(ex) ; e.w(" = extractvalue ") ; e.w(valType) ; e.w(" ") ; e.w(valOp) ; e.w(", 0\n")
				valOp = ex
				valType = elemType
			}
			if valType == "ptr" && len(elemType) > 0 && elemType[0] == '{' {
				e.nextReg++
				ld := "%rv" | irItoa(e.nextReg)
				e.w("  ") ; e.w(ld) ; e.w(" = load ") ; e.w(elemType) ; e.w(", ptr ") ; e.w(valOp) ; e.w("\n")
				valOp = ld
				valType = elemType
			}
			if valOp == "null" && elemType != "ptr" {
				valOp = "zeroinitializer"
			} else if (elemType == "double" || elemType == "float") && isConstOperand(valOp) {
				valOp = ensureFloatLit(valOp)
			} else if (elemType == "double" || elemType == "float") && e.intBits(valType) > 0 {
				valOp = e.intToFloat(valOp, valType, elemType)
			} else {
				valOp = e.coerceInt(valOp, valType, elemType, e.isUnsignedType(res.SSAType()))
			}
			if valType == "double" && elemType == "float" {
				e.nextReg++
				rc := "%rc" | irItoa(e.nextReg)
				e.w("  ") ; e.w(rc) ; e.w(" = fptrunc double ") ; e.w(valOp) ; e.w(" to float\n")
				valOp = rc
			} else if valType == "float" && elemType == "double" {
				e.nextReg++
				rc := "%rc" | irItoa(e.nextReg)
				e.w("  ") ; e.w(rc) ; e.w(" = fpext float ") ; e.w(valOp) ; e.w(" to double\n")
				valOp = rc
			}
		}
		e.nextReg++
		cur := "%rv" | irItoa(e.nextReg)
		e.w("  ")
		e.w(cur)
		e.w(" = insertvalue ")
		e.w(retType)
		e.w(" ")
		e.w(prev)
		e.w(", ")
		e.w(elemType)
		e.w(" ")
		e.w(valOp)
		e.w(", ")
		e.w(irItoa(i))
		e.w("\n")
		prev = cur
	}
	if e.sretType != "" {
		e.w("  store ") ; e.w(retType) ; e.w(" ") ; e.w(prev) ; e.w(", ptr %retval\n")
		e.w("  ret void\n")
	} else {
		e.emitRetWithCodec(retType, prev)
	}
}

func (e *irEmitter) emitJump(j *SSAJump) {
	blk := e.currentEmitBlock
	if blk == nil {
		return
	}
	if len(blk.Succs) > 0 {
		target := blk.Succs[0]
		e.w("  br label ")
		e.w(e.blockLabel(target))
		e.w("\n")
	}
}

func (e *irEmitter) emitIf(i *SSAIf) {
	blk := e.currentEmitBlock
	if i.Cond == nil {
		if len(blk.Succs) >= 2 {
			e.w("  br label ")
			e.w(e.blockLabel(blk.Succs[1]))
			e.w("\n")
		} else {
			e.w("  unreachable\n")
		}
		return
	}
	cond := e.operand(i.Cond)
	condType := e.llvmType(i.Cond.SSAType())
	if at, ok := e.allocTypes[i.Cond]; ok {
		condType = at
	}
	if bop, ok := i.Cond.(*SSABinOp); ok && isComparisonOp(bop.Op) {
		condType = "i1"
	}
	if condType != "i1" && condType != "" && condType != "void" {
		e.nextReg++
		truncReg := "%ift" | irItoa(e.nextReg)
		if condType == "ptr" {
			e.w("  ") ; e.w(truncReg) ; e.w(" = icmp ne ptr ") ; e.w(cond) ; e.w(", null\n")
		} else if condType == "{ptr, ptr}" {
			// Function pointer fat pointer: check code_ptr (field 1),
			// not context (field 0) which is legitimately nil for
			// non-closure functions.
			e.nextReg++
			extReg := "%ife" | irItoa(e.nextReg)
			e.w("  ") ; e.w(extReg) ; e.w(" = extractvalue {ptr, ptr} ") ; e.w(cond) ; e.w(", 1\n")
			e.w("  ") ; e.w(truncReg) ; e.w(" = icmp ne ptr ") ; e.w(extReg) ; e.w(", null\n")
		} else if len(condType) > 0 && condType[0] == '{' {
			curType := condType
			curVal := cond
			for len(curType) > 0 && curType[0] == '{' {
				e.nextReg++
				extReg := "%ife" | irItoa(e.nextReg)
				e.w("  ") ; e.w(extReg) ; e.w(" = extractvalue ") ; e.w(curType) ; e.w(" ") ; e.w(curVal) ; e.w(", 0\n")
				curType = e.structField0Type(curType)
				curVal = extReg
			}
			e.w("  ") ; e.w(truncReg) ; e.w(" = icmp ne ptr ") ; e.w(curVal) ; e.w(", null\n")
		} else {
			e.w("  ") ; e.w(truncReg) ; e.w(" = trunc ") ; e.w(condType) ; e.w(" ") ; e.w(cond) ; e.w(" to i1\n")
		}
		cond = truncReg
	}
	if len(blk.Succs) >= 2 {
		e.w("  br i1 ")
		e.w(cond)
		e.w(", label ")
		e.w(e.blockLabel(blk.Succs[0]))
		e.w(", label ")
		e.w(e.blockLabel(blk.Succs[1]))
		e.w("\n")
	}
}

// isRuneSlice reports whether t is a slice of 32-bit signed integers, i.e. the
// []rune that a string conversion has to encode. `[]int32` is the same type in
// Go's rules and converts the same way.
func isRuneSlice(t Type) (ok bool) {
	if t == nil {
		return false
	}
	sl, isSl := SafeUnderlying(t).(*Slice)
	if !isSl {
		return false
	}
	b, isB := SafeUnderlying(sl.Elem).(*Basic)
	return isB && b.Kind == Int32 && b.Info&IsInteger != 0
}

func (e *irEmitter) emitConvert(c *SSAConvert) {
	reg := e.regName(c)
	srcType := e.llvmType(c.X.SSAType())
	dstType := e.llvmType(c.SSAType())
	val := e.operand(c.X)

	if srcType != "ptr" {
		resolved := e.resolvedType(c.X, srcType)
		if resolved != srcType {
			srcType = resolved
		}
	}

	if srcType == "void" || c.X.SSAType() == nil {
		if dstType == "ptr" {
			e.valName[c] = "null"
		} else {
			e.valName[c] = "zeroinitializer"
		}
		return
	}

	// A rune slice and a string share the three-word header, so they have the
	// SAME LLVM type and the equality return below hands the header straight
	// through - but the conversion is not a reinterpretation: a rune slice
	// holds one 32-bit code point per element and a string holds UTF-8 bytes.
	// string([]rune{'a','b','c'}) was therefore a 3-byte string containing the
	// first three bytes of the rune array ("a\x00\x00"), which is how
	// x/net/idna's punycode decoder produced interleaved NULs, and
	// []rune("abc") returned the string's bytes reinterpreted as code points.
	// Both directions go through the runtime encoders, exactly as legacy does.
	if isRuneSlice(c.X.SSAType()) && e.isStringLike(c.SSAType()) {
		e.declareRuntime("runtime.stringFromRunes", e.sliceType(), e.sliceType())
		e.w("  ") ; e.w(reg) ; e.w(" = call ") ; e.w(e.sliceType()) ; e.w(" @runtime.stringFromRunes(") ; e.w(srcType) ; e.w(" ") ; e.w(val) ; e.w(", ptr null)\n")
		e.setRegType(c, reg, e.sliceType())
		return
	}
	if e.isStringLike(c.X.SSAType()) && isRuneSlice(c.SSAType()) {
		e.declareRuntime("runtime.stringToRunes", e.sliceType(), e.sliceType())
		e.w("  ") ; e.w(reg) ; e.w(" = call ") ; e.w(e.sliceType()) ; e.w(" @runtime.stringToRunes(") ; e.w(srcType) ; e.w(" ") ; e.w(val) ; e.w(", ptr null)\n")
		e.setRegType(c, reg, e.sliceType())
		return
	}

	if srcType == dstType {
		e.valName[c] = val
		e.allocTypes[c] = srcType
		return
	}

	// Constant int->int conversions fold at emission. Materializing an
	// untyped constant at its default width and extending loses high bits
	// (e.g. uint64(0xFFFFFFFFFFFFFFFF) emitted as zext i32 -1 -> 0xFFFFFFFF).
	if k, ok := c.X.(*SSAConst); ok {
		if ci, ok2 := k.val.(*ConstInt); ok2 {
			sb := e.intBits(srcType)
			db := e.intBits(dstType)
			if sb > 0 && db > 0 {
				v := ci.V
				if db < 64 {
					v = v & ((int64(1) << uint32(db)) - 1)
				}
				e.valName[c] = irItoa64(v)
				return
			}
		}
	}

	if dstType == e.ifaceType() {
		_, dstIsIface := SafeUnderlying(c.SSAType()).(*TCInterface)
		if dstIsIface {
			var valPtr string
			if srcType == "ptr" {
				valPtr = val
			} else if e.isScalarType(srcType) {
				ipt := e.intptrType()
				srcBits := e.intBits(srcType)
				dstBits := e.intBits(ipt)
				if srcBits > dstBits {
					// Value doesn't fit in intptr - heap allocate
					sz := e.nextReg2("cv")
					e.w("  ") ; e.w(sz) ; e.w(" = ptrtoint ptr getelementptr (") ; e.w(srcType) ; e.w(", ptr null, i32 1) to ") ; e.w(ipt) ; e.w("\n")
					valPtr = e.nextReg2("cv")
					e.w("  ") ; e.w(valPtr) ; e.w(" = call ptr @runtime.alloc(") ; e.w(ipt) ; e.w(" ") ; e.w(sz) ; e.w(", ptr null, ptr null, ptr null)\n")
					e.w("  store ") ; e.w(srcType) ; e.w(" ") ; e.w(val) ; e.w(", ptr ") ; e.w(valPtr) ; e.w("\n")
					e.declareRuntime("runtime.alloc", "ptr", ipt | ", ptr, ptr")
				} else {
					ext := e.nextReg2("cv")
					if srcBits == dstBits {
						ext = val
					} else {
						e.w("  ") ; e.w(ext) ; e.w(" = zext ") ; e.w(srcType) ; e.w(" ") ; e.w(val) ; e.w(" to ") ; e.w(ipt) ; e.w("\n")
					}
					valPtr = e.nextReg2("cv")
					e.w("  ") ; e.w(valPtr) ; e.w(" = inttoptr ") ; e.w(ipt) ; e.w(" ") ; e.w(ext) ; e.w(" to ptr\n")
				}
			} else {
				ipt := e.intptrType()
				sz := e.nextReg2("cv")
				e.w("  ") ; e.w(sz) ; e.w(" = ptrtoint ptr getelementptr (") ; e.w(srcType) ; e.w(", ptr null, i32 1) to ") ; e.w(ipt) ; e.w("\n")
				valPtr = e.nextReg2("cv")
				e.w("  ") ; e.w(valPtr) ; e.w(" = call ptr @runtime.alloc(") ; e.w(ipt) ; e.w(" ") ; e.w(sz) ; e.w(", ptr null, ptr null, ptr null)\n")
				e.w("  store ") ; e.w(srcType) ; e.w(" ") ; e.w(val) ; e.w(", ptr ") ; e.w(valPtr) ; e.w("\n")
				e.declareRuntime("runtime.alloc", "ptr", ipt | ", ptr, ptr")
			}
			typeid := e.typeIDHash(c.X.SSAType())
			t1 := e.nextReg2("cv")
			e.w("  ") ; e.w(t1) ; e.w(" = insertvalue " | e.ifaceType() | " undef, " | e.intptrType() | " ") ; e.w(typeid) ; e.w(", 0\n")
			e.w("  ") ; e.w(reg) ; e.w(" = insertvalue " | e.ifaceType() | " ") ; e.w(t1) ; e.w(", ptr ") ; e.w(valPtr) ; e.w(", 1\n")
			return
		}
	}

	srcIsInt := false
	if b, ok := SafeUnderlying(c.X.SSAType()).(*Basic); ok {
		srcIsInt = b.Info&IsInteger != 0
	}
	if !srcIsInt && len(srcType) > 0 && srcType[0] == 'i' {
		srcIsInt = true
	}
	if e.isStringLike(c.SSAType()) && srcIsInt {
		if k, ok := c.X.(*SSAConst); ok {
			rv := int64(0)
			if ci, ok2 := k.val.(*ConstInt); ok2 {
				rv = ci.V
			}
			s := runeToUTF8(rune(rv))
			idx := e.addStringConst(s)
			ipt := e.intptrType()
			slen := irItoa64(int64(len(s)))
			e.valName[c] = "{ ptr " | e.strConstGlobal(idx) | ", " | ipt | " " | slen | ", " | ipt | " " | slen | " }"
			return
		}
		e.declareRuntime("runtime.stringFromUnicode", e.sliceType(), "i32")
		srcVal := val
		if srcType != "i32" {
			e.nextReg++
			srcVal = "%cv" | irItoa(e.nextReg)
			if e.typeBits(c.X.SSAType()) < 32 {
				e.w("  ") ; e.w(srcVal) ; e.w(" = sext ") ; e.w(srcType) ; e.w(" ") ; e.w(val) ; e.w(" to i32\n")
			} else if e.typeBits(c.X.SSAType()) > 32 {
				e.w("  ") ; e.w(srcVal) ; e.w(" = trunc ") ; e.w(srcType) ; e.w(" ") ; e.w(val) ; e.w(" to i32\n")
			}
		}
		e.w("  ") ; e.w(reg) ; e.w(" = call ") ; e.w(e.sliceType()) ; e.w(" @runtime.stringFromUnicode(i32 ") ; e.w(srcVal) ; e.w(", ptr null)\n")
		return
	}

	srcIsSlice := false
	if _, slOK := SafeUnderlying(c.X.SSAType()).(*Slice); slOK {
		srcIsSlice = true
	} else if e.isStringLike(c.X.SSAType()) {
		srcIsSlice = true
	} else if srcType == e.sliceType() {
		srcIsSlice = true
	}
	if srcIsSlice {
		if _, arOK := SafeUnderlying(c.SSAType()).(*Array); arOK {
			dp := e.nextReg2("cv")
			e.w("  ") ; e.w(dp) ; e.w(" = extractvalue ") ; e.w(srcType) ; e.w(" ") ; e.w(val) ; e.w(", 0\n")
			e.w("  ") ; e.w(reg) ; e.w(" = load ") ; e.w(dstType) ; e.w(", ptr ") ; e.w(dp) ; e.w("\n")
			return
		}
	}

	op := e.conversionOp(c.X.SSAType(), c.SSAType())
	// An integer constant that does not fit the signed slot carries the Unsigned
	// marker on its VALUE, while its TYPE says nothing about it - an untyped
	// integer constant is not an unsigned type. conversionOp therefore answered
	// sitofp and the backend sign-extended a bit pattern that was never
	// negative:
	//   float64(1<<63)   -> sitofp i64 -9223372036854775808 -> -9.22337203685478e+18
	//   float64(1<<64-1) -> sitofp i64 -1                  -> -1.0  (math.MaxUint64)
	// conversionOp already returns uitofp for a genuinely unsigned TYPE, so the
	// only gap is this marker.
	if op == "sitofp" && constIntUnsigned(c.X) {
		op = "uitofp"
	}
	srcBitsLLVM := e.intBits(srcType)
	dstBitsLLVM := e.intBits(dstType)
	if (op == "sext" || op == "zext") && srcBitsLLVM > 0 && dstBitsLLVM > 0 && srcBitsLLVM > dstBitsLLVM {
		op = "trunc"
	} else if op == "trunc" && srcBitsLLVM > 0 && dstBitsLLVM > 0 && srcBitsLLVM < dstBitsLLVM {
		op = "sext"
	}
	srcIsFloat := srcType == "double" || srcType == "float"
	dstIsFloat := dstType == "double" || dstType == "float"
	if op == "trunc" && srcIsFloat && !dstIsFloat {
		op = "fptosi"
	} else if op == "trunc" && !srcIsFloat && dstIsFloat {
		op = "sitofp"
	} else if (op == "sext" || op == "zext") && !srcIsFloat && dstIsFloat {
		op = "sitofp"
	} else if (op == "sext" || op == "zext") && srcIsFloat && !dstIsFloat {
		op = "fptosi"
	} else if op == "bitcast" && srcIsFloat != dstIsFloat {
		if srcIsFloat {
			op = "fptosi"
		} else {
			op = "sitofp"
		}
	} else if (op == "sext" || op == "zext" || op == "trunc") && srcIsFloat && dstIsFloat {
		if e.intBits(srcType) < e.intBits(dstType) {
			op = "fpext"
		} else {
			op = "fptrunc"
		}
	}
	if op == "ptrtoint" && e.intBits(dstType) == 0 {
		if dstType == e.ifaceType() {
			typeid := e.typeIDHash(c.X.SSAType())
			t1 := e.nextReg2("cv")
			e.w("  ") ; e.w(t1) ; e.w(" = insertvalue " | e.ifaceType() | " undef, " | e.intptrType() | " ") ; e.w(typeid) ; e.w(", 0\n")
			e.w("  ") ; e.w(reg) ; e.w(" = insertvalue " | e.ifaceType() | " ") ; e.w(t1) ; e.w(", ptr ") ; e.w(val) ; e.w(", 1\n")
		} else {
			e.valName[c] = "zeroinitializer"
		}
		return
	}
	if op == "inttoptr" && e.intBits(srcType) == 0 {
		if srcType == e.ifaceType() {
			e.nextReg++
			r := "%cv" | irItoa(e.nextReg)
			e.w("  ") ; e.w(r) ; e.w(" = extractvalue ") ; e.w(srcType) ; e.w(" ") ; e.w(val) ; e.w(", 1\n")
			e.valName[c] = r
		} else {
			e.valName[c] = "null"
		}
		return
	}
	e.w("  ")
	e.w(reg)
	e.w(" = ")
	e.w(op)
	e.w(" ")
	e.w(srcType)
	e.w(" ")
	e.w(val)
	e.w(" to ")
	e.w(dstType)
	e.w("\n")
	if e.intBits(dstType) > 0 || dstType == "ptr" {
		e.setRegType(c, reg, dstType)
	}
}

func (e *irEmitter) emitChangeType(c *SSAChangeType) {
	srcType := e.llvmType(c.X.SSAType())
	dstType := e.llvmType(c.SSAType())
	if at, ok := e.allocTypes[c.X]; ok && at != "ptr" && at != "void" {
		srcType = at
	}
	if srcType == dstType || (srcType == "ptr" && dstType == "ptr") {
		e.valName[c] = e.operand(c.X)
		return
	}
	reg := e.regName(c)
	val := e.operand(c.X)
	e.nextReg++
	tmp := "%ct" | irItoa(e.nextReg)
	e.w("  ") ; e.w(tmp) ; e.w(" = alloca ") ; e.w(dstType) ; e.w("\n")
	e.w("  store ") ; e.w(srcType) ; e.w(" ") ; e.w(val) ; e.w(", ptr ") ; e.w(tmp) ; e.w("\n")
	e.w("  ") ; e.w(reg) ; e.w(" = load ") ; e.w(dstType) ; e.w(", ptr ") ; e.w(tmp) ; e.w("\n")
}

// emitTypeDescAddr emits the address of the type-descriptor global for the
// static type carried by an unsafe.TypeOf call.
func (e *irEmitter) emitTypeDescAddr(td *SSATypeDesc) {
	reg := e.regName(td)
	if td.t == nil {
		e.w("  ") ; e.w(reg) ; e.w(" = ptr null\n")
		return
	}
	if _, isIface := td.t.(*TCInterface); !isIface {
		e.collectTypeDesc(td.t)
	}
	tn := e.reflectTypeName(td.t)
	e.w("  ") ; e.w(reg) ; e.w(" = bitcast ptr ") ; e.w(irQuoteName(tn)) ; e.w(" to ptr\n")
}

func (e *irEmitter) resolveFieldAddrBase(f *SSAFieldAddr) (s string) {
	baseType := e.llvmType(f.X.SSAType())
	if p, ok := SafeUnderlying(f.X.SSAType()).(*Pointer); ok && p.Base != nil {
		elem := p.Base
		if p2, ok2 := SafeUnderlying(elem).(*Pointer); ok2 && p2.Base != nil {
			baseType = e.llvmType(p2.Base)
		} else {
			baseType = e.llvmType(elem)
		}
	}
	if at, ok := e.allocTypes[f.X]; ok && at != "ptr" && at != "void" {
		baseType = at
	}
	return baseType
}

func (e *irEmitter) emitFieldAddr(f *SSAFieldAddr) {
	reg := e.regName(f)
	baseType := e.resolveFieldAddrBase(f)
	base := e.operand(f.X)
	if uop, ok := f.X.(*SSAUnOp); ok {
		_, isFreeVar := uop.X.(*SSAFreeVar)
		addrType := e.llvmType(uop.X.SSAType())
		useSource := false
		if p, ok2 := SafeUnderlying(uop.X.SSAType()).(*Pointer); ok2 && p.Base != nil {
			elem := p.Base
			if _, ok3 := SafeUnderlying(elem).(*Pointer); ok3 {
				// double-pointer: alloca holds **T, keep the loaded *T as base
			} else {
				baseType = e.llvmType(elem)
				useSource = true
			}
		}
		if useSource && !isFreeVar && addrType == "ptr" && baseType != "ptr" && baseType != "void" {
			base = e.operand(uop.X)
		}
	}
	if baseType == "ptr" || baseType == "void" {
		e.w("  ") ; e.w(reg) ; e.w(" = getelementptr inbounds i8, ptr ") ; e.w(base)
		e.w(", i32 0\n")
		return
	}
	e.w("  ")
	e.w(reg)
	e.w(" = getelementptr inbounds ")
	e.w(baseType)
	e.w(", ptr ")
	e.w(base)
	e.w(", i32 0, i32 ")
	e.w(irItoa(f.Field))
	e.w("\n")
}

// markAddressAccess marks the IndexAddr at the root of an address chain as
// element-accessed, following field and element links (out[i].f, out[i][j]).
func markAddressAccess(v SSAValue) {
	switch a := v.(type) {
	case *SSAIndexAddr:
		a.accessed = true
		markAddressAccess(a.X)
	case *SSAFieldAddr:
		markAddressAccess(a.X)
	}
}

// markIndexAccesses records every index address whose value is loaded or
// stored. Address formation (unsafe.Pointer(&s[i]), passing &s[i] on) is
// pointer arithmetic, and the runtime's buffer cursors sit one past the end of
// a full buffer by design. Legacy checks exactly this set - see
// addressIsElementAccess in legacy/compiler/asserts.go.
func markIndexAccesses(f *SSAFunction) {
	for _, b := range f.Blocks {
		for _, instr := range b.Instrs {
			switch in := instr.(type) {
			case *SSAUnOp:
				if in.Op == OpMul {
					markAddressAccess(in.X)
				}
			case *SSAStore:
				markAddressAccess(in.Addr)
			}
		}
	}
}

// llvmIntWidth returns the bit width of an LLVM integer type name ("i64").
func llvmIntWidth(t string) (w int32) {
	if len(t) < 2 || t[0] != 'i' {
		return 0
	}
	for i := 1; i < len(t); i++ {
		c := t[i]
		if c < '0' || c > '9' {
			return 0
		}
		w = w*10 + int32(c-'0')
	}
	return w
}

// emitIndexBoundsCheck traps when index is not below the length of the slice
// or array being indexed. Moxie dropped index bounds checks, so an index store
// past len wrote into spare capacity and left len unchanged: the value silently
// vanished at the next push. A silent wrong answer is worse than a trap.
// Mirrors legacy's createLookupBoundsCheck, including the
// sign-extend-then-compare-unsigned so a negative index is caught too. The
// comparison is done at the wider of the index width and the pointer width: a
// 64-bit index on a 32-bit target must not be truncated, and a narrower index
// is sign/zero-extended. lenReg is the length as an iptr register; when it is
// empty lenConst is the compile-time length.
func (e *irEmitter) emitIndexBoundsCheck(index, idxLLVM, lenReg string, lenConst int64, idxGo Type) {
	ipt := e.intptrType()
	pw := llvmIntWidth(ipt)
	w := llvmIntWidth(idxLLVM)
	if w == 0 {
		w = pw
	}
	cmpIdx := index
	if w < pw {
		ext := "sext"
		if b, ok := SafeUnderlying(idxGo).(*Basic); ok && b.Info&IsUnsigned != 0 {
			ext = "zext"
		}
		cmpIdx = e.nextReg2("lb")
		e.w("  ") ; e.w(cmpIdx) ; e.w(" = ") ; e.w(ext) ; e.w(" ") ; e.w(idxLLVM) ; e.w(" ") ; e.w(index) ; e.w(" to ") ; e.w(ipt) ; e.w("\n")
		w = pw
	}
	cmpType := "i" | irItoa(w)
	var lenOperand string
	if lenReg != "" {
		if w > pw {
			// A length never exceeds the address space, so zero-extending it
			// is exact and keeps a huge index out of range.
			wide := e.nextReg2("lb")
			e.w("  ") ; e.w(wide) ; e.w(" = zext ") ; e.w(ipt) ; e.w(" ") ; e.w(lenReg) ; e.w(" to ") ; e.w(cmpType) ; e.w("\n")
			lenOperand = cmpType | " " | wide
		} else {
			lenOperand = cmpType | " " | lenReg
		}
	} else {
		lenOperand = cmpType | " " | irItoa64(lenConst)
	}
	// A runtime call, not an inline branch: splitting a block here leaves the
	// continuation as a new predecessor and every later PHI then names the
	// wrong block. A 64-bit index on a 32-bit target needs the uint64 entry:
	// calling the uintptr one with an i64 argument is a type mismatch, and the
	// wasm link answers a mismatched call with a stub that traps even when the
	// index is in bounds.
	check := "runtime.lookupCheck"
	if w > pw {
		check = "runtime.lookupCheck64"
	}
	e.w("  call void @") ; e.w(check) ; e.w("(") ; e.w(cmpType) ; e.w(" ") ; e.w(cmpIdx) ; e.w(", ") ; e.w(lenOperand) ; e.w(", ptr null)\n")
	e.declareRuntime(check, "void", cmpType | ", " | cmpType)
}

func (e *irEmitter) emitIndexAddr(idx *SSAIndexAddr) {
	reg := e.regName(idx)
	elemType := e.llvmType(idx.SSAType())
	if p, ok := SafeUnderlying(idx.SSAType()).(*Pointer); ok {
		elemType = e.llvmType(p.Base)
	}
	if idx.byteStep {
		// unsafe.Add steps bytes. The result is typed unsafe.Pointer (its
		// declaration), whose base ArbitraryType would otherwise make this a
		// 4-byte step.
		elemType = "i8"
	}
	base := e.operand(idx.X)
	index := e.operand(idx.Index)
	baseType := e.llvmType(idx.X.SSAType())
	resolvedBase := e.resolvedType(idx.X, baseType)
	_, isSlice := SafeUnderlying(idx.X.SSAType()).(*Slice)
	if !isSlice {
		if b, ok := SafeUnderlying(idx.X.SSAType()).(*Basic); ok && b.Info&IsString != 0 {
			isSlice = true
		}
	}
	if at, ok4 := e.allocTypes[idx.X]; ok4 && len(at) > 0 && at[0] == '[' {
		isSlice = false
	} else if !isSlice && (baseType == e.sliceType() || resolvedBase == e.sliceType()) {
		isSlice = true
	}
	if isSlice && (elemType == "void" || elemType == "i8" || elemType == "ptr") {
		baseU := SafeUnderlying(idx.X.SSAType())
		if sl, ok2 := baseU.(*Slice); ok2 && sl.Elem != nil {
			elemType = e.llvmType(sl.Elem)
			if b, ok3 := SafeUnderlying(sl.Elem).(*Basic); ok3 && b.Info&IsString != 0 {
				elemType = e.sliceType()
			}
			if elemType == "void" || elemType == "" {
				elemType = e.sliceType()
			}
		} else if b, ok3 := baseU.(*Basic); ok3 && b.Info&IsString != 0 {
			elemType = "i8"
		}
		if elemType == "void" {
			elemType = "i8"
		}
	}
	idxType := e.resolvedType(idx.Index, e.llvmType(idx.Index.SSAType()))
	// GEP indices are interpreted as signed: a raw i8/i16 index from a
	// uint8/uint16 value >= half-range goes negative and reads garbage.
	// Normalize narrow indices to i32 with the extension matching the
	// source signedness.
	if idxType == "i8" || idxType == "i16" {
		ext := "sext"
		if b, okx := SafeUnderlying(idx.Index.SSAType()).(*Basic); okx && b.Info&IsUnsigned != 0 {
			ext = "zext"
		}
		e.nextReg++
		widened := "%ixw" | irItoa(e.nextReg)
		e.w("  ") ; e.w(widened) ; e.w(" = ") ; e.w(ext) ; e.w(" ") ; e.w(idxType) ; e.w(" ") ; e.w(index) ; e.w(" to i32\n")
		index = widened
		idxType = "i32"
	}
	if isSlice {
		e.nextReg++
		dataPtr := "%sp" | irItoa(e.nextReg)
		e.w("  ")
		e.w(dataPtr)
		e.w(" = extractvalue ")
		e.w(e.sliceType())
		e.w(" ")
		e.w(base)
		e.w(", 0\n")
		if idx.accessed {
			lenReg := e.nextReg2("lb")
			e.w("  ") ; e.w(lenReg) ; e.w(" = extractvalue ") ; e.w(e.sliceType()) ; e.w(" ") ; e.w(base) ; e.w(", 1\n")
			e.emitIndexBoundsCheck(index, idxType, lenReg, 0, idx.Index.SSAType())
		}
		e.w("  ")
		e.w(reg)
		e.w(" = getelementptr inbounds ")
		e.w(elemType)
		e.w(", ptr ")
		e.w(dataPtr)
		e.w(", ")
		e.w(idxType)
		e.w(" ")
		e.w(index)
		e.w("\n")
		if elemType != "i8" {
			e.allocTypes[idx] = elemType
		}
		return
	}
	// A base whose type is *[N]E indexes array elements, and the GEP source
	// type is the array itself. Deciding "is this an array?" from the index
	// operand's own type misses every base that reaches the array through a
	// pointer - a struct field, a package-level struct field, a *[N]E
	// parameter, a loaded pointer. Those fell through to the element branch
	// below, which steps by the element type: &h.q[i] over `q [n]row` came out
	// as `getelementptr [8 x i32], ptr %row_field, i32 0, i32 %i`, a 4-byte
	// step instead of a row, so every i > 0 addressed row 0. legacy builds the
	// GEP from the type LLVM already has and never had this shape.
	if !isSlice && !idx.byteStep {
		if p, ok4 := SafeUnderlying(idx.X.SSAType()).(*Pointer); ok4 && p.Base != nil {
			if _, ok6 := SafeUnderlying(p.Base).(*Array); ok6 {
				arrT := e.llvmType(p.Base)
				e.w("  ") ; e.w(reg) ; e.w(" = getelementptr inbounds ")
				e.w(arrT) ; e.w(", ptr ") ; e.w(base) ; e.w(", i32 0, ")
				e.w(idxType) ; e.w(" ") ; e.w(index) ; e.w("\n")
				aet := e.arrayElemType(arrT)
				if aet != "" {
					e.setRegType(idx, reg, aet)
				}
				return
			}
		}
	}
	arr, isArray := SafeUnderlying(idx.X.SSAType()).(*Array)
	if !isArray {
		if at, ok4 := e.allocTypes[idx.X]; ok4 && len(at) > 0 && at[0] == '[' {
			isArray = true
		}
	}
	if !isArray {
		if alloc, ok4 := idx.X.(*SSAAlloc); ok4 {
			if p, ok5 := SafeUnderlying(alloc.SSAType()).(*Pointer); ok5 && p.Base != nil {
				if ar, ok6 := SafeUnderlying(p.Base).(*Array); ok6 && ar.Len > 0 {
					isArray = true
					arrT := e.llvmType(p.Base)
					if len(arrT) > 0 && arrT[0] == '[' {
						e.allocTypes[alloc] = arrT
					}
				}
			}
		}
	}
	if !isArray {
		if load, ok4 := idx.X.(*SSAUnOp); ok4 && load.Op == OpMul {
			if at, ok5 := e.allocTypes[load.X]; ok5 && len(at) > 0 && at[0] == '[' {
				isArray = true
				e.allocTypes[idx.X] = at
				allocBase := e.operand(load.X)
				e.w("  ") ; e.w(reg) ; e.w(" = getelementptr inbounds ")
				e.w(at) ; e.w(", ptr ") ; e.w(allocBase) ; e.w(", i32 0, ")
				e.w(e.llvmType(idx.Index.SSAType())) ; e.w(" ") ; e.w(index) ; e.w("\n")
				aet := e.arrayElemType(at)
				if aet != "" { e.setRegType(idx, reg, aet) }
				return
			}
		}
	}
	if isArray {
		arrType := e.llvmType(idx.X.SSAType())
		if at, ok4 := e.allocTypes[idx.X]; ok4 && len(at) > 0 && at[0] == '[' {
			arrType = at
		}
		if arrType == "ptr" || arrType == "void" {
			if p, ok4 := SafeUnderlying(idx.X.SSAType()).(*Pointer); ok4 && p.Base != nil {
				arrType = e.llvmType(p.Base)
			}
		}
		_, isGlobal := idx.X.(*SSAGlobal)
		_, isAlloc := idx.X.(*SSAAlloc)
		_, isFieldAddr := idx.X.(*SSAFieldAddr)
		if isGlobal || isAlloc || isFieldAddr {
			_ = arr
			e.w("  ") ; e.w(reg) ; e.w(" = getelementptr inbounds ")
			e.w(arrType) ; e.w(", ptr ") ; e.w(base) ; e.w(", i32 0, ")
			e.w(idxType) ; e.w(" ") ; e.w(index) ; e.w("\n")
			return
		}
		if load, ok4 := idx.X.(*SSAUnOp); ok4 && load.Op == OpMul {
			_, srcAlloc := load.X.(*SSAAlloc)
			_, srcGlobal := load.X.(*SSAGlobal)
			_, srcField := load.X.(*SSAFieldAddr)
			// A load of an index/field-addr result is a load from an
			// addressable chain (e.g. global[i][j]): forwarding to the
			// source GEP keeps the element addressable so mutations
			// through method receivers hit the original, not a spill copy.
			_, srcIndex := load.X.(*SSAIndexAddr)
			if srcAlloc || srcGlobal || srcField || srcIndex {
				// Index into a load-of-array: GEP the source address
				// instead of spilling a copy. The spill alloca lands in
				// the current block - inside a loop that grows the frame
				// per iteration until the stack is gone.
				allocBase := e.operand(load.X)
				e.w("  ") ; e.w(reg) ; e.w(" = getelementptr inbounds ")
				e.w(arrType) ; e.w(", ptr ") ; e.w(allocBase) ; e.w(", i32 0, ")
				e.w(idxType) ; e.w(" ") ; e.w(index) ; e.w("\n")
				aet0 := e.arrayElemType(arrType)
				if aet0 != "" {
					e.setRegType(idx, reg, aet0)
				}
				return
			}
		}
		e.nextReg++
		arrPtr := "%ai" | irItoa(e.nextReg)
		e.w("  ") ; e.w(arrPtr) ; e.w(" = alloca ") ; e.w(arrType) ; e.w("\n")
		e.w("  store ") ; e.w(arrType) ; e.w(" ") ; e.w(base) ; e.w(", ptr ") ; e.w(arrPtr) ; e.w("\n")
		e.w("  ") ; e.w(reg) ; e.w(" = getelementptr inbounds ")
		e.w(arrType) ; e.w(", ptr ") ; e.w(arrPtr) ; e.w(", i32 0, ")
		e.w(idxType) ; e.w(" ") ; e.w(index) ; e.w("\n")
		aet := e.arrayElemType(arrType)
		if aet != "" {
			e.setRegType(idx, reg, aet)
		}
		return
	}
	if len(elemType) > 0 && elemType[0] == '[' {
		aet := e.arrayElemType(elemType)
		e.w("  ") ; e.w(reg) ; e.w(" = getelementptr inbounds ")
		e.w(elemType) ; e.w(", ptr ") ; e.w(base) ; e.w(", i32 0, ")
		e.w(idxType) ; e.w(" ") ; e.w(index) ; e.w("\n")
		e.setRegType(idx, reg, aet)
		return
	}
	e.w("  ")
	if elemType == "void" || elemType == "" {
		elemType = "i8"
	}
	baseLLT := e.llvmType(idx.X.SSAType())
	if baseLLT != "ptr" && baseLLT != "void" && len(baseLLT) > 0 && (baseLLT[0] == 'i' || baseLLT == "float" || baseLLT == "double") {
		e.nextReg++
		casted := "%itp" | irItoa(e.nextReg)
		e.w("  ") ; e.w(casted) ; e.w(" = inttoptr ") ; e.w(baseLLT) ; e.w(" ") ; e.w(base) ; e.w(" to ptr\n")
		base = casted
	}
	e.w(reg)
	e.w(" = getelementptr inbounds ")
	e.w(elemType)
	e.w(", ptr ")
	e.w(base)
	e.w(", ")
	e.w(idxType)
	e.w(" ")
	e.w(index)
	e.w("\n")
}

func (e *irEmitter) emitExtract(ex *SSAExtract) {
	reg := e.regName(ex)
	tupType := e.llvmType(ex.Tuple.SSAType())
	if at, ok := e.allocTypes[ex.Tuple]; ok {
		tupType = at
	}
	if n, ok := ex.Tuple.(*SSANext); ok {
		rangeInstr := n.Iter.(*SSARange)
		if mt, ok2 := SafeUnderlying(rangeInstr.X.SSAType()).(*TCMap); ok2 {
			tupType = "{i1, " | e.llvmType(mt.Key) | ", " | e.llvmType(mt.Elem) | "}"
		} else if arr, ok3 := SafeUnderlying(rangeInstr.X.SSAType()).(*Array); ok3 {
			tupType = "{i1, i32, " | e.llvmType(arr.Elem) | "}"
		} else if p, ok4 := SafeUnderlying(rangeInstr.X.SSAType()).(*Pointer); ok4 {
			if ar, ok5 := SafeUnderlying(p.Base).(*Array); ok5 {
				tupType = "{i1, i32, " | e.llvmType(ar.Elem) | "}"
			}
		} else if bt, okb := SafeUnderlying(rangeInstr.X.SSAType()).(*Basic); okb && bt.Info&IsInteger != 0 {
			// range-over-int: key in the operand's own integer type, no value.
			tupType = "{i1, " | e.llvmType(bt) | ", i8}"
		} else {
			et := "i32"
			if sl, ok6 := SafeUnderlying(rangeInstr.X.SSAType()).(*Slice); ok6 {
				et = e.llvmType(sl.Elem)
			}
			tupType = "{i1, i32, " | et | "}"
		}
	}
	val := e.operand(ex.Tuple)
	// Track extracted element type for downstream alloc/store consistency
	extractedType := extractTupleField(tupType, ex.Index)
	if extractedType != "" {
		ssaType := e.llvmType(ex.SSAType())
		if extractedType != ssaType {
			e.allocTypes[ex] = extractedType
		}
	}
	if tupType == "ptr" || tupType == "void" {
		elemType := e.llvmType(ex.SSAType())
		if elemType == "void" { elemType = "ptr" }
		e.nextReg++
		castReg := "%ev" | irItoa(e.nextReg)
		e.w("  ") ; e.w(castReg) ; e.w(" = getelementptr inbounds i8, ptr ") ; e.w(val) ; e.w(", i32 0\n")
		e.w("  ") ; e.w(reg) ; e.w(" = load ") ; e.w(elemType) ; e.w(", ptr ") ; e.w(castReg) ; e.w("\n")
		e.allocTypes[ex] = elemType
		return
	}
	e.w("  ")
	e.w(reg)
	e.w(" = extractvalue ")
	e.w(tupType)
	e.w(" ")
	e.w(val)
	e.w(", ")
	e.w(irItoa(ex.Index))
	e.w("\n")
}

func (e *irEmitter) sextToIpt(val SSAValue, op string) (s string) {
	ipt := e.intptrType()
	if val == nil {
		return op
	}
	valType := e.llvmType(val.SSAType())
	if valType == ipt {
		return op
	}
	e.nextReg++
	ext := "%sx" | irItoa(e.nextReg)
	srcBits := e.intBits(valType)
	dstBits := e.intBits(ipt)
	if srcBits > dstBits {
		e.w("  ") ; e.w(ext) ; e.w(" = trunc ") ; e.w(valType) ; e.w(" ") ; e.w(op) ; e.w(" to ") ; e.w(ipt) ; e.w("\n")
		return ext
	}
	extOp := "sext"
	if b, ok := SafeUnderlying(val.SSAType()).(*Basic); ok && b.Info&IsUnsigned != 0 {
		extOp = "zext"
	}
	e.w("  ") ; e.w(ext) ; e.w(" = ") ; e.w(extOp) ; e.w(" ") ; e.w(valType) ; e.w(" ") ; e.w(op) ; e.w(" to ") ; e.w(ipt) ; e.w("\n")
	return ext
}

func (e *irEmitter) emitConstMemCpy(m *SSAConstMemCpy) {
	// ConstText lives in the fn arena; stage it in pendArrConsts and merge
	// (copied) after the arena dies - same lifecycle as pendStrConsts. The
	// global index is base + pending position, matching merge order.
	idx := int32(len(e.arrConsts) + len(e.pendArrConsts))
	push(e.pendArrConsts, m.ConstText)
	gname := "@.arr." | irItoa(idx)
	e.w("  call void @llvm.memcpy.p0.p0.i64(ptr " | e.operand(m.Dst) | ", ptr " | gname | ", i64 " | irItoa64(m.Bytes) | ", i1 false)\n")
}

func (e *irEmitter) emitMakeSlice(m *SSAMakeSlice) {
	reg := e.regName(m)
	ipt := e.intptrType()
	sty := e.sliceType()
	lenOp := e.sextToIpt(m.Len, e.operand(m.Len))
	capOp := lenOp
	if m.Cap != nil {
		capOp = e.sextToIpt(m.Cap, e.operand(m.Cap))
	}
	var dataPtr string
	if m.Data != nil {
		dataPtr = e.operand(m.Data)
	} else {
		elemType := "i8"
		if sl, ok := SafeUnderlying(m.SSAType()).(*Slice); ok {
			elemType = e.llvmType(sl.Elem)
		} else if b, ok2 := SafeUnderlying(m.SSAType()).(*Basic); ok2 && b.Info&IsString != 0 {
			elemType = "i8"
		}
		e.nextReg++
		elemSz := "%ms" | irItoa(e.nextReg)
		e.w("  ")
		e.w(elemSz)
		e.w(" = ptrtoint ptr getelementptr (")
		e.w(elemType)
		e.w(", ptr null, i32 1) to ")
		e.w(ipt)
		e.w("\n")
		e.nextReg++
		allocSz := "%ms" | irItoa(e.nextReg)
		e.w("  ")
		e.w(allocSz)
		e.w(" = mul ")
		e.w(ipt)
		e.w(" ")
		e.w(elemSz)
		e.w(", ")
		e.w(capOp)
		e.w("\n")
		e.nextReg++
		dataPtr = "%ms" | irItoa(e.nextReg)
		e.w("  ")
		e.w(dataPtr)
		e.w(" = call ptr @runtime.alloc(")
		e.w(ipt)
		e.w(" ")
		e.w(allocSz)
		e.w(", ptr null, ptr null, ptr null)\n")
		e.declareRuntime("runtime.alloc", "ptr", ipt | ", ptr, ptr")
		e.emitLogAlloc(allocSz)
	}
	e.nextReg++
	s1 := "%ms" | irItoa(e.nextReg)
	e.w("  ")
	e.w(s1)
	e.w(" = insertvalue ")
	e.w(sty)
	e.w(" undef, ptr ")
	e.w(dataPtr)
	e.w(", 0\n")
	e.nextReg++
	s2 := "%ms" | irItoa(e.nextReg)
	e.w("  ")
	e.w(s2)
	e.w(" = insertvalue ")
	e.w(sty)
	e.w(" ")
	e.w(s1)
	e.w(", ")
	e.w(ipt)
	e.w(" ")
	e.w(lenOp)
	e.w(", 1\n")
	e.w("  ")
	e.w(reg)
	e.w(" = insertvalue ")
	e.w(sty)
	e.w(" ")
	e.w(s2)
	e.w(", ")
	e.w(ipt)
	e.w(" ")
	e.w(capOp)
	e.w(", 2\n")
}

func (e *irEmitter) emitSliceOp(s *SSASlice) {
	reg := e.regName(s)
	ipt := e.intptrType()
	sty := e.sliceType()
	src := e.operand(s.X)
	var oldPtr, oldLen, oldCap string
	srcType := SafeUnderlying(s.X.SSAType())
	if p, ok := srcType.(*Pointer); ok && p.Base != nil {
		if arr, ok2 := SafeUnderlying(p.Base).(*Array); ok2 {
			oldPtr = src
			oldLen = irItoa64(arr.Len)
			oldCap = irItoa64(arr.Len)
		}
	}
	if oldPtr == "" {
		if arr, ok := srcType.(*Array); ok {
			// Array value: materialize to a heap copy to obtain its address.
			arrType := e.llvmType(s.X.SSAType())
			e.nextReg++
			sz := "%sl" | irItoa(e.nextReg)
			e.w("  ") ; e.w(sz) ; e.w(" = ptrtoint ptr getelementptr (") ; e.w(arrType) ; e.w(", ptr null, i32 1) to ") ; e.w(ipt) ; e.w("\n")
			e.nextReg++
			tmp := "%sl" | irItoa(e.nextReg)
			e.w("  ") ; e.w(tmp) ; e.w(" = call ptr @runtime.alloc(") ; e.w(ipt) ; e.w(" ") ; e.w(sz) ; e.w(", ptr null, ptr null, ptr null)\n")
			e.declareRuntime("runtime.alloc", "ptr", ipt | ", ptr, ptr")
			e.w("  store ") ; e.w(arrType) ; e.w(" ") ; e.w(src) ; e.w(", ptr ") ; e.w(tmp) ; e.w("\n")
			oldPtr = tmp
			oldLen = irItoa64(arr.Len)
			oldCap = irItoa64(arr.Len)
		} else {
			// Slice value: extract its base pointer and length.
			e.nextReg++
			oldPtr = "%sl" | irItoa(e.nextReg)
			e.w("  ") ; e.w(oldPtr) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(src) ; e.w(", 0\n")
			e.nextReg++
			oldLen = "%sl" | irItoa(e.nextReg)
			e.w("  ") ; e.w(oldLen) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(src) ; e.w(", 1\n")
			e.nextReg++
			oldCap = "%" | irItoa(e.nextReg)
			e.w("  ") ; e.w(oldCap) ; e.w(" = extractvalue ") ; e.w(sty) ; e.w(" ") ; e.w(src) ; e.w(", 2\n")
		}
	}
	low := "0"
	if s.Low != nil {
		low = e.sliceIdxToIpt(s.Low, ipt)
	}
	high := oldLen
	if s.High != nil {
		high = e.sliceIdxToIpt(s.High, ipt)
	}
	if s.Max != nil {
		_ = e.sliceIdxToIpt(s.Max, ipt)
	}
	elemType := "i8"
	if sl, ok := SafeUnderlying(s.X.SSAType()).(*Slice); ok {
		elemType = e.llvmType(sl.Elem)
		if elemType == "void" { elemType = "i8" }
	} else if ar, ok2 := SafeUnderlying(s.X.SSAType()).(*Array); ok2 {
		elemType = e.llvmType(ar.Elem)
		if elemType == "void" { elemType = "i8" }
	} else if p, ok3 := SafeUnderlying(s.X.SSAType()).(*Pointer); ok3 && p.Base != nil {
		if ar2, ok4 := SafeUnderlying(p.Base).(*Array); ok4 {
			elemType = e.llvmType(ar2.Elem)
			if elemType == "void" { elemType = "i8" }
		}
	}
	// Copy rule: a sub-slice allocates len elements and copies. Array bases
	// (and pointers to arrays) stay views - they are not slices and have no
	// allocation to make.
	//
	// No bounds check is emitted - Moxie leaves the indices to the programmer
	// - but an exhausted cursor must not produce a negative length: the
	// tree's `for ; len(r) > 0; r = r[1:]` loops leave `r` empty and the
	// `if len(r) == 0` guards that follow have to fire. Clamp the low bound
	// only, so every valid slice (0 <= low <= high <= len) is untouched.
	isArr := false
	if _, okA := SafeUnderlying(s.X.SSAType()).(*Array); okA {
		isArr = true
	}
	if pA, okP := SafeUnderlying(s.X.SSAType()).(*Pointer); okP && pA.Base != nil {
		if _, okA2 := SafeUnderlying(pA.Base).(*Array); okA2 {
			isArr = true
		}
	}
	lowC := e.uminIpt(ipt, low, oldLen)
	lowC = e.uminIpt(ipt, lowC, high)
	newLen := e.nextReg2("sl")
	e.w("  ") ; e.w(newLen) ; e.w(" = sub ") ; e.w(ipt) ; e.w(" ") ; e.w(high) ; e.w(", ") ; e.w(lowC) ; e.w("\n")
	elemSz := e.nextReg2("sl")
	e.w("  ") ; e.w(elemSz) ; e.w(" = ptrtoint ptr getelementptr (") ; e.w(elemType) ; e.w(", ptr null, i32 1) to ") ; e.w(ipt) ; e.w("\n")
	srcOff := e.nextReg2("sl")
	e.w("  ") ; e.w(srcOff) ; e.w(" = mul ") ; e.w(ipt) ; e.w(" ") ; e.w(lowC) ; e.w(", ") ; e.w(elemSz) ; e.w("\n")
	srcPtr := e.nextReg2("sl")
	e.w("  ") ; e.w(srcPtr) ; e.w(" = getelementptr inbounds i8, ptr ") ; e.w(oldPtr) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(srcOff) ; e.w("\n")
	basePtr := srcPtr
	newCap := e.nextReg2("sl")
	if isArr {
		e.w("  ") ; e.w(newCap) ; e.w(" = sub ") ; e.w(ipt) ; e.w(" ") ; e.w(oldCap) ; e.w(", ") ; e.w(lowC) ; e.w("\n")
	} else {
		byteLen := e.nextReg2("sl")
		e.w("  ") ; e.w(byteLen) ; e.w(" = mul ") ; e.w(ipt) ; e.w(" ") ; e.w(elemSz) ; e.w(", ") ; e.w(newLen) ; e.w("\n")
		buf := e.nextReg2("sl")
		e.w("  ") ; e.w(buf) ; e.w(" = call ptr @runtime.alloc(") ; e.w(ipt) ; e.w(" ") ; e.w(byteLen) ; e.w(", ptr null, ptr null, ptr null)\n")
		e.declareRuntime("runtime.alloc", "ptr", ipt | ", ptr, ptr")
		e.w("  call ") ; e.w(ipt) ; e.w(" @runtime.sliceCopy(ptr ") ; e.w(buf) ; e.w(", ptr ") ; e.w(srcPtr) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(newLen) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(newLen) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(elemSz) ; e.w(", ptr null)\n")
		e.declareRuntime("runtime.sliceCopy", ipt, "ptr, ptr, " | ipt | ", " | ipt | ", " | ipt)
		isZero := e.nextReg2("sl")
		e.w("  ") ; e.w(isZero) ; e.w(" = icmp eq ") ; e.w(ipt) ; e.w(" ") ; e.w(newLen) ; e.w(", 0\n")
		basePtr = e.nextReg2("sl")
		e.w("  ") ; e.w(basePtr) ; e.w(" = select i1 ") ; e.w(isZero) ; e.w(", ptr null, ptr ") ; e.w(buf) ; e.w("\n")
		e.w("  ") ; e.w(newCap) ; e.w(" = add ") ; e.w(ipt) ; e.w(" ") ; e.w(newLen) ; e.w(", 0\n")
	}
	s1 := e.nextReg2("sl")
	e.w("  ") ; e.w(s1) ; e.w(" = insertvalue ") ; e.w(sty) ; e.w(" undef, ptr ") ; e.w(basePtr) ; e.w(", 0\n")
	s2 := e.nextReg2("sl")
	e.w("  ") ; e.w(s2) ; e.w(" = insertvalue ") ; e.w(sty) ; e.w(" ") ; e.w(s1) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(newLen) ; e.w(", 1\n")
	e.w("  ") ; e.w(reg) ; e.w(" = insertvalue ") ; e.w(sty) ; e.w(" ") ; e.w(s2) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(newCap) ; e.w(", 2\n")
}

// uminIpt emits the unsigned minimum of two intptr-width values, the clamp a
// slice index needs so an exhausted cursor stays an empty view of its parent.
func (e *irEmitter) uminIpt(ipt, a, b string) (s string) {
	lt := e.nextReg2("mn")
	e.w("  ") ; e.w(lt) ; e.w(" = icmp ult ") ; e.w(ipt) ; e.w(" ") ; e.w(a) ; e.w(", ") ; e.w(b) ; e.w("\n")
	s = e.nextReg2("mn")
	e.w("  ") ; e.w(s) ; e.w(" = select i1 ") ; e.w(lt) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(a) ; e.w(", ") ; e.w(ipt) ; e.w(" ") ; e.w(b) ; e.w("\n")
	return
}

func (e *irEmitter) sliceIdxToIpt(val SSAValue, ipt string) (s string) {
	operandStr := e.operand(val)
	valType := e.llvmType(val.SSAType())
	if valType == ipt {
		return operandStr
	}
	if valType == "void" || valType == "" {
		return "0"
	}
	e.nextReg++
	ext := "%sl" | irItoa(e.nextReg)
	srcBits := e.intBits(valType)
	dstBits := e.intBits(ipt)
	if srcBits > dstBits {
		e.w("  ") ; e.w(ext) ; e.w(" = trunc ") ; e.w(valType) ; e.w(" ") ; e.w(operandStr) ; e.w(" to ") ; e.w(ipt) ; e.w("\n")
		return ext
	}
	op := "sext"
	if b, ok2 := SafeUnderlying(val.SSAType()).(*Basic); ok2 && b.Info&IsUnsigned != 0 {
		op = "zext"
	}
	e.w("  ") ; e.w(ext) ; e.w(" = ") ; e.w(op) ; e.w(" ") ; e.w(valType) ; e.w(" ") ; e.w(operandStr) ; e.w(" to ") ; e.w(ipt) ; e.w("\n")
	return ext
}

func (e *irEmitter) emitPanic(p *SSAPanic) {
	ity := e.sliceType()
	arg := "zeroinitializer"
	if p.X != nil && p.X.SSAType() != nil {
		arg = e.operand(p.X)
		if arg == "" {
			arg = "zeroinitializer"
		}
	}
	e.w("  call void @runtime._panic(" | ity | " ") ; e.w(arg) ; e.w(", ptr null)\n")
	e.declareRuntime("runtime._panic", "void", ity)
	e.w("  unreachable\n")
}

func (e *irEmitter) operandNoSideEffect(v SSAValue) (s string) {
	if v == nil {
		return "zeroinitializer"
	}
	if c, ok := v.(*SSAConst); ok {
		return e.constOperand(c)
	}
	if n, ok := e.valName[v]; ok {
		return n
	}
	return ""
}

func (e *irEmitter) operand(v SSAValue) (s string) {
	if v == nil {
		return "zeroinitializer"
	}
	if c, ok := v.(*SSAConst); ok {
		return e.constOperand(c)
	}
	if b, ok := v.(*SSABuiltin); ok {
		return "@runtime." | b.SSAName()
	}
	if f, ok := v.(*SSAFunction); ok {
		if !e.isPkgFunc(f) {
			// Func used as a value: ensure the symbol is declared, the
			// call-emission path is never reached for it.
			e.declareExternalFunc(f)
		}
		return "{ ptr null, ptr " | e.funcSymbol(f) | " }"
	}
	if g, ok := v.(*SSAGlobal); ok {
		e.declareExternalGlobal(g)
		return e.globalName(g)
	}
	return e.regName(v)
}

func (e *irEmitter) constOperand(c *SSAConst) (s string) {
	if c.val == nil {
		if c.typ == nil {
			return "null"
		}
		typ := e.llvmType(c.typ)
		if typ == "ptr" {
			return "null"
		}
		if typ == "i1" {
			return "false"
		}
		return "zeroinitializer"
	}
	b := underlyingBasic(c.typ)
	if b != nil {
		switch b.Kind {
		case Bool, UntypedBool:
			if cb, ok := c.val.(*ConstBool); ok {
				if cb.V {
					return "true"
				}
				return "false"
			}
			sv := c.val.String()
			if sv == "true" {
				return "true"
			}
			return "false"
		case Int8, Int16, Int32, Int64, Uint8, Uint16, Uint32, Uint64,
			UntypedInt, UntypedRune:
			if ci, ok := c.val.(*ConstInt); ok {
				v := ci.V
				switch b.Kind {
				case Int8:
					v = int64(int8(v))
				case Uint8:
					v = int64(uint8(v))
				case Int16:
					v = int64(int16(v))
				case Uint16:
					v = int64(uint16(v))
				case Int32:
					v = int64(int32(v))
				case Uint32:
					v = int64(uint32(v))
				case UntypedInt, UntypedRune:
					// The unsigned mark means the exact value is >= 2^63 even
					// though V holds its low bits, so the constant needs 64
					// bits just as much as a large negative one does
					// (math.MaxUint64 is V=-1 with the mark).
					if v < -2147483648 || v > 4294967295 || ci.Unsigned {
						e.allocTypes[c] = "i64"
					}
				}
				return irItoa64(v)
			}
			if cf, ok := c.val.(*ConstFloat); ok {
				return irItoa64(int64(cf.V))
			}
			if cs, ok := c.val.(*ConstStr); ok {
				if len(cs.S) == 0 {
					return "zeroinitializer"
				}
				e.allocTypes[c] = e.sliceType()
				return e.stringConstOperand(c, cs.S)
			}
			return c.val.String()
		case Float32:
			if cf, ok := c.val.(*ConstFloat); ok {
				if cf.Lit != "" {
					return NormalizeLLVMFloat(cf.Lit)
				}
				bits := math.Float64bits(float64(float32(cf.V)))
				return "0x" | irHex64(bits)
			}
			return "0.0"
		case Float64, UntypedFloat:
			if cf, ok := c.val.(*ConstFloat); ok {
				if cf.Lit != "" {
					return NormalizeLLVMFloat(cf.Lit)
				}
				bits := math.Float64bits(cf.V)
				return "0x" | irHex64(bits)
			}
			return "0.0"
		case TCString, UntypedString:
			if cs, ok := c.val.(*ConstStr); ok {
				if len(cs.S) == 0 {
					return "zeroinitializer"
				}
				return e.stringConstOperand(c, cs.S)
			}
			return "zeroinitializer"
		}
	}
	if c.typ == nil {
		return c.val.String()
	}
	return "zeroinitializer"
}

// instrOperands leaves the instruction's operands in e.operandBuf and returns
// NOTHING. Returning the slice was a whole-package deep copy per instruction:
// the elements are SSAValue interfaces, so the return protocol encoded every
// operand's graph (block -> function -> package -> the member map) and decoded
// a copy of it into the caller's arena. Measured: 3.2 GB live inside `math`'s
// emit, all of it in codecDecodeValue <- instrOperands, with the allocations
// recorded one by one in the emitter's sovereign arena (sovAddRec).
func (e *irEmitter) instrOperands(instr SSAInstruction) {
	// Reuse scratch slice to avoid per-instruction allocation.
	e.operandBuf = resize(e.operandBuf, 0)
	switch i := instr.(type) {
	case *SSAStore:
		push(e.operandBuf, i.Addr, i.Val)
	case *SSAConstMemCpy:
		push(e.operandBuf, i.Dst)
	case *SSAUnOp:
		push(e.operandBuf, i.X)
	case *SSABinOp:
		push(e.operandBuf, i.X, i.Y)
	case *SSACall:
		push(e.operandBuf, i.Call.Value)
		for _, a := range i.Call.Args {
			push(e.operandBuf, a)
		}
	case *SSAFieldAddr:
		push(e.operandBuf, i.X)
	case *SSAIndexAddr:
		push(e.operandBuf, i.X, i.Index)
	case *SSAExtract:
		push(e.operandBuf, i.Tuple)
	case *SSAPhi:
		// Copied into the scratch buffer rather than aliased: e.operandBuf is
		// grown in place below, and handing it the phi's own backing would let
		// the next push write through to the phi.
		for _, ed := range i.Edges {
			push(e.operandBuf, ed)
		}
	case *SSAReturn:
		for _, r := range i.Results {
			push(e.operandBuf, r)
		}
	case *SSAIf:
		push(e.operandBuf, i.Cond)
	case *SSAConvert:
		push(e.operandBuf, i.X)
	case *SSAChangeType:
		push(e.operandBuf, i.X)
	case *SSAMakeInterface:
		push(e.operandBuf, i.X)
	case *SSATypeAssert:
		push(e.operandBuf, i.X)
	case *SSASlice:
		push(e.operandBuf, i.X)
		if i.Low != nil { e.operandBuf = mxutil.Ensure(e.operandBuf, 1); push(e.operandBuf, i.Low) }
		if i.High != nil { e.operandBuf = mxutil.Ensure(e.operandBuf, 1); push(e.operandBuf, i.High) }
		if i.Max != nil { e.operandBuf = mxutil.Ensure(e.operandBuf, 1); push(e.operandBuf, i.Max) }
	case *SSAMapUpdate:
		push(e.operandBuf, i.Map, i.Key, i.Value)
	case *SSALookup:
		push(e.operandBuf, i.X, i.Index)
	case *SSARange:
		push(e.operandBuf, i.X)
	case *SSANext:
		push(e.operandBuf, i.Iter)
	case *SSASend:
		push(e.operandBuf, i.Chan, i.X)
	case *SSAMakeSlice:
		push(e.operandBuf, i.Len)
		if i.Cap != nil { e.operandBuf = mxutil.Ensure(e.operandBuf, 1); push(e.operandBuf, i.Cap) }
		if i.Data != nil { e.operandBuf = mxutil.Ensure(e.operandBuf, 1); push(e.operandBuf, i.Data) }
	}
}

