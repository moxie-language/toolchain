package main

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"git.smesh.lol/moxie/pkg/syntax"
	"git.smesh.lol/moxie/pkg/token"
	. "git.smesh.lol/moxie/pkg/types"
)

func asType(t Type) (tv Type) { return t }

// ssaConstEqual compares two SSAConst values for equality.
// Used to fold constant switch cases at SSA build time.
func ssaConstEqual(a, b *SSAConst) (eq bool) {
	if a.val == nil && b.val == nil {
		return true
	}
	if a.val == nil || b.val == nil {
		return false
	}
	switch av := a.val.(type) {
	case *ConstStr:
		if bv, ok := b.val.(*ConstStr); ok {
			if len(av.S) != len(bv.S) {
				return false
			}
			for i := int32(0); i < len(av.S); i++ {
				if av.S[i] != bv.S[i] {
					return false
				}
			}
			return true
		}
	case *ConstInt:
		if bv, ok := b.val.(*ConstInt); ok {
			return av.V == bv.V
		}
	case *ConstBool:
		if bv, ok := b.val.(*ConstBool); ok {
			return av.V == bv.V
		}
	}
	return false
}

// CreatePackage builds the SSA Package from type-checked syntax files.
func (prog *SSAProgram) CreatePackage(pkg *TCPackage, files []*syntax.File, info *Info) (s *SSAPackage) {
	p := &SSAPackage{
		Prog:        prog,
		Pkg:         pkg,
		Members:     map[string]SSAMember{},
		ImportNames: packageImportNames(files),
	}
	prog.packages[pkg] = p
	prog.imported[pkg.Path] = p

	pb := &ssaPkgBuilder{pkg: p, info: info, prog: prog}

	// Imports are file-scoped: each file gets a scope (parent = pkg scope)
	// holding its own PkgName bindings, so two files can bind the same
	// local name to different packages. The driver concatenates all package
	// files into one syntax.File with a hoisted+deduped import block, so the
	// per-file association comes from mxutil.ConcatImportSegs (per-file import
	// specs + concat start line), and decls map to their file's scope by
	// position.
	pb.fileScopes = map[*syntax.File]*Scope{}
	pb.varInitScopes = map[*syntax.VarDecl]*Scope{}
	for _, f := range files {
		pb.fileScopes[f] = NewScope(pkg.Scope)
	}
	pb.buildImportSegScopes()

	for _, f := range files {
		if f == nil {
			continue
		}
		pb.curFileScope = pb.fileScopes[f]
		pb.registerImportsAndTypes(f)
	}
	for _, f := range files {
		pb.curFileScope = pb.fileScopes[f]
		pb.registerFile(f)
	}
	for _, f := range files {
		pb.curFileScope = pb.fileScopes[f]
		pb.buildFile(f)
	}
	pb.curFileScope = nil
	if len(pb.varInits) > 0 || pb.initFn != nil {
		pb.buildVarInits()
	}
	// Every body has been built by now, so the import marks are complete.
	pb.checkUnusedImports()
	// Restriction checks run before the compileErrors gate in ir_typecheck.
	for _, member := range p.Members {
		if f, ok := member.(*SSAFunction); ok {
			checkGlobalMutation(f)
		}
	}
	checkSovereignLoopDecls(p, files)
	checkShadowing(files)
	pb.checkImportConflicts(files)
	checkPackageDecls(files, pkg.Path)
	checkDuplicateCases(p, files)
	checkMissingReturn(files)
	checkClosureCaptures(p)
	scanWasmSpawnTargets(p)
	return p
}

// ssaPkgBuilder builds one SSAPackage.
type ssaPkgBuilder struct {
	pkg           *SSAPackage
	info          *Info
	prog          *SSAProgram
	varInits      []*syntax.VarDecl
	// initFn is the package's single init() function, registered like any
	// other function and called at the end of the package entry that
	// runtime.initAll invokes. Legacy allows one init() per package (main
	// packages excepted) and runs it; stage4 skipped every init after printing
	// a message, so a library's setup never happened.
	initFn        *SSAFunction
	// segImports records every import of every source file, one entry per
	// spec, so checkUnusedImports can report the ones nothing referred to.
	segImports    []segImport
	// declared is every top-level function name seen in this package. A
	// redeclaration used to be accepted silently: the second body replaced the
	// first in the member map, so `func main()` twice compiled and ran the
	// first body while the file that lost was never reported. Legacy rejects
	// it through go/types ("main redeclared in this block"), so stage4 accepts
	// nothing legacy does not.
	declared      map[string]bool
	fileScopes    map[*syntax.File]*Scope
	curFileScope  *Scope
	varInitScopes map[*syntax.VarDecl]*Scope
	segScopes     []segScope
}

// segScope is one source file's import scope in the concatenated package
// stream, keyed by the concat line its body starts at.
type segScope struct {
	outStart int32
	scope    *Scope
}

// buildImportSegScopes turns the driver's per-file import segments into
// scopes holding each file's PkgName bindings.
// segImport is one import spec of one source file. seg is the index of the
// file's body in ConcatImportSegs, which is what pairs the import with the
// text the check scans. dot marks a dot import, whose members are bound
// directly in the file scope instead of under a package name.
type segImport struct {
	seg   int32
	path  string
	local string
	dot   bool
	// target is the imported package. A dot import binds no name, so the
	// check has to look for the package's own members in the file; the other
	// forms only need the name they bind.
	target *TCPackage
}

// checkUnusedImports reports an imported package whose name never appears in
// its own file's body. go/types rejects these on the legacy side ("math"
// imported and not used); stage4 linked them and said nothing, so a file could
// import a package it never mentioned and only the legacy compiler would
// object.
//
// Per file, not per package: two files may import the same package and one of
// them not using it is an error even when the other does. A dot import binds
// the package's members rather than a name, so it is left alone (see
// buildImportSegScopes).
//
// The test is textual - does the local name appear as a whole identifier in
// the file's source range - rather than a record of resolved uses. Resolution
// cannot answer this per file: an import name is bound in the file's scope and
// in the package scope, So a lookup may reach either object, and the package
// scope holds one shared binding for every file that imports the name. Scanning
// the text errs only towards missing a report (a name mentioned in a comment or
// string counts as used), which is the safe direction for a rule whose
// false positives would refuse valid code; it never reports an import that the
// file really uses.
func (pb *ssaPkgBuilder) checkUnusedImports() {
	if len(pb.segImports) == 0 {
		return
	}
	src := cctx.tcPkgSrc
	if len(src) == 0 {
		return
	}
	for _, im := range pb.segImports {
		startLine := pb.segStartLine(im.seg)
		if startLine <= 0 {
			continue
		}
		endLine := pb.segStartLine(im.seg + 1)
		body := concatSegText(src, startLine, endLine)
		if im.dot {
			// A dot import is used when one of the package's exported names
			// appears in the file. go/types reports an unused dot import the
			// same way it reports a named one ("path" imported and not used);
			// stage4 did not, which was the last gap in this check.
			if dotImportMentioned(body, im.target) {
				continue
			}
			cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
			push(cctx.compileErrors, "\"" | im.path | "\" imported and not used")
			continue
		}
		if identAppearsOutsideImports(body, im.local) {
			continue
		}
		elem := im.path
		for i := len(im.path) - 1; i >= 0; i-- {
			if im.path[i] == '/' {
				elem = im.path[i+1:]
				break
			}
		}
		// go/types names the alias only when it differs from the path
		// element, which covers both a renamed import and a package whose
		// declared name does not match its directory.
		msg := "\"" | im.path | "\" imported and not used"
		if im.local != "" && im.local != elem {
			msg = "\"" | im.path | "\" imported as " | im.local | " and not used"
		}
		cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
		push(cctx.compileErrors, msg)
	}
}

// dotImportMentioned reports whether a dot import's package contributes any
// name to the file. An unresolved package counts as mentioned: without its
// scope there is nothing to look for, and reporting an import the file may
// well use would refuse valid code.
func dotImportMentioned(body string, target *TCPackage) (ok bool) {
	if target == nil || target.Scope == nil {
		return true
	}
	names := target.Scope.Names()
	for i := int32(0); i < int32(len(names)); i++ {
		n := names[i]
		if len(n) == 0 || n[0] < 'A' || n[0] > 'Z' {
			// Unexported names cannot be reached through a dot import, and
			// matching them would only hide a genuinely unused one.
			continue
		}
		if identAppearsOutsideImports(body, n) {
			return true
		}
	}
	return false
}

// segStartLine returns the 1-based line one source file's body starts at, or 0
// when there is no such segment (the end of the package).
func (pb *ssaPkgBuilder) segStartLine(seg int32) (n int32) {
	if seg < 0 || seg >= int32(len(pb.segScopes)) {
		return 0
	}
	return pb.segScopes[seg].outStart
}

// concatSegText returns the concatenated source between two 1-based start
// lines; endLine 0 means the end of the text.
func concatSegText(src string, startLine, endLine int32) (t string) {
	start := lineStartByte(src, startLine)
	end := int32(len(src))
	if endLine > startLine {
		end = lineStartByte(src, endLine)
	}
	if start >= end {
		return ""
	}
	return src[start:end]
}

// lineStartByte returns the byte offset line starts at, 1-based; a line past
// the end returns the end of the text.
func lineStartByte(src string, line int32) (off int32) {
	if line <= 1 {
		return 0
	}
	cur := int32(1)
	for i := int32(0); i < int32(len(src)); i++ {
		if src[i] != '\n' {
			continue
		}
		cur++
		if cur == line {
			return i + 1
		}
	}
	return int32(len(src))
}

// identAppearsOutsideImports is identAppears over the parts of a segment that
// are not an import declaration.
//
// A file's concatenated body starts at its own import block, so the path
// string of the import being tested is in the text: "…/pkg/mxutil" contains
// the local name mxutil as a whole identifier, and a plain text search would
// find every import used. Import declarations are therefore skipped: a line
// opening an import block (or a single-line import) is skipped entirely, and
// the lines up to the closing ')' are skipped with it.
func identAppearsOutsideImports(body, name string) (ok bool) {
	inImport := false
	i := int32(0)
	for i <= int32(len(body)) {
		le := i
		for le < int32(len(body)) && body[le] != '\n' {
			le++
		}
		ts := lineTrimStart(body, i, le)
		if inImport {
			if ts < le && body[ts] == ')' {
				inImport = false
			}
		} else if lineOpensImport(body, ts, le) {
			if importBlockStaysOpen(body, ts, le) {
				inImport = true
			}
		} else if identAppears(body[i:le], name) {
			return true
		}
		i = le + 1
	}
	return false
}

func lineTrimStart(s string, i, le int32) (t int32) {
	t = i
	for t < le && (s[t] == ' ' || s[t] == '\t' || s[t] == '\r') {
		t++
	}
	return t
}

// lineOpensImport reports whether the line begins with the import keyword.
func lineOpensImport(s string, ts, le int32) (ok bool) {
	if le-ts < 6 {
		return false
	}
	if s[ts] != 'i' || s[ts+1] != 'm' || s[ts+2] != 'p' || s[ts+3] != 'o' || s[ts+4] != 'r' || s[ts+5] != 't' {
		return false
	}
	return ts+6 == le || !importIdentByte(s[ts+6])
}

// importBlockStaysOpen reports whether an import line opens a parenthesized
// block that later lines continue.
func importBlockStaysOpen(s string, ts, le int32) (ok bool) {
	hasOpen := false
	hasClose := false
	for k := ts; k < le; k++ {
		if s[k] == '(' {
			hasOpen = true
		}
		if s[k] == ')' {
			hasClose = true
		}
	}
	return hasOpen && !hasClose
}

// identAppears reports whether name occurs in text as a whole identifier, so a
// shorter name inside a longer one does not count.
func identAppears(text, name string) (ok bool) {
	n := int32(len(name))
	if n == 0 || n > int32(len(text)) {
		return false
	}
	for i := int32(0); i+n <= int32(len(text)); i++ {
		matched := true
		for j := int32(0); j < n; j++ {
			if text[i+j] != name[j] {
				matched = false
				break
			}
		}
		if !matched {
			continue
		}
		if i > 0 && importIdentByte(text[i-1]) {
			continue
		}
		if i+n < int32(len(text)) && importIdentByte(text[i+n]) {
			continue
		}
		return true
	}
	return false
}

func importIdentByte(c byte) (ok bool) {
	if c == '_' {
		return true
	}
	if c >= 'a' && c <= 'z' {
		return true
	}
	if c >= 'A' && c <= 'Z' {
		return true
	}
	return c >= '0' && c <= '9'
}

func (pb *ssaPkgBuilder) buildImportSegScopes() {
	pb.segScopes = nil
	pb.segImports = nil
	for si := 0; si < len(mxutil.ConcatImportSegs()); si++ {
		seg := mxutil.ConcatImportSegs()[si]
		sc := NewScope(pb.pkg.Pkg.Scope)
		for _, spec := range seg.Specs {
			path := mxutil.ExtractQuoted(spec)
			if path == "" {
				continue
			}
			alias := importSpecAlias(spec)
			if alias == "." {
				// A dot import binds the package's members in the file scope
				// rather than a name, so the check looks for the members. The
				// target is still resolved, so an unresolved one is treated as
				// used below rather than reported.
				pb.segImports = mxutil.Ensure(pb.segImports, 1)
				push(pb.segImports, segImport{seg: si, path: path, local: ".", dot: true, target: pb.resolveImportTarget(path)})
				continue
			}
			if alias == "_" {
				continue
			}
			target := pb.resolveImportTarget(path)
			if target == nil {
				continue
			}
			localName := alias
			if localName == "" {
				localName = target.Name
			}
			if localName == "" {
				for i := len(path) - 1; i >= 0; i-- {
					if path[i] == '/' {
						localName = path[i+1:]
						break
					}
				}
				if localName == "" {
					localName = path
				}
			}
			sc.Insert(NewPkgName(nil, localName, target))
			pb.segImports = mxutil.Ensure(pb.segImports, 1)
			push(pb.segImports, segImport{seg: si, path: path, local: localName})
		}
		pb.segScopes = mxutil.Ensure(pb.segScopes, 1)
		push(pb.segScopes, segScope{outStart: seg.OutStart, scope: sc})
	}
}

// importSpecAlias returns the local alias of a raw import spec line
// (`alias "path"`), or "" when the spec has no alias.
func importSpecAlias(spec string) (s string) {
	for i := int32(0); i < int32(len(spec)); i++ {
		if spec[i] == '"' {
			return mxutil.TrimSpace(spec[:i])
		}
	}
	return ""
}

func (pb *ssaPkgBuilder) resolveImportTarget(path string) (t *TCPackage) {
	impPkg := pb.prog.ImportedPackage(path)
	if impPkg != nil && impPkg.Pkg != nil {
		return impPkg.Pkg
	}
	return cctx.universe.Registry[path]
}

// declScope returns the import scope of the source file a decl came from.
// Decls before the first segment (the hoisted import block) get nil.
func (pb *ssaPkgBuilder) declScope(d syntax.Decl) (sc *Scope) {
	if len(pb.segScopes) == 0 {
		return pb.curFileScope
	}
	// Pos() lives on the embedded node base; interface dispatch does not
	// cover embedded-base methods of another package's types, so switch on
	// the concrete decl types.
	line := int32(0)
	switch dd := d.(type) {
	case *syntax.ImportDecl:
		dp := dd.Pos()
		line = int32(dp.Line())
	case *syntax.ConstDecl:
		dp := dd.Pos()
		line = int32(dp.Line())
	case *syntax.TypeDecl:
		dp := dd.Pos()
		line = int32(dp.Line())
	case *syntax.VarDecl:
		dp := dd.Pos()
		line = int32(dp.Line())
	case *syntax.FuncDecl:
		dp := dd.Pos()
		line = int32(dp.Line())
	}
	// The declaration's line and a segment's outStart are both 1-based
	// concatenated-source lines, so they compare directly. (This used to add 1
	// to undo Parser.pos's 0-based line.)
	var best *Scope
	for i := 0; i < len(pb.segScopes); i++ {
		if pb.segScopes[i].outStart <= line {
			best = pb.segScopes[i].scope
		}
	}
	return best
}

func (pb *ssaPkgBuilder) registerImportsAndTypes(f *syntax.File) {
	for _, d := range f.DeclList {
		if d == nil {
			continue
		}
		pb.curFileScope = pb.declScope(d)
		switch dd := d.(type) {
		case *syntax.ImportDecl:
			pb.registerImport(dd)
		case *syntax.TypeDecl:
			pb.registerType(dd)
		default:
		}
	}
}

func (pb *ssaPkgBuilder) registerFile(f *syntax.File) {
	for _, d := range f.DeclList {
		pb.curFileScope = pb.declScope(d)
		switch dd := d.(type) {
		case *syntax.FuncDecl:
			// Both functions and methods are FuncDecls, so one call covers the
			// rule for each; registerFunc's early returns for methods would
			// otherwise skip it.
			checkNamedReturns(dd, pb.pkg.Pkg.Path)
			pb.registerFunc(dd)
		case *syntax.VarDecl:
			pb.registerVar(dd)
		case *syntax.ConstDecl:
			pb.registerConst(dd)
		}
	}
}

func (pb *ssaPkgBuilder) registerImport(d *syntax.ImportDecl) {
	if d.Path == nil {
		return
	}
	path := d.Path.Value
	if len(path) >= 2 && path[0] == '"' {
		path = path[1 : len(path)-1]
	}
	localName := ""
	if d.LocalPkgName != nil {
		localName = d.LocalPkgName.Value
	}
	target := pb.resolveImportTarget(path)
	if target == nil {
		return
	}
	// Default name is the package clause name, NOT the path tail: the two
	// differ for packages like crypto/ec (package btcec).
	if localName == "" {
		localName = target.Name
	}
	if localName == "" {
		for i := len(path) - 1; i >= 0; i-- {
			if path[i] == '/' {
				localName = path[i+1:]
				break
			}
		}
		if localName == "" {
			localName = path
		}
	}
	if localName == "." || localName == "_" {
		return
	}
	// Track all direct imports regardless of local-name collisions.
	tcp := pb.pkg.Pkg
	found := false
	for _, ip := range tcp.Imports {
		if ip == target {
			found = true
			break
		}
	}
	if !found {
		tcp.Imports = mxutil.Ensure(tcp.Imports, 1)
		push(tcp.Imports, target)
	}
	pn := NewPkgName(nil, localName, target)
	// File scope binding wins over a same-named import in another file.
	if pb.curFileScope != nil {
		pb.curFileScope.Insert(pn)
	}
	// Legacy fallback for lookup paths without file context: first-wins.
	if existing := pb.pkg.Pkg.Scope.Lookup(localName); existing != nil {
		return
	}
	pb.pkg.Pkg.Scope.Insert(pn)
}

func pkgResolveTypeAST(pkg *SSAPackage, e syntax.Expr) (t Type) {
	if e == nil {
		return nil
	}
	switch ev := e.(type) {
	case *syntax.Name:
		if _, obj := Universe.LookupParent(ev.Value); obj != nil {
			if tn, ok := obj.(*TypeName); ok {
				return tn.Typ
			}
		}
		if pkg != nil {
			obj := pkg.Pkg.Scope.Lookup(ev.Value)
			if tn, ok := obj.(*TypeName); ok {
				return tn.Typ
			}
		}
	case *syntax.Operation:
		if ev.Y == nil && ev.Op == token.Mul {
			base := pkgResolveTypeAST(pkg, ev.X)
			if base != nil {
				return NewPointer(base)
			}
		}
	case *syntax.ArrayType:
		elem := pkgResolveTypeAST(pkg, ev.Elem)
		if elem != nil {
			n := int64(-1)
			if lit, ok := ev.Len.(*syntax.BasicLit); ok {
				n = ssaParseInt64(lit.Value)
			}
			return NewArray(elem, n)
		}
	case *syntax.SliceType:
		elem := pkgResolveTypeAST(pkg, ev.Elem)
		if elem != nil {
			if b, ok := elem.(*Basic); ok && b.Kind == Uint8 {
				return Typ[TCString]
			}
			return NewSlice(elem)
		}
	case *syntax.MapType:
		key := pkgResolveTypeAST(pkg, ev.Key)
		val := pkgResolveTypeAST(pkg, ev.Value)
		if key != nil && val != nil {
			return NewTCMap(key, val)
		}
	case *syntax.FuncType:
		return pkgResolveSigAST(pkg, ev)
	case *syntax.SelectorExpr:
		if x, ok := ev.X.(*syntax.Name); ok {
			pn, _ := pkg.Pkg.Scope.Lookup(x.Value).(*PkgName)
			if pn != nil && pn.Imported != nil {
				sel := pn.Imported.Scope.Lookup(ev.Sel.Value)
				if tn, ok2 := sel.(*TypeName); ok2 {
					return tn.Typ
				}
			}
		}
	case *syntax.InterfaceType:
		return resolveInterfaceFromAST(ev)
	case *syntax.DotsType:
		elem := pkgResolveTypeAST(pkg, ev.Elem)
		if elem != nil {
			if b, ok := elem.(*Basic); ok && b.Kind == Uint8 {
				return Typ[TCString]
			}
			return NewSlice(elem)
		}
		// See tcResolveNameInline's DotsType: a nil element type here leaves the
		// parameter `void` while the variadic flag stays true, so callers build a
		// slice for a void parameter. Name the type rather than emit that.
		push(cctx.compileErrors, "undefined: " | typeExprName(ev.Elem))
		return nil
	}
	return nil
}

func pkgResolveSigAST(pkg *SSAPackage, ft *syntax.FuncType) (s *Signature) {
	if ft == nil {
		return nil
	}
	var params []*TCVar
	for _, p := range ft.ParamList {
		typ := pkgResolveTypeAST(pkg, p.Type)
		pname := ""
		if p.Name != nil {
			pname = p.Name.Value
		}
		params = mxutil.Ensure(params, 1)
		push(params, NewTCVar(nil, pname, typ))
	}
	var results []*TCVar
	for _, r := range ft.ResultList {
		typ := pkgResolveTypeAST(pkg, r.Type)
		rname := ""
		if r.Name != nil {
			rname = r.Name.Value
		}
		results = mxutil.Ensure(results, 1)
		push(results, NewTCVar(nil, rname, typ))
	}
	variadic := false
	if len(ft.ParamList) > 0 {
		if _, ok := ft.ParamList[len(ft.ParamList)-1].Type.(*syntax.DotsType); ok {
			variadic = true
		}
	}
	var pTuple, rTuple *Tuple
	if len(params) > 0 {
		pTuple = NewTuple(params...)
	}
	if len(results) > 0 {
		rTuple = NewTuple(results...)
	}
	return NewSignature(nil, pTuple, rTuple, variadic)
}

func (pb *ssaPkgBuilder) registerFunc(d *syntax.FuncDecl) {
	if len(d.TParamList) > 0 {
		return
	}
	if d.Recv != nil {
		// Receiver-qualified so T.M and U.M coexist, but two T.M do not:
		// legacy reports "method T.M already declared in this block" and
		// stage4 used to let the later body replace the earlier one.
		recvName := ssaRecvTypeName(d.Recv)
		if recvName != "" && d.Name.Value != "_" {
			key := "method " | recvName | "." | d.Name.Value
			if pb.declared == nil {
				pb.declared = map[string]bool{}
			}
			if pb.declared[key] {
				cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
				push(cctx.compileErrors, key | " already declared")
				return
			}
			pb.declared[key] = true
		}
		pb.registerMethod(d)
		return
	}
	if d.Name.Value == "init" {
		if pb.pkg.Pkg.Name == "main" && !testWrapsLibrary() {
			cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
			push(cctx.compileErrors, "init() is not allowed in main package: use main() for program entry")
			return
		}
		if pb.initFn != nil {
			cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
			push(cctx.compileErrors, "at most one init() per package")
			return
		}
	}
	// A second declaration of the same top-level name is an error, the same
	// one go/types reports. Before this, the later body silently replaced the
	// earlier member and the earlier body still ran. The blank identifier is
	// never a redeclaration - math/big declares `_` several times, which
	// run_tests.sh caught the moment this check landed without the exemption.
	if d.Name.Value != "_" {
		if pb.declared == nil {
			pb.declared = map[string]bool{}
		}
		if pb.declared[d.Name.Value] {
			cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
			push(cctx.compileErrors, d.Name.Value | " redeclared in this block")
			return
		}
		pb.declared[d.Name.Value] = true
	}
	var obj *TCFunc
	if o := pb.pkg.Pkg.Scope.Lookup(d.Name.Value); o != nil {
		obj, _ = o.(*TCFunc)
	}
	var sig *Signature
	if obj != nil {
		sig, _ = obj.Typ.(*Signature)
	}
	if sig == nil && d.Type != nil {
		sig = pkgResolveSigAST(pb.pkg, d.Type)
	}
	fn := &SSAFunction{
		name:      d.Name.Value,
		object:    obj,
		Signature: sig,
		pos:       0,
		Pkg:       pb.pkg,
		Prog:      pb.prog,
	}
	if cctx.compileExportMap != nil {
		if ename, ok := cctx.compileExportMap[d.Name.Value]; ok {
			fn.externalSymbol = ename
			fn.isExternC = true
		}
	}
	if d.Body == nil && isNoContextExtern(pb.pkg.Pkg.Path, d.Name.Value) {
		fn.isExternC = true
	}
	pb.pkg.SetMember(fn.name, fn)
	if d.Name.Value == "init" {
		pb.initFn = fn
	}
}


func checkInitStmt(s syntax.Stmt) (sv string) {
	switch ss := s.(type) {
	case *syntax.SelectStmt:
		_ = ss
		return "select{} not allowed in init()"
	case *syntax.BlockStmt:
		for _, sub := range ss.List {
			if err := checkInitStmt(sub); err != "" {
				return err
			}
		}
	case *syntax.IfStmt:
		if ss.Then != nil {
			if err := checkInitStmt(ss.Then); err != "" {
				return err
			}
		}
		if ss.Else != nil {
			if err := checkInitStmt(ss.Else); err != "" {
				return err
			}
		}
	case *syntax.ForStmt:
		if ss.Body != nil {
			if err := checkInitStmt(ss.Body); err != "" {
				return err
			}
		}
	case *syntax.SwitchStmt:
		for _, cc := range ss.Body {
			for _, sub := range cc.Body {
				if err := checkInitStmt(sub); err != "" {
					return err
				}
			}
		}
	case *syntax.ExprStmt:
		if err := checkInitExpr(ss.X); err != "" {
			return err
		}
	}
	return ""
}

func checkInitExpr(x syntax.Expr) (s string) {
	if x == nil {
		return ""
	}
	if c, ok := x.(*syntax.CallExpr); ok {
		if n, ok2 := c.Fun.(*syntax.Name); ok2 && n.Value == "spawn" {
			return "spawn() not allowed in init()"
		}
	}
	return ""
}

func isNoContextExtern(pkg, name string) (ok bool) {
	if pkg == "internal/runtime/syscall" && name == "Syscall6" {
		return true
	}
	if pkg == "syscall" {
		switch name {
		case "runtime_entersyscall", "runtime_exitsyscall",
			"Exit", "Getpagesize", "gettimeofday",
			"runtime_BeforeExec", "runtime_AfterExec",
			"runtime_BeforeFork", "runtime_AfterFork", "runtime_AfterForkInChild":
			return true
		}
	}
	if pkg == "os" {
		switch name {
		case "putchar", "getchar", "buffered", "gosched", "runtime_args":
			return true
		}
	}
	return false
}

func (pb *ssaPkgBuilder) registerMethod(d *syntax.FuncDecl) {
	if !ssaRecvIsPtr(d.Recv) && isUserPackagePath(restrictPath(pb.pkg.Pkg.Path)) {
		cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
		push(cctx.compileErrors, "value receiver is not allowed: use pointer receiver (*" | ssaRecvTypeName(d.Recv) | ")")
		return
	}
	recvTypeName := ssaRecvTypeName(d.Recv)
	if recvTypeName == "" {
		return
	}
	// All methods use (*Type).Method naming regardless of receiver type.
	mangledName := "(*" | recvTypeName | ")." | d.Name.Value
	var obj *TCFunc
	obj = pb.findMethod(recvTypeName, d.Name.Value)
	var sig *Signature
	if obj != nil {
		sig, _ = obj.Typ.(*Signature)
	}
	if sig == nil && d.Type != nil {
		sig = pkgResolveSigAST(pb.pkg, d.Type)
	}
	if sig == nil {
		mxutil.WriteStr(2, "WARN: nil sig for method " | mangledName | "\n")
	}
	fn := &SSAFunction{
		name:      mangledName,
		object:    obj,
		Signature: sig,
		pos:       0,
		Pkg:       pb.pkg,
		Prog:      pb.prog,
	}
	pb.pkg.SetMember(mangledName, fn)
}

func ssaRecvTypeName(recv *syntax.Field) (s string) {
	if recv == nil {
		return ""
	}
	switch t := recv.Type.(type) {
	case *syntax.Name:
		return t.Value
	case *syntax.IndexExpr:
		// Generic receiver type: nistCurve[Point] -> nistCurve.
		return ssaRecvTypeName(&syntax.Field{Type: t.X})
	case *syntax.Operation:
		if t.Y == nil && t.Op == token.Mul {
			switch x := t.X.(type) {
			case *syntax.Name:
				return x.Value
			case *syntax.IndexExpr:
				return ssaRecvTypeName(&syntax.Field{Type: x.X})
			}
		}
	}
	return ""
}

// ssaRecvIsGeneric reports whether the receiver type is a generic
// instantiation (nistCurve[Point]); such methods are instantiated on
// demand and their base bodies must not be built directly.
func ssaRecvIsGeneric(recv *syntax.Field) (ok bool) {
	if recv == nil {
		return false
	}
	t := recv.Type
	if op, ok2 := t.(*syntax.Operation); ok2 && op.Y == nil && op.Op == token.Mul {
		t = op.X
	}
	_, isIdx := t.(*syntax.IndexExpr)
	return isIdx
}

func ssaRecvIsPtr(recv *syntax.Field) (ok bool) {
	if recv == nil {
		return false
	}
	if op, ok2 := recv.Type.(*syntax.Operation); ok2 {
		return op.Y == nil && op.Op == token.Mul
	}
	return false
}

func (pb *ssaPkgBuilder) findMethod(typeName string, methodName string) (t *TCFunc) {
	obj := pb.pkg.Pkg.Scope.Lookup(typeName)
	if obj == nil && Universe != nil {
		obj = Universe.Lookup(typeName)
	}
	if obj == nil {
		return nil
	}
	tn, ok := obj.(*TypeName)
	if !ok {
		return nil
	}
	switch tt := tn.Typ.(type) {
	case *Named:
		for i := int32(0); i < tt.NumMethods(); i++ {
			m := tt.Method(i)
			if m.Name == methodName {
				return m
			}
		}
	case *Basic:
		for i := int32(0); i < tt.NumMethods(); i++ {
			m := tt.Method(i)
			if m.Name == methodName {
				return m
			}
		}
	}
	return nil
}

func (pb *ssaPkgBuilder) registerVar(d *syntax.VarDecl) {
	for _, name := range d.NameList {
		var obj *TCVar
		if o := pb.pkg.Pkg.Scope.Lookup(name.Value); o != nil {
			obj, _ = o.(*TCVar)
		}
		var typ Type
		if obj != nil {
			typ = obj.Typ
		}
		if typ == nil && d.Type != nil {
			typ = pkgResolveTypeAST(pb.pkg, d.Type)
		}
		if typ == nil && d.Values != nil {
			typ = pkgResolveTypeAST(pb.pkg, d.Values)
		}
		g := &SSAGlobal{
			name:   name.Value,
			object: obj,
			typ:    NewPointer(typ),
			pos:    0,
			pkg:    pb.pkg,
		}
		pb.pkg.SetMember(name.Value, g)
	}
	if d.Values != nil {
		pb.varInits = mxutil.Ensure(pb.varInits, 1)
		push(pb.varInits, d)
		pb.varInitScopes[d] = pb.curFileScope
	}
}

func (pb *ssaPkgBuilder) registerType(d *syntax.TypeDecl) {
	var obj *TypeName
	if o := pb.pkg.Pkg.Scope.Lookup(d.Name.Value); o != nil {
		obj, _ = o.(*TypeName)
	}
	if obj == nil {
		underlying := pkgResolveTypeAST(pb.pkg, d.Type)
		if underlying == nil {
			underlying = &TCStruct{}
		}
		named := NewNamed(NewTypeName(pb.pkg.Pkg, d.Name.Value, nil), underlying)
		named.Obj.Typ = named
		pb.pkg.Pkg.Scope.Insert(named.Obj)
		obj = named.Obj
	}
	t := &SSAType_{object: obj, pkg: pb.pkg}
	pb.pkg.SetMember(d.Name.Value, t)
}

func (pb *ssaPkgBuilder) registerConst(d *syntax.ConstDecl) {
	for _, name := range d.NameList {
		var obj *TCConst
		if o := pb.pkg.Pkg.Scope.Lookup(name.Value); o != nil {
			obj, _ = o.(*TCConst)
		}
		if obj == nil {
			continue
		}
		c := &SSANamedConst{
			object: obj,
			Value:  &SSAConst{typ: obj.Typ, val: localizeConstVal(obj.Val, obj.Typ)},
			pkg:    pb.pkg,
		}
		pb.pkg.SetMember(name.Value, c)
	}
}

func (pb *ssaPkgBuilder) buildFile(f *syntax.File) {
	for _, d := range f.DeclList {
		if fd, ok := d.(*syntax.FuncDecl); ok {
			pb.curFileScope = pb.declScope(d)
			if fd.Recv != nil {
				ssaRecvTypeName(fd.Recv)
			}
			pb.buildFunc(fd)
		}
	}
}

func (pb *ssaPkgBuilder) buildVarInits() {
	sig := &Signature{
		Params:  NewTuple(),
		Results: NewTuple(),
	}
	fn, _ := pb.pkg.Members["main"].(*SSAFunction)
	if fn == nil {
		fn = &SSAFunction{
			name:      "main",
			Signature: sig,
			Pkg:       pb.pkg,
			Prog:      pb.prog,
		}
		pb.pkg.SetMember("main", fn)
	}
	if len(fn.Blocks) > 0 {
		initSig := &Signature{Params: NewTuple(), Results: NewTuple()}
		initFn := &SSAFunction{
			name:      "__varinit",
			Signature: initSig,
			Pkg:       pb.pkg,
			Prog:      pb.prog,
		}
		pb.pkg.SetMember("__varinit", initFn)
		fb2 := newSSAFuncBuilder(initFn, pb.info)
		entry2 := fb2.newBlock("entry")
		fb2.currentBlock = entry2
		for _, d := range pb.varInits {
			if d.Values == nil {
				continue
			}
			fb2.fileScope = pb.varInitScopes[d]
			var rhs SSAValue
			rhsBuilt := false
			// `var a, b T = x, y` gives each name its own value (see the
			// function-scope form in buildLocalDecl): building the list once
			// handed the last value to every name, so `var g1, g2 int32 = 3, 4`
			// printed 4 4.
			var multiVals2 []SSAValue
			if vl, isList := d.Values.(*syntax.ListExpr); isList && len(d.NameList) > 1 && len(vl.ElemList) == len(d.NameList) {
				multiVals2 = []SSAValue{:len(vl.ElemList)}
				for mi := int32(0); mi < len(vl.ElemList); mi++ {
					multiVals2[mi] = fb2.buildExpr(vl.ElemList[mi])
				}
			}
			for ni, name := range d.NameList {
				if name.Value == "_" {
					continue
				}
				if fb2.tryConstArrayMemcpy(name, d.Values) {
					continue
				}
				if multiVals2 != nil && ni < len(multiVals2) {
					if multiVals2[ni] == nil {
						break
					}
					fb2.buildStore(name, multiVals2[ni])
					continue
				}
				if !rhsBuilt {
					rhs = fb2.buildExpr(d.Values)
					rhsBuilt = true
				}
				if rhs == nil {
					break
				}
				fb2.buildStore(name, rhs)
			}
		}
		fb2.emit(&SSAReturn{})
		// Inject __varinit and, when the package has one, init() at the start
		// of main, in that order. The synthesised-main branch below already
		// does both; this branch is the target package, whose main already has
		// a body. A program's main package cannot declare init(), so a normal
		// build never needed the second call - but the synthetic main that
		// `moxie test` builds around a library can, and it was skipped: a
		// library's init() never ran in its own test (scalar global = 0,
		// want 42).
		pre := []SSAInstruction{}
		callInstr := &SSACall{Call: SSACallCommon{Value: initFn}}
		callInstr.name = "vinit"
		pre = mxutil.Ensure(pre, 1)
		pre = push(pre, callInstr)
		if pb.initFn != nil {
			callInit := &SSACall{Call: SSACallCommon{Value: pb.initFn}}
			callInit.name = "pinit"
			pre = mxutil.Ensure(pre, 1)
			pre = push(pre, callInit)
		}
		oldEntry := fn.Blocks[0]
		n := int32(len(oldEntry.Instrs))
		pn := int32(len(pre))
		combined := []SSAInstruction{:n + pn}
		for i := int32(0); i < pn; i++ {
			combined[i] = pre[i]
		}
		for i := int32(0); i < n; i++ {
			combined[i+pn] = oldEntry.Instrs[i]
		}
		oldEntry.Instrs = combined
		return
	}
	fb := newSSAFuncBuilder(fn, pb.info)
	entry := fb.newBlock("entry")
	fb.currentBlock = entry
	for _, d := range pb.varInits {
		if d.Values == nil {
			continue
		}
		fb.fileScope = pb.varInitScopes[d]
		var rhs SSAValue
		rhsBuilt := false
		// `var a, b T = x, y` gives each name its own value, the same way
		// buildLocalDecl does for the function-scope form. Building the list
		// once and storing the result to every name gave both names the last
		// value (`var g1, g2 int32 = 3, 4` printed 4 4).
		var multiVals []SSAValue
		if vl, isList := d.Values.(*syntax.ListExpr); isList && len(d.NameList) > 1 && len(vl.ElemList) == len(d.NameList) {
			multiVals = []SSAValue{:len(vl.ElemList)}
			for mi := int32(0); mi < len(vl.ElemList); mi++ {
				multiVals[mi] = fb.buildExpr(vl.ElemList[mi])
			}
		}
		for ni, name := range d.NameList {
			if name.Value == "_" {
				continue
			}
			if fb.tryConstArrayMemcpy(name, d.Values) {
				continue
			}
			if multiVals != nil && ni < len(multiVals) {
				if multiVals[ni] == nil {
					break
				}
				fb.buildStore(name, multiVals[ni])
				continue
			}
			if !rhsBuilt {
				rhs = fb.buildExpr(d.Values)
				rhsBuilt = true
			}
			if rhs == nil {
				break
			}
			fb.buildStore(name, rhs)
		}
	}
	// Package-level variable initializers run first, then init(), as in Go.
	if pb.initFn != nil {
		callInit := &SSACall{Call: SSACallCommon{Value: pb.initFn}}
		callInit.name = "pinit"
		fb.emit(callInit)
	}
	fb.emit(&SSAReturn{})
}

func (pb *ssaPkgBuilder) buildFunc(d *syntax.FuncDecl) {
	if len(d.TParamList) > 0 {
		return
	}
	if d.Recv != nil && ssaRecvIsGeneric(d.Recv) {
		// Methods on generic receiver types are instantiated per concrete
		// type on demand; the base body has unresolved type parameters.
		return
	}
	if d.Body == nil {
		return
	}
	name := d.Name.Value
	if d.Recv != nil {
		rtn := ssaRecvTypeName(d.Recv)
		if rtn != "" {
			name = "(*" | rtn | ")." | d.Name.Value
		}
	}
	member := pb.pkg.Members[name]
	if member == nil {
		mxutil.WriteStr(2, "WARN: buildFunc no member for " | name | "\n")
		return
	}
	fn, ok := member.(*SSAFunction)
	if !ok || fn == nil {
		mxutil.WriteStr(2, "WARN: buildFunc member not SSAFunction for " | name | "\n")
		return
	}
	fb := newSSAFuncBuilder(fn, pb.info)
	fb.fileScope = pb.curFileScope
	fb.buildBody(d)
}

// ssaFuncBuilder builds one SSAFunction body.
type ssaFuncBuilder struct {
	fn           *SSAFunction
	info         *Info
	parent       *ssaFuncBuilder
	currentBlock *SSABasicBlock
	vars         map[Object]*SSAAlloc
	varScope     map[Object]int32
	localTypes   map[string]Type
	localConsts  map[string]*SSAConst
	lastConstGroup *syntax.Group // iota tracking: the group of the last const decl
	iotaVal      int64           // iota position within the current const group
	quietTypeErr bool            // suppress "undefined" type errors (buildCall conversion probe)
	freeVarPtrs  map[string]*SSAFreeVar
	namedResults []*SSAAlloc
	paramAllocas []*SSAAlloc
	tailBlock    *SSABasicBlock
	counter      int32

	loops        []ssaLoopState
	pendingLabel string
	labels       map[string]*SSABasicBlock
	deferred     int32
	typeSubst    map[string]Type
	srcScope     *Scope
	fileScope    *Scope // imports of the file declaring this function
	decl         *syntax.FuncDecl
	// curLine is the 1-based concatenated-source line of the statement being
	// built. Blocks record it so -cover can label each one with file:line.
	curLine int32
	scopeID      int32
	nextScopeID  int32
	// scopeParent records the enclosing scope of each entered scope, so a
	// declaration can tell an enclosing binding (shadowing) from one in a
	// sibling scope (an earlier case of the same switch), which is not.
	scopeParent  map[int32]int32
}

type ssaLoopState struct {
	label string
	body  *SSABasicBlock
	post  *SSABasicBlock
	done  *SSABasicBlock
}

func newSSAFuncBuilder(fn *SSAFunction, info *Info) (p *ssaFuncBuilder) {
	return &ssaFuncBuilder{
		fn:         fn,
		info:       info,
		vars:       map[Object]*SSAAlloc{},
		varScope:    map[Object]int32{},
		localTypes:  map[string]Type{},
		scopeParent: map[int32]int32{},
	}
}

func (fb *ssaFuncBuilder) newBlock(comment string) (s *SSABasicBlock) {
	b := NewSSABasicBlock(fb.fn, comment)
	b.Line = fb.curLine
	return b
}

func (fb *ssaFuncBuilder) enterScope() (prev int32) {
	fb.nextScopeID++
	prev = fb.scopeID
	fb.scopeParent[fb.nextScopeID] = prev
	fb.scopeID = fb.nextScopeID
	return prev
}

// scopeIsAncestor reports whether scope a encloses scope b. Only a binding from
// an enclosing scope is shadowed by a declaration in b; one from a sibling
// scope is a separate binding, which legacy's checkScopeShadowing also allows.
func (fb *ssaFuncBuilder) scopeIsAncestor(a, b int32) (ok bool) {
	s := b
	for {
		if s == a {
			return true
		}
		if s == 0 {
			return false
		}
		s = fb.scopeParent[s]
	}
}

func (fb *ssaFuncBuilder) exitScope(old int32) {
	fb.scopeID = old
}

// bindingShadows reports whether obj is visible from an enclosing scope of the
// function being built, so that a declaration of the same name shadows it.
//
// A binding of an enclosing function lives in that function's builder and
// carries scope ids from that builder's numbering, which cannot be compared
// with this one's. The closure is built while its parent is still walking the
// statement that contains it, so the parent's current scope is exactly the
// scope the closure was created in: the ancestry test runs in the parent's id
// space. Names bound outside any function body - package scope, file imports,
// predeclared - enclose every function.
func (fb *ssaFuncBuilder) bindingShadows(obj Object) (ok bool) {
	if _, mine := fb.vars[obj]; mine {
		sc, hasScope := fb.varScope[obj]
		return !hasScope || fb.scopeIsAncestor(sc, fb.scopeID)
	}
	for p := fb.parent; p != nil; p = p.parent {
		if _, found := p.vars[obj]; found {
			sc, hasScope := p.varScope[obj]
			return !hasScope || p.scopeIsAncestor(sc, p.scopeID)
		}
	}
	return true
}

func (fb *ssaFuncBuilder) labelBlock(name string) (s *SSABasicBlock) {
	if fb.labels == nil {
		fb.labels = map[string]*SSABasicBlock{}
	}
	if lb := fb.labels[name]; lb != nil {
		return lb
	}
	nb := fb.newBlock("label." + name)
	fb.labels[name] = nb
	return nb
}

func (fb *ssaFuncBuilder) emit(instr SSAInstruction) {
	if fb.currentBlock == nil {
		return
	}
	instr.setBlock(fb.currentBlock)
	fb.currentBlock.Instrs = mxutil.Ensure(fb.currentBlock.Instrs, 1)
	push(fb.currentBlock.Instrs, instr)
}

// pushSucc records an edge b -> succ with explicit capacity growth
// (push never reallocates).
func (fb *ssaFuncBuilder) pushSucc(b, succ *SSABasicBlock) {
	b.Succs = mxutil.Ensure(b.Succs, 1)
	push(b.Succs, succ)
}

// pushPred records an edge pred -> b with explicit capacity growth.
func (fb *ssaFuncBuilder) pushPred(b, pred *SSABasicBlock) {
	b.Preds = mxutil.Ensure(b.Preds, 1)
	push(b.Preds, pred)
}

func (fb *ssaFuncBuilder) nextName() (s string) {
	fb.counter++
	return "t" | ssaItoa(fb.counter)
}

func (fb *ssaFuncBuilder) buildBody(d *syntax.FuncDecl) {
	fb.decl = d
	// The entry block is created before any statement, so seed the line with the
	// declaration's own line.
	dp := d.Pos()
	fb.curLine = int32(dp.Line())
	entry := fb.newBlock("entry")
	fb.currentBlock = entry

	sig := fb.fn.Signature
	if sig == nil {
		return
	}
	params := sig.Params
	if d.Recv != nil {
		recv := sig.Recv
		if recv != nil {
			recvName := recv.Name
			if recvName == "" && d.Recv.Name != nil {
				recvName = d.Recv.Name.Value
			}
			// All receivers are ptr in Moxie. If the type checker says
			// value receiver, wrap in pointer so the SSA type is *T.
			recvType := recv.Typ
			isValRecv := false
			if _, isP := SafeUnderlying(recvType).(*Pointer); !isP {
				recvType = NewPointer(recvType)
				isValRecv = true
			}
			p := &SSAParameter{
				name:   recvName,
				typ:    recvType,
				pos:    0,
				parent: fb.fn,
			}
			fb.fn.Params = mxutil.Ensure(fb.fn.Params, 1)
			push(fb.fn.Params, p)
			if recvName != "" && recvName != "_" {
				recvObj := NewTCVar(fb.fn.Pkg.Pkg, recvName, recv.Typ)
				p.object = recvObj
				alloc := fb.emitAlloc(recv.Typ, 0)
				fb.vars[recvObj] = alloc
				fb.paramAllocas = mxutil.Ensure(fb.paramAllocas, 1)
				push(fb.paramAllocas, alloc)
				if isValRecv {
					// p is *T; load the value T from the pointer, then store.
					deref := &SSAUnOp{Op: OpMul, X: p}
					deref.typ = recv.Typ
					fb.fn.Blocks = mxutil.Ensure(fb.fn.Blocks, 1)
					fb.fn.Blocks[0].Instrs = mxutil.Ensure(fb.fn.Blocks[0].Instrs, 1)
					push(fb.fn.Blocks[0].Instrs, deref)
					fb.emitStore(alloc, deref)
				} else {
					fb.emitStore(alloc, p)
				}
			}
		}
	}
	if params != nil {
		for i := 0; i < params.Len(); i++ {
			pvar := params.At(i)
			p := &SSAParameter{
				name:   pvar.Name,
				typ:    pvar.Typ,
				pos:    fb.fn.pos,
				parent: fb.fn,
			}
			fb.fn.Params = mxutil.Ensure(fb.fn.Params, 1)
			push(fb.fn.Params, p)
			if pvar.Name != "" && pvar.Name != "_" {
				obj := NewTCVar(fb.fn.Pkg.Pkg, pvar.Name, pvar.Typ)
				alloc := fb.emitAlloc(pvar.Typ, p.pos)
				fb.vars[obj] = alloc
				fb.varScope[obj] = fb.scopeID
				fb.paramAllocas = mxutil.Ensure(fb.paramAllocas, 1)
				push(fb.paramAllocas, alloc)
				fb.emitStore(alloc, p)
			}
		}
	}

	if sig.Results != nil {
		for i := 0; i < sig.Results.Len(); i++ {
			r := sig.Results.At(i)
			if r.Name != "" && r.Name != "_" {
				alloc := fb.emitAlloc(r.Typ, fb.fn.pos)
				fb.namedResults = mxutil.Ensure(fb.namedResults, 1)
				push(fb.namedResults, alloc)
				fb.fn.Locals = mxutil.Ensure(fb.fn.Locals, 1)
				push(fb.fn.Locals, alloc)
				fb.vars[r] = alloc
				fb.varScope[r] = fb.scopeID
			}
		}
	}

	if len(fb.paramAllocas) > 0 {
		fb.tailBlock = fb.newBlock("tailcall")
		fb.emit(&SSAJump{Comment: "enter.body"})
		fb.pushSucc(fb.currentBlock, fb.tailBlock)
		fb.pushPred(fb.tailBlock, fb.currentBlock)
		fb.currentBlock = fb.tailBlock
	}

	if d.Body != nil {
		fb.buildBlock(d.Body)
	}

	if fb.currentBlock != nil && !fb.blockTerminated(fb.currentBlock) {
		if len(fb.namedResults) > 0 {
			// This is the implicit return at the end of a body that falls off
			// the end, so it carries no source position (pos 0). It must align
			// the named results with their POSITIONS in the result list and
			// give a BLANK result its zero value, exactly like a bare `return`:
			//   func (t *Transport) getConn(...) (_ *persistConn, err error)
			// has ONE named result and TWO results, so pushing only the named
			// ones produced a one-element SSAReturn for a two-result function.
			// The exit serialiser then took its single-value shortcut and
			// decomposed that one interface value across both results, feeding
			// the error's TYPE word to the codec as the *persistConn:
			//   '%cext100' defined with type 'i64' but expected 'ptr'
			//   %cext100 = extractvalue {i64, ptr} %t168, 0
			// which is what blocked src/net/http.
			// Build the value list POSITIONALLY: vals[i] belongs to
			// Signature.Results.At(i). A blank (`_`) result occupies its
			// position as the zero of its type, and the named results fill the
			// other positions in order. Appending the zeros afterwards instead
			// put the error at the blank's position and a zero at the named
			// result's - the aggregate came out inverted
			// (%rv98 = the error inserted at field 0, the zero at field 1).
			var vals []SSAValue
			nj := 0
			if fb.fn.Signature != nil && fb.fn.Signature.Results != nil {
				for i := int32(0); i < fb.fn.Signature.Results.Len(); i++ {
					res := fb.fn.Signature.Results.At(i)
					if res == nil {
						continue
					}
					if res.Name == "" || res.Name == "_" {
						vals = mxutil.Ensure(vals, 1)
						push(vals, &SSAConst{typ: res.Typ, val: nil})
						continue
					}
					if nj >= len(fb.namedResults) {
						break
					}
					nr := fb.namedResults[nj]
					nj++
					elemType := nr.SSAType()
					if p, ok := elemType.(*Pointer); ok {
						elemType = p.Base
					}
					vals = mxutil.Ensure(vals, 1)
					push(vals, fb.emitLoad(nr, elemType))
				}
			} else {
				for _, nr := range fb.namedResults {
					elemType := nr.SSAType()
					if p, ok := elemType.(*Pointer); ok {
						elemType = p.Base
					}
					vals = mxutil.Ensure(vals, 1)
					push(vals, fb.emitLoad(nr, elemType))
				}
			}
			fb.emitReturn(vals, 0)
		} else {
			fb.emitReturn(nil, 0)
		}
	}
	// Functions with defers need a recover block: the emitter's landing pad
	// (defer_landingN) runs the defers after a panic and branches here to
	// return; destroyDeferFrame re-raises if still panicking. Mirrors
	// legacy, where x/tools/go/ssa creates fn.Recover for every function
	// with deferred calls. Without it the landing pad label is never
	// defined and clang rejects the module.
	if fb.deferred > 0 && fb.fn.Recover == nil {
		recBlock := fb.newBlock("recover")
		fb.currentBlock = recBlock
		fb.emitReturn(nil, 0)
		fb.fn.Recover = recBlock
	}
	fb.fn.NamedResults = fb.namedResults
}

func (fb *ssaFuncBuilder) emitAlloc(typ Type, pos int32) (s *SSAAlloc) {
	a := &SSAAlloc{Heap: false}
	a.typ = NewPointer(typ)
	a.pos = pos
	a.name = fb.nextName()
	fb.emit(a)
	fb.fn.Locals = mxutil.Ensure(fb.fn.Locals, 1)
	push(fb.fn.Locals, a)
	return a
}

func (fb *ssaFuncBuilder) emitStore(addr SSAValue, val SSAValue) {
	val = fb.coerceStored(addr, val)
	fb.emit(&SSAStore{Addr: addr, Val: val})
}

// coerceStored converts an untyped numeric constant to the type of the memory
// it is stored into, and boxes a concrete value for an interface target. The
// emitter prints a value at the LLVM type it was built as, so `var a float64 =
// 4` stored the integer bit pattern 4 into a double slot: a printed as
// 2e-323, math.Float64bits(a) returned 4, and every math function that starts
// from Float64bits (Sqrt, Pow, Hypot, the portable Ceil/Floor/Trunc) answered
// 0 because the constant was never converted.
func (fb *ssaFuncBuilder) coerceStored(addr SSAValue, val SSAValue) (s SSAValue) {
	if addr == nil || val == nil || val.SSAType() == nil || addr.SSAType() == nil {
		return val
	}
	p, isPtr := SafeUnderlying(addr.SSAType()).(*Pointer)
	if !isPtr || p.Base == nil {
		return val
	}
	val = fb.coerceToInterface(val, p.Base)
	if val.SSAType() == nil {
		return val
	}
	sb, sIsBasic := SafeUnderlying(val.SSAType()).(*Basic)
	db, dIsBasic := SafeUnderlying(p.Base).(*Basic)
	if !sIsBasic || !dIsBasic || sb == db {
		return val
	}
	// Only an untyped constant is converted here; a typed value of a different
	// numeric type is rejected by checkAssignable, never silently converted.
	if sb.Info&IsUntyped == 0 || sb.Info&IsNumeric == 0 || db.Info&IsNumeric == 0 {
		return val
	}
	c := &SSAConvert{X: val}
	c.typ = p.Base
	c.name = fb.nextName()
	fb.emit(c)
	return c
}

func (fb *ssaFuncBuilder) emitLoad(addr SSAValue, typ Type) (s SSAValue) {
	u := &SSAUnOp{Op: OpMul, X: addr}
	u.typ = typ
	u.name = fb.nextName()
	fb.emit(u)
	return u
}

func (fb *ssaFuncBuilder) emitReturn(vals []SSAValue, pos int32) {
	fb.emit(&SSAReturn{Results: vals, pos: pos})
	fb.currentBlock = nil
}

func (fb *ssaFuncBuilder) blockTerminated(b *SSABasicBlock) (ok bool) {
	if len(b.Instrs) == 0 {
		return false
	}
	switch b.Instrs[len(b.Instrs)-1].(type) {
	case *SSAReturn, *SSAJump, *SSAIf, *SSAPanic:
		return true
	}
	return false
}

// Statement builders.

func (fb *ssaFuncBuilder) buildBlock(b *syntax.BlockStmt) {
	if b == nil {
		return
	}
	for _, s := range b.List {
		fb.buildStmt(s)
	}
}

func (fb *ssaFuncBuilder) buildStmt(s syntax.Stmt) {
	if s == nil {
		return
	}
	// Positions are 1-based concatenated-source lines, the same lines the
	// coverage and error maps use. Blocks created while this statement compiles
	// carry its line.
	sp := s.Pos()
	fb.curLine = int32(sp.Line())
	if ls, ok := s.(*syntax.LabeledStmt); ok {
		if ls.Label != nil {
			fb.pendingLabel = ls.Label.Value
			lblBlock := fb.labelBlock(ls.Label.Value)
			if fb.currentBlock != nil {
				fb.emit(&SSAJump{Comment: "goto.label." + ls.Label.Value})
				fb.pushSucc(fb.currentBlock, lblBlock)
				fb.pushPred(lblBlock, fb.currentBlock)
			}
			fb.currentBlock = lblBlock
		}
		fb.buildStmt(ls.Stmt)
		fb.pendingLabel = ""
		return
	}
	if fb.currentBlock == nil {
		return
	}
	// -cover: one hit per statement, labelled with its line. Emitted before the
	// statement's own code so it lands in the block the statement executes in,
	// after the LabeledStmt block above has been created.
	if bst != nil && bst.cover {
		ch := &SSACoverHit{}
		ch.Line = fb.curLine
		fb.emit(ch)
	}
	switch ss := s.(type) {
	case *syntax.EmptyStmt:
		_ = ss
		// nothing
	case *syntax.ExprStmt:
		if name, ok := ss.X.(*syntax.Name); ok && name.Value != "_" {
			cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
			if fb.nameResolves(name) {
				push(cctx.compileErrors, "evaluated but not used: " | name.Value)
			} else {
				push(cctx.compileErrors, "undefined: " | name.Value)
			}
			break
		}
		fb.buildExpr(ss.X)
	case *syntax.AssignStmt:
		fb.buildAssign(ss)
	case *syntax.BlockStmt:
		// A bare block is its own scope: bindings inside it do not outlive it,
		// and a later sibling block may reuse their names.
		blockScope := fb.enterBlock()
		fb.buildBlock(ss)
		fb.exitBlock(blockScope)
	case *syntax.DeclStmt:
		for _, d := range ss.DeclList {
			fb.buildLocalDecl(d)
		}
	case *syntax.IfStmt:
		fb.buildIf(ss)
	case *syntax.ForStmt:
		fb.buildFor(ss)
	case *syntax.SwitchStmt:
		fb.buildSwitch(ss)
	case *syntax.SelectStmt:
		fb.buildSelect(ss)
	case *syntax.ReturnStmt:
		fb.buildReturn(ss)
	case *syntax.BranchStmt:
		fb.buildBranch(ss)
	case *syntax.SendStmt:
		ch := fb.buildExpr(ss.Chan)
		val := fb.buildExpr(ss.Value)
		if ch != nil && val != nil {
			// The channel's ELEMENT type is the send's context, the same way a
			// parameter type is for an argument: a send of *T into an
			// interface-element channel must BOX the value. Without this the raw
			// pointer was stored into the interface's 2-word slot:
			//   '%t193' defined with type 'ptr' but expected '{ i64, ptr }'
			//     %t193 = load ptr, ptr %t183
			//     store {i64, ptr} %t193, ptr %selsv289
			// which is what blocked (*http2responseWriter).Push, whose
			//   case sc.serveMsgCh <- msg:
			// sends a *http2startPushRequest into a chan http2serveMsg.
			if ce, isChan := SafeUnderlying(ch.SSAType()).(*TCChan); isChan && ce != nil && ce.Elem != nil {
				val = fb.coerceSendValue(val, ce.Elem)
			}
			fb.emit(&SSASend{Chan: ch, X: val})
		}
	case *syntax.CallStmt:
		call, _ := ss.Call.(*syntax.CallExpr)
		switch ss.Tok {
		case token.Defer:
			if call != nil {
				fb.buildDeferStmt(call)
			}
		default:
			fb.buildExpr(ss.Call)
		}
	}
}

func (fb *ssaFuncBuilder) buildAssign(s *syntax.AssignStmt) {
	if s.Rhs == nil {
		lv := fb.buildExpr(s.Lhs)
		if lv == nil {
			return
		}
		// The 1 must be a constant OF the operand's kind, not an integer merely
		// LABELLED with the operand's type. Building it as ConstInt while
		// setting typ to the lvalue's type made `x++` a silent no-op on floats:
		//
		//	y := 2.0; y++   -> y is still 2.0
		//	i := int64(2); i++ -> 3   (integers were never affected)
		//
		// That is what broke math.Sin and math.Cos: their range reduction does
		// `j++; y++` after a float conversion, so y stayed the un-incremented
		// value and Sin(1.0) returned 0.977061263899476 instead of
		// 0.8414709848078965. Everything downstream of trig went with it -
		// math.J0(2.5) was -0.404278302239057 instead of -0.04838377646819797.
		var one SSAValue
		if b, isBasic := SafeUnderlying(lv.SSAType()).(*Basic); isBasic && b.Info&IsFloat != 0 {
			one = &SSAConst{typ: lv.SSAType(), val: &ConstFloat{V:1.0}}
		} else {
			one = &SSAConst{typ: lv.SSAType(), val: &ConstInt{V:1}}
		}
		op := OpAdd
		if s.Op == token.Sub {
			op = OpSub
		}
		bin := &SSABinOp{Op: op, X: lv, Y: one}
		bin.typ = lv.SSAType()
		bin.name = fb.nextName()
		fb.emit(bin)
		fb.buildStore(s.Lhs, bin)
		return
	}
	if s.Op == token.Def {
		fb.buildShortVarDecl(s)
		return
	}
	if s.Op != 0 {
		lv := fb.buildExpr(s.Lhs)
		rv := fb.buildExpr(s.Rhs)
		if lv == nil || rv == nil {
			return
		}
		// The left operand of a shift inside a compound assignment assumes the
		// assignment target's type, the same context a plain assignment gives
		// it. Without it `x &^= 1<<(64-12-e) - 1` folded at the untyped i32
		// default, so the mask was 0xFFFFFFFF and math.Modf cleared 32 bits
		// of the mantissa instead of 51 (Modf(2.1) returned 2.0999984).
		retypeUntypedShift(rv, lv.SSAType())
		op := compoundOp(s.Op)
		bin := &SSABinOp{Op: op, X: lv, Y: rv}
		bin.typ = lv.SSAType()
		bin.name = fb.nextName()
		fb.emit(bin)
		fb.buildStore(s.Lhs, bin)
		return
	}
	lhsList, lhsIsList := s.Lhs.(*syntax.ListExpr)
	rhsList, rhsIsList := s.Rhs.(*syntax.ListExpr)
	if lhsIsList && rhsIsList && len(lhsList.ElemList) == len(rhsList.ElemList) {
		vals := []SSAValue{:len(rhsList.ElemList)}
		for i, re := range rhsList.ElemList {
			vals[i] = fb.buildExpr(re)
		}
		for i, le := range lhsList.ElemList {
			if vals[i] != nil {
				fb.buildStore(le, vals[i])
			}
		}
		return
	}
	if lhsIsList && len(lhsList.ElemList) == 2 {
		if ae, ok := s.Rhs.(*syntax.AssertExpr); ok {
			x := fb.buildExpr(ae.X)
			assertedType := fb.resolveType(ae.Type)
			if x != nil && assertedType != nil {
				ta := &SSATypeAssert{X: x, AssertedType: assertedType, CommaOk: true}
				ta.typ = NewTuple(
					NewTCVar(nil, "val", assertedType),
					NewTCVar(nil, "ok", Typ[Bool]),
				)
				ta.name = fb.nextName()
				fb.emit(ta)
				for i, le := range lhsList.ElemList {
					if n, isName := le.(*syntax.Name); isName && n.Value == "_" {
						continue
					}
					ext := &SSAExtract{Tuple: ta, Index: i}
					ext.typ = ssaTupleElemType(ta.typ, i)
					ext.name = fb.nextName()
					fb.emit(ext)
					fb.buildStore(le, ext)
				}
				return
			}
		}
		if ie, ok := s.Rhs.(*syntax.IndexExpr); ok {
			x := fb.buildExpr(ie.X)
			idx := fb.buildExpr(ie.Index)
			if x != nil && idx != nil {
				if mt, ok2 := SafeUnderlying(x.SSAType()).(*TCMap); ok2 {
					idx = fb.coerceToInterface(idx, mt.Key)
					l := &SSALookup{X: x, Index: idx, CommaOk: true}
					l.typ = NewTuple(
						NewTCVar(nil, "v", mt.Elem),
						NewTCVar(nil, "ok", Typ[Bool]),
					)
					l.name = fb.nextName()
					fb.emit(l)
					for i, le := range lhsList.ElemList {
						if n, isName := le.(*syntax.Name); isName && n.Value == "_" {
							continue
						}
						ext := &SSAExtract{Tuple: l, Index: i}
						ext.typ = ssaTupleElemType(l.typ, i)
						ext.name = fb.nextName()
						fb.emit(ext)
						fb.buildStore(le, ext)
					}
					return
				}
			}
		}
		if oe, ok := s.Rhs.(*syntax.Operation); ok && oe.Y == nil && oe.Op == token.Recv {
			x := fb.buildExpr(oe.X)
			if x != nil {
				elemType := ssaChanElemType(x.SSAType())
				u := &SSAUnOp{Op: OpArrow, X: x, CommaOk: true}
				u.typ = NewTuple(
					NewTCVar(nil, "v", elemType),
					NewTCVar(nil, "ok", Typ[Bool]),
				)
				u.name = fb.nextName()
				fb.emit(u)
				for i, le := range lhsList.ElemList {
					if n, isName := le.(*syntax.Name); isName && n.Value == "_" {
						continue
					}
					ext := &SSAExtract{Tuple: u, Index: i}
					ext.typ = ssaTupleElemType(u.typ, i)
					ext.name = fb.nextName()
					fb.emit(ext)
					fb.buildStore(le, ext)
				}
				return
			}
		}
	}
	if fb.tryConstArrayMemcpy(s.Lhs, s.Rhs) {
		return
	}
	rhs := fb.buildExpr(s.Rhs)
	if rhs == nil {
		return
	}
	fb.buildStore(s.Lhs, rhs)
}

// coerceSendValue gives a send's value the channel ELEMENT type. An untyped nil
// has no SSA type at all (llvmType(nil) is "void", which produced
// `store void null` for `errc <- nil` into a chan error), so it becomes the nil
// of the element type; a concrete value is boxed when the element is an
// interface, exactly as an argument is.
func (fb *ssaFuncBuilder) coerceSendValue(val SSAValue, elem Type) (out SSAValue) {
	if val == nil || elem == nil {
		return val
	}
	if val.SSAType() == nil {
		return &SSAConst{typ: elem, val: &ConstNil{}}
	}
	return fb.coerceToInterface(val, elem)
}

// foldConstConvert folds `T(constant)` at build time. It matters because the
// exact value of a wide integer constant must be used, not its low 64 bits:
// leaving the conversion as an SSAConvert emitted `uitofp i64 0` for
// `float64(1<<70)` and reported 0, and `2.5 > 1<<129` as true for every positive
// x. ConvertConstLocal consults ConstInt.Exact, so folding here uses the real
// value. Mirrors go/types, which folds conversions of constants.
func (fb *ssaFuncBuilder) foldConstConvert(val SSAValue, target Type) (s SSAValue, ok bool) {
	sc, isConst := val.(*SSAConst)
	if !isConst || sc == nil || sc.val == nil || target == nil {
		return nil, false
	}
	// ConvertConstLocal returns the value UNCHANGED for a non-basic target
	// (`[]byte(x)`, `*T(x)`, a named struct). Folding there labelled the original
	// value with the new type - asn1_oid_der, crc32_hw_kernels,
	// generic_pkg_type, multi_value_var and asn1_tag_crosspkg compiled and then
	// aborted at run time. Only a basic target is a real constant conversion.
	if _, isBasic := SafeUnderlying(target).(*Basic); !isBasic {
		return nil, false
	}
	folded := ConvertConstLocal(sc.val, target)
	if folded == nil {
		return nil, false
	}
	// SSAConst is just {typ, val}: the emitter turns a constant into a literal on
	// demand (see the emitter's operand path), so there is no name to set and it
	// must NOT be emitted as an instruction.
	return &SSAConst{typ: target, val: folded}, true
}

func (fb *ssaFuncBuilder) coerceToInterface(val SSAValue, targetType Type) (s SSAValue) {
	if targetType == nil || val == nil || val.SSAType() == nil {
		return val
	}
	if _, isIface := SafeUnderlying(targetType).(*TCInterface); isIface {
		if _, alreadyIface := SafeUnderlying(val.SSAType()).(*TCInterface); !alreadyIface {
			mi := &SSAMakeInterface{X: val, IType: targetType}
			mi.typ = targetType
			mi.name = fb.nextName()
			fb.emit(mi)
			return mi
		}
	}
	return val
}

// checkCallArgs reports argument-count and argument-type mismatches, mirroring
// go/types, and returns the arguments converted to their parameter's type.
// Conservative: only signatures that carry a parameter tuple are checked, a
// variadic tail is compared against the element type (or the slice itself when
// the call uses ...), and checkAssignable skips interfaces and type parameters.
// Call it before wrapVariadicArgs, while args are still one per source argument.
//
// The conversion is what makes the call well typed. The emitter prints each
// argument at the LLVM type of the value it was built as, and the ABI does not
// convert: `id(-42)` folds the negation as an i32 sub, and passing an i32 where
// the signature declares i64 zero-extended it, so -42 arrived as 4294967254.
func (fb *ssaFuncBuilder) checkCallArgs(args []SSAValue, sig *Signature, hasDots bool) {
	if sig == nil || sig.Params == nil {
		return
	}
	np := sig.Params.Len()
	n := int32(len(args))
	// Name the counts. "not enough arguments in call" alone cannot distinguish
	// a caller that is short an argument from a signature that was resolved with
	// the wrong arity - and the second is how a missing js/wasm variant of a
	// function shows up, because the wrong declaration is silently preferred.
	want := "want " | irItoa(np) | ", have " | irItoa(n)
	if sig.Variadic && np > 0 {
		if n < np-1 {
			fb.errArgs("not enough arguments in call (" | want | ")")
			return
		}
	} else if n > np {
		fb.errArgs("too many arguments in call (" | want | ")")
		return
	} else if n < np {
		fb.errArgs("not enough arguments in call (" | want | ")")
		return
	}
	for i := int32(0); i < n; i++ {
		var pt Type
		if sig.Variadic && np > 0 && i >= np-1 {
			if hasDots {
				pt = sig.Params.At(np - 1).Typ
			} else if sl, isSl := SafeUnderlying(sig.Params.At(np-1).Typ).(*Slice); isSl {
				pt = sl.Elem
			}
		} else if i < np {
			pt = sig.Params.At(i).Typ
		}
		if pt == nil {
			continue
		}
		// The parameter's type is the shift's context: `g(1 << n)` with a
		// uint64 parameter is a 64-bit shift, the same context a return or an
		// assignment gives it.
		if bin, okB := args[i].(*SSABinOp); okB && bin.untypedShift {
			retypeUntypedShift(bin, pt)
		}
		fb.checkAssignable(args[i], pt, "argument to function")
		args[i] = fb.coerceArg(args[i], pt)
	}
}

// coerceArg converts an untyped numeric constant argument to the parameter's
// type. The emitter passes an argument at the LLVM type it was built as and the
// ABI does not convert, so `math.Sqrt(4)` handed the *integer* 4 to a double
// parameter: the callee read 0 from its vector register and every function that
// starts from its argument answered f(0) - Sqrt and Pow gave 0, Exp gave 1,
// while `math.Sqrt(4.0)` (a float literal) was correct.
func (fb *ssaFuncBuilder) coerceArg(val SSAValue, pt Type) (s SSAValue) {
	if val == nil || val.SSAType() == nil || pt == nil {
		return val
	}
	// An interface parameter boxes the concrete operand at the type it takes
	// when no type is given, so an untyped constant that does not fit its
	// default type must be rejected rather than truncated to its low bits.
	if _, isIface := SafeUnderlying(pt).(*TCInterface); isIface {
		fb.checkDefaultRepr(val, "argument to function")
	}
	sb, sIsBasic := SafeUnderlying(val.SSAType()).(*Basic)
	db, dIsBasic := SafeUnderlying(pt).(*Basic)
	if !sIsBasic || !dIsBasic || sb == db {
		return val
	}
	if sb.Info&IsUntyped == 0 || sb.Info&IsNumeric == 0 || db.Info&IsNumeric == 0 {
		return val
	}
	c := &SSAConvert{X: val}
	c.typ = pt
	c.name = fb.nextName()
	fb.emit(c)
	return c
}

// errArgs records a call-arity error for user packages only, matching the gate
// checkAssignable uses.
func (fb *ssaFuncBuilder) errArgs(msg string) {
	if fb.fn == nil || fb.fn.Pkg == nil || fb.fn.Pkg.Pkg == nil {
		return
	}
	cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
	push(cctx.compileErrors, fb.errPos() | msg)
}

// checkAssignable reports a value that cannot be assigned to the target type,
// mirroring the go/types diagnostic the legacy compiler gets for free. stage4
// accepted every mismatch - `var x int32 = "s"` compiled and printed 2288828
// before crashing - because nothing consulted the type rules while building.
// Interfaces and type parameters are skipped: their method sets and
// instantiations may not be resolved yet, and a false error is worse than a
// missing one.
// errPos renders the source position of the check that is about to fail so
// remapErrorLines turns it back into file:line when the diagnostic is printed
// (the "prefix:number:" shape remapOneLine expects). Without it an assignability
// error names no file, and the stdlib has many.
func (fb *ssaFuncBuilder) errPos() (s string) {
	if fb.curLine > 0 {
		return "line:" | simpleItoa(fb.curLine) | ": "
	}
	if fb.fn != nil {
		return fb.fn.name | ": "
	}
	return ""
}

func (fb *ssaFuncBuilder) checkAssignable(val SSAValue, T Type, what string) {
	if val == nil || T == nil {
		return
	}
	if fb.fn == nil || fb.fn.Pkg == nil || fb.fn.Pkg.Pkg == nil {
		return
	}
	V := val.SSAType()
	if V == nil {
		return
	}
	// A constant must be representable before any type compatibility is
	// considered: an untyped int is Assignable to int8, but 1000 is not.
	if cv, explicitNeg := constValueOf(val); cv != nil {
		if msg := constReprError(cv, T); msg != "" && !constReprSkipUnsigned(T, cv, explicitNeg) {
			cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
			push(cctx.compileErrors, fb.errPos() | "cannot use " | cv.String() | " as " | T.String() | " in " | what | " (" | msg | ")")
			return
		}
	}
	if Assignable(V, T) {
		return
	}
	// Constants and untyped values arrive with a default or unresolved type
	// (an untyped int is int32, a short-declared "s" keeps untyped string), so
	// Assignable cannot see the untypedness that makes `var x uint32 = PrimeRK`
	// legal while `var x int32 = "s"` is not. Compare kind classes for those
	// instead: only a mismatch between two known classes is reported.
	_, isConst := val.(*SSAConst)
	untypedInvolved := false
	if bv, isB := SafeUnderlying(V).(*Basic); isB && bv.Info&IsUntyped != 0 {
		untypedInvolved = true
	}
	if bt, isB := SafeUnderlying(T).(*Basic); isB && bt.Info&IsUntyped != 0 {
		untypedInvolved = true
	}
	// A TYPED constant must be judged like a value of its type, not by the
	// untyped kind-class rule below. `const Nano int64 = 1` then
	// `var y int32 = Nano` is a TYPE error in Go ("cannot use Nano (constant 1
	// of type int64) as int32 value"), but isConst was true and constClass
	// lumps every integer kind into one class, so it was accepted. Downstream
	// that typedness has to survive too: `5 * time.Second` is a Duration
	// (int64) precisely because Nanosecond is `Duration = 1`, and losing it
	// made the product untyped, default to int32, and surface as
	// "cannot use 5000000000 as int32 value ... (overflows int32)" - the whole
	// time.Duration cluster in net/http.
	if isConst && !untypedInvolved {
		isConst = false
	}
	if isConst || untypedInvolved {
		// Only a mismatch between two KNOWN classes is reported: an interface
		// target (fmt.Stringer) or a container has no class here, and
		// `fmt.Println("x")` against a ...fmt.Stringer parameter is legal.
		cv := constClass(V)
		ct := constClass(T)
		if cv == constClassOther || ct == constClassOther || cv == ct {
			return
		}
	} else if !ConcreteAssignTypes(V, T) {
		// ConcreteAssignTypes skips an interface on EITHER side because a
		// destination interface's method set may not be resolved yet, and a
		// false error is worse than a missing one. That reason does not reach
		// an interface SOURCE: a value of interface type is a dynamic
		// container, and getting the concrete value out of it needs a type
		// assertion, so Assignable's false is final. Without this arm
		// takeBox(i) with i of interface type compiled and handed the
		// interface payload to a Box parameter - silent garbage (1132487840)
		// where legacy/go/types reports "cannot use i ... as Box value".
		if _, vIface := SafeUnderlying(V).(*TCInterface); vIface {
			if _, vTP := V.(*TypeParam); !vTP {
				if _, tIface := SafeUnderlying(T).(*TCInterface); !tIface {
					cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
					push(cctx.compileErrors, fb.errPos() | "cannot use value of type " | V.String() | " as " | T.String() | " in " | what | " (an interface value needs a type assertion)")
					return
				}
			}
		}
		return
	}
	cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
	push(cctx.compileErrors, fb.errPos() | "cannot use value of type " | V.String() | " as " | T.String() | " in " | what)
}

// checkConstConvert reports a constant conversion whose value cannot be
// represented in the target type. go/types rejects `int8(1000)` (overflows)
// and `int32(1.5)` (truncated); stage4 emitted the convert and the value
// wrapped or truncated silently.
func (fb *ssaFuncBuilder) checkConstConvert(val SSAValue, T Type) {
	if fb.fn == nil || fb.fn.Pkg == nil || fb.fn.Pkg.Pkg == nil {
		return
	}
	cv, explicitNeg := constValueOf(val)
	if cv == nil {
		return
	}
	if msg := constReprError(cv, T); msg != "" && !constReprSkipUnsigned(T, cv, explicitNeg) {
		cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
		push(cctx.compileErrors, fb.errPos() | "cannot convert " | cv.String() | " to " | T.String() | " (" | msg | ")")
	}
}

// Constant kind classes, for checkAssignable's constant rule.
const (
	constClassOther int32 = 0
	constClassText  int32 = 1
	constClassNum   int32 = 2
	constClassBool  int32 = 3
)

// constClass classifies T coarsely: text (string/[]byte), numeric, boolean,
// or unknown. Only a mismatch between two known classes is reported.
func constClass(T Type) (c int32) {
	if T == nil {
		return constClassOther
	}
	if TextType(T) {
		return constClassText
	}
	b, ok := SafeUnderlying(T).(*Basic)
	if !ok {
		return constClassOther
	}
	if b.Info&IsString != 0 {
		return constClassText
	}
	if b.Info&IsBoolean != 0 {
		return constClassBool
	}
	if b.Info&(IsInteger|IsFloat) != 0 {
		return constClassNum
	}
	return constClassOther
}

// intFitsKind reports whether v is representable in the integer kind k.
// uintptr is treated as unsigned 64-bit so the same source does not report a
// false overflow on the wide targets while wasm32 accepts it.
func intFitsKind(v int64, k BasicKind) (ok bool) {
	switch k {
	case Int8:
		return v >= -128 && v <= 127
	case Int16:
		return v >= -32768 && v <= 32767
	case Int32:
		return v >= -2147483648 && v <= 2147483647
	case Int64:
		return true
	case Uint8:
		return v >= 0 && v <= 255
	case Uint16:
		return v >= 0 && v <= 65535
	case Uint32:
		return v >= 0 && v <= 4294967295
	case Uint64:
		return v >= 0
	case Uintptr:
		return v >= 0
	}
	return true
}

// constReprError returns why a constant cannot be represented in T, or "".
// go/types applies this at every assignment and conversion; stage4
// materializes a constant at its default type, so `var x int8 = 1000`,
// `var x uint8 = -1` and `int32(1.5)` used to compile and print the wrapped
// or truncated value.
func constReprError(cv ConstVal, T Type) (msg string) {
	bt, isB := SafeUnderlying(T).(*Basic)
	if !isB {
		return ""
	}
	switch c := cv.(type) {
	case *ConstInt:
		if bt.Info&IsInteger != 0 && !intFitsKind(c.V, bt.Kind) {
			return "overflows " | T.String()
		}
	case *ConstFloat:
		if bt.Info&IsInteger != 0 {
			if c.V < -9.2e18 || c.V > 9.2e18 {
				return "overflows " | T.String()
			}
			if c.V != float64(int64(c.V)) {
				return "truncated to integer"
			}
			if !intFitsKind(int64(c.V), bt.Kind) {
				return "overflows " | T.String()
			}
		}
	}
	return ""
}

// constValueOf extracts the constant value behind a value, folding a unary
// minus: `-1` is built as SSAMinus(const 1), so without the fold a negative
// constant assigned to an unsigned type was never seen as a constant at all.
// explicitNeg distinguishes that fold from a value that merely looks negative:
// ConstInt holds an int64, so the uint64 literal 0xFFFFFFFFFFFFFFFF is stored
// as -1 and only the written form may be judged against an unsigned target.
func constValueOf(val SSAValue) (cv ConstVal, explicitNeg bool) {
	if c := ssaExtractConst(val); c != nil {
		return c.val, false
	}
	if u, ok := val.(*SSAUnOp); ok && u.Op == OpSub {
		if c := ssaExtractConst(u.X); c != nil {
			switch k := c.val.(type) {
			case *ConstInt:
				return &ConstInt{V: -k.V}, true
			case *ConstFloat:
				return &ConstFloat{V: -k.V, Lit: "-" | k.Lit}, true
			}
		}
	}
	return nil, false
}

// constReprSkipUnsigned suppresses a verdict for a negative constant against
// an unsigned target when the source did not write the minus (see
// constValueOf). A positive constant cannot be a wrapped unsigned literal, so
// it is always judged.
func constReprSkipUnsigned(T Type, cv ConstVal, explicitNeg bool) (skip bool) {
	if explicitNeg {
		return false
	}
	bt, isB := SafeUnderlying(T).(*Basic)
	if !isB || bt.Info&IsUnsigned == 0 {
		return false
	}
	switch c := cv.(type) {
	case *ConstInt:
		return c.V < 0
	case *ConstFloat:
		return c.V < 0
	}
	return false
}

// shiftConstWiden returns a 64-bit type able to hold an untyped integer
// constant shifted by a non-constant count when the count's type cannot, or
// nil when T already holds the value. A shift result takes the left operand's
// type, so letting the count's type decide truncated 0x20000000000000 to zero
// (math.expm1 computed 0 instead of 4.6e18).
func shiftConstWiden(x SSAValue, T Type) Type {
	c := ssaExtractConst(x)
	if c == nil || c.val == nil {
		return nil
	}
	ci, ok := c.val.(*ConstInt)
	if !ok {
		return nil
	}
	if b, isB := SafeUnderlying(T).(*Basic); isB && b.Info&IsInteger != 0 && intFitsKind(ci.V, b.Kind) {
		return nil
	}
	if ci.V >= 0 {
		return Typ[Uint64]
	}
	return Typ[Int64]
}

// intTypeBits returns the width of an integer type, or 0 when T is not a
// concrete integer. A shift is re-typed by its context only where the width is
// unchanged, so the codegen already decided for it still holds.
func intTypeBits(T Type) (n int32) {
	b, ok := SafeUnderlying(T).(*Basic)
	if !ok || b.Info&IsInteger == 0 {
		return 0
	}
	switch b.Kind {
	case Int8, Uint8:
		return 8
	case Int16, Uint16:
		return 16
	case Int32, Uint32:
		return 32
	case Int64, Uint64, Uintptr:
		return 64
	}
	return 0
}

// isUntypedBasicType reports whether T is an untyped basic type, so an
// arithmetic result over it is still waiting for its context type.
func isUntypedBasicType(T Type) (ok bool) {
	b, isB := SafeUnderlying(T).(*Basic)
	return isB && b.Info&IsUntyped != 0
}

// defaultReprType is the type an untyped constant takes when no type is given.
// Moxie's int is 32 bits on every target (legacy's compiler.Sizes sets
// intWidth = 32), so an untyped integer that does not fit int32 overflows.
func defaultReprType(b *Basic) (t Type) {
	if b == nil {
		return nil
	}
	switch b.Kind {
	case UntypedInt, UntypedRune:
		return Typ[Int32]
	case UntypedFloat:
		return Typ[Float64]
	case UntypedBool:
		return Typ[Bool]
	case UntypedString:
		return Typ[TCString]
	}
	return nil
}

// defaultTypedVar gives a declaration's inferred type the default type of an
// untyped constant. `acc := 0` declares an int32 variable, not a value that is
// still untyped; go/types gives it int (int32 here) and legacy follows.
//
// Leaving it untyped made every later use context-dependent: in
// `out[j] = byte((acc >> bits) & 0x1f)` the conversion retyped the shift chain
// to uint8, the emitter declared an i8 shift, and bech32 encoding produced
// wrong payloads (the shift ran on acc's low byte sign-extended). Legacy was
// right, so the variable's type is what had to change.
func defaultTypedVar(t Type) (r Type) {
	if b, ok := SafeUnderlying(t).(*Basic); ok && b.Info&IsUntyped != 0 {
		if dt := defaultReprType(b); dt != nil {
			return dt
		}
	}
	return t
}

// checkDefaultRepr reports an untyped constant that is used without a type and
// does not fit the type it then takes. go/types reports "overflows int" for
// these; stage4 used to truncate the value to its low 32 bits, so
// `0 - 9223372036854775807` became 1 and `math.MaxUint64 / 10` printed its low
// half. Same user-code gate as checkAssignable: the stdlib carries latent
// overflow errors that go/types reports but the legacy loader never surfaces.
func (fb *ssaFuncBuilder) checkDefaultRepr(val SSAValue, what string) {
	if val == nil || val.SSAType() == nil {
		return
	}
	if fb.fn == nil || fb.fn.Pkg == nil || fb.fn.Pkg.Pkg == nil {
		return
	}
	b, isB := SafeUnderlying(val.SSAType()).(*Basic)
	if !isB || b.Info&IsUntyped == 0 {
		return
	}
	cv, explicitNeg := constValueOf(val)
	if cv == nil {
		return
	}
	dt := defaultReprType(b)
	if dt == nil {
		return
	}
	if msg := constReprError(cv, dt); msg != "" && !constReprSkipUnsigned(dt, cv, explicitNeg) {
		cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
		push(cctx.compileErrors, fb.errPos() | "cannot use " | cv.String() | " as " | dt.String() | " value in " | what | " (" | msg | ")")
	}
}

// retypeUntypedShift gives a shift, and the shifts feeding it, the context type
// T. A chain such as `1 << mantbits << expbits` takes one type from the
// surrounding expression, so assigning the outer shift the context type is not
// enough: the inner shift must emit at that width too, or a 52-bit shift runs
// at 32 bits (strconv's denormal path). Only instructions that were marked
// context-dependent are touched, so a typed count or left operand is unaffected.
func retypeUntypedShift(v SSAValue, T Type) {
	bin, ok := v.(*SSABinOp)
	if !ok || bin == nil || !bin.untypedShift || T == nil || intTypeBits(T) == 0 {
		return
	}
	bin.typ = T
	retypeUntypedShift(bin.X, T)
	if bin.Y != nil {
		retypeUntypedShift(bin.Y, T)
	}
}

func (fb *ssaFuncBuilder) buildStore(lhs syntax.Expr, val SSAValue) {
	if lhs == nil {
		panic("buildStore: nil lhs")
	}
	switch lv := lhs.(type) {
	case *syntax.Name:
		if lv == nil {
			panic("buildStore: nil *syntax.Name after type switch")
		}
		if lv.Value == "_" {
			return
		}
		obj := fb.lookupObject(lv.Value)
		if obj == nil {
			return
		}
		// A shift whose left operand is an untyped constant takes the type the
		// assignment gives it: `mantissa = 1 << flt.mantbits` with mantissa
		// uint64 is a 64-bit shift (mantbits is 52 for float64). The emitter
		// shifts at the instruction's declared type, so re-typing here also
		// fixes the width.
		if bin, okB := val.(*SSABinOp); okB && bin.untypedShift {
			retypeUntypedShift(bin, ObjectType(obj))
		}
		fb.checkAssignable(val, ObjectType(obj), "assignment")
		if alloc, ok2 := fb.vars[obj]; ok2 {
			val = fb.coerceToInterface(val, ObjectType(obj))
			fb.emitStore(alloc, val)
		} else if fv, ok3 := fb.freeVarPtrs[lv.Value]; ok3 {
			val = fb.coerceToInterface(val, ObjectType(obj))
			fb.emitStore(fv, val)
		} else if g2, ok4 := fb.fn.Pkg.Members[lv.Value].(*SSAGlobal); ok4 {
			if p, ok5 := g2.SSAType().(*Pointer); ok5 && p.Base != nil {
				val = fb.coerceToInterface(val, p.Base)
			}
			fb.emitStore(g2, val)
		} else if v, ok6 := obj.(*TCVar); ok6 && v.Pkg != nil && v.Pkg != fb.fn.Pkg.Pkg {
			// dot-imported global from another package
			impPkg := fb.ensureImportedSSAPackage(v.Pkg)
			g3, ok7 := impPkg.Members[lv.Value].(*SSAGlobal)
			if !ok7 {
				g3 = &SSAGlobal{
					name: lv.Value,
					typ:  NewPointer(v.Typ),
					pkg:  impPkg,
				}
				impPkg.SetMember(lv.Value, g3)
			}
			if p, ok8 := g3.SSAType().(*Pointer); ok8 && p.Base != nil {
				val = fb.coerceToInterface(val, p.Base)
			}
			fb.emitStore(g3, val)
		}
	case *syntax.Operation:
		if lv.Y == nil && lv.Op == token.Mul {
			ptr := fb.buildExpr(lv.X)
			if ptr != nil {
				if p, ok2 := ptr.SSAType().(*Pointer); ok2 && p.Base != nil {
					val = fb.coerceToInterface(val, p.Base)
				}
				fb.emitStore(ptr, val)
			}
		}
	case *syntax.SelectorExpr:
		addr := fb.buildSelectorAddr(lv)
		if addr == nil {
			fb.reportUndefinedField(lv, fb.operandType(lv.X))
			return
		}
		if p, ok2 := addr.SSAType().(*Pointer); ok2 && p.Base != nil {
			val = fb.coerceToInterface(val, p.Base)
		}
		fb.emitStore(addr, val)
	case *syntax.IndexExpr:
		base := fb.buildExpr(lv.X)
		idx := fb.buildExpr(lv.Index)
		if base == nil || idx == nil {
			return
		}
		if m, isMap := SafeUnderlying(base.SSAType()).(*TCMap); isMap {
			idx = fb.coerceToInterface(idx, m.Key)
			val = fb.coerceToInterface(val, m.Elem)
			fb.emit(&SSAMapUpdate{Map: base, Key: idx, Value: val})
			return
		}
		// For array LHS assignment, resolve the address of the base directly
		// so SSAIndexAddr GEPs into the original, not a stack copy.
		var baseAddr SSAValue
		if n, ok := lv.X.(*syntax.Name); ok {
			obj := fb.lookupObject(n.Value)
			if obj != nil {
				if alloc, ok2 := fb.vars[obj]; ok2 {
					baseAddr = alloc
				} else if g4, ok10 := fb.fn.Pkg.Members[n.Value].(*SSAGlobal); ok10 {
					baseAddr = g4
				}
			}
		} else if sel, ok11 := lv.X.(*syntax.SelectorExpr); ok11 {
			baseAddr = fb.buildSelectorAddr(sel)
		}
		if baseAddr != nil {
			if _, isArr := SafeUnderlying(base.SSAType()).(*Array); isArr {
				ia2 := &SSAIndexAddr{X: baseAddr, Index: idx}
				ia2.typ = NewPointer(ssaElemType(base.SSAType()))
				ia2.name = fb.nextName()
				fb.emit(ia2)
				if p, ok9 := ia2.SSAType().(*Pointer); ok9 && p.Base != nil {
					val = fb.coerceToInterface(val, p.Base)
				}
				fb.emitStore(ia2, val)
				return
			}
		}
		ia := &SSAIndexAddr{X: base, Index: idx}
		ia.typ = NewPointer(ssaElemType(base.SSAType()))
		ia.name = fb.nextName()
		fb.emit(ia)
		if p, ok2 := ia.SSAType().(*Pointer); ok2 && p.Base != nil {
			val = fb.coerceToInterface(val, p.Base)
		}
		fb.emitStore(ia, val)
	case *syntax.ListExpr:
		for i, e := range lv.ElemList {
			ext := &SSAExtract{Tuple: val, Index: i}
			ext.typ = ssaTupleElemType(val.SSAType(), i)
			ext.name = fb.nextName()
			fb.emit(ext)
			fb.buildStore(e, ext)
		}
	}
}

// shortVarStore assigns one LHS name of a short variable declaration.
// Go semantics: if the name already denotes a variable in the same scope,
// := reassigns it (info.Defs is nil); otherwise it declares a new local.
func (fb *ssaFuncBuilder) shortVarStore(name *syntax.Name, val SSAValue, typ Type) {
	if name == nil || name.Value == "_" {
		return
	}
	typ = defaultTypedVar(typ)
	// Same-scope reassignment: if a variable with this name was declared in
	// the current scope, := assigns to it (Go semantics). A name that resolves
	// to an enclosing scope would be shadowing, which Moxie forbids.
	//
	// The report is only made inside a function literal: checkShadowing already
	// walks every named function body, position-insensitively, and it does not
	// walk closures, so this is the closure's only check. Reporting outside a
	// closure would duplicate that pass's diagnostic.
	if ex := fb.lookupObject(name.Value); ex != nil {
		if sc, ok := fb.varScope[ex]; ok {
			if sc == fb.scopeID {
				if existing, ok2 := fb.vars[ex]; ok2 {
					if val != nil {
						fb.emitStore(existing, val)
					}
					return
				}
			}
			if fb.parent != nil && fb.scopeIsAncestor(sc, fb.scopeID) {
				shadowErr(fb.fn.name, name.Value)
			}
		} else if fb.parent != nil && fb.bindingShadows(ex) {
			shadowErr(fb.fn.name, name.Value)
		}
	} else if fb.parent != nil && fb.fn.Pkg != nil && inNameList(fb.fn.Pkg.ImportNames, name.Value) {
		// Bound by an import in another file of this package. The collision
		// rule is package-wide, so this is still a collision.
		shadowErr(fb.fn.name, name.Value)
	} else if fb.parent != nil && Universe.Lookup(name.Value) != nil {
		// Predeclared identifiers are in scope everywhere.
		shadowErr(fb.fn.name, name.Value)
	}
	fb.removeVar(name.Value)
	var obj Object
	if fb.info != nil {
		obj = fb.info.Defs[name]
	}
	if obj == nil {
		obj = NewTCVar(fb.fn.Pkg.Pkg, name.Value, typ)
	}
	alloc := fb.emitAlloc(typ, 0)
	fb.vars[obj] = alloc
	fb.varScope[obj] = fb.scopeID
	if val != nil {
		fb.emitStore(alloc, val)
	}
}

func (fb *ssaFuncBuilder) buildShortVarDecl(s *syntax.AssignStmt) {
	names := ssaExprNames(s.Lhs)
	if len(names) == 2 {
		if ae, ok := s.Rhs.(*syntax.AssertExpr); ok {
			x := fb.buildExpr(ae.X)
			assertedType := fb.resolveType(ae.Type)
			if assertedType != nil {
				if x == nil {
					x = &SSAConst{typ: NewTCInterface(nil, nil)}
				}
				ta := &SSATypeAssert{X: x, AssertedType: assertedType, CommaOk: true}
				ta.typ = NewTuple(
					NewTCVar(nil, "val", assertedType),
					NewTCVar(nil, "ok", Typ[Bool]),
				)
				ta.name = fb.nextName()
				fb.emit(ta)
				for i, name := range names {
					if name.Value == "_" {
						continue
					}
					ext := &SSAExtract{Tuple: ta, Index: i}
					ext.typ = ssaTupleElemType(ta.typ, i)
					ext.name = fb.nextName()
					fb.emit(ext)
					fb.shortVarStore(name, ext, ext.typ)
				}
				return
			}
		}
		if ie, ok := s.Rhs.(*syntax.IndexExpr); ok {
			x := fb.buildExpr(ie.X)
			idx := fb.buildExpr(ie.Index)
			if x != nil && idx != nil {
				if mt, ok2 := SafeUnderlying(x.SSAType()).(*TCMap); ok2 {
					idx = fb.coerceToInterface(idx, mt.Key)
					l := &SSALookup{X: x, Index: idx, CommaOk: true}
					l.typ = NewTuple(
						NewTCVar(nil, "v", mt.Elem),
						NewTCVar(nil, "ok", Typ[Bool]),
					)
					l.name = fb.nextName()
					fb.emit(l)
					for i, name := range names {
						if name.Value == "_" {
							continue
						}
						ext := &SSAExtract{Tuple: l, Index: i}
						ext.typ = ssaTupleElemType(l.typ, i)
						ext.name = fb.nextName()
						fb.emit(ext)
						fb.shortVarStore(name, ext, ext.typ)
					}
					return
				}
			}
		}
		if oe, ok := s.Rhs.(*syntax.Operation); ok && oe.Y == nil && oe.Op == token.Recv {
			x := fb.buildExpr(oe.X)
			if x != nil {
				elemType := ssaChanElemType(x.SSAType())
				u := &SSAUnOp{Op: OpArrow, X: x, CommaOk: true}
				u.typ = NewTuple(
					NewTCVar(nil, "v", elemType),
					NewTCVar(nil, "ok", Typ[Bool]),
				)
				u.name = fb.nextName()
				fb.emit(u)
				for i, name := range names {
					if name.Value == "_" {
						continue
					}
					ext := &SSAExtract{Tuple: u, Index: i}
					ext.typ = ssaTupleElemType(u.typ, i)
					ext.name = fb.nextName()
					fb.emit(ext)
					fb.shortVarStore(name, ext, ext.typ)
				}
				return
			}
		}
	}
	if rhsList, ok := s.Rhs.(*syntax.ListExpr); ok && len(rhsList.ElemList) == len(names) {
		vals := []SSAValue{:len(rhsList.ElemList)}
		for i, re := range rhsList.ElemList {
			vals[i] = fb.buildExpr(re)
		}
		for i, name := range names {
			if name.Value == "_" {
				continue
			}
			var typ Type
			if vals[i] != nil {
				typ = vals[i].SSAType()
			}
			fb.shortVarStore(name, vals[i], typ)
		}
		return
	}

	rhs := fb.buildExpr(s.Rhs)


	isTuple := false
	var tup *Tuple
	if rhs != nil {
		tup, isTuple = rhs.SSAType().(*Tuple)
	}
	for i, name := range names {
		if name.Value == "_" {
			continue
		}
		var typ Type
		if rhs != nil {
			if isTuple && i < tup.Len() {
				typ = tup.At(i).Typ
			} else if i == 0 {
				typ = rhs.SSAType()
			}
		}
		if typ == nil {
			// Fail loud: a short var whose rhs type cannot be resolved
			// would silently compile as Int32 and corrupt the IR.
			// Every known class (generic methods, func-field calls, push,
			// iota consts) is fixed in the builder - a nil here is a new
			// builder bug, not a fallback case.
			rhsInfo := "nil"
			if rhs != nil {
				if rhs.SSAType() == nil {
					rhsInfo = "ssatype=nil"
				} else {
					rhsInfo = "non-tuple"
				}
			}
			if fb.fn != nil {
				mxutil.WriteStr(2, "compile error: cannot resolve type of short var " | name.Value | " in " | fb.fn.name | " (rhs=" | rhsInfo | ")\n")
			} else {
				mxutil.WriteStr(2, "compile error: cannot resolve type of short var " | name.Value | " (rhs=" | rhsInfo | ")\n")
			}
			typ = Typ[Int32]
		}
		var initVal SSAValue
		if rhs != nil {
			if isTuple {
				ext := &SSAExtract{Tuple: rhs, Index: i}
				ext.typ = typ
				ext.name = fb.nextName()
				fb.emit(ext)
				initVal = ext
			} else if i == 0 {
				initVal = rhs
			}
		}
		if typ != nil && isUntypedBasicType(typ) {
			fb.checkDefaultRepr(initVal, "assignment to " | name.Value)
		}
		fb.shortVarStore(name, initVal, typ)
	}
}

func (fb *ssaFuncBuilder) buildLocalDecl(d syntax.Decl) {
	switch dd := d.(type) {
	case *syntax.VarDecl:
		var typ Type
		if fb.info != nil && len(dd.NameList) > 0 {
			if obj := fb.info.Defs[dd.NameList[0]]; obj != nil {
				typ = ObjectType(obj)
			}
		}
		if typ == nil && dd.Type != nil {
			typ = fb.resolveType(dd.Type)
		}
		// `var a, b T = x, y` gives each name its own value. Building the list
		// once and storing it to every name handed the first value to both (and
		// a values list that built to nil left them all zero):
		// `var pow, sq uint32 = 1, PrimeRK` in bytealg.HashStrBytes left the
		// rolling-hash factor at 0, so IndexRabinKarp answered -1 for needles
		// that are present.
		var initVal SSAValue
		var multiVals []SSAValue
		if vl, isList := dd.Values.(*syntax.ListExpr); isList && len(dd.NameList) > 1 && len(vl.ElemList) == len(dd.NameList) {
			multiVals = []SSAValue{:len(vl.ElemList)}
			for mi := int32(0); mi < len(vl.ElemList); mi++ {
				multiVals[mi] = fb.buildExpr(vl.ElemList[mi])
			}
			initVal = multiVals[0]
		} else {
			initVal = fb.buildExpr(dd.Values)
		}
		if dd.Type != nil && initVal != nil && typ != nil {
			// A declared type is the shift's context, like an assignment.
			if bin, okB := initVal.(*SSABinOp); okB && bin.untypedShift {
				retypeUntypedShift(bin, typ)
			}
			fb.checkAssignable(initVal, typ, "variable declaration")
		}
		if typ == nil && initVal != nil {
			// No explicit type and nothing recorded on the object: the
			// initializer's SSA type IS the declaration's type, which is the
			// same source buildShortVarDecl uses for ':'. Without this a
			// 'var b = pkgs.New()' left b untyped, so a later b.Method()
			// failed to resolve.
			typ = initVal.SSAType()
			if isUntypedBasicType(typ) {
				fb.checkDefaultRepr(initVal, "variable declaration")
			}
			typ = defaultTypedVar(typ)
		}
		for ni, name := range dd.NameList {
			if name.Value == "_" {
				continue
			}
			// Only a closure is checked here: checkShadowing covers every named
			// function body and does not walk function literals.
			if fb.parent != nil {
				if ex := fb.lookupObject(name.Value); ex != nil {
					if fb.bindingShadows(ex) {
						shadowErr(fb.fn.name, name.Value)
					}
				} else if fb.fn.Pkg != nil && inNameList(fb.fn.Pkg.ImportNames, name.Value) {
					// Bound by an import in another file of this package.
					shadowErr(fb.fn.name, name.Value)
				} else if Universe.Lookup(name.Value) != nil {
					shadowErr(fb.fn.name, name.Value)
				}
			}
			fb.removeVar(name.Value)
			var obj Object
			if fb.info != nil {
				obj = fb.info.Defs[name]
			}
			if obj == nil {
				obj = NewTCVar(fb.fn.Pkg.Pkg, name.Value, typ)
			}
			if tv, isVar := obj.(*TCVar); isVar && tv.Typ == nil {
				tv.Typ = typ
			}
			alloc := fb.emitAlloc(ObjectType(obj), 0)
			fb.vars[obj] = alloc
			fb.varScope[obj] = fb.scopeID
			fb.fn.Locals = mxutil.Ensure(fb.fn.Locals, 1)
			push(fb.fn.Locals, alloc)
			v := initVal
			if multiVals != nil && ni < len(multiVals) {
				v = multiVals[ni]
				if v != nil {
					if bin, okB := v.(*SSABinOp); okB && bin.untypedShift {
						retypeUntypedShift(bin, ObjectType(obj))
					}
					fb.checkAssignable(v, ObjectType(obj), "variable declaration")
				}
			}
			if v != nil {
				v = fb.coerceToInterface(v, ObjectType(obj))
				fb.emitStore(alloc, v)
			} else {
				fb.emitStore(alloc, &SSAConst{typ: ObjectType(obj), val: nil})
			}
		}
	case *syntax.ConstDecl:
		if fb.localConsts == nil {
			fb.localConsts = map[string]*SSAConst{}
		}
		// iota: the parser emits one ConstDecl per line; bare lines have
		// Values == nil. Track the position within the const group.
		if dd.Group == nil {
			fb.iotaVal = 0
			fb.lastConstGroup = nil
		} else if dd.Group == fb.lastConstGroup {
			fb.iotaVal++
		} else {
			fb.lastConstGroup = dd.Group
			fb.iotaVal = 0
		}
		if dd.Values == nil && len(dd.NameList) == 1 {
			fb.localConsts[dd.NameList[0].Value] = &SSAConst{typ: Typ[UntypedInt], val: &ConstInt{V: fb.iotaVal}}
		} else if dd.Values != nil {
			if list, ok := dd.Values.(*syntax.ListExpr); ok {
				for i, name := range dd.NameList {
					if i < len(list.ElemList) {
						if cv := fb.evalLocalConstExpr(list.ElemList[i], fb.iotaVal); cv != nil {
							fb.localConsts[name.Value] = &SSAConst{typ: constValType(cv), val: cv}
						}
					}
				}
			} else if len(dd.NameList) == 1 {
				if cv := fb.evalLocalConstExpr(dd.Values, fb.iotaVal); cv != nil {
					fb.localConsts[dd.NameList[0].Value] = &SSAConst{typ: constValType(cv), val: cv}
				}
			}
		}
	case *syntax.TypeDecl:
		if dd.Name != nil {
			resolved := fb.resolveTypeAST(dd.Type)
			if resolved != nil {
				fb.localTypes[dd.Name.Value] = resolved
			}
		}
	}
}


// wordType is the universe's uintptr: a named type over Uint32 on wasm32 and
// Uint64 elsewhere. unsafe.Sizeof/Alignof/Offsetof yield uintptr, so folding
// them to this type gives the constant the target's word width. Typing them
// Int64 instead made the value i64 on wasm32, and passing an i64 where a
// uintptr parameter is declared - runtime.alloc's size, for one - produced a
// call whose signature did not match, which LLVM lowers to unreachable.
func (fb *ssaFuncBuilder) wordType() (t Type) {
	if cctx != nil && cctx.universe != nil && cctx.universe.Uintptr != nil && cctx.universe.Uintptr.Typ != nil {
		return cctx.universe.Uintptr.Typ
	}
	return Typ[Uint64]
}

func (fb *ssaFuncBuilder) evalLocalConstExpr(e syntax.Expr, iotaVal int64) (c ConstVal) {
	if e == nil {
		return nil
	}
	switch ev := e.(type) {
	case *syntax.BasicLit:
		return EvalBasicLitLocal(ev)
	case *syntax.Name:
		if ev.Value == "iota" {
			return &ConstInt{V: iotaVal}
		}
		if lc, ok := fb.localConsts[ev.Value]; ok && lc != nil && lc.val != nil {
			return lc.val
		}
		return tcEvalConstExpr(ev, fb.fn.Pkg.Pkg.Scope, iotaVal)
	case *syntax.Operation:
		if ev.Y == nil {
			xr2 := fb.evalLocalConstExpr(ev.X, iotaVal)
			if xr2 == nil {
				return nil
			}
			return EvalUnaryLocal(ev.Op, xr2)
		}
		xr := fb.evalLocalConstExpr(ev.X, iotaVal)
		yr := fb.evalLocalConstExpr(ev.Y, iotaVal)
		if xr == nil || yr == nil {
			return nil
		}
		return EvalBinaryLocal(ev.Op, xr, yr)
	case *syntax.ParenExpr:
		return fb.evalLocalConstExpr(ev.X, iotaVal)
	case *syntax.SelectorExpr:
		// Qualified constant: pkg.Const. Resolve the package through the
		// builder's scopes (imports are file-scoped), then read the const.
		if pkgName, ok := ev.X.(*syntax.Name); ok {
			if pn, ok2 := fb.lookupObject(pkgName.Value).(*PkgName); ok2 && pn.Imported != nil && pn.Imported.Scope != nil {
				if obj := pn.Imported.Scope.Lookup(ev.Sel.Value); obj != nil {
					if k, ok3 := obj.(*TCConst); ok3 && k.Val != nil {
						return k.Val
					}
				}
			}
		}
		return tcEvalConstExpr(ev, fb.fn.Pkg.Pkg.Scope, iotaVal)
	case *syntax.CallExpr:
		if name, ok := ev.Fun.(*syntax.Name); ok && name.Value == "len" && len(ev.ArgList) == 1 {
			lenArg := fb.evalLocalConstExpr(ev.ArgList[0], iotaVal)
			if cs, ok2 := lenArg.(*ConstStr); ok2 {
				return &ConstInt{V: int64(len(cs.S))}
			}
			// len of an array-typed expression is a compile-time constant.
			if arr, ok2 := SafeUnderlying(fb.exprStaticType(ev.ArgList[0])).(*Array); ok2 {
				return &ConstInt{V: arr.Len}
			}
		}
		if sel, ok := ev.Fun.(*syntax.SelectorExpr); ok {
			if pg, ok2 := sel.X.(*syntax.Name); ok2 && pg.Value == "unsafe" && len(ev.ArgList) == 1 {
				switch sel.Sel.Value {
				case "Offsetof":
					if off, ok3 := fb.evalOffsetofArg(ev.ArgList[0]); ok3 {
						return &ConstInt{V: off}
					}
					return nil
				case "Sizeof":
					if t := fb.exprStaticType(ev.ArgList[0]); t != nil {
						return &ConstInt{V: TypeSize(t)}
					}
					return nil
				case "Alignof":
					if t := fb.exprStaticType(ev.ArgList[0]); t != nil {
						return &ConstInt{V: TypeAlign(t)}
					}
					return nil
				}
			}
		}
		if len(ev.ArgList) != 1 {
			return nil
		}
		inner := fb.evalLocalConstExpr(ev.ArgList[0], iotaVal)
		if inner == nil {
			return nil
		}
		targetType := tcResolveNameInline(ev.Fun, fb.fn.Pkg.Pkg.Scope)
		if targetType == nil {
			return inner
		}
		return ConvertConstLocal(inner, targetType)
	}
	return nil
}

// operandType returns the static type of an unsafe.Sizeof/Alignof/Offsetof
// operand without leaving it evaluated. It first tries the syntactic resolver
// (no IR), and only if that cannot see the type (literals, conversions,
// package-qualified globals) falls back to evaluating the expression and
// rolling back the instructions and name counter it emitted. The original
// buildExpr-only path left dead IR (e.g. an alloc for a composite literal)
// that survived optimization; the syntactic-only path returned the default 8
// for slices/strings/small ints and corrupted allocation and hash state.
func (fb *ssaFuncBuilder) operandType(e syntax.Expr) (t Type) {
	if e == nil {
		return nil
	}
	if t = fb.exprStaticType(e); t != nil {
		return t
	}
	block := fb.currentBlock
	n := int32(0)
	if block != nil {
		n = len(block.Instrs)
	}
	savedCounter := fb.counter
	v := fb.buildExpr(e)
	if block != nil && len(block.Instrs) > n {
		block.Instrs = block.Instrs[:n]
	}
	fb.counter = savedCounter
	if v != nil {
		return v.SSAType()
	}
	return nil
}

// exprStaticType returns the static type of a value expression without
// emitting IR. Used by unsafe.Sizeof/Alignof/Offsetof const folding, where
// the operand is inspected, never evaluated.
func (fb *ssaFuncBuilder) exprStaticType(e syntax.Expr) (t Type) {
	switch ex := e.(type) {
	case *syntax.Name:
		if obj := fb.lookupObject(ex.Value); obj != nil {
			return ObjectType(obj)
		}
	case *syntax.ParenExpr:
		return fb.exprStaticType(ex.X)
	case *syntax.Operation:
		if ex.Y == nil && ex.Op == token.And {
			if bt := fb.exprStaticType(ex.X); bt != nil {
				return &Pointer{Base: bt}
			}
			return nil
		}
		if ex.Y == nil && ex.Op == token.Mul {
			if p, ok := SafeUnderlying(fb.exprStaticType(ex.X)).(*Pointer); ok {
				return p.Base
			}
		}
	case *syntax.CallExpr:
		if sig, ok := SafeUnderlying(fb.exprStaticType(ex.Fun)).(*Signature); ok && sig != nil && sig.Results != nil && sig.Results.Len() > 0 {
			return sig.Results.At(0).Typ
		}
	case *syntax.CompositeLit:
		if ex.Type != nil {
			return fb.resolveType(ex.Type)
		}
	case *syntax.SelectorExpr:
		bt := fb.exprStaticType(ex.X)
		if bt == nil {
			return nil
		}
		st, ok := SafeUnderlying(bt).(*TCStruct)
		if !ok {
			return nil
		}
		if i := fb.fieldIndex(st, ex.Sel.Value); i >= 0 {
			return st.Field(i).Typ
		}
		path := fb.findEmbeddedFieldPath(st, ex.Sel.Value)
		if len(path) == 0 {
			return nil
		}
		var cur Type = st
		for _, idx := range path {
			cur = fb.fieldType(cur, idx)
		}
		return cur
	case *syntax.IndexExpr:
		switch u := SafeUnderlying(fb.exprStaticType(ex.X)).(type) {
		case *Slice:
			return u.Elem
		case *Array:
			return u.Elem
		}
	}
	return nil
}

// evalOffsetofArg computes unsafe.Offsetof(sel) for a struct field selector,
// following embedded fields the same way an ordinary selector does. Offsets are
// accumulated along the embedded path; a path that hops through a pointer has no
// constant offset and reports false.
func (fb *ssaFuncBuilder) evalOffsetofArg(e syntax.Expr) (off int64, ok bool) {
	sel, isSel := e.(*syntax.SelectorExpr)
	if !isSel || sel == nil || sel.Sel == nil {
		return 0, false
	}
	st, isStruct := SafeUnderlying(fb.operandType(sel.X)).(*TCStruct)
	if !isStruct {
		return 0, false
	}
	if i := fb.fieldIndex(st, sel.Sel.Value); i >= 0 {
		return int64(structFieldOffset(st, i)), true
	}
	path := fb.findEmbeddedFieldPath(st, sel.Sel.Value)
	if len(path) < 2 {
		return 0, false
	}
	var total int64
	var cur Type = st
	for pi, idx := range path {
		cst, isS := SafeUnderlying(cur).(*TCStruct)
		if !isS {
			return 0, false
		}
		total += int64(structFieldOffset(cst, idx))
		cur = fb.fieldType(cur, idx)
		if pi < len(path)-1 {
			if _, isPtr := SafeUnderlying(cur).(*Pointer); isPtr {
				// The remaining offsets are relative to the pointed-to
				// struct, not to the operand, so there is no constant offset.
				return 0, false
			}
		}
	}
	return total, true
}

func (fb *ssaFuncBuilder) buildIf(s *syntax.IfStmt) {
	// An if statement is its own implicit block. Without this scope an init
	// ':=' that reuses an outer name was treated as a same-scope assignment:
	// it overwrote the outer variable (a parameter, typically) instead of
	// shadowing it, and the body then resolved the name to the outer object -
	// so `if w, ok := w.(io.ReaderFrom); ok { w.ReadFrom(...) }` failed to
	// resolve ReadFrom against the outer io.Writer.
	ifScope := fb.enterBlock()
	if s.Init != nil {
		fb.buildStmt(s.Init)
	}
	if fb.currentBlock == nil {
		fb.exitBlock(ifScope)
		return
	}
	cond := fb.buildExpr(s.Cond)
	if cond == nil {
		fb.exitBlock(ifScope)
		return
	}

	thenBlock := fb.newBlock("if.then")
	var elseBlock *SSABasicBlock
	doneBlock := fb.newBlock("if.done")

	if s.Else != nil {
		elseBlock = fb.newBlock("if.else")
	} else {
		elseBlock = doneBlock
	}

	fb.emit(&SSAIf{Cond: cond})
	fb.pushSucc(fb.currentBlock, thenBlock)
	fb.pushSucc(fb.currentBlock, elseBlock)
	fb.pushPred(thenBlock, fb.currentBlock)
	fb.pushPred(elseBlock, fb.currentBlock)

	thenScope := fb.enterBlock()
	fb.currentBlock = thenBlock
	fb.buildBlock(s.Then)
	if fb.currentBlock != nil && !fb.blockTerminated(fb.currentBlock) {
		fb.emit(&SSAJump{Comment: "if.done"})
		fb.pushSucc(fb.currentBlock, doneBlock)
		fb.pushPred(doneBlock, fb.currentBlock)
	}
	fb.exitBlock(thenScope)

	if s.Else != nil {
		elseScope := fb.enterBlock()
		fb.currentBlock = elseBlock
		fb.buildStmt(s.Else)
		if fb.currentBlock != nil && !fb.blockTerminated(fb.currentBlock) {
			fb.emit(&SSAJump{Comment: "if.done"})
			fb.pushSucc(fb.currentBlock, doneBlock)
			fb.pushPred(doneBlock, fb.currentBlock)
		}
		fb.exitBlock(elseScope)
	}

	fb.currentBlock = doneBlock
	fb.exitBlock(ifScope)
}

func (fb *ssaFuncBuilder) buildFor(s *syntax.ForStmt) {
	// A for statement is its own implicit block, so its init ':=' shadows an
	// outer name of the same name rather than assigning to it.
	forScope := fb.enterBlock()
	if s.Init != nil {
		if rc, ok := s.Init.(*syntax.RangeClause); ok {
			fb.buildRangeLoop(s, rc)
			fb.exitBlock(forScope)
			return
		}
		fb.buildStmt(s.Init)
	}

	condBlock := fb.newBlock("for.cond")
	bodyBlock := fb.newBlock("for.body")
	postBlock := fb.newBlock("for.post")
	doneBlock := fb.newBlock("for.done")

	fb.emit(&SSAJump{Comment: "for.cond"})
	fb.pushSucc(fb.currentBlock, condBlock)
	fb.pushPred(condBlock, fb.currentBlock)

	fb.loops = mxutil.Ensure(fb.loops, 1)
	push(fb.loops, ssaLoopState{label: fb.pendingLabel, body: bodyBlock, post: postBlock, done: doneBlock})
	fb.pendingLabel = ""

	fb.currentBlock = condBlock
	if s.Cond != nil {
		cond := fb.buildExpr(s.Cond)
		if cond != nil {
			fb.emit(&SSAIf{Cond: cond})
			fb.pushSucc(fb.currentBlock, bodyBlock)
			fb.pushSucc(fb.currentBlock, doneBlock)
			fb.pushPred(bodyBlock, condBlock)
			fb.pushPred(doneBlock, condBlock)
		}
	} else {
		fb.emit(&SSAJump{Comment: "for.body"})
		fb.pushSucc(fb.currentBlock, bodyBlock)
		fb.pushPred(bodyBlock, condBlock)
	}

	fb.currentBlock = bodyBlock
	fb.buildBlock(s.Body)
	if fb.currentBlock != nil && !fb.blockTerminated(fb.currentBlock) {
		fb.emit(&SSAJump{Comment: "for.post"})
		fb.pushSucc(fb.currentBlock, postBlock)
		fb.pushPred(postBlock, fb.currentBlock)
	}

	fb.currentBlock = postBlock
	if s.Post != nil {
		fb.buildStmt(s.Post)
	}
	if fb.currentBlock != nil {
		fb.emit(&SSAJump{Comment: "for.cond"})
		fb.pushSucc(fb.currentBlock, condBlock)
		fb.pushPred(condBlock, fb.currentBlock)
	}
	fb.exitBlock(forScope)

	fb.loops = fb.loops[:len(fb.loops)-1]
	fb.currentBlock = doneBlock
}

func (fb *ssaFuncBuilder) buildRangeLoop(s *syntax.ForStmt, rc *syntax.RangeClause) {
	rangeScope := fb.enterBlock()
	iterExpr := fb.buildExpr(rc.X)
	if iterExpr == nil {
		return
	}

	r := &SSARange{X: iterExpr}
	r.typ = Typ[Invalid]
	r.name = fb.nextName()
	fb.emit(r)

	bodyBlock := fb.newBlock("range.body")
	doneBlock := fb.newBlock("range.done")

	condBlock := fb.newBlock("range.cond")

	fb.loops = mxutil.Ensure(fb.loops, 1)
	push(fb.loops, ssaLoopState{label: fb.pendingLabel, body: bodyBlock, post: condBlock, done: doneBlock})
	fb.pendingLabel = ""
	fb.emit(&SSAJump{Comment: "range.cond"})
	fb.pushSucc(fb.currentBlock, condBlock)
	fb.pushPred(condBlock, fb.currentBlock)

	fb.currentBlock = condBlock
	iterSSAType := iterExpr.SSAType()
	if iterSSAType == nil {
		switch x := rc.X.(type) {
		case *syntax.SelectorExpr:
			if x != nil {
				tv := x.GetTypeInfo()
				if tv.Type != nil {
					if t, ok := tv.Type.(Type); ok { iterSSAType = t }
				}
			}
		case *syntax.Name:
			if x != nil {
				tv := x.GetTypeInfo()
				if tv.Type != nil {
					if t, ok := tv.Type.(Type); ok { iterSSAType = t }
				}
			}
		}
		if iterSSAType == nil {
			mxutil.WriteStr(2, "WARN: unresolved range type in " | fb.fn.Pkg.Pkg.Path | "." | fb.fn.name | "\n")
			return
		}
	}
	nxt := &SSANext{Iter: r, IsString: ssaIsStringType(iterSSAType)}
	keyTyp := asType(Typ[Int32])
	valTyp := asType(Typ[Invalid])
	iterT := iterSSAType
	iterU := SafeUnderlying(iterT)
	if bt, okb := iterU.(*Basic); okb && bt.Info&IsInteger != 0 {
		// range-over-int: the index carries the operand's own integer type.
		keyTyp = iterT
	} else if sl, ok := iterU.(*Slice); ok {
		valTyp = sl.Elem
	} else if sl2, ok12 := iterT.(*Slice); ok12 {
		valTyp = sl2.Elem
	} else if mt2, ok13 := iterU.(*TCMap); ok13 {
		keyTyp = mt2.Key
		valTyp = mt2.Elem
	} else if mt3, ok14 := iterT.(*TCMap); ok14 {
		keyTyp = mt3.Key
		valTyp = mt3.Elem
	} else if ar2, ok15 := iterU.(*Array); ok15 {
		valTyp = ar2.Elem
	} else if ar3, ok16 := iterT.(*Array); ok16 {
		valTyp = ar3.Elem
	} else if p, ok17 := iterU.(*Pointer); ok17 && p.Base != nil {
		if ar4, ok18 := SafeUnderlying(p.Base).(*Array); ok18 {
			valTyp = ar4.Elem
		}
	}
	if valTyp == asType(Typ[Invalid]) && ssaIsStringType(iterSSAType) {
		valTyp = asType(Typ[Uint8])
	}
	nxt.typ = NewTuple(
		NewTCVar(nil, "ok", Typ[Bool]),
		NewTCVar(nil, "k", keyTyp),
		NewTCVar(nil, "v", valTyp),
	)
	nxt.name = fb.nextName()
	fb.emit(nxt)

	okExt := &SSAExtract{Tuple: nxt, Index: 0}
	okExt.typ = Typ[Bool]
	okExt.name = fb.nextName()
	fb.emit(okExt)

	fb.emit(&SSAIf{Cond: okExt})
	fb.pushSucc(fb.currentBlock, bodyBlock)
	fb.pushSucc(fb.currentBlock, doneBlock)
	fb.pushPred(bodyBlock, condBlock)
	fb.pushPred(doneBlock, condBlock)

	rangeScope := fb.enterBlock()
	fb.currentBlock = bodyBlock
	if rc.Lhs != nil && rc.Def {
		names := ssaExprNames(rc.Lhs)
		for i, name := range names {
			if name.Value == "_" {
				continue
			}
			ext := &SSAExtract{Tuple: nxt, Index: i + 1}
			ext.typ = ssaTupleElemType(nxt.typ, i+1)
			ext.name = fb.nextName()
			fb.emit(ext)
			var obj Object
			if fb.info != nil {
				obj = fb.info.Defs[name]
			}
			if obj == nil {
				obj = NewTCVar(fb.fn.Pkg.Pkg, name.Value, ext.typ)
			}
			fb.removeVar(name.Value)
			alloc := fb.emitAlloc(ext.typ, 0)
			fb.vars[obj] = alloc
			fb.emitStore(alloc, ext)
		}
	} else if rc.Lhs != nil && !rc.Def {
		names := ssaExprNames(rc.Lhs)
		for i, name := range names {
			if name.Value == "_" {
				continue
			}
			ext := &SSAExtract{Tuple: nxt, Index: i + 1}
			ext.typ = ssaTupleElemType(nxt.typ, i+1)
			ext.name = fb.nextName()
			fb.emit(ext)
			fb.buildStore(name, ext)
		}
	}
	fb.buildBlock(s.Body)
	if fb.currentBlock != nil && !fb.blockTerminated(fb.currentBlock) {
		fb.emit(&SSAJump{Comment: "range.cond"})
		fb.pushSucc(fb.currentBlock, condBlock)
		fb.pushPred(condBlock, fb.currentBlock)
	}
	fb.exitBlock(rangeScope)

	fb.loops = fb.loops[:len(fb.loops)-1]
	fb.currentBlock = doneBlock
}

func (fb *ssaFuncBuilder) buildSwitch(s *syntax.SwitchStmt) {
	// A switch statement is its own implicit block, so its init ':=' shadows
	// an outer name of the same name rather than assigning to it.
	switchScope := fb.enterBlock()
	if s.Init != nil {
		fb.buildStmt(s.Init)
	}
	if fb.currentBlock == nil {
		fb.exitBlock(switchScope)
		return
	}

	doneBlock := fb.newBlock("switch.done")
	savedLoops := fb.loops
	fb.loops = mxutil.Ensure(fb.loops, 1)
	push(fb.loops, ssaLoopState{label: fb.pendingLabel, done: doneBlock})
	fb.pendingLabel = ""

	if s.Tag != nil {
		if tsg, ok := s.Tag.(*syntax.TypeSwitchGuard); ok {
			fb.buildTypeSwitch(s, tsg, doneBlock)
			fb.loops = savedLoops
			fb.currentBlock = doneBlock
			fb.exitBlock(switchScope)
			return
		}
	}

	var tag SSAValue
	if s.Tag != nil {
		tag = fb.buildExpr(s.Tag)
	}

	// A default clause is tested last no matter where it is written: every case
	// expression is evaluated before control falls back to default. Emitting
	// default where it stands jumped into its body unconditionally and made
	// every case after it dead, so crypto/aes.NewCipher rejected a 32-byte key
	// ('switch k { default: ...; case 16, 24, 32: break }' always took
	// default). The legacy compiler evaluates the cases first.
	var defaultClause *syntax.CaseClause
	for _, clause := range s.Body {
		if clause.Cases == nil {
			defaultClause = clause
			break
		}
	}
	var defaultBlock *SSABasicBlock
	if defaultClause != nil {
		defaultBlock = fb.newBlock("switch.default")
	}

	for _, clause := range s.Body {
		if clause.Cases == nil {
			continue
		}
		caseBlock := fb.newBlock("switch.case")
		nextBlock := fb.newBlock("switch.next")

		if clause.Cases != nil && tag != nil {
			var cond SSAValue
			caseExprs := []syntax.Expr{clause.Cases}
			if list, ok := clause.Cases.(*syntax.ListExpr); ok {
				caseExprs = list.ElemList
			}
			for _, ce := range caseExprs {
				caseVal := fb.buildExpr(ce)
				// Fold constant string comparisons at SSA build time.
				if tc, ok1 := tag.(*SSAConst); ok1 {
					if cc, ok2 := caseVal.(*SSAConst); ok2 {
						eq := ssaConstEqual(tc, cc)
						boolConst := &SSAConst{typ: Typ[Bool], val: &ConstBool{V: eq}}
						if cond == nil {
							cond = boolConst
						} else {
							// OR with previous: true || x = true, false || x = x
							if pc, ok3 := cond.(*SSAConst); ok3 {
								if pb, ok4 := pc.val.(*ConstBool); ok4 {
									if pb.V {
										cond = pc // already true
									} else {
										cond = boolConst
									}
								} else {
									cond = boolConst
								}
							} else {
								orOp := &SSABinOp{Op: OpLor, X: cond, Y: boolConst}
								orOp.typ = Typ[Bool]
								orOp.name = fb.nextName()
								fb.emit(orOp)
								cond = orOp
							}
						}
						continue
					}
				}
				cmp := &SSABinOp{Op: OpEql, X: tag, Y: caseVal}
				cmp.typ = Typ[Bool]
				cmp.name = fb.nextName()
				fb.emit(cmp)
				if cond == nil {
					cond = cmp
				} else {
					orOp := &SSABinOp{Op: OpLor, X: cond, Y: cmp}
					orOp.typ = Typ[Bool]
					orOp.name = fb.nextName()
					fb.emit(orOp)
					cond = orOp
				}
			}
			// If cond folded to a constant, emit unconditional branch.
			if cc, ok := cond.(*SSAConst); ok {
				if cb, ok2 := cc.val.(*ConstBool); ok2 {
					if cb.V {
						fb.emit(&SSAJump{Comment: "switch.const.true"})
						fb.pushSucc(fb.currentBlock, caseBlock)
						fb.pushPred(caseBlock, fb.currentBlock)
					} else {
						fb.emit(&SSAJump{Comment: "switch.const.false"})
						fb.pushSucc(fb.currentBlock, nextBlock)
						fb.pushPred(nextBlock, fb.currentBlock)
					}
				} else {
					fb.emit(&SSAIf{Cond: cond})
					fb.pushSucc(fb.currentBlock, caseBlock)
					fb.pushSucc(fb.currentBlock, nextBlock)
					fb.pushPred(caseBlock, fb.currentBlock)
					fb.pushPred(nextBlock, fb.currentBlock)
				}
			} else {
				fb.emit(&SSAIf{Cond: cond})
				fb.pushSucc(fb.currentBlock, caseBlock)
				fb.pushSucc(fb.currentBlock, nextBlock)
				fb.pushPred(caseBlock, fb.currentBlock)
				fb.pushPred(nextBlock, fb.currentBlock)
			}
		} else if clause.Cases != nil && tag == nil {
			// Tagless switch: comma-separated cases are OR'd.
			caseExprs := []syntax.Expr{clause.Cases}
			if list, ok := clause.Cases.(*syntax.ListExpr); ok {
				caseExprs = list.ElemList
			}
			var cond SSAValue
			for _, ce := range caseExprs {
				cv := fb.buildExpr(ce)
				if cond == nil {
					cond = cv
				} else {
					orOp := &SSABinOp{Op: OpLor, X: cond, Y: cv}
					orOp.typ = Typ[Bool]
					orOp.name = fb.nextName()
					fb.emit(orOp)
					cond = orOp
				}
			}
			fb.emit(&SSAIf{Cond: cond})
			fb.pushSucc(fb.currentBlock, caseBlock)
			fb.pushSucc(fb.currentBlock, nextBlock)
			fb.pushPred(caseBlock, fb.currentBlock)
			fb.pushPred(nextBlock, fb.currentBlock)
		} else {
			fb.emit(&SSAJump{Comment: "switch.case"})
			fb.pushSucc(fb.currentBlock, caseBlock)
			fb.pushPred(caseBlock, fb.currentBlock)
		}

		caseScope := fb.enterBlock()
		fb.currentBlock = caseBlock
		for _, stmt := range clause.Body {
			fb.buildStmt(stmt)
			if fb.currentBlock == nil {
				break
			}
		}
		if fb.currentBlock != nil && !fb.blockTerminated(fb.currentBlock) {
			fb.emit(&SSAJump{Comment: "switch.done"})
			fb.pushSucc(fb.currentBlock, doneBlock)
			fb.pushPred(doneBlock, fb.currentBlock)
		}
		fb.exitBlock(caseScope)
		fb.currentBlock = nextBlock
	}

	if defaultClause != nil {
		// The fallthrough of the last case test reaches the default body.
		if fb.currentBlock != nil {
			fb.emit(&SSAJump{Comment: "switch.default"})
			fb.pushSucc(fb.currentBlock, defaultBlock)
			fb.pushPred(defaultBlock, fb.currentBlock)
		}
		defaultScope := fb.enterBlock()
		fb.currentBlock = defaultBlock
		for _, stmt := range defaultClause.Body {
			fb.buildStmt(stmt)
			if fb.currentBlock == nil {
				break
			}
		}
		if fb.currentBlock != nil && !fb.blockTerminated(fb.currentBlock) {
			fb.emit(&SSAJump{Comment: "switch.done"})
			fb.pushSucc(fb.currentBlock, doneBlock)
			fb.pushPred(doneBlock, fb.currentBlock)
		}
		fb.exitBlock(defaultScope)
	} else if fb.currentBlock != nil {
		fb.emit(&SSAJump{Comment: "switch.done"})
		fb.pushSucc(fb.currentBlock, doneBlock)
		fb.pushPred(doneBlock, fb.currentBlock)
	}

	fb.loops = savedLoops
	fb.currentBlock = doneBlock
	fb.exitBlock(switchScope)
}

func (fb *ssaFuncBuilder) buildTypeSwitch(s *syntax.SwitchStmt, tsg *syntax.TypeSwitchGuard, doneBlock *SSABasicBlock) {
	x := fb.buildExpr(tsg.X)
	var savedObj Object
	var savedAlloc *SSAAlloc
	if tsg.Lhs != nil {
		for obj, alloc := range fb.vars {
			if ObjectName(obj) == tsg.Lhs.Value {
				savedObj = obj
				savedAlloc = alloc
				break
			}
		}
	}
	for _, clause := range s.Body {
		caseBlock := fb.newBlock("typeswitch.case")
		nextBlock := fb.newBlock("typeswitch.next")

		if clause.Cases != nil {
			caseExprs := []syntax.Expr{clause.Cases}
			if list, ok := clause.Cases.(*syntax.ListExpr); ok {
				caseExprs = list.ElemList
			}

			var cond SSAValue
			var firstTA *SSATypeAssert
			var firstType Type
			for _, ce := range caseExprs {
				if n, isName := ce.(*syntax.Name); isName && n.Value == "nil" {
					nilType := x.SSAType()
					if nilType == nil {
						nilType = NewTCInterface(nil, nil)
					}
					nilCheck := &SSABinOp{Op: OpEql, X: x, Y: &SSAConst{typ: nilType, val: nil}}
					nilCheck.typ = Typ[Bool]
					nilCheck.name = fb.nextName()
					fb.emit(nilCheck)
					if cond == nil {
						cond = nilCheck
					} else {
						orOp := &SSABinOp{Op: OpLor, X: cond, Y: nilCheck}
						orOp.typ = Typ[Bool]
						orOp.name = fb.nextName()
						fb.emit(orOp)
						cond = orOp
					}
					continue
				}
				var assertedType Type
				if fb.info != nil {
					tv := fb.info.Types[ce]
					assertedType = tv.Type
				}
				if assertedType == nil {
					assertedType = fb.resolveType(ce)
				}
				if assertedType == nil {
					assertedType = Typ[Invalid]
				}
				ta := &SSATypeAssert{X: x, AssertedType: assertedType, CommaOk: true}
				ta.typ = NewTuple(
					NewTCVar(nil, "val", assertedType),
					NewTCVar(nil, "ok", Typ[Bool]),
				)
				ta.name = fb.nextName()
				fb.emit(ta)
				okExt := &SSAExtract{Tuple: ta, Index: 1}
				okExt.typ = Typ[Bool]
				okExt.name = fb.nextName()
				fb.emit(okExt)
				if firstTA == nil {
					firstTA = ta
					firstType = assertedType
				}
				if cond == nil {
					cond = okExt
				} else {
					orOp := &SSABinOp{Op: OpLor, X: cond, Y: okExt}
					orOp.typ = Typ[Bool]
					orOp.name = fb.nextName()
					fb.emit(orOp)
					cond = orOp
				}
			}
			fb.emit(&SSAIf{Cond: cond})
			fb.pushSucc(fb.currentBlock, caseBlock)
			fb.pushSucc(fb.currentBlock, nextBlock)
			fb.pushPred(caseBlock, fb.currentBlock)
			fb.pushPred(nextBlock, fb.currentBlock)

			fb.currentBlock = caseBlock
			if tsg.Lhs != nil {
				var guardVal SSAValue
				var guardType Type
				if firstTA != nil {
					ext := &SSAExtract{Tuple: firstTA, Index: 0}
					ext.typ = firstType
					ext.name = fb.nextName()
					fb.emit(ext)
					guardVal = ext
					guardType = firstType
				} else {
					guardType = x.SSAType()
					if guardType == nil {
						guardType = NewTCInterface(nil, nil)
					}
					guardVal = &SSAConst{typ: guardType, val: nil}
				}
				for old := range fb.vars {
					if ObjectName(old) == tsg.Lhs.Value {
						delete(fb.vars, old)
						break
					}
				}
				obj := NewTCVar(fb.fn.Pkg.Pkg, tsg.Lhs.Value, guardType)
				alloc := fb.emitAlloc(guardType, 0)
				fb.vars[obj] = alloc
				fb.emitStore(alloc, guardVal)
			}
		} else {
			fb.emit(&SSAJump{Comment: "typeswitch.case"})
			fb.pushSucc(fb.currentBlock, caseBlock)
			fb.pushPred(caseBlock, fb.currentBlock)
			fb.currentBlock = caseBlock
			if tsg.Lhs != nil {
				guardType := x.SSAType()
				if guardType == nil {
					guardType = NewTCInterface(nil, nil)
				}
				for old := range fb.vars {
					if ObjectName(old) == tsg.Lhs.Value {
						delete(fb.vars, old)
						break
					}
				}
				obj := NewTCVar(fb.fn.Pkg.Pkg, tsg.Lhs.Value, guardType)
				alloc := fb.emitAlloc(guardType, 0)
				fb.vars[obj] = alloc
				fb.emitStore(alloc, x)
			}
		}

		tsScope := fb.enterBlock()
		for _, stmt := range clause.Body {
			fb.buildStmt(stmt)
			if fb.currentBlock == nil {
				break
			}
		}
		if fb.currentBlock != nil && !fb.blockTerminated(fb.currentBlock) {
			fb.emit(&SSAJump{Comment: "switch.done"})
			fb.pushSucc(fb.currentBlock, doneBlock)
			fb.pushPred(doneBlock, fb.currentBlock)
		}
		fb.exitBlock(tsScope)
		fb.currentBlock = nextBlock
	}
	if savedObj != nil && savedAlloc != nil {
		for old := range fb.vars {
			if ObjectName(old) == tsg.Lhs.Value {
				delete(fb.vars, old)
				break
			}
		}
		fb.vars[savedObj] = savedAlloc
	}
	if fb.currentBlock != nil {
		fb.emit(&SSAJump{Comment: "switch.done"})
		fb.pushSucc(fb.currentBlock, doneBlock)
		fb.pushPred(doneBlock, fb.currentBlock)
	}
}

func (fb *ssaFuncBuilder) buildSelect(s *syntax.SelectStmt) {
	doneBlock := fb.newBlock("select.done")

	var states []*SSASelectState
	caseBlocks := [](*SSABasicBlock){:0:len(s.Body)}
	for i, clause := range s.Body {
		cb := fb.newBlock("select.case")
		caseBlocks = mxutil.Ensure(caseBlocks, 1)
		push(caseBlocks, cb)
		state := &SSASelectState{}
		if clause.Comm != nil {
			switch comm := clause.Comm.(type) {
			case *syntax.SendStmt:
				state.Dir = SelectDirSend
				state.Chan = fb.buildExpr(comm.Chan)
				state.Send = fb.buildExpr(comm.Value)
				// Same context rule as a plain send: the channel's ELEMENT
				// type governs, so a send of *T into an interface-element
				// channel must box. This is the one that blocked net/http's
				//   case sc.serveMsgCh <- msg:
				// where serveMsgCh is a chan http2serveMsg and msg is a
				// *http2startPushRequest: the raw pointer was stored into the
				// interface's 2-word slot.
				if state.Chan != nil && state.Send != nil {
					if ce, isChan := SafeUnderlying(state.Chan.SSAType()).(*TCChan); isChan && ce != nil && ce.Elem != nil {
						state.Send = fb.coerceSendValue(state.Send, ce.Elem)
					}
				}
			case *syntax.AssignStmt:
				var chanExpr syntax.Expr
				if op, ok2 := comm.Rhs.(*syntax.Operation); ok2 && op.Y == nil && op.Op == token.Recv {
					chanExpr = op.X
				}
				if chanExpr != nil {
					state.Dir = SelectDirRecv
					state.Chan = fb.buildExpr(chanExpr)
				}
			case *syntax.ExprStmt:
				if op, ok2 := comm.X.(*syntax.Operation); ok2 && op.Y == nil && op.Op == token.Recv {
					state.Dir = SelectDirRecv
					state.Chan = fb.buildExpr(op.X)
				}
			}
		}
		states = mxutil.Ensure(states, 1)
		push(states, state)
		_ = i
	}

	// Build tuple type with recv element types.
	tupleVars := []*TCVar{
		NewTCVar(nil, "index", Typ[Int32]),
		NewTCVar(nil, "recvOk", Typ[Bool]),
	}
	recvFieldIdx := int32(2) // first recv value in tuple
	for _, st := range states {
		if st.Dir == SelectDirRecv && st.Chan != nil {
			elemType := ssaChanElemType(st.Chan.SSAType())
			tupleVars = mxutil.Ensure(tupleVars, 1)
			push(tupleVars, NewTCVar(nil, "recv", elemType))
		}
	}
	hasDefault := false
	for _, clause := range s.Body {
		if clause.Comm == nil {
			hasDefault = true
			break
		}
	}
	sel := &SSASelect{States: states, Blocking: !hasDefault}
	sel.typ = &Tuple{Vars: tupleVars}
	sel.name = fb.nextName()
	fb.emit(sel)

	// A select with no clauses needs no dispatch, and its block still needs a
	// terminator: without the jump the emitted block fell through into the next
	// one with no branch, which clang rejects ("expected instruction opcode").
	// This is legacy's shortcut for len(States) == 0, where the blocking form
	// blocks forever (the runtime reports a deadlock) and the default form does
	// nothing. The deadlock call itself is emitted for the select node, which
	// carries Blocking.
	if len(s.Body) == 0 {
		fb.emit(&SSAJump{Comment: "select.done"})
		fb.pushSucc(fb.currentBlock, doneBlock)
		fb.pushPred(doneBlock, fb.currentBlock)
		fb.currentBlock = doneBlock
		return
	}

	// Extract index from select result.
	idxExt := &SSAExtract{Tuple: sel, Index: 0}
	idxExt.typ = Typ[Int32]
	idxExt.name = fb.nextName()
	fb.emit(idxExt)

	// Build if/else chain: if index == 0 -> case0, elif index == 1 -> case1, ...
	entryBlock := fb.currentBlock
	for i := int32(0); i < int32(len(s.Body)); i++ {
		if i == int32(len(s.Body))-1 {
			// Last case: unconditional jump.
			fb.emit(&SSAJump{Comment: "select.last"})
			fb.pushSucc(entryBlock, caseBlocks[i])
			fb.pushPred(caseBlocks[i], entryBlock)
			break
		}
		nextCheck := fb.newBlock("select.check")
		cmpVal := &SSAConst{typ: Typ[Int32], val: &ConstInt{V:int64(i)}}
		cmp := &SSABinOp{Op: OpEql, X: idxExt, Y: cmpVal}
		cmp.typ = Typ[Bool]
		cmp.name = fb.nextName()
		fb.emit(cmp)
		fb.emit(&SSAIf{Cond: cmp})
		fb.pushSucc(entryBlock, caseBlocks[i])
		fb.pushPred(caseBlocks[i], entryBlock)
		fb.pushSucc(entryBlock, nextCheck)
		fb.pushPred(nextCheck, entryBlock)
		fb.currentBlock = nextCheck
		entryBlock = nextCheck
	}

	// Build case bodies.
	recvIdx := recvFieldIdx
	for i, clause := range s.Body {
		selScope := fb.enterBlock()
		fb.currentBlock = caseBlocks[i]

		// For recv cases, extract the received value from the select tuple
		// and bind it to the variable (don't re-do chanRecv).
		if clause.Comm != nil && states[i].Dir == SelectDirRecv {
			switch comm := clause.Comm.(type) {
			case *syntax.AssignStmt:
				// v := <-ch, v = <-ch, or the comma-ok pair `ev, ok := <-ch`.
				// The pair takes the value from this case's receive slot and ok
				// from the select tuple's recvOk slot (index 1). Binding both
				// names to the received value gave `ok` the element's type, so
				// `if !ok` negated a pointer - `xor ptr %t, -1` - and clang
				// refused the module, which is how pkg/nostr/ws failed to build.
				names := ssaExprNames(comm.Lhs)
				// TWO names is the comma-ok pair, whether the statement
				// defines or assigns. Requiring token.Def made the assignment
				// form (`case incoming, ok = <-ch:`, which net's fakeConnect
				// uses because ok is declared before the select) bind the
				// received []*netFD to the bool `ok` and report "cannot use
				// value of type []*net.netFD as bool in assignment" - the last
				// error blocking net/http for wasm.
				pair := len(names) == 2
				for ni := int32(0); ni < int32(len(names)); ni++ {
					name := names[ni]
					if name.Value == "_" {
						continue
					}
					ext := &SSAExtract{Tuple: sel, Index: recvIdx}
					ext.typ = ssaChanElemType(states[i].Chan.SSAType())
					if pair && ni == 1 {
						ext.Index = 1 // recvOk
						ext.typ = Typ[Bool]
					}
					ext.name = fb.nextName()
					fb.emit(ext)
					if comm.Op == token.Def {
						fb.removeVar(name.Value)
						obj := NewTCVar(fb.fn.Pkg.Pkg, name.Value, ext.typ)
						alloc := fb.emitAlloc(ext.typ, 0)
						fb.vars[obj] = alloc
						fb.emitStore(alloc, ext)
					} else {
						fb.buildStore(name, ext)
					}
				}
			}
			recvIdx++
		}
		// For send cases, the send was already done by chanSelect. Skip comm.

		for _, stmt := range clause.Body {
			fb.buildStmt(stmt)
			if fb.currentBlock == nil {
				break
			}
		}
		if fb.currentBlock != nil && !fb.blockTerminated(fb.currentBlock) {
			fb.emit(&SSAJump{Comment: "select.done"})
			fb.pushSucc(fb.currentBlock, doneBlock)
			fb.pushPred(doneBlock, fb.currentBlock)
		}
		fb.exitBlock(selScope)
	}

	fb.currentBlock = doneBlock
}

func (fb *ssaFuncBuilder) isSelfTailCall(e syntax.Expr) (ce *syntax.CallExpr, found bool) {
	call, ok := e.(*syntax.CallExpr)
	if !ok || fb.tailBlock == nil || fb.deferred > 0 {
		return nil, false
	}
	name, ok := call.Fun.(*syntax.Name)
	if !ok {
		return nil, false
	}
	obj := fb.lookupObject(name.Value)
	if obj == nil {
		return nil, false
	}
	tc, ok := obj.(*TCFunc)
	if !ok || tc == nil {
		return nil, false
	}
	fn, _ := fb.fn.Pkg.Members[name.Value].(*SSAFunction)
	if fn != fb.fn {
		return nil, false
	}
	return call, true
}

func (fb *ssaFuncBuilder) buildReturn(s *syntax.ReturnStmt) {
	if s.Results != nil {
		if call, ok := fb.isSelfTailCall(s.Results); ok {
			args := fb.buildArgs(call.ArgList)
			if len(args) == len(fb.paramAllocas) {
				for i, arg := range args {
					fb.emitStore(fb.paramAllocas[i], arg)
				}
				fb.emit(&SSAJump{Comment: "tailcall"})
				fb.pushSucc(fb.currentBlock, fb.tailBlock)
				fb.pushPred(fb.tailBlock, fb.currentBlock)
				fb.currentBlock = nil
				return
			}
		}
	}
	var vals []SSAValue
	if s.Results != nil {
		if list, ok := s.Results.(*syntax.ListExpr); ok {
			for i, el := range list.ElemList {
				v := fb.buildExpr(el)
				if v != nil {
					vals = mxutil.Ensure(vals, 1)
					push(vals, v)
				} else {
					var zeroType Type
					if fb.fn.Signature != nil && fb.fn.Signature.Results != nil && int32(i) < int32(fb.fn.Signature.Results.Len()) {
						zeroType = fb.fn.Signature.Results.At(int32(i)).Typ
					}
					vals = mxutil.Ensure(vals, 1)
					push(vals, &SSAConst{typ: zeroType, val: nil})
				}
			}
		} else {
			v := fb.buildExpr(s.Results)
			if v != nil {
				if v.SSAType() == nil {
					vals = mxutil.Ensure(vals, 1)
					push(vals, v)
				} else if tup, ok2 := v.SSAType().(*Tuple); ok2 && tup.Len() > 1 {
					for i := 0; i < tup.Len(); i++ {
						ext := &SSAExtract{Tuple: v, Index: i}
						ext.typ = tup.At(i).Typ
						ext.name = fb.nextName()
						fb.emit(ext)
						vals = mxutil.Ensure(vals, 1)
						push(vals, ext)
					}
				} else {
					vals = mxutil.Ensure(vals, 1)
					push(vals, v)
				}
			}
		}
	} else if len(fb.namedResults) > 0 {
		// A bare `return` in a function with named results: the values are
		// POSITIONED by the signature, not by the named list. NamedResults holds
		// only the NAMED results, so `func f() (_ error, err error)` has ONE
		// entry for TWO results; pushing just that entry made a one-element
		// SSAReturn, the exit serialiser decomposed the single interface across
		// both slots, and its TYPE word went to the codec as the first result:
		//   '%cext769' defined with type 'i64' but expected '{ i64, ptr }'
		//   store { i64, ptr } %cext769, ptr %cet770
		// A blank result occupies its position as the zero of its type and the
		// named results fill the rest in order - the same alignment the implicit
		// return at the end of a body uses. x/tools does this for legacy: its
		// Function.results has one entry per result SLOT, blanks included.
		nj := 0
		if fb.fn.Signature != nil && fb.fn.Signature.Results != nil {
			for i := int32(0); i < fb.fn.Signature.Results.Len(); i++ {
				res := fb.fn.Signature.Results.At(i)
				if res == nil {
					continue
				}
				if res.Name == "" || res.Name == "_" {
					vals = mxutil.Ensure(vals, 1)
					push(vals, &SSAConst{typ: res.Typ, val: nil})
					continue
				}
				if nj >= len(fb.namedResults) {
					break
				}
				nr := fb.namedResults[nj]
				nj++
				elemType := nr.SSAType()
				if p, ok := elemType.(*Pointer); ok {
					elemType = p.Base
				}
				vals = mxutil.Ensure(vals, 1)
				push(vals, fb.emitLoad(nr, elemType))
			}
		} else {
			for _, nr := range fb.namedResults {
				elemType := nr.SSAType()
				if p, ok := elemType.(*Pointer); ok {
					elemType = p.Base
				}
				vals = mxutil.Ensure(vals, 1)
				push(vals, fb.emitLoad(nr, elemType))
			}
		}
	}
	if fb.fn.Signature != nil && fb.fn.Signature.Results != nil {
		for i, v := range vals {
			if i < fb.fn.Signature.Results.Len() {
				retType := fb.fn.Signature.Results.At(i).Typ
				// The result type is the shift's context, so `return 1 << n`
				// from a uint64 function is a 64-bit shift.
				if bin, okB := v.(*SSABinOp); okB && bin.untypedShift {
					retypeUntypedShift(bin, retType)
				}
				fb.checkAssignable(v, retType, "return statement")
				if n, ok := retType.(*Named); ok && n != nil {
					u := n.Underlying()
					if u != nil && u != Type(n) {
						if _, isIface := u.(*TCInterface); isIface {
							if _, alreadyIface := SafeUnderlying(v.SSAType()).(*TCInterface); !alreadyIface {
								mi := &SSAMakeInterface{X: v, IType: retType}
								mi.typ = retType
								mi.name = fb.nextName()
								fb.emit(mi)
								vals[i] = mi
								continue
							}
						}
					}
				}
				vals[i] = fb.coerceToInterface(v, retType)
			}
		}
	}
	fb.emitReturn(vals, 0)
}

func (fb *ssaFuncBuilder) buildBranch(s *syntax.BranchStmt) {
	if fb.currentBlock == nil {
		return
	}
	switch s.Tok {
	case token.Break:
		if len(fb.loops) > 0 {
			var doneBlock *SSABasicBlock
			if s.Label != nil {
				for i := len(fb.loops) - 1; i >= 0; i-- {
					if fb.loops[i].label == s.Label.Value {
						doneBlock = fb.loops[i].done
						break
					}
				}
			}
			if doneBlock == nil {
				doneBlock = fb.loops[len(fb.loops)-1].done
			}
			if doneBlock != nil {
				fb.emit(&SSAJump{Comment: "break"})
				fb.pushSucc(fb.currentBlock, doneBlock)
				fb.pushPred(doneBlock, fb.currentBlock)
				fb.currentBlock = nil
			}
		}
	case token.Continue:
		// A labelled continue targets the loop that owns the label, and the
		// jump must skip the post statements of every loop inside it: a post
		// statement runs on the way round its own loop and on no other. The
		// label used to be ignored, so `continue outer` continued the
		// innermost loop and ran one extra post - fmt's verb scanner then read
		// the format string one byte ahead and printed a phantom `%!(NOVERB)`
		// after every formatted value.
		var postBlock *SSABasicBlock
		if s.Label != nil {
			for i := len(fb.loops) - 1; i >= 0; i-- {
				if fb.loops[i].label == s.Label.Value {
					postBlock = fb.loops[i].post
					if postBlock == nil {
						postBlock = fb.loops[i].body
					}
					break
				}
			}
		} else {
			for i := len(fb.loops) - 1; i >= 0; i-- {
				postBlock = fb.loops[i].post
				if postBlock == nil {
					postBlock = fb.loops[i].body
				}
				if postBlock != nil {
					break
				}
			}
		}
		if postBlock != nil {
			fb.emit(&SSAJump{Comment: "continue"})
			fb.pushSucc(fb.currentBlock, postBlock)
			fb.pushPred(postBlock, fb.currentBlock)
			fb.currentBlock = nil
		}
	case token.Goto:
		if s.Label != nil {
			target := fb.labelBlock(s.Label.Value)
			if target != nil {
				fb.emit(&SSAJump{Comment: "goto"})
				fb.pushSucc(fb.currentBlock, target)
				fb.pushPred(target, fb.currentBlock)
				fb.currentBlock = nil
			}
		}
	case token.Return:
		fb.emitReturn(nil, 0)
	}
}

// buildDeferStmt lowers `defer call`.
//
// A deferred method call goes through a thunk whose first parameter is the
// receiver, the way legacy lowers it: the receiver travels as an argument on
// the defer record, so `defer f.Close()` stays legal while `x := f.Close` is a
// capture and is rejected. Building a bound method value here instead (a) made
// a legal defer look like a capture to checkClosureCaptures and (b) could not
// serve an interface receiver at all, because that call is an invoke, which is
// an instruction rather than a value - `defer i.M()` was dropped in silence.
func (fb *ssaFuncBuilder) buildDeferStmt(call *syntax.CallExpr) {
	if sel, ok := call.Fun.(*syntax.SelectorExpr); ok {
		if target, allArgs := fb.buildDeferMethodTarget(sel, call.ArgList, call.HasDots); target != nil {
			deferred := &SSADefer{Call: SSACallCommon{Value: target, Args: allArgs}}
			fb.emit(deferred)
			fb.deferred++
			return
		}
	}
	fn := fb.buildExpr(call.Fun)
	if fn == nil {
		return
	}
	args := fb.buildArgs(call.ArgList)
	d := &SSADefer{Call: SSACallCommon{Value: fn, Args: args}}
	fb.emit(d)
	fb.deferred++
}

// buildDeferMethodTarget resolves `recv.M(...)` for a deferred call into the
// thunk to run plus its arguments, receiver first. A nil target means the
// selector is not a method call (a package-qualified function, or a function
// stored in a field) and the generic path should evaluate it; the speculative
// receiver and argument instructions are rolled back first so the expression
// is evaluated exactly once.
func (fb *ssaFuncBuilder) buildDeferMethodTarget(sel *syntax.SelectorExpr, argExprs []syntax.Expr, hasDots bool) (target SSAValue, allArgs []SSAValue) {
	if name, ok := sel.X.(*syntax.Name); ok {
		if _, isPkg := fb.lookupObject(name.Value).(*PkgName); isPkg {
			return nil, nil
		}
	}
	block := fb.currentBlock
	recvMark := int32(0)
	if block != nil {
		recvMark = len(block.Instrs)
	}
	recvCounter := fb.counter
	recv := fb.buildExpr(sel.X)
	if recv != nil && recv.SSAType() != nil {
		mfn, fixedRecv := fb.resolveMethodCallWithRecv(sel, recv)
		if mfn != nil && mfn.Signature != nil {
			// A pointer-receiver method needs the operand's address, not a
			// loaded copy: discard the value instructions and rebuild it as an
			// address, exactly as buildCall does for a direct method call. The
			// arguments are built after that rollback, so no live value is
			// left pointing at a discarded instruction.
			//
			// The test is against `recv`, the operand that was just built, NOT
			// against fixedRecv: resolveMethodCallWithRecv has usually already
			// taken the address, so asking it about its own result can never
			// report "a value where a pointer is wanted" and the discarded
			// value survived as dead IR. See the same note in buildCall.
			if fb.methodNeedsAddr(mfn, recv) {
				if block != nil {
					block.Instrs = block.Instrs[:recvMark]
				}
				fb.counter = recvCounter
				if addr := fb.buildOperandAddr(sel.X); addr != nil {
					fixedRecv = addr
				}
			}
			fixedRecv = fb.derefValueRecv(mfn, fixedRecv)
			args := fb.buildArgs(argExprs)
			fb.checkCallArgs(args, mfn.Signature, hasDots)
			if mfn.Signature.Variadic && !hasDots {
				args = fb.wrapVariadicArgs(args, mfn.Signature)
			}
			args = fb.coerceArgsToInterface(args, mfn.Signature)
			thunk := fb.buildDeferThunk(mfn, nil, "", fixedRecv.SSAType(), args, mfn.Signature)
			return thunk, prependValue(fixedRecv, args)
		}
		if iface, msig := ifaceMethodOf(recv, sel.Sel.Value); iface != nil && msig != nil {
			args := fb.buildArgs(argExprs)
			fb.checkCallArgs(args, msig, hasDots)
			if msig.Variadic && !hasDots {
				args = fb.wrapVariadicArgs(args, msig)
			}
			args = fb.coerceArgsToInterface(args, msig)
			thunk := fb.buildDeferThunk(nil, iface, sel.Sel.Value, recv.SSAType(), args, msig)
			return thunk, prependValue(recv, args)
		}
	}
	if block != nil {
		block.Instrs = block.Instrs[:recvMark]
	}
	fb.counter = recvCounter
	return nil, nil
}

func prependValue(first SSAValue, rest []SSAValue) (all []SSAValue) {
	all = []SSAValue{:0:len(rest) + 1}
	push(all, first)
	for _, r := range rest {
		push(all, r)
	}
	return all
}

// ifaceMethodOf resolves methodName on the interface recv is typed as,
// unwrapping a pointer to the interface. Returns nil for a concrete receiver.
func ifaceMethodOf(recv SSAValue, methodName string) (iface *TCInterface, sig *Signature) {
	typ := recv.SSAType()
	if p7, ok := SafeUnderlying(typ).(*Pointer); ok {
		typ = p7.Base
	}
	ifc, ok2 := SafeUnderlying(typ).(*TCInterface)
	if !ok2 {
		return nil, nil
	}
	for k := int32(0); k < ifc.NumMethods(); k++ {
		m := ifc.Method(k)
		if m == nil {
			continue
		}
		if m.Name == methodName {
			return ifc, m.Sig
		}
	}
	return ifc, nil
}

// buildDeferThunk creates the function a deferred method call runs: parameter 0
// is the receiver and the rest are the call's arguments, so it captures
// nothing. With mfn non-nil the body is a direct call to it; otherwise the body
// invokes methodName on the interface in parameter 0.
func (fb *ssaFuncBuilder) buildDeferThunk(mfn *SSAFunction, iface *TCInterface, methodName string, recvType Type, argVals []SSAValue, sig *Signature) (t *SSAFunction) {
	recvVar := &TCVar{Name: "recv", Typ: recvType}
	var params *Tuple
	{
		vars := []*TCVar{:0:len(argVals) + 1}
		push(vars, recvVar)
		for i := int32(0); i < int32(len(argVals)); i++ {
			vars = mxutil.Ensure(vars, 1)
			push(vars, &TCVar{Name: "a" | ssaItoa(i), Typ: argVals[i].SSAType()})
		}
		params = NewTuple(vars...)
	}
	var results *Tuple
	if sig != nil {
		results = sig.Results
	}
	thunk := &SSAFunction{
		name:      fb.fn.name | "__dthunk" | ssaItoa(len(fb.fn.AnonFuncs)+1),
		Signature: NewSignature(nil, params, results, false),
		Pkg:       fb.fn.Pkg,
		Prog:      fb.fn.Prog,
		parent:    fb.fn,
	}
	fb.fn.AnonFuncs = mxutil.Ensure(fb.fn.AnonFuncs, 1)
	push(fb.fn.AnonFuncs, thunk)
	recvParam := &SSAParameter{name: "recv", typ: recvType, parent: thunk}
	thunk.Params = mxutil.Ensure(thunk.Params, 1)
	push(thunk.Params, recvParam)
	for i := int32(0); i < int32(len(argVals)); i++ {
		p := &SSAParameter{name: "a" | ssaItoa(i), typ: argVals[i].SSAType(), parent: thunk}
		thunk.Params = mxutil.Ensure(thunk.Params, 1)
		push(thunk.Params, p)
	}
	entry := NewSSABasicBlock(thunk, "entry")
	var retType Type
	if results != nil && results.Len() == 1 {
		retType = results.At(0).Typ
	} else if results != nil && results.Len() > 1 {
		retType = results
	}
	var body SSAValue
	if mfn != nil {
		callArgs := []SSAValue{:0:len(thunk.Params)}
		for _, p := range thunk.Params {
			push(callArgs, p)
		}
		call := &SSACall{Call: SSACallCommon{Value: mfn, Args: callArgs}}
		call.typ = retType
		call.name = "t1"
		call.setBlock(entry)
		entry.Instrs = mxutil.Ensure(entry.Instrs, 1)
		push(entry.Instrs, call)
		body = call
	} else {
		invArgs := []SSAValue{:0:len(thunk.Params) - 1}
		for i := int32(1); i < int32(len(thunk.Params)); i++ {
			push(invArgs, thunk.Params[i])
		}
		inv := &SSAInvoke{X: recvParam, MethodName: methodName, IfaceType: iface, Args: invArgs}
		inv.typ = retType
		inv.name = "t1"
		inv.setBlock(entry)
		entry.Instrs = mxutil.Ensure(entry.Instrs, 1)
		push(entry.Instrs, inv)
		body = inv
	}
	ret := &SSAReturn{}
	if retType != nil {
		ret.Results = []SSAValue{body}
	}
	ret.setBlock(entry)
	entry.Instrs = mxutil.Ensure(entry.Instrs, 1)
	push(entry.Instrs, ret)
	return thunk
}

// Expression builders.

func (fb *ssaFuncBuilder) buildExpr(e syntax.Expr) (s SSAValue) {
	if e == nil || fb.currentBlock == nil {
		return nil
	}
	switch ev := e.(type) {
	case *syntax.Name:
		return fb.buildIdent(ev)
	case *syntax.BasicLit:
		return fb.buildLit(ev)
	case *syntax.Operation:
		return fb.buildOperation(ev)
	case *syntax.CallExpr:
		return fb.buildCall(ev)
	case *syntax.SelectorExpr:
		return fb.buildSelector(ev)
	case *syntax.IndexExpr:
		return fb.buildIndex(ev)
	case *syntax.SliceExpr:
		return fb.buildSlice(ev)
	case *syntax.AssertExpr:
		return fb.buildAssert(ev)
	case *syntax.CompositeLit:
		return fb.buildCompositeLit(ev)
	case *syntax.FuncLit:
		return fb.buildFuncLit(ev)
	case *syntax.ParenExpr:
		return fb.buildExpr(ev.X)
	case *syntax.ListExpr:
		var last SSAValue
		for _, el := range ev.ElemList {
			last = fb.buildExpr(el)
		}
		return last
	case *syntax.KeyValueExpr:
		return fb.buildExpr(ev.Value)
	}
	return nil
}

func (fb *ssaFuncBuilder) buildIdent(e *syntax.Name) (s SSAValue) {
	if e.Value == "_" || e.Value == "nil" {
		return &SSAConst{typ: nil, val: nil}
	}
	if fb.localConsts != nil {
		if c, ok := fb.localConsts[e.Value]; ok {
			return c
		}
	}
	// Local constants of enclosing functions are compile-time values, not
	// captured state: a closure may read them without an explicit parameter.
	for p := fb.parent; p != nil; p = p.parent {
		if p.localConsts != nil {
			if c, ok := p.localConsts[e.Value]; ok {
				return c
			}
		}
	}
	obj := fb.lookupObject(e.Value)
	if obj == nil && fb.info != nil {
		obj = fb.info.Uses[e]
	}
	if obj == nil && fb.parent != nil {
		for p := fb.parent; p != nil; p = p.parent {
			for pobj := range p.vars {
				if ObjectName(pobj) == e.Value {
					fv := fb.getOrCreateFreeVar(e.Value, ObjectType(pobj))
					return fb.emitLoad(fv, ObjectType(pobj))
				}
			}
			if p.freeVarPtrs != nil {
				if pfv, ok := p.freeVarPtrs[e.Value]; ok {
					fv := fb.getOrCreateFreeVar(e.Value, pfv.typ)
					return fb.emitLoad(fv, pfv.typ)
				}
			}
		}
	}
	if obj == nil {
		if fb.fn.Pkg != nil {
			if fn, ok := fb.fn.Pkg.Members[e.Value].(*SSAFunction); ok {
				return fn
			}
			if g, ok := fb.fn.Pkg.Members[e.Value].(*SSAGlobal); ok {
				return fb.emitLoad(g, g.typ)
			}
			if nc, ok := fb.fn.Pkg.Members[e.Value].(*SSANamedConst); ok {
				return nc.Value
			}
		}
		if bv := fb.builtinValue(e.Value); bv != nil {
			return bv
		}
		// No local, free var, package member, predeclared type, or builtin:
		// the name does not exist. Fail loud - a dropped reference compiles
		// the surrounding code to garbage far from the cause.
		cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
		push(cctx.compileErrors, "undefined: " | e.Value)
		return nil
	}
	switch ob := obj.(type) {
	case *TCVar:
		if alloc, ok := fb.vars[ob]; ok {
			return fb.emitLoad(alloc, ob.Typ)
		}
		if fv, ok := fb.freeVarPtrs[e.Value]; ok {
			return fb.emitLoad(fv, ob.Typ)
		}
		for p := fb.parent; p != nil; p = p.parent {
			found := false
			if _, ok := p.vars[ob]; ok {
				found = true
			}
			if !found {
				for pobj := range p.vars {
					if ObjectName(pobj) == e.Value {
						found = true
						break
					}
				}
			}
			if !found && p.freeVarPtrs != nil {
				if _, ok := p.freeVarPtrs[e.Value]; ok {
					found = true
				}
			}
			if found {
				fv := fb.getOrCreateFreeVar(e.Value, ob.Typ)
				return fb.emitLoad(fv, ob.Typ)
			}
		}
		if g, ok := fb.fn.Pkg.Members[e.Value].(*SSAGlobal); ok {
			return fb.emitLoad(g, ob.Typ)
		}
		// dot-imported variable from another package
		if ob.Pkg != nil && ob.Pkg != fb.fn.Pkg.Pkg {
			impPkg := fb.ensureImportedSSAPackage(ob.Pkg)
			g, ok := impPkg.Members[e.Value].(*SSAGlobal)
			if !ok {
				g = &SSAGlobal{
					name: e.Value,
					typ:  NewPointer(ob.Typ),
					pkg:  impPkg,
				}
				impPkg.SetMember(e.Value, g)
			}
			return fb.emitLoad(g, ob.Typ)
		}
		return &SSAConst{typ: ob.Typ, val: nil}
	case *TCConst:
		return &SSAConst{typ: ob.Typ, val: localizeConstVal(ob.Val, ob.Typ)}
	case *TCFunc:
		fn, _ := fb.fn.Pkg.Members[e.Value].(*SSAFunction)
		if fn != nil {
			return fn
		}
		// dot-imported function from another package
		if ob.Pkg != nil && ob.Pkg != fb.fn.Pkg.Pkg {
			impPkg := fb.ensureImportedSSAPackage(ob.Pkg)
			fn = impPkg.Func(e.Value)
			if fn == nil {
				sig, _ := ob.Typ.(*Signature)
				fn = &SSAFunction{
					name:      e.Value,
					object:    ob,
					Signature: sig,
					Pkg:       impPkg,
					Prog:      fb.fn.Prog,
				}
				impPkg.SetMember(e.Value, fn)
			}
			return fn
		}
		return &SSAConst{typ: ob.Typ, val: nil}
	case *TypeName:
		return nil
	case *Builtin:
		return &SSABuiltin{id: ob.Id, name: ob.Name}
	}
	return nil
}

func (fb *ssaFuncBuilder) builtinValue(name string) (s SSAValue) {
	id, ok := ssaBuiltinID(name)
	if !ok {
		return nil
	}
	return &SSABuiltin{id: id, name: name}
}

func (fb *ssaFuncBuilder) buildLit(e *syntax.BasicLit) (s SSAValue) {
	cv := EvalBasicLitLocal(e)
	if cv == nil {
		return nil
	}
	switch e.Kind {
	case token.IntLit:
		return &SSAConst{typ: Typ[UntypedInt], val: cv}
	case token.FloatLit:
		return &SSAConst{typ: Typ[UntypedFloat], val: cv}
	case token.StringLit:
		return &SSAConst{typ: Typ[UntypedString], val: cv}
	case token.RuneLit:
		return &SSAConst{typ: Typ[UntypedRune], val: cv}
	}
	return nil
}

// buildOperandAddr returns the address of an addressable operand. It backs
// both the unary & operator and the receiver of a pointer-receiver method
// call, which must pass the address of the operand rather than a loaded copy:
// a copy makes the call's signature disagree with the method definition (a
// struct by value where wasm32 expects an i32 pointer, which the wasm
// validator rejects) and silently discards writes the method makes to its
// receiver.
func (fb *ssaFuncBuilder) buildOperandAddr(e syntax.Expr) (s SSAValue) {
	switch x := e.(type) {
	case *syntax.ParenExpr:
		return fb.buildOperandAddr(x.X)
	case *syntax.Name:
		obj := fb.lookupObject(x.Value)
		if obj != nil {
			if alloc, ok := fb.vars[obj]; ok {
				alloc.Heap = true
				return alloc
			}
			if g, ok := fb.fn.Pkg.Members[x.Value].(*SSAGlobal); ok {
				return g
			}
		}
	case *syntax.IndexExpr:
		idx := fb.buildExpr(x.Index)
		if idx == nil {
			return nil
		}
		var base SSAValue
		if sel, ok := x.X.(*syntax.SelectorExpr); ok {
			base = fb.buildSelectorAddr(sel)
		}
		if base == nil {
			base = fb.buildExpr(x.X)
		}
		if base == nil {
			return nil
		}
		// &s.field[i] where field is a slice: base is a pointer to the slice
		// header; load the header so IndexAddr indexes the slice's data
		// pointer, not the header itself.
		if pt, okp := SafeUnderlying(base.SSAType()).(*Pointer); okp && pt.Base != nil {
			pte := pt.Base
			pteu := SafeUnderlying(pte)
			isSl := false
			if _, ok := pteu.(*Slice); ok {
				isSl = true
			} else if bb, okb := pteu.(*Basic); okb && bb.Info&IsString != 0 {
				isSl = true
			}
			if isSl {
				base = fb.emitLoad(base, pte)
			}
		}
		ia := &SSAIndexAddr{X: base, Index: idx}
		// ssaIndexElemType, not ssaElemType: &arr[i] on a *[N]T base (e.g.
		// &bucket.tophash[i] where tophash is an [8]uint8 field) has to yield
		// *uint8. ssaElemType stops at the pointee and gave *[8]uint8, which
		// the assignability check then rejected.
		ia.typ = NewPointer(ssaIndexElemType(base.SSAType()))
		ia.name = fb.nextName()
		fb.emit(ia)
		fb.markAddrEscaping(ia)
		return ia
	case *syntax.SelectorExpr:
		addr := fb.buildSelectorAddr(x)
		if addr != nil {
			fb.markAddrEscaping(addr)
			return addr
		}
	case *syntax.Operation:
		// &*p is p: the pointer is already the operand's address.
		if x.Y == nil && x.Op == token.Mul {
			return fb.buildExpr(x.X)
		}
	case *syntax.CompositeLit:
		// &T{...} builds the literal INTO the allocation the address denotes.
		// Falling through to the value path below built the whole aggregate as
		// an SSA VALUE and then copied it into a fresh arena allocation:
		// tracev1's Events.grow does `push(l.buckets, &[eventsBucketSize]Event{})`
		// with eventsBucketSize = 524288, so the IR carried a 32 MiB alloca, a
		// 32 MiB load and a 32 MiB store, and clang's DAG combiner segfaulted in
		// SelectionDAG::ReplaceAllUsesWith on it. buildCompositeLitInto already
		// builds into an allocation for the `[]*T{{...}}` shorthand; this is the
		// same thing written with an explicit `&`.
		//
		// Only aggregates take this path: a slice or map literal's value is a
		// header/pointer, and taking its address means addressing that small
		// value, which the existing path already handles correctly.
		var litType Type
		if x.Type != nil {
			litType = fb.resolveType(x.Type)
		}
		if litType != nil {
			switch SafeUnderlying(litType).(type) {
			case *Array, *TCStruct:
				alloc := fb.emitAlloc(litType, 0)
				if litFullyCovers(x, litType) {
					alloc.NoZero = true
				}
				fb.markAddrEscaping(alloc)
				fb.buildCompositeLitInto(alloc, x, litType)
				return alloc
			}
		}
	}
	xv := fb.buildExpr(e)
	if xv == nil {
		return nil
	}
	a := &SSAAlloc{Heap: true}
	a.typ = NewPointer(xv.SSAType())
	a.name = fb.nextName()
	fb.emit(a)
	fb.emitStore(a, xv)
	return a
}

func (fb *ssaFuncBuilder) buildOperation(e *syntax.Operation) (s SSAValue) {
	if e.Y == nil {
		if e.Op == token.Add {
			return fb.buildExpr(e.X)
		}
		op2 := syntaxOpToSSAOp(e.Op, true)
		if op2 == OpAnd {
			return fb.buildOperandAddr(e.X)
		}
		xv3 := fb.buildExpr(e.X)
		if xv3 == nil {
			return nil
		}
		// Fold a unary operator applied to a CONSTANT in constant space. An
		// untyped value is otherwise materialized at its default
		// representation (int32), so -9223371966606163200 lost its high bits
		// before the convert to int64 could widen it. EvalUnaryLocal keeps the
		// untyped type and the exact value, and returns nil for the operators it
		// does not fold (receive among them), which fall through below.
		if kc, isConst := xv3.(*SSAConst); isConst && kc.val != nil {
			if folded := EvalUnaryLocal(e.Op, kc.val); folded != nil {
				return &SSAConst{typ: kc.typ, val: folded}
			}
		}
		if op2 == OpArrow {
			u2 := &SSAUnOp{Op: OpArrow, X: xv3}
			u2.typ = ssaChanElemType(xv3.SSAType())
			u2.name = fb.nextName()
			fb.emit(u2)
			return u2
		}
		u := &SSAUnOp{Op: op2, X: xv3}
		if op2 == OpMul {
			if p, ok := xv3.SSAType().(*Pointer); ok {
				u.typ = p.Base
			} else {
				u.typ = xv3.SSAType()
			}
		} else {
			u.typ = xv3.SSAType()
		}
		u.name = fb.nextName()
		fb.emit(u)
		return u
	}
	op := syntaxOpToSSAOp(e.Op, false)
	if op == OpLand || op == OpLor {
		xv4 := fb.buildExpr(e.X)
		if xv4 == nil {
			return nil
		}
		rhsBlock := fb.newBlock("sc.rhs")
		mergeBlock := fb.newBlock("sc.merge")
		entryBlock := fb.currentBlock
		fb.emit(&SSAIf{Cond: xv4})
		if op == OpLand {
			fb.pushSucc(fb.currentBlock, rhsBlock)
			fb.pushSucc(fb.currentBlock, mergeBlock)
		} else {
			fb.pushSucc(fb.currentBlock, mergeBlock)
			fb.pushSucc(fb.currentBlock, rhsBlock)
		}
		fb.pushPred(rhsBlock, entryBlock)
		fb.pushPred(mergeBlock, entryBlock)
		fb.currentBlock = rhsBlock
		yv := fb.buildExpr(e.Y)
		if yv == nil {
			yv = &SSAConst{typ: Typ[Bool], val: &ConstBool{V:false}}
		}
		fb.emit(&SSAJump{Comment: "sc.merge"})
		fb.pushSucc(fb.currentBlock, mergeBlock)
		fb.pushPred(mergeBlock, fb.currentBlock)
		fb.currentBlock = mergeBlock
		var shortVal SSAValue
		if op == OpLand {
			shortVal = &SSAConst{typ: Typ[Bool], val: &ConstBool{V:false}}
		} else {
			shortVal = &SSAConst{typ: Typ[Bool], val: &ConstBool{V:true}}
		}
		phi := &SSAPhi{Edges: []SSAValue{shortVal, yv}, Comment: "sc"}
		phi.typ = Typ[Bool]
		phi.name = fb.nextName()
		fb.emit(phi)
		return phi
	}
	x := fb.buildExpr(e.X)
	y := fb.buildExpr(e.Y)
	if x == nil || y == nil {
		return nil
	}
	// Legacy rejects '+' for text in user code (restrict.go
	// checkInstrRestrictions): concatenation is the '|' operator. It tests the
	// left operand's resolved type, so this does too - the rune/string mix
	// below is a separate error with its own message. The rule is a
	// main-module rule in legacy (CheckPlusOnText), so a manifest-less target
	// and a dependency package both keep '+' - see targetIsMainModule.
	if e.Op == token.Add && ssaIsStringType(x.SSAType()) && targetIsMainModule() && fb.fn != nil && fb.fn.Pkg != nil && fb.fn.Pkg.Pkg != nil && isTargetPkg(fb.fn.Pkg.Pkg.Path) {
		if isUserPackagePath(restrictPath(fb.fn.Pkg.Pkg.Path)) {
			cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
			push(cctx.compileErrors, "'+' is not allowed for text concatenation, use | operator")
		}
	}
	if (op == OpOr || op == OpAdd) && x.SSAType() != nil && y.SSAType() != nil {
		if IsRuneKind(x.SSAType()) && IsStringKind(y.SSAType()) || IsStringKind(x.SSAType()) && IsRuneKind(y.SSAType()) {
			mxutil.WriteStr(2, "compile error: cannot concatenate rune with string - convert to UTF-8 first\n")
			cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
			push(cctx.compileErrors, "cannot concatenate rune with string")
		}
	}
	if xc, ok := x.(*SSAConst); ok {
		if yc, ok2 := y.(*SSAConst); ok2 {
			if xc.val != nil && yc.val != nil {
				folded := EvalBinaryLocal(e.Op, xc.val, yc.val)
				if folded != nil {
					ct := xc.typ
					if ct == nil {
						ct = yc.typ
					}
					// A shift's result type follows its left operand; the
					// count never types it (`1 << uint32(3)` is an untyped
					// constant, and `0x20000000000000 >> uint32(3)` must not
					// become uint32 and truncate).
					if op != OpShl && op != OpShr {
						if yc.typ != nil && !isUntypedBasicType(yc.typ) && (ct == nil || isUntypedBasicType(ct)) {
							// A typed operand decides the result type.
							ct = yc.typ
						} else if isUntypedBasicType(ct) || ct == nil {
							// An untyped integer against an untyped float
							// folds to a float value; leaving ct as the left
							// operand's int truncated `1/2.0` to 0 at every
							// use. EvalBinaryLocal already mixes the kinds, so
							// the folded value decides here too.
							if _, isFloat := folded.(*ConstFloat); isFloat {
								ct = Typ[UntypedFloat]
							}
						}
					}
					if _, isBool := folded.(*ConstBool); isBool {
						ct = Typ[Bool]
					}
					return &SSAConst{typ: ct, val: folded}
				}
			}
		}
	}
	// Go types a shift whose left operand is an untyped constant by the type
	// that operand would take in context, so the enclosing operation supplies
	// the type, not the count: `1<<uint32(expbits) + int32(bias)` is int32, and
	// only the sibling operand knows that (strconv's atofHex). The width guard
	// keeps codegen unchanged - the shift already emits at that width, and a
	// fully constant shift returned above.
	if xs, ok := x.(*SSABinOp); ok && xs.untypedShift {
		if n := intTypeBits(y.SSAType()); n > 0 && n == intTypeBits(xs.SSAType()) {
			retypeUntypedShift(xs, y.SSAType())
		}
	}
	if ys, ok := y.(*SSABinOp); ok && ys.untypedShift {
		if n := intTypeBits(x.SSAType()); n > 0 && n == intTypeBits(ys.SSAType()) {
			retypeUntypedShift(ys, x.SSAType())
		}
	}
	b := &SSABinOp{Op: op, X: x, Y: y}
	b.name = fb.nextName()
	switch op {
	case OpEql, OpNeq, OpLss, OpLeq, OpGtr, OpGeq:
		b.typ = Typ[Bool]
	default:
		xT := x.SSAType()
		yT := y.SSAType()
		xUntyped := false
		if xB, ok := SafeUnderlying(xT).(*Basic); ok && xB.Info&IsUntyped != 0 {
			xUntyped = true
		}
		if xT != nil && !xUntyped {
			b.typ = xT
		} else if yT != nil {
			b.typ = yT
		} else {
			b.typ = xT
		}
		// A shift's result type follows the left operand, not the count.
		// Where the left operand is an untyped constant, the count's type
		// must not truncate it: 0x20000000000000 >> uint32(k) is 2^49, and
		// adopting the uint32 count computed it as 0 (math.expm1).
		if op == OpShl || op == OpShr {
			xShifted := false
			if xs, okS := x.(*SSABinOp); okS && xs.untypedShift {
				xShifted = true
			}
			if xUntyped || xShifted {
				if xUntyped {
					// The shift's type is the left operand's, and an untyped
					// operand takes the type it would have in context - with
					// none, its default type. The count's type is not that
					// context: `1 << c` with a byte count was typed uint8, so
					// the emitter's overshift select (count >= 8) answered 0
					// for every count >= 8 and `bytes.TrimRight(s, "\r\n")`
					// never trimmed. A constant too wide for the default keeps
					// its widened type, as before.
					if xb, okB := SafeUnderlying(xT).(*Basic); okB {
						if d := defaultReprType(xb); d != nil {
							b.typ = d
						}
					}
					if b.typ != nil {
						if wider := shiftConstWiden(x, b.typ); wider != nil {
							b.typ = wider
						}
					}
				}
				b.untypedShift = true
			}
		} else {
			// Keep the marker while the expression is still untyped-derived:
			// the `- 1` in `1<<uint32(expbits) - 1 + bias` must not lose it,
			// or the final `+ bias` can no longer supply the context type.
			if xs, okS := x.(*SSABinOp); okS && xs.untypedShift && isUntypedBasicType(yT) {
				b.untypedShift = true
			}
			if ys, okS := y.(*SSABinOp); okS && ys.untypedShift && isUntypedBasicType(xT) {
				b.untypedShift = true
			}
		}
	}
	fb.emit(b)
	return b
}

// checkSliceToArrayConv rejects (*[N]T)(s) when s is a slice: slices replace
// arrays and Moxie has no slice-to-array conversion machinery. Pointer-to-array
// puns are unaffected - their operand is a pointer, not a slice.
func (fb *ssaFuncBuilder) checkSliceToArrayConv(x SSAValue, dst Type) {
	if x == nil || dst == nil || fb.fn == nil || fb.fn.Pkg == nil || fb.fn.Pkg.Pkg == nil {
		return
	}
	if !isUserPackagePath(restrictPath(fb.fn.Pkg.Pkg.Path)) {
		return
	}
	if _, isSl := x.SSAType().(*Slice); !isSl {
		return
	}
	p, isPtr := dst.(*Pointer)
	if !isPtr {
		return
	}
	if _, isArr := p.Base.(*Array); !isArr {
		return
	}
	cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
	push(cctx.compileErrors, "slice-to-array-pointer conversion is not allowed: work in slices")
}

func (fb *ssaFuncBuilder) buildCall(e *syntax.CallExpr) (s SSAValue) {
	if fb.fn != nil && fb.fn.Pkg != nil && fb.fn.Pkg.Pkg != nil {
		checkParenCallTarget(e, fb.fn.Pkg.Pkg.Path)
	}
	if ie, ok := e.Fun.(*syntax.IndexExpr); ok {
		if result, handled := fb.tryGenericCallFromIndex(ie, e.ArgList, e.HasDots); handled {
			return result
		}
	}
	if name, ok := e.Fun.(*syntax.Name); ok {
		obj := fb.lookupObject(name.Value)
		if tn, ok2 := obj.(*TypeName); ok2 {
			if _, isTP := tn.Typ.(*TypeParam); !isTP {
				args2 := fb.buildArgs(e.ArgList)
				if len(args2) == 1 && args2[0] != nil {
					// An explicit conversion is a context for an untyped shift
					// operand, exactly like an assignment: the `1` in
					// `uint64(1 << uint32(bitSize-1))` assumes uint64, so the
					// shift must emit at 64 bits or a 63-bit shift runs at 32
					// and folds to 0 (strconv.ParseInt's cutoff).
					if binS, okS := args2[0].(*SSABinOp); okS && binS.untypedShift {
						retypeUntypedShift(binS, tn.Typ)
					}
					fb.checkConstConvert(args2[0], tn.Typ)
					if folded, okF := fb.foldConstConvert(args2[0], tn.Typ); okF {
						return folded
					}
					conv := &SSAConvert{X: args2[0]}
					conv.typ = tn.Typ
					fb.checkSliceToArrayConv(args2[0], tn.Typ)
					conv.name = fb.nextName()
					fb.emit(conv)
					return conv
				}
				return nil
			}
		}
		if result, handled := fb.tryGenericLocalCall(name.Value, e.ArgList, e.HasDots); handled {
			return result
		}
	}
	if convType := fb.resolveTypeProbe(e.Fun); convType != nil {
		args3 := fb.buildArgs(e.ArgList)
		if len(args3) == 1 && args3[0] != nil {
			if binS, okS := args3[0].(*SSABinOp); okS && binS.untypedShift {
				retypeUntypedShift(binS, convType)
			}
			fb.checkConstConvert(args3[0], convType)
			if folded, okF := fb.foldConstConvert(args3[0], convType); okF {
				return folded
			}
			conv := &SSAConvert{X: args3[0]}
			conv.typ = convType
			fb.checkSliceToArrayConv(args3[0], convType)
			conv.name = fb.nextName()
			fb.emit(conv)
			return conv
		}
		return nil
	}
	if sel, ok := e.Fun.(*syntax.SelectorExpr); ok {
		if name, ok2 := sel.X.(*syntax.Name); ok2 {
			obj := fb.lookupObject(name.Value)
			if obj == nil && fb.info != nil {
				obj = fb.info.Uses[name]
			}
			if pn, ok3 := obj.(*PkgName); ok3 {
				return fb.buildPkgCall(pn, sel.Sel.Value, e.ArgList, e.HasDots)
			}
		}
		// The receiver is built as a value first, because the method can only
		// be resolved against the operand's type. A pointer-receiver method
		// must be handed the operand's address rather than a loaded copy: a
		// copy makes the call's signature disagree with the method definition
		// (a struct by value where the callee takes a pointer, which the wasm
		// validator rejects) and loses receiver writes. When the resolved
		// method wants a pointer and the operand came in as a value, the
		// instructions just emitted for the value are discarded and the
		// operand is rebuilt as an address, so it is evaluated once.
		block := fb.currentBlock
		recvMark := int32(0)
		if block != nil {
			recvMark = len(block.Instrs)
		}
		recvCounter := fb.counter
		recv := fb.buildExpr(sel.X)
		if recv != nil && recv.SSAType() != nil {
			if fn2, fixedRecv := fb.resolveMethodCallWithRecv(sel, recv); fn2 != nil {
				// Ask about `recv`, the operand that was just built, not about
				// fixedRecv. resolveMethodCallWithRecv takes the operand's
				// address itself when the method has a pointer receiver, so
				// methodNeedsAddr(fn2, fixedRecv) can never report "a value
				// where a pointer is wanted" - the rollback below never ran and
				// the discarded value stayed in the instruction list as dead
				// IR. For a large struct that dead IR is a full-struct load:
				// flate.(*Writer).Close, whose `return w.d.close()` loads the
				// 640KB compressor, emitted
				//   %t5 = load { ...[131072 x i32], i1, i1 ... }, ptr %t4
				// and clang's instruction selector, lowering that aggregate
				// load field by field, hit an i1 field and aborted with
				//   Cannot select: i1,ch = load<(load (s8) ... align 8)>
				// which is what killed compress/flate and, through it, net/http.
				if fb.methodNeedsAddr(fn2, recv) {
					if block != nil {
						block.Instrs = block.Instrs[:recvMark]
					}
					fb.counter = recvCounter
					if addr := fb.buildOperandAddr(sel.X); addr != nil {
						fixedRecv = addr
					}
				}
				fixedRecv = fb.derefValueRecv(fn2, fixedRecv)
				args4 := fb.buildArgs(e.ArgList)
				if fn2.Signature != nil {
					fb.checkCallArgs(args4, fn2.Signature, e.HasDots)
					if fn2.Signature.Variadic && !e.HasDots {
						args4 = fb.wrapVariadicArgs(args4, fn2.Signature)
					}
					args4 = fb.coerceArgsToInterface(args4, fn2.Signature)
				}
				allArgs := []SSAValue{:0:len(args4) + 1}
				push(allArgs, fixedRecv)
				for _, ma := range args4 {
					push(allArgs, ma)
				}
				var retType2 Type
				if fn2.Signature != nil {
					if fn2.Signature.Results != nil && fn2.Signature.Results.Len() == 1 {
						retType2 = fn2.Signature.Results.At(0).Typ
					} else if fn2.Signature.Results != nil && fn2.Signature.Results.Len() > 1 {
						retType2 = fn2.Signature.Results
					}
				}
				call2 := &SSACall{Call: SSACallCommon{Value: fn2, Args: allArgs}}
				call2.typ = retType2
				call2.name = fb.nextName()
				fb.emit(call2)
				if retType2 == nil {
					return nil
				}
				return call2
			}
			if inv, handled := fb.buildIfaceMethodCall(sel, recv, e.ArgList); handled {
				return inv
			}
			if inv := fb.buildEmbeddedIfaceMethodCall(sel, recv, e.ArgList); inv != nil {
				return inv
			}
			if fv, handled := fb.buildFuncFieldCall(sel, e.ArgList, e.HasDots); handled {
				return fv
			}
			if gm, gmHandled := fb.tryGenericMethodCall(sel, recv, e.ArgList, e.HasDots); gmHandled {
				return gm
			}
			// No method, interface dispatch, function field or generic
			// instantiation matched the selector. Legacy rejects this in
			// go/types ("n.Nope undefined (type int32 has no field or
			// method Nope)"); returning nil here dropped the call, so a
			// typo compiled silently instead of failing loud.
			fb.reportUndefinedField(sel, recv.SSAType())
			return nil
		}
	}
	fn := fb.buildExpr(e.Fun)
	args := fb.buildArgs(e.ArgList)

	if fn == nil {
		// buildIdent already reported "undefined" for an unresolved callee name.
		return nil
	}
	if bi, ok := fn.(*SSABuiltin); ok {
		return fb.buildBuiltinCall(e, bi, args)
	}

	var retType Type
	if fn.SSAType() != nil {
		if sig, ok := SafeUnderlying(fn.SSAType()).(*Signature); ok {
			fb.checkCallArgs(args, sig, e.HasDots)
			if sig.Results != nil && sig.Results.Len() == 1 {
				retType = sig.Results.At(0).Typ
			} else if sig.Results != nil && sig.Results.Len() > 1 {
				retType = sig.Results
			}
		}
	} else if ssaFn, ok := fn.(*SSAFunction); ok && ssaFn.Signature != nil {
		sig := ssaFn.Signature
		if sig.Results != nil && sig.Results.Len() == 1 {
			retType = sig.Results.At(0).Typ
		} else if sig.Results != nil && sig.Results.Len() > 1 {
			retType = sig.Results
		}
	}

	if fn.SSAType() != nil {
		if sig, ok := SafeUnderlying(fn.SSAType()).(*Signature); ok {
			if sig.Variadic && !e.HasDots {
				args = fb.wrapVariadicArgs(args, sig)
			}
			args = fb.coerceArgsToInterface(args, sig)
		}
	}

	call := &SSACall{Call: SSACallCommon{Value: fn, Args: args}}
	call.typ = retType
	call.name = fb.nextName()
	fb.emit(call)

	if retType == nil {
		return nil
	}
	return call
}

func (fb *ssaFuncBuilder) coerceArgsToInterface(args []SSAValue, sig *Signature) (ss []SSAValue) {
	if sig.Params == nil {
		return args
	}
	for i := 0; i < len(args) && i < sig.Params.Len(); i++ {
		paramType := sig.Params.At(i).Typ
		if paramType == nil || args[i] == nil || args[i].SSAType() == nil {
			continue
		}
		_, isIface := SafeUnderlying(paramType).(*TCInterface)
		if !isIface {
			continue
		}
		_, argIsIface := SafeUnderlying(args[i].SSAType()).(*TCInterface)
		if argIsIface {
			continue
		}
		mi := &SSAMakeInterface{X: args[i], IType: paramType}
		mi.typ = paramType
		mi.name = fb.nextName()
		fb.emit(mi)
		args[i] = mi
	}
	return args
}

func (fb *ssaFuncBuilder) wrapVariadicArgs(args []SSAValue, sig *Signature) (ss []SSAValue) {
	if sig.Params == nil {
		return args
	}
	nFixed := sig.Params.Len() - 1
	if nFixed < 0 {
		nFixed = 0
	}
	if nFixed > len(args) {
		nFixed = len(args)
	}
	nVariadic := len(args) - nFixed
	if nVariadic <= 0 {
		nilSlice := NewSSAConst(&ConstNil{}, sig.Params.At(sig.Params.Len()-1).Typ)
		result2 := []SSAValue{:nFixed:nFixed + 1}
		copy(result2, args[:nFixed])
		push(result2, nilSlice)
		return result2
	}
	sliceType := sig.Params.At(sig.Params.Len() - 1).Typ
	// A variadic parameter whose type failed to resolve is nil, and the error is
	// already recorded by name at the DotsType sites. Building the variadic slice
	// anyway emitted an SSAMakeSlice with a nil element type, so the allocation
	// size and the slice header were computed from garbage: the header's length
	// came out as a stack address and the compiler segfaulted in runtime.memcpy
	// on roughly 2-7% of runs, on exactly this input. A compiler must not
	// synthesize a value of a type it could not resolve - refuse instead.
	if sliceType == nil {
		return args
	}
	var elemType Type
	if sl, ok := SafeUnderlying(sliceType).(*Slice); ok {
		elemType = sl.Elem
	}
	// HasDots lost because closures can't write to captured named returns.
	// Detect spread: if exactly 1 variadic arg whose type matches the
	// variadic param's slice type, pass it through. This covers both
	// concrete T and interface{} variadics (e.g. fmt.Print -> fmt.Fprint).
	if nVariadic == 1 && elemType != nil {
		argT := args[nFixed].SSAType()
		if argT != nil && Identical(argT, sliceType) {
			return args
		}
	}
	lenVal := NewSSAConst(&ConstInt{V:int64(nVariadic)}, Typ[Int32])
	ms := &SSAMakeSlice{Len: lenVal, Cap: lenVal}
	ms.typ = sliceType
	ms.name = fb.nextName()
	fb.emit(ms)
	for i := 0; i < nVariadic; i++ {
		idx := NewSSAConst(&ConstInt{V:int64(i)}, Typ[Int32])
		ia := &SSAIndexAddr{X: ms, Index: idx}
		ia.typ = NewPointer(elemType)
		ia.name = fb.nextName()
		fb.emit(ia)
		v := args[nFixed+i]
		if elemType != nil {
			v = fb.coerceToInterface(v, elemType)
		}
		fb.emitStore(ia, v)
	}
	result := []SSAValue{:nFixed:nFixed + 1}
	copy(result, args[:nFixed])
	push(result, ms)
	return result
}

func (fb *ssaFuncBuilder) buildArgs(argList []syntax.Expr) (ss []SSAValue) {
	args := []SSAValue{:0:len(argList)}
	for _, a := range argList {
		v := fb.buildExpr(a)
		if v != nil {
			push(args, v)
		}
	}
	if len(args) == 1 && args[0] != nil {
		if t, ok := args[0].SSAType().(*Tuple); ok && t.Len() > 1 {
			expanded := []SSAValue{:0:t.Len()}
			for i := int32(0); i < int32(t.Len()); i++ {
				ext := &SSAExtract{Tuple: args[0], Index: int32(i)}
				ext.typ = t.At(int32(i)).Typ
				ext.name = fb.nextName()
				fb.emit(ext)
				push(expanded, ext)
			}
			return expanded
		}
	}
	return args
}

func (fb *ssaFuncBuilder) buildBuiltinCall(e *syntax.CallExpr, b *SSABuiltin, args []SSAValue) (s SSAValue) {
	switch b.id {
	case BuiltinLen, BuiltinCap:
		if b.id == BuiltinLen && len(args) == 1 {
			if c, ok := args[0].(*SSAConst); ok {
				if cs, ok2 := c.val.(*ConstStr); ok2 {
					return &SSAConst{typ: Typ[Int32], val: &ConstInt{V:int64(len(cs.S))}}
				}
			}
		}
		call2 := &SSACall{Call: SSACallCommon{Value: b, Args: args}}
		call2.typ = Typ[Int32]
		call2.name = fb.nextName()
		fb.emit(call2)
		return call2
	case BuiltinAppend:
		if len(args) > 1 {
			if sl, ok := SafeUnderlying(args[0].SSAType()).(*Slice); ok {
				for i := 1; i < len(args); i++ {
					if e.HasDots && i == 1 {
						continue
					}
					// Every pushed/appended element is a value of the slice's
					// ELEMENT type, exactly as a sent value is a value of the
					// channel's element type. Box it when the element is an
					// interface, and give an argument that has no type of its
					// own - the untyped nil - the nil of the element type.
					// Leaving the untyped nil alone made `push(lines, nil)`
					// (text/tabwriter's addLine) emit `store []cell null`, and
					// clang rejected the module: "null must be a pointer type".
					// The zero of a slice is zeroinitializer, not the pointer
					// literal null. Only the type of the value decides that,
					// which is why it is the builder's job and not the
					// emitter's.
					args[i] = fb.coerceSendValue(args[i], sl.Elem)
				}
			}
		}
		call3 := &SSACall{Call: SSACallCommon{Value: b, Args: args, HasDots: e.HasDots}}
		if len(args) > 0 {
			call3.typ = args[0].SSAType()
		}
		call3.name = fb.nextName()
		fb.emit(call3)
		return call3
	case BuiltinMake:
		if len(e.ArgList) == 0 {
			return nil
		}
		typ := fb.resolveType(e.ArgList[0])
		return fb.emitMake(typ, args)
	case BuiltinNew:
		mxutil.WriteStr(2, "compile error: new() is not supported (use &T{})\n")
		return nil
	case BuiltinPanic:
		if len(args) > 0 {
			fb.emit(&SSAPanic{X: args[0]})
			fb.currentBlock = nil
		}
		return nil
	case BuiltinClose, BuiltinDelete, BuiltinClear, BuiltinPrint, BuiltinPrintln:
		if b.id == BuiltinClear && len(args) == 1 {
			// Legacy rejects clear on anything but a slice or a map. The
			// check belongs here, before the compileErrors gate: one made at
			// IR-emit time prints but still links a binary.
			at := args[0].SSAType()
			u := SafeUnderlying(at)
			if u == nil {
				u = at
			}
			_, isMap := u.(*TCMap)
			_, isSlice := u.(*Slice)
			if !isMap && !isSlice {
				tn := "unknown"
				if at != nil {
					tn = at.String()
				}
				mxutil.WriteStr(2, "compile error: unsupported type in clear builtin: " | tn | "\n")
				cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
				push(cctx.compileErrors, "unsupported type in clear builtin: " | tn)
				return nil
			}
		}
		call4 := &SSACall{Call: SSACallCommon{Value: b, Args: args}}
		call4.name = fb.nextName()
		fb.emit(call4)
		return nil
	case BuiltinCopy:
		call5 := &SSACall{Call: SSACallCommon{Value: b, Args: args}}
		call5.typ = Typ[Int32]
		call5.name = fb.nextName()
		fb.emit(call5)
		return call5
	case BuiltinRecover:
		call6 := &SSACall{Call: SSACallCommon{Value: b, Args: args}}
		call6.typ = Typ[TCString]
		call6.name = fb.nextName()
		fb.emit(call6)
		return call6
	case BuiltinSpawn:
		call7 := &SSACall{Call: SSACallCommon{Value: b, Args: args}}
		// spawn returns the control channel: chan struct{}, bidirectional
		// because either side may close it. It was typed <-chan string, a
		// leftover from when the control channel carried strings, so every
		// `done := spawn(...)` stored into a chan struct{} field was a type
		// error - pkg/broadcast's Broadcaster.done was the first to hit it.
		call7.typ = NewTCChan(TCSendRecv, &TCStruct{})
		call7.name = fb.nextName()
		fb.emit(call7)
		return call7
	case BuiltinMin, BuiltinMax:
		call8 := &SSACall{Call: SSACallCommon{Value: b, Args: args}}
		if len(args) > 0 && args[0] != nil {
			call8.typ = args[0].SSAType()
		} else {
			call8.typ = Typ[Int32]
		}
		call8.name = fb.nextName()
		fb.emit(call8)
		return call8
	case BuiltinPush, BuiltinResize:
		// An untyped nil has no element type, so the call cannot be typed: the
		// result used to become untyped nil and default to int32, which either
		// produced IR clang refuses (an i32 where a slice header belongs) or
		// silently yielded an empty slice. Legacy reports this; stage4 did not.
		// The nil literal is built with a nil type (buildIdent), so both
		// spellings have to be caught.
		if len(args) > 0 && args[0] != nil {
			at := args[0].SSAType()
			untypedNil := at == nil
			if !untypedNil {
				if b0, ok0 := SafeUnderlying(at).(*Basic); ok0 && b0.Kind == UntypedNil {
					untypedNil = true
				}
			}
			if untypedNil {
				cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
				push(cctx.compileErrors, "invalid push: argument must be a slice; have untyped nil")
				return nil
			}
		}
		if len(args) > 1 {
			if sl, ok := SafeUnderlying(args[0].SSAType()).(*Slice); ok {
				for i := 1; i < len(args); i++ {
					if e.HasDots && i == 1 {
						continue
					}
					// Every pushed/appended element is a value of the slice's
					// ELEMENT type, exactly as a sent value is a value of the
					// channel's element type. Box it when the element is an
					// interface, and give an argument that has no type of its
					// own - the untyped nil - the nil of the element type.
					// Leaving the untyped nil alone made `push(lines, nil)`
					// (text/tabwriter's addLine) emit `store []cell null`, and
					// clang rejected the module: "null must be a pointer type".
					// The zero of a slice is zeroinitializer, not the pointer
					// literal null. Only the type of the value decides that,
					// which is why it is the builder's job and not the
					// emitter's.
					args[i] = fb.coerceSendValue(args[i], sl.Elem)
				}
			}
		}
		callP := &SSACall{Call: SSACallCommon{Value: b, Args: args, HasDots: e.HasDots}}
		if len(args) > 0 && args[0] != nil {
			callP.typ = args[0].SSAType()
		}
		callP.name = fb.nextName()
		fb.emit(callP)
		// push is an in-place mutation: store the new slice header back
		// into the slice's storage. The emitter lowers push to slicePush +
		// memmove and returns the new header as the call result; without
		// this store, statement-form push (e.g. codecWriteU32's
		// push(cb.data, ...)) silently drops the appended elements.
		if len(e.ArgList) > 0 && callP.typ != nil {
			if addr := fb.buildPushTargetAddr(e.ArgList[0]); addr != nil {
				st := &SSAStore{Addr: addr, Val: callP}
				fb.emit(st)
			}
		}
		return callP
	case BuiltinPop:
		callPop := &SSACall{Call: SSACallCommon{Value: b, Args: args}}
		if len(args) == 1 {
			if sl, ok := SafeUnderlying(args[0].SSAType()).(*Slice); ok {
				callPop.typ = sl.Elem
			} else {
				callPop.typ = Typ[Uint8]
			}
		}
		callPop.name = fb.nextName()
		fb.emit(callPop)
		return callPop
	}
	call9 := &SSACall{Call: SSACallCommon{Value: b, Args: args}}
	call9.name = fb.nextName()
	fb.emit(call9)
	return call9
}

func (fb *ssaFuncBuilder) emitMake(typ Type, sizeArgs []SSAValue) (s SSAValue) {
	if typ == nil {
		return nil
	}
	switch u := SafeUnderlying(typ).(type) {
	case *Basic:
		if u.Kind == TCString {
			ms := &SSAMakeSlice{}
			ms.typ = typ
			ms.name = fb.nextName()
			if len(sizeArgs) > 0 {
				ms.Len = sizeArgs[0]
			}
			if len(sizeArgs) > 1 {
				ms.Cap = sizeArgs[1]
			}
			fb.emit(ms)
			return ms
		}
	case *Slice:
		ms := &SSAMakeSlice{}
		ms.typ = typ
		ms.name = fb.nextName()
		if len(sizeArgs) > 0 {
			ms.Len = sizeArgs[0]
		}
		if len(sizeArgs) > 1 {
			ms.Cap = sizeArgs[1]
		}
		fb.emit(ms)
		return ms
	case *TCMap:
		mm := &SSAMakeMap{}
		mm.typ = typ
		mm.name = fb.nextName()
		if len(sizeArgs) > 0 {
			mm.Reserve = sizeArgs[0]
		}
		fb.emit(mm)
		return mm
	case *TCChan:
		mc := &SSAMakeChan{}
		mc.typ = typ
		mc.name = fb.nextName()
		if len(sizeArgs) > 0 {
			mc.Size = sizeArgs[0]
		}
		fb.emit(mc)
		return mc
	}
	return nil
}

// reportUndefinedField mirrors legacy's diagnostic for a selector that is
// neither a field nor a method on a struct operand. go/types reports
// "x.f undefined (type T has no field or method f)" and stops; without the
// same check here the failed lookup left a nil value behind and the emitter
// dereferenced it, so a typo compiled into invalid wasm instead of an error.
// The struct check keeps speculative selector paths (method expressions on
// non-struct types, type parameters) from reporting.
func (fb *ssaFuncBuilder) reportUndefinedField(sel *syntax.SelectorExpr, t Type) {
	if sel == nil || sel.Sel == nil || sel.Sel.Value == "" {
		return
	}
	// User packages only, like the other assignability diagnostics: the stdlib
	// has selector shapes stage4 cannot resolve yet (a method on a generic
	// instantiation, e.g. array.Array.Next) and reporting those would be
	// false errors. go/types still covers the stdlib on the legacy side.
	if fb.fn == nil || fb.fn.Pkg == nil || fb.fn.Pkg.Pkg == nil {
		return
	}
	if !isUserPackagePath(restrictPath(fb.fn.Pkg.Pkg.Path)) {
		return
	}
	// A field selected on a map value (m[k].f) is legal even though the map
	// element is not addressable: the value path copies the element out. Only
	// the operand kinds that must resolve to an address are reported.
	if ie, ok := sel.X.(*syntax.IndexExpr); ok {
		if _, isMap := SafeUnderlying(fb.operandType(ie.X)).(*TCMap); isMap {
			return
		}
	}
	if p, ok := SafeUnderlying(t).(*Pointer); ok {
		t = p.Base
	}
	if t == nil {
		return
	}
	// Operand kinds whose method set stage4 cannot resolve completely are
	// skipped: type parameters (the methods live in the constraint), function
	// signatures and tuples, and a pointer that the single unwrap above did not
	// reach. Named types are judged by their underlying kind, which became safe
	// once a function-typed field call reported itself handled even when it
	// returns nothing: the misses that looked like unknown fields on captured or
	// cross-package receivers were really dropped void func-field calls.
	//
	// An interface IS judged, but only a non-empty one. Its method set is
	// written down in the interface itself, so a name that is not in it is
	// always an error - go/types agrees. An EMPTY interface is also how the
	// compiler spells an interface it has not resolved yet (NewTCInterface(nil,
	// nil) is used as a placeholder in the guard paths), and reporting on a
	// placeholder would be the false error the skip was protecting against.
	u := SafeUnderlying(t)
	if ifc, isIface := u.(*TCInterface); isIface {
		if ifc.IsEmpty() {
			return
		}
	} else {
		switch u.(type) {
		case *TypeParam, *Signature, *Tuple, *Pointer:
			return
		}
	}
	name := ""
	if t != nil {
		name = t.String()
	}
	cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
	push(cctx.compileErrors, fb.errPos() | sel.Sel.Value | " undefined (type " | name | " has no field or method " | sel.Sel.Value | ")")
}

func (fb *ssaFuncBuilder) buildSelector(e *syntax.SelectorExpr) (s SSAValue) {
	if name, ok := e.X.(*syntax.Name); ok {
		obj := fb.lookupObject(name.Value)
		if obj == nil && fb.info != nil {
			obj = fb.info.Uses[name]
		}
		if pn, ok2 := obj.(*PkgName); ok2 {
			return fb.buildPkgMember(pn, e.Sel.Value)
		}
		// Fallback: resolve imported const directly from the type
		// checker's selection info when PkgName lookup fails.
		if obj == nil && fb.info != nil && fb.info.Selections != nil {
			if sel, ok3 := fb.info.Selections[e]; ok3 {
				if sel.Obj != nil {
					if tc, ok4 := sel.Obj.(*TCConst); ok4 {
						return &SSAConst{typ: tc.Typ, val: localizeConstVal(tc.Val, tc.Typ)}
					}
				}
			}
		}
	}
	fa := fb.buildSelectorAddr(e)
	if fa != nil {
		elemType := fa.SSAType()
		if p, ok := SafeUnderlying(elemType).(*Pointer); ok {
			elemType = p.Base
		}
		return fb.emitLoad(fa, elemType)
	}
	recv := fb.buildExpr(e.X)
	if recv == nil {
		return nil
	}
	mv := fb.buildMethodValue(e, recv)
	if mv == nil {
		fb.reportUndefinedField(e, recv.SSAType())
	}
	return mv
}

func (fb *ssaFuncBuilder) buildMethodValue(sel *syntax.SelectorExpr, recv SSAValue) (s SSAValue) {
	fn, fixedRecv := fb.resolveMethodCallWithRecv(sel, recv)
	if fn == nil || fn.Signature == nil {
		return nil
	}
	methodSig := fn.Signature
	var wrapperParams *Tuple
	if methodSig.Params != nil && methodSig.Params.Len() > 0 {
		vars := []*TCVar{:0:methodSig.Params.Len()}
		for i := 0; i < methodSig.Params.Len(); i++ {
			push(vars, methodSig.Params.At(i))
		}
		wrapperParams = NewTuple(vars...)
	}
	wrapperSig := NewSignature(nil, wrapperParams, methodSig.Results, methodSig.Variadic)
	name := fb.fn.name | "__mval" | ssaItoa(len(fb.fn.AnonFuncs)+1)
	wrapper := &SSAFunction{
		name:      name,
		Signature: wrapperSig,
		Pkg:       fb.fn.Pkg,
		Prog:      fb.fn.Prog,
		parent:    fb.fn,
	}
	fb.fn.AnonFuncs = mxutil.Ensure(fb.fn.AnonFuncs, 1)
	push(fb.fn.AnonFuncs, wrapper)
	recvType := fixedRecv.SSAType()
	fv := &SSAFreeVar{name: "recv", typ: recvType, parent: wrapper}
	wrapper.FreeVars = mxutil.Ensure(wrapper.FreeVars, 1)
	push(wrapper.FreeVars, fv)
	if wrapperParams != nil {
		for i := 0; i < wrapperParams.Len(); i++ {
			v := wrapperParams.At(i)
			p := &SSAParameter{name: v.Name, typ: v.Typ, parent: wrapper}
			wrapper.Params = mxutil.Ensure(wrapper.Params, 1)
			push(wrapper.Params, p)
		}
	}
	entry := NewSSABasicBlock(wrapper, "entry")
	args := []SSAValue{:0:1 + len(wrapper.Params)}
	push(args, fv)
	for _, p := range wrapper.Params {
		push(args, p)
	}
	var retType Type
	if methodSig.Results != nil && methodSig.Results.Len() == 1 {
		retType = methodSig.Results.At(0).Typ
	} else if methodSig.Results != nil && methodSig.Results.Len() > 1 {
		retType = methodSig.Results
	}
	call := &SSACall{Call: SSACallCommon{Value: fn, Args: args}}
	call.typ = retType
	call.name = "t1"
	call.setBlock(entry)
	entry.Instrs = mxutil.Ensure(entry.Instrs, 1)
	push(entry.Instrs, call)
	ret := &SSAReturn{}
	if retType != nil {
		ret.Results = []SSAValue{call}
	}
	ret.setBlock(entry)
	entry.Instrs = mxutil.Ensure(entry.Instrs, 1)
	push(entry.Instrs, ret)
	mc := &SSAMakeClosure{Fn: wrapper, Bindings: []SSAValue{fixedRecv}}
	mc.typ = wrapperSig
	mc.name = fb.nextName()
	fb.emit(mc)
	return mc
}

// buildPushTargetAddr computes the storage address of a slice expression
// for in-place push mutation. Mirrors the assign-LHS addressing in
// buildStore: Name -> var/global alloc, *p -> p, x.f -> field addr,
// a[i] -> index addr.
func (fb *ssaFuncBuilder) buildPushTargetAddr(e syntax.Expr) (a SSAValue) {
	switch lv := e.(type) {
	case *syntax.Name:
		obj := fb.lookupObject(lv.Value)
		if obj == nil {
			return nil
		}
		if alloc, ok := fb.vars[obj]; ok {
			return alloc
		}
		if fv, ok := fb.freeVarPtrs[lv.Value]; ok {
			return fv
		}
		if g, ok := fb.fn.Pkg.Members[lv.Value].(*SSAGlobal); ok {
			return g
		}
	case *syntax.Operation:
		if lv.Y == nil && lv.Op == token.Mul {
			return fb.buildExpr(lv.X)
		}
	case *syntax.SelectorExpr:
		s := fb.buildSelectorAddr(lv)
		if s == nil {
			fb.reportUndefinedField(lv, fb.operandType(lv.X))
		}
		return s
	case *syntax.IndexExpr:
		base := fb.buildExpr(lv.X)
		idx := fb.buildExpr(lv.Index)
		if base == nil || idx == nil {
			return nil
		}
		// A map element is not addressable. `m[k] = push(m[k], v)` writes
		// the new header through the map update, and a bare `push(m[k], v)`
		// has nowhere to put it. Indexing the map as if it were a slice
		// emitted a GEP whose index was the key (invalid IR), and the map
		// update then also fired, so the element was written twice.
		if _, isMap := SafeUnderlying(base.SSAType()).(*TCMap); isMap {
			return nil
		}
		// IndexAddr takes the slice VALUE, exactly as buildOperandAddr does for
		// an assignment lvalue: the emitter then addresses data+index*elemSize.
		// This branch used to pass the ADDRESS of the slice variable instead,
		// so the store-back of the grown header targeted the slice header
		// itself rather than its element. `d[i] = push(d[i], v)` therefore
		// overwrote the outer slice with the element's header - the directory
		// gained an entry and its lengths scrambled on every call - and a
		// slice-of-slices accumulator could not be built at all.
		ia := &SSAIndexAddr{X: base, Index: idx}
		ia.typ = NewPointer(ssaElemType(base.SSAType()))
		ia.name = fb.nextName()
		fb.emit(ia)
		return ia
	}
	return nil
}

// buildFuncFieldCall builds a call through a struct field of function type
// (e.g. m.keyHash(...) where keyHash is a func field on hashmap). handled
// distinguishes "not a function field" from a void call: the call is emitted
// either way, but a coincidental nil return made buildCall keep searching and
// report the field as missing (relay's c.onReady(false), c.ScheduleReconnect,
// sub.OnEvent - all void fields).
func (fb *ssaFuncBuilder) buildFuncFieldCall(sel *syntax.SelectorExpr, argList []syntax.Expr, hasDots bool) (s SSAValue, handled bool) {
	recv := fb.buildExpr(sel.X)
	if recv == nil || recv.SSAType() == nil {
		return nil, false
	}
	ft := fb.fieldType(recv.SSAType(), fb.fieldIndex(recv.SSAType(), sel.Sel.Value))
	sig, ok := SafeUnderlying(ft).(*Signature)
	if !ok {
		return nil, false
	}
	addr := fb.buildSelectorAddr(sel)
	if addr == nil {
		return nil, false
	}
	fv := fb.emitLoad(addr, ft)
	args := fb.buildArgs(argList)
	if sig.Variadic && !hasDots {
		args = fb.wrapVariadicArgs(args, sig)
	}
	args = fb.coerceArgsToInterface(args, sig)
	var retType Type
	if sig.Results != nil && sig.Results.Len() == 1 {
		retType = sig.Results.At(0).Typ
	} else if sig.Results != nil && sig.Results.Len() > 1 {
		retType = sig.Results
	}
	call := &SSACall{Call: SSACallCommon{Value: fv, Args: args}}
	call.typ = retType
	call.name = fb.nextName()
	fb.emit(call)
	if retType == nil {
		return nil, true
	}
	return call, true
}

// tryGenericMethodCall monomorphizes a method call on a generic receiver
// (e.g. fields.Index(i) where fields is Array[rtStructFieldDesc]). The
// receiver type must carry instantiation args (TArgs set by
// resolveTypeExprWithSubst). Looks up the generic method decl collected by
// ScanGenericDecls, substitutes the type params, builds the body, and emits
// the call with the receiver as first argument.
func (fb *ssaFuncBuilder) tryGenericMethodCall(sel *syntax.SelectorExpr, recv SSAValue, argList []syntax.Expr, hasDots bool) (s SSAValue, handled bool) {
	typ := recv.SSAType()
	if typ == nil {
		return nil, false
	}
	isPtr := false
	if p, isP := SafeUnderlying(typ).(*Pointer); isP {
		typ = p.Base
		isPtr = true
	}
	named, ok := typ.(*Named)
	if !ok || named.Obj == nil || len(named.TArgs) == 0 {
		return nil, false
	}
	pkgPath := ""
	if named.Obj.Pkg != nil {
		pkgPath = named.Obj.Pkg.Path
	}
	key := pkgPath | "." | named.Obj.Name | "." | sel.Sel.Value
	fd, ok2 := cctx.genericMethodDecls[key]
	if !ok2 || fd == nil || fd.Recv == nil {
		return nil, false
	}
	tparamNames := extractRecvTParamNames(fd.Recv.Type)
	if len(tparamNames) == 0 || len(tparamNames) > len(named.TArgs) {
		return nil, false
	}
	typeSubst := map[string]Type{}
	for i, tn := range tparamNames {
		typeSubst[tn] = named.TArgs[i]
	}
	var srcScope *Scope
	if cctx.genericPkgScopes != nil {
		srcScope = cctx.genericPkgScopes[pkgPath]
	}
	savedImports := cctx.sigDeclPkgImports
	if fb.fn != nil && fb.fn.Pkg != nil && fb.fn.Pkg.Pkg != nil && fb.fn.Pkg.Pkg.Path == pkgPath {
		cctx.sigDeclPkgImports = fb.fn.Pkg.Pkg.Imports
	}
	sig := resolveMethodSigWithSubst(fd, typeSubst, srcScope)
	cctx.sigDeclPkgImports = savedImports
	if sig == nil || sig.Recv == nil {
		return nil, false
	}
	mangledName := mangleGenericName("(*"|named.Obj.Name|")."|sel.Sel.Value, named.TArgs)
	if pkgPath != "" {
		pfx := ""
		for j := 0; j < len(pkgPath); j++ {
			c := pkgPath[j]
			if c == '/' {
				pfx = pfx | "_"
			} else {
				pfx = pfx | string([]byte{c})
			}
		}
		mangledName = pfx | "." | mangledName
	}
	fixed := recv
	if !isPtr {
		// Pass the receiver's ADDRESS whenever it is addressable. Handing the
		// callee a copy loses every receiver write: o.queue.push's q.end++ went
		// into a temporary, the following o.queue.pop() then saw start == end
		// and returned the zero value and false. The plain method path rebuilds
		// the operand as an address for exactly this reason (methodNeedsAddr).
		// Only a genuinely non-addressable receiver (a call result) falls back
		// to a copy, which is the one case Go's rule rejects anyway.
		if addr := fb.buildOperandAddr(sel.X); addr != nil {
			fixed = addr
		} else {
			alloc := &SSAAlloc{Comment: "gmethod.tmp"}
			alloc.typ = NewPointer(recv.SSAType())
			alloc.name = fb.nextName()
			fb.emit(alloc)
			storeOp := &SSAStore{Addr: alloc, Val: recv}
			fb.emit(storeOp)
			fixed = alloc
		}
	}
	args := fb.buildArgs(argList)
	allArgs := []SSAValue{:0:len(args) + 1}
	push(allArgs, fixed)
	for _, ma := range args {
		push(allArgs, ma)
	}
	if fn5, ok5 := fb.fn.Pkg.Members[mangledName].(*SSAFunction); ok5 {
		return fb.emitCallToSSAFunc(fn5, allArgs, hasDots), true
	}
	fn := &SSAFunction{
		name:      mangledName,
		Signature: sig,
		Pkg:       fb.fn.Pkg,
		Prog:      fb.fn.Prog,
	}
	fb.fn.Pkg.SetMember(mangledName, fn)
	subFb := newSSAFuncBuilder(fn, fb.info)
	subFb.typeSubst = typeSubst
	subFb.srcScope = srcScope
	subFb.buildBody(fd)
	return fb.emitCallToSSAFunc(fn, allArgs, hasDots), true
}

// extractRecvTParamNames extracts the type parameter names declared on a
// generic receiver type expression (e.g. Array[K, V] -> [K, V]).
func extractRecvTParamNames(t syntax.Expr) (names []string) {
	switch tt := t.(type) {
	case *syntax.Operation:
		if tt.Y == nil {
			return extractRecvTParamNames(tt.X)
		}
	case *syntax.IndexExpr:
		if le, ok := tt.Index.(*syntax.ListExpr); ok {
			for _, e := range le.ElemList {
				if n, ok2 := e.(*syntax.Name); ok2 {
					names = mxutil.Ensure(names, 1)
					push(names, n.Value)
				}
			}
		} else if n, ok2 := tt.Index.(*syntax.Name); ok2 {
			names = mxutil.Ensure(names, 1)
			push(names, n.Value)
		}
	}
	return names
}

// resolveMethodSigWithSubst resolves a method's full signature including
// the receiver, substituting type params via typeSubst.
func resolveMethodSigWithSubst(fd *syntax.FuncDecl, typeSubst map[string]Type, pkgScope *Scope) (s *Signature) {
	if fd == nil || fd.Type == nil {
		return nil
	}
	s = resolveSignatureWithSubst(fd.Type, typeSubst, pkgScope)
	if s == nil {
		return nil
	}
	if fd.Recv != nil {
		rt := resolveTypeExprWithSubst(fd.Recv.Type, typeSubst, pkgScope)
		rname := ""
		if fd.Recv.Name != nil {
			rname = fd.Recv.Name.Value
		}
		s.Recv = NewTCVar(nil, rname, rt)
	}
	return s
}

func (fb *ssaFuncBuilder) ensureImportedSSAPackage(imported *TCPackage) (s *SSAPackage) {
	impPkg := fb.fn.Prog.ImportedPackage(imported.Path)
	if impPkg == nil {
		impPkg = &SSAPackage{
			Prog:    fb.fn.Prog,
			Pkg:     imported,
			Members: map[string]SSAMember{},
		}
		fb.fn.Prog.imported[imported.Path] = impPkg
		fb.fn.Prog.packages[imported] = impPkg
	}
	return impPkg
}

func (fb *ssaFuncBuilder) buildPkgMember(pn *PkgName, memberName string) (s SSAValue) {
	imported := pn.Imported
	if imported == nil {
		return nil
	}
	obj := imported.Scope.Lookup(memberName)
	if obj == nil {
		return nil
	}
	// runtime.GOOS/GOARCH and internal/goarch.GOARCH are target-dependent
	// consts. Return as SSAConst so switch folding and string compare work.
	if imported.Path == "runtime" || imported.Path == "internal/goarch" {
		if memberName == "GOOS" {
			return &SSAConst{typ: Typ[TCString], val: &ConstStr{S:compileTargetOS()}}
		}
		if memberName == "GOARCH" {
			return &SSAConst{typ: Typ[TCString], val: &ConstStr{S:compileTargetArch()}}
		}
	}
	switch ob := obj.(type) {
	case *TCConst:
		return &SSAConst{typ: ob.Typ, val: localizeConstVal(ob.Val, ob.Typ)}
	case *TCVar:
		impPkg := fb.ensureImportedSSAPackage(imported)
		g, ok := impPkg.Members[memberName].(*SSAGlobal)
		if !ok {
			g = &SSAGlobal{
				name: memberName,
				typ:  NewPointer(ob.Typ),
				pkg:  impPkg,
			}
			impPkg.SetMember(memberName, g)
		}
		return fb.emitLoad(g, ob.Typ)
	case *TCFunc:
		impPkg := fb.ensureImportedSSAPackage(imported)
		fn := impPkg.Func(memberName)
		if fn == nil {
			// Materialize the imported function for use as a value; the
			// direct-call path does the same lazily, but a func referenced
			// as an argument never goes through it.
			sig, _ := ob.Typ.(*Signature)
			fn = &SSAFunction{
				name:      memberName,
				object:    ob,
				Signature: sig,
				Pkg:       impPkg,
				Prog:      fb.fn.Prog,
			}
			if isNoContextExtern(imported.Path, memberName) {
				fn.isExternC = true
			}
			impPkg.SetMember(memberName, fn)
		}
		return fn
	}
	return nil
}

func markAddrEscapingRec(v SSAValue, seen map[SSAValue]bool, depth int32) {
	if v == nil || depth > 32 || seen[v] {
		return
	}
	seen[v] = true
	switch t := v.(type) {
	case *SSAAlloc:
		t.Heap = true
	case *SSAFieldAddr:
		markAddrEscapingRec(t.X, seen, depth+1)
	case *SSAIndexAddr:
		markAddrEscapingRec(t.X, seen, depth+1)
	case *SSASlice:
		markAddrEscapingRec(t.X, seen, depth+1)
	case *SSAChangeType:
		markAddrEscapingRec(t.X, seen, depth+1)
	case *SSAConvert:
		markAddrEscapingRec(t.X, seen, depth+1)
	case *SSAPhi:
		for _, edge := range t.Edges {
			markAddrEscapingRec(edge, seen, depth+1)
		}
	}
}

// markAddrEscaping marks every local alloca an address expression is rooted at
// as heap-allocated. The legacy compiler makes exactly this decision in
// builder.addr(fn, e, escaping=true) -> Function.lookup(obj, true), which sets
// Alloc.Heap: an address that is formed by & (or by slicing an addressable
// array, or by taking the receiver of a pointer method) may be stored
// anywhere, so its storage has to outlive the frame. Without it a
// self-mutating method writes a stack pointer into the receiver's sovereign
// arena and the pointer dangles as soon as the method returns.
//
// The walk stops at a load: &p.f addresses the pointee, not the storage of p,
// so p's own alloca does not escape (legacy: sel.indirect receiver loads the
// pointer without taking an address).
func (fb *ssaFuncBuilder) markAddrEscaping(v SSAValue) {
	markAddrEscapingRec(v, map[SSAValue]bool{}, 0)
}

func (fb *ssaFuncBuilder) buildSelectorAddr(e *syntax.SelectorExpr) (s SSAValue) {
	var addr SSAValue
	var structType Type
	if inner, ok := e.X.(*syntax.SelectorExpr); ok {
		addr = fb.buildSelectorAddr(inner)
		if addr == nil {
			return nil
		}
		structType = addr.SSAType()
		if p2, ok19 := SafeUnderlying(structType).(*Pointer); ok19 {
			structType = p2.Base
		}
		if p3, ok20 := SafeUnderlying(structType).(*Pointer); ok20 {
			ld := &SSAUnOp{Op: OpMul, X: addr}
			ld.typ = structType
			ld.name = fb.nextName()
			fb.emit(ld)
			addr = ld
			structType = p3.Base
		}
	} else if ie2, ok21 := e.X.(*syntax.IndexExpr); ok21 {
		x := fb.buildExpr(ie2.X)
		idx := fb.buildExpr(ie2.Index)
		if x == nil || idx == nil {
			return nil
		}
		if mt, isMap := SafeUnderlying(x.SSAType()).(*TCMap); isMap {
			// A map index is a lookup, not an address. GEP'ing into the
			// hashmap pointer produced a load from the map struct at element
			// offset k, so `m[k].Field` read garbage and crashed.
			lk := &SSALookup{X: x, Index: fb.coerceToInterface(idx, mt.Key)}
			lk.typ = mt.Elem
			lk.name = fb.nextName()
			fb.emit(lk)
			elemT := mt.Elem
			addr = lk
			structType = elemT
			if _, isPtr := SafeUnderlying(elemT).(*Pointer); isPtr {
				// A pointer-valued map element selects through the pointer.
				ld := fb.emitLoad(lk, elemT)
				addr = ld
				structType = elemT
			} else {
				// A map value is not addressable, but reading a field of one
				// is: materialize the looked-up value and select from that.
				// Returning nil here dropped the field select, and the nil
				// argument to the enclosing call then failed arg-count
				// checking - `m[k].Field` read a value the compiler never
				// built.
				alloc := &SSAAlloc{Comment: "mapval.fieldaddr.tmp"}
				alloc.typ = NewPointer(elemT)
				alloc.name = fb.nextName()
				fb.emit(alloc)
				fb.emitStore(alloc, lk)
				addr = alloc
				structType = elemT
			}
		} else {
		ia := &SSAIndexAddr{X: x, Index: idx}
		elemT := ssaIndexElemType(x.SSAType())
		ia.typ = NewPointer(elemT)
		ia.name = fb.nextName()
		fb.emit(ia)
		addr = ia
		structType = elemT
		if _, isPtr := SafeUnderlying(elemT).(*Pointer); isPtr {
			ld := fb.emitLoad(ia, elemT)
			addr = ld
			structType = elemT
		}
		}
	} else {
		// An addressable operand - a local, a package-level global, a free
		// variable - is addressed directly, BEFORE anything is emitted for it.
		// The old order built the operand's VALUE with
		// `x := fb.buildExpr(e.X)` and then replaced it with the variable's
		// alloca, which left the value load in the instruction list as dead IR.
		// For a large struct that dead IR is a full-struct copy: flate.NewWriter
		// (`var dw Writer` then `dw.d.init(w, level)`) emitted
		//   %t5 = call ptr @runtime.alloc(...)
		//   store { ...[131072 x i32], i1, i1 ... } zeroinitializer, ptr %t5
		//   %t6 = load { ...[131072 x i32], i1, i1 ... }, ptr %t5
		// a 640KB copy nothing read, and clang died in
		// SelectionDAG::ReplaceAllUsesWith while combining it. Same class as the
		// discarded receiver in buildCall; here the operand is discarded inside
		// this function rather than by the caller.
		var baseAddr SSAValue
		lookName := ""
		if name3, ok25 := e.X.(*syntax.Name); ok25 {
			lookName = name3.Value
		}
		if lookName != "" {
			obj := fb.lookupObject(lookName)
			if obj != nil {
				if alloc, ok2 := fb.vars[obj]; ok2 {
					baseAddr = alloc
				} else if g, okG := fb.fn.Pkg.Members[lookName].(*SSAGlobal); okG {
					baseAddr = g
				} else if fb.freeVarPtrs != nil {
					if fv2, ok26 := fb.freeVarPtrs[lookName]; ok26 {
						baseAddr = fv2
					}
				}
			}
		}
		if baseAddr != nil && baseAddr.SSAType() != nil {
			// The alloca holds the variable's VALUE. A struct-valued variable
			// is addressed by the alloca itself; a POINTER-valued variable
			// (`o *outer`, the common case) must be loaded first, or the field
			// offset is taken from the stack slot holding the pointer. Getting
			// this wrong read `o.in.n` from the slot itself and printed
			// 2270074 instead of 41.
			bt := baseAddr.SSAType()
			var vt Type
			if bp, isPtr := SafeUnderlying(bt).(*Pointer); isPtr {
				vt = bp.Base
			}
			valIsPtr := false
			if vt != nil {
				if _, isP := SafeUnderlying(vt).(*Pointer); isP {
					valIsPtr = true
				}
			}
			if valIsPtr {
				addr = fb.emitLoad(baseAddr, vt)
				structType = vt
			} else {
				addr = baseAddr
				structType = bt
			}
		} else {
			x := fb.buildExpr(e.X)
			if x == nil || x.SSAType() == nil {
				if name2, ok22 := e.X.(*syntax.Name); ok22 {
					obj := fb.lookupObject(name2.Value)
					if pn2, ok23 := obj.(*PkgName); ok23 {
						return fb.buildPkgMemberAddr(pn2, e.Sel.Value)
					}
				}
				return nil
			}
			baseType := x.SSAType()
			addr = x
			if _, ok24 := SafeUnderlying(baseType).(*Pointer); !ok24 {
				alloc := &SSAAlloc{Comment: "fieldaddr.tmp"}
				alloc.typ = NewPointer(baseType)
				alloc.name = fb.nextName()
				fb.emit(alloc)
				fb.emitStore(alloc, x)
				addr = alloc
				baseType = NewPointer(baseType)
			}
			structType = baseType
		}
		if p4, ok27 := SafeUnderlying(structType).(*Pointer); ok27 {
			structType = p4.Base
		}
	}
	fieldIdx := fb.fieldIndex(structType, e.Sel.Value)
	if fieldIdx < 0 {
		_ = structType
	}
	if fieldIdx >= 0 {
		fa := &SSAFieldAddr{X: addr, Field: fieldIdx}
		fa.typ = NewPointer(fb.fieldType(structType, fieldIdx))
		fa.name = fb.nextName()
		fb.emit(fa)
		return fa
	}
	path := fb.findEmbeddedFieldPath(structType, e.Sel.Value)
	if len(path) >= 2 {
		cur := addr
		curType := structType
		for pi, idx := range path {
			fa := &SSAFieldAddr{X: cur, Field: idx}
			fa.typ = NewPointer(fb.fieldType(curType, idx))
			fa.name = fb.nextName()
			fb.emit(fa)
			curType = fb.fieldType(curType, idx)
			if pi < len(path)-1 {
				if p, ok := SafeUnderlying(curType).(*Pointer); ok {
					ld := &SSAUnOp{Op: OpMul, X: fa}
					ld.typ = curType
					ld.name = fb.nextName()
					fb.emit(ld)
					cur = ld
					curType = p.Base
					continue
				}
			}
			cur = fa
		}
		return cur
	}
	return nil
}

func (fb *ssaFuncBuilder) buildIndex(e *syntax.IndexExpr) (s SSAValue) {
	x := fb.buildExpr(e.X)
	idx := fb.buildExpr(e.Index)
	if x == nil || idx == nil {
		return nil
	}
	if x.SSAType() == nil {
		return nil
	}
	switch t := SafeUnderlying(x.SSAType()).(type) {
	case *TCMap:
		idx = fb.coerceToInterface(idx, t.Key)
		l := &SSALookup{X: x, Index: idx}
		l.typ = t.Elem
		l.name = fb.nextName()
		fb.emit(l)
		return l
	case *Pointer:
		if arr, ok2 := SafeUnderlying(t.Base).(*Array); ok2 {
			ia2 := &SSAIndexAddr{X: x, Index: idx}
			ia2.typ = NewPointer(t.Base)
			ia2.name = fb.nextName()
			fb.emit(ia2)
			return fb.emitLoad(ia2, arr.Elem)
		}
		et := ssaElemType(x.SSAType())
		ia := &SSAIndexAddr{X: x, Index: idx}
		ia.typ = NewPointer(et)
		ia.name = fb.nextName()
		fb.emit(ia)
		return fb.emitLoad(ia, et)
	default:
		et := ssaElemType(x.SSAType())
		ia := &SSAIndexAddr{X: x, Index: idx}
		ia.typ = NewPointer(et)
		ia.name = fb.nextName()
		fb.emit(ia)
		return fb.emitLoad(ia, et)
	}
}

func (fb *ssaFuncBuilder) buildSlice(e *syntax.SliceExpr) (s SSAValue) {
	// Slicing an addressable array must alias its storage: arr[:] passed to
	// a writer mutates arr. Building the array VALUE would slice a copy.
	x := fb.buildArrayAddr(e.X)
	if x != nil {
		// Slicing an addressable array aliases its storage, so the array must
		// outlive the frame (legacy: b.addr(fn, e.X, escaping=true)).
		fb.markAddrEscaping(x)
	} else {
		x = fb.buildExpr(e.X)
	}
	if x == nil {
		return nil
	}
	sl := &SSASlice{X: x}
	if len(e.Index) > 0 && e.Index[0] != nil {
		sl.Low = fb.buildExpr(e.Index[0])
	}
	if len(e.Index) > 1 && e.Index[1] != nil {
		sl.High = fb.buildExpr(e.Index[1])
	}
	if len(e.Index) > 2 && e.Index[2] != nil {
		sl.Max = fb.buildExpr(e.Index[2])
	}
	sl.typ = ssaSliceOf(x.SSAType())
	sl.name = fb.nextName()
	fb.emit(sl)
	return sl
}

// buildArrayAddr returns the address of an addressable array-typed
// expression, or nil if the expression is not an addressable array.
func (fb *ssaFuncBuilder) buildArrayAddr(x syntax.Expr) (s SSAValue) {
	switch ex := x.(type) {
	case *syntax.ParenExpr:
		return fb.buildArrayAddr(ex.X)
	case *syntax.Operation:
		if ex.Y == nil && ex.Op == token.Mul {
			// (*p)[low:high] - p already points at the array
			p := fb.buildExpr(ex.X)
			if p != nil {
				if pt, ok := SafeUnderlying(p.SSAType()).(*Pointer); ok && pt.Base != nil {
					if _, isArr := SafeUnderlying(pt.Base).(*Array); isArr {
						return p
					}
				}
			}
		}
	case *syntax.Name:
		obj := fb.lookupObject(ex.Value)
		if obj == nil || ObjectType(obj) == nil {
			return nil
		}
		if _, isArr := SafeUnderlying(ObjectType(obj)).(*Array); !isArr {
			return nil
		}
		if alloc, ok := fb.vars[obj]; ok {
			return alloc
		}
		if fv, ok := fb.freeVarPtrs[ex.Value]; ok {
			return fv
		}
		if fb.fn.Pkg != nil {
			if g, ok := fb.fn.Pkg.Members[ex.Value].(*SSAGlobal); ok {
				return g
			}
		}
	case *syntax.SelectorExpr:
		// Skip package selectors: pkg.Name is not a field access.
		if name, ok := ex.X.(*syntax.Name); ok {
			if _, isPkg := fb.lookupObject(name.Value).(*PkgName); isPkg {
				return nil
			}
		}
		addr := fb.buildSelectorAddr(ex)
		if addr == nil {
			return nil
		}
		if pt, ok := SafeUnderlying(addr.SSAType()).(*Pointer); ok && pt.Base != nil {
			if _, isArr := SafeUnderlying(pt.Base).(*Array); isArr {
				return addr
			}
		}
		// Not an array field: the stray field-addr GEP is dead code.
		return nil
	case *syntax.IndexExpr:
		var base SSAValue
		if sel, ok2 := ex.X.(*syntax.SelectorExpr); ok2 {
			base = fb.buildSelectorAddr(sel)
		}
		if base == nil {
			base = fb.buildArrayAddr(ex.X)
		}
		if base == nil {
			base = fb.buildExpr(ex.X)
		}
		if base == nil {
			return nil
		}
		bt := base.SSAType()
		if pt, ok := SafeUnderlying(bt).(*Pointer); ok && pt.Base != nil {
			bt = pt.Base
		}
		elem := ssaElemType(bt)
		if elem == nil {
			return nil
		}
		if _, isArr := SafeUnderlying(elem).(*Array); !isArr {
			return nil
		}
		idx := fb.buildExpr(ex.Index)
		if idx == nil {
			return nil
		}
		ia := &SSAIndexAddr{X: base, Index: idx}
		ia.typ = NewPointer(elem)
		ia.name = fb.nextName()
		fb.emit(ia)
		return ia
	}
	return nil
}

func (fb *ssaFuncBuilder) buildAssert(e *syntax.AssertExpr) (s SSAValue) {
	x := fb.buildExpr(e.X)
	assertedType := fb.resolveType(e.Type)
	if x == nil {
		return nil
	}
	ta := &SSATypeAssert{X: x, AssertedType: assertedType, CommaOk: false}
	ta.typ = assertedType
	ta.name = fb.nextName()
	fb.emit(ta)
	return ta
}

func (fb *ssaFuncBuilder) buildCompositeLit(e *syntax.CompositeLit) (s SSAValue) {
	var typ Type
	if e.Type != nil {
		typ = fb.resolveType(e.Type)
	}
	if typ == nil {
		return nil
	}

	if sl, ok := SafeUnderlying(typ).(*Slice); ok {
		return fb.buildSliceLit(e, typ, sl)
	}

	// Moxie string == []byte: []uint8{...} literals resolve to the string
	// type. Build them as byte slices (e.g. token.String's idx table).
	if b, ok := SafeUnderlying(typ).(*Basic); ok && b.Kind == TCString {
		return fb.buildSliceLit(e, typ, NewSlice(Typ[Uint8]))
	}

	if mt, isMap := SafeUnderlying(typ).(*TCMap); isMap {
		return fb.buildMapLit(e, typ, mt)
	}

	if ar, isArr := SafeUnderlying(typ).(*Array); isArr {
		return fb.buildArrayLit(e, typ, ar)
	}

	alloc := fb.emitAlloc(typ, 0)
	if litFullyCovers(e, typ) {
		alloc.NoZero = true
	}
	fb.buildCompositeLitInto(alloc, e, typ)
	return fb.emitLoad(alloc, typ)
}

// buildMapLit builds a map composite literal. A bare `{...}` in key or value
// position carries no type of its own - its type is the map's key/element
// type. buildExpr on an untyped composite literal returns nil, and the entry
// was dropped without a word: map[string]map[string]string{"en": {"k": "v"}}
// built an empty map, and map[string][]string{"a": {"x"}} a zero-length slice.
// Pass the context type down instead, the way storeLitElem does for struct
// fields and slice elements.
func (fb *ssaFuncBuilder) buildMapLit(e *syntax.CompositeLit, typ Type, mt *TCMap) (s SSAValue) {
	mm := &SSAMakeMap{}
	mm.typ = typ
	mm.name = fb.nextName()
	fb.emit(mm)
	for _, el := range e.ElemList {
		if kv, ok := el.(*syntax.KeyValueExpr); ok {
			k := fb.mapLitElem(kv.Key, mt.Key)
			v := fb.mapLitElem(kv.Value, mt.Elem)
			if k != nil && v != nil {
				// The map's key and element types are the shift's context.
				if kb, okB := k.(*SSABinOp); okB && kb.untypedShift {
					retypeUntypedShift(kb, mt.Key)
				}
				if vb, okB := v.(*SSABinOp); okB && vb.untypedShift {
					retypeUntypedShift(vb, mt.Elem)
				}
				fb.checkAssignable(k, mt.Key, "map literal")
				fb.checkAssignable(v, mt.Elem, "map literal")
				k = fb.coerceToInterface(k, mt.Key)
				v = fb.coerceToInterface(v, mt.Elem)
				fb.emit(&SSAMapUpdate{Map: mm, Key: k, Value: v})
			}
		}
	}
	return mm
}

// mapLitElem builds one map literal key or value. A nested composite literal
// written without its type is built against the context type.
func (fb *ssaFuncBuilder) mapLitElem(e syntax.Expr, typ Type) (v SSAValue) {
	if cl, ok := e.(*syntax.CompositeLit); ok && cl.Type == nil {
		return fb.buildCompositeLitWithType(cl, typ)
	}
	return fb.buildExpr(e)
}

func (fb *ssaFuncBuilder) buildArrayLit(e *syntax.CompositeLit, typ Type, ar *Array) (s SSAValue) {
	if ar.Len < 0 {
		ar = NewArray(ar.Elem, int64(len(e.ElemList)))
		typ = ar
	}
	alloc := fb.emitAlloc(typ, 0)
	if litFullyCovers(e, typ) {
		alloc.NoZero = true
	}
	fb.buildCompositeLitInto(alloc, e, typ)
	return fb.emitLoad(alloc, typ)
}

// constArrayLitMinElems is the threshold above which an all-constant
// array literal is lowered to a private constant global + one memcpy
// instead of per-element stores. Below it the per-element path emits
// better code ( immediates, no rodata indirection).
const constArrayLitMinElems = int32(64)

// constArrayLitText formats an all-constant positional array literal as
// an LLVM constant global body "[N x iK] [iK v, ...]". ok is false when
// the literal has keyed elements, non-constant elements, non-integer
// element type, or is below the size threshold.
func (fb *ssaFuncBuilder) constArrayLitText(e *syntax.CompositeLit, ar *Array) (text string, bytes int64, ok bool) {
	n := int32(len(e.ElemList))
	if n < constArrayLitMinElems {
		return "", 0, false
	}
	b, isBasic := SafeUnderlying(ar.Elem).(*Basic)
	if !isBasic {
		return "", 0, false
	}
	var width int32
	var llvmName string
	var signed bool
	switch b.Kind {
	case Int8:
		width, llvmName, signed = 1, "i8", true
	case Uint8:
		width, llvmName = 1, "i8"
	case Int16:
		width, llvmName, signed = 2, "i16", true
	case Uint16:
		width, llvmName = 2, "i16"
	case Int32:
		width, llvmName, signed = 4, "i32", true
	case Uint32, Uintptr:
		width, llvmName = 4, "i32"
	case Int64:
		width, llvmName, signed = 8, "i64", true
	case Uint64:
		width, llvmName = 8, "i64"
	default:
		return "", 0, false
	}
	buf := []byte{:0:n * 8}
	buf = appendStrBytes(buf, "[" | irItoa(n) | " x " | llvmName | "] [")
	for i, el := range e.ElemList {
		var v int64
		switch ex := el.(type) {
		case *syntax.BasicLit:
			if ex.Kind != token.IntLit && ex.Kind != token.RuneLit {
				return "", 0, false
			}
			cv := EvalBasicLitLocal(ex)
			ci, cok := cv.(*ConstInt)
			if !cok {
				return "", 0, false
			}
			v = ci.V
		case *syntax.Operation:
			if ex.Op != token.Sub || ex.Y != nil {
				return "", 0, false
			}
			inner, iok := ex.X.(*syntax.BasicLit)
			if !iok || inner.Kind != token.IntLit {
				return "", 0, false
			}
			cv := EvalBasicLitLocal(inner)
			ci, cok := cv.(*ConstInt)
			if !cok {
				return "", 0, false
			}
			v = -ci.V
		default:
			return "", 0, false
		}
		v = truncIntWidth(v, width, signed)
		if i > 0 {
			buf = mxutil.Ensure(buf, 1)
			buf = push(buf, ',')
		}
		buf = appendStrBytes(buf, " " | llvmName | " ")
		buf = appendStrBytes(buf, irItoa64(v))
	}
	buf = appendStrBytes(buf, "]")
	return string(buf), int64(n) * int64(width), true
}

func truncIntWidth(v int64, width int32, signed bool) (r int64) {
	switch width {
	case 1:
		if signed {
			return int64(int8(v))
		}
		return int64(uint8(v))
	case 2:
		if signed {
			return int64(int16(v))
		}
		return int64(uint16(v))
	case 4:
		if signed {
			return int64(int32(v))
		}
		return int64(uint32(v))
	}
	return v
}

func appendStrBytes(b []byte, s string) (r []byte) {
	r = b
	for i := int32(0); i < int32(len(s)); i++ {
		r = mxutil.Ensure(r, 1)
		r = push(r, s[i])
	}
	return r
}

// tryConstArrayMemcpy lowers `lhs = <const array literal>` to a single
// memcpy from a private constant global into lhs, when the literal
// qualifies (see constArrayLitText). Returns false when not applicable
// and the caller falls back to the normal value path.
func (fb *ssaFuncBuilder) tryConstArrayMemcpy(lhs, rhs syntax.Expr) (handled bool) {
	cl, ok := rhs.(*syntax.CompositeLit)
	if !ok || cl.Type == nil {
		return false
	}
	typ := fb.resolveType(cl.Type)
	if typ == nil {
		return false
	}
	ar, isArr := SafeUnderlying(typ).(*Array)
	if !isArr {
		return false
	}
	text, bytes, cok := fb.constArrayLitText(cl, ar)
	if !cok {
		return false
	}
	var dst SSAValue
	switch lv := lhs.(type) {
	case *syntax.Name:
		if lv.Value == "_" {
			return false
		}
		obj := fb.lookupObject(lv.Value)
		if obj == nil {
			return false
		}
		if alloc, ok2 := fb.vars[obj]; ok2 {
			dst = alloc
		} else if fv, ok3 := fb.freeVarPtrs[lv.Value]; ok3 {
			dst = fv
		} else if g2, ok4 := fb.fn.Pkg.Members[lv.Value].(*SSAGlobal); ok4 {
			dst = g2
		} else if v, ok6 := obj.(*TCVar); ok6 && v.Pkg != nil && v.Pkg != fb.fn.Pkg.Pkg {
			impPkg := fb.ensureImportedSSAPackage(v.Pkg)
			g3, ok7 := impPkg.Members[lv.Value].(*SSAGlobal)
			if !ok7 {
				g3 = &SSAGlobal{name: lv.Value, typ: NewPointer(v.Typ), pkg: impPkg}
				impPkg.SetMember(lv.Value, g3)
			}
			dst = g3
		}
	case *syntax.SelectorExpr:
		dst = fb.buildSelectorAddr(lv)
	case *syntax.Operation:
		if lv.Y == nil && lv.Op == token.Mul {
			dst = fb.buildExpr(lv.X)
		}
	}
	if dst == nil {
		return false
	}
	fb.emit(&SSAConstMemCpy{Dst: dst, ConstText: text, Bytes: bytes})
	return true
}

func (fb *ssaFuncBuilder) buildCompositeLitWithType(e *syntax.CompositeLit, typ Type) (s SSAValue) {
	if sl, ok := SafeUnderlying(typ).(*Slice); ok {
		return fb.buildSliceLit(e, typ, sl)
	}
	if ar, isArr := SafeUnderlying(typ).(*Array); isArr {
		return fb.buildArrayLit(e, typ, ar)
	}
	if mt, isMap := SafeUnderlying(typ).(*TCMap); isMap {
		return fb.buildMapLit(e, typ, mt)
	}
	alloc := fb.emitAlloc(typ, 0)
	if litFullyCovers(e, typ) {
		alloc.NoZero = true
	}
	fb.buildCompositeLitInto(alloc, e, typ)
	return fb.emitLoad(alloc, typ)
}

// buildCompositeLitInto writes a composite literal into dst (a pointer to
// typ) with direct field/index stores instead of building a temporary
// aggregate value per element. Nested array and struct literals recurse.
func (fb *ssaFuncBuilder) buildCompositeLitInto(dst SSAValue, e *syntax.CompositeLit, typ Type) {
	if ar, isArr := SafeUnderlying(typ).(*Array); isArr {
		posIdx := int32(0)
		for _, el := range e.ElemList {
			expr := syntax.Expr(el)
			idx := posIdx
			if kv, ok := el.(*syntax.KeyValueExpr); ok {
				expr = kv.Value
				if bl, ok2 := kv.Key.(*syntax.BasicLit); ok2 {
					if ci, ok3 := EvalBasicLitLocal(bl).(*ConstInt); ok3 {
						idx = int32(ci.V)
					}
				}
			}
			posIdx++
			ia := &SSAIndexAddr{X: dst, Index: &SSAConst{typ: Typ[Int32], val: &ConstInt{V: int64(idx)}}}
			ia.typ = NewPointer(ar.Elem)
			ia.name = fb.nextName()
			fb.emit(ia)
			fb.storeLitElem(ia, expr, ar.Elem, "array or slice literal")
		}
		return
	}
	if _, isStruct := SafeUnderlying(typ).(*TCStruct); isStruct {
		posIdx := int32(0)
		for _, el := range e.ElemList {
			expr := syntax.Expr(el)
			idx := posIdx
			if kv, ok := el.(*syntax.KeyValueExpr); ok {
				expr = kv.Value
				if nm, ok2 := kv.Key.(*syntax.Name); ok2 {
					idx = fb.fieldIndex(typ, nm.Value)
				}
			}
			posIdx++
			if idx < 0 {
				continue
			}
			ft := fb.fieldType(typ, idx)
			fa := &SSAFieldAddr{X: dst, Field: idx}
			fa.typ = NewPointer(ft)
			fa.name = fb.nextName()
			fb.emit(fa)
			fb.storeLitElem(fa, expr, ft, "struct literal")
		}
		return
	}
	// A pointer-to-aggregate target is the `&T{...}` shorthand an untyped
	// literal carries in tables like
	//   formTable = []*formInfo{{ form: NFC, ... }}
	//   return []*cipherSuite{{ ID: TLS_RSA_..., ... }}
	// The element `{...}` has no type of its own: it means &formInfo{...}. The
	// pointee has to be allocated, filled, and its ADDRESS stored in dst.
	if p, isPtr := SafeUnderlying(typ).(*Pointer); isPtr {
		if _, isStruct := SafeUnderlying(p.Base).(*TCStruct); isStruct {
			alloc := fb.emitAlloc(p.Base, 0)
			if litFullyCovers(e, p.Base) {
				alloc.NoZero = true
			}
			fb.buildCompositeLitInto(alloc, e, p.Base)
			fb.emitStore(dst, alloc)
			return
		}
	}
	// A non-aggregate target with NO elements is the port's spelling of Go's
	// new(T) for a scalar Named type:
	//   http2settingsTimerMsg = &http2serverMessage{}   // Go: new(serverMessage)
	// dst is already an allocation of exactly typ and the allocator zeroes it,
	// so there is nothing to store: the address is the whole result. This is
	// also the true root of the net/http segfault - the old fallback called
	// buildExpr(e) on this same node, and because the literal still carried its
	// type that path allocated and came straight back here (gdb: resolveTypeAST
	// <- resolveType <- buildCompositeLit <- buildExpr <- buildCompositeLitInto,
	// repeating), overflowing the stack. Elements cannot be stored into a scalar
	// at all, so only that case is an error.
	if len(e.ElemList) == 0 {
		return
	}
	cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
	push(cctx.compileErrors, fb.errPos() | "composite literal of non-aggregate type " | typ.String())
}

// storeLitElem stores one composite-literal element at dst. An untyped nested
// literal is written directly into dst so no temporary aggregate is created.
func (fb *ssaFuncBuilder) storeLitElem(dst SSAValue, expr syntax.Expr, elemTyp Type, what string) {
	if cl, ok := expr.(*syntax.CompositeLit); ok && cl.Type == nil {
		fb.buildCompositeLitInto(dst, cl, elemTyp)
		return
	}
	v := fb.buildExpr(expr)
	if v == nil {
		return
	}
	// The element type is the shift's context, like an assignment.
	if bin, okB := v.(*SSABinOp); okB && bin.untypedShift {
		retypeUntypedShift(bin, elemTyp)
	}
	fb.checkAssignable(v, elemTyp, what)
	v = fb.coerceToInterface(v, elemTyp)
	fb.emitStore(dst, v)
}

// litFullyCovers reports whether a positional composite literal specifies
// every element/field of typ, so an alloca holding it needs no zero-init.
func litFullyCovers(e *syntax.CompositeLit, typ Type) (ok bool) {
	if ar, isArr := SafeUnderlying(typ).(*Array); isArr {
		if int64(len(e.ElemList)) != ar.Len {
			return false
		}
		for _, el := range e.ElemList {
			if _, isKV := el.(*syntax.KeyValueExpr); isKV {
				return false
			}
		}
		return true
	}
	if st, isStruct := SafeUnderlying(typ).(*TCStruct); isStruct {
		if int32(len(e.ElemList)) != int32(len(st.Fields)) {
			return false
		}
		for _, el := range e.ElemList {
			if _, isKV := el.(*syntax.KeyValueExpr); isKV {
				return false
			}
		}
		return true
	}
	return false
}

func (fb *ssaFuncBuilder) buildSliceLit(e *syntax.CompositeLit, typ Type, sl *Slice) (s SSAValue) {
	n := len(e.ElemList)
	nVal := &SSAConst{typ: Typ[Int32], val: &ConstInt{V:int64(n)}}
	ms := &SSAMakeSlice{}
	ms.typ = typ
	ms.name = fb.nextName()
	ms.Len = nVal
	ms.Cap = nVal
	fb.emit(ms)

	elemTyp := sl.Elem
	for i, el := range e.ElemList {
		var expr syntax.Expr
		if kv, ok := el.(*syntax.KeyValueExpr); ok {
			expr = kv.Value
		} else {
			expr = el
		}
		var v SSAValue
		if cl, ok := expr.(*syntax.CompositeLit); ok && cl.Type == nil {
			v = fb.buildCompositeLitWithType(cl, elemTyp)
		} else {
			v = fb.buildExpr(expr)
		}
		if v == nil {
			continue
		}
		if bin, okB := v.(*SSABinOp); okB && bin.untypedShift {
			retypeUntypedShift(bin, elemTyp)
		}
		fb.checkAssignable(v, elemTyp, "array or slice literal")
		idx := &SSAConst{typ: Typ[Int32], val: &ConstInt{V:int64(i)}}
		ia := &SSAIndexAddr{X: ms, Index: idx}
		ia.typ = NewPointer(elemTyp)
		ia.name = fb.nextName()
		fb.emit(ia)
		v = fb.coerceToInterface(v, elemTyp)
		fb.emitStore(ia, v)
	}
	return ms
}

func (fb *ssaFuncBuilder) buildFuncLit(e *syntax.FuncLit) (s SSAValue) {
	var sig *Signature
	if fb.info != nil {
		if tv, ok := fb.info.Types[e]; ok {
			sig, _ = tv.Type.(*Signature)
		}
	}
	if sig == nil && e.Type != nil {
		sig = tcResolveFuncInline(e.Type, fb.fn.Pkg.Pkg.Scope)
	}
	name := fb.fn.name | "__anon" | ssaItoa(len(fb.fn.AnonFuncs)+1)
	anon := &SSAFunction{
		name:      name,
		Signature: sig,
		pos:       0,
		Pkg:       fb.fn.Pkg,
		Prog:      fb.fn.Prog,
		parent:    fb.fn,
	}
	fb.fn.AnonFuncs = mxutil.Ensure(fb.fn.AnonFuncs, 1)
	push(fb.fn.AnonFuncs, anon)

	ab := newSSAFuncBuilder(anon, fb.info)
	ab.parent = fb
	// Closures inside monomorphized bodies need the same generic context as
	// their parent, or calls to source-package functions silently vanish.
	ab.typeSubst = fb.typeSubst
	ab.srcScope = fb.srcScope
	ab.fileScope = fb.fileScope
	d := &syntax.FuncDecl{
		Name: &syntax.Name{Value: name},
		Type: e.Type,
		Body: e.Body,
	}
	ab.buildBody(d)

	if len(anon.FreeVars) == 0 {
		mc0 := &SSAMakeClosure{Fn: anon}
		mc0.typ = sig
		mc0.name = fb.nextName()
		fb.emit(mc0)
		return mc0
	}
	bindings := []SSAValue{:0:len(anon.FreeVars)}
	for _, fv := range anon.FreeVars {
		obj := fb.lookupObject(fv.name)
		if obj != nil {
			if alloc, ok := fb.vars[obj]; ok {
				alloc.Heap = true
				push(bindings, alloc)
			} else if pfv2, ok28 := fb.freeVarPtrs[fv.name]; ok28 {
				push(bindings, pfv2)
			} else {
				// No live slot for this captured name. Binding a nil pointer
				// here produced a closure that called through a null captured
				// value, and the program died at run time with "indirect call
				// to null" in a frame unrelated to the capture (smesh's
				// create-vault UI). Fail at compile time and name it.
				cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
				push(cctx.compileErrors, fb.fn.name | ": closure capture '" | fv.name | "' has no live slot")
				push(bindings, &SSAConst{typ: NewPointer(fv.typ), val: nil})
			}
		} else if pfv, ok := fb.freeVarPtrs[fv.name]; ok {
			push(bindings, pfv)
		} else {
			cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
			push(cctx.compileErrors, fb.fn.name | ": closure capture '" | fv.name | "' has no live slot")
			push(bindings, &SSAConst{typ: NewPointer(fv.typ), val: nil})
		}
	}
	mc := &SSAMakeClosure{Fn: anon, Bindings: bindings}
	mc.typ = sig
	mc.name = fb.nextName()
	fb.emit(mc)
	return mc
}

func (fb *ssaFuncBuilder) saveVars() (m map[Object]*SSAAlloc) {
	saved := map[Object]*SSAAlloc{}
	for k, v := range fb.vars {
		saved[k] = v
	}
	return saved
}

func (fb *ssaFuncBuilder) saveVarScopes() (m map[Object]int32) {
	saved := map[Object]int32{}
	for k, v := range fb.varScope {
		saved[k] = v
	}
	return saved
}

// scopeVars is the binding snapshot taken when a block is entered.
type scopeVars struct {
	prev  int32
	vars  map[Object]*SSAAlloc
	scope map[Object]int32
}

// enterBlock enters a nested scope. exitBlock leaves it and drops the bindings
// the block introduced, so a name declared inside a block is undefined after
// it - the same thing go/types gives the legacy compiler. Without the restore a
// later sibling statement resolved the name to the dead binding instead of
// reporting it undefined.
func (fb *ssaFuncBuilder) enterBlock() (s scopeVars) {
	s.prev = fb.enterScope()
	s.vars = fb.saveVars()
	s.scope = fb.saveVarScopes()
	return s
}

func (fb *ssaFuncBuilder) exitBlock(s scopeVars) {
	fb.vars = s.vars
	fb.varScope = s.scope
	fb.exitScope(s.prev)
}

func (fb *ssaFuncBuilder) removeVar(name string) {
	// Delete ALL matching Objects. A map iteration would be nondeterministic
	// if multiple Objects share the same name (scope shadowing), so collect
	// matches first, then delete.
	var matches []Object
	for o := range fb.vars {
		if ObjectName(o) == name {
			matches = mxutil.Ensure(matches, 1)
			push(matches, o)
		}
	}
	for _, o := range matches {
		delete(fb.vars, o)
	}
}


func (fb *ssaFuncBuilder) buildPkgMemberAddr(pn *PkgName, memberName string) (s SSAValue) {
	imported := pn.Imported
	if imported == nil {
		return nil
	}
	obj := imported.Scope.Lookup(memberName)
	if obj == nil {
		return nil
	}
	switch ob := obj.(type) {
	case *TCConst:
		return nil
	case *TCVar:
		impPkg := fb.ensureImportedSSAPackage(imported)
		g, ok := impPkg.Members[memberName].(*SSAGlobal)
		if !ok {
			g = &SSAGlobal{
				name: memberName,
				typ:  NewPointer(ob.Typ),
				pkg:  impPkg,
			}
			impPkg.SetMember(memberName, g)
		}
		return g
	}
	return nil
}

func (fb *ssaFuncBuilder) buildPkgCall(pn *PkgName, funcName string, argList []syntax.Expr, hasDots bool) (s SSAValue) {
	imported := pn.Imported
	if imported == nil {
		return nil
	}
	if imported.Path == "os" && funcName == "Exit" && isUserPackagePath(restrictPath(fb.fn.Pkg.Pkg.Path)) {
		// Legal, but it ends the process without running deferred cleanup, so
		// whatever the program owns - a scratch tree, a lock, a socket - is
		// left behind. Warn; do not reject, a short-lived tool may mean it.
		mxutil.WriteStr(2, "  warning: os.Exit does not run deferred cleanup in " | fb.fn.Pkg.Pkg.Path | "\n")
	}
	if imported.Path == "unsafe" && (funcName == "Slice" || funcName == "String") {
		// string and []byte are the same type: unsafe.String(ptr, len) is
		// unsafe.Slice with a byte element, which already yields string.
		return fb.buildUnsafeSlice(argList)
	}
	if imported.Path == "unsafe" && (funcName == "SliceData" || funcName == "StringData") {
		arg := fb.buildExpr(argList[0])
		extract := &SSAExtract{Tuple: arg, Index: 0}
		// The declared results are *byte (StringData) and *T (SliceData), not
		// unsafe.Pointer. Pointing the value at the element type keeps the
		// type honest, so passing it to a *byte parameter - every wasm bridge
		// does - is the assignment Go also allows, instead of an implicit
		// unsafe.Pointer-to-*byte conversion that neither compiler permits.
		var elemT Type = Typ[Uint8]
		if funcName == "SliceData" {
			if sl, isSl := SafeUnderlying(arg.SSAType()).(*Slice); isSl && sl.Elem != nil {
				elemT = sl.Elem
			}
		}
		extract.typ = NewPointer(elemT)
		extract.name = fb.nextName()
		extract.setBlock(fb.currentBlock)
		fb.currentBlock.Instrs = mxutil.Ensure(fb.currentBlock.Instrs, 1)
		push(fb.currentBlock.Instrs, extract)
		return extract
	}
	if imported.Path == "unsafe" && funcName == "Add" {
		if len(argList) != 2 {
			return nil
		}
		ptr := fb.buildExpr(argList[0])
		offset := fb.buildExpr(argList[1])
		idx := &SSAIndexAddr{X: ptr, Index: offset}
		// unsafe.Add is declared `func Add(ptr Pointer, len IntegerType)
		// Pointer`, and the runtime hands its result straight to functions
		// that take unsafe.Pointer (every memcpy call). Typing it as the
		// element pointer - the old NewPointer(Uint8) - made those arguments
		// look like `*uint8` where a Pointer is wanted, so enabling the
		// assignability check outside user code reported 53 false errors in
		// runtime. Take the declared type from the unsafe package and keep
		// byteStepping in the emitter.
		var ptrType Type = Typ[UnsafePointer]
		if ptrObj := imported.Scope.Lookup("Pointer"); ptrObj != nil {
			if tn, ok2 := ptrObj.(*TypeName); ok2 && tn.Typ != nil {
				ptrType = tn.Typ
			}
		}
		idx.typ = ptrType
		idx.byteStep = true
		idx.name = fb.nextName()
		idx.setBlock(fb.currentBlock)
		fb.currentBlock.Instrs = mxutil.Ensure(fb.currentBlock.Instrs, 1)
		push(fb.currentBlock.Instrs, idx)
		return idx
	}
	if imported.Path == "unsafe" && funcName == "Sizeof" {
		// Typed uintptr, not Int64: the folded value is the target's word
		// width, and giving it i64 on wasm32 made every consumer that passes
		// it to a uintptr parameter - notably runtime.alloc's size - call
		// with a mismatched signature, which LLVM lowers to unreachable.
		sz := int64(8)
		if len(argList) == 1 {
			// The operand is not evaluated (Go spec); operandType gets its
			// type without leaving IR behind.
			if t := fb.operandType(argList[0]); t != nil {
				sz = TypeSize(t)
			}
		}
		return NewSSAConst(&ConstInt{V:sz}, fb.wordType())
	}
	if imported.Path == "unsafe" && funcName == "Alignof" {
		al := int64(8)
		if len(argList) == 1 {
			if t := fb.operandType(argList[0]); t != nil {
				al = TypeAlign(t)
			}
		}
		return NewSSAConst(&ConstInt{V:al}, fb.wordType())
	}
	if imported.Path == "unsafe" && funcName == "TypeOf" {
		if len(argList) != 1 {
			return nil
		}
		arg := fb.buildExpr(argList[0])
		if arg == nil || arg.SSAType() == nil {
			return nil
		}
		td := &SSATypeDesc{t: arg.SSAType()}
		td.typ = Typ[UnsafePointer]
		td.name = fb.nextName()
		td.setBlock(fb.currentBlock)
		fb.currentBlock.Instrs = mxutil.Ensure(fb.currentBlock.Instrs, 1)
		push(fb.currentBlock.Instrs, td)
		return td
	}
	if imported.Path == "unsafe" && funcName == "Offsetof" {
		off := int64(0)
		if len(argList) == 1 {
			if o, offOK := fb.evalOffsetofArg(argList[0]); offOK {
				off = o
			}
		}
		return NewSSAConst(&ConstInt{V:off}, fb.wordType())
	}
	if imported.Path == "internal/abi" && (funcName == "Escape" || funcName == "NoEscape") {
		// Escape is a no-op identity in the arena model (values are
		// serialized across function returns regardless); NoEscape
		// passes the pointer through.
		if len(argList) == 1 {
			return fb.buildExpr(argList[0])
		}
		return nil
	}
	if result, handled := fb.tryGenericPkgCall(pn, funcName, argList, hasDots); handled {
		return result
	}
	obj := imported.Scope.Lookup(funcName)
	if obj == nil {
		// Fail loud: a dropped call compiles the caller to garbage
		// (zeroinitializer returns) and crashes far from the cause.
		cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
		push(cctx.compileErrors,
			"undefined: "|imported.Path|"."|funcName|" (called from "|fb.fn.name|")")
		return nil
	}
	fn, ok := obj.(*TCFunc)
	if !ok {
		return nil
	}
	impPkg := fb.ensureImportedSSAPackage(imported)
	ssaFn := impPkg.Func(funcName)
	if ssaFn == nil {
		ssaFn = &SSAFunction{
			name:      funcName,
			object:    fn,
			Signature: fn.Typ.(*Signature),
			Pkg:       impPkg,
			Prog:      fb.fn.Prog,
		}
		if isNoContextExtern(imported.Path, funcName) {
			ssaFn.isExternC = true
		}
		impPkg.SetMember(funcName, ssaFn)
	}
	args := fb.buildArgs(argList)
	var retType Type
	if ssaFn.Signature != nil {
		fb.checkCallArgs(args, ssaFn.Signature, hasDots)
		if ssaFn.Signature.Variadic && !hasDots {
			args = fb.wrapVariadicArgs(args, ssaFn.Signature)
		}
		args = fb.coerceArgsToInterface(args, ssaFn.Signature)
		if ssaFn.Signature.Results != nil && ssaFn.Signature.Results.Len() == 1 {
			retType = ssaFn.Signature.Results.At(0).Typ
		} else if ssaFn.Signature.Results != nil && ssaFn.Signature.Results.Len() > 1 {
			retType = ssaFn.Signature.Results
		}
	}
	call := &SSACall{Call: SSACallCommon{Value: ssaFn, Args: args}}
	call.typ = retType
	call.name = fb.nextName()
	fb.emit(call)
	if retType == nil {
		return nil
	}
	return call
}

func (fb *ssaFuncBuilder) buildUnsafeSlice(argList []syntax.Expr) (s SSAValue) {
	if len(argList) < 2 {
		return nil
	}
	ptrVal := fb.buildExpr(argList[0])
	lenVal := fb.buildExpr(argList[1])
	if ptrVal == nil || lenVal == nil {
		return nil
	}
	var elemType Type
	if pt, ok := SafeUnderlying(ptrVal.SSAType()).(*Pointer); ok {
		elemType = pt.Base
	}
	if elemType == nil {
		elemType = Typ[Uint8]
	}
	ms := &SSAMakeSlice{Len: lenVal, Cap: lenVal, Data: ptrVal}
	if b, ok := elemType.(*Basic); ok && b.Kind == Uint8 {
		ms.typ = Typ[TCString]
	} else {
		ms.typ = NewSlice(elemType)
	}
	ms.name = fb.nextName()
	fb.emit(ms)
	return ms
}

// Helpers.

func (fb *ssaFuncBuilder) lookupObject(name string) (o Object) {
	for obj := range fb.vars {
		if ObjectName(obj) == name {
			return obj
		}
	}
	if fb.parent != nil {
		for obj := range fb.parent.vars {
			if ObjectName(obj) == name {
				return obj
			}
		}
	}
	if fb.srcScope != nil {
		if _, obj := fb.srcScope.LookupParent(name); obj != nil {
			return obj
		}
	}
	if fb.fileScope != nil {
		if _, obj := fb.fileScope.LookupParent(name); obj != nil {
			return obj
		}
	}
	if fb.fn.Pkg != nil {
		if _, obj := fb.fn.Pkg.Pkg.Scope.LookupParent(name); obj != nil {
			return obj
		}
	}
	if fb.info != nil {
		return nil
	}
	return nil
}

// nameResolves reports whether a bare identifier statement refers to a defined
// symbol (local, parent free var, package member, predeclared, or builtin).
// Removed Go names (int, make, fallthrough, go, ...) are not registered
// anywhere, so they resolve false and report "undefined", matching the legacy
// compiler's go/types behavior.
func (fb *ssaFuncBuilder) nameResolves(n *syntax.Name) (ok bool) {
	if n.Value == "nil" {
		return true
	}
	if fb.localConsts != nil {
		if _, haveConst := fb.localConsts[n.Value]; haveConst {
			return true
		}
	}
	if fb.lookupObject(n.Value) != nil {
		return true
	}
	if fb.info != nil {
		if fb.info.Uses[n] != nil {
			return true
		}
	}
	if fb.parent != nil {
		for p := fb.parent; p != nil; p = p.parent {
			if p.localConsts != nil {
				if _, parentConst := p.localConsts[n.Value]; parentConst {
					return true
				}
			}
			for pobj := range p.vars {
				if ObjectName(pobj) == n.Value {
					return true
				}
			}
			if p.freeVarPtrs != nil {
				if _, isFree := p.freeVarPtrs[n.Value]; isFree {
					return true
				}
			}
		}
	}
	if fb.fn.Pkg != nil {
		if fb.fn.Pkg.Members[n.Value] != nil {
			return true
		}
	}
	if _, isBuiltin := ssaBuiltinID(n.Value); isBuiltin {
		return true
	}
	return false
}

func (fb *ssaFuncBuilder) getOrCreateFreeVar(name string, typ Type) (s SSAValue) {
	for _, fv2 := range fb.fn.FreeVars {
		if fv2.name == name {
			return fv2
		}
	}
	fv := &SSAFreeVar{
		name:   name,
		typ:    typ,
		parent: fb.fn,
	}
	fb.fn.FreeVars = mxutil.Ensure(fb.fn.FreeVars, 1)
	push(fb.fn.FreeVars, fv)
	if fb.freeVarPtrs == nil {
		fb.freeVarPtrs = map[string]*SSAFreeVar{}
	}
	fb.freeVarPtrs[name] = fv
	// Propagate the capture through every enclosing closure up to the frame
	// that owns the name. A grandchild's reference used to stop here, so an
	// intermediate closure held no slot for it and the make-closure binding
	// built in that frame bound nil. The program then called through a null
	// captured value and died with "indirect call to null" in a frame with no
	// relation to the capture (smesh's create-vault UI; 50 such captures
	// across the app). Inner closure bodies are built before the enclosing
	// closure value is created, so adding to each frame here is in time for
	// that frame's binding list.
	for p := fb.parent; p != nil; p = p.parent {
		if p.freeVarPtrs != nil {
			if _, have := p.freeVarPtrs[name]; have {
				break
			}
		}
		owns := false
		for pobj := range p.vars {
			if ObjectName(pobj) == name {
				owns = true
				break
			}
		}
		if owns {
			break
		}
		pf := &SSAFreeVar{name: name, typ: typ, parent: p.fn}
		p.fn.FreeVars = mxutil.Ensure(p.fn.FreeVars, 1)
		push(p.fn.FreeVars, pf)
		if p.freeVarPtrs == nil {
			p.freeVarPtrs = map[string]*SSAFreeVar{}
		}
		p.freeVarPtrs[name] = pf
	}
	return fv
}


// derefValueRecv loads the receiver through the pointer when a value-receiver
// method is called on a pointer: the definition takes the receiver by value
// (an LLVM aggregate), so passing the raw pointer reinterprets pointer bits
// as field data.
// methodNeedsAddr reports whether a resolved method call needs its operand's
// address: the method has a pointer receiver while the built receiver is a
// value.
func (fb *ssaFuncBuilder) methodNeedsAddr(fn *SSAFunction, recv SSAValue) (ok bool) {
	if fn == nil || recv == nil || fn.Signature == nil || fn.Signature.Recv == nil {
		return false
	}
	if _, recvIsPtr := SafeUnderlying(fn.Signature.Recv.Typ).(*Pointer); !recvIsPtr {
		return false
	}
	if _, haveIsPtr := SafeUnderlying(recv.SSAType()).(*Pointer); haveIsPtr {
		return false
	}
	return true
}

func (fb *ssaFuncBuilder) derefValueRecv(fn *SSAFunction, recv SSAValue) (s SSAValue) {
	if fn == nil || recv == nil || fn.Signature == nil || fn.Signature.Recv == nil {
		return recv
	}
	// All receivers are ptr in Moxie. If the Signature says value receiver
	// and the caller has a pointer, pass it through (already ptr).
	// If the caller has a value, take its address.
	if _, recvIsPtr := SafeUnderlying(fn.Signature.Recv.Typ).(*Pointer); recvIsPtr {
		return recv
	}
	// Source-level value receiver - function now expects ptr.
	// If recv is already a pointer, pass through.
	if _, ok := SafeUnderlying(recv.SSAType()).(*Pointer); ok {
		return recv
	}
	// recv is a value - take its address by storing to an alloca.
	alloc := fb.emitAlloc(recv.SSAType(), 0)
	fb.emitStore(alloc, recv)
	return alloc
}

// builtinMethod finds a method in a builtin type's method set. The
// universe (pkg/types) declares String() on every builtin and on the
// universe aliases byte, rune and uintptr; the bodies live in
// src/runtime/stringer.mx.
func builtinMethod(t Type, name string) (m *TCFunc) {
	switch tt := t.(type) {
	case *Basic:
		for i := int32(0); i < tt.NumMethods(); i++ {
			if mm := tt.Method(i); mm.Name == name {
				return mm
			}
		}
	case *Named:
		for i := int32(0); i < tt.NumMethods(); i++ {
			if mm := tt.Method(i); mm.Name == name {
				return mm
			}
		}
	}
	return nil
}

func typeDeclName(t Type) (s string) {
	switch tt := t.(type) {
	case *Basic:
		return tt.Name
	case *Named:
		if tt.Obj != nil {
			return tt.Obj.Name
		}
	}
	return ""
}

// resolveBuiltinMethod resolves a call to a method whose body the runtime
// provides. Inside the runtime package the call is the local definition;
// anywhere else it is the ordinary ctx-carrying cross-package call. Moxie's
// receiver ABI is a pointer even for a value receiver, so the caller
// materialises the value and passes its address.
func (fb *ssaFuncBuilder) resolveBuiltinMethod(t Type, typeName string, sel *syntax.SelectorExpr, recv SSAValue) (rfn *SSAFunction, rrecv SSAValue, ok bool) {
	if !buildTagTrue("moxie.stringer") {
		// Without the tag the runtime carries no builtin String() bodies,
		// so there is no symbol to resolve to.
		return nil, nil, false
	}
	if typeName == "" || recv == nil || recv.SSAType() == nil {
		return nil, nil, false
	}
	m := builtinMethod(t, sel.Sel.Value)
	if m == nil || m.Signature() == nil {
		return nil, nil, false
	}
	target := recv
	if _, isP := SafeUnderlying(recv.SSAType()).(*Pointer); !isP {
		// Allocate the RESOLVED type, not the operand's. The method was chosen
		// on the default type (UntypedToTyped maps an untyped int to int64) and
		// the runtime body reads at that width, while an untyped constant
		// operand is materialised at the width it was folded to - i32 for
		// `(42)`. Allocating the operand's width made `(*int64).String` read 8
		// bytes out of a 4-byte alloca and report 42<<32|42; `(1<<26).String()`
		// reported 67108864<<32|67108864. emitStore widens the operand to the
		// alloca's type, so the constant arrives sign-correct.
		alloc := fb.emitAlloc(t, 0)
		fb.emitStore(alloc, recv)
		target = alloc
	}
	// The runtime declares the body under the underlying type's name (byte
	// and rune are aliases of uint8 and int32 in the legacy compiler).
	mangled := "(*" | builtinAliasName(typeName) | ")." | sel.Sel.Value
	if fb.fn.Pkg != nil && fb.fn.Pkg.Pkg != nil && fb.fn.Pkg.Pkg.Path == "runtime" {
		// The runtime defines this method: reference the symbol without
		// re-registering the member that holds the definition.
		fn := &SSAFunction{name: mangled, Signature: m.Signature(), Pkg: fb.fn.Pkg, Prog: fb.fn.Prog}
		return fn, target, true
	}
	rtPkg := cctx.universe.Registry["runtime"]
	if rtPkg == nil {
		return nil, nil, false
	}
	impPkg := fb.ensureImportedSSAPackage(rtPkg)
	return impPkg.ExternalFunc(mangled, m.Signature()), target, true
}

func (fb *ssaFuncBuilder) resolveMethodCallWithRecv(sel *syntax.SelectorExpr, recv SSAValue) (rfn *SSAFunction, rrecv SSAValue) {
	typ := recv.SSAType()
	if typ == nil {
		return nil, nil
	}
	isPtr := false
	if p5, ok35 := SafeUnderlying(typ).(*Pointer); ok35 {
		typ = p5.Base
		isPtr = true
	}
	// A method on a GENERIC type is only reachable through the
	// monomorphizing path (tryGenericMethodCall): an instantiation is emitted
	// under a mangled name and the generic declaration itself emits no symbol,
	// so resolving one here produced a call to a symbol nobody defines
	// ("undefined symbol: main.(*Box).get") and skipped the substitution of
	// the type arguments. Hand it to the generic path.
	// The presence of TArgs, not TParams, is the signal: an instantiated Named
	// carries the arguments, while its TParams list is empty whenever the base
	// declaration's parameter list was not recorded (src/internal/trace's
	// queue[Event] arrives as tparams=0 targs=1). Testing TParams let the plain
	// path resolve `o.queue.pop()` to the unmangled trace.(*queue).pop.
	if gn, okg := typ.(*Named); okg && (len(gn.TParams) > 0 || len(gn.TArgs) > 0) {
		return nil, nil
	}
	if _, ok36 := SafeUnderlying(typ).(*TCInterface); ok36 {
		if named2, ok37 := typ.(*Named); !ok37 || named2.NumMethods() == 0 {
			return nil, nil
		}
	}
	// A builtin receiver's methods are the universe's synthetic set (String
	// on every builtin); the runtime provides the bodies. Resolve through
	// that set, exactly as a Named type resolves its own methods.
	if basic, ok38 := typ.(*Basic); ok38 {
		resolved := UntypedToTyped(basic)
		if resolved == nil {
			resolved = basic
		}
		// An unsigned-marked constant does not fit int64, and the default type
		// for an untyped int is int64, so `(1<<64-1).String()` resolved to
		// (*int64).String and printed -1. Go rejects the expression outright
		// (the constant overflows int); uint64 is the type that holds it.
		if constIntUnsigned(recv) {
			resolved = Typ[Uint64]
		}
		switch rt := resolved.(type) {
		case *Basic:
			if bfn, brc, okb := fb.resolveBuiltinMethod(rt, rt.Name, sel, recv); okb {
				return bfn, brc
			}
			return nil, nil
		case *Named:
			typ = rt
		default:
			return nil, nil
		}
	}
	named, ok := typ.(*Named)
	if !ok {
		return nil, nil
	}
	typeName := ""
	if named.Obj != nil {
		typeName = named.Obj.Name
	}
	if typeName == "" {
		return nil, nil
	}
	// byte, rune and uintptr are universe types with no package: their
	// String() bodies live in the runtime exactly like the builtins'.
	if named.Obj != nil && named.Obj.Pkg == nil {
		if bfn, brc, okb := fb.resolveBuiltinMethod(named, typeName, sel, recv); okb {
			return bfn, brc
		}
	}
	resolveNamed := named
	// Try registry for types imported from other packages,
	// since local named copies may only have interface methods (Underlying/String)
	// and lack the actual declared methods (Len, Elem, etc).
	samePackage := false
	if resolveNamed.Obj != nil && resolveNamed.Obj.Pkg != nil {
		samePackage = resolveNamed.Obj.Pkg.Path == fb.fn.Pkg.Pkg.Path
	}
	if !samePackage && resolveNamed.Obj != nil && resolveNamed.Obj.Pkg != nil {
		pkgPath := resolveNamed.Obj.Pkg.Path
		nm := resolveNamed.Obj.Name
		if cctx.universe.Registry != nil {
			if pkg := cctx.universe.Registry[pkgPath]; pkg != nil && pkg.Scope != nil {
				if obj := pkg.Scope.Lookup(nm); obj != nil {
					if regType := ObjectType(obj); regType != nil {
						if regNamed, ok39 := regType.(*Named); ok39 {
							resolveNamed = regNamed
							typeName = nm
						}
					}
				}
			}
		}
	}
	if resolveNamed.NumMethods() == 0 {
		// The Named type from typeSubst may be a bare copy without methods.
		// Look up the canonical type in cctx.universe.Registry which has methods
		// attached from mxh loading.
		if resolveNamed.Obj != nil && resolveNamed.Obj.Pkg != nil {
			pkgPath := resolveNamed.Obj.Pkg.Path
			nm := resolveNamed.Obj.Name
			if cctx.universe.Registry != nil {
				if pkg := cctx.universe.Registry[pkgPath]; pkg != nil && pkg.Scope != nil {
					if obj := pkg.Scope.Lookup(nm); obj != nil {
						if regNamed, ok39 := ObjectType(obj).(*Named); ok39 && regNamed.NumMethods() > 0 {
							resolveNamed = regNamed
							typeName = nm
						}
					}
				}
			}
		}
		if resolveNamed.NumMethods() == 0 {
			cur := Type(resolveNamed)
			for depth := 0; depth < 10; depth++ {
				n2, ok40 := cur.(*Named)
				if !ok40 || n2 == nil { break }
				if n2.NumMethods() > 0 {
					resolveNamed = n2
					if n2.Obj != nil && n2.Obj.Name != "" {
						typeName = n2.Obj.Name
					}
					break
				}
				raw := n2.Under
				if raw == nil || raw == cur { break }
				cur = raw
			}
		}
	}
	namedPkgPath := ""
	if resolveNamed.Obj != nil && resolveNamed.Obj.Pkg != nil {
		namedPkgPath = resolveNamed.Obj.Pkg.Path
	}
	// All methods use (*Type).Method naming regardless of receiver type.
	recvName := "(*" | typeName | ")"
	samePackage := namedPkgPath != "" && namedPkgPath == fb.fn.Pkg.Pkg.Path
	mangledName := recvName | "." | sel.Sel.Value
	if !samePackage && namedPkgPath != "" {
		mangledName = namedPkgPath | "." | recvName | "." | sel.Sel.Value
	}
	var fn *SSAFunction
	if samePackage {
		fn, _ = fb.fn.Pkg.Members[mangledName].(*SSAFunction)
	}
	if fn == nil {
		for i := 0; i < resolveNamed.NumMethods(); i++ {
			m := resolveNamed.Method(i)
			if m.Name == sel.Sel.Value {
				if !samePackage && namedPkgPath != "" {
					// Imported method: register in the imported package so the
					// emitter uses the moxie convention (value receivers passed
					// by value, trailing ctx param). The externalSymbol path is
					// C-export ABI and drops the ctx argument.
					impPkg := fb.ensureImportedSSAPackage(resolveNamed.Obj.Pkg)
					fn = impPkg.ExternalFunc(recvName|"."|sel.Sel.Value, m.Signature())
				} else {
					fn = fb.fn.Pkg.ExternalFunc(mangledName, m.Signature())
					if resolveNamed.Obj != nil && resolveNamed.Obj.Pkg == nil {
						fn.externalSymbol = "runtime." | mangledName
					}
				}
				break
			}
		}
	}
	if fn == nil && !samePackage && namedPkgPath != "" && resolveNamed.Obj != nil {
		impPkg3 := cctx.universe.Registry[namedPkgPath]
		if impPkg3 != nil && impPkg3.Scope != nil {
			obj3 := impPkg3.Scope.Lookup(resolveNamed.Obj.Name)
			if obj3 != nil {
				if tn3, ok43 := obj3.(*TypeName); ok43 {
					if named3, ok44 := tn3.Typ.(*Named); ok44 {
						for i := int32(0); i < named3.NumMethods(); i++ {
							m := named3.Method(i)
							if m.Name == sel.Sel.Value {
								impSSA2 := fb.ensureImportedSSAPackage(impPkg3)
								fn = impSSA2.ExternalFunc(recvName|"."|sel.Sel.Value, m.Signature())
								break
							}
						}
					}
				}
			}
		}
	}
	if fn != nil {
		if fn.Signature != nil && fn.Signature.Recv != nil {
			recvParam := fn.Signature.Recv
			_, recvIsPtr := SafeUnderlying(recvParam.Typ).(*Pointer)
		if recvIsPtr && !isPtr {
			if nameExpr, ok41 := sel.X.(*syntax.Name); ok41 {
				obj := fb.lookupObject(nameExpr.Value)
				if obj != nil {
					if alloc, ok3 := fb.vars[obj]; ok3 {
						alloc.Heap = true
						recv = alloc
					}
				}
				// Receiver is a package-level global: pass its address.
				// The global itself is emitted as its address (@pkg.global).
				if g, okG := fb.fn.Pkg.Members[nameExpr.Value].(*SSAGlobal); okG {
					recv = g
				} else if tv, okT := obj.(*TCVar); okT && tv.Pkg != nil && tv.Pkg != fb.fn.Pkg.Pkg {
					impPkg := fb.ensureImportedSSAPackage(tv.Pkg)
					if ig, iokG := impPkg.Members[nameExpr.Value].(*SSAGlobal); iokG {
						recv = ig
					}
				}
			} else if innerSel, ok42 := sel.X.(*syntax.SelectorExpr); ok42 {
					addr := fb.buildSelectorAddr(innerSel)
					if addr != nil {
						fb.markAddrEscaping(addr)
						recv = addr
					}
				}
			}
		}
		return fn, recv
	}
	st, ok2 := SafeUnderlying(named).(*TCStruct)
	if !ok2 {
		return nil, nil
	}
	if !isPtr {
		fixed := false
		if innerSel, ok3 := sel.X.(*syntax.SelectorExpr); ok3 {
			addr := fb.buildSelectorAddr(innerSel)
			if addr != nil {
				fb.markAddrEscaping(addr)
				recv = addr
				fixed = true
			}
		}
		if !fixed {
			if nameExpr, ok3 := sel.X.(*syntax.Name); ok3 {
				obj := fb.lookupObject(nameExpr.Value)
				if obj != nil {
					if a, ok4 := fb.vars[obj]; ok4 {
						a.Heap = true
						recv = a
						fixed = true
					}
				}
			}
		}
		if !fixed {
			alloc := &SSAAlloc{Heap: true}
			alloc.typ = NewPointer(recv.SSAType())
			alloc.name = fb.nextName()
			fb.emit(alloc)
			storeOp := &SSAStore{Addr: alloc, Val: recv}
			fb.emit(storeOp)
			recv = alloc
		}
	}
	for i := 0; i < st.NumFields(); i++ {
		f := st.Field(i)
		if !f.Anonymous {
			continue
		}
		embedType := f.Typ
		embedNamed, ok3 := embedType.(*Named)
		if !ok3 {
			if p, ok4 := embedType.(*Pointer); ok4 {
				embedNamed, ok3 = p.Base.(*Named)
			}
		}
		if !ok3 || embedNamed.Obj == nil {
			continue
		}
		embedName := "(*" | embedNamed.Obj.Name | ")"
		embedSamePkg := embedNamed.Obj.Pkg != nil && embedNamed.Obj.Pkg.Path == fb.fn.Pkg.Pkg.Path
		embedMangledName := embedName | "." | sel.Sel.Value
		if !embedSamePkg && embedNamed.Obj.Pkg != nil {
			embedMangledName = embedNamed.Obj.Pkg.Path | "." | embedName | "." | sel.Sel.Value
		}
		var embedFn *SSAFunction
		if embedSamePkg {
			embedFn, _ = fb.fn.Pkg.Members[embedMangledName].(*SSAFunction)
		}
		if embedFn == nil {
			for mi := int32(0); mi < int32(embedNamed.NumMethods()); mi++ {
				m := embedNamed.Method(int32(mi))
				if m.Name == sel.Sel.Value {
					if !embedSamePkg && embedNamed.Obj.Pkg != nil {
						impPkg := fb.ensureImportedSSAPackage(embedNamed.Obj.Pkg)
						embedFn = impPkg.ExternalFunc(embedName|"."|sel.Sel.Value, m.Signature())
					} else {
						embedFn = fb.fn.Pkg.ExternalFunc(embedMangledName, m.Signature())
					}
					break
				}
			}
		}
		if embedFn != nil {
			fieldAddr := &SSAFieldAddr{
				X:     recv,
				Field: i,
			}
			fieldAddr.typ = NewPointer(embedType)
			fieldAddr.name = fb.nextName()
			fb.emit(fieldAddr)
			var embedRecv SSAValue = fieldAddr
			if _, isEmbedPtr := SafeUnderlying(embedType).(*Pointer); isEmbedPtr {
				ld := &SSAUnOp{Op: OpMul, X: fieldAddr}
				ld.typ = embedType
				ld.name = fb.nextName()
				fb.emit(ld)
				embedRecv = ld
			}
			return embedFn, embedRecv
		}
		embedSt, ok5 := SafeUnderlying(embedNamed).(*TCStruct)
		if !ok5 {
			continue
		}
		for j := 0; j < embedSt.NumFields(); j++ {
			f2 := embedSt.Field(j)
			if !f2.Anonymous {
				continue
			}
			embed2Type := f2.Typ
			embed2Named, ok6 := embed2Type.(*Named)
			if !ok6 {
				if p2, ok7 := embed2Type.(*Pointer); ok7 {
					embed2Named, ok6 = p2.Base.(*Named)
				}
			}
			if !ok6 || embed2Named.Obj == nil {
				continue
			}
			embed2Name := "(*" | embed2Named.Obj.Name | ")"
			embed2SamePkg := embed2Named.Obj.Pkg != nil && embed2Named.Obj.Pkg.Path == fb.fn.Pkg.Pkg.Path
			embed2Mangled := embed2Name | "." | sel.Sel.Value
			if !embed2SamePkg && embed2Named.Obj.Pkg != nil {
				embed2Mangled = embed2Named.Obj.Pkg.Path | "." | embed2Name | "." | sel.Sel.Value
			}
			var embed2Fn *SSAFunction
			if embed2SamePkg {
				embed2Fn, _ = fb.fn.Pkg.Members[embed2Mangled].(*SSAFunction)
			}
			if embed2Fn == nil {
				for mi := int32(0); mi < int32(embed2Named.NumMethods()); mi++ {
					m := embed2Named.Method(int32(mi))
					if m.Name == sel.Sel.Value {
						if !embed2SamePkg && embed2Named.Obj.Pkg != nil {
							impPkg := fb.ensureImportedSSAPackage(embed2Named.Obj.Pkg)
							embed2Fn = impPkg.ExternalFunc(embed2Name|"."|sel.Sel.Value, m.Signature())
						} else {
							embed2Fn = fb.fn.Pkg.ExternalFunc(embed2Mangled, m.Signature())
						}
						break
					}
				}
			}
			if embed2Fn == nil {
				continue
			}
			fieldAddr1 := &SSAFieldAddr{X: recv, Field: i}
			fieldAddr1.typ = NewPointer(embedType)
			fieldAddr1.name = fb.nextName()
			fb.emit(fieldAddr1)
			var cur1 SSAValue = fieldAddr1
			curEmbedType := embedType
			if p5, ok8 := SafeUnderlying(embedType).(*Pointer); ok8 {
				ld := &SSAUnOp{Op: OpMul, X: fieldAddr1}
				ld.typ = embedType
				ld.name = fb.nextName()
				fb.emit(ld)
				cur1 = ld
				curEmbedType = p5.Base
			}
			_ = curEmbedType
			fieldAddr2 := &SSAFieldAddr{X: cur1, Field: j}
			fieldAddr2.typ = NewPointer(embed2Type)
			fieldAddr2.name = fb.nextName()
			fb.emit(fieldAddr2)
			var embedRecv2 SSAValue = fieldAddr2
			if _, isEmbedPtr2 := SafeUnderlying(embed2Type).(*Pointer); isEmbedPtr2 {
				ld2 := &SSAUnOp{Op: OpMul, X: fieldAddr2}
				ld2.typ = embed2Type
				ld2.name = fb.nextName()
				fb.emit(ld2)
				embedRecv2 = ld2
			}
			return embed2Fn, embedRecv2
		}
	}
	return nil, nil
}

// buildEmbeddedIfaceMethodCall handles a method promoted from an embedded
// interface field (e.g. byteReader embeds fmt.ScanState and calls
// r.ReadRune()). The promoted call is an interface invoke on the embedded
// field's interface value, not a concrete call.
func (fb *ssaFuncBuilder) buildEmbeddedIfaceMethodCall(sel *syntax.SelectorExpr, recv SSAValue, argExprs []syntax.Expr) (s SSAValue) {
	if recv == nil || recv.SSAType() == nil {
		return nil
	}
	t := recv.SSAType()
	isPtr := false
	if p, isP := SafeUnderlying(t).(*Pointer); isP {
		t = p.Base
		isPtr = true
	}
	st, ok := SafeUnderlying(t).(*TCStruct)
	if !ok {
		return nil
	}
	for i := 0; i < st.NumFields(); i++ {
		f := st.Field(i)
		if !f.Anonymous {
			continue
		}
		iface, ok2 := SafeUnderlying(f.Typ).(*TCInterface)
		if !ok2 {
			continue
		}
		var methodSig *Signature
		for j := 0; j < iface.NumMethods(); j++ {
			m := iface.Method(j)
			if m != nil && m.Name == sel.Sel.Value {
				methodSig = m.Sig
				break
			}
		}
		if methodSig == nil {
			continue
		}
		var recvAddr SSAValue
		if isPtr {
			recvAddr = recv
		} else {
			alloc := fb.emitAlloc(t, 0)
			fb.emitStore(alloc, recv)
			recvAddr = alloc
		}
		fa := &SSAFieldAddr{X: recvAddr, Field: i}
		fa.typ = NewPointer(f.Typ)
		fa.name = fb.nextName()
		fb.emit(fa)
		var ifaceVal SSAValue = fa
		if _, fp := SafeUnderlying(f.Typ).(*Pointer); !fp {
			ld := &SSAUnOp{Op: OpMul, X: fa}
			ld.typ = f.Typ
			ld.name = fb.nextName()
			fb.emit(ld)
			ifaceVal = ld
		}
		var retType Type
		if methodSig.Results != nil {
			if methodSig.Results.Len() == 1 {
				retType = methodSig.Results.At(0).Typ
			} else if methodSig.Results.Len() > 1 {
				retType = methodSig.Results
			}
		}
		args := fb.buildArgs(argExprs)
		if methodSig.Variadic {
			args = fb.wrapVariadicArgs(args, methodSig)
		}
		inv := &SSAInvoke{
			X:          ifaceVal,
			MethodName: sel.Sel.Value,
			IfaceType:  iface,
			Args:       args,
		}
		inv.typ = retType
		inv.name = fb.nextName()
		fb.emit(inv)
		if retType == nil {
			return nil
		}
		return inv
	}
	return nil
}

// buildIfaceMethodCall lowers `recv.M(args)` where recv is an interface value
// into an SSAInvoke. handled distinguishes the three outcomes the caller must
// not confuse: false means recv is not an interface, so another path owns the
// call; true with a nil value means M IS in the interface and returns nothing;
// true with a value is the invoke itself.
//
// The method is looked up BEFORE anything is emitted. The previous shape built
// the arguments and emitted the invoke first and then used `retType == nil` as
// a proxy for "this was not a method call", which is also how a VOID method
// reports itself - so a name the interface does not have still produced an
// invoke, the caller saw nil and fell through as if nothing had been emitted,
// and `i.Bytes()` on an interface without Bytes evaluated to nil, silently
// printing 0. go/types rejects that call.
func (fb *ssaFuncBuilder) buildIfaceMethodCall(sel *syntax.SelectorExpr, recv SSAValue, argExprs []syntax.Expr) (s SSAValue, handled bool) {
	typ := recv.SSAType()
	if p6, ok43 := SafeUnderlying(typ).(*Pointer); ok43 {
		typ = p6.Base
	}
	iface, ok := SafeUnderlying(typ).(*TCInterface)
	if !ok {
		return nil, false
	}
	var methodSig *Signature
	for i := 0; i < iface.NumMethods(); i++ {
		m := iface.Method(i)
		if m == nil {
			continue
		}
		if m.Name == sel.Sel.Value {
			methodSig = m.Sig
			break
		}
	}
	if methodSig == nil {
		return nil, false
	}
	var retType Type
	if methodSig.Results != nil {
		if methodSig.Results.Len() == 1 {
			retType = methodSig.Results.At(0).Typ
		} else if methodSig.Results.Len() > 1 {
			retType = methodSig.Results
		}
	}
	args := fb.buildArgs(argExprs)
	inv := &SSAInvoke{
		X:          recv,
		MethodName: sel.Sel.Value,
		IfaceType:  iface,
		Args:       args,
	}
	inv.typ = retType
	inv.name = fb.nextName()
	fb.emit(inv)
	if retType == nil {
		return nil, true
	}
	return inv, true
}

func (fb *ssaFuncBuilder) resolveType(e syntax.Expr) (t Type) {
	return fb.resolveTypeAST(e)
}

// resolveTypeProbe resolves e as a type without reporting "undefined" errors.
// Used by buildCall to detect type-conversion calls (int32(x)); the callee of
// a normal function call is not a type and must not produce a diagnostic.
func (fb *ssaFuncBuilder) resolveTypeProbe(e syntax.Expr) (t Type) {
	saved := fb.quietTypeErr
	fb.quietTypeErr = true
	t = fb.resolveTypeAST(e)
	fb.quietTypeErr = saved
	return t
}

func (fb *ssaFuncBuilder) resolveTypeAST(e syntax.Expr) (t Type) {
	if e == nil {
		return nil
	}
	switch ev := e.(type) {
	case *syntax.Name:
		if fb.typeSubst != nil {
			if t2, ok44 := fb.typeSubst[ev.Value]; ok44 {
				return t2
			}
		}
		if t3, ok45 := fb.localTypes[ev.Value]; ok45 {
			return t3
		}
		obj := fb.lookupObject(ev.Value)
		if tn, ok := obj.(*TypeName); ok {
			if tp, ok2 := tn.Typ.(*TypeParam); ok2 && fb.typeSubst != nil {
				if t4, ok46 := fb.typeSubst[tp.String()]; ok46 {
					return t4
				}
			}
			return tn.Typ
		}
		if obj == nil {
			if !fb.quietTypeErr {
				// Not a predeclared or user-defined name: int/uint/make/new/
				// complex64 etc are undefined in Moxie, not restricted.
				cctx.compileErrors = mxutil.Ensure(cctx.compileErrors, 1)
				push(cctx.compileErrors, "undefined: " | ev.Value)
			}
		}
		return nil
	case *syntax.Operation:
		if ev.Y == nil && ev.Op == token.Mul {
			base := fb.resolveTypeAST(ev.X)
			if base != nil {
				return NewPointer(base)
			}
		}
	case *syntax.SliceType:
		elem := fb.resolveTypeAST(ev.Elem)
		if elem != nil {
			if b, ok := elem.(*Basic); ok && b.Kind == Uint8 {
				return Typ[TCString]
			}
			return NewSlice(elem)
		}
	case *syntax.ArrayType:
		elem := fb.resolveTypeAST(ev.Elem)
		if elem != nil {
			n := int64(-1)
			if lit, ok := ev.Len.(*syntax.BasicLit); ok {
				n = ssaParseInt64(lit.Value)
			} else if ev.Len != nil {
				cv := tcEvalConstExpr(ev.Len, fb.fn.Pkg.Pkg.Scope, -1)
				if cv == nil && fb.localConsts != nil {
					cv = fb.evalLocalConstExpr(ev.Len, -1)
				}
				if ci2, ok47 := cv.(*ConstInt); ok47 {
					n = ci2.V
				}
			}
			return NewArray(elem, n)
		}
	case *syntax.MapType:
		key := fb.resolveTypeAST(ev.Key)
		val := fb.resolveTypeAST(ev.Value)
		if key != nil && val != nil {
			return NewTCMap(key, val)
		}
	case *syntax.StructType:
		return fb.resolveStructTypeAST(ev)
	case *syntax.ChanType:
		elem := fb.resolveTypeAST(ev.Elem)
		if elem != nil {
			dir := TCSendRecv
			if ev.Dir == syntax.SendOnly {
				dir = TCSendOnly
			} else if ev.Dir == syntax.RecvOnly {
				dir = TCRecvOnly
			}
			return NewTCChan(dir, elem)
		}
	case *syntax.InterfaceType:
		return fb.resolveInterfaceTypeAST(ev)
	case *syntax.FuncType:
		return fb.resolveFuncTypeAST(ev)
	case *syntax.SelectorExpr:
		if x, ok := ev.X.(*syntax.Name); ok {
			obj := fb.lookupObject(x.Value)
			if pn, ok2 := obj.(*PkgName); ok2 && pn.Imported != nil {
				sel := pn.Imported.Scope.Lookup(ev.Sel.Value)
				if tn, ok3 := sel.(*TypeName); ok3 {
					return tn.Typ
				}
			}
		}
	case *syntax.IndexExpr:
		// Generic instantiation Curve[int32]: carry the instantiation args
		// on a shallow Named copy so method resolution and layout
		// substitution see them. Mirrors resolveTypeExprWithSubst.
		base := fb.resolveTypeAST(ev.X)
		if named, ok := base.(*Named); ok && named.TArgs == nil && ev.Index != nil {
			args := []Type{}
			if le, ok2 := ev.Index.(*syntax.ListExpr); ok2 {
				for _, te := range le.ElemList {
					ta := fb.resolveTypeAST(te)
					if ta == nil {
						return nil
					}
					push(args, ta)
				}
			} else {
				ta := fb.resolveTypeAST(ev.Index)
				if ta == nil {
					return nil
				}
				push(args, ta)
			}
			if len(args) > 0 {
				inst := &Named{Obj: named.Obj, Under: named.Under, Methods: named.Methods, TParams: named.TParams, TArgs: args}
				return inst
			}
		}
		return base
	case *syntax.ParenExpr:
		return fb.resolveTypeAST(ev.X)
	}
	return nil
}

func (fb *ssaFuncBuilder) resolveInterfaceTypeAST(e *syntax.InterfaceType) (t *TCInterface) {
	var methods []*IfaceMethod
	for _, f := range e.MethodList {
		if f.Name == nil {
			continue
		}
		ft, ok := f.Type.(*syntax.FuncType)
		if !ok {
			continue
		}
		sig := fb.resolveFuncTypeAST(ft)
		if sig != nil {
			methods = mxutil.Ensure(methods, 1)
			push(methods, NewTCIfaceMethod(f.Name.Value, sig))
		}
	}
	iface := NewTCInterface(methods, nil)
	iface.Complete()
	return iface
}

func (fb *ssaFuncBuilder) resolveStructTypeAST(e *syntax.StructType) (t *TCStruct) {
	var fields []*TCVar
	var tags []string
	for i, f := range e.FieldList {
		typ := fb.resolveTypeAST(f.Type)
		if typ == nil {
			return nil
		}
		name := ""
		if f.Name != nil {
			name = f.Name.Value
		} else {
			name = EmbeddedFieldName(f.Type)
			if name == "" {
				name = TypeBaseName(typ)
			}
		}
		fields = mxutil.Ensure(fields, 1)
		push(fields, NewTCField(fb.fn.Pkg.Pkg, name, typ, f.Name == nil))
		tag := ""
		if i < len(e.TagList) && e.TagList[i] != nil {
			tag = TagText(e.TagList[i].Value)
		}
		tags = mxutil.Ensure(tags, 1)
		push(tags, tag)
	}
	return NewTCStruct(fields, tags)
}

func (fb *ssaFuncBuilder) resolveFuncTypeAST(ft *syntax.FuncType) (s *Signature) {
	if ft == nil {
		return nil
	}
	var params []*TCVar
	for _, p := range ft.ParamList {
		typ := fb.resolveTypeAST(p.Type)
		pname := ""
		if p.Name != nil {
			pname = p.Name.Value
		}
		params = mxutil.Ensure(params, 1)
		push(params, NewTCVar(nil, pname, typ))
	}
	var results []*TCVar
	for _, r := range ft.ResultList {
		typ := fb.resolveTypeAST(r.Type)
		rname := ""
		if r.Name != nil {
			rname = r.Name.Value
		}
		results = mxutil.Ensure(results, 1)
		push(results, NewTCVar(nil, rname, typ))
	}
	var pTuple, rTuple *Tuple
	if len(params) > 0 {
		pTuple = NewTuple(params...)
	}
	if len(results) > 0 {
		rTuple = NewTuple(results...)
	}
	return NewSignature(nil, pTuple, rTuple, false)
}

func (fb *ssaFuncBuilder) fieldIndex(t Type, name string) (n int32) {
	if t == nil {
		return -1
	}
	if pt, ok := SafeUnderlying(t).(*Pointer); ok {
		t = pt.Base
	}
	if st, ok := SafeUnderlying(t).(*TCStruct); ok {
		for i := 0; i < st.NumFields(); i++ {
			if st.Field(i).Name == name {
				return i
			}
		}
	}
	return -1
}


func (fb *ssaFuncBuilder) findEmbeddedFieldPath(t Type, name string) (ss []int32) {
	if t == nil {
		return nil
	}
	if pt2, ok48 := SafeUnderlying(t).(*Pointer); ok48 {
		t = pt2.Base
	}
	st, ok := SafeUnderlying(t).(*TCStruct)
	if !ok {
		return nil
	}
	for i := 0; i < st.NumFields(); i++ {
		f := st.Field(i)
		if !f.Anonymous {
			continue
		}
		embedType := f.Typ
		if pt3, ok49 := SafeUnderlying(embedType).(*Pointer); ok49 {
			embedType = pt3.Base
		}
		inner := fb.fieldIndex(embedType, name)
		if inner >= 0 {
			return []int32{i, inner}
		}
		sub := fb.findEmbeddedFieldPath(embedType, name)
		if len(sub) > 0 {
			return []int32{i} | sub
		}
	}
	return nil
}

func (fb *ssaFuncBuilder) fieldType(t Type, idx int32) (tv Type) {
	if t == nil {
		return nil
	}
	if pt, ok := SafeUnderlying(t).(*Pointer); ok {
		t = pt.Base
	}
	st, isStruct := SafeUnderlying(t).(*TCStruct)
	if !isStruct || idx < 0 || idx >= st.NumFields() {
		return nil
	}
	ft := st.Field(idx).Typ
	// An instantiated generic used in ORDINARY code has no fb.typeSubst - the
	// bindings live on the Named's TArgs, and only monomorphized bodies carry a
	// map. Without this the field type stayed the type parameter: `s.v[2]` for a
	// Box[int32] was a T, so passing it to an int32 parameter carried the wrong
	// value and printing it printed nothing. src/internal/trace's
	// `ordering.queue` (a queue[Event]) depends on this to reach
	// (*queue).pop at all.
	if gn, okg := t.(*Named); okg && len(gn.TArgs) > 0 && len(gn.TParams) > 0 {
		merged := map[string]Type{}
		for k, v := range fb.typeSubst {
			merged[k] = v
		}
		n := len(gn.TParams)
		if len(gn.TArgs) < n {
			n = len(gn.TArgs)
		}
		for i := int32(0); i < int32(n); i++ {
			merged[gn.TParams[i].String()] = gn.TArgs[i]
		}
		saved := fb.typeSubst
		fb.typeSubst = merged
		out := fb.substTypeParams(ft)
		fb.typeSubst = saved
		return out
	}
	return fb.substTypeParams(ft)
}

// substTypeParams substitutes type parameters in t using fb.typeSubst.
// Generic struct types are erased to their base Named inside monomorphized
// bodies, so a field like newPoint func() P still carries the TypeParam; the
// concrete binding lives in fb.typeSubst.
func (fb *ssaFuncBuilder) substTypeParams(t Type) (tv Type) {
	if t == nil || fb.typeSubst == nil {
		return t
	}
	return substTypeIn(t, fb.typeSubst)
}

// substTypeIn rewrites type parameters in t using sub. A bare TypeParam is the
// easy case; the composite constructors matter exactly as much, because a
// substituted field is just as often an aggregate. `m map[K]V` and
// `s []entry[K,V]` are a TCMap and a Slice wrapping a Named, and leaving them
// on the parameter handed the emitter a type it has no case for. llvmType's
// fallback for an unrecognised type is "i8", so mapping[string,int64]'s map
// slot became `alloca i8` receiving a {ptr,i64,i64} string key:
//
//	store i8 %t64, ptr %mu18
//	clang: '%t64' defined with type '{ ptr, i64, i64 }' but expected 'i8'
//
// The same fallback lowered entry[K,V] to the layout {i8, i8}, so the alloca,
// the store into it and the gep that read it back described three different
// structs. Recursion terminates because a Named whose args are already its own
// parameters substitutes nothing and comes back unchanged.
func substTypeIn(t Type, sub map[string]Type) (tv Type) {
	if t == nil || sub == nil {
		return t
	}
	switch tt := t.(type) {
	case *TypeParam:
		if r, ok := sub[tt.String()]; ok {
			return r
		}
	case *Pointer:
		e := substTypeIn(tt.Base, sub)
		if e != tt.Base {
			return NewPointer(e)
		}
	case *Slice:
		e := substTypeIn(tt.Elem, sub)
		if e != tt.Elem {
			return NewSlice(e)
		}
	case *Array:
		e := substTypeIn(tt.Elem, sub)
		if e != tt.Elem {
			return NewArray(e, tt.Len)
		}
	case *TCMap:
		k := substTypeIn(tt.Key, sub)
		v := substTypeIn(tt.Elem, sub)
		if k != tt.Key || v != tt.Elem {
			return NewTCMap(k, v)
		}
	case *TCChan:
		e := substTypeIn(tt.Elem, sub)
		if e != tt.Elem {
			return NewTCChan(tt.Dir, e)
		}
	case *TCStruct:
		changed := false
		var fields []*TCVar
		for i := int32(0); i < tt.NumFields(); i++ {
			f := tt.Field(i)
			nt := substTypeIn(f.Typ, sub)
			if nt != f.Typ {
				changed = true
			}
			fields = mxutil.Ensure(fields, 1)
			push(fields, NewTCField(f.Pkg, f.Name, nt, f.Anonymous))
		}
		if changed {
			return NewTCStruct(fields, tt.Tags)
		}
	case *Named:
		if len(tt.TParams) == 0 {
			return t
		}
		inner := map[string]Type{}
		changed := false
		if len(tt.TArgs) > 0 {
			n := len(tt.TParams)
			if len(tt.TArgs) < n {
				n = len(tt.TArgs)
			}
			for i := int32(0); i < int32(n); i++ {
				a := substTypeIn(tt.TArgs[i], sub)
				if a != tt.TArgs[i] {
					changed = true
				}
				inner[tt.TParams[i].String()] = a
			}
		} else {
			// A generic type written inside a generic declaration carries no
			// args of its own: `s []entry[K,V]` in mapping[K,V] names the
			// ENCLOSING parameters, and the args live only in sub. Binding by
			// name is the same binding Go applies. Without this the slice's
			// element stayed the generic entry and the push/range temporaries
			// were alloca {i8, i8} while the value stored into them was the
			// substituted struct.
			for i := int32(0); i < int32(len(tt.TParams)); i++ {
				if r, ok := sub[tt.TParams[i].String()]; ok {
					inner[tt.TParams[i].String()] = r
					changed = true
				}
			}
		}
		if !changed {
			return t
		}
		// Only the ARGS move: Under stays the generic body. Minting a
		// substituted struct here and hanging it off Under gave the descriptor
		// pass a type no one had declared - the build failed with
		//   use of undefined value '@reflect/types.type:struct:{s:slice:
		//   named:main.entry[basic:invalid,basic:invalid],m:map:...}'
		// The layout is resolved where it is needed (ir_types llvmTypeInner);
		// here only the binding has to travel, so field accesses and the
		// emitter agree on the arguments.
		args := []Type{}
		for i := int32(0); i < int32(len(tt.TParams)); i++ {
			if r, ok := inner[tt.TParams[i].String()]; ok {
				push(args, r)
			} else {
				push(args, tt.TParams[i])
			}
		}
		return &Named{Obj: tt.Obj, Under: tt.Under, Methods: tt.Methods, TParams: tt.TParams, TArgs: args}
	case *Signature:
		changed := false
		var params []*TCVar
		if tt.Params != nil {
			for i := 0; i < tt.Params.Len(); i++ {
				p := tt.Params.At(i)
				nt := substTypeIn(p.Typ, sub)
				if nt != p.Typ {
					changed = true
					params = mxutil.Ensure(params, 1)
					push(params, NewTCVar(nil, p.Name, nt))
				} else {
					params = mxutil.Ensure(params, 1)
					push(params, p)
				}
			}
		}
		var results []*TCVar
		if tt.Results != nil {
			for i := 0; i < tt.Results.Len(); i++ {
				r := tt.Results.At(i)
				nt := substTypeIn(r.Typ, sub)
				if nt != r.Typ {
					changed = true
					results = mxutil.Ensure(results, 1)
					push(results, NewTCVar(nil, r.Name, nt))
				} else {
					results = mxutil.Ensure(results, 1)
					push(results, r)
				}
			}
		}
		if changed {
			var pT *Tuple
			if len(params) > 0 {
				pT = NewTuple(params...)
			}
			var rT *Tuple
			if len(results) > 0 {
				rT = NewTuple(results...)
			}
			return NewSignature(nil, pT, rT, tt.Variadic)
		}
	}
	return t
}



func ssaExtractConst(v SSAValue) (s *SSAConst) {
	if c, ok := v.(*SSAConst); ok {
		return c
	}
	if conv, ok := v.(*SSAConvert); ok {
		if c, ok2 := conv.X.(*SSAConst); ok2 {
			return &SSAConst{typ: conv.SSAType(), val: c.val}
		}
	}
	return nil
}

// constValType returns the untyped SSA type matching a constant value.
func constValType(cv ConstVal) (t Type) {
	switch cv.(type) {
	case *ConstInt:
		return Typ[UntypedInt]
	case *ConstFloat:
		return Typ[UntypedFloat]
	case *ConstStr:
		return Typ[UntypedString]
	case *ConstBool:
		return Typ[UntypedBool]
	}
	return nil
}

func ssaExprNames(e syntax.Expr) (ns []*syntax.Name) {
	if e == nil {
		return nil
	}
	if n, ok := e.(*syntax.Name); ok {
		return []*syntax.Name{n}
	}
	if l, ok := e.(*syntax.ListExpr); ok {
		var names []*syntax.Name
		names = []*syntax.Name{:0:len(l.ElemList)}
		for _, el := range l.ElemList {
			if n2, ok50 := el.(*syntax.Name); ok50 {
				push(names, n2)
			}
		}
		return names
	}
	return nil
}

func localizeConstVal(val ConstVal, typ Type) (c ConstVal) {
	if val == nil {
		return nil
	}
	// A declared type is applied AT THE DECLARATION, as Go does. Deferring it
	// to the use site left a typed constant holding its untyped value, and the
	// conversion there went through float64 - time's absoluteToInternal, an
	// int64 constant built from a float literal expression, came out 256 off.
	if typ != nil {
		return ConvertConstLocal(val, typ)
	}
	return val
}

func mangleGenericName(plainName string, typeArgs []Type) (s string) {
	s = plainName | "__"
	for i, t := range typeArgs {
		if i > 0 {
			s = s | "_"
		}
		if t == nil {
			s = s | "nil"
		} else {
			ts := t.String()
			for j := 0; j < len(ts); j++ {
				c := ts[j]
				if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') {
					s = s | string([]byte{c})
				} else if c == '.' {
					s = s | "."
				} else {
					s = s | "_"
				}
			}
		}
	}
	return s
}

func resolveTypeExprWithSubst(e syntax.Expr, typeSubst map[string]Type, pkgScope *Scope) (t Type) {
	if e == nil {
		return nil
	}
	switch ev := e.(type) {
	case *syntax.Name:
		if t5, ok51 := typeSubst[ev.Value]; ok51 {
			return t5
		}
		_, obj := Universe.LookupParent(ev.Value)
		if obj != nil {
			if tn, ok := obj.(*TypeName); ok {
				return tn.Typ
			}
		}
		if pkgScope != nil {
			tobj := pkgScope.Lookup(ev.Value)
			if tobj != nil {
				if tn, ok := tobj.(*TypeName); ok {
					return tn.Typ
				}
			}
		}
		if cctx.universe.Registry != nil {
			for _, pkg := range cctx.universe.Registry {
				if pkg == nil || pkg.Scope == nil {
					continue
				}
				tobj := pkg.Scope.Lookup(ev.Value)
				if tobj != nil {
					if tn, ok := tobj.(*TypeName); ok {
						return tn.Typ
					}
				}
			}
		}
		return nil
	case *syntax.DotsType:
		elem := resolveTypeExprWithSubst(ev.Elem, typeSubst, pkgScope)
		if elem != nil {
			if b, ok := elem.(*Basic); ok && b.Kind == Uint8 {
				return Typ[TCString]
			}
			return NewSlice(elem)
		}
		// See tcResolveNameInline's DotsType: a nil element type leaves the
		// parameter `void` while the variadic flag stays true.
		push(cctx.compileErrors, "undefined: " | typeExprName(ev.Elem))
		return nil
	case *syntax.SliceType:
		elem := resolveTypeExprWithSubst(ev.Elem, typeSubst, pkgScope)
		if elem != nil {
			if b, ok := elem.(*Basic); ok && b.Kind == Uint8 {
				return Typ[TCString]
			}
			return NewSlice(elem)
		}
	case *syntax.ArrayType:
		elem := resolveTypeExprWithSubst(ev.Elem, typeSubst, pkgScope)
		if elem != nil {
			n := int64(-1)
			if lit, ok := ev.Len.(*syntax.BasicLit); ok {
				n = ssaParseInt64(lit.Value)
			} else if ev.Len != nil && pkgScope != nil {
				cv := tcEvalConstExpr(ev.Len, pkgScope, -1)
				if ci3, ok52 := cv.(*ConstInt); ok52 {
					n = ci3.V
				}
			}
			return NewArray(elem, n)
		}
	case *syntax.Operation:
		if ev.Y == nil && ev.Op == token.Mul {
			base := resolveTypeExprWithSubst(ev.X, typeSubst, pkgScope)
			if base != nil {
				return NewPointer(base)
			}
		}
	case *syntax.MapType:
		key := resolveTypeExprWithSubst(ev.Key, typeSubst, pkgScope)
		val := resolveTypeExprWithSubst(ev.Value, typeSubst, pkgScope)
		if key != nil && val != nil {
			return NewTCMap(key, val)
		}
	case *syntax.ChanType:
		elem := resolveTypeExprWithSubst(ev.Elem, typeSubst, pkgScope)
		if elem != nil {
			dir := TCSendRecv
			if ev.Dir == syntax.SendOnly {
				dir = TCSendOnly
			} else if ev.Dir == syntax.RecvOnly {
				dir = TCRecvOnly
			}
			return NewTCChan(dir, elem)
		}
	case *syntax.InterfaceType:
		return resolveInterfaceFromAST(ev)
	case *syntax.FuncType:
		return resolveSignatureWithSubst(ev, typeSubst, pkgScope)
	case *syntax.IndexExpr:
		// Generic instantiation Curve[P]: erase to the base named type for
		// layout, but carry the instantiation args on a shallow Named copy
		// so method resolution can substitute the type params. Fields typed
		// by the type param are substituted at use sites via fb.typeSubst.
		base := resolveTypeExprWithSubst(ev.X, typeSubst, pkgScope)
		args := resolveTypeArgsExpr(ev.Index, typeSubst, pkgScope)
		if named, ok := base.(*Named); ok && named.TArgs == nil && len(args) > 0 {
			inst := &Named{Obj: named.Obj, Under: named.Under, Methods: named.Methods, TParams: named.TParams, TArgs: args}
			return inst
		}
		return base
	case *syntax.SelectorExpr:
		if pkgName, ok := ev.X.(*syntax.Name); ok {
			for _, im := range cctx.sigDeclPkgImports {
				if im != nil && im.Name == pkgName.Value && im.Scope != nil {
					if tn, ok3 := im.Scope.Lookup(ev.Sel.Value).(*TypeName); ok3 {
						return tn.Typ
					}
				}
			}
			// The scope of the file that WROTE the qualifier. ScanGenericDecls
			// rebuilds a declaring package's scope with a PkgName binding per
			// import, so this route is that package's own import list, already
			// resolved to live packages. It is the same route the type checker
			// uses (tcResolveNameInline), and the one this resolver was missing:
			// it consulted only sigDeclPkgImports, which is empty for a plain
			// body build, so `unsafe.Pointer` in a scanned type declaration
			// resolved to nil and the global short-name map was masking it.
			if pkgScope != nil {
				if pn, ok4 := pkgScope.Lookup(pkgName.Value).(*PkgName); ok4 && pn != nil && pn.Imported != nil && pn.Imported.Scope != nil {
					if tn, ok5 := pn.Imported.Scope.Lookup(ev.Sel.Value).(*TypeName); ok5 && tn != nil {
						return tn.Typ
					}
				}
			}
			// Neither route answered. If the name is a package the compiler
			// knows, the qualifier is one legacy rejects, so say so. This is
			// only a diagnostic: "the name is a known package" is NOT the rule
			// (an unimported package is not in the Registry at all), and the
			// real rule is enforced where a nil type would do damage - see
			// tcResolveFuncInline, which reports an unresolved parameter type.
			if imp := cctx.universe.LookupByName(pkgName.Value); imp != nil && imp.Scope != nil {
				if tn, ok6 := imp.Scope.Lookup(ev.Sel.Value).(*TypeName); ok6 && tn != nil {
					push(cctx.compileErrors, "undefined: " | pkgName.Value)
				}
			}
		}
	}
	return nil
}

// resolveTypeArgsExpr resolves the type arguments of a generic
// instantiation expression (single type or ListExpr of types).
func resolveTypeArgsExpr(indexExpr syntax.Expr, typeSubst map[string]Type, pkgScope *Scope) (ts []Type) {
	if indexExpr == nil {
		return nil
	}
	if le, ok := indexExpr.(*syntax.ListExpr); ok {
		for _, te := range le.ElemList {
			ts = mxutil.Ensure(ts, 1)
			push(ts, resolveTypeExprWithSubst(te, typeSubst, pkgScope))
		}
	} else {
		ts = mxutil.Ensure(ts, 1)
		push(ts, resolveTypeExprWithSubst(indexExpr, typeSubst, pkgScope))
	}
	return ts
}

func resolveSignatureWithSubst(ft *syntax.FuncType, typeSubst map[string]Type, pkgScope *Scope) (s *Signature) {
	if ft == nil {
		return nil
	}
	var params []*TCVar
	variadic := false
	for _, p := range ft.ParamList {
		typ := resolveTypeExprWithSubst(p.Type, typeSubst, pkgScope)
		name := ""
		if p.Name != nil {
			name = p.Name.Value
		}
		params = mxutil.Ensure(params, 1)
		push(params, NewTCVar(nil, name, typ))
	}
	if len(ft.ParamList) > 0 {
		last := ft.ParamList[len(ft.ParamList)-1]
		if _, ok := last.Type.(*syntax.DotsType); ok {
			variadic = true
		}
	}
	var results []*TCVar
	for _, r := range ft.ResultList {
		typ := resolveTypeExprWithSubst(r.Type, typeSubst, pkgScope)
		name := ""
		if r.Name != nil {
			name = r.Name.Value
		}
		if typ == nil && r.Name != nil {
			if _, ok := r.Type.(*syntax.Name); ok {
			}
		}
		results = mxutil.Ensure(results, 1)
		push(results, NewTCVar(nil, name, typ))
	}
	var paramTuple *Tuple
	if len(params) > 0 {
		paramTuple = NewTuple(params...)
	}
	var resultTuple *Tuple
	if len(results) > 0 {
		resultTuple = NewTuple(results...)
	}
	return NewSignature(nil, paramTuple, resultTuple, variadic)
}

func matchTypeParam(paramType syntax.Expr, argType Type, tparams []*syntax.Field, typeMap map[string]Type) {
	if paramType == nil || argType == nil {
		return
	}
	switch pt := paramType.(type) {
	case *syntax.Name:
		for _, tp := range tparams {
			if tp.Name != nil && tp.Name.Value == pt.Value {
				typeMap[pt.Value] = argType
				return
			}
		}
	case *syntax.DotsType:
		matchTypeParam(pt.Elem, argType, tparams, typeMap)
	case *syntax.Operation:
		// pointer param AST: *T is Operation{Op: Mul, Y: nil}
		if pt.Y == nil && pt.Op == token.Mul {
			if p, ok := SafeUnderlying(argType).(*Pointer); ok {
				matchTypeParam(pt.X, p.Base, tparams, typeMap)
			}
		}
	case *syntax.SliceType:
		u := SafeUnderlying(argType)
		// In Moxie, string and []byte are the same type. Treat string as
		// []byte when matching against a slice type parameter.
		if b, ok := u.(*Basic); ok && b.Kind == TCString {
			u = NewSlice(Typ[Uint8])
		}
		if sl, ok := u.(*Slice); ok {
			matchTypeParam(pt.Elem, sl.Elem, tparams, typeMap)
		}
	case *syntax.FuncType:
		sig, ok := SafeUnderlying(argType).(*Signature)
		if !ok {
			return
		}
		for i, p := range pt.ParamList {
			if sig.Params != nil && i < int32(sig.Params.Len()) {
				matchTypeParam(p.Type, sig.Params.At(int32(i)).Typ, tparams, typeMap)
			}
		}
		for i, r := range pt.ResultList {
			if sig.Results != nil && i < int32(sig.Results.Len()) {
				matchTypeParam(r.Type, sig.Results.At(int32(i)).Typ, tparams, typeMap)
			}
		}
	case *syntax.IndexExpr:
		// Generic instantiation Curve[T] in the parameter: bind the type
		// args from the argument's instantiation args (a shallow Named
		// with TArgs). E.g. Curve[T] vs Curve[int32] binds T=int32.
		argNamed, ok := argType.(*Named)
		if !ok {
			if p, ok2 := SafeUnderlying(argType).(*Pointer); ok2 {
				argNamed, ok = p.Base.(*Named)
			}
		}
		if ok && argNamed.TArgs != nil {
			if le, ok2 := pt.Index.(*syntax.ListExpr); ok2 {
				for i, te := range le.ElemList {
					if i < int32(len(argNamed.TArgs)) {
						matchTypeParam(te, argNamed.TArgs[i], tparams, typeMap)
					}
				}
			} else if int32(len(argNamed.TArgs)) == 1 {
				matchTypeParam(pt.Index, argNamed.TArgs[0], tparams, typeMap)
			}
		}
	}
}

func inferFromConstraints(tparams []*syntax.Field, typeMap map[string]Type) {
	for _, tp := range tparams {
		if tp.Name == nil || tp.Type == nil {
			continue
		}
		knownType, ok := typeMap[tp.Name.Value]
		if !ok {
			continue
		}
		extractConstraintTypeParams(tp.Type, knownType, tparams, typeMap)
	}
}

func extractConstraintTypeParams(constraint syntax.Expr, concreteType Type, tparams []*syntax.Field, typeMap map[string]Type) {
	if constraint == nil || concreteType == nil {
		return
	}
	switch c := constraint.(type) {
	case *syntax.Operation:
		if c.Op == token.Tilde && c.Y == nil {
			extractConstraintTypeParams(c.X, concreteType, tparams, typeMap)
		}
	case *syntax.SliceType:
		// In Moxie, string and []byte are the same type. When the concrete
		// type is string (Basic), treat it as []byte for constraint matching.
		ct := concreteType
		u := SafeUnderlying(ct)
		if b, ok := u.(*Basic); ok && b.Kind == TCString {
			ct = NewSlice(Typ[Uint8])
			u = ct
		}
		if sl, ok := u.(*Slice); ok {
			if name, ok2 := c.Elem.(*syntax.Name); ok2 {
				for _, tp := range tparams {
					if tp.Name != nil && tp.Name.Value == name.Value {
						if _, already := typeMap[name.Value]; !already {
							typeMap[name.Value] = sl.Elem
						}
					}
				}
			}
		}
	case *syntax.MapType:
		// ~map[K]V constraints (e.g. maps.All[Map ~map[K]V, K, V]): bind
		// the key and value type params from the concrete map type.
		if m, ok := SafeUnderlying(concreteType).(*TCMap); ok {
			if name, ok2 := c.Key.(*syntax.Name); ok2 {
				for _, tp := range tparams {
					if tp.Name != nil && tp.Name.Value == name.Value {
						if _, already := typeMap[name.Value]; !already {
							typeMap[name.Value] = m.Key
						}
					}
				}
			}
			if name, ok2 := c.Value.(*syntax.Name); ok2 {
				for _, tp := range tparams {
					if tp.Name != nil && tp.Name.Value == name.Value {
						if _, already := typeMap[name.Value]; !already {
							typeMap[name.Value] = m.Elem
						}
					}
				}
			}
		}
	}
}

func inferTypeArgsFromFunc(fd *syntax.FuncDecl, args []SSAValue) (ts []Type) {
	typeMap := map[string]Type{}
	if fd.Type != nil {
		for i, param := range fd.Type.ParamList {
			if i >= len(args) || args[i] == nil || args[i].SSAType() == nil {
				continue
			}
			matchTypeParam(param.Type, args[i].SSAType(), fd.TParamList, typeMap)
		}
	}

	inferFromConstraints(fd.TParamList, typeMap)
	var result []Type
	for _, tp := range fd.TParamList {
		if tp.Name != nil {
			push(result, typeMap[tp.Name.Value])
		}
	}
	return result
}

// inferTypeArgsFromArgASTs is a fallback for inferTypeArgsFromFunc when the
// checker erased a generic instantiation (resolveGenericInst is a stub): the
// checked type of an arg like ecdh.P256() is bare *Curve with no type args,
// so type-level matching cannot bind P. Instead, unify the callee param's
// type AST (*Curve[P]) against the argument EXPRESSION's declared type AST:
// the result AST of the called function, or the enclosing function's param
// AST (resolved through fb.typeSubst inside monomorphized bodies).
func (fb *ssaFuncBuilder) inferTypeArgsFromArgASTs(fd *syntax.FuncDecl, argList []syntax.Expr, typeArgs []Type) (ts []Type) {
	anyNil := false
	for _, ta := range typeArgs {
		if ta == nil {
			anyNil = true
		}
	}
	if !anyNil {
		return typeArgs
	}
	typeMap := map[string]Type{}
	for i, tp := range fd.TParamList {
		if tp.Name != nil && i < len(typeArgs) && typeArgs[i] != nil {
			typeMap[tp.Name.Value] = typeArgs[i]
		}
	}
	if fd.Type != nil {
		for i, param := range fd.Type.ParamList {
			if i >= len(argList) {
				break
			}
			argAST, argSubst, argScope := fb.declaredTypeAST(argList[i])
			if argAST == nil {
				continue
			}
			fb.unifyParamAST(param.Type, argAST, fd.TParamList, typeMap, argSubst, argScope)
		}
	}
	inferFromConstraints(fd.TParamList, typeMap)
	var result []Type
	for _, tp := range fd.TParamList {
		if tp.Name != nil {
			push(result, typeMap[tp.Name.Value])
		}
	}
	return result
}

// declaredTypeAST returns the source-declared type AST of an argument
// expression plus the subst map and scope needed to resolve concrete names
// inside it. Two shapes matter: a call to a function whose FuncDecl AST is
// recorded (its result type AST carries the un-erased generic instantiation),
// and a bare name referring to a parameter of the enclosing function.
func (fb *ssaFuncBuilder) declaredTypeAST(arg syntax.Expr) (e syntax.Expr, m map[string]Type, sc *Scope) {
	switch a := arg.(type) {
	case *syntax.CallExpr:
		path := ""
		fname := ""
		switch fun := a.Fun.(type) {
		case *syntax.SelectorExpr:
			if pkgName, ok53 := fun.X.(*syntax.Name); ok53 {
				if pn, ok2 := fb.lookupObject(pkgName.Value).(*PkgName); ok2 && pn.Imported != nil {
					path = pn.Imported.Path
					fname = fun.Sel.Value
				}
			}
		case *syntax.Name:
			path = fb.fn.Pkg.Pkg.Path
			fname = fun.Value
			if fb.srcScope != nil {
				for gPkg, gScope := range cctx.genericPkgScopes {
					if gScope == fb.srcScope {
						path = gPkg
						break
					}
				}
			}
		}
		if fname == "" {
			return nil, nil, nil
		}
		callee, ok := cctx.genericPkgLocalDecls[path|"."|fname]
		if !ok {
			return nil, nil, nil
		}
		if callee.Type == nil || len(callee.Type.ResultList) != 1 {
			return nil, nil, nil
		}
		var scope *Scope
		if cctx.genericPkgScopes != nil {
			scope = cctx.genericPkgScopes[path]
		}
		return callee.Type.ResultList[0].Type, map[string]Type{}, scope
	case *syntax.Name:
		// Walk the closure parent chain: a free variable captured by a
		// closure inside a monomorphized body is declared as a param of an
		// enclosing function, not of the closure itself.
		for cur := fb; cur != nil; cur = cur.parent {
			if cur.decl == nil || cur.decl.Type == nil {
				continue
			}
			for _, p := range cur.decl.Type.ParamList {
				if p.Name != nil && p.Name.Value == a.Value {
					return p.Type, cur.typeSubst, cur.srcScope
				}
			}
		}
	}
	return nil, nil, nil
}

// unifyParamAST structurally unifies a callee parameter type AST against an
// argument's declared type AST, binding callee type params in typeMap. Leaf
// exprs on the arg side are resolved with (argSubst, argScope).
func (fb *ssaFuncBuilder) unifyParamAST(paramAST syntax.Expr, argAST syntax.Expr, tparams []*syntax.Field, typeMap map[string]Type, argSubst map[string]Type, argScope *Scope) {
	if paramAST == nil || argAST == nil {
		return
	}
	switch pt := paramAST.(type) {
	case *syntax.Name:
		for _, tp := range tparams {
			if tp.Name != nil && tp.Name.Value == pt.Value {
				if _, already := typeMap[pt.Value]; already {
					return
				}
				t := resolveTypeExprWithSubst(argAST, argSubst, argScope)
				if t != nil {
					typeMap[pt.Value] = t
				}
				return
			}
		}
	case *syntax.Operation:
		if pt.Y == nil && pt.Op == token.Mul {
			if at, ok := argAST.(*syntax.Operation); ok && at.Y == nil && at.Op == token.Mul {
				fb.unifyParamAST(pt.X, at.X, tparams, typeMap, argSubst, argScope)
			}
		}
	case *syntax.IndexExpr:
		if at, ok := argAST.(*syntax.IndexExpr); ok {
			fb.unifyParamAST(pt.Index, at.Index, tparams, typeMap, argSubst, argScope)
		}
	case *syntax.ListExpr:
		if at, ok := argAST.(*syntax.ListExpr); ok {
			for i, el := range pt.ElemList {
				if i < len(at.ElemList) {
					fb.unifyParamAST(el, at.ElemList[i], tparams, typeMap, argSubst, argScope)
				}
			}
		}
	case *syntax.SliceType:
		if at, ok := argAST.(*syntax.SliceType); ok {
			fb.unifyParamAST(pt.Elem, at.Elem, tparams, typeMap, argSubst, argScope)
		}
	case *syntax.DotsType:
		fb.unifyParamAST(pt.Elem, argAST, tparams, typeMap, argSubst, argScope)
	}
}

// monomorphizeAndCall returns (value, handled). handled is true when the call
// was emitted - the value is nil for void functions, so callers must NOT use
// value-nilness to decide whether to fall through to a non-generic call path
// (that double-emits the call).
func (fb *ssaFuncBuilder) monomorphizeAndCall(fd *syntax.FuncDecl, plainName string, typeArgs []Type, args []SSAValue, targetPkg *SSAPackage, srcPkgPath string, hasDots bool) (s SSAValue, handled bool) {
	for _, ta := range typeArgs {
		if ta == nil {
			return nil, false
		}
	}
	mangledName := mangleGenericName(plainName, typeArgs)
	if srcPkgPath != "" {
		// Two generic funcs with the same name from different packages can
		// mangle identically (e.g. crypto/pbkdf2.Key and
		// crypto/internal/fips140/pbkdf2.Key, both instantiated at
		// hash.Hash); without the source package in the name the second
		// instantiation resolves to the first and recurses.
		pfx := ""
		for j := 0; j < len(srcPkgPath); j++ {
			c := srcPkgPath[j]
			if c == '/' {
				pfx = pfx | "_"
			} else {
				pfx = pfx | string([]byte{c})
			}
		}
		mangledName = pfx | "." | mangledName
	}
	if fn5, ok54 := targetPkg.Members[mangledName].(*SSAFunction); ok54 {
		return fb.emitCallToSSAFunc(fn5, args, hasDots), true
	}
	typeSubst := map[string]Type{}
	for i, tp := range fd.TParamList {
		if tp.Name != nil && i < len(typeArgs) && typeArgs[i] != nil {
			typeSubst[tp.Name.Value] = typeArgs[i]
		}
	}
	var srcScope *Scope
	// Instantiation inside the package being compiled uses that package's live
	// scope. genericPkgScopes holds a scope ScanGenericDecls rebuilt in a
	// persistent arena (it must outlive the compile arena), and the Named
	// objects in it are copies of the package's own types: a generic's
	// signature then disagreed with the non-generic code that calls it
	// (time.Parse returned a Time that parseRFC3339's result type did not
	// match - `time.Time as time.Time`).
	if fb.fn != nil && fb.fn.Pkg != nil && fb.fn.Pkg.Pkg != nil && srcPkgPath == fb.fn.Pkg.Pkg.Path {
		srcScope = fb.fn.Pkg.Pkg.Scope
	}
	if srcScope == nil && cctx.genericPkgScopes != nil {
		if sc, ok := cctx.genericPkgScopes[srcPkgPath]; ok {
			srcScope = sc
		}
	}
	savedImports2 := cctx.sigDeclPkgImports
	// Only replace the context when the declaring package could be identified.
	// Assigning nil here CLEARED the caller's context for a package that is
	// neither the one being compiled nor in the Registry, which turned a
	// resolution that used to keep working into an undefined one. Unknown means
	// "leave what we had", not "resolve nothing".
	if declImports := fb.declPkgImports(srcPkgPath); declImports != nil {
		cctx.sigDeclPkgImports = declImports
	}
	sig := resolveSignatureWithSubst(fd.Type, typeSubst, srcScope)
	if sig == nil {
		cctx.sigDeclPkgImports = savedImports2
		return nil, false
	}
	fn := &SSAFunction{
		name:      mangledName,
		Signature: sig,
		Pkg:       targetPkg,
		Prog:      fb.fn.Prog,
	}
	targetPkg.SetMember(mangledName, fn)
	subFb := newSSAFuncBuilder(fn, fb.info)
	subFb.typeSubst = typeSubst
	subFb.srcScope = srcScope
	// The BODY is source from the declaring package too, so its qualified
	// types and methods resolve through the declaring package's imports for
	// exactly the same reason the signature does. Restoring the context before
	// buildBody left a clone with the CALLER's imports: net/http closes over
	// crypto/tls, which instantiates crypto/internal/fips140/ecdsa's pad000,
	// and that clone's `h.BlockSize()` on a *hmac.HMAC resolved to nothing -
	// buildExpr returned nil, and the short var above it reported "cannot
	// resolve type of short var blockSize in pad000__".
	subFb.buildBody(fd)
	cctx.sigDeclPkgImports = savedImports2
	return fb.emitCallToSSAFunc(fn, args, hasDots), true
}

// declPkgImports returns the import list of the package that DECLARES the
// generic being instantiated, which is not the package being compiled when the
// instantiation happens downstream. The declaring package is a dependency
// there, so its live list is unavailable and the paths recorded in
// DirectImports are resolved through the Registry instead.
func (fb *ssaFuncBuilder) declPkgImports(srcPkgPath string) (out []*TCPackage) {
	if fb.fn != nil && fb.fn.Pkg != nil && fb.fn.Pkg.Pkg != nil && fb.fn.Pkg.Pkg.Path == srcPkgPath {
		return fb.fn.Pkg.Pkg.Imports
	}
	decl := cctx.universe.Registry[srcPkgPath]
	if decl == nil {
		return nil
	}
	for _, p := range cctx.universe.DirectImportPaths(decl) {
		if ip := cctx.universe.Registry[p]; ip != nil {
			out = mxutil.Ensure(out, 1)
			push(out, ip)
		}
	}
	return out
}

func (fb *ssaFuncBuilder) emitCallToSSAFunc(fn *SSAFunction, args []SSAValue, hasDots bool) (s SSAValue) {
	if fn.Signature != nil {
		if fn.Signature.Variadic && !hasDots {
			args = fb.wrapVariadicArgs(args, fn.Signature)
		}
		args = fb.coerceArgsToInterface(args, fn.Signature)
	}
	var retType Type
	if fn.Signature != nil && fn.Signature.Results != nil {
		if fn.Signature.Results.Len() == 1 {
			retType = fn.Signature.Results.At(0).Typ
		} else if fn.Signature.Results.Len() > 1 {
			retType = fn.Signature.Results
		}
	}
	call := &SSACall{Call: SSACallCommon{Value: fn, Args: args}}
	call.typ = retType
	call.name = fb.nextName()
	fb.emit(call)
	if retType == nil {
		return nil
	}
	return call
}

func (fb *ssaFuncBuilder) tryGenericLocalCall(funcName string, argList []syntax.Expr, hasDots bool) (s SSAValue, handled bool) {
	pkgPath := fb.fn.Pkg.Pkg.Path
	key := pkgPath + "." + funcName
	fd, ok := cctx.genericFuncDecls[key]
	if !ok && fb.srcScope != nil {
		for gPkg, gScope := range cctx.genericPkgScopes {
			if gScope == fb.srcScope {
				key = gPkg + "." + funcName
				fd, ok = cctx.genericFuncDecls[key]
				if !ok && gPkg != fb.fn.Pkg.Pkg.Path {
					// Package-local non-generic helper called from a
					// monomorphized body in ANOTHER package: instantiate it
					// here, its symbol is unexported in the source package's
					// object. Within the source package itself the local
					// function is directly available.
					fd, ok = cctx.genericPkgLocalDecls[key]
				}
				if ok {
					pkgPath = gPkg
					break
				}
			}
		}
	}
	if !ok {
		return nil, false
	}
	args := fb.buildArgs(argList)
	typeArgs := inferTypeArgsFromFunc(fd, args)
	typeArgs = fb.inferTypeArgsFromArgASTs(fd, argList, typeArgs)
	return fb.monomorphizeAndCall(fd, funcName, typeArgs, args, fb.fn.Pkg, pkgPath, hasDots)
}


func (fb *ssaFuncBuilder) tryGenericPkgCall(pn *PkgName, funcName string, argList []syntax.Expr, hasDots bool) (s SSAValue, handled bool) {
	imported := pn.Imported
	if imported == nil {
		return nil, false
	}
	key := imported.Path + "." + funcName
	fd, ok := cctx.genericFuncDecls[key]
	if !ok {
		return nil, false
	}
	args := fb.buildArgs(argList)
	typeArgs := inferTypeArgsFromFunc(fd, args)
	typeArgs = fb.inferTypeArgsFromArgASTs(fd, argList, typeArgs)
	return fb.monomorphizeAndCall(fd, funcName, typeArgs, args, fb.fn.Pkg, imported.Path, hasDots)
}

func (fb *ssaFuncBuilder) tryGenericCallFromIndex(ie *syntax.IndexExpr, argList []syntax.Expr, hasDots bool) (s SSAValue, handled bool) {
	switch x := ie.X.(type) {
	case *syntax.Name:
		pkgPath := fb.fn.Pkg.Pkg.Path
		key := pkgPath + "." + x.Value
		fd, ok := cctx.genericFuncDecls[key]
		if !ok && fb.srcScope != nil {
			for gPkg, gScope := range cctx.genericPkgScopes {
				if gScope == fb.srcScope {
					key = gPkg + "." + x.Value
					fd, ok = cctx.genericFuncDecls[key]
					if ok {
						pkgPath = gPkg
						break
					}
				}
			}
		}
		if !ok {
			return nil, false
		}
		typeArgs := fb.resolveExplicitTypeArgs(ie.Index, fd)
		args := fb.buildArgs(argList)
		return fb.monomorphizeAndCall(fd, x.Value, typeArgs, args, fb.fn.Pkg, pkgPath, hasDots)
	case *syntax.SelectorExpr:
		if pkgName, ok2 := x.X.(*syntax.Name); ok2 {
			obj := fb.lookupObject(pkgName.Value)
			if pn, ok3 := obj.(*PkgName); ok3 && pn.Imported != nil {
				key := pn.Imported.Path + "." + x.Sel.Value
				fd, ok4 := cctx.genericFuncDecls[key]
				if !ok4 {
					return nil, false
				}
				typeArgs := fb.resolveExplicitTypeArgs(ie.Index, fd)
				args := fb.buildArgs(argList)
				mono, handledMono := fb.monomorphizeAndCall(fd, x.Sel.Value, typeArgs, args, fb.fn.Pkg, pn.Imported.Path, hasDots)
				return mono, handledMono
			}
		}
	}
	return nil, false
}

func (fb *ssaFuncBuilder) resolveExplicitTypeArgs(indexExpr syntax.Expr, fd *syntax.FuncDecl) (ts []Type) {
	var typeExprs []syntax.Expr
	if le, ok := indexExpr.(*syntax.ListExpr); ok {
		typeExprs = le.ElemList
	} else {
		typeExprs = []syntax.Expr{indexExpr}
	}
	var result []Type
	for _, te := range typeExprs {
		t := fb.resolveTypeAST(te)
		result = mxutil.Ensure(result, 1)
		push(result, t)
	}
	if len(result) < len(fd.TParamList) {
		typeMap := map[string]Type{}
		for i, tp := range fd.TParamList {
			if tp.Name != nil && i < len(result) && result[i] != nil {
				typeMap[tp.Name.Value] = result[i]
			}
		}
		inferFromConstraints(fd.TParamList, typeMap)
		result = nil
		for _, tp := range fd.TParamList {
			if tp.Name != nil {
				push(result, typeMap[tp.Name.Value])
			}
		}
	}
	return result
}


func resolveInterfaceFromAST(e *syntax.InterfaceType) (t *TCInterface) {
	var methods []*IfaceMethod
	if e.MethodList != nil {
		for _, f := range e.MethodList {
			if f.Name != nil {
				m := NewTCIfaceMethod(f.Name.Value, nil)
				methods = mxutil.Ensure(methods, 1)
				push(methods, m)
			}
		}
	}
	iface := NewTCInterface(methods, nil)
	iface.Complete()
	return iface
}
