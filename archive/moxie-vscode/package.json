{
  "name": "moxie-lang",
  "displayName": "Moxie Language Support",
  "description": "Syntax highlighting for Moxie (.mx) files",
  "version": "1.0.0",
  "publisher": "mleku",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "moxie",
        "aliases": ["Moxie", "moxie"],
        "extensions": [".mx"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "moxie",
        "scopeName": "source.moxie",
        "path": "./syntaxes/moxie.tmLanguage.json"
      }
    ]
  }
}
