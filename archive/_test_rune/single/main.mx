package main

func main() {
	println("single-file rune values:")
	println("'a' =", int32('a'))
	println("'b' =", int32('b'))
	println("'z' =", int32('z'))
	println("'0' =", int32('0'))
	println("'9' =", int32('9'))
	println("'A' =", int32('A'))
	println("'Z' =", int32('Z'))
	println("' ' =", int32(' '))
	println("'\\n' =", int32('\n'))
	println("'\\t' =", int32('\t'))
	println("'\\'' =", int32('\''))
	println("'\"' =", int32('"'))
	println("'\\\\' =", int32('\\'))
	println("'/' =", int32('/'))
	println("'_' =", int32('_'))
}
