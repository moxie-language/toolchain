package main

func main() {
	println("many-file rune values (8 files):")
	println("'a' =", runeA())
	println("'b' =", runeB())
	println("'z' =", runeZ())
	println("'0' =", rune0())
	println("'9' =", rune9())
	println("'A' =", runeAU())
	println("'Z' =", runeZU())
	println("' ' =", runeSP())
	println("'\\n' =", runeNL())
	println("'\\t' =", runeTab())
	println("'\\'' =", runeSQ())
	println("'\"' =", runeDQ())
	println("'\\\\' =", runeBS())
	println("'/' =", runeSlash())
	println("'_' =", runeUS())
}
