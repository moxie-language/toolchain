package main

import (
	"os"
	"unsafe"

	"git.smesh.lol/moxie/pkg/emit"
	"git.smesh.lol/moxie/pkg/mod"
	"git.smesh.lol/moxie/pkg/mxutil"
	"git.smesh.lol/moxie/pkg/syntax"
	"git.smesh.lol/moxie/pkg/typeapi"
	"git.smesh.lol/moxie/pkg/types"
)

//export mxc_run
func cRun(argv unsafe.Pointer, argc int32) (n int32)

func fatal(msg string) {
	mxutil.WriteStr(2, "mxc: " | msg | "\n")
	os.Exit(1)
}

func getArgs() (ss []string) {
	data, ok := mxutil.ReadFile("/proc/self/cmdline")
	if !ok {
		return nil
	}
	var args []string
	start := int32(0)
	for i := int32(0); i < int32(len(data)); i++ {
		if data[i] == 0 {
			if i > start {
				args = append(args, string(data[start:i]))
			}
			start = i + 1
		}
	}
	if start < int32(len(data)) {
		args = append(args, string(data[start:]))
	}
	return args
}

func run(args []string) (n int32) {
	argv := []unsafe.Pointer{:len(args) + 1}
	cstrs := [][]byte{:len(args)}
	for i, a := range args {
		b := []byte{:len(a) + 1}
		copy(b, a)
		b[len(a)] = 0
		cstrs[i] = b
		argv[i] = unsafe.Pointer(unsafe.SliceData(b))
	}
	return cRun(unsafe.Pointer(unsafe.SliceData(argv)), int32(len(args)))
}

func getMoxiePath() (s string) {
	p := mxutil.Getenv("MOXIEPATH")
	if p != "" {
		return p
	}
	home := mxutil.Getenv("HOME")
	if home == "" {
		return "./tmp/moxie"
	}
	return mxutil.JoinPath(home, "moxie")
}

func mxcVersion() (s string) { return "1.9.2" }

func moxieCacheDir() (s string) {
	return mxutil.JoinPath(mxutil.JoinPath(getMoxiePath(), "cache"), "mxc-" | mxcVersion())
}

var globalModPrefix string
var globalModDir string
var globalReplaces map[string]string
var builtinOnly []string

func autoFetchRepo(pkgPath, version string) (s string) {
	mpath := getMoxiePath()
	repoPath := pkgPath
	for {
		dest := mxutil.JoinPath(mpath, repoPath)
		gitHead := mxutil.JoinPath(dest, ".git/HEAD")
		_, exists := mxutil.ReadFile(gitHead)
		if exists {
			break
		}
		parent := mxutil.PathDir(repoPath)
		if parent == repoPath || parent == "." || parent == "" {
			break
		}
		parentDest := mxutil.JoinPath(mpath, parent)
		parentGit := mxutil.JoinPath(parentDest, ".git/HEAD")
		_, parentExists := mxutil.ReadFile(parentGit)
		if parentExists {
			repoPath = parent
			break
		}
		repoPath = parent
	}
	if !mod.AcquireRepoLock(mpath, repoPath) {
		mxutil.WriteStr(2, "  waiting for lock: " | repoPath | "\n")
		fatal("repo locked: " | repoPath)
	}
	dest := mxutil.JoinPath(mpath, repoPath)
	gitHead := mxutil.JoinPath(dest, ".git/HEAD")
	_, exists := mxutil.ReadFile(gitHead)
	if !exists {
		mxutil.MkdirAll(mxutil.PathDir(dest), 0755)
		url := "https://" | repoPath
		mxutil.WriteStr(2, "  auto-fetch " | repoPath | "\n")
		if run([]string{"git", "clone", url, dest}) != 0 {
			mod.ReleaseRepoLock(mpath, repoPath)
			return ""
		}
	}
	if version != "" && version != "v0.0.0" {
		if run([]string{"git", "-C", dest, "checkout", version}) != 0 {
			run([]string{"git", "-C", dest, "fetch", "--tags"})
			run([]string{"git", "-C", dest, "pull"})
			run([]string{"git", "-C", dest, "checkout", version})
		}
	}
	mod.ReleaseRepoLock(mpath, repoPath)
	return mxutil.JoinPath(mpath, pkgPath)
}

func cmdFetch(url string) {
	mpath := getMoxiePath()
	mxutil.MkdirAll(mpath, 0755)

	rootDir := "."
	if url != "" {
		modPath := mod.GitURLToModPath(url)
		if modPath == "" {
			fatal("cannot derive module path from URL: " | url)
		}
		dest := mxutil.JoinPath(mpath, modPath)
		_, exists := mxutil.ReadFile(mxutil.JoinPath(dest, ".git/HEAD"))
		if exists {
			mxutil.WriteStr(2, modPath | ": fetch\n")
			run([]string{"git", "-C", dest, "remote", "set-url", "origin", url})
			run([]string{"git", "-C", dest, "fetch", "origin"})
			run([]string{"git", "-C", dest, "reset", "--hard", "origin/HEAD"})
		} else {
			mxutil.WriteStr(2, modPath | ": clone\n")
			mxutil.MkdirAll(mxutil.PathDir(dest), 0755)
			if run([]string{"git", "clone", url, dest}) != 0 {
				fatal("clone failed: " | url)
			}
		}
		rootDir = dest
	}

	modName, reqs, repls := mod.ParseModRequires(rootDir)
	if modName == "" {
		fatal("no moxie.mod in " | rootDir)
	}
	if url == "" {
		mxutil.WriteStr(2, "module: " | modName | "\n")
	}

	var queue []mod.ModRequire
	for _, r := range reqs {
		if _, ok := repls[r.Path]; ok {
			mxutil.WriteStr(2, "  skip (replaced): " | r.Path | "\n")
			continue
		}
		queue = append(queue, r)
	}

	seen := map[string]bool{}
	for len(queue) > 0 {
		req := queue[0]
		queue = queue[1:]
		if seen[req.Path] {
			continue
		}
		seen[req.Path] = true

		if !mod.AcquireRepoLock(mpath, req.Path) {
			mxutil.WriteStr(2, "  locked: " | req.Path | " (another build in progress)\n")
			fatal("repo locked: " | req.Path)
		}

		dest := mxutil.JoinPath(mpath, req.Path)
		gitHead := mxutil.JoinPath(dest, ".git/HEAD")
		_, exists := mxutil.ReadFile(gitHead)

		if !exists {
			mxutil.MkdirAll(mxutil.PathDir(dest), 0755)
			cloneURL := "https://" | req.Path
			mxutil.WriteStr(2, "  clone " | req.Path | "\n")
			if run([]string{"git", "clone", cloneURL, dest}) != 0 {
				mod.ReleaseRepoLock(mpath, req.Path)
				mxutil.WriteStr(2, "  FAIL: clone " | req.Path | "\n")
				continue
			}
		}

		if req.Version != "" && req.Version != "v0.0.0" {
			if run([]string{"git", "-C", dest, "checkout", req.Version}) != 0 {
				mxutil.WriteStr(2, "  tag " | req.Version | " not found, pulling\n")
				run([]string{"git", "-C", dest, "pull"})
				if run([]string{"git", "-C", dest, "checkout", req.Version}) != 0 {
					mxutil.WriteStr(2, "  WARN: " | req.Version | " unavailable for " | req.Path | "\n")
				}
			} else {
				mxutil.WriteStr(2, "  " | req.Path | " @ " | req.Version | "\n")
			}
		} else if exists {
			mxutil.WriteStr(2, "  pull " | req.Path | "\n")
			run([]string{"git", "-C", dest, "pull"})
		} else {
			mxutil.WriteStr(2, "  fetched " | req.Path | "\n")
		}

		mod.ReleaseRepoLock(mpath, req.Path)

		_, subReqs, _ := mod.ParseModRequires(dest)
		for _, sr := range subReqs {
			if !seen[sr.Path] {
				queue = append(queue, sr)
			}
		}
	}

	mxutil.WriteStr(2, "fetch done\n")
}

func pkgCacheDir() (s string) {
	return mxutil.JoinPath(moxieCacheDir(), "pkg")
}

func pkgCacheKey(dir string, files []string) (s string) {
	var sorted []string
	for _, f := range files {
		sorted = append(sorted, f)
	}
	for i := int32(1); i < int32(len(sorted)); i++ {
		for j := i; j > 0 && sorted[j] < sorted[j-1]; j-- {
			sorted[j], sorted[j-1] = sorted[j-1], sorted[j]
		}
	}
	var all []byte
	for _, f := range sorted {
		p := mxutil.JoinPath(dir, f)
		data, ok := mxutil.ReadFile(p)
		if !ok {
			continue
		}
		all = append(all, data...)
		all = append(all, 0)
	}
	return mxutil.FnvHash(all)
}

func versionedCacheName(hash, version, ext string) (s string) {
	if version != "" {
		return hash | "_" | version | ext
	}
	return hash | ext
}

func cachedBcPath(cacheBase, pkgPath, hash, version string) (s string) {
	return mxutil.JoinPath(mxutil.JoinPath(cacheBase, mxutil.SafeName(pkgPath)), versionedCacheName(hash, version, ".o"))
}

func cachedMxhPath(cacheBase, pkgPath, hash, version string) (s string) {
	return mxutil.JoinPath(mxutil.JoinPath(cacheBase, mxutil.SafeName(pkgPath)), versionedCacheName(hash, version, ".mxh"))
}

func loadSysroot(path string) {
	data, ok := mxutil.ReadFile(path)
	if !ok {
		return
	}
	for _, line := range mxutil.SplitLines(string(data)) {
		line = mxutil.TrimSpace(line)
		if len(line) == 0 || line[0] == '#' {
			continue
		}
		eq := int32(-1)
		for i := int32(0); i < int32(len(line)); i++ {
			if line[i] == '=' {
				eq = i
				break
			}
		}
		if eq < 0 {
			continue
		}
		key := line[:eq]
		val := line[eq+1:]
		os.Setenv(key, val)
	}
}

type srcSpan struct {
	file      string
	outStart  int32
	srcLine   int32
}

var concatSourceMap []srcSpan

func concatLineToFile(concatLine int32) (string, int32) {
	if len(concatSourceMap) == 0 {
		return "", concatLine
	}
	best := int32(0)
	for i, s := range concatSourceMap {
		if s.outStart <= concatLine {
			best = int32(i)
		}
	}
	sp := concatSourceMap[best]
	return sp.file, sp.srcLine + (concatLine - sp.outStart)
}

func concatSources(dir string, files []string) (buf []byte) {
	imports := map[string]bool{}
	var bodies [][]byte
	var bodyFiles []string
	var bodyStartLines []int32
	pkgName := ""
	for _, f := range files {
		data, ok := mxutil.ReadFile(mxutil.JoinPath(dir, f))
		if !ok {
			continue
		}
		if pkgName == "" {
			pkgName = mod.ExtractPkgName(data)
		}
		lines := mxutil.SplitLines(string(data))
		var body []string
		i := int32(0)
		firstBodyLine := int32(0)
		for i < int32(len(lines)) {
			line := mxutil.TrimSpace(lines[i])
			if mxutil.HasPrefix(line, "package ") {
				i++
				continue
			}
			if line == "import (" {
				i++
				for i < int32(len(lines)) {
					imp := mxutil.TrimSpace(lines[i])
					i++
					if imp == ")" {
						break
					}
					if imp != "" {
						imports[imp] = true
					}
				}
				continue
			}
			if mxutil.HasPrefix(line, "import ") && !mxutil.HasPrefix(line, "import (") {
				imp := line[7:]
				imports[imp] = true
				i++
				continue
			}
			if len(body) == 0 {
				firstBodyLine = i + 1
			}
			body = append(body, lines[i])
			i++
		}
		bodies = append(bodies, []byte(mxutil.JoinStrings(body, "\n")))
		bodyFiles = append(bodyFiles, f)
		bodyStartLines = append(bodyStartLines, firstBodyLine)
	}
	var out []byte
	out = append(out, ("package " | pkgName | "\n")...)
	if len(imports) > 0 {
		var impKeys []string
		for imp := range imports {
			impKeys = append(impKeys, imp)
		}
		for i := int32(1); i < int32(len(impKeys)); i++ {
			for j := i; j > 0 && impKeys[j] < impKeys[j-1]; j-- {
				impKeys[j], impKeys[j-1] = impKeys[j-1], impKeys[j]
			}
		}
		out = append(out, "import (\n"...)
		for _, imp := range impKeys {
			out = append(out, '\t')
			out = append(out, imp...)
			out = append(out, '\n')
		}
		out = append(out, ")\n"...)
	}
	concatSourceMap = nil
	outLine := int32(1)
	for j := int32(0); j < int32(len(out)); j++ {
		if out[j] == '\n' {
			outLine++
		}
	}
	for i, b := range bodies {
		concatSourceMap = append(concatSourceMap, srcSpan{
			file:     bodyFiles[i],
			outStart: outLine,
			srcLine:  bodyStartLines[i],
		})
		for j := int32(0); j < int32(len(b)); j++ {
			if b[j] == '\n' {
				outLine++
			}
		}
		outLine++
		out = append(out, b...)
		out = append(out, '\n')
		bodies[i] = nil
	}
	bodies = nil
	imports = nil
	return out
}

func remapErrorLines(msg string) (s string) {
	if len(concatSourceMap) == 0 {
		return msg
	}
	lines := mxutil.SplitLines(msg)
	var out []string
	for _, line := range lines {
		out = append(out, remapOneLine(line))
	}
	return mxutil.JoinStrings(out, "\n")
}

func remapOneLine(line string) (s string) {
	if len(concatSourceMap) == 0 {
		return line
	}
	colonCount := int32(0)
	firstColon := int32(-1)
	secondColon := int32(-1)
	for i := int32(0); i < int32(len(line)); i++ {
		if line[i] == ':' {
			colonCount++
			if colonCount == 1 {
				firstColon = i
			} else if colonCount == 2 {
				secondColon = i
				break
			}
		}
	}
	if secondColon < 0 {
		return line
	}
	numStr := line[firstColon+1 : secondColon]
	n := int32(0)
	valid := len(numStr) > 0
	for i := int32(0); i < int32(len(numStr)); i++ {
		if numStr[i] < '0' || numStr[i] > '9' {
			valid = false
			break
		}
		n = n*10 + int32(numStr[i]-'0')
	}
	if !valid {
		return line
	}
	file, srcLine := concatLineToFile(n)
	if file == "" {
		return line
	}
	return file | ":" | mxutil.SimpleItoa(srcLine) | line[secondColon:]
}

func compileSource(src []byte, pkgName, triple string) (s string) {
	ir := emit.CompileToIR(src, pkgName, triple)
	if len(ir) > 0 && ir[0] == ';' {
		mxutil.WriteStr(2, remapErrorLines(ir))
		fatal("compile error for " | pkgName)
	}
	if len(ir) == 0 {
		fatal("empty IR for " | pkgName)
	}
	return ir
}

var typeDescPkgPath string

func typeDescStr(t typeapi.Type) (s string) {
	if t == nil {
		return "interface{}"
	}
	switch v := t.(type) {
	case *types.Basic:
		switch v.Kind() {
		case types.Bool:
			return "bool"
		case types.Int8:
			return "int8"
		case types.Int16:
			return "int16"
		case types.Int32:
			return "int32"
		case types.Int64:
			return "int64"
		case types.Uint8:
			return "uint8"
		case types.Uint16:
			return "uint16"
		case types.Uint32:
			return "uint32"
		case types.Uint64:
			return "uint64"
		case types.Float32:
			return "float32"
		case types.Float64:
			return "float64"
		case types.TCString:
			return "string"
		case types.UnsafePointer:
			return "ptr"
		}
		return "int32"
	case *types.Slice:
		return "[]" | typeDescStr(v.Elem())
	case *types.Array:
		return "[" | mxutil.SimpleItoa64(v.Len()) | "]" | typeDescStr(v.Elem())
	case *types.Pointer:
		return "*" | typeDescStr(v.Elem())
	case *types.TCStruct:
		s := "struct{"
		for i := int32(0); i < v.NumFields(); i++ {
			if i > 0 {
				s = s | ","
			}
			f := v.Field(i)
			s = s | f.Name() | ":" | typeDescStr(f.Type())
		}
		return s | "}"
	case *types.TCInterface:
		if v.IsEmpty() {
			return "interface{}"
		}
		if v.NumMethods() == 1 && v.Method(0).Name() == "Error" {
			return "error"
		}
		return "interface{}"
	case *types.TCChan:
		switch v.Dir() {
		case types.TCSendOnly:
			return "chan<-:" | typeDescStr(v.Elem())
		case types.TCRecvOnly:
			return "<-chan:" | typeDescStr(v.Elem())
		}
		return "chan:" | typeDescStr(v.Elem())
	case *types.TCMap:
		return "map[" | typeDescStr(v.Key()) | "]" | typeDescStr(v.Elem())
	case *types.Named:
		if v.Obj() != nil {
			if typeDescPkgPath != "" && v.Obj().Pkg() != nil && v.Obj().Pkg().Path() != typeDescPkgPath {
				return v.Obj().Pkg().Path() | "." | v.Obj().Name()
			}
			return v.Obj().Name()
		}
		return typeDescStr(v.RawUnderlying())
	}
	return "interface{}"
}

func sigDescStr(sig *types.Signature) (s string) {
	var out string
	if sig.Params() != nil {
		for i := int32(0); i < sig.Params().Len(); i++ {
			if i > 0 {
				out = out | ","
			}
			out = out | typeDescStr(sig.Params().At(i).Type())
		}
	}
	if sig.Results() != nil && sig.Results().Len() > 0 {
		out = out | "->"
		for i := int32(0); i < sig.Results().Len(); i++ {
			if i > 0 {
				out = out | ","
			}
			out = out | typeDescStr(sig.Results().At(i).Type())
		}
	}
	return out
}

func generateMxh(pkg *types.TCPackage) (s string) {
	path := pkg.Path()
	name := pkg.Name()
	typeDescPkgPath = path
	var out string
	out = "package " | path | " " | name | "\n"
	for _, objName := range pkg.Scope().Names() {
		if len(objName) == 0 {
			continue
		}
		exported := objName[0] >= 'A' && objName[0] <= 'Z'
		obj := pkg.Scope().Lookup(objName)
		if obj == nil {
			continue
		}
		if !exported {
			if tn, ok := obj.(*types.TypeName); ok {
				if named, ok2 := tn.Type().(*types.Named); ok2 && named.NumMethods() > 0 {
				} else {
					continue
				}
			} else {
				continue
			}
		}
		switch v := obj.(type) {
		case *types.TCFunc:
			sig := v.Signature()
			if sig != nil {
				out = out | "func " | objName | " " | sigDescStr(sig) | "\n"
			}
		case *types.TCVar:
			out = out | "var " | objName | " " | typeDescStr(v.Type()) | "\n"
		case *types.TCConst:
			td := typeDescStr(v.Type())
			vs := ""
			if v.Val() != nil {
				vs = v.Val().String()
			}
			out = out | "const " | objName | " " | td | " " | vs | "\n"
		case *types.TypeName:
			typ := v.Type()
			if named, ok := typ.(*types.Named); ok {
				if ui, ok2 := named.RawUnderlying().(*types.TCInterface); ok2 && ui != nil && !ui.IsEmpty() {
					var methods string
					for mi := int32(0); mi < ui.NumMethods(); mi++ {
						m := ui.Method(mi)
						if mi > 0 {
							methods = methods | ";"
						}
						methods = methods | m.Name() | "=" | sigDescStr(m.Sig())
					}
					out = out | "iface " | objName | " " | methods | "\n"
				} else {
					ud := ""
					if named.RawUnderlying() != nil {
						ud = typeDescStr(named.RawUnderlying())
					}
					out = out | "type " | objName | " " | ud | "\n"
					for _, m := range named.Methods() {
						ptrRecv := "0"
						if m.HasPtrRecv() {
							ptrRecv = "1"
						}
						msig := m.Signature()
						if msig != nil {
							out = out | "method " | objName | " " | m.Name() | " " | sigDescStr(msig) | " " | ptrRecv | "\n"
						}
					}
				}
			} else if iface, ok := typ.(*types.TCInterface); ok {
				var methods string
				for mi := int32(0); mi < iface.NumMethods(); mi++ {
					m := iface.Method(mi)
					if mi > 0 {
						methods = methods | ";"
					}
					methods = methods | m.Name() | "=" | sigDescStr(m.Sig())
				}
				out = out | "iface " | objName | " " | methods | "\n"
			}
		}
	}
	return out
}

func loadMxh(path string) (ok bool) {
	data, ok := mxutil.ReadFile(path)
	if !ok {
		return false
	}
	emit.EnsureImportRegistry()
	lines := mxutil.SplitLines(string(data))
	if len(lines) == 0 {
		return false
	}
	first := lines[0]
	if !mxutil.HasPrefix(first, "package ") {
		return false
	}
	rest := first[8:]
	spaceIdx := int32(-1)
	for i := int32(0); i < int32(len(rest)); i++ {
		if rest[i] == ' ' {
			spaceIdx = i
			break
		}
	}
	if spaceIdx < 0 {
		return false
	}
	pkgPath := rest[:spaceIdx]
	pkgName := rest[spaceIdx+1:]
	pkg := types.NewTCPackage(pkgPath, pkgName)

	oldScope := emit.ParseTypePkgScope
	emit.ParseTypePkgScope = pkg.Scope()

	for li := 1; li < len(lines); li++ {
		line := lines[li]
		if mxutil.HasPrefix(line, "type ") {
			parts := mxutil.SplitBySpace(line[5:])
			if len(parts) >= 1 {
				tn := types.NewTypeName(pkg, parts[0], nil)
				types.NewNamed(tn, nil)
				pkg.Scope().Insert(tn)
			}
		} else if mxutil.HasPrefix(line, "iface ") {
			parts := mxutil.SplitBySpace(line[6:])
			if len(parts) >= 1 {
				placeholder := types.NewTCInterface(nil, nil)
				placeholder.Complete()
				tn := types.NewTypeName(pkg, parts[0], nil)
				types.NewNamed(tn, placeholder)
				pkg.Scope().Insert(tn)
			}
		}
	}

	for li := 1; li < len(lines); li++ {
		line := lines[li]
		if mxutil.HasPrefix(line, "type ") {
			parts := mxutil.SplitBySpace(line[5:])
			if len(parts) >= 2 {
				underlying := emit.ParseTypeDesc(parts[1])
				obj := pkg.Scope().Lookup(parts[0])
				if tn, ok := obj.(*types.TypeName); ok {
					if named, ok2 := tn.Type().(*types.Named); ok2 {
						named.SetUnderlying(underlying)
					}
				}
			} else if len(parts) == 1 {
				obj := pkg.Scope().Lookup(parts[0])
				if tn, ok := obj.(*types.TypeName); ok {
					if named, ok2 := tn.Type().(*types.Named); ok2 {
						named.SetUnderlying(types.NewTCStruct(nil, nil))
					}
				}
			}
		} else if mxutil.HasPrefix(line, "iface ") {
			parts := mxutil.SplitBySpace(line[6:])
			if len(parts) >= 1 {
				ifaceName := parts[0]
				methodsDesc := ""
				if len(parts) >= 2 {
					methodsDesc = parts[1]
				}
				var methods []*types.IfaceMethod
				if methodsDesc != "" {
					mparts := emit.SplitSemicolon(methodsDesc)
					for _, p := range mparts {
						eqIdx := -1
						for i := 0; i < len(p); i++ {
							if p[i] == '=' {
								eqIdx = i
								break
							}
						}
						if eqIdx < 0 {
							continue
						}
						mname := p[:eqIdx]
						msig := emit.ParseSignatureDesc(p[eqIdx+1:])
						methods = append(methods, types.NewTCIfaceMethod(mname, msig))
					}
				}
				iface := types.NewTCInterface(methods, nil)
				iface.Complete()
				obj := pkg.Scope().Lookup(ifaceName)
				if tn, ok := obj.(*types.TypeName); ok {
					if named, ok2 := tn.Type().(*types.Named); ok2 {
						named.SetUnderlying(iface)
					} else {
						tn.SetType(iface)
					}
				}
			}
		}
	}

	for li := 1; li < len(lines); li++ {
		line := lines[li]
		if mxutil.HasPrefix(line, "func ") {
			parts := mxutil.SplitBySpace(line[5:])
			if len(parts) >= 2 {
				sig := emit.ParseSignatureDesc(parts[1])
				pkg.Scope().Insert(types.NewTCFunc(pkg, parts[0], sig))
			} else if len(parts) == 1 {
				sig := emit.ParseSignatureDesc("")
				pkg.Scope().Insert(types.NewTCFunc(pkg, parts[0], sig))
			}
		} else if mxutil.HasPrefix(line, "var ") {
			parts := mxutil.SplitBySpace(line[4:])
			if len(parts) >= 2 {
				typ := emit.ParseTypeDesc(parts[1])
				pkg.Scope().Insert(types.NewTCVar(pkg, parts[0], typ))
			}
		} else if mxutil.HasPrefix(line, "const ") {
			parts := mxutil.SplitBySpace(line[6:])
			if len(parts) >= 2 {
				typ := emit.ParseTypeDesc(parts[1])
				var val types.ConstVal
				if len(parts) >= 3 {
					rest := parts[2]
					for k := int32(3); k < int32(len(parts)); k++ {
						rest = rest | " " | parts[k]
					}
					isNum := true
					for ci := int32(0); ci < int32(len(rest)); ci++ {
						ch := rest[ci]
						if !((ch >= '0' && ch <= '9') || ch == '-' || ch == '+' || ch == 'x' || ch == 'X' || (ch >= 'a' && ch <= 'f') || (ch >= 'A' && ch <= 'F')) {
							isNum = false
							break
						}
					}
					if isNum {
						n := mxutil.ParseInt64(rest)
						val = &types.ConstInt{V: n}
					} else {
						if b, ok := typ.(*types.Basic); ok && (b.Kind() == types.TCString || b.Kind() == types.UntypedString) {
							val = &types.ConstStr{S: rest}
						} else {
							val = &types.ConstInt{V: 0}
						}
					}
				} else {
					val = &types.ConstInt{V: 0}
				}
				pkg.Scope().Insert(types.NewTCConst(pkg, parts[0], typ, val))
			}
		} else if mxutil.HasPrefix(line, "method ") {
			parts := mxutil.SplitBySpace(line[7:])
			if len(parts) >= 3 {
				typeName := parts[0]
				methodName := parts[1]
				sigDesc := parts[2]
				ptrRecv := false
				if len(parts) >= 4 && parts[3] == "1" {
					ptrRecv = true
				}
				obj := pkg.Scope().Lookup(typeName)
				if obj != nil {
					if tn, ok := obj.(*types.TypeName); ok {
						if named, ok := tn.Type().(*types.Named); ok {
							sig := emit.ParseSignatureDesc(sigDesc)
							var recvType typeapi.Type = named
							if ptrRecv {
								recvType = types.NewPointer(named)
							}
							sig = types.NewSignature(types.NewTCVar(pkg, "", recvType), sig.Params(), sig.Results(), sig.Variadic())
							fn := types.NewTCFunc(pkg, methodName, sig)
							fn.SetPtrRecv(ptrRecv)
							named.AddMethod(fn)
						}
					}
				}
			}
		}
	}

	emit.ParseTypePkgScope = oldScope
	data = nil
	lines = nil
	emit.ImportRegistry[pkgPath] = pkg
	return true
}

func registerBuiltins() {
	types.InitUniverse()
	emit.EnsureImportRegistry()
	emit.ImportRegistry = map[string]*types.TCPackage{}

	unsafePkg := types.NewTCPackage("unsafe", "unsafe")
	unsafePkg.Scope().Insert(types.NewTypeName(unsafePkg, "Pointer", types.Typ[types.UnsafePointer]))
	unsafePkg.Scope().Insert(types.NewTCFunc(unsafePkg, "Sizeof", emit.ParseSignatureDesc("interface{}->int32")))
	unsafePkg.Scope().Insert(types.NewTCFunc(unsafePkg, "Offsetof", emit.ParseSignatureDesc("interface{}->int32")))
	unsafePkg.Scope().Insert(types.NewTCFunc(unsafePkg, "Alignof", emit.ParseSignatureDesc("interface{}->int32")))
	unsafePkg.Scope().Insert(types.NewTCFunc(unsafePkg, "Slice", emit.ParseSignatureDesc("ptr,int32->[]uint8")))
	unsafePkg.Scope().Insert(types.NewTCFunc(unsafePkg, "SliceData", emit.ParseSignatureDesc("[]uint8->ptr")))
	emit.ImportRegistry["unsafe"] = unsafePkg

	emit.ImportRegistry["moxie"] = types.NewTCPackage("moxie", "moxie")

	rtPkg := types.NewTCPackage("runtime", "runtime")
	rtPkg.Scope().Insert(types.NewTCFunc(rtPkg, "InitCShared", emit.ParseSignatureDesc("")))
	emit.ImportRegistry["runtime"] = rtPkg
}

func addPtrMethod(pkg *types.TCPackage, named *types.Named, name, sigDesc string) {
	var sig *types.Signature
	if sigDesc == "" {
		sig = types.NewSignature(nil, nil, nil, false)
	} else {
		sig = emit.ParseSignatureDesc(sigDesc)
	}
	recvType := types.NewPointer(named)
	sig = types.NewSignature(types.NewTCVar(pkg, "", recvType), sig.Params(), sig.Results(), sig.Variadic())
	fn := types.NewTCFunc(pkg, name, sig)
	fn.SetPtrRecv(true)
	named.AddMethod(fn)
}

func removeAll(path string) {
	entries := mxutil.ListFiles(path, "")
	if entries == nil {
		return
	}
	for _, e := range entries {
		os.Remove(mxutil.JoinPath(path, e))
	}
	os.Remove(path)
}

func walkStdlibPkgs(srcDir, prefix string, out []string) []string {
	entries := mxutil.ListFiles(srcDir, "")
	if entries == nil {
		return out
	}
	mxFiles := mxutil.ListFiles(srcDir, ".mx")
	if len(mxFiles) > 0 && prefix != "" {
		out = append(out, prefix)
	}
	for _, e := range entries {
		if e[0] == '.' || e[0] == '_' {
			continue
		}
		sub := mxutil.JoinPath(srcDir, e)
		subEntries := mxutil.ListFiles(sub, "")
		if subEntries != nil {
			var subPrefix string
			if prefix == "" {
				subPrefix = e
			} else {
				subPrefix = prefix | "/" | e
			}
			out = walkStdlibPkgs(sub, subPrefix, out)
		}
	}
	return out
}

func cmdCacheWarm() {
	root := mxutil.Getenv("MOXIEROOT")
	if root == "" {
		root = "."
	}
	srcDir := mxutil.JoinPath(root, "src")
	mxutil.WriteStr(2, "warming stdlib cache from " | srcDir | " ...\n")
	pkgPaths := walkStdlibPkgs(srcDir, "", nil)
	if len(pkgPaths) == 0 {
		mxutil.WriteStr(2, "  no stdlib packages found\n")
		return
	}
	triple := "x86_64-unknown-linux-musleabihf"
	clang := "clang-21"
	tmpdir := "./tmp/mxc-build"
	mxutil.MkdirAll(tmpdir, 0755)
	cacheBase := pkgCacheDir()
	registerBuiltins()
	compiled := int32(0)
	skipped := int32(0)
	failed := int32(0)
	for _, pkgPath := range pkgPaths {
		isBuiltin := false
		for _, b := range builtinOnly {
			if pkgPath == b {
				isBuiltin = true
				break
			}
		}
		if isBuiltin {
			continue
		}
		pkg := mod.DiscoverPkg(pkgPath, root, globalModPrefix, globalModDir, getMoxiePath(), globalReplaces, builtinOnly, false)
		if pkg == nil {
			skipped++
			continue
		}
		hash := pkgCacheKey(pkg.Dir, pkg.Files)
		cached := cachedBcPath(cacheBase, pkg.Path, hash, pkg.Version)
		cachedMxh := cachedMxhPath(cacheBase, pkg.Path, hash, pkg.Version)
		_, bcOk := mxutil.ReadFile(cached)
		_, mxhOk := mxutil.ReadFile(cachedMxh)
		if bcOk && mxhOk {
			skipped++
			continue
		}
		compilePath := pkg.Path
		if mxutil.HasPrefix(compilePath, "/") || mxutil.HasPrefix(compilePath, "./") || mxutil.HasPrefix(compilePath, "../") {
			compilePath = pkg.Name
		}
		src := concatSources(pkg.Dir, pkg.Files)
		ir := compileSource(src, compilePath, triple)
		src = nil
		llFile := mxutil.JoinPath(tmpdir, mxutil.SafeName(pkg.Path) | ".ll")
		mxutil.WriteFile(llFile, []byte(ir), 0644)
		ir = ""
		bcFile := mxutil.JoinPath(tmpdir, mxutil.SafeName(pkg.Path) | ".o")
		rc := run([]string{clang, "--target=" | triple, "-c", llFile, "-o", bcFile})
		if rc != 0 {
			mxutil.WriteStr(2, "  FAIL: " | pkg.Path | "\n")
			failed++
			continue
		}
		cdir := mxutil.JoinPath(cacheBase, mxutil.SafeName(pkg.Path))
		mxutil.MkdirAll(cdir, 0755)
		data, rok := mxutil.ReadFile(bcFile)
		if rok {
			mxutil.WriteFile(cached, data, 0644)
		}
		data = nil
		regPkg := emit.ImportRegistry[compilePath]
		if regPkg != nil {
			mxhData := generateMxh(regPkg)
			mxutil.WriteFile(cachedMxh, []byte(mxhData), 0644)
		}
		compiled++
		mxutil.WriteStr(2, "  " | pkg.Path | "\n")
	}
	mxutil.WriteStr(2, "warm done: " | mxutil.SimpleItoa(compiled) | " compiled, " | mxutil.SimpleItoa(skipped) | " cached, " | mxutil.SimpleItoa(failed) | " failed\n")
}

func cacheClean() {
	base := pkgCacheDir()
	mxutil.WriteStr(2, "cleaning cache: " | base | "\n")
	entries := mxutil.ListFiles(base, "")
	if entries == nil {
		mxutil.WriteStr(2, "  (empty)\n")
		return
	}
	for _, e := range entries {
		removeAll(mxutil.JoinPath(base, e))
	}
	os.Remove(base)
	mxutil.WriteStr(2, "  done\n")
}

func cmdUpdate(rebuildAll bool) {
	cacheRoot := mxutil.JoinPath(getMoxiePath(), "cache")
	currentDir := "mxc-" | mxcVersion()
	entries := mxutil.ListFiles(cacheRoot, "")
	if entries == nil {
		mxutil.WriteStr(2, "cache is empty\n")
		return
	}
	for _, e := range entries {
		if mxutil.HasPrefix(e, "mxc-") && e != currentDir {
			mxutil.WriteStr(2, "  remove old: " | e | "\n")
			fullPath := mxutil.JoinPath(cacheRoot, e)
			pkgEntries := mxutil.ListFiles(fullPath, "")
			if pkgEntries != nil {
				for _, pe := range pkgEntries {
					removeAll(mxutil.JoinPath(fullPath, pe))
				}
			}
			os.Remove(fullPath)
		}
	}
	if !rebuildAll {
		mxutil.WriteStr(2, "update done\n")
		return
	}
	mxutil.WriteStr(2, "rebuilding all cached packages...\n")
	mpath := getMoxiePath()
	root := mxutil.Getenv("MOXIEROOT")
	if root == "" {
		root = "."
	}
	cacheBase := pkgCacheDir()
	pkgDirs := mxutil.ListFiles(cacheBase, "")
	if pkgDirs == nil {
		mxutil.WriteStr(2, "  no packages to rebuild\n")
		return
	}
	triple := "x86_64-unknown-linux-musleabihf"
	clang := "clang-21"
	tmpdir := "./tmp/mxc-build"
	mxutil.MkdirAll(tmpdir, 0755)
	registerBuiltins()
	for _, pkgDir := range pkgDirs {
		pkgPath := ""
		for i := 0; i < len(pkgDir); i++ {
			if pkgDir[i] == '_' {
				pkgPath = pkgPath | "/"
			} else {
				pkgPath = pkgPath | string([]byte{pkgDir[i]})
			}
		}
		if len(pkgPath) > 0 && pkgPath[0] == '/' {
			continue
		}
		mxutil.WriteStr(2, "  rebuild " | pkgPath | "\n")
		pkg := mod.DiscoverPkg(pkgPath, root, globalModPrefix, globalModDir, getMoxiePath(), globalReplaces, builtinOnly, false)
		if pkg == nil {
			candidate := mxutil.JoinPath(mpath, pkgPath)
			mxF := mxutil.ListFiles(candidate, ".mx")
			if len(mxF) > 0 {
				pkg = mod.DiscoverPkg(pkgPath, root, globalModPrefix, globalModDir, getMoxiePath(), globalReplaces, builtinOnly, false)
			}
		}
		if pkg == nil {
			mxutil.WriteStr(2, "    skip (source not found)\n")
			continue
		}
		compilePath := pkg.Path
		if compilePath == "." || compilePath == ".." || mxutil.HasPrefix(compilePath, "/") || mxutil.HasPrefix(compilePath, "./") || mxutil.HasPrefix(compilePath, "../") {
			compilePath = pkg.Name
		}
		src := concatSources(pkg.Dir, pkg.Files)
		ir := compileSource(src, compilePath, triple)
		src = nil
		llFile := mxutil.JoinPath(tmpdir, mxutil.SafeName(pkg.Path) | ".ll")
		mxutil.WriteFile(llFile, []byte(ir), 0644)
		ir = ""
		bcFile := mxutil.JoinPath(tmpdir, mxutil.SafeName(pkg.Path) | ".o")
		rc := run([]string{clang, "--target=" | triple, "-c", llFile, "-o", bcFile})
		if rc != 0 {
			mxutil.WriteStr(2, "    FAIL: clang for " | pkg.Path | "\n")
			continue
		}
		hash := pkgCacheKey(pkg.Dir, pkg.Files)
		cached := cachedBcPath(cacheBase, pkg.Path, hash, pkg.Version)
		cdir := mxutil.JoinPath(cacheBase, mxutil.SafeName(pkg.Path))
		mxutil.MkdirAll(cdir, 0755)
		data, rok := mxutil.ReadFile(bcFile)
		if rok {
			mxutil.WriteFile(cached, data, 0644)
		}
		data = nil
		regPkg := emit.ImportRegistry[compilePath]
		if regPkg != nil {
			cachedMxh := cachedMxhPath(cacheBase, pkg.Path, hash, pkg.Version)
			mxhData := generateMxh(regPkg)
			mxutil.WriteFile(cachedMxh, []byte(mxhData), 0644)
		}
	}
	mxutil.WriteStr(2, "rebuild done\n")
}

func scanTestFuncs(data []byte) (ss []string) {
	var funcs []string
	lines := mxutil.SplitLines(string(data))
	for _, line := range lines {
		line = mxutil.TrimSpace(line)
		if !mxutil.HasPrefix(line, "func Test") {
			continue
		}
		paren := int32(-1)
		for i := int32(5); i < int32(len(line)); i++ {
			if line[i] == '(' {
				paren = i
				break
			}
		}
		if paren < 0 {
			continue
		}
		name := line[5:paren]
		if len(name) == 0 {
			continue
		}
		if name[0] < 'A' || name[0] > 'Z' {
			continue
		}
		rest := line[paren:]
		if mxutil.HasPrefix(rest, "(t *testing.T)") {
			funcs = append(funcs, name)
		}
	}
	return funcs
}

func generateTestMain(pkgName string, testFuncs []string) (buf []byte) {
	var out []byte
	out = append(out, ("package " | pkgName | "\n\nimport \"testing\"\n\nfunc main() {\n\ttests := []testing.InternalTest{\n")...)
	for _, name := range testFuncs {
		out = append(out, ("\t\t{Name: \"" | name | "\", F: " | name | "},\n")...)
	}
	out = append(out, "\t}\n\ttesting.Main(tests)\n}\n"...)
	return out
}

func cmdTest(args []string) {
	pkgPath := ""
	forceRebuild := false
	verbose := false
	i := int32(2)
	for i < int32(len(args)) {
		if args[i] == "-a" {
			forceRebuild = true
			i++
		} else if args[i] == "-v" {
			verbose = true
			i++
		} else {
			pkgPath = args[i]
			i++
		}
	}
	if pkgPath == "" {
		pkgPath = "."
	}
	_ = verbose

	root := mxutil.Getenv("MOXIEROOT")
	if root == "" {
		root = "."
	}
	triple := "x86_64-unknown-linux-musleabihf"
	clang := "clang-21"

	if mxutil.HasPrefix(pkgPath, "./") || mxutil.HasPrefix(pkgPath, "../") || pkgPath == "." || mxutil.HasPrefix(pkgPath, "/") {
		absDir := pkgPath
		if absDir == "." {
			absDir = ""
		}
		globalModPrefix, globalModDir, globalReplaces = mod.FindModuleRoot(absDir)
	}

	registerBuiltins()

	var testPkgDir string
	if pkgPath == "." || pkgPath == ".." || mxutil.HasPrefix(pkgPath, "/") || mxutil.HasPrefix(pkgPath, "./") || mxutil.HasPrefix(pkgPath, "../") {
		testPkgDir = pkgPath
	} else {
		testPkgDir = mxutil.JoinPath(root, mxutil.JoinPath("src", pkgPath))
	}

	testFiles := mxutil.ListFiles(testPkgDir, "_test.mx")
	if len(testFiles) == 0 {
		mxutil.WriteStr(2, "no test files found in " | testPkgDir | "\n")
		return
	}

	var allTestFuncs []string
	for _, tf := range testFiles {
		data, ok := mxutil.ReadFile(mxutil.JoinPath(testPkgDir, tf))
		if !ok {
			continue
		}
		funcs := scanTestFuncs(data)
		for _, fn := range funcs {
			allTestFuncs = append(allTestFuncs, fn)
		}
	}
	if len(allTestFuncs) == 0 {
		mxutil.WriteStr(2, "no Test* functions found\n")
		return
	}

	mxutil.WriteStr(2, "=== test: " | pkgPath | " ===\n")
	for _, fn := range allTestFuncs {
		mxutil.WriteStr(2, "  found " | fn | "\n")
	}

	pkgName := ""
	for _, tf := range testFiles {
		data, ok := mxutil.ReadFile(mxutil.JoinPath(testPkgDir, tf))
		if ok && pkgName == "" {
			pkgName = mod.ExtractPkgName(data)
		}
	}
	if pkgName == "" {
		pkgName = "main"
	}

	tmpdir := "./tmp/mxc-testbuild"
	mxutil.MkdirAll(tmpdir, 0755)

	testMainSrc := generateTestMain(pkgName, allTestFuncs)
	testMainFile := mxutil.JoinPath(tmpdir, "_testmain.mx")
	mxutil.WriteFile(testMainFile, testMainSrc, 0644)

	pkg := mod.DiscoverPkg(pkgPath, root, globalModPrefix, globalModDir, getMoxiePath(), globalReplaces, builtinOnly, false)
	if pkg == nil {
		fatal("cannot find package " | pkgPath)
	}

	for _, tf := range testFiles {
		pkg.Files = append(pkg.Files, tf)
	}
	pkg.Files = append(pkg.Files, testMainFile)
	pkg.Name = "main"

	if !hasImportStr(pkg.Imports, "testing") {
		pkg.Imports = append(pkg.Imports, "testing")
	}

	pkgs := resolveTestDeps(pkg, root)

	cacheBase := pkgCacheDir()

	for _, dp := range pkgs {
		compilePath := dp.Path
		if compilePath == "." || compilePath == ".." || mxutil.HasPrefix(compilePath, "/") || mxutil.HasPrefix(compilePath, "./") || mxutil.HasPrefix(compilePath, "../") {
			compilePath = dp.Name
		}
		if dp == pkg {
			compilePath = "main"
		}
		hash := pkgCacheKey(dp.Dir, dp.Files)
		cachedMxh := cachedMxhPath(cacheBase, dp.Path, hash, dp.Version)
		_, mxhOk := mxutil.ReadFile(cachedMxh)
		if mxhOk && !forceRebuild && dp != pkg {
			loadMxh(cachedMxh)
			src := concatSources(dp.Dir, dp.Files)
			emit.ScanGenericDecls(src, compilePath)
			src = nil
		} else {
			var src []byte
			if dp == pkg {
				src = concatTestSources(dp.Dir, dp.Files, testMainFile)
			} else {
				src = concatSources(dp.Dir, dp.Files)
			}
			emit.TypeCheckOnly(src, compilePath)
			src = nil
		}
	}

	var allBcFiles []string

	for _, dp := range pkgs {
		compilePath := dp.Path
		if compilePath == "." || compilePath == ".." || mxutil.HasPrefix(compilePath, "/") || mxutil.HasPrefix(compilePath, "./") || mxutil.HasPrefix(compilePath, "../") {
			compilePath = dp.Name
		}
		if dp == pkg {
			compilePath = "main"
		}

		hash := pkgCacheKey(dp.Dir, dp.Files)
		cached := cachedBcPath(cacheBase, dp.Path, hash, dp.Version)
		cachedMxh := cachedMxhPath(cacheBase, dp.Path, hash, dp.Version)

		if dp != pkg {
			_, bcOk := mxutil.ReadFile(cached)
			_, mxhOk := mxutil.ReadFile(cachedMxh)
			if bcOk && mxhOk && !forceRebuild {
				mxutil.WriteStr(2, "  cached " | dp.Path | "\n")
				loadMxh(cachedMxh)
				allBcFiles = append(allBcFiles, cached)
				for _, cf := range dp.CFiles {
					cPath := mxutil.JoinPath(dp.Dir, cf)
					cbcFile := mxutil.JoinPath(tmpdir, mxutil.SafeName(dp.Path) | "_" | cf | ".o")
					rc := run([]string{clang, "--target=" | triple, "-c", cPath, "-o", cbcFile})
					if rc == 0 {
						allBcFiles = append(allBcFiles, cbcFile)
					}
				}
				for _, bf := range dp.BCFiles {
					allBcFiles = append(allBcFiles, mxutil.JoinPath(dp.Dir, bf))
				}
				continue
			}

			if mod.IsStdlib(dp.Path) && bcOk && !forceRebuild {
				mxutil.WriteStr(2, "  cached " | dp.Path | "\n")
				src := concatSources(dp.Dir, dp.Files)
				emit.TypeCheckOnly(src, compilePath)
				src = nil
				regPkg := emit.ImportRegistry[compilePath]
				if regPkg != nil {
					cacheDir := mxutil.JoinPath(cacheBase, mxutil.SafeName(dp.Path))
					mxutil.MkdirAll(cacheDir, 0755)
					mxhData := generateMxh(regPkg)
					mxutil.WriteFile(cachedMxh, []byte(mxhData), 0644)
				}
				allBcFiles = append(allBcFiles, cached)
				continue
			}
		}

		mxutil.WriteStr(2, "  compile " | dp.Path | "\n")
		var src []byte
		if dp == pkg {
			src = concatTestSources(dp.Dir, dp.Files, testMainFile)
		} else {
			src = concatSources(dp.Dir, dp.Files)
		}
		ir := compileSource(src, compilePath, triple)
		src = nil
		llFile := mxutil.JoinPath(tmpdir, mxutil.SafeName(dp.Path) | ".ll")
		mxutil.WriteFile(llFile, []byte(ir), 0644)
		ir = ""
		bcFile := mxutil.JoinPath(tmpdir, mxutil.SafeName(dp.Path) | ".o")
		rc := run([]string{clang, "--target=" | triple, "-c", llFile, "-o", bcFile})
		if rc != 0 {
			fatal("clang failed for " | dp.Path)
		}
		if dp != pkg {
			cacheDir := mxutil.JoinPath(cacheBase, mxutil.SafeName(dp.Path))
			mxutil.MkdirAll(cacheDir, 0755)
			data, rok := mxutil.ReadFile(bcFile)
			if rok {
				mxutil.WriteFile(cached, data, 0644)
			}
			data = nil
			regPkg := emit.ImportRegistry[compilePath]
			if regPkg != nil {
				mxhData := generateMxh(regPkg)
				mxutil.WriteFile(cachedMxh, []byte(mxhData), 0644)
			}
		}
		allBcFiles = append(allBcFiles, bcFile)
		for _, cf := range dp.CFiles {
			cPath := mxutil.JoinPath(dp.Dir, cf)
			cbcFile := mxutil.JoinPath(tmpdir, mxutil.SafeName(dp.Path) | "_" | cf | ".o")
			rc = run([]string{clang, "--target=" | triple, "-c", cPath, "-o", cbcFile})
			if rc != 0 {
				fatal("clang failed for " | cf)
			}
			allBcFiles = append(allBcFiles, cbcFile)
		}
		for _, bf := range dp.BCFiles {
			allBcFiles = append(allBcFiles, mxutil.JoinPath(dp.Dir, bf))
		}
	}

	loadSysroot(mxutil.JoinPath(root, "_sysroot.env"))

	sysroot := mxutil.JoinPath(root, "sysroot")
	runtimeBc := mxutil.Getenv("RUNTIME_BC")
	if runtimeBc == "" {
		runtimeBc = mxutil.JoinPath(sysroot, "runtime.bc")
	}
	muslDir := mxutil.Getenv("MUSL_DIR")
	if muslDir == "" {
		muslDir = mxutil.JoinPath(sysroot, "musl")
	}
	comprtLib := mxutil.Getenv("COMPRT_LIB")
	if comprtLib == "" {
		comprtLib = mxutil.JoinPath(mxutil.JoinPath(sysroot, "compiler-rt"), "lib.a")
	}
	muslLib := mxutil.Getenv("MUSL_LIB")
	if muslLib == "" {
		muslLib = mxutil.JoinPath(mxutil.JoinPath(sysroot, "musl"), "lib.a")
	}

	mxutil.WriteStr(2, "  generate initAll\n")
	var initCalls string
	for _, dp := range pkgs {
		compilePath := dp.Path
		if compilePath == "." || compilePath == ".." || mxutil.HasPrefix(compilePath, "/") || mxutil.HasPrefix(compilePath, "./") || mxutil.HasPrefix(compilePath, "../") {
			compilePath = dp.Name
		}
		if dp == pkg {
			continue
		}
		initSym := emit.IrGlobalSymbol(compilePath, "main")
		initCalls = initCalls | "  call void " | initSym | "(ptr %context)\n"
	}
	initAllIR := "\ndefine dso_local void @runtime.initAll(ptr %context) {\nentry:\n" | initCalls | "  ret void\n}\n"
	declared := map[string]bool{}
	for _, dp := range pkgs {
		compilePath := dp.Path
		if compilePath == "." || compilePath == ".." || mxutil.HasPrefix(compilePath, "/") || mxutil.HasPrefix(compilePath, "./") || mxutil.HasPrefix(compilePath, "../") {
			compilePath = dp.Name
		}
		if dp == pkg {
			continue
		}
		declSym := emit.IrGlobalSymbol(compilePath, "main")
		if declared[declSym] {
			continue
		}
		declared[declSym] = true
		initAllIR = initAllIR | "declare void " | declSym | "(ptr)\n"
	}
	initAllFile := mxutil.JoinPath(tmpdir, "initall.ll")
	mxutil.WriteFile(initAllFile, []byte(initAllIR), 0644)
	initAllObj := mxutil.JoinPath(tmpdir, "initall.o")
	rc := run([]string{clang, "--target=" | triple, "-c", initAllFile, "-o", initAllObj})
	if rc != 0 {
		fatal("clang failed for initall")
	}

	mxutil.WriteStr(2, "  compile sysroot\n")
	runtimeObj := mxutil.JoinPath(tmpdir, "runtime.o")
	compileBc(clang, triple, runtimeBc, runtimeObj)
	stdlibBc := mxutil.JoinPath(sysroot, "stdlib.bc")
	stdlibObj := mxutil.JoinPath(tmpdir, "stdlib.o")
	if _, slok := mxutil.ReadFile(stdlibBc); slok {
		compileBc(clang, triple, stdlibBc, stdlibObj)
	}
	shimsBc := mxutil.JoinPath(sysroot, "hashmap_shims.bc")
	shimsObj := mxutil.JoinPath(tmpdir, "hashmap_shims.o")
	if _, shok := mxutil.ReadFile(shimsBc); shok {
		compileBc(clang, triple, shimsBc, shimsObj)
	}
	stringerBc := mxutil.JoinPath(sysroot, "stringer.bc")
	stringerObj := mxutil.JoinPath(tmpdir, "stringer.o")
	if _, sok := mxutil.ReadFile(stringerBc); sok {
		compileBc(clang, triple, stringerBc, stringerObj)
	}
	runtimeGoBc := mxutil.JoinPath(sysroot, "runtime_go.bc")
	runtimeGoObj := mxutil.JoinPath(tmpdir, "runtime_go.o")
	if _, gok := mxutil.ReadFile(runtimeGoBc); gok {
		compileBc(clang, triple, runtimeGoBc, runtimeGoObj)
	}
	stubsBc := mxutil.JoinPath(sysroot, "stubs_moxie.bc")
	stubsObj := mxutil.JoinPath(tmpdir, "stubs_moxie.o")
	if _, sok2 := mxutil.ReadFile(stubsBc); sok2 {
		compileBc(clang, triple, stubsBc, stubsObj)
	}
	deallocBc := mxutil.JoinPath(sysroot, "dealloc_freelist.bc")
	deallocObj := mxutil.JoinPath(tmpdir, "dealloc_freelist.o")
	if _, dok := mxutil.ReadFile(deallocBc); dok {
		compileBc(clang, triple, deallocBc, deallocObj)
	}
	diagObj := mxutil.JoinPath(tmpdir, "alloc_diag.o")
	if mxutil.Getenv("ALLOC_DIAG") != "" {
		diagBc := mxutil.JoinPath(sysroot, "alloc_diag.bc")
		if _, diagOk := mxutil.ReadFile(diagBc); diagOk {
			compileBc(clang, triple, diagBc, diagObj)
		}
	}
	lnShims := mxutil.JoinPath(sysroot, "linkname_shims.bc")
	lnShimsObj := mxutil.JoinPath(tmpdir, "linkname_shims.o")
	if _, lok := mxutil.ReadFile(lnShims); lok {
		compileBc(clang, triple, lnShims, lnShimsObj)
	}

	outpath := mxutil.JoinPath(tmpdir, "test.bin")
	mxutil.WriteStr(2, "  link\n")
	objDir := mxutil.JoinPath(sysroot, "obj")
	objFiles := mxutil.Getenv("OBJ_FILES")
	if objFiles == "" {
		objBcEntries := mxutil.ListFiles(objDir, ".bc")
		if objBcEntries != nil {
			for _, e := range objBcEntries {
				objFiles = objFiles | mxutil.JoinPath(objDir, e) | " "
			}
		}
	}
	linker := "ld.lld-21"
	ldArgs := []string{linker, "--gc-sections", "--allow-multiple-definition", "-o", outpath,
		mxutil.JoinPath(muslDir, "crt1.o")}
	ldArgs = append(ldArgs, initAllObj)
	for _, bf := range allBcFiles {
		ldArgs = append(ldArgs, bf)
	}
	if _, gok2 := mxutil.ReadFile(runtimeGoBc); gok2 {
		ldArgs = append(ldArgs, runtimeGoObj)
	}
	if _, sok3 := mxutil.ReadFile(stubsBc); sok3 {
		ldArgs = append(ldArgs, stubsObj)
	}
	if _, dok2 := mxutil.ReadFile(deallocBc); dok2 {
		ldArgs = append(ldArgs, deallocObj)
	}
	if mxutil.Getenv("ALLOC_DIAG") != "" {
		if _, diagOk2 := mxutil.ReadFile(mxutil.JoinPath(sysroot, "alloc_diag.bc")); diagOk2 {
			ldArgs = append(ldArgs, diagObj)
		}
	}
	ldArgs = append(ldArgs, runtimeObj)
	if _, slok2 := mxutil.ReadFile(stdlibBc); slok2 {
		ldArgs = append(ldArgs, stdlibObj)
	}
	if _, shok2 := mxutil.ReadFile(shimsBc); shok2 {
		ldArgs = append(ldArgs, shimsObj)
	}
	if _, sok4 := mxutil.ReadFile(stringerBc); sok4 {
		ldArgs = append(ldArgs, stringerObj)
	}
	if _, lok2 := mxutil.ReadFile(lnShims); lok2 {
		ldArgs = append(ldArgs, lnShimsObj)
	}
	for _, f := range mxutil.SplitBySpace(objFiles) {
		if f != "" {
			ldArgs = append(ldArgs, f)
		}
	}
	oEntries := mxutil.ListFiles(objDir, ".o")
	if oEntries != nil {
		for _, e := range oEntries {
			ldArgs = append(ldArgs, mxutil.JoinPath(objDir, e))
		}
	}
	ldArgs = append(ldArgs, comprtLib, muslLib, "-z", "stack-size=67108864")
	rc = run(ldArgs)
	if rc != 0 {
		fatal("linker failed")
	}

	mxutil.WriteStr(2, "  run tests\n")
	rc = run([]string{outpath})
	os.Exit(int32(rc))
}

func compileBc(clang, target, inpath, outpath string) {
	rc := run([]string{clang, "--target=" | target, "-c", inpath, "-o", outpath})
	if rc != 0 {
		fatal("clang failed for " | inpath)
	}
}

func hasImportStr(imports []string, pkg string) (ok bool) {
	for _, imp := range imports {
		if imp == pkg {
			return true
		}
	}
	return false
}

func resolveTestDeps(testPkg *mod.PkgInfo, root string) (ss []*mod.PkgInfo) {
	r := &mod.Resolver{
		Visited:  map[string]bool{},
		Root:     root,
		ModPrefix: globalModPrefix,
		ModDir:    globalModDir,
		MoxiePath: getMoxiePath(),
		Replaces:  globalReplaces,
		BuiltinOnly: builtinOnly,
		MustExist: false,
	}
	for _, imp := range testPkg.Imports {
		r.Walk(imp)
	}
	r.Order = append(r.Order, testPkg)
	return r.Order
}

func concatTestSources(dir string, files []string, testMainFile string) (buf []byte) {
	imports := map[string]bool{}
	var bodies [][]byte
	var bodyFiles []string
	var bodyStartLines []int32
	pkgName := "main"

	allFiles := []string{:0:len(files) + 1}
	for _, f := range files {
		if f == testMainFile {
			continue
		}
		allFiles = append(allFiles, f)
	}

	for _, f := range allFiles {
		var data []byte
		var ok bool
		if mxutil.HasPrefix(f, "/") {
			data, ok = mxutil.ReadFile(f)
		} else {
			data, ok = mxutil.ReadFile(mxutil.JoinPath(dir, f))
		}
		if !ok {
			continue
		}
		lines := mxutil.SplitLines(string(data))
		var body []string
		i := int32(0)
		firstBodyLine := int32(0)
		for i < int32(len(lines)) {
			line := mxutil.TrimSpace(lines[i])
			if mxutil.HasPrefix(line, "package ") {
				i++
				continue
			}
			if line == "import (" {
				i++
				for i < int32(len(lines)) {
					imp := mxutil.TrimSpace(lines[i])
					i++
					if imp == ")" {
						break
					}
					if imp != "" {
						imports[imp] = true
					}
				}
				continue
			}
			if mxutil.HasPrefix(line, "import ") && !mxutil.HasPrefix(line, "import (") {
				imp := line[7:]
				imports[imp] = true
				i++
				continue
			}
			if len(body) == 0 {
				firstBodyLine = i + 1
			}
			body = append(body, lines[i])
			i++
		}
		bodies = append(bodies, []byte(mxutil.JoinStrings(body, "\n")))
		bodyFiles = append(bodyFiles, f)
		bodyStartLines = append(bodyStartLines, firstBodyLine)
	}

	tmData, tmOk := mxutil.ReadFile(testMainFile)
	if tmOk {
		lines := mxutil.SplitLines(string(tmData))
		var body []string
		i := int32(0)
		firstBodyLine := int32(0)
		for i < int32(len(lines)) {
			line := mxutil.TrimSpace(lines[i])
			if mxutil.HasPrefix(line, "package ") {
				i++
				continue
			}
			if line == "import (" {
				i++
				for i < int32(len(lines)) {
					imp := mxutil.TrimSpace(lines[i])
					i++
					if imp == ")" {
						break
					}
					if imp != "" {
						imports[imp] = true
					}
				}
				continue
			}
			if mxutil.HasPrefix(line, "import ") && !mxutil.HasPrefix(line, "import (") {
				imp := line[7:]
				imports[imp] = true
				i++
				continue
			}
			if len(body) == 0 {
				firstBodyLine = i + 1
			}
			body = append(body, lines[i])
			i++
		}
		bodies = append(bodies, []byte(mxutil.JoinStrings(body, "\n")))
		bodyFiles = append(bodyFiles, "_testmain.mx")
		bodyStartLines = append(bodyStartLines, firstBodyLine)
	}

	var out []byte
	out = append(out, ("package " | pkgName | "\n")...)
	if len(imports) > 0 {
		var impKeys []string
		for imp := range imports {
			impKeys = append(impKeys, imp)
		}
		for i := int32(1); i < int32(len(impKeys)); i++ {
			for j := i; j > 0 && impKeys[j] < impKeys[j-1]; j-- {
				impKeys[j], impKeys[j-1] = impKeys[j-1], impKeys[j]
			}
		}
		out = append(out, "import (\n"...)
		for _, imp := range impKeys {
			out = append(out, '\t')
			out = append(out, imp...)
			out = append(out, '\n')
		}
		out = append(out, ")\n"...)
	}
	concatSourceMap = nil
	outLine := int32(1)
	for j := int32(0); j < int32(len(out)); j++ {
		if out[j] == '\n' {
			outLine++
		}
	}
	for i, b := range bodies {
		concatSourceMap = append(concatSourceMap, srcSpan{
			file:     bodyFiles[i],
			outStart: outLine,
			srcLine:  bodyStartLines[i],
		})
		for j := int32(0); j < int32(len(b)); j++ {
			if b[j] == '\n' {
				outLine++
			}
		}
		outLine++
		out = append(out, b...)
		out = append(out, '\n')
		bodies[i] = nil
	}
	bodies = nil
	imports = nil
	return out
}

func main() {
	builtinOnly = []string{"unsafe", "runtime", "moxie"}
	args := getArgs()
	if len(args) < 2 {
		mxutil.WriteStr(2, "usage: mxc <build|test|version|cache|fetch|update> ...\n")
		os.Exit(1)
	}

	cmd := args[1]
	if cmd == "version" {
		mxutil.WriteStr(1, "mxc " | mxcVersion() | "\n")
		return
	}
	if cmd == "cache" {
		if len(args) >= 3 && args[2] == "clean" {
			cacheClean()
			return
		}
		if len(args) >= 3 && args[2] == "warm" {
			cmdCacheWarm()
			return
		}
		mxutil.WriteStr(2, "usage: mxc cache <clean|warm>\n")
		os.Exit(1)
	}
	if cmd == "fetch" {
		fetchURL := ""
		if len(args) >= 3 {
			fetchURL = args[2]
		}
		cmdFetch(fetchURL)
		return
	}
	if cmd == "update" {
		rebuildAll := false
		for ai := int32(2); ai < int32(len(args)); ai++ {
			if args[ai] == "--all" {
				rebuildAll = true
			}
		}
		cmdUpdate(rebuildAll)
		return
	}
	if cmd == "test" {
		cmdTest(args)
		return
	}
	if cmd != "build" {
		mxutil.WriteStr(2, "usage: mxc <build|test|version|cache|fetch|update> ...\n")
		os.Exit(1)
	}

	outpath := ""
	pkgPath := ""
	printIR := false
	forceRebuild := false
	i := int32(2)
	for i < int32(len(args)) {
		if args[i] == "-o" && i+1 < int32(len(args)) {
			outpath = args[i+1]
			i += 2
		} else if args[i] == "-print-ir" {
			printIR = true
			i++
		} else if args[i] == "-a" {
			forceRebuild = true
			i++
		} else {
			pkgPath = args[i]
			i++
		}
	}
	if pkgPath == "" {
		fatal("no package specified")
	}
	if outpath == "" {
		outpath = mxutil.PathBase(pkgPath)
	}

	root := mxutil.Getenv("MOXIEROOT")
	if root == "" {
		root = "."
	}
	triple := "x86_64-unknown-linux-musleabihf"
	clang := "clang-21"

	if mxutil.HasPrefix(pkgPath, "./") || mxutil.HasPrefix(pkgPath, "../") || pkgPath == "." || mxutil.HasPrefix(pkgPath, "/") {
		absDir := pkgPath
		if absDir == "." {
			absDir = ""
		}
		globalModPrefix, globalModDir, globalReplaces = mod.FindModuleRoot(absDir)
	}

	registerBuiltins()
	moxiePath := getMoxiePath()
	pkgs := mod.ResolveAll(pkgPath, root, globalModPrefix, globalModDir, moxiePath, globalReplaces, builtinOnly, false)
	if len(pkgs) == 0 {
		fatal("no packages to compile")
	}

	tmpdir := "./tmp/mxc-build"
	mxutil.MkdirAll(tmpdir, 0755)

	cacheBase := pkgCacheDir()
	var allBcFiles []string

	for pi, pkg := range pkgs {
		compilePath := pkg.Path
		if compilePath == "." || compilePath == ".." || mxutil.HasPrefix(compilePath, "/") || mxutil.HasPrefix(compilePath, "./") || mxutil.HasPrefix(compilePath, "../") {
			compilePath = pkg.Name
		}
		hash := pkgCacheKey(pkg.Dir, pkg.Files)
		cachedMxh := cachedMxhPath(cacheBase, pkg.Path, hash, pkg.Version)
		_, mxhOk := mxutil.ReadFile(cachedMxh)
		if mxhOk && !forceRebuild {
			loadMxh(cachedMxh)
			src := concatSources(pkg.Dir, pkg.Files)
			emit.ScanGenericDecls(src, compilePath)
			src = nil
		} else {
			src := concatSources(pkg.Dir, pkg.Files)
			emit.TypeCheckOnly(src, compilePath)
			src = nil
		}
	}

	for _, pkg := range pkgs {
		compilePath := pkg.Path
		if compilePath == "." || compilePath == ".." || mxutil.HasPrefix(compilePath, "/") || mxutil.HasPrefix(compilePath, "./") || mxutil.HasPrefix(compilePath, "../") {
			compilePath = pkg.Name
		}

		hash := pkgCacheKey(pkg.Dir, pkg.Files)
		cached := cachedBcPath(cacheBase, pkg.Path, hash, pkg.Version)
		cachedMxh := cachedMxhPath(cacheBase, pkg.Path, hash, pkg.Version)

		_, bcOk := mxutil.ReadFile(cached)
		_, mxhOk := mxutil.ReadFile(cachedMxh)
		if bcOk && mxhOk && !forceRebuild {
			mxutil.WriteStr(2, "  cached " | pkg.Path)
			if pkg.Version != "" {
				mxutil.WriteStr(2, " @ " | pkg.Version)
			}
			mxutil.WriteStr(2, "\n")
			loadMxh(cachedMxh)
			allBcFiles = append(allBcFiles, cached)
			for _, cf := range pkg.CFiles {
				cPath := mxutil.JoinPath(pkg.Dir, cf)
				cbcFile := mxutil.JoinPath(tmpdir, mxutil.SafeName(pkg.Path) | "_" | cf | ".o")
				rc := run([]string{clang, "--target=" | triple, "-c", cPath, "-o", cbcFile})
				if rc == 0 {
					allBcFiles = append(allBcFiles, cbcFile)
				}
			}
			for _, bf := range pkg.BCFiles {
				allBcFiles = append(allBcFiles, mxutil.JoinPath(pkg.Dir, bf))
			}
			continue
		}

		if mod.IsStdlib(pkg.Path) && bcOk && !forceRebuild {
			mxutil.WriteStr(2, "  cached " | pkg.Path | "\n")
			src := concatSources(pkg.Dir, pkg.Files)
			emit.TypeCheckOnly(src, compilePath)
			src = nil
			regPkg := emit.ImportRegistry[compilePath]
			if regPkg != nil {
				cacheDir := mxutil.JoinPath(cacheBase, mxutil.SafeName(pkg.Path))
				mxutil.MkdirAll(cacheDir, 0755)
				mxhData := generateMxh(regPkg)
				mxutil.WriteFile(cachedMxh, []byte(mxhData), 0644)
			}
			allBcFiles = append(allBcFiles, cached)
			continue
		}

		mxutil.WriteStr(2, "  compile " | pkg.Path | "\n")
		src := concatSources(pkg.Dir, pkg.Files)
		ir := compileSource(src, compilePath, triple)
		src = nil
		if printIR {
			mxutil.WriteStr(1, ir)
		}
		llFile := mxutil.JoinPath(tmpdir, mxutil.SafeName(pkg.Path) | ".ll")
		mxutil.WriteFile(llFile, []byte(ir), 0644)
		ir = ""
		bcFile := mxutil.JoinPath(tmpdir, mxutil.SafeName(pkg.Path) | ".o")
		rc := run([]string{clang, "--target=" | triple, "-c", llFile, "-o", bcFile})
		if rc != 0 {
			fatal("clang failed for " | pkg.Path)
		}
		cacheDir := mxutil.JoinPath(cacheBase, mxutil.SafeName(pkg.Path))
		mxutil.MkdirAll(cacheDir, 0755)
		data, rok := mxutil.ReadFile(bcFile)
		if rok {
			mxutil.WriteFile(cached, data, 0644)
		}
		data = nil
		regPkg := emit.ImportRegistry[compilePath]
		if regPkg != nil {
			mxhData := generateMxh(regPkg)
			mxutil.WriteFile(cachedMxh, []byte(mxhData), 0644)
		}
		allBcFiles = append(allBcFiles, bcFile)
		for _, cf := range pkg.CFiles {
			cPath := mxutil.JoinPath(pkg.Dir, cf)
			cbcFile := mxutil.JoinPath(tmpdir, mxutil.SafeName(pkg.Path) | "_" | cf | ".o")
			rc = run([]string{clang, "--target=" | triple, "-c", cPath, "-o", cbcFile})
			if rc != 0 {
				fatal("clang failed for " | cf)
			}
			allBcFiles = append(allBcFiles, cbcFile)
		}
		for _, bf := range pkg.BCFiles {
			allBcFiles = append(allBcFiles, mxutil.JoinPath(pkg.Dir, bf))
		}
	}

	loadSysroot(mxutil.JoinPath(root, "_sysroot.env"))

	sysroot := mxutil.JoinPath(root, "sysroot")
	runtimeBc := mxutil.Getenv("RUNTIME_BC")
	if runtimeBc == "" {
		runtimeBc = mxutil.JoinPath(sysroot, "runtime.bc")
	}
	muslDir := mxutil.Getenv("MUSL_DIR")
	if muslDir == "" {
		muslDir = mxutil.JoinPath(sysroot, "musl")
	}
	comprtLib := mxutil.Getenv("COMPRT_LIB")
	if comprtLib == "" {
		comprtLib = mxutil.JoinPath(mxutil.JoinPath(sysroot, "compiler-rt"), "lib.a")
	}
	muslLib := mxutil.Getenv("MUSL_LIB")
	if muslLib == "" {
		muslLib = mxutil.JoinPath(mxutil.JoinPath(sysroot, "musl"), "lib.a")
	}

	mxutil.WriteStr(2, "  generate initAll\n")
	var initCalls string
	for _, pkg := range pkgs {
		compilePath := pkg.Path
		if compilePath == "." || compilePath == ".." || mxutil.HasPrefix(compilePath, "/") || mxutil.HasPrefix(compilePath, "./") || mxutil.HasPrefix(compilePath, "../") {
			compilePath = pkg.Name
		}
		if compilePath == "main" {
			continue
		}
		initSym := emit.IrGlobalSymbol(compilePath, "main")
		initCalls = initCalls | "  call void " | initSym | "(ptr %context)\n"
	}
	initAllIR := "\ndefine dso_local void @runtime.initAll(ptr %context) {\nentry:\n" | initCalls | "  ret void\n}\n"
	declared := map[string]bool{}
	for _, pkg := range pkgs {
		compilePath := pkg.Path
		if compilePath == "." || compilePath == ".." || mxutil.HasPrefix(compilePath, "/") || mxutil.HasPrefix(compilePath, "./") || mxutil.HasPrefix(compilePath, "../") {
			compilePath = pkg.Name
		}
		if compilePath == "main" {
			continue
		}
		declSym := emit.IrGlobalSymbol(compilePath, "main")
		if declared[declSym] {
			continue
		}
		declared[declSym] = true
		initAllIR = initAllIR | "declare void " | declSym | "(ptr)\n"
	}
	initAllFile := mxutil.JoinPath(tmpdir, "initall.ll")
	mxutil.WriteFile(initAllFile, []byte(initAllIR), 0644)
	initAllObj := mxutil.JoinPath(tmpdir, "initall.o")
	rc := run([]string{clang, "--target=" | triple, "-c", initAllFile, "-o", initAllObj})
	if rc != 0 {
		fatal("clang failed for initall")
	}

	mxutil.WriteStr(2, "  compile sysroot\n")
	runtimeObj := mxutil.JoinPath(tmpdir, "runtime.o")
	compileBc(clang, triple, runtimeBc, runtimeObj)
	stdlibBc := mxutil.JoinPath(sysroot, "stdlib.bc")
	stdlibObj := mxutil.JoinPath(tmpdir, "stdlib.o")
	if _, slok := mxutil.ReadFile(stdlibBc); slok {
		compileBc(clang, triple, stdlibBc, stdlibObj)
	}
	shimsBc := mxutil.JoinPath(sysroot, "hashmap_shims.bc")
	shimsObj := mxutil.JoinPath(tmpdir, "hashmap_shims.o")
	if _, shok := mxutil.ReadFile(shimsBc); shok {
		compileBc(clang, triple, shimsBc, shimsObj)
	}
	stringerBc := mxutil.JoinPath(sysroot, "stringer.bc")
	stringerObj := mxutil.JoinPath(tmpdir, "stringer.o")
	if _, sok := mxutil.ReadFile(stringerBc); sok {
		compileBc(clang, triple, stringerBc, stringerObj)
	}
	runtimeGoBc := mxutil.JoinPath(sysroot, "runtime_go.bc")
	runtimeGoObj := mxutil.JoinPath(tmpdir, "runtime_go.o")
	if _, gok := mxutil.ReadFile(runtimeGoBc); gok {
		compileBc(clang, triple, runtimeGoBc, runtimeGoObj)
	}
	stubsBc := mxutil.JoinPath(sysroot, "stubs_moxie.bc")
	stubsObj := mxutil.JoinPath(tmpdir, "stubs_moxie.o")
	if _, sok2 := mxutil.ReadFile(stubsBc); sok2 {
		compileBc(clang, triple, stubsBc, stubsObj)
	}
	deallocBc := mxutil.JoinPath(sysroot, "dealloc_freelist.bc")
	deallocObj := mxutil.JoinPath(tmpdir, "dealloc_freelist.o")
	if _, dok := mxutil.ReadFile(deallocBc); dok {
		compileBc(clang, triple, deallocBc, deallocObj)
	}
	diagObj := mxutil.JoinPath(tmpdir, "alloc_diag.o")
	if mxutil.Getenv("ALLOC_DIAG") != "" {
		diagBc := mxutil.JoinPath(sysroot, "alloc_diag.bc")
		if _, diagOk := mxutil.ReadFile(diagBc); diagOk {
			compileBc(clang, triple, diagBc, diagObj)
		}
	}
	lnShims := mxutil.JoinPath(sysroot, "linkname_shims.bc")
	lnShimsObj := mxutil.JoinPath(tmpdir, "linkname_shims.o")
	if _, lok := mxutil.ReadFile(lnShims); lok {
		compileBc(clang, triple, lnShims, lnShimsObj)
	}

	mxutil.WriteStr(2, "  link\n")
	objDir := mxutil.JoinPath(sysroot, "obj")
	objFiles := mxutil.Getenv("OBJ_FILES")
	if objFiles == "" {
		objBcEntries := mxutil.ListFiles(objDir, ".bc")
		if objBcEntries != nil {
			for _, e := range objBcEntries {
				objFiles = objFiles | mxutil.JoinPath(objDir, e) | " "
			}
		}
	}
	linker := "ld.lld-21"
	ldArgs := []string{linker, "--gc-sections", "--allow-multiple-definition", "-o", outpath,
		mxutil.JoinPath(muslDir, "crt1.o")}
	ldArgs = append(ldArgs, initAllObj)
	for _, bf := range allBcFiles {
		ldArgs = append(ldArgs, bf)
	}
	if _, gok2 := mxutil.ReadFile(runtimeGoBc); gok2 {
		ldArgs = append(ldArgs, runtimeGoObj)
	}
	if _, sok3 := mxutil.ReadFile(stubsBc); sok3 {
		ldArgs = append(ldArgs, stubsObj)
	}
	if _, dok2 := mxutil.ReadFile(deallocBc); dok2 {
		ldArgs = append(ldArgs, deallocObj)
	}
	if mxutil.Getenv("ALLOC_DIAG") != "" {
		if _, diagOk2 := mxutil.ReadFile(mxutil.JoinPath(sysroot, "alloc_diag.bc")); diagOk2 {
			ldArgs = append(ldArgs, diagObj)
		}
	}
	ldArgs = append(ldArgs, runtimeObj)
	if _, slok2 := mxutil.ReadFile(stdlibBc); slok2 {
		ldArgs = append(ldArgs, stdlibObj)
	}
	if _, shok2 := mxutil.ReadFile(shimsBc); shok2 {
		ldArgs = append(ldArgs, shimsObj)
	}
	if _, sok4 := mxutil.ReadFile(stringerBc); sok4 {
		ldArgs = append(ldArgs, stringerObj)
	}
	if _, lok2 := mxutil.ReadFile(lnShims); lok2 {
		ldArgs = append(ldArgs, lnShimsObj)
	}
	for _, f := range mxutil.SplitBySpace(objFiles) {
		if f != "" {
			ldArgs = append(ldArgs, f)
		}
	}
	oEntries := mxutil.ListFiles(objDir, ".o")
	if oEntries != nil {
		for _, e := range oEntries {
			ldArgs = append(ldArgs, mxutil.JoinPath(objDir, e))
		}
	}
	ldArgs = append(ldArgs, comprtLib, muslLib, "-z", "stack-size=67108864")
	rc = run(ldArgs)
	if rc != 0 {
		fatal("linker failed")
	}
	mxutil.WriteStr(2, "  -> " | outpath | "\n")
}
