// Package suffixarray implements substring search in logarithmic time using
// an in-memory suffix array.
//
// Example use:
//
//	// create index for some data
//	index := suffixarray.New(data)
//
//	// lookup byte slice s
//	offsets1 := index.Lookup(s, -1) // the list of all indices where s occurs in data
//	offsets2 := index.Lookup(s, 3)  // the list of at most 3 indices where s occurs in data
package suffixarray

import (
	"bytes"
	"encoding/binary"
	"errors"
	"io"
	"math"
)

const maxData32 = math.MaxInt32

// Index implements a suffix array for fast substring search.
type Index struct {
	data []byte
	sa   ints // suffix array for data; sa.len() == len(data)
}

// An ints is either an []int32 or an []int64.
// That is, one of them is empty, and one is the real data.
// The int64 form is used when len(data) > maxData32
type ints struct {
	int32 []int32
	int64 []int64
}

func (a *ints) len() (out int32) {
	return len(a.int32) + len(a.int64)
}

func (a *ints) get(i int32) (out int64) {
	if a.int32 != nil {
		return int64(a.int32[i])
	}
	return a.int64[i]
}

func (a *ints) set(i int32, v int64) {
	if a.int32 != nil {
		a.int32[i] = int32(v)
	} else {
		a.int64[i] = v
	}
}

func (a *ints) slice(i, j int32) (out ints) {
	if a.int32 != nil {
		return ints{a.int32[i:j], nil}
	}
	return ints{nil, a.int64[i:j]}
}

// New creates a new [Index] for data.
// [Index] creation time is O(N) for N = len(data).
func New(data []byte) (out *Index) {
	ix := &Index{data: data}
	if len(data) <= maxData32 {
		ix.sa.int32 = []int32{:len(data)}
		text_32(data, ix.sa.int32)
	} else {
		ix.sa.int64 = []int64{:len(data)}
		text_64(data, ix.sa.int64)
	}
	return ix
}

// writeInt writes an int32 x to w using buf to buffer the write.
func writeInt(w io.Writer, buf []byte, x int32) (werr error) {
	binary.PutVarint(buf, int64(x))
	_, err := w.Write(buf[0:binary.MaxVarintLen64])
	return err
}

// readInt reads an int32 x from r using buf to buffer the read and returns x.
func readInt(r io.Reader, buf []byte) (v int64, rerr error) {
	_, err := io.ReadFullIntoN(r, buf, 0, binary.MaxVarintLen64) // ok to continue with error
	x, _ := binary.Varint(buf)
	return x, err
}

// writeSlice writes data[:n] to w and returns n.
// It uses buf to buffer the write.
func writeSlice(w io.Writer, buf []byte, data ints) (n int32, err error) {
	// encode as many elements as fit into buf
	p := binary.MaxVarintLen64
	m := data.len()
	for ; n < m && p+binary.MaxVarintLen64 <= len(buf); n++ {
		p += binary.PutUvarint(buf[p:], uint64(data.get(n)))
	}

	// update buffer size
	binary.PutVarint(buf, int64(p))

	// write buffer
	_, err = w.Write(buf[0:p])
	return
}

var errTooBig error

// readSlice reads data[:n] from r and returns n.
// It uses buf to buffer the read.
func readSlice(r io.Reader, buf []byte, data ints) (n int32, err error) {
	// read buffer size
	var size64 int64
	size64, err = readInt(r, buf)
	if err != nil {
		return
	}
	if int64(int32(size64)) != size64 || int32(size64) < 0 {
		// We never write chunks this big anyway.
		return 0, errTooBig
	}
	size := int32(size64)

	// read buffer w/o the size
	if _, err = io.ReadFullIntoN(r, buf, binary.MaxVarintLen64, size-binary.MaxVarintLen64); err != nil {
		return
	}

	// decode as many elements as present in buf
	for p := binary.MaxVarintLen64; p < size; n++ {
		x, w := binary.Uvarint(buf[p:])
		data.set(n, int64(x))
		p += w
	}

	return
}

const bufSize = 16 << 10 // reasonable for BenchmarkSaveRestore

// Read reads the index from r into x; x must not be nil.
func (x *Index) Read(r io.Reader) (rerr error) {
	// buffer for all reads
	buf := []byte{:bufSize}

	// read length
	n64, err := readInt(r, buf)
	if err != nil {
		return err
	}
	if int64(int32(n64)) != n64 || int32(n64) < 0 {
		return errTooBig
	}
	n := int32(n64)

	// allocate space
	if 2*n < cap(x.data) || cap(x.data) < n || x.sa.int32 != nil && n > maxData32 || x.sa.int64 != nil && n <= maxData32 {
		// new data is significantly smaller or larger than
		// existing buffers - allocate new ones
		x.data = []byte{:n}
		x.sa.int32 = nil
		x.sa.int64 = nil
		if n <= maxData32 {
			x.sa.int32 = []int32{:n}
		} else {
			x.sa.int64 = []int64{:n}
		}
	} else {
		// re-use existing buffers
		x.data = x.data[0:n]
		x.sa = x.sa.slice(0, n)
	}

	// read data
	if _, rerr = io.ReadFull(r, x.data); rerr != nil {
		return rerr
	}

	// read index
	sa := x.sa
	for sa.len() > 0 {
		// `n` and `err` are the function-scope bindings above; a
		// declaration here would be rejected in a self-mutating method.
		n, err = readSlice(r, buf, sa)
		if err != nil {
			return err
		}
		sa = sa.slice(n, sa.len())
	}
	return nil
}

// Write writes the index x to w.
func (x *Index) Write(w io.Writer) (werr error) {
	// buffer for all writes
	buf := []byte{:bufSize}

	// write length
	if err := writeInt(w, buf, len(x.data)); err != nil {
		return err
	}

	// write data
	if _, err := w.Write(x.data); err != nil {
		return err
	}

	// write index
	sa := x.sa
	for sa.len() > 0 {
		n, err := writeSlice(w, buf, sa)
		if err != nil {
			return err
		}
		sa = sa.slice(n, sa.len())
	}
	return nil
}

// Bytes returns the data over which the index was created.
// It must not be modified.
func (x *Index) Bytes() (out []byte) {
	return x.data
}

func (x *Index) at(i int32) (out []byte) {
	return x.data[x.sa.get(i):]
}

// lookupAll returns a slice into the matching region of the index.
// The runtime is O(log(N)*len(s)).
func (x *Index) lookupAll(s []byte) (out ints) {
	// find matching suffix index range [i:j]. A Moxie closure captures
	// nothing, so the two binary searches are written out rather than passed
	// to sort.Search as predicates over x and s.
	// Find the first index where s would be the prefix.
	lo, hi := int32(0), x.sa.len()
	for lo < hi {
		mid := (lo + hi) / 2
		if bytes.Compare(x.at(mid), s) >= 0 {
			hi = mid
		} else {
			lo = mid + 1
		}
	}
	i := lo
	// Starting at i, find the first index at which s is not a prefix.
	lo, hi = 0, x.sa.len()-i
	for lo < hi {
		mid := (lo + hi) / 2
		if !bytes.HasPrefix(x.at(mid+i), s) {
			hi = mid
		} else {
			lo = mid + 1
		}
	}
	j := i + lo
	return x.sa.slice(i, j)
}

// Lookup returns an unsorted list of at most n indices where the byte string s
// occurs in the indexed data. If n < 0, all occurrences are returned.
// The result is nil if s is empty, s is not found, or n == 0.
// Lookup time is O(log(N)*len(s) + len(result)) where N is the
// size of the indexed data.
func (x *Index) Lookup(s []byte, n int32) (result []int32) {
	if len(s) > 0 && n != 0 {
		matches := x.lookupAll(s)
		count := matches.len()
		if n < 0 || count < n {
			n = count
		}
		// 0 <= n <= count
		if n > 0 {
			result = []int32{:n}
			if matches.int32 != nil {
				for i := range result {
					result[i] = int32(matches.int32[i])
				}
			} else {
				for i := range result {
					result[i] = int32(matches.int64[i])
				}
			}
		}
	}
	return
}

// FindAllIndex(re *regexp.Regexp, n int32) is NOT here. This tree has no
// regexp package - it went with reflect/any in 3b6e25e8 and no reflect-free
// replacement exists - and this method was its only use (round 103). Lookup
// is the literal-prefix search that remains; the sorted, non-overlapping
// match pairs FindAllIndex built on top of it are the caller's to produce.

func init() {
	errTooBig = errors.New("suffixarray: data too large")
}
