// Package heap provides heap operations for any type that implements the
// [Interface]. A heap is a tree with the property that each node is the
// minimum-valued node in its subtree. T is monomorphized per element type.
package heap

// Interface describes a min-heap.
type Interface[T comparable] interface {
	Len() int32
	Less(i, j int32) bool
	Swap(i, j int32)
	Push(x T)
	Pop() T
}

// Init establishes the heap invariants.
func Init[T comparable](h Interface[T]) {
	n := h.Len()
	for i := n/2 - 1; i >= 0; i-- {
		down(h, i, n)
	}
}

// Push pushes the element x onto the heap.
func Push[T comparable](h Interface[T], x T) {
	h.Push(x)
	up(h, h.Len()-1)
}

// Pop removes and returns the minimum element from the heap.
func Pop[T comparable](h Interface[T]) (x T) {
	n := h.Len() - 1
	h.Swap(0, n)
	down(h, 0, n)
	return h.Pop()
}

// Remove removes and returns the element at index i from the heap.
func Remove[T comparable](h Interface[T], i int32) (x T) {
	n := h.Len() - 1
	if n != i {
		h.Swap(i, n)
		if !down(h, i, n) {
			up(h, i)
		}
	}
	return h.Pop()
}

func up[T comparable](h Interface[T], j int32) {
	for {
		i := (j - 1) / 2
		if i == j || !h.Less(j, i) {
			break
		}
		h.Swap(i, j)
		j = i
	}
}

func down[T comparable](h Interface[T], i0, n int32) (b bool) {
	i := i0
	for {
		j1 := 2*i + 1
		if j1 >= n || j1 < 0 {
			break
		}
		j := j1
		if j2 := j1 + 1; j2 < n && h.Less(j2, j1) {
			j = j2
		}
		if !h.Less(j, i) {
			break
		}
		h.Swap(i, j)
		i = j
	}
	return i > i0
}
