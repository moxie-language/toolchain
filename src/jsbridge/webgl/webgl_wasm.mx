//:build wasm

package webgl

//:wasmimport bridge webgl_CreateContext
func CreateContext(canvasID int32) Context

//:wasmimport bridge webgl_CreateContextFromHandle
func CreateContextFromHandle(el int32) Context

//:wasmimport bridge webgl_DeleteContext
func DeleteContext(ctx Context)

//:wasmimport bridge webgl_Enable
func Enable(ctx Context, cap int32)

//:wasmimport bridge webgl_Disable
func Disable(ctx Context, cap int32)

//:wasmimport bridge webgl_Viewport
func Viewport(ctx Context, x, y, w, h int32)

//:wasmimport bridge webgl_Scissor
func Scissor(ctx Context, x, y, w, h int32)

//:wasmimport bridge webgl_BlendFunc
func BlendFunc(ctx Context, src, dst int32)

//:wasmimport bridge webgl_BlendFuncSeparate
func BlendFuncSeparate(ctx Context, srcRGB, dstRGB, srcA, dstA int32)

//:wasmimport bridge webgl_BlendEquation
func BlendEquation(ctx Context, mode int32)

//:wasmimport bridge webgl_DepthFunc
func DepthFunc(ctx Context, fn int32)

//:wasmimport bridge webgl_DepthMask
func DepthMask(ctx Context, flag int32)

//:wasmimport bridge webgl_ClearColor
func ClearColor(ctx Context, r, g, b, a float32)

//:wasmimport bridge webgl_ClearDepth
func ClearDepth(ctx Context, d float32)

//:wasmimport bridge webgl_Clear
func Clear(ctx Context, mask int32)

//:wasmimport bridge webgl_Flush
func Flush(ctx Context)

//:wasmimport bridge webgl_Finish
func Finish(ctx Context)

//:wasmimport bridge webgl_GetError
func GetError(ctx Context) int32

//:wasmimport bridge webgl_GetInteger
func GetInteger(ctx Context, pname int32) int32

//:wasmimport bridge webgl_IsEnabled
func IsEnabled(ctx Context, cap int32) int32

//:wasmimport bridge webgl_PixelStorei
func PixelStorei(ctx Context, pname, param int32)

//:wasmimport bridge webgl_ReadPixels
func ReadPixels(ctx Context, x, y, w, h, format, typ int32, bufPtr *byte, bufLen int32)

//:wasmimport bridge webgl_CreateBuffer
func CreateBuffer(ctx Context) Buffer

//:wasmimport bridge webgl_DeleteBuffer
func DeleteBuffer(ctx Context, buf Buffer)

//:wasmimport bridge webgl_BindBuffer
func BindBuffer(ctx Context, target int32, buf Buffer)

//:wasmimport bridge webgl_BufferData
func BufferData(ctx Context, target int32, dataPtr *byte, dataLen int32, usage int32)

//:wasmimport bridge webgl_BufferSubData
func BufferSubData(ctx Context, target int32, offset int32, dataPtr *byte, dataLen int32)

//:wasmimport bridge webgl_CreateTexture
func CreateTexture(ctx Context) Texture

//:wasmimport bridge webgl_DeleteTexture
func DeleteTexture(ctx Context, tex Texture)

//:wasmimport bridge webgl_BindTexture
func BindTexture(ctx Context, target int32, tex Texture)

//:wasmimport bridge webgl_ActiveTexture
func ActiveTexture(ctx Context, unit int32)

//:wasmimport bridge webgl_TexParameteri
func TexParameteri(ctx Context, target, pname, param int32)

//:wasmimport bridge webgl_TexImage2D
func TexImage2D(ctx Context, target, level, internalformat, width, height, border, format, typ int32, dataPtr *byte, dataLen int32)

//:wasmimport bridge webgl_TexStorage2D
func TexStorage2D(ctx Context, target, levels, internalformat, width, height int32)

//:wasmimport bridge webgl_TexSubImage2D
func TexSubImage2D(ctx Context, target, level, xoff, yoff, width, height, format, typ int32, dataPtr *byte, dataLen int32)

//:wasmimport bridge webgl_CopyTexSubImage2D
func CopyTexSubImage2D(ctx Context, target, level, xoff, yoff, x, y, w, h int32)

//:wasmimport bridge webgl_GenerateMipmap
func GenerateMipmap(ctx Context, target int32)

//:wasmimport bridge webgl_CreateFramebuffer
func CreateFramebuffer(ctx Context) Framebuffer

//:wasmimport bridge webgl_DeleteFramebuffer
func DeleteFramebuffer(ctx Context, fbo Framebuffer)

//:wasmimport bridge webgl_BindFramebuffer
func BindFramebuffer(ctx Context, target int32, fbo Framebuffer)

//:wasmimport bridge webgl_FramebufferTexture2D
func FramebufferTexture2D(ctx Context, target, attachment, textarget int32, tex Texture, level int32)

//:wasmimport bridge webgl_CheckFramebufferStatus
func CheckFramebufferStatus(ctx Context, target int32) int32

//:wasmimport bridge webgl_InvalidateFramebuffer
func InvalidateFramebuffer(ctx Context, target, attachment int32)

//:wasmimport bridge webgl_CreateRenderbuffer
func CreateRenderbuffer(ctx Context) Renderbuffer

//:wasmimport bridge webgl_DeleteRenderbuffer
func DeleteRenderbuffer(ctx Context, rbo Renderbuffer)

//:wasmimport bridge webgl_BindRenderbuffer
func BindRenderbuffer(ctx Context, target int32, rbo Renderbuffer)

//:wasmimport bridge webgl_RenderbufferStorage
func RenderbufferStorage(ctx Context, target, internalformat, width, height int32)

//:wasmimport bridge webgl_FramebufferRenderbuffer
func FramebufferRenderbuffer(ctx Context, target, attachment, renderbuffertarget int32, rbo Renderbuffer)

//:wasmimport bridge webgl_CreateShader
func CreateShader(ctx Context, typ int32) Shader

//:wasmimport bridge webgl_DeleteShader
func DeleteShader(ctx Context, shader Shader)

//:wasmimport bridge webgl_ShaderSource
func ShaderSource(ctx Context, shader Shader, srcPtr *byte, srcLen int32)

