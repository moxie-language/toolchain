//go:build wasm

package text

import "unsafe"

//go:wasmimport bridge text_Measure
func wasmMeasure(fontPtr *byte, fontLen int32, size float32,
	textPtr *byte, textLen int32, wPtr *int32, hPtr *int32)

//go:wasmimport bridge text_Render
func wasmRender(fontPtr *byte, fontLen int32, size float32,
	textPtr *byte, textLen int32, maxW int32,
	dataPtr *byte, dataCap int32) int32

func Measure(font string, size float32, txt string, wPtr, hPtr *int32) {
	wasmMeasure(
		unsafe.StringData(font), int32(len(font)),
		size,
		unsafe.StringData(txt), int32(len(txt)),
		wPtr, hPtr,
	)
}

func Render(font string, size float32, txt string, maxW int32, data []byte) int32 {
	if len(data) == 0 {
		return 0
	}
	return wasmRender(
		unsafe.StringData(font), int32(len(font)),
		size,
		unsafe.StringData(txt), int32(len(txt)),
		maxW,
		&data[0], int32(len(data)),
	)
}
