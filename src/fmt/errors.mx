package fmt

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"errors"
)

// Errorf formats according to a format specifier and returns the string as a
// value that satisfies error.
//
// If the format specifier includes a %w verb with an error operand,
// the returned error will implement an Unwrap method returning the operand.
// If there is more than one %w verb, the returned error will implement an
// Unwrap method returning a []error containing all the %w operands in the
// order they appear in the arguments.
// It is invalid to supply the %w verb with an operand that does not implement
// the error interface. The %w verb is otherwise a synonym for %v.
func Errorf(format []byte, a ...Stringer) error {
	p := newPrinter()
	p.wrapErrs = true
	p.doPrintf(format, a)
	s := copyBuf(p.buf)
	var err error
	switch len(p.wrappedErrs) {
	case 0:
		err = errors.New(s)
	case 1:
		w := &wrapError{msg: s}
		w.err = errors.New(a[p.wrappedErrs[0]].String())
		err = w
	default:
		if p.reordered {
			for si := 1; si < len(p.wrappedErrs); si++ {
				for sj := si; sj > 0 && p.wrappedErrs[sj] < p.wrappedErrs[sj-1]; sj-- {
					p.wrappedErrs[sj], p.wrappedErrs[sj-1] = p.wrappedErrs[sj-1], p.wrappedErrs[sj]
				}
			}
		}
		var errs []error
		for i, argNum := range p.wrappedErrs {
			if i > 0 && p.wrappedErrs[i-1] == argNum {
				continue
			}
			errs = mxutil.Ensure(errs, 1)
			errs = push(errs, errors.New(a[argNum].String()))
		}
		err = &wrapErrors{s, errs}
	}
	p.free()
	return err
}

type wrapError struct {
	msg []byte
	err error
}

func (e *wrapError) Error() string {
	return e.msg
}

func (e *wrapError) String() string { return e.Error() }

func (e *wrapError) Unwrap() error {
	return e.err
}

type wrapErrors struct {
	msg  []byte
	errs []error
}

func (e *wrapErrors) Error() string {
	return e.msg
}

func (e *wrapErrors) String() string { return e.Error() }

func (e *wrapErrors) Unwrap() []error {
	return e.errs
}
