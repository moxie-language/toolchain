// Package adler32 implements the Adler-32 checksum.
//
// It is defined in RFC 1950:
//
//	Adler-32 is composed of two sums accumulated per byte: s1 is
//	the sum of all bytes, s2 is the sum of all s1 values. Both sums
//	are done modulo 65521. s1 is initialized to 1, s2 to zero.  The
//	Adler-32 checksum is stored as s2*65536 + s1 in most-
//	significant-byte first (network) order.
package adler32

import (
	"github.com/moxie-language/toolchain/pkg/mxutil"
	"errors"
	"hash"
	"internal/byteorder"
)

const (
	// mod is the largest prime that is less than 65536.
	mod = 65521
	// nmax is the largest n such that
	// 255 * n * (n+1) / 2 + (n+1) * (mod-1) <= 2^32-1.
	// It is mentioned in RFC 1950 (search for "5552").
	nmax = 5552
)

// The size of an Adler-32 checksum in bytes.
const Size = 4

// digest represents the partial evaluation of a checksum.
// The low 16 bits are s1, the high 16 bits are s2.
//
// A struct, not a bare uint32 (Go's spelling): the codec cannot tell a pointer
// to a whole scalar object from a pointer into a larger buffer, so a returned
// *uint32 is aliased and its frame arena is leaked to keep it alive - one
// 64 KiB arena per New, which for zlib means one per compressed stream. A
// one-field struct is deep-copied into the caller's arena instead.
type digest struct {
	s uint32
}

func (d *digest) Reset() { d.s = 1 }

// New returns a new hash.Hash32 computing the Adler-32 checksum. Its
// Sum method will lay the value out in big-endian byte order. The
// returned Hash32 also implements [encoding.BinaryMarshaler] and
// [encoding.BinaryUnmarshaler] to marshal and unmarshal the internal
// state of the hash.
func New() (h hash.Hash32) {
	var d digest
	d.Reset()
	return &d
}

func (d *digest) Size() (size int32) { return Size }

func (d *digest) BlockSize() (size int32) { return 4 }

const (
	magic         = "adl\x01"
	marshaledSize = len(magic) + 4
)

func (d *digest) AppendBinary(b []byte) (out []byte, aerr error) {
	out = mxutil.Ensure(b, len(magic))
	out = push(out, magic...)
	out = byteorder.BEAppendUint32(out, d.s)
	return out, nil
}

func (d *digest) MarshalBinary() (out []byte, merr error) {
	return d.AppendBinary([]byte{:0:marshaledSize})
}

func (d *digest) UnmarshalBinary(b []byte) (uerr error) {
	if len(b) < len(magic) || b[:len(magic)] != magic {
		return errors.New("hash/adler32: invalid hash state identifier")
	}
	if len(b) != marshaledSize {
		return errors.New("hash/adler32: invalid hash state size")
	}
	d.s = byteorder.BEUint32At(b, len(magic))
	return nil
}

func (d *digest) Clone() (c hash.Cloner, cerr error) {
	r := *d
	return &r, nil
}

// Add p to the running checksum d.
func update(d digest, p []byte) (out digest) {
	s1, s2 := d.s&0xffff, d.s>>16
	// pos walks p: p = p[4:] per word would copy the rest of the input at every
	// four bytes, and the nmax window would copy the remainder per chunk.
	pos := int32(0)
	for len(p)-pos > 0 {
		end := int32(len(p))
		if end-pos > nmax {
			end = pos + nmax
		}
		for end-pos >= 4 {
			s1 += uint32(p[pos+0])
			s2 += s1
			s1 += uint32(p[pos+1])
			s2 += s1
			s1 += uint32(p[pos+2])
			s2 += s1
			s1 += uint32(p[pos+3])
			s2 += s1
			pos += 4
		}
		for pos < end {
			s1 += uint32(p[pos])
			s2 += s1
			pos++
		}
		s1 %= mod
		s2 %= mod
	}
	out.s = s2<<16 | s1
	return out
}

func (d *digest) Write(p []byte) (nn int32, err error) {
	*d = update(*d, p)
	return len(p), nil
}

func (d *digest) Sum32() (s uint32) { return d.s }

func (d *digest) Sum(in []byte) (out []byte) {
	s := d.s
	return push(in, byte(s>>24), byte(s>>16), byte(s>>8), byte(s))
}

// Checksum returns the Adler-32 checksum of data.
func Checksum(data []byte) (sum uint32) { return update(digest{s: 1}, data).s }
