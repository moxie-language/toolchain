// Package crc64 implements the 64-bit cyclic redundancy check, or CRC-64,
// checksum. See https://en.wikipedia.org/wiki/Cyclic_redundancy_check for
// information.
package crc64

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"errors"
	"hash"
	"internal/byteorder"
)

// The size of a CRC-64 checksum in bytes.
const Size = 8

// Predefined polynomials.
const (
	// The ISO polynomial, defined in ISO 3309 and used in HDLC.
	ISO = 0xD800000000000000

	// The ECMA polynomial, defined in ECMA 182.
	ECMA = 0xC96C5795D7870F42
)

// Table is a 256-word table representing the polynomial for efficient processing.
type Table struct {
	words []uint64
}

// The two slicing-by-8 table sets are built in init(), which is the only place
// a package global may be written: outside init() a global store is rejected by
// the restrictions and is not relocated into the root arena, so a slice built
// in a caller's frame and stored into a global would dangle there.
var slicing8Tables struct {
	ISO  [][]uint64
	ECMA [][]uint64
}

func init() {
	slicing8Tables.ISO = makeSlicingBy8Table(makeTable(ISO))
	slicing8Tables.ECMA = makeSlicingBy8Table(makeTable(ECMA))
}

// MakeTable returns a [Table] constructed from the specified polynomial.
// The contents of this [Table] must not be modified.
func MakeTable(poly uint64) (tab *Table) {
	switch poly {
	case ISO:
		return &Table{words: slicing8Tables.ISO[0]}
	case ECMA:
		return &Table{words: slicing8Tables.ECMA[0]}
	default:
		return makeTable(poly)
	}
}

func makeTable(poly uint64) (tab *Table) {
	tab = &Table{words: []uint64{:256}}
	for i := 0; i < 256; i++ {
		crc := uint64(i)
		for j := 0; j < 8; j++ {
			if crc&1 == 1 {
				crc = (crc >> 1) ^ poly
			} else {
				crc >>= 1
			}
		}
		tab.words[i] = crc
	}
	return tab
}

func makeSlicingBy8Table(t *Table) (tab [][]uint64) {
	tab = [][]uint64{:8}
	for j := 0; j < 8; j++ {
		tab[j] = []uint64{:256}
	}
	copy(tab[0], t.words)
	for i := 0; i < 256; i++ {
		crc := t.words[i]
		for j := 1; j < 8; j++ {
			crc = t.words[crc&0xff] ^ (crc >> 8)
			tab[j][i] = crc
		}
	}
	return tab
}

// digest represents the partial evaluation of a checksum.
type digest struct {
	crc uint64
	tab *Table
}

// New creates a new hash.Hash64 computing the CRC-64 checksum using the
// polynomial represented by the [Table]. Its Sum method will lay the
// value out in big-endian byte order. The returned Hash64 also
// implements [encoding.BinaryMarshaler] and [encoding.BinaryUnmarshaler] to
// marshal and unmarshal the internal state of the hash.
func New(tab *Table) (h hash.Hash64) { return &digest{0, tab} }

func (d *digest) Size() (size int32) { return Size }

func (d *digest) BlockSize() (size int32) { return 1 }

func (d *digest) Reset() { d.crc = 0 }

const (
	magic         = "crc\x02"
	marshaledSize = len(magic) + 8 + 8
)

func (d *digest) AppendBinary(b []byte) (out []byte, aerr error) {
	out = mxutil.Ensure(b, len(magic))
	out = push(out, magic...)
	out = byteorder.BEAppendUint64(out, tableSum(d.tab))
	out = byteorder.BEAppendUint64(out, d.crc)
	return out, nil
}

func (d *digest) MarshalBinary() (out []byte, merr error) {
	return d.AppendBinary([]byte{:0:marshaledSize})
}

func (d *digest) UnmarshalBinary(b []byte) (uerr error) {
	if len(b) < len(magic) || b[:len(magic)] != magic {
		return errors.New("hash/crc64: invalid hash state identifier")
	}
	if len(b) != marshaledSize {
		return errors.New("hash/crc64: invalid hash state size")
	}
	if tableSum(d.tab) != byteorder.BEUint64At(b, 4) {
		return errors.New("hash/crc64: tables do not match")
	}
	d.crc = byteorder.BEUint64At(b, 12)
	return nil
}

func (d *digest) Clone() (cl hash.Cloner, cerr error) {
	r := *d
	return &r, nil
}

func update(crc uint64, tab *Table, p []byte) (out uint64) {
	crc = ^crc
	// pos walks p: p = p[8:] inside the loop would copy the rest of the input
	// every eight bytes.
	pos := int32(0)
	// Table comparison is somewhat expensive, so avoid it for small sizes
	for len(p)-pos >= 64 {
		var helperTable [][]uint64
		if tab.words == slicing8Tables.ECMA[0] {
			helperTable = slicing8Tables.ECMA
		} else if tab.words == slicing8Tables.ISO[0] {
			helperTable = slicing8Tables.ISO
			// For smaller sizes creating extended table takes too much time
		} else if len(p)-pos >= 2048 {
			// According to the tests between various x86 and arm CPUs, 2k is a reasonable
			// threshold for now. This may change in the future.
			helperTable = makeSlicingBy8Table(tab)
		} else {
			break
		}
		// Update using slicing-by-8
		for len(p)-pos > 8 {
			crc ^= byteorder.LEUint64At(p, pos)
			crc = helperTable[7][crc&0xff] ^
				helperTable[6][(crc>>8)&0xff] ^
				helperTable[5][(crc>>16)&0xff] ^
				helperTable[4][(crc>>24)&0xff] ^
				helperTable[3][(crc>>32)&0xff] ^
				helperTable[2][(crc>>40)&0xff] ^
				helperTable[1][(crc>>48)&0xff] ^
				helperTable[0][crc>>56]
			pos += 8
		}
	}
	// For reminders or small sizes
	for i := pos; i < len(p); i++ {
		crc = tab.words[byte(crc)^p[i]] ^ (crc >> 8)
	}
	return ^crc
}

// Update returns the result of adding the bytes in p to the crc.
func Update(crc uint64, tab *Table, p []byte) (out uint64) {
	return update(crc, tab, p)
}

func (d *digest) Write(p []byte) (n int32, err error) {
	d.crc = update(d.crc, d.tab, p)
	return len(p), nil
}

func (d *digest) Sum64() (s uint64) { return d.crc }

func (d *digest) Sum(in []byte) (out []byte) {
	s := d.Sum64()
	return push(in, byte(s>>56), byte(s>>48), byte(s>>40), byte(s>>32), byte(s>>24), byte(s>>16), byte(s>>8), byte(s))
}

// Checksum returns the CRC-64 checksum of data
// using the polynomial represented by the [Table].
func Checksum(data []byte, tab *Table) (sum uint64) { return update(0, tab, data) }

// tableSum returns the ISO checksum of table t.
func tableSum(t *Table) (sum uint64) {
	b := []byte{:0:2048}
	if t != nil {
		for _, x := range t.words {
			b = byteorder.BEAppendUint64(b, x)
		}
	}
	return Checksum(b, MakeTable(ISO))
}
