// ARM64-specific hardware-assisted CRC32 algorithms. See crc32.go for a
// description of the interface that each architecture-specific file
// implements.

package crc32

import "internal/cpu"

type archState struct{}

// The CRC32 instructions have no assembler pass here and the .s files were
// never ported, so these two used to be bodiless declarations and every arm64
// link that reached crc32 failed with undefined symbols. Same raw reflected
// update as the amd64 file: the callers invert, so these must not (see the
// comment on crcRawUpdate in crc32_amd64.mx).
func castagnoliUpdate(crc uint32, p []byte) (out uint32) {
	return crcRawUpdate(crc, Castagnoli, p)
}

func ieeeUpdate(crc uint32, p []byte) (out uint32) {
	return crcRawUpdate(crc, IEEE, p)
}

func archAvailableCastagnoli() (avail bool) {
	return cpu.ARM64.HasCRC32
}

func (c *CRC32) archInitCastagnoli() {
	if !cpu.ARM64.HasCRC32 {
		panic("arch-specific crc32 instruction for Castagnoli not available")
	}
}

func (c *CRC32) archUpdateCastagnoli(crc uint32, p []byte) (out uint32) {
	if !cpu.ARM64.HasCRC32 {
		panic("arch-specific crc32 instruction for Castagnoli not available")
	}

	return ^castagnoliUpdate(^crc, p)
}

func archAvailableIEEE() (avail bool) {
	return cpu.ARM64.HasCRC32
}

func (c *CRC32) archInitIEEE() {
	if !cpu.ARM64.HasCRC32 {
		panic("arch-specific crc32 instruction for IEEE not available")
	}
}

func (c *CRC32) archUpdateIEEE(crc uint32, p []byte) (out uint32) {
	if !cpu.ARM64.HasCRC32 {
		panic("arch-specific crc32 instruction for IEEE not available")
	}

	return ^ieeeUpdate(^crc, p)
}
