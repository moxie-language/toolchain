// AMD64-specific hardware-assisted CRC32 algorithms. See crc32.go for a
// description of the interface that each architecture-specific file
// implements.

package crc32

import (
	"internal/cpu"
	"unsafe"
)

// This file contains the code to call the SSE 4.2 version of the Castagnoli
// and IEEE CRC.

// The SSE 4.2 CRC32 instruction and the PCLMULQDQ kernels have no assembler
// pass in this tree and their .s files were never ported, so these three used
// to be bodiless declarations. Every binary whose closure reached crc32 then
// died at link: "undefined symbol: hash/crc32.castagnoliSSE42",
// "castagnoliSSE42Triple", "ieeeCLMUL" - which is where src/net/http stopped
// once its codegen blockers were gone.
//
// A CRC is a function of its input, not of the instruction that computed it, so
// the same update is written out here in Moxie. What the hardware kernels
// compute - and what archUpdateIEEE/archUpdateCastagnoli expect - is the
// reflected register update with NO pre- or post-inversion; both callers invert
// the value themselves (`^ieeeCLMUL(^crc, ...)`, `crc = ^crc; ...; return ^crc`),
// so the raw form is what belongs here.

// crcRawUpdate is one reflected CRC register update with no inversion.
func crcRawUpdate(crc uint32, poly uint32, p []byte) (out uint32) {
	for _, v := range p {
		crc = crc ^ uint32(v)
		for k := 0; k < 8; k++ {
			if crc&1 != 0 {
				crc = (crc >> 1) ^ poly
			} else {
				crc >>= 1
			}
		}
	}
	return crc
}

// castagnoliSSE42 updates one stream with Castagnoli's polynomial.
func castagnoliSSE42(crc uint32, p []byte) (out uint32) {
	return crcRawUpdate(crc, Castagnoli, p)
}

// castagnoliSSE42Triple updates three independent streams. The hardware
// interleaves them for instruction-level parallelism; each stream is still a
// sequential update over its own rounds*24 bytes, which is exactly how far the
// caller advances p (castagnoliK2/24 * 24 == castagnoliK2).
func castagnoliSSE42Triple(
	crcA, crcB, crcC uint32,
	a, b, c []byte,
	rounds uint32,
) (retA uint32, retB uint32, retC uint32) {
	nn := int32(rounds) * 24
	return crcRawUpdate(crcA, Castagnoli, a[:nn]),
		crcRawUpdate(crcB, Castagnoli, b[:nn]),
		crcRawUpdate(crcC, Castagnoli, c[:nn])
}

// ieeeCLMUL updates one stream with the IEEE polynomial.
func ieeeCLMUL(crc uint32, p []byte) (out uint32) {
	return crcRawUpdate(crc, IEEE, p)
}

const castagnoliK1 = 168
const castagnoliK2 = 1344

type sse42Table [4]Table

type archState struct {
	castagnoliSSE42TableK1 *sse42Table
	castagnoliSSE42TableK2 *sse42Table
	archIeeeTable8         *slicing8Table
}

func archAvailableCastagnoli() (avail bool) {
	return cpu.X86.HasSSE42
}

func (c *CRC32) archInitCastagnoli() {
	if !cpu.X86.HasSSE42 {
		panic("arch-specific Castagnoli not available")
	}
	c.castagnoliSSE42TableK1 = &sse42Table{}
	c.castagnoliSSE42TableK2 = &sse42Table{}
	// See description in archUpdateCastagnoli.
	//    t[0][i] = CRC(i000, O)
	//    t[1][i] = CRC(0i00, O)
	//    t[2][i] = CRC(00i0, O)
	//    t[3][i] = CRC(000i, O)
	// where O is a sequence of K zeros.
	var tmp [castagnoliK2]byte
	// Declared once, outside both loops: a declaration in a loop in a
	// self-mutating method is rejected, and the scratch would otherwise be
	// re-allocated into the sovereign arena on every iteration.
	var val uint32
	for b := 0; b < 4; b++ {
		for i := 0; i < 256; i++ {
			val = uint32(i) << uint32(b*8)
			c.castagnoliSSE42TableK1[b][i] = castagnoliSSE42(val, tmp[:castagnoliK1])
			c.castagnoliSSE42TableK2[b][i] = castagnoliSSE42(val, tmp[:])
		}
	}
}

// castagnoliShift computes the CRC32-C of K1 or K2 zeroes (depending on the
// table given) with the given initial crc value. This corresponds to
// CRC(crc, O) in the description in archUpdateCastagnoli.
func castagnoliShift(table *sse42Table, crc uint32) (out uint32) {
	return table[3][crc>>24] ^
		table[2][(crc>>16)&0xFF] ^
		table[1][(crc>>8)&0xFF] ^
		table[0][crc&0xFF]
}

func (c *CRC32) archUpdateCastagnoli(crc uint32, p []byte) (out uint32) {
	if !cpu.X86.HasSSE42 {
		panic("not available")
	}

	crc = ^crc

	if len(p) >= castagnoliK1*3 {
		delta := int32(uintptr(unsafe.Pointer(&p[0])) & 7)
		if delta != 0 {
			delta = 8 - delta
			crc = castagnoliSSE42(crc, p[:delta])
			p = p[delta:]
		}
	}

	for len(p) >= castagnoliK2*3 {
		crcA, crcB, crcC := castagnoliSSE42Triple(
			crc, 0, 0,
			p, p[castagnoliK2:], p[castagnoliK2*2:],
			castagnoliK2/24)

		crcAB := castagnoliShift(c.castagnoliSSE42TableK2, crcA) ^ crcB
		crc = castagnoliShift(c.castagnoliSSE42TableK2, crcAB) ^ crcC
		p = p[castagnoliK2*3:]
	}

	for len(p) >= castagnoliK1*3 {
		crcA, crcB, crcC := castagnoliSSE42Triple(
			crc, 0, 0,
			p, p[castagnoliK1:], p[castagnoliK1*2:],
			castagnoliK1/24)

		crcAB := castagnoliShift(c.castagnoliSSE42TableK1, crcA) ^ crcB
		crc = castagnoliShift(c.castagnoliSSE42TableK1, crcAB) ^ crcC
		p = p[castagnoliK1*3:]
	}

	crc = castagnoliSSE42(crc, p)
	return ^crc
}

func archAvailableIEEE() (avail bool) {
	return cpu.X86.HasPCLMULQDQ && cpu.X86.HasSSE41
}

func (c *CRC32) archInitIEEE() {
	if !cpu.X86.HasPCLMULQDQ || !cpu.X86.HasSSE41 {
		panic("not available")
	}
	c.archIeeeTable8 = slicingMakeTable(IEEE)
}

func (c *CRC32) archUpdateIEEE(crc uint32, p []byte) (out uint32) {
	if !cpu.X86.HasPCLMULQDQ || !cpu.X86.HasSSE41 {
		panic("not available")
	}

	if len(p) >= 64 {
		left := len(p) & 15
		do := len(p) - left
		crc = ^ieeeCLMUL(^crc, p[:do])
		p = p[do:]
	}
	if len(p) == 0 {
		return crc
	}
	return slicingUpdate(crc, c.archIeeeTable8, p)
}
