// Package crc32 implements the 32-bit cyclic redundancy check, or CRC-32,
// checksum. See https://en.wikipedia.org/wiki/Cyclic_redundancy_check for
// information.
//
// Polynomials are represented in LSB-first form also known as reversed representation.
//
// See https://en.wikipedia.org/wiki/Mathematics_of_cyclic_redundancy_checks#Reversed_representations_and_reciprocal_polynomials
// for information.
package crc32

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"errors"
	"hash"
	"internal/byteorder"
)

// The size of a CRC-32 checksum in bytes.
const Size = 4

// Predefined polynomials.
const (
	// IEEE is by far and away the most common CRC-32 polynomial.
	// Used by ethernet (IEEE 802.3), v.42, fddi, gzip, zip, png, ...
	IEEE = 0xedb88320

	// Castagnoli's polynomial, used in iSCSI.
	// Has better error detection characteristics than IEEE.
	// https://dx.doi.org/10.1109/26.231911
	Castagnoli = 0x82f63b78

	// Koopman's polynomial.
	// Also has better error detection characteristics than IEEE.
	// https://dx.doi.org/10.1109/DSN.2002.1028931
	Koopman = 0xeb31d82e
)

// Table is a 256-word table representing the polynomial for efficient processing.
type Table [256]uint32

// CRC32 holds all state for CRC-32 computation. Callers create an instance
// with NewCRC32 and call methods on it.
type CRC32 struct {
	archState
	ieeeTable        *Table
	ieeeTable8       *slicing8Table
	ieeeArch         bool
	ieeeInited       bool
	castagnoliTable  *Table
	castagnoliTable8 *slicing8Table
	castagnoliArch   bool
	castagnoliInited bool
}

// NewCRC32 creates a new CRC32 instance with IEEE tables eagerly initialized.
func NewCRC32() (c *CRC32) {
	c = &CRC32{}
	c.ieeeTable = simpleMakeTable(IEEE)
	c.initIEEE()
	return c
}

func (c *CRC32) initIEEE() {
	if c.ieeeInited {
		return
	}
	if archAvailableIEEE() {
		c.archInitIEEE()
		c.ieeeArch = true
	} else {
		c.ieeeTable8 = slicingMakeTable(IEEE)
	}
	c.ieeeInited = true
}

func (c *CRC32) initCastagnoli() {
	if c.castagnoliInited {
		return
	}
	c.castagnoliTable = simpleMakeTable(Castagnoli)
	if archAvailableCastagnoli() {
		c.archInitCastagnoli()
		c.castagnoliArch = true
	} else {
		c.castagnoliTable8 = slicingMakeTable(Castagnoli)
	}
	c.castagnoliInited = true
}

// IEEETable returns the table for the IEEE polynomial.
func (c *CRC32) IEEETable() (tab *Table) { return c.ieeeTable }

// MakeTable returns a [Table] constructed from the specified polynomial.
// The contents of this [Table] must not be modified.
func (c *CRC32) MakeTable(poly uint32) (tab *Table) {
	switch poly {
	case IEEE:
		c.initIEEE()
		return c.ieeeTable
	case Castagnoli:
		c.initCastagnoli()
		return c.castagnoliTable
	default:
		return simpleMakeTable(poly)
	}
}

// digest represents the partial evaluation of a checksum.
type digest struct {
	crc uint32
	tab *Table
	c   *CRC32
}

// New creates a new [hash.Hash32] computing the CRC-32 checksum using the
// polynomial represented by the [Table]. Its Sum method will lay the
// value out in big-endian byte order. The returned Hash32 also
// implements [encoding.BinaryMarshaler] and [encoding.BinaryUnmarshaler] to
// marshal and unmarshal the internal state of the hash.
func (c *CRC32) New(tab *Table) (h hash.Hash32) {
	if tab == c.ieeeTable {
		c.initIEEE()
	}
	return &digest{0, tab, c}
}

// NewIEEE creates a new [hash.Hash32] computing the CRC-32 checksum using
// the [IEEE] polynomial. Its Sum method will lay the value out in
// big-endian byte order. The returned Hash32 also implements
// [encoding.BinaryMarshaler] and [encoding.BinaryUnmarshaler] to marshal
// and unmarshal the internal state of the hash.
func (c *CRC32) NewIEEE() (h hash.Hash32) { return c.New(c.ieeeTable) }

func (d *digest) Size() (size int32) { return Size }

func (d *digest) BlockSize() (size int32) { return 1 }

func (d *digest) Reset() { d.crc = 0 }

const (
	magic         = "crc\x01"
	marshaledSize = len(magic) + 4 + 4
)

func (d *digest) AppendBinary(b []byte) (out []byte, aerr error) {
	out = mxutil.Ensure(b, len(magic))
	out = push(out, magic...)
	out = byteorder.BEAppendUint32(out, d.c.tableSum(d.tab))
	out = byteorder.BEAppendUint32(out, d.crc)
	return out, nil
}

func (d *digest) MarshalBinary() (out []byte, merr error) {
	return d.AppendBinary([]byte{:0:marshaledSize})

}

func (d *digest) UnmarshalBinary(b []byte) (uerr error) {
	if len(b) < len(magic) || b[:len(magic)] != magic {
		return errors.New("hash/crc32: invalid hash state identifier")
	}
	if len(b) != marshaledSize {
		return errors.New("hash/crc32: invalid hash state size")
	}
	if d.c.tableSum(d.tab) != byteorder.BEUint32(b[4:]) {
		return errors.New("hash/crc32: tables do not match")
	}
	d.crc = byteorder.BEUint32(b[8:])
	return nil
}

func (d *digest) Clone() (cl hash.Cloner, cerr error) {
	r := *d
	return &r, nil
}

func (c *CRC32) update(crc uint32, tab *Table, p []byte, checkInitIEEE bool) (out uint32) {
	switch {
	case c.castagnoliInited && tab == c.castagnoliTable:
		if c.castagnoliArch {
			return c.archUpdateCastagnoli(crc, p)
		}
		return slicingUpdate(crc, c.castagnoliTable8, p)
	case tab == c.ieeeTable:
		if checkInitIEEE {
			c.initIEEE()
		}
		if c.ieeeArch {
			return c.archUpdateIEEE(crc, p)
		}
		return slicingUpdate(crc, c.ieeeTable8, p)
	default:
		return simpleUpdate(crc, tab, p)
	}
}

// Update returns the result of adding the bytes in p to the crc.
func (c *CRC32) Update(crc uint32, tab *Table, p []byte) (out uint32) {
	return c.update(crc, tab, p, true)
}

func (d *digest) Write(p []byte) (n int32, err error) {
	d.crc = d.c.update(d.crc, d.tab, p, false)
	return len(p), nil
}

func (d *digest) Sum32() (s uint32) { return d.crc }

func (d *digest) Sum(in []byte) (out []byte) {
	s := d.Sum32()
	return push(in, byte(s>>24), byte(s>>16), byte(s>>8), byte(s))
}

// Checksum returns the CRC-32 checksum of data
// using the polynomial represented by the [Table].
func (c *CRC32) Checksum(data []byte, tab *Table) (sum uint32) { return c.Update(0, tab, data) }

// ChecksumIEEE returns the CRC-32 checksum of data
// using the [IEEE] polynomial.
func (c *CRC32) ChecksumIEEE(data []byte) (sum uint32) {
	c.initIEEE()
	if c.ieeeArch {
		return c.archUpdateIEEE(0, data)
	}
	return slicingUpdate(0, c.ieeeTable8, data)
}

// tableSum returns the IEEE checksum of table t.
func (c *CRC32) tableSum(t *Table) (sum uint32) {
	var a [1024]byte
	b := a[:0]
	if t != nil {
		for _, x := range t {
			b = byteorder.BEAppendUint32(b, x)
		}
	}
	return c.ChecksumIEEE(b)
}
