package crc32

import "internal/cpu"

const (
	vxMinLen    = 64
	vxAlignMask = 15 // align to 16 bytes
)

// vectorizedCastagnoli implements CRC32 using vector instructions.
// It is defined in crc32_s390x.s.
//
//go:noescape
func vectorizedCastagnoli(crc uint32, p []byte) uint32

// vectorizedIEEE implements CRC32 using vector instructions.
// It is defined in crc32_s390x.s.
//
//go:noescape
func vectorizedIEEE(crc uint32, p []byte) uint32

type archState struct {
	archCastagnoliTable8 *slicing8Table
	archIeeeTable8       *slicing8Table
}

func archAvailableCastagnoli() bool {
	return cpu.S390X.HasVX
}

func (c *CRC32) archInitCastagnoli() {
	if !cpu.S390X.HasVX {
		panic("not available")
	}
	c.archCastagnoliTable8 = slicingMakeTable(Castagnoli)
}

// archUpdateCastagnoli calculates the checksum of p using
// vectorizedCastagnoli.
func (c *CRC32) archUpdateCastagnoli(crc uint32, p []byte) uint32 {
	if !cpu.S390X.HasVX {
		panic("not available")
	}
	if len(p) >= vxMinLen {
		aligned := len(p) & ^vxAlignMask
		crc = vectorizedCastagnoli(crc, p[:aligned])
		p = p[aligned:]
	}
	if len(p) == 0 {
		return crc
	}
	return slicingUpdate(crc, c.archCastagnoliTable8, p)
}

func archAvailableIEEE() bool {
	return cpu.S390X.HasVX
}

func (c *CRC32) archInitIEEE() {
	if !cpu.S390X.HasVX {
		panic("not available")
	}
	c.archIeeeTable8 = slicingMakeTable(IEEE)
}

// archUpdateIEEE calculates the checksum of p using vectorizedIEEE.
func (c *CRC32) archUpdateIEEE(crc uint32, p []byte) uint32 {
	if !cpu.S390X.HasVX {
		panic("not available")
	}
	if len(p) >= vxMinLen {
		aligned := len(p) & ^vxAlignMask
		crc = vectorizedIEEE(crc, p[:aligned])
		p = p[aligned:]
	}
	if len(p) == 0 {
		return crc
	}
	return slicingUpdate(crc, c.archIeeeTable8, p)
}
