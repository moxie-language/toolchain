// Package fnv implements FNV-1 and FNV-1a, non-cryptographic hash functions
// created by Glenn Fowler, Landon Curt Noll, and Phong Vo.
// See
// https://en.wikipedia.org/wiki/Fowler-Noll-Vo_hash_function.
//
// All the hash.Hash implementations returned by this package also
// implement encoding.BinaryMarshaler and encoding.BinaryUnmarshaler to
// marshal and unmarshal the internal state of the hash.
package fnv

import (
	"moxielang.dev/pkg/mxutil"
	"errors"
	"hash"
	"internal/byteorder"
	"math/bits"
)

type (
	sum32   uint32
	sum32a  uint32
	sum64   uint64
	sum64a  uint64
	sum128 struct {
		hi uint64
		lo uint64
	}
	sum128a struct {
		hi uint64
		lo uint64
	}
)

const (
	offset32        = 2166136261
	offset64        = 14695981039346656037
	offset128Lower  = 0x62b821756295c58d
	offset128Higher = 0x6c62272e07bb0142
	prime32         = 16777619
	prime64         = 1099511628211
	prime128Lower   = 0x13b
	prime128Shift   = 24
)

// New32 returns a new 32-bit FNV-1 [hash.Hash].
// Its Sum method will lay the value out in big-endian byte order.
func New32() (h hash.Hash32) {
	var s sum32 = offset32
	return &s
}

// New32a returns a new 32-bit FNV-1a [hash.Hash].
// Its Sum method will lay the value out in big-endian byte order.
func New32a() (h hash.Hash32) {
	var s sum32a = offset32
	return &s
}

// New64 returns a new 64-bit FNV-1 [hash.Hash].
// Its Sum method will lay the value out in big-endian byte order.
func New64() (h hash.Hash64) {
	var s sum64 = offset64
	return &s
}

// New64a returns a new 64-bit FNV-1a [hash.Hash].
// Its Sum method will lay the value out in big-endian byte order.
func New64a() (h hash.Hash64) {
	var s sum64a = offset64
	return &s
}

// New128 returns a new 128-bit FNV-1 [hash.Hash].
// Its Sum method will lay the value out in big-endian byte order.
func New128() (h hash.Hash) {
	var s sum128
	s.hi = offset128Higher
	s.lo = offset128Lower
	return &s
}

// New128a returns a new 128-bit FNV-1a [hash.Hash].
// Its Sum method will lay the value out in big-endian byte order.
func New128a() (h hash.Hash) {
	var s sum128a
	s.hi = offset128Higher
	s.lo = offset128Lower
	return &s
}

func (s *sum32) Reset()   { *s = offset32 }
func (s *sum32a) Reset()  { *s = offset32 }
func (s *sum64) Reset()   { *s = offset64 }
func (s *sum64a) Reset()  { *s = offset64 }
func (s *sum128) Reset()  { s.hi = offset128Higher; s.lo = offset128Lower }
func (s *sum128a) Reset() { s.hi = offset128Higher; s.lo = offset128Lower }

func (s *sum32) Sum32() (v uint32)  { return uint32(*s) }
func (s *sum32a) Sum32() (v uint32) { return uint32(*s) }
func (s *sum64) Sum64() (v uint64)  { return uint64(*s) }
func (s *sum64a) Sum64() (v uint64) { return uint64(*s) }

func (s *sum32) Write(data []byte) (n int32, err error) {
	h := *s
	for _, c := range data {
		h *= prime32
		h ^= sum32(c)
	}
	*s = h
	return len(data), nil
}

func (s *sum32a) Write(data []byte) (n int32, err error) {
	h := *s
	for _, c := range data {
		h ^= sum32a(c)
		h *= prime32
	}
	*s = h
	return len(data), nil
}

func (s *sum64) Write(data []byte) (n int32, err error) {
	h := *s
	for _, c := range data {
		h *= prime64
		h ^= sum64(c)
	}
	*s = h
	return len(data), nil
}

func (s *sum64a) Write(data []byte) (n int32, err error) {
	h := *s
	for _, c := range data {
		h ^= sum64a(c)
		h *= prime64
	}
	*s = h
	return len(data), nil
}

func (s *sum128) Write(data []byte) (n int32, err error) {
	for _, c := range data {
		// Compute the multiplication
		s0, s1 := bits.Mul64(prime128Lower, s.lo)
		s0 += s.lo<<prime128Shift + prime128Lower*s.hi
		// Update the values
		s.lo = s1
		s.hi = s0
		s.lo ^= uint64(c)
	}
	return len(data), nil
}

func (s *sum128a) Write(data []byte) (n int32, err error) {
	for _, c := range data {
		s.lo ^= uint64(c)
		// Compute the multiplication
		s0, s1 := bits.Mul64(prime128Lower, s.lo)
		s0 += s.lo<<prime128Shift + prime128Lower*s.hi
		// Update the values
		s.lo = s1
		s.hi = s0
	}
	return len(data), nil
}

func (s *sum32) Size() (size int32)   { return 4 }
func (s *sum32a) Size() (size int32)  { return 4 }
func (s *sum64) Size() (size int32)   { return 8 }
func (s *sum64a) Size() (size int32)  { return 8 }
func (s *sum128) Size() (size int32)  { return 16 }
func (s *sum128a) Size() (size int32) { return 16 }

func (s *sum32) BlockSize() (size int32)   { return 1 }
func (s *sum32a) BlockSize() (size int32)  { return 1 }
func (s *sum64) BlockSize() (size int32)   { return 1 }
func (s *sum64a) BlockSize() (size int32)  { return 1 }
func (s *sum128) BlockSize() (size int32)  { return 1 }
func (s *sum128a) BlockSize() (size int32) { return 1 }

func (s *sum32) Sum(in []byte) (out []byte) {
	v := uint32(*s)
	return byteorder.BEAppendUint32(in, v)
}

func (s *sum32a) Sum(in []byte) (out []byte) {
	v := uint32(*s)
	return byteorder.BEAppendUint32(in, v)
}

func (s *sum64) Sum(in []byte) (out []byte) {
	v := uint64(*s)
	return byteorder.BEAppendUint64(in, v)
}

func (s *sum64a) Sum(in []byte) (out []byte) {
	v := uint64(*s)
	return byteorder.BEAppendUint64(in, v)
}

func (s *sum128) Sum(in []byte) (out []byte) {
	ret := byteorder.BEAppendUint64(in, s.hi)
	return byteorder.BEAppendUint64(ret, s.lo)
}

func (s *sum128a) Sum(in []byte) (out []byte) {
	ret := byteorder.BEAppendUint64(in, s.hi)
	return byteorder.BEAppendUint64(ret, s.lo)
}

const (
	magic32          = "fnv\x01"
	magic32a         = "fnv\x02"
	magic64          = "fnv\x03"
	magic64a         = "fnv\x04"
	magic128         = "fnv\x05"
	magic128a        = "fnv\x06"
	marshaledSize32  = len(magic32) + 4
	marshaledSize64  = len(magic64) + 8
	marshaledSize128 = len(magic128) + 8*2
)

func (s *sum32) AppendBinary(b []byte) (out []byte, aerr error) {
	out = mxutil.Ensure(b, len(magic32))
	out = push(out, magic32...)
	out = byteorder.BEAppendUint32(out, uint32(*s))
	return out, nil
}

func (s *sum32) MarshalBinary() (out []byte, merr error) {
	return s.AppendBinary([]byte{:0:marshaledSize32})
}

func (s *sum32a) AppendBinary(b []byte) (out []byte, aerr error) {
	out = mxutil.Ensure(b, len(magic32a))
	out = push(out, magic32a...)
	out = byteorder.BEAppendUint32(out, uint32(*s))
	return out, nil
}

func (s *sum32a) MarshalBinary() (out []byte, merr error) {
	return s.AppendBinary([]byte{:0:marshaledSize32})
}

func (s *sum64) AppendBinary(b []byte) (out []byte, aerr error) {
	out = mxutil.Ensure(b, len(magic64))
	out = push(out, magic64...)
	out = byteorder.BEAppendUint64(out, uint64(*s))
	return out, nil
}

func (s *sum64) MarshalBinary() (out []byte, merr error) {
	return s.AppendBinary([]byte{:0:marshaledSize64})
}

func (s *sum64a) AppendBinary(b []byte) (out []byte, aerr error) {
	out = mxutil.Ensure(b, len(magic64a))
	out = push(out, magic64a...)
	out = byteorder.BEAppendUint64(out, uint64(*s))
	return out, nil
}

func (s *sum64a) MarshalBinary() (out []byte, merr error) {
	return s.AppendBinary([]byte{:0:marshaledSize64})
}

func (s *sum128) AppendBinary(b []byte) (out []byte, aerr error) {
	out = mxutil.Ensure(b, len(magic128))
	out = push(out, magic128...)
	out = byteorder.BEAppendUint64(out, s.hi)
	out = byteorder.BEAppendUint64(out, s.lo)
	return out, nil
}

func (s *sum128) MarshalBinary() (out []byte, merr error) {
	return s.AppendBinary([]byte{:0:marshaledSize128})
}

func (s *sum128a) AppendBinary(b []byte) (out []byte, aerr error) {
	out = mxutil.Ensure(b, len(magic128a))
	out = push(out, magic128a...)
	out = byteorder.BEAppendUint64(out, s.hi)
	out = byteorder.BEAppendUint64(out, s.lo)
	return out, nil
}

func (s *sum128a) MarshalBinary() (out []byte, merr error) {
	return s.AppendBinary([]byte{:0:marshaledSize128})
}

func (s *sum32) UnmarshalBinary(b []byte) (uerr error) {
	if len(b) < len(magic32) || b[:len(magic32)] != magic32 {
		return errors.New("hash/fnv: invalid hash state identifier")
	}
	if len(b) != marshaledSize32 {
		return errors.New("hash/fnv: invalid hash state size")
	}
	*s = sum32(byteorder.BEUint32At(b, 4))
	return nil
}

func (s *sum32a) UnmarshalBinary(b []byte) (uerr error) {
	if len(b) < len(magic32a) || b[:len(magic32a)] != magic32a {
		return errors.New("hash/fnv: invalid hash state identifier")
	}
	if len(b) != marshaledSize32 {
		return errors.New("hash/fnv: invalid hash state size")
	}
	*s = sum32a(byteorder.BEUint32At(b, 4))
	return nil
}

func (s *sum64) UnmarshalBinary(b []byte) (uerr error) {
	if len(b) < len(magic64) || b[:len(magic64)] != magic64 {
		return errors.New("hash/fnv: invalid hash state identifier")
	}
	if len(b) != marshaledSize64 {
		return errors.New("hash/fnv: invalid hash state size")
	}
	*s = sum64(byteorder.BEUint64At(b, 4))
	return nil
}

func (s *sum64a) UnmarshalBinary(b []byte) (uerr error) {
	if len(b) < len(magic64a) || b[:len(magic64a)] != magic64a {
		return errors.New("hash/fnv: invalid hash state identifier")
	}
	if len(b) != marshaledSize64 {
		return errors.New("hash/fnv: invalid hash state size")
	}
	*s = sum64a(byteorder.BEUint64At(b, 4))
	return nil
}

func (s *sum128) UnmarshalBinary(b []byte) (uerr error) {
	if len(b) < len(magic128) || b[:len(magic128)] != magic128 {
		return errors.New("hash/fnv: invalid hash state identifier")
	}
	if len(b) != marshaledSize128 {
		return errors.New("hash/fnv: invalid hash state size")
	}
	s.hi = byteorder.BEUint64At(b, 4)
	s.lo = byteorder.BEUint64At(b, 12)
	return nil
}

func (s *sum128a) UnmarshalBinary(b []byte) (uerr error) {
	if len(b) < len(magic128a) || b[:len(magic128a)] != magic128a {
		return errors.New("hash/fnv: invalid hash state identifier")
	}
	if len(b) != marshaledSize128 {
		return errors.New("hash/fnv: invalid hash state size")
	}
	s.hi = byteorder.BEUint64At(b, 4)
	s.lo = byteorder.BEUint64At(b, 12)
	return nil
}

func (d *sum32) Clone() (cl hash.Cloner, cerr error) {
	r := *d
	return &r, nil
}

func (d *sum32a) Clone() (cl hash.Cloner, cerr error) {
	r := *d
	return &r, nil
}

func (d *sum64) Clone() (cl hash.Cloner, cerr error) {
	r := *d
	return &r, nil
}

func (d *sum64a) Clone() (cl hash.Cloner, cerr error) {
	r := *d
	return &r, nil
}

func (d *sum128) Clone() (cl hash.Cloner, cerr error) {
	r := *d
	return &r, nil
}

func (d *sum128a) Clone() (cl hash.Cloner, cerr error) {
	r := *d
	return &r, nil
}
