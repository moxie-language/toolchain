// Package context carries deadlines and cancellation signals across API
// boundaries.
//
// A Context is a thin wrapper around a chan struct{} breaker: the channel is
// closed when the work done on behalf of the Context should stop. A nil
// breaker means the Context can never be canceled.
//
// In Moxie a Context only makes sense inside spawned domains. The breaker is
// the lifecycle signal a spawned worker watches: the owner closes it to tear
// the worker down, and the worker selects on it to abandon work. Contexts
// are handed across the spawn boundary together with the work they govern.
package context

import (
	"errors"
	"git.smesh.lol/moxie/pkg/mxutil"
	"runtime"
	"time"
)

// A Context carries a deadline and a cancellation breaker.
//
// A Context may be canceled to indicate that work done on its behalf should
// stop. A Context with a deadline is canceled after the deadline passes.
// When a Context is canceled, all Contexts derived from it are also canceled.
type Context interface {
	// Deadline returns the time when work done on behalf of this context
	// should be canceled. Deadline returns ok==false when no deadline is
	// set. Successive calls to Deadline return the same results.
	Deadline() (deadline time.Time, ok bool)

	// Done returns a channel that's closed when work done on behalf of this
	// context should be canceled. Done may return nil if this context can
	// never be canceled. Successive calls to Done return the same value.
	Done() <-chan struct{}

	// If Done is not yet closed, Err returns nil.
	// If Done is closed, Err returns a non-nil error explaining why:
	// DeadlineExceeded if the context's deadline passed,
	// or Canceled if the context was canceled for some other reason.
	// After Err returns a non-nil error, successive calls to Err return the
	// same error.
	Err() error
}

// Canceled is the error returned by [Context.Err] when the context is canceled
// for some reason other than its deadline passing.
var Canceled error

// deadlineExceeded is the singleton returned by DeadlineExceeded: pointer
// receivers make every call a distinct value otherwise, and errors.Is compares
// the target with ==.
var deadlineExceeded error

func DeadlineExceeded() (err error) { return deadlineExceeded }

type deadlineExceededError struct{}

func (e *deadlineExceededError) Error() (msg string)   { return "context deadline exceeded" }
func (e *deadlineExceededError) String() (msg string)  { return e.Error() }
func (e *deadlineExceededError) Timeout() (ok bool)    { return true }
func (e *deadlineExceededError) Temporary() (ok bool)  { return true }

// emptyCtx is never canceled and has no deadline. Background and TODO both
// return it directly - no embedding, so interface dispatch never needs to
// resolve a promoted method across a package boundary.
type emptyCtx struct{}

func (e *emptyCtx) Deadline() (deadline time.Time, ok bool) { return }
func (e *emptyCtx) Done() (d <-chan struct{})                { return nil }
func (e *emptyCtx) Err() (err error)                         { return nil }

// background and todo are stable singletons: with pointer receivers a fresh
// &emptyCtx{} per call would make Background() != Background().
var background Context
var todo Context

func init() {
	deadlineExceeded = &deadlineExceededError{}
	background = &emptyCtx{}
	todo = &emptyCtx{}
	Canceled = errors.New("context canceled")
	deadlines = &deadlineScheduler{}
}

// Background returns a non-nil, empty Context. It is never canceled and has
// no deadline. It is typically used by the main function, initialization,
// and as the top-level Context for incoming requests.
func Background() (ctx Context) {
	return background
}

// TODO returns a non-nil, empty Context. Code should use context.TODO when
// it's unclear which Context to use or it is not yet available.
func TODO() (ctx Context) {
	return todo
}

// breakerCtx is the cancelable Context: a wrapper around a chan struct{}
// breaker. Closing the breaker signals cancellation to every domain holding
// a reference to it. A nil breaker means never canceled.
type breakerCtx struct {
	done        chan struct{}
	err         error
	cause       error
	deadline    time.Time
	hasDeadline bool
	parent      *breakerCtx
	children    map[*breakerCtx]struct{}
	afterFuncs  []*afterFunc
}

func (c *breakerCtx) Deadline() (deadline time.Time, ok bool) {
	return c.deadline, c.hasDeadline
}

func (c *breakerCtx) Done() (d <-chan struct{}) {
	if c.done == nil {
		c.done = chan struct{}{}
	}
	return c.done
}

func (c *breakerCtx) Err() (err error) { return c.err }

// A CancelFunc tells an operation to abandon its work.
// A CancelFunc does not wait for the work to stop.
// After the first call, subsequent calls do nothing.
//
// A Moxie func value carries no environment, so a callback that must remember
// which context it cancels cannot be a func(): CancelFunc is a stateful type
// whose method does the write.
type CancelFunc struct {
	c *breakerCtx
}

func (f *CancelFunc) Cancel() {
	if f.c == nil {
		return
	}
	deadlines.remove(f.c)
	f.c.cancel(true, Canceled, nil)
}

// A CancelCauseFunc behaves like a [CancelFunc] but additionally sets the
// cancellation cause.
type CancelCauseFunc struct {
	c *breakerCtx
}

func (f *CancelCauseFunc) Cancel(cause error) {
	if f.c == nil {
		return
	}
	deadlines.remove(f.c)
	f.c.cancel(true, Canceled, cause)
}

// deadlineEntry is one pending WithDeadline timer.
type deadlineEntry struct {
	c    *breakerCtx
	when time.Time
}

// deadlineScheduler holds the pending deadlines. Moxie has no goroutines to
// watch each deadline, so one package-level timer is armed for the earliest
// entry and re-armed as entries are added, cancelled, or fire. Its callback is
// the top-level deadlineFired, which reaches the scheduler through the package
// global: a func() cannot capture per-instance state.
type deadlineScheduler struct {
	entries []*deadlineEntry
	timer   *time.Timer
}

var deadlines *deadlineScheduler

func (s *deadlineScheduler) add(c *breakerCtx, when time.Time) {
	s.entries = mxutil.Ensure(s.entries, 1)
	s.entries = push(s.entries, &deadlineEntry{c: c, when: when})
	s.arm()
}

func (s *deadlineScheduler) remove(c *breakerCtx) {
	n := int32(0)
	for _, e := range s.entries {
		if e.c != c {
			n++
		}
	}
	if n == int32(len(s.entries)) {
		return
	}
	keep := []*deadlineEntry{:0:n}
	i := int32(0)
	for _, e := range s.entries {
		if e.c != c {
			keep[i] = e
			i++
		}
	}
	s.entries = keep[:i]
	s.arm()
}

func (s *deadlineScheduler) arm() {
	if len(s.entries) == 0 {
		return
	}
	earliest := s.entries[0]
	for _, e := range s.entries {
		if e.when.Before(earliest.when) {
			earliest = e
		}
	}
	if s.timer != nil {
		s.timer.Stop()
		s.timer = nil
	}
	dur := time.Until(earliest.when)
	if dur <= 0 {
		s.fire()
		return
	}
	s.timer = time.AfterFunc(dur, deadlineFired)
}

func (s *deadlineScheduler) fire() {
	now := time.Now()
	snap := s.entries
	keep := []*deadlineEntry{:0:len(snap)}
	n := int32(0)
	for _, e := range snap {
		if e.when.After(now) {
			keep[n] = e
			n++
		} else {
			e.c.cancel(true, DeadlineExceeded(), nil)
		}
	}
	s.entries = keep[:n]
	s.arm()
}

func deadlineFired() {
	deadlines.fire()
}

// cancel closes the breaker, cascades to children, and runs AfterFuncs.
func (c *breakerCtx) cancel(removeFromParent bool, err, cause error) {
	if c.err != nil {
		return // already canceled
	}
	c.err = err
	if cause == nil {
		c.cause = err
	} else {
		c.cause = cause
	}
	if c.done == nil {
		c.done = chan struct{}{}
	}
	close(c.done)
	for child := range c.children {
		child.cancel(false, err, cause)
	}
	c.children = nil
	for _, a := range c.afterFuncs {
		if a != nil && !a.done {
			a.done = true
			a.f.Call()
		}
	}
	c.afterFuncs = nil
	if removeFromParent && c.parent != nil {
		delete(c.parent.children, c)
	}
}

// newChild derives a breakerCtx from parent, wiring synchronous propagation:
// when parent cancels, child cancels. Moxie has no goroutines to watch a
// foreign parent's breaker, so a foreign parent that is not yet canceled and
// does not support cancellation propagation is a panic.
func newChild(parent Context) (child *breakerCtx) {
	prevArena := runtime.CurrentArena()
	runtime.SetCurrentArena(runtime.RootArena())
	defer runtime.SetCurrentArena(prevArena)
	if parent == nil {
		panic("cannot create context from nil parent")
	}
	child = &breakerCtx{}
	if p, ok := parent.(*breakerCtx); ok {
		child.parent = p
		if p.err != nil {
			child.cancel(false, p.err, p.cause)
		} else {
			if p.children == nil {
				p.children = map[*breakerCtx]struct{}{}
			}
			p.children[child] = struct{}{}
		}
		return child
	}
	// Foreign parent (Background, WithoutCancel wrapper, or custom type).
	// Check its Done channel synchronously.
	if d := parent.Done(); d != nil {
		select {
		case <-d:
			child.cancel(false, parent.Err(), parent.Err())
		default:
			panic("context: parent does not support cancellation propagation")
		}
	}
	return child
}

// WithCancel returns a copy of parent with a new Done channel. The returned
// context's Done channel is closed when the returned cancel function is
// called or when the parent context's Done channel is closed, whichever
// happens first.
func WithCancel(parent Context) (ctx Context, cancel CancelFunc) {
	prevArena := runtime.CurrentArena()
	runtime.SetCurrentArena(runtime.RootArena())
	defer runtime.SetCurrentArena(prevArena)
	c := newChild(parent)
	return c, CancelFunc{c: c}
}

// WithCancelCause behaves like [WithCancel] but returns a [CancelCauseFunc]
// instead of a [CancelFunc]. Calling cancel with a non-nil error (the
// "cause") records that error in ctx; it can then be retrieved using Cause.
// Calling cancel with nil sets the cause to Canceled.
func WithCancelCause(parent Context) (ctx Context, cancel CancelCauseFunc) {
	prevArena := runtime.CurrentArena()
	runtime.SetCurrentArena(runtime.RootArena())
	defer runtime.SetCurrentArena(prevArena)
	c := newChild(parent)
	return c, CancelCauseFunc{c: c}
}

// Cause returns a non-nil error explaining why c was canceled.
// The first cancellation of c or one of its parents sets the cause.
// If that cancellation happened via a call to CancelCauseFunc(err),
// then Cause returns err. Otherwise Cause(c) returns the same value as
// c.Err(). Cause returns nil if c has not been canceled yet.
func Cause(c Context) (err error) {
	if b, ok := c.(*breakerCtx); ok {
		return b.cause
	}
	return c.Err()
}

// WithoutCancel returns a derived context that points to the parent context
// and is not canceled when parent is canceled. The returned context returns
// no Deadline or Err, and its Done channel is nil.
func WithoutCancel(parent Context) (ctx Context) {
	if parent == nil {
		panic("cannot create context from nil parent")
	}
	return &withoutCancelCtx{parent}
}

type withoutCancelCtx struct {
	c Context
}

func (w *withoutCancelCtx) Deadline() (deadline time.Time, ok bool) { return }
func (w *withoutCancelCtx) Done() (d <-chan struct{})                { return nil }
func (w *withoutCancelCtx) Err() (err error)                         { return nil }

// WithDeadline returns a copy of the parent context with the deadline
// adjusted to be no later than d. If the parent's deadline is already
// earlier than d, WithDeadline(parent, d) is semantically equivalent to
// parent. The returned Done channel is closed when the deadline expires,
// when the returned cancel function is called, or when the parent context's
// Done channel is closed, whichever happens first.
func WithDeadline(parent Context, d time.Time) (ctx Context, cancel CancelFunc) {
	prevArena := runtime.CurrentArena()
	runtime.SetCurrentArena(runtime.RootArena())
	defer runtime.SetCurrentArena(prevArena)
	if parent == nil {
		panic("cannot create context from nil parent")
	}
	if cur, ok := parent.Deadline(); ok && cur.Before(d) {
		// The current deadline is already sooner than the new one.
		return WithCancel(parent)
	}
	c := newChild(parent)
	c.deadline = d
	c.hasDeadline = true
	if time.Until(d) <= 0 {
		// deadline has already passed
		c.cancel(true, DeadlineExceeded(), nil)
		return c, CancelFunc{c: c}
	}
	deadlines.add(c, d)
	return c, CancelFunc{c: c}
}

// WithTimeout returns WithDeadline(parent, time.Now().Add(timeout)).
func WithTimeout(parent Context, timeout time.Duration) (ctx Context, cancel CancelFunc) {
	return WithDeadline(parent, time.Now().Add(timeout))
}

// A Callback is the stateful callback [AfterFunc] runs. A Moxie func value
// carries no environment, so a callback that must remember what to act on is a
// type with a Call method rather than a func().
type Callback interface {
	Call()
}

// afterFunc registers a callback to run when its breakerCtx cancels.
type afterFunc struct {
	f    Callback
	done bool
}

// A StopFunc stops the association created by [AfterFunc].
type StopFunc struct {
	a *afterFunc
}

// Stop reports whether it stopped f from being run. If it returns false, the
// context has been canceled and f has been run.
func (s *StopFunc) Stop() (stopped bool) {
	if s.a.done {
		return false
	}
	s.a.done = true
	return true
}

// AfterFunc arranges to call f after ctx is canceled.
// If ctx is already canceled, AfterFunc calls f immediately.
//
// Calling the returned StopFunc's Stop method stops the association of ctx
// with f. Stop returns true if the call stopped f from being run.
// If Stop returns false, the context has been canceled and f has been run.
func AfterFunc(ctx Context, f Callback) (stop StopFunc) {
	prevArena := runtime.CurrentArena()
	runtime.SetCurrentArena(runtime.RootArena())
	defer runtime.SetCurrentArena(prevArena)
	a := &afterFunc{f: f}
	if b, ok := ctx.(*breakerCtx); ok {
		if b.err != nil {
			a.done = true
			f.Call()
			return StopFunc{a: a}
		}
		b.afterFuncs = mxutil.Ensure(b.afterFuncs, 1)
		push(b.afterFuncs, a)
		return StopFunc{a: a}
	}
	// Foreign context: check its Done channel synchronously.
	if d := ctx.Done(); d != nil {
		select {
		case <-d:
			a.done = true
			f.Call()
			return StopFunc{a: a}
		default:
			panic("context: parent does not support cancellation propagation")
		}
	}
	// Never canceled (e.g. Background): f never runs; Stop is still defined.
	return StopFunc{a: a}
}
