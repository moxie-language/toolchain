//:build js && wasm

package time

import (
	"internal/itoa"
	"runtime"
)

func _platformZoneSources() (rbyte [][]byte) {
	return [][]byte{
		"/usr/share/zoneinfo/",
		"/usr/share/lib/zoneinfo/",
		"/usr/lib/locale/TZ/",
	}
}

//:wasmimport bridge timezone_offset_minutes
func timezoneOffsetMinutes() (rn int32)

// initLocal fills the localLoc package global; see zoneinfo_unix.mx. The zone
// slice is built here and localLoc outlives this frame, so it goes in the
// root arena.
func initLocal() {
	saved := runtime.CurrentArena()
	runtime.SetCurrentArena(runtime.RootArena())
	initLocalInRoot()
	runtime.SetCurrentArena(saved)
}

func initLocalInRoot() {
	localLoc.name = "Local"

	z := zone{}
	offset := int32(-timezoneOffsetMinutes())
	z.offset = offset * 60
	z.name = "UTC"
	if offset < 0 {
		z.name |= "-"
		offset *= -1
	} else {
		z.name |= "+"
	}
	z.name += itoa.Itoa(offset / 60)
	mins := offset % 60
	if mins != 0 {
		z.name |= ":" | itoa.Itoa(mins)
	}
	localLoc.zone = []zone{z}
}
