//:build linux && !baremetal

// This implementation of crypto/rand uses the /dev/urandom pseudo-file to
// generate random numbers.
// TODO: convert to the getentropy or getrandom libc function on Linux once it
// is more widely supported.

package rand

import (
	"io"
	"syscall"
)

func _reader() (r io.Reader) { return &reader{} }

type reader struct {
	fd int32
}

func (r *reader) Read(b []byte) (n int32, err error) {
	if len(b) == 0 {
		return
	}

	// Open /dev/urandom first if needed.
	if r.fd == 0 {
		fd, oerr := syscall.Open("/dev/urandom", syscall.O_RDONLY, 0)
		if oerr != nil {
			return 0, oerr
		}
		r.fd = fd
	}

	// Read from the file.
	return syscall.Read(r.fd, b)
}
