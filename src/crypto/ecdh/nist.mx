package ecdh

import (
	"bytes"
	"crypto/internal/boring"
	"crypto/internal/fips140/ecdh"
	"crypto/internal/fips140only"
	"errors"
	"io"
)

type curveID uint8

const (
	curveP256 curveID = iota
	curveP384
	curveP521
)

type nistCurve struct {
	id curveID
}

func (c nistCurve) String() string {
	switch c.id {
	case curveP256:
		return "P-256"
	case curveP384:
		return "P-384"
	case curveP521:
		return "P-521"
	}
	return ""
}

func (c nistCurve) boringName() []byte {
	switch c.id {
	case curveP256:
		return "P-256"
	case curveP384:
		return "P-384"
	case curveP521:
		return "P-521"
	}
	return ""
}

func (c nistCurve) fipsGenerateKey(rand io.Reader) (*ecdh.PrivateKey, error) {
	switch c.id {
	case curveP256:
		return ecdh.GenerateKey(ecdh.P256(), rand)
	case curveP384:
		return ecdh.GenerateKey(ecdh.P384(), rand)
	case curveP521:
		return ecdh.GenerateKey(ecdh.P521(), rand)
	}
	return nil, errors.New("crypto/ecdh: unknown curve")
}

func (c nistCurve) fipsNewPrivateKey(key []byte) (*ecdh.PrivateKey, error) {
	switch c.id {
	case curveP256:
		return ecdh.NewPrivateKey(ecdh.P256(), key)
	case curveP384:
		return ecdh.NewPrivateKey(ecdh.P384(), key)
	case curveP521:
		return ecdh.NewPrivateKey(ecdh.P521(), key)
	}
	return nil, errors.New("crypto/ecdh: unknown curve")
}

func (c nistCurve) fipsNewPublicKey(key []byte) (*ecdh.PublicKey, error) {
	switch c.id {
	case curveP256:
		return ecdh.NewPublicKey(ecdh.P256(), key)
	case curveP384:
		return ecdh.NewPublicKey(ecdh.P384(), key)
	case curveP521:
		return ecdh.NewPublicKey(ecdh.P521(), key)
	}
	return nil, errors.New("crypto/ecdh: unknown curve")
}

func (c nistCurve) fipsECDH(priv *ecdh.PrivateKey, pub *ecdh.PublicKey) ([]byte, error) {
	switch c.id {
	case curveP256:
		return ecdh.ECDH(ecdh.P256(), priv, pub)
	case curveP384:
		return ecdh.ECDH(ecdh.P384(), priv, pub)
	case curveP521:
		return ecdh.ECDH(ecdh.P521(), priv, pub)
	}
	return nil, errors.New("crypto/ecdh: unknown curve")
}

func (c nistCurve) GenerateKey(rand io.Reader) (*PrivateKey, error) {
	name := c.boringName()
	if boring.Enabled && rand == boring.RandReader {
		key, keyBytes, err := boring.GenerateKeyECDH(name)
		if err != nil {
			return nil, err
		}
		pub, err := key.PublicKey()
		if err != nil {
			return nil, err
		}
		k := &PrivateKey{
			curve:      c,
			privateKey: keyBytes,
			publicKey:  &PublicKey{curve: c, publicKey: pub.Bytes(), boring: pub},
			boring:     key,
		}
		return k, nil
	}

	if fips140only.Enabled && !fips140only.ApprovedRandomReader(rand) {
		return nil, errors.New("crypto/ecdh: only crypto/rand.Reader is allowed in FIPS 140-only mode")
	}

	privateKey, kerr := c.fipsGenerateKey(rand)
	if kerr != nil {
		return nil, kerr
	}

	priv := &PrivateKey{
		curve:      c,
		privateKey: privateKey.Bytes(),
		fips:       privateKey,
		publicKey: &PublicKey{
			curve:     c,
			publicKey: privateKey.PublicKey().Bytes(),
			fips:      privateKey.PublicKey(),
		},
	}
	if boring.Enabled {
		bk, err := boring.NewPrivateKeyECDH(name, priv.privateKey)
		if err != nil {
			return nil, err
		}
		pub, err := bk.PublicKey()
		if err != nil {
			return nil, err
		}
		priv.boring = bk
		priv.publicKey.boring = pub
	}
	return priv, nil
}

func (c nistCurve) NewPrivateKey(key []byte) (*PrivateKey, error) {
	name := c.boringName()
	if boring.Enabled {
		bk, err := boring.NewPrivateKeyECDH(name, key)
		if err != nil {
			return nil, errors.New("crypto/ecdh: invalid private key")
		}
		pub, err := bk.PublicKey()
		if err != nil {
			return nil, errors.New("crypto/ecdh: invalid private key")
		}
		k := &PrivateKey{
			curve:      c,
			privateKey: bytes.Clone(key),
			publicKey:  &PublicKey{curve: c, publicKey: pub.Bytes(), boring: pub},
			boring:     bk,
		}
		return k, nil
	}

	fk, kerr := c.fipsNewPrivateKey(key)
	if kerr != nil {
		return nil, kerr
	}
	priv := &PrivateKey{
		curve:      c,
		privateKey: bytes.Clone(key),
		fips:       fk,
		publicKey: &PublicKey{
			curve:     c,
			publicKey: fk.PublicKey().Bytes(),
			fips:      fk.PublicKey(),
		},
	}
	return priv, nil
}

func (c nistCurve) NewPublicKey(key []byte) (*PublicKey, error) {
	if len(key) == 0 || key[0] != 4 {
		return nil, errors.New("crypto/ecdh: invalid public key")
	}
	k := &PublicKey{
		curve:     c,
		publicKey: bytes.Clone(key),
	}
	if boring.Enabled {
		bk, err := boring.NewPublicKeyECDH(c.boringName(), k.publicKey)
		if err != nil {
			return nil, errors.New("crypto/ecdh: invalid public key")
		}
		k.boring = bk
	} else {
		fk, err := c.fipsNewPublicKey(key)
		if err != nil {
			return nil, err
		}
		k.fips = fk
	}
	return k, nil
}

func (c nistCurve) ecdh(local *PrivateKey, remote *PublicKey) ([]byte, error) {
	if boring.Enabled {
		return boring.ECDH(local.boring, remote.boring)
	}
	return c.fipsECDH(local.fips, remote.fips)
}

// P256 returns a [Curve] which implements NIST P-256 (FIPS 186-3, section D.2.3),
// also known as secp256r1 or prime256v1.
func P256() Curve { return nistCurve{curveP256} }

// P384 returns a [Curve] which implements NIST P-384 (FIPS 186-3, section D.2.4),
// also known as secp384r1.
func P384() Curve { return nistCurve{curveP384} }

// P521 returns a [Curve] which implements NIST P-521 (FIPS 186-3, section D.2.5),
// also known as secp521r1.
func P521() Curve { return nistCurve{curveP521} }
