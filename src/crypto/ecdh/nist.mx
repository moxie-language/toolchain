package ecdh

import (
	"bytes"
	"crypto/internal/fips140/ecdh"
	"crypto/internal/fips140only"
	"errors"
	"io"
)

type curveID uint8

const (
	curveP256 curveID = iota
	curveP384
	curveP521
)

// The three NIST curves are singletons, built in init(): ECDH compares the
// Curve an interface holds (PrivateKey.ECDH: `k.curve != remote.curve`), which
// is a pointer comparison, so a fresh &nistCurve per P256() call makes every
// key its own curve and every exchange fail with "curves do not match".
var (
	p256Curve *nistCurve
	p384Curve *nistCurve
	p521Curve *nistCurve
)

func init() {
	p256Curve = &nistCurve{curveP256}
	p384Curve = &nistCurve{curveP384}
	p521Curve = &nistCurve{curveP521}
	x25519 = &x25519Curve{}
}

type nistCurve struct {
	id curveID
}

func (c *nistCurve) String() (s string) {
	switch c.id {
	case curveP256:
		return "P-256"
	case curveP384:
		return "P-384"
	case curveP521:
		return "P-521"
	}
	return ""
}

func (c *nistCurve) fipsGenerateKey(rand io.Reader) (out *ecdh.PrivateKey, derr error) {
	switch c.id {
	case curveP256:
		return ecdh.GenerateKey(ecdh.P256(), rand)
	case curveP384:
		return ecdh.GenerateKey(ecdh.P384(), rand)
	case curveP521:
		return ecdh.GenerateKey(ecdh.P521(), rand)
	}
	return nil, errors.New("crypto/ecdh: unknown curve")
}

func (c *nistCurve) fipsNewPrivateKey(key []byte) (out *ecdh.PrivateKey, derr error) {
	switch c.id {
	case curveP256:
		return ecdh.NewPrivateKey(ecdh.P256(), key)
	case curveP384:
		return ecdh.NewPrivateKey(ecdh.P384(), key)
	case curveP521:
		return ecdh.NewPrivateKey(ecdh.P521(), key)
	}
	return nil, errors.New("crypto/ecdh: unknown curve")
}

func (c *nistCurve) fipsNewPublicKey(key []byte) (out *ecdh.PublicKey, derr error) {
	switch c.id {
	case curveP256:
		return ecdh.NewPublicKey(ecdh.P256(), key)
	case curveP384:
		return ecdh.NewPublicKey(ecdh.P384(), key)
	case curveP521:
		return ecdh.NewPublicKey(ecdh.P521(), key)
	}
	return nil, errors.New("crypto/ecdh: unknown curve")
}

func (c *nistCurve) fipsECDH(priv *ecdh.PrivateKey, pub *ecdh.PublicKey) (b []byte, derr error) {
	switch c.id {
	case curveP256:
		return ecdh.ECDH(ecdh.P256(), priv, pub)
	case curveP384:
		return ecdh.ECDH(ecdh.P384(), priv, pub)
	case curveP521:
		return ecdh.ECDH(ecdh.P521(), priv, pub)
	}
	return nil, errors.New("crypto/ecdh: unknown curve")
}

func (c *nistCurve) GenerateKey(rand io.Reader) (out *PrivateKey, derr error) {
	if fips140only.Enabled && !fips140only.ApprovedRandomReader(rand) {
		return nil, errors.New("crypto/ecdh: only crypto/rand.Reader is allowed in FIPS 140-only mode")
	}

	privateKey, kerr := c.fipsGenerateKey(rand)
	if kerr != nil {
		return nil, kerr
	}

	priv := &PrivateKey{
		curve:      c,
		privateKey: privateKey.Bytes(),
		fips:       privateKey,
		publicKey: &PublicKey{
			curve:     c,
			publicKey: privateKey.PublicKey().Bytes(),
			fips:      privateKey.PublicKey(),
		},
	}
	return priv, nil
}

func (c *nistCurve) NewPrivateKey(key []byte) (out *PrivateKey, derr error) {
	fk, kerr := c.fipsNewPrivateKey(key)
	if kerr != nil {
		return nil, kerr
	}
	priv := &PrivateKey{
		curve:      c,
		privateKey: bytes.Clone(key),
		fips:       fk,
		publicKey: &PublicKey{
			curve:     c,
			publicKey: fk.PublicKey().Bytes(),
			fips:      fk.PublicKey(),
		},
	}
	return priv, nil
}

func (c *nistCurve) NewPublicKey(key []byte) (out *PublicKey, derr error) {
	if len(key) == 0 || key[0] != 4 {
		return nil, errors.New("crypto/ecdh: invalid public key")
	}
	k := &PublicKey{
		curve:     c,
		publicKey: bytes.Clone(key),
	}
	fk, err := c.fipsNewPublicKey(key)
	if err != nil {
		return nil, err
	}
	k.fips = fk
	return k, nil
}

func (c *nistCurve) ecdh(local *PrivateKey, remote *PublicKey) (b []byte, derr error) {
	return c.fipsECDH(local.fips, remote.fips)
}

// P256 returns a [Curve] which implements NIST P-256 (FIPS 186-3, section D.2.3),
// also known as secp256r1 or prime256v1.
func P256() (out Curve) { return p256Curve }

// P384 returns a [Curve] which implements NIST P-384 (FIPS 186-3, section D.2.4),
// also known as secp384r1.
func P384() (out Curve) { return p384Curve }

// P521 returns a [Curve] which implements NIST P-521 (FIPS 186-3, section D.2.5),
// also known as secp521r1.
func P521() (out Curve) { return p521Curve }
