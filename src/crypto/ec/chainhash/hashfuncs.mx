package chainhash

import (
	"crypto/sha256"
)

// HashB calculates hash(b) and returns the resulting bytes.
func HashB(b []byte) (buf []byte) {
	return sha256.Sum256(b)
}

// HashH calculates hash(b) and returns the resulting bytes as a Hash.
func HashH(b []byte) (out Hash) { return hashOf(sha256.Sum256(b)) }

// DoubleHashB calculates hash(hash(b)) and returns the resulting bytes.
func DoubleHashB(b []byte) (buf []byte) {
	return sha256.Sum256(sha256.Sum256(b))
}

// DoubleHashH calculates hash(hash(b)) and returns the resulting bytes as a
// Hash.
func DoubleHashH(b []byte) (out Hash) {
	return hashOf(sha256.Sum256(sha256.Sum256(b)))
}
