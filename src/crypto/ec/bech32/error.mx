package bech32

import (
	"fmt"
)

// ErrMixedCase is returned when the bech32 string has both lower and uppercase
// characters.
type ErrMixedCase struct{}

func (err *ErrMixedCase) Error() (msg string) {
	return "string not all lowercase or all uppercase"
}

func (err *ErrMixedCase) String() (msg string) { return err.Error() }

// ErrInvalidBitGroups is returned when conversion is attempted between byte
// slices using bit-per-element of unsupported value.
type ErrInvalidBitGroups struct{}

func (err *ErrInvalidBitGroups) Error() (msg string) {
	return "only bit groups between 1 and 8 allowed"
}

func (err *ErrInvalidBitGroups) String() (msg string) { return err.Error() }

// ErrInvalidIncompleteGroup is returned when then byte slice used as input has
// data of wrong length.
type ErrInvalidIncompleteGroup struct{}

func (err *ErrInvalidIncompleteGroup) Error() (msg string) {
	return "invalid incomplete group"
}

func (err *ErrInvalidIncompleteGroup) String() (msg string) { return err.Error() }

// ErrInvalidLength is returned when the bech32 string has an invalid length
// given the BIP-173 defined restrictions.
type ErrInvalidLength int32

func (err *ErrInvalidLength) Error() (msg string) {
	return string(push([]byte(nil), fmt.Sprintf("invalid bech32 string length %d", int32(*err))...))
}

func (err *ErrInvalidLength) String() (msg string) { return err.Error() }

// ErrInvalidCharacter is returned when the bech32 string has a character
// outside the range of the supported charset.
type ErrInvalidCharacter rune

func (err *ErrInvalidCharacter) Error() (msg string) {
	return string(push([]byte(nil), fmt.Sprintf("invalid character in string: '%c'", rune(*err))...))
}

func (err *ErrInvalidCharacter) String() (msg string) { return err.Error() }

// ErrInvalidSeparatorIndex is returned when the separator character '1' is
// in an invalid position in the bech32 string.
type ErrInvalidSeparatorIndex int32

func (err *ErrInvalidSeparatorIndex) Error() (msg string) {
	return string(push([]byte(nil), fmt.Sprintf("invalid separator index %d", int32(*err))...))
}

func (err *ErrInvalidSeparatorIndex) String() (msg string) { return err.Error() }

// ErrNonCharsetChar is returned when a character outside of the specific
// bech32 charset is used in the string.
type ErrNonCharsetChar rune

func (err *ErrNonCharsetChar) Error() (msg string) {
	return string(push([]byte(nil), fmt.Sprintf("invalid character not part of charset: %v", int32(*err))...))
}

func (err *ErrNonCharsetChar) String() (msg string) { return err.Error() }

// ErrInvalidChecksum is returned when the extracted checksum of the string
// is different than what was expected. Both the original version, as well as
// the new bech32m checksum may be specified.
type ErrInvalidChecksum struct {
	Expected  string
	ExpectedM string
	Actual    string
}

func (err *ErrInvalidChecksum) Error() (msg string) {
	return string(push([]byte(nil), fmt.Sprintf(
		"invalid checksum (expected (bech32=%v, "+
			"bech32m=%v), got %v)", err.Expected, err.ExpectedM, err.Actual)...))
}

func (err *ErrInvalidChecksum) String() (msg string) { return err.Error() }

// ErrInvalidDataByte is returned when a byte outside the range required for
// conversion into a string was found.
type ErrInvalidDataByte byte

func (err *ErrInvalidDataByte) Error() (msg string) {
	return string(push([]byte(nil), fmt.Sprintf("invalid data byte: %v", byte(*err))...))
}

func (err *ErrInvalidDataByte) String() (msg string) { return err.Error() }
