package tls

import (
	"slices"
)

// Defaults are collected in this file to allow distributions to more easily patch
// them to apply local policies.

// defaultCurvePreferences is the default set of supported key exchanges, as
// well as the preference order.
// defaultCurvePreferencesTable is allocated once at package init in the root arena: a
// slice literal inside a function is an allocation on that function's
// code path.
var defaultCurvePreferencesTable = []CurveID{
		X25519MLKEM768, SecP256r1MLKEM768, SecP384r1MLKEM1024,
		X25519, CurveP256, CurveP384, CurveP521,
	}

func defaultCurvePreferences() (rcurveID []CurveID) { return defaultCurvePreferencesTable }

// defaultSupportedSignatureAlgorithms returns the signature and hash algorithms that
// the code advertises and supports in a TLS 1.2+ ClientHello and in a TLS 1.2+
// CertificateRequest. The two fields are merged to match with TLS 1.3.
// Note that in TLS 1.2, the ECDSA algorithms are not constrained to P-256, etc.
func defaultSupportedSignatureAlgorithms() (rsignatureScheme []SignatureScheme) {
	return []SignatureScheme{
		PSSWithSHA256,
		ECDSAWithP256AndSHA256,
		Ed25519,
		PSSWithSHA384,
		PSSWithSHA512,
		PKCS1WithSHA256,
		PKCS1WithSHA384,
		PKCS1WithSHA512,
		ECDSAWithP384AndSHA384,
		ECDSAWithP521AndSHA512,
		PKCS1WithSHA1,
		ECDSAWithSHA1,
	}
}

func supportedCipherSuites(aesGCMPreferred bool) (ruint16 []uint16) {
	if aesGCMPreferred {
		return slices.Clone(_cipherSuitesPreferenceOrder())
	} else {
		return slices.Clone(_cipherSuitesPreferenceOrderNoAES())
	}
}

func defaultCipherSuites(aesGCMPreferred bool) (ruint16 []uint16) {
	cipherSuites := supportedCipherSuites(aesGCMPreferred)
	disabled := _disabledCipherSuites()
	rsaKex := _rsaKexCiphers()
	tdes := _tdesCiphers()
	// Length, not capacity: the loop below writes filtered[n] by index, and an
	// index must be below len. []uint16{:0:cap} is the shape for a slice that
	// is filled with push; this one is filled by index and truncated at the end.
	filtered := []uint16{:len(cipherSuites)}
	n := int32(0)
	for _, cs := range cipherSuites {
		if !(disabled[cs] || rsaKex[cs] || tdes[cs]) {
			filtered[n] = cs
			n++
		}
	}
	return filtered[:n]
}

// _defaultCipherSuitesTLS13 is also the preference order, since there are no
// disabled by default TLS 1.3 cipher suites. The same AES vs ChaCha20 logic as
// cipherSuitesPreferenceOrder applies.
func _defaultCipherSuitesTLS13() (ruint16 []uint16) {
	return []uint16{
		TLS_AES_128_GCM_SHA256,
		TLS_AES_256_GCM_SHA384,
		TLS_CHACHA20_POLY1305_SHA256,
	}
}

func _defaultCipherSuitesTLS13NoAES() (ruint16 []uint16) {
	return []uint16{
		TLS_CHACHA20_POLY1305_SHA256,
		TLS_AES_128_GCM_SHA256,
		TLS_AES_256_GCM_SHA384,
	}
}
