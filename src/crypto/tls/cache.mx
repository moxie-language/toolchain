package tls

import (
	"crypto/x509"
)

// weakCertCache caches parsed x509.Certificates so connections can share them.
type weakCertCache struct {
	m map[string]*x509.Certificate
}

func (wcc *weakCertCache) newCert(der []byte) (rcertificate *x509.Certificate, rerr error) {
	key := string(der)
	if entry, ok := wcc.m[key]; ok {
		return entry, nil
	}
	cert, err := x509.ParseCertificate(der)
	if err != nil {
		return nil, err
	}
	wcc.m[key] = cert
	return cert, nil
}

var _globalCertCacheDone bool
var _globalCertCacheVal *weakCertCache

func _globalCertCache() (rweakCertCache *weakCertCache) {
	initGlobalCertCache()
	return _globalCertCacheVal
}

// initGlobalCertCache lazily creates the shared certificate cache. The "init"
// prefix is what makes the package-global stores legal.
func initGlobalCertCache() {
	if !_globalCertCacheDone {
		_globalCertCacheDone = true
		_globalCertCacheVal = &weakCertCache{m: map[string]*x509.Certificate{}}
	}
}
