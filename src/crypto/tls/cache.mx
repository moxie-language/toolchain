package tls

import (
	"crypto/x509"
)

// weakCertCache caches parsed x509.Certificates so connections can share them.
type weakCertCache struct {
	m map[string]*x509.Certificate
}

func (wcc *weakCertCache) newCert(der []byte) (*x509.Certificate, error) {
	key := string(der)
	if entry, ok := wcc.m[key]; ok {
		return entry, nil
	}
	cert, err := x509.ParseCertificate(der)
	if err != nil {
		return nil, err
	}
	wcc.m[key] = cert
	return cert, nil
}

var _globalCertCacheDone bool
var _globalCertCacheVal *weakCertCache

func _globalCertCache() *weakCertCache {
	if !_globalCertCacheDone {
		_globalCertCacheDone = true
		_globalCertCacheVal = &weakCertCache{m: map[string]*x509.Certificate{}}
	}
	return _globalCertCacheVal
}
