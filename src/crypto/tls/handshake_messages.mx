package tls

import (
	"github.com/moxie-language/toolchain/pkg/mxutil"
	"errors"
	"fmt"
	"slices"
	"bytes"

	"golang.org/x/crypto/cryptobyte"
)

// addBytesWithLength appends a sequence of bytes to the cryptobyte.Builder. If
// the length of the sequence is not the value specified, it produces an error.
func addBytesWithLength(b *cryptobyte.Builder, v []byte, n int32) {
	if int32(len(v)) != n {
		b.SetError(fmt.Errorf("invalid value length: expected %d, got %d", n, len(v)))
		return
	}
	b.AddBytes(v)
}

// addUint64 appends a big-endian, 64-bit value to the cryptobyte.Builder.
func addUint64(b *cryptobyte.Builder, v uint64) {
	b.AddUint32(uint32(v >> 32))
	b.AddUint32(uint32(v))
}

// readUint64 decodes a big-endian, 64-bit value into out and advances over it.
// It reports whether the read was successful.
func readUint64(s *cryptobyte.String, out *uint64) (rok bool) {
	var hi, lo uint32
	if !s.ReadUint32(&hi) || !s.ReadUint32(&lo) {
		return false
	}
	*out = uint64(hi)<<32 | uint64(lo)
	return true
}

// readUint8LengthPrefixed acts like s.ReadUint8LengthPrefixed, but targets a
// []byte instead of a cryptobyte.String.
func readUint8LengthPrefixed(s *cryptobyte.String, out *[]byte) (rok bool) {
	return s.ReadUint8LengthPrefixed((*cryptobyte.String)(out))
}

// readUint16LengthPrefixed acts like s.ReadUint16LengthPrefixed, but targets a
// []byte instead of a cryptobyte.String.
func readUint16LengthPrefixed(s *cryptobyte.String, out *[]byte) (rok bool) {
	return s.ReadUint16LengthPrefixed((*cryptobyte.String)(out))
}

// readUint24LengthPrefixed acts like s.ReadUint24LengthPrefixed, but targets a
// []byte instead of a cryptobyte.String.
func readUint24LengthPrefixed(s *cryptobyte.String, out *[]byte) (rok bool) {
	return s.ReadUint24LengthPrefixed((*cryptobyte.String)(out))
}

type clientHelloMsg struct {
	original                         []byte
	vers                             uint16
	random                           []byte
	sessionId                        []byte
	cipherSuites                     []uint16
	compressionMethods               []uint8
	serverName                       []byte
	ocspStapling                     bool
	supportedCurves                  []CurveID
	supportedPoints                  []uint8
	ticketSupported                  bool
	sessionTicket                    []uint8
	supportedSignatureAlgorithms     []SignatureScheme
	supportedSignatureAlgorithmsCert []SignatureScheme
	secureRenegotiationSupported     bool
	secureRenegotiation              []byte
	extendedMasterSecret             bool
	alpnProtocols                    [][]byte
	scts                             bool
	supportedVersions                []uint16
	cookie                           []byte
	keyShares                        []keyShare
	earlyData                        bool
	pskModes                         []uint8
	pskIdentities                    []pskIdentity
	pskBinders                       [][]byte
	quicTransportParameters          []byte
	encryptedClientHello             []byte
	// extensions are only populated on the server-side of a handshake
	extensions []uint16
}

func (m *clientHelloMsg) marshalMsg(echInner bool) (rb []byte, rerr error) {
	var exts cryptobyte.Builder
	if len(m.serverName) > 0 {
		// RFC 6066, Section 3
		exts.AddUint16(extensionServerName)
		exts.BeginUint16LengthPrefixed()
			exts.BeginUint16LengthPrefixed()
				exts.AddUint8(0) // name_type = host_name
				exts.BeginUint16LengthPrefixed()
					exts.AddBytes([]byte(m.serverName))
				exts.EndLengthPrefixed()
			exts.EndLengthPrefixed()
		exts.EndLengthPrefixed()
	}
	if len(m.supportedPoints) > 0 && !echInner {
		// RFC 4492, Section 5.1.2
		exts.AddUint16(extensionSupportedPoints)
		exts.BeginUint16LengthPrefixed()
			exts.BeginUint8LengthPrefixed()
				exts.AddBytes(m.supportedPoints)
			exts.EndLengthPrefixed()
		exts.EndLengthPrefixed()
	}
	if m.ticketSupported && !echInner {
		// RFC 5077, Section 3.2
		exts.AddUint16(extensionSessionTicket)
		exts.BeginUint16LengthPrefixed()
			exts.AddBytes(m.sessionTicket)
		exts.EndLengthPrefixed()
	}
	if m.secureRenegotiationSupported && !echInner {
		// RFC 5746, Section 3.2
		exts.AddUint16(extensionRenegotiationInfo)
		exts.BeginUint16LengthPrefixed()
			exts.BeginUint8LengthPrefixed()
				exts.AddBytes(m.secureRenegotiation)
			exts.EndLengthPrefixed()
		exts.EndLengthPrefixed()
	}
	if m.extendedMasterSecret && !echInner {
		// RFC 7627
		exts.AddUint16(extensionExtendedMasterSecret)
		exts.AddUint16(0) // empty extension_data
	}
	if m.scts {
		// RFC 6962, Section 3.3.1
		exts.AddUint16(extensionSCT)
		exts.AddUint16(0) // empty extension_data
	}
	if m.earlyData {
		// RFC 8446, Section 4.2.10
		exts.AddUint16(extensionEarlyData)
		exts.AddUint16(0) // empty extension_data
	}
	if m.quicTransportParameters != nil { // marshal zero-length parameters when present
		// RFC 9001, Section 8.2
		exts.AddUint16(extensionQUICTransportParameters)
		exts.BeginUint16LengthPrefixed()
			exts.AddBytes(m.quicTransportParameters)
		exts.EndLengthPrefixed()
	}
	if len(m.encryptedClientHello) > 0 {
		exts.AddUint16(extensionEncryptedClientHello)
		exts.BeginUint16LengthPrefixed()
			exts.AddBytes(m.encryptedClientHello)
		exts.EndLengthPrefixed()
	}
	// Note that any extension that can be compressed during ECH must be
	// contiguous. If any additional extensions are to be compressed they must
	// be added to the following block, so that they can be properly
	// decompressed on the other side.
	var echOuterExts []uint16
	if m.ocspStapling {
		// RFC 4366, Section 3.6
		if echInner {
			echOuterExts = mxutil.Ensure(echOuterExts, 1)
			echOuterExts = push(echOuterExts, extensionStatusRequest)
		} else {
			exts.AddUint16(extensionStatusRequest)
			exts.BeginUint16LengthPrefixed()
				exts.AddUint8(1)  // status_type = ocsp
				exts.AddUint16(0) // empty responder_id_list
				exts.AddUint16(0) // empty request_extensions
			exts.EndLengthPrefixed()
		}
	}
	if len(m.supportedCurves) > 0 {
		// RFC 4492, sections 5.1.1 and RFC 8446, Section 4.2.7
		if echInner {
			echOuterExts = mxutil.Ensure(echOuterExts, 1)
			echOuterExts = push(echOuterExts, extensionSupportedCurves)
		} else {
			exts.AddUint16(extensionSupportedCurves)
			exts.BeginUint16LengthPrefixed()
				exts.BeginUint16LengthPrefixed()
					for _, curve := range m.supportedCurves {
						exts.AddUint16(uint16(curve))
					}
				exts.EndLengthPrefixed()
			exts.EndLengthPrefixed()
		}
	}
	if len(m.supportedSignatureAlgorithms) > 0 {
		// RFC 5246, Section 7.4.1.4.1
		if echInner {
			echOuterExts = mxutil.Ensure(echOuterExts, 1)
			echOuterExts = push(echOuterExts, extensionSignatureAlgorithms)
		} else {
			exts.AddUint16(extensionSignatureAlgorithms)
			exts.BeginUint16LengthPrefixed()
				exts.BeginUint16LengthPrefixed()
					for _, sigAlgo := range m.supportedSignatureAlgorithms {
						exts.AddUint16(uint16(sigAlgo))
					}
				exts.EndLengthPrefixed()
			exts.EndLengthPrefixed()
		}
	}
	if len(m.supportedSignatureAlgorithmsCert) > 0 {
		// RFC 8446, Section 4.2.3
		if echInner {
			echOuterExts = mxutil.Ensure(echOuterExts, 1)
			echOuterExts = push(echOuterExts, extensionSignatureAlgorithmsCert)
		} else {
			exts.AddUint16(extensionSignatureAlgorithmsCert)
			exts.BeginUint16LengthPrefixed()
				exts.BeginUint16LengthPrefixed()
					for _, sigAlgo := range m.supportedSignatureAlgorithmsCert {
						exts.AddUint16(uint16(sigAlgo))
					}
				exts.EndLengthPrefixed()
			exts.EndLengthPrefixed()
		}
	}
	if len(m.alpnProtocols) > 0 {
		// RFC 7301, Section 3.1
		if echInner {
			echOuterExts = mxutil.Ensure(echOuterExts, 1)
			echOuterExts = push(echOuterExts, extensionALPN)
		} else {
			exts.AddUint16(extensionALPN)
			exts.BeginUint16LengthPrefixed()
				exts.BeginUint16LengthPrefixed()
					for _, proto := range m.alpnProtocols {
						exts.BeginUint8LengthPrefixed()
							exts.AddBytes([]byte(proto))
						exts.EndLengthPrefixed()
					}
				exts.EndLengthPrefixed()
			exts.EndLengthPrefixed()
		}
	}
	if len(m.supportedVersions) > 0 {
		// RFC 8446, Section 4.2.1
		if echInner {
			echOuterExts = mxutil.Ensure(echOuterExts, 1)
			echOuterExts = push(echOuterExts, extensionSupportedVersions)
		} else {
			exts.AddUint16(extensionSupportedVersions)
			exts.BeginUint16LengthPrefixed()
				exts.BeginUint8LengthPrefixed()
					for _, vers := range m.supportedVersions {
						exts.AddUint16(vers)
					}
				exts.EndLengthPrefixed()
			exts.EndLengthPrefixed()
		}
	}
	if len(m.cookie) > 0 {
		// RFC 8446, Section 4.2.2
		if echInner {
			echOuterExts = mxutil.Ensure(echOuterExts, 1)
			echOuterExts = push(echOuterExts, extensionCookie)
		} else {
			exts.AddUint16(extensionCookie)
			exts.BeginUint16LengthPrefixed()
				exts.BeginUint16LengthPrefixed()
					exts.AddBytes(m.cookie)
				exts.EndLengthPrefixed()
			exts.EndLengthPrefixed()
		}
	}
	if len(m.keyShares) > 0 {
		// RFC 8446, Section 4.2.8
		if echInner {
			echOuterExts = mxutil.Ensure(echOuterExts, 1)
			echOuterExts = push(echOuterExts, extensionKeyShare)
		} else {
			exts.AddUint16(extensionKeyShare)
			exts.BeginUint16LengthPrefixed()
				exts.BeginUint16LengthPrefixed()
					for _, ks := range m.keyShares {
						exts.AddUint16(uint16(ks.group))
						exts.BeginUint16LengthPrefixed()
							exts.AddBytes(ks.data)
						exts.EndLengthPrefixed()
					}
				exts.EndLengthPrefixed()
			exts.EndLengthPrefixed()
		}
	}
	if len(m.pskModes) > 0 {
		// RFC 8446, Section 4.2.9
		if echInner {
			echOuterExts = mxutil.Ensure(echOuterExts, 1)
			echOuterExts = push(echOuterExts, extensionPSKModes)
		} else {
			exts.AddUint16(extensionPSKModes)
			exts.BeginUint16LengthPrefixed()
				exts.BeginUint8LengthPrefixed()
					exts.AddBytes(m.pskModes)
				exts.EndLengthPrefixed()
			exts.EndLengthPrefixed()
		}
	}
	if len(echOuterExts) > 0 && echInner {
		exts.AddUint16(extensionECHOuterExtensions)
		exts.BeginUint16LengthPrefixed()
			exts.BeginUint8LengthPrefixed()
				for _, e := range echOuterExts {
					exts.AddUint16(e)
				}
			exts.EndLengthPrefixed()
		exts.EndLengthPrefixed()
	}
	if len(m.pskIdentities) > 0 { // pre_shared_key must be the last extension
		// RFC 8446, Section 4.2.11
		exts.AddUint16(extensionPreSharedKey)
		exts.BeginUint16LengthPrefixed()
			exts.BeginUint16LengthPrefixed()
				for _, psk := range m.pskIdentities {
					exts.BeginUint16LengthPrefixed()
						exts.AddBytes(psk.label)
					exts.EndLengthPrefixed()
					exts.AddUint32(psk.obfuscatedTicketAge)
				}
			exts.EndLengthPrefixed()
			exts.BeginUint16LengthPrefixed()
				for _, binder := range m.pskBinders {
					exts.BeginUint8LengthPrefixed()
						exts.AddBytes(binder)
					exts.EndLengthPrefixed()
				}
			exts.EndLengthPrefixed()
		exts.EndLengthPrefixed()
	}
	extBytes, err := exts.Bytes()
	if err != nil {
		return nil, err
	}

	var b cryptobyte.Builder
	b.AddUint8(typeClientHello)
	b.BeginUint24LengthPrefixed()
		b.AddUint16(m.vers)
		addBytesWithLength(&b, m.random, 32)
		b.BeginUint8LengthPrefixed()
			if !echInner {
				b.AddBytes(m.sessionId)
			}
		b.EndLengthPrefixed()
		b.BeginUint16LengthPrefixed()
			for _, suite := range m.cipherSuites {
				b.AddUint16(suite)
			}
		b.EndLengthPrefixed()
		b.BeginUint8LengthPrefixed()
			b.AddBytes(m.compressionMethods)
		b.EndLengthPrefixed()

		if len(extBytes) > 0 {
			b.BeginUint16LengthPrefixed()
				b.AddBytes(extBytes)
			b.EndLengthPrefixed()
		}
	b.EndLengthPrefixed()

	return b.Bytes()
}

func (m *clientHelloMsg) marshal() (rb []byte, rerr error) {
	return m.marshalMsg(false)
}

// marshalWithoutBinders returns the ClientHello through the
// PreSharedKeyExtension.identities field, according to RFC 8446, Section
// 4.2.11.2. Note that m.pskBinders must be set to slices of the correct length.
func (m *clientHelloMsg) marshalWithoutBinders() (rb []byte, rerr error) {
	bindersLen := 2 // uint16 length prefix
	for _, binder := range m.pskBinders {
		bindersLen += 1 // uint8 length prefix
		bindersLen += len(binder)
	}

	var fullMessage []byte
	if m.original != nil {
		fullMessage = m.original
	} else {
		var err error
		fullMessage, err = m.marshal()
		if err != nil {
			return nil, err
		}
	}
	return fullMessage[:len(fullMessage)-bindersLen], nil
}

// updateBinders updates the m.pskBinders field. The supplied binders must have
// the same length as the current m.pskBinders.
func (m *clientHelloMsg) updateBinders(pskBinders [][]byte) (rerr error) {
	if len(pskBinders) != len(m.pskBinders) {
		return errors.New("tls: internal error: pskBinders length mismatch")
	}
	for i := range m.pskBinders {
		if len(pskBinders[i]) != len(m.pskBinders[i]) {
			return errors.New("tls: internal error: pskBinders length mismatch")
		}
	}
	m.pskBinders = pskBinders

	return nil
}

func (m *clientHelloMsg) unmarshal(data []byte) (rok bool) {
	*m = clientHelloMsg{original: data}
	s := cryptobyte.String(data)

	if !s.Skip(4) || // message type and uint24 length field
		!s.ReadUint16(&m.vers) || !s.ReadBytes(&m.random, 32) ||
		!readUint8LengthPrefixed(&s, &m.sessionId) {
		return false
	}

	var cipherSuites cryptobyte.String
	if !s.ReadUint16LengthPrefixed(&cipherSuites) {
		return false
	}
	m.cipherSuites = []uint16{}
	m.secureRenegotiationSupported = false
	var suite uint16
	var extension uint16
	var extData cryptobyte.String
	var nameList cryptobyte.String
	var nameType uint8
	var serverName cryptobyte.String
	var statusType uint8
	var ignored cryptobyte.String
	var curves cryptobyte.String
	var curve uint16
	var sigAndAlgs cryptobyte.String
	var sigAndAlg uint16
	var protoList cryptobyte.String
	var proto cryptobyte.String
	var versList cryptobyte.String
	var vers uint16
	var clientShares cryptobyte.String
	var ks keyShare
	var identities cryptobyte.String
	var psk pskIdentity
	var binders cryptobyte.String
	var binder []byte
	for !cipherSuites.Empty() {
		if !cipherSuites.ReadUint16(&suite) {
			return false
		}
		if suite == scsvRenegotiation {
			m.secureRenegotiationSupported = true
		}
		m.cipherSuites = mxutil.Ensure(m.cipherSuites, 1)
		m.cipherSuites = push(m.cipherSuites, suite)
	}

	if !readUint8LengthPrefixed(&s, &m.compressionMethods) {
		return false
	}

	if s.Empty() {
		// ClientHello is optionally followed by extension data
		return true
	}

	var extensions cryptobyte.String
	if !s.ReadUint16LengthPrefixed(&extensions) || !s.Empty() {
		return false
	}

	seenExts := map[uint16]bool{}
	for !extensions.Empty() {
		if !extensions.ReadUint16(&extension) ||
			!extensions.ReadUint16LengthPrefixed(&extData) {
			return false
		}

		if seenExts[extension] {
			return false
		}
		seenExts[extension] = true
		m.extensions = mxutil.Ensure(m.extensions, 1)
		m.extensions = push(m.extensions, extension)

		switch extension {
		case extensionServerName:
			// RFC 6066, Section 3
			if !extData.ReadUint16LengthPrefixed(&nameList) || nameList.Empty() {
				return false
			}
			for !nameList.Empty() {
				if !nameList.ReadUint8(&nameType) ||
					!nameList.ReadUint16LengthPrefixed(&serverName) ||
					serverName.Empty() {
					return false
				}
				if nameType != 0 {
					continue
				}
				if len(m.serverName) != 0 {
					// Multiple names of the same name_type are prohibited.
					return false
				}
				m.serverName = []byte(serverName)
				// An SNI value may not include a trailing dot.
				if bytes.HasSuffix(m.serverName, ".") {
					return false
				}
			}
		case extensionStatusRequest:
			// RFC 4366, Section 3.6
			if !extData.ReadUint8(&statusType) ||
				!extData.ReadUint16LengthPrefixed(&ignored) ||
				!extData.ReadUint16LengthPrefixed(&ignored) {
				return false
			}
			m.ocspStapling = statusType == statusTypeOCSP
		case extensionSupportedCurves:
			// RFC 4492, sections 5.1.1 and RFC 8446, Section 4.2.7
			if !extData.ReadUint16LengthPrefixed(&curves) || curves.Empty() {
				return false
			}
			for !curves.Empty() {
				if !curves.ReadUint16(&curve) {
					return false
				}
				m.supportedCurves = mxutil.Ensure(m.supportedCurves, 1)
				m.supportedCurves = push(m.supportedCurves, CurveID(curve))
			}
		case extensionSupportedPoints:
			// RFC 4492, Section 5.1.2
			if !readUint8LengthPrefixed(&extData, &m.supportedPoints) ||
				len(m.supportedPoints) == 0 {
				return false
			}
		case extensionSessionTicket:
			// RFC 5077, Section 3.2
			m.ticketSupported = true
			extData.ReadBytes(&m.sessionTicket, len(extData))
		case extensionSignatureAlgorithms:
			// RFC 5246, Section 7.4.1.4.1
			if !extData.ReadUint16LengthPrefixed(&sigAndAlgs) || sigAndAlgs.Empty() {
				return false
			}
			for !sigAndAlgs.Empty() {
				if !sigAndAlgs.ReadUint16(&sigAndAlg) {
					return false
				}
				m.supportedSignatureAlgorithms = push(
					m.supportedSignatureAlgorithms, SignatureScheme(sigAndAlg))
			}
		case extensionSignatureAlgorithmsCert:
			// RFC 8446, Section 4.2.3
			if !extData.ReadUint16LengthPrefixed(&sigAndAlgs) || sigAndAlgs.Empty() {
				return false
			}
			for !sigAndAlgs.Empty() {
				if !sigAndAlgs.ReadUint16(&sigAndAlg) {
					return false
				}
				m.supportedSignatureAlgorithmsCert = push(
					m.supportedSignatureAlgorithmsCert, SignatureScheme(sigAndAlg))
			}
		case extensionRenegotiationInfo:
			// RFC 5746, Section 3.2
			if !readUint8LengthPrefixed(&extData, &m.secureRenegotiation) {
				return false
			}
			m.secureRenegotiationSupported = true
		case extensionExtendedMasterSecret:
			// RFC 7627
			m.extendedMasterSecret = true
		case extensionALPN:
			// RFC 7301, Section 3.1
			if !extData.ReadUint16LengthPrefixed(&protoList) || protoList.Empty() {
				return false
			}
			for !protoList.Empty() {
				if !protoList.ReadUint8LengthPrefixed(&proto) || proto.Empty() {
					return false
				}
				m.alpnProtocols = mxutil.Ensure(m.alpnProtocols, 1)
				m.alpnProtocols = push(m.alpnProtocols, []byte(proto))
			}
		case extensionSCT:
			// RFC 6962, Section 3.3.1
			m.scts = true
		case extensionSupportedVersions:
			// RFC 8446, Section 4.2.1
			if !extData.ReadUint8LengthPrefixed(&versList) || versList.Empty() {
				return false
			}
			for !versList.Empty() {
				if !versList.ReadUint16(&vers) {
					return false
				}
				m.supportedVersions = mxutil.Ensure(m.supportedVersions, 1)
				m.supportedVersions = push(m.supportedVersions, vers)
			}
		case extensionCookie:
			// RFC 8446, Section 4.2.2
			if !readUint16LengthPrefixed(&extData, &m.cookie) ||
				len(m.cookie) == 0 {
				return false
			}
		case extensionKeyShare:
			// RFC 8446, Section 4.2.8
			if !extData.ReadUint16LengthPrefixed(&clientShares) {
				return false
			}
			for !clientShares.Empty() {
				if !clientShares.ReadUint16((*uint16)(&ks.group)) ||
					!readUint16LengthPrefixed(&clientShares, &ks.data) ||
					len(ks.data) == 0 {
					return false
				}
				m.keyShares = mxutil.Ensure(m.keyShares, 1)
				m.keyShares = push(m.keyShares, ks)
			}
		case extensionEarlyData:
			// RFC 8446, Section 4.2.10
			m.earlyData = true
		case extensionPSKModes:
			// RFC 8446, Section 4.2.9
			if !readUint8LengthPrefixed(&extData, &m.pskModes) {
				return false
			}
		case extensionQUICTransportParameters:
			m.quicTransportParameters = []byte{:len(extData)}
			if !extData.CopyBytes(m.quicTransportParameters) {
				return false
			}
		case extensionPreSharedKey:
			// RFC 8446, Section 4.2.11
			if !extensions.Empty() {
				return false // pre_shared_key must be the last extension
			}
			if !extData.ReadUint16LengthPrefixed(&identities) || identities.Empty() {
				return false
			}
			for !identities.Empty() {
				if !readUint16LengthPrefixed(&identities, &psk.label) ||
					!identities.ReadUint32(&psk.obfuscatedTicketAge) ||
					len(psk.label) == 0 {
					return false
				}
				m.pskIdentities = mxutil.Ensure(m.pskIdentities, 1)
				m.pskIdentities = push(m.pskIdentities, psk)
			}
			if !extData.ReadUint16LengthPrefixed(&binders) || binders.Empty() {
				return false
			}
			for !binders.Empty() {
				if !readUint8LengthPrefixed(&binders, &binder) ||
					len(binder) == 0 {
					return false
				}
				m.pskBinders = mxutil.Ensure(m.pskBinders, 1)
				m.pskBinders = push(m.pskBinders, binder)
			}
		case extensionEncryptedClientHello:
			if !extData.ReadBytes(&m.encryptedClientHello, len(extData)) {
				return false
			}
		default:
			// Ignore unknown extensions.
			continue
		}

		if !extData.Empty() {
			return false
		}
	}

	return true
}

func (m *clientHelloMsg) originalBytes() (rb []byte) {
	return m.original
}

func (m *clientHelloMsg) clone() (rclientHelloMsg *clientHelloMsg) {
	return &clientHelloMsg{
		original:                         slices.Clone(m.original),
		vers:                             m.vers,
		random:                           slices.Clone(m.random),
		sessionId:                        slices.Clone(m.sessionId),
		cipherSuites:                     slices.Clone(m.cipherSuites),
		compressionMethods:               slices.Clone(m.compressionMethods),
		serverName:                       m.serverName,
		ocspStapling:                     m.ocspStapling,
		supportedCurves:                  slices.Clone(m.supportedCurves),
		supportedPoints:                  slices.Clone(m.supportedPoints),
		ticketSupported:                  m.ticketSupported,
		sessionTicket:                    slices.Clone(m.sessionTicket),
		supportedSignatureAlgorithms:     slices.Clone(m.supportedSignatureAlgorithms),
		supportedSignatureAlgorithmsCert: slices.Clone(m.supportedSignatureAlgorithmsCert),
		secureRenegotiationSupported:     m.secureRenegotiationSupported,
		secureRenegotiation:              slices.Clone(m.secureRenegotiation),
		extendedMasterSecret:             m.extendedMasterSecret,
		alpnProtocols:                    slices.Clone(m.alpnProtocols),
		scts:                             m.scts,
		supportedVersions:                slices.Clone(m.supportedVersions),
		cookie:                           slices.Clone(m.cookie),
		keyShares:                        slices.Clone(m.keyShares),
		earlyData:                        m.earlyData,
		pskModes:                         slices.Clone(m.pskModes),
		pskIdentities:                    slices.Clone(m.pskIdentities),
		pskBinders:                       slices.Clone(m.pskBinders),
		quicTransportParameters:          slices.Clone(m.quicTransportParameters),
		encryptedClientHello:             slices.Clone(m.encryptedClientHello),
	}
}

type serverHelloMsg struct {
	original                     []byte
	vers                         uint16
	random                       []byte
	sessionId                    []byte
	cipherSuite                  uint16
	compressionMethod            uint8
	ocspStapling                 bool
	ticketSupported              bool
	secureRenegotiationSupported bool
	secureRenegotiation          []byte
	extendedMasterSecret         bool
	alpnProtocol                 []byte
	scts                         [][]byte
	supportedVersion             uint16
	serverShare                  keyShare
	selectedIdentityPresent      bool
	selectedIdentity             uint16
	supportedPoints              []uint8
	encryptedClientHello         []byte
	serverNameAck                bool

	// HelloRetryRequest extensions
	cookie        []byte
	selectedGroup CurveID
}

func (m *serverHelloMsg) marshal() (rb []byte, rerr error) {
	var exts cryptobyte.Builder
	if m.ocspStapling {
		exts.AddUint16(extensionStatusRequest)
		exts.AddUint16(0) // empty extension_data
	}
	if m.ticketSupported {
		exts.AddUint16(extensionSessionTicket)
		exts.AddUint16(0) // empty extension_data
	}
	if m.secureRenegotiationSupported {
		exts.AddUint16(extensionRenegotiationInfo)
		exts.BeginUint16LengthPrefixed()
			exts.BeginUint8LengthPrefixed()
				exts.AddBytes(m.secureRenegotiation)
			exts.EndLengthPrefixed()
		exts.EndLengthPrefixed()
	}
	if m.extendedMasterSecret {
		exts.AddUint16(extensionExtendedMasterSecret)
		exts.AddUint16(0) // empty extension_data
	}
	if len(m.alpnProtocol) > 0 {
		exts.AddUint16(extensionALPN)
		exts.BeginUint16LengthPrefixed()
			exts.BeginUint16LengthPrefixed()
				exts.BeginUint8LengthPrefixed()
					exts.AddBytes([]byte(m.alpnProtocol))
				exts.EndLengthPrefixed()
			exts.EndLengthPrefixed()
		exts.EndLengthPrefixed()
	}
	if len(m.scts) > 0 {
		exts.AddUint16(extensionSCT)
		exts.BeginUint16LengthPrefixed()
			exts.BeginUint16LengthPrefixed()
				for _, sct := range m.scts {
					exts.BeginUint16LengthPrefixed()
						exts.AddBytes(sct)
					exts.EndLengthPrefixed()
				}
			exts.EndLengthPrefixed()
		exts.EndLengthPrefixed()
	}
	if m.supportedVersion != 0 {
		exts.AddUint16(extensionSupportedVersions)
		exts.BeginUint16LengthPrefixed()
			exts.AddUint16(m.supportedVersion)
		exts.EndLengthPrefixed()
	}
	if m.serverShare.group != 0 {
		exts.AddUint16(extensionKeyShare)
		exts.BeginUint16LengthPrefixed()
			exts.AddUint16(uint16(m.serverShare.group))
			exts.BeginUint16LengthPrefixed()
				exts.AddBytes(m.serverShare.data)
			exts.EndLengthPrefixed()
		exts.EndLengthPrefixed()
	}
	if m.selectedIdentityPresent {
		exts.AddUint16(extensionPreSharedKey)
		exts.BeginUint16LengthPrefixed()
			exts.AddUint16(m.selectedIdentity)
		exts.EndLengthPrefixed()
	}

	if len(m.cookie) > 0 {
		exts.AddUint16(extensionCookie)
		exts.BeginUint16LengthPrefixed()
			exts.BeginUint16LengthPrefixed()
				exts.AddBytes(m.cookie)
			exts.EndLengthPrefixed()
		exts.EndLengthPrefixed()
	}
	if m.selectedGroup != 0 {
		exts.AddUint16(extensionKeyShare)
		exts.BeginUint16LengthPrefixed()
			exts.AddUint16(uint16(m.selectedGroup))
		exts.EndLengthPrefixed()
	}
	if len(m.supportedPoints) > 0 {
		exts.AddUint16(extensionSupportedPoints)
		exts.BeginUint16LengthPrefixed()
			exts.BeginUint8LengthPrefixed()
				exts.AddBytes(m.supportedPoints)
			exts.EndLengthPrefixed()
		exts.EndLengthPrefixed()
	}
	if len(m.encryptedClientHello) > 0 {
		exts.AddUint16(extensionEncryptedClientHello)
		exts.BeginUint16LengthPrefixed()
			exts.AddBytes(m.encryptedClientHello)
		exts.EndLengthPrefixed()
	}
	if m.serverNameAck {
		exts.AddUint16(extensionServerName)
		exts.AddUint16(0)
	}

	extBytes, err := exts.Bytes()
	if err != nil {
		return nil, err
	}

	var b cryptobyte.Builder
	b.AddUint8(typeServerHello)
	b.BeginUint24LengthPrefixed()
		b.AddUint16(m.vers)
		addBytesWithLength(&b, m.random, 32)
		b.BeginUint8LengthPrefixed()
			b.AddBytes(m.sessionId)
		b.EndLengthPrefixed()
		b.AddUint16(m.cipherSuite)
		b.AddUint8(m.compressionMethod)

		if len(extBytes) > 0 {
			b.BeginUint16LengthPrefixed()
				b.AddBytes(extBytes)
			b.EndLengthPrefixed()
		}
	b.EndLengthPrefixed()

	return b.Bytes()
}

func (m *serverHelloMsg) unmarshal(data []byte) (rok bool) {
	*m = serverHelloMsg{original: data}
	s := cryptobyte.String(data)

	if !s.Skip(4) || // message type and uint24 length field
		!s.ReadUint16(&m.vers) || !s.ReadBytes(&m.random, 32) ||
		!readUint8LengthPrefixed(&s, &m.sessionId) ||
		!s.ReadUint16(&m.cipherSuite) ||
		!s.ReadUint8(&m.compressionMethod) {
		return false
	}

	if s.Empty() {
		// ServerHello is optionally followed by extension data
		return true
	}

	var extensions cryptobyte.String
	if !s.ReadUint16LengthPrefixed(&extensions) || !s.Empty() {
		return false
	}

	seenExts := map[uint16]bool{}
	var extension uint16
	var extData cryptobyte.String
	var protoList cryptobyte.String
	var proto cryptobyte.String
	var sctList cryptobyte.String
	var sct []byte
	for !extensions.Empty() {
		if !extensions.ReadUint16(&extension) ||
			!extensions.ReadUint16LengthPrefixed(&extData) {
			return false
		}

		if seenExts[extension] {
			return false
		}
		seenExts[extension] = true

		switch extension {
		case extensionStatusRequest:
			m.ocspStapling = true
		case extensionSessionTicket:
			m.ticketSupported = true
		case extensionRenegotiationInfo:
			if !readUint8LengthPrefixed(&extData, &m.secureRenegotiation) {
				return false
			}
			m.secureRenegotiationSupported = true
		case extensionExtendedMasterSecret:
			m.extendedMasterSecret = true
		case extensionALPN:
			if !extData.ReadUint16LengthPrefixed(&protoList) || protoList.Empty() {
				return false
			}
			if !protoList.ReadUint8LengthPrefixed(&proto) ||
				proto.Empty() || !protoList.Empty() {
				return false
			}
			m.alpnProtocol = []byte(proto)
		case extensionSCT:
			if !extData.ReadUint16LengthPrefixed(&sctList) || sctList.Empty() {
				return false
			}
			for !sctList.Empty() {
				if !readUint16LengthPrefixed(&sctList, &sct) ||
					len(sct) == 0 {
					return false
				}
				m.scts = mxutil.Ensure(m.scts, 1)
				m.scts = push(m.scts, sct)
			}
		case extensionSupportedVersions:
			if !extData.ReadUint16(&m.supportedVersion) {
				return false
			}
		case extensionCookie:
			if !readUint16LengthPrefixed(&extData, &m.cookie) ||
				len(m.cookie) == 0 {
				return false
			}
		case extensionKeyShare:
			// This extension has different formats in SH and HRR, accept either
			// and let the handshake logic decide. See RFC 8446, Section 4.2.8.
			if len(extData) == 2 {
				if !extData.ReadUint16((*uint16)(&m.selectedGroup)) {
					return false
				}
			} else {
				if !extData.ReadUint16((*uint16)(&m.serverShare.group)) ||
					!readUint16LengthPrefixed(&extData, &m.serverShare.data) {
					return false
				}
			}
		case extensionPreSharedKey:
			m.selectedIdentityPresent = true
			if !extData.ReadUint16(&m.selectedIdentity) {
				return false
			}
		case extensionSupportedPoints:
			// RFC 4492, Section 5.1.2
			if !readUint8LengthPrefixed(&extData, &m.supportedPoints) ||
				len(m.supportedPoints) == 0 {
				return false
			}
		case extensionEncryptedClientHello: // encrypted_client_hello
			m.encryptedClientHello = []byte{:len(extData)}
			if !extData.CopyBytes(m.encryptedClientHello) {
				return false
			}
		case extensionServerName:
			if len(extData) != 0 {
				return false
			}
			m.serverNameAck = true
		default:
			// Ignore unknown extensions.
			continue
		}

		if !extData.Empty() {
			return false
		}
	}

	return true
}

func (m *serverHelloMsg) originalBytes() (rb []byte) {
	return m.original
}

type encryptedExtensionsMsg struct {
	alpnProtocol            []byte
	quicTransportParameters []byte
	earlyData               bool
	echRetryConfigs         []byte
	serverNameAck           bool
}

func (m *encryptedExtensionsMsg) marshal() (rb []byte, rerr error) {
	var b cryptobyte.Builder
	b.AddUint8(typeEncryptedExtensions)
	b.BeginUint24LengthPrefixed()
		b.BeginUint16LengthPrefixed()
			if len(m.alpnProtocol) > 0 {
				b.AddUint16(extensionALPN)
				b.BeginUint16LengthPrefixed()
					b.BeginUint16LengthPrefixed()
						b.BeginUint8LengthPrefixed()
							b.AddBytes([]byte(m.alpnProtocol))
						b.EndLengthPrefixed()
					b.EndLengthPrefixed()
				b.EndLengthPrefixed()
			}
			if m.quicTransportParameters != nil { // marshal zero-length parameters when present
				// draft-ietf-quic-tls-32, Section 8.2
				b.AddUint16(extensionQUICTransportParameters)
				b.BeginUint16LengthPrefixed()
					b.AddBytes(m.quicTransportParameters)
				b.EndLengthPrefixed()
			}
			if m.earlyData {
				// RFC 8446, Section 4.2.10
				b.AddUint16(extensionEarlyData)
				b.AddUint16(0) // empty extension_data
			}
			if len(m.echRetryConfigs) > 0 {
				b.AddUint16(extensionEncryptedClientHello)
				b.BeginUint16LengthPrefixed()
					b.AddBytes(m.echRetryConfigs)
				b.EndLengthPrefixed()
			}
			if m.serverNameAck {
				b.AddUint16(extensionServerName)
				b.AddUint16(0) // empty extension_data
			}
		b.EndLengthPrefixed()
	b.EndLengthPrefixed()

	return b.Bytes()
}

func (m *encryptedExtensionsMsg) unmarshal(data []byte) (rok bool) {
	*m = encryptedExtensionsMsg{}
	s := cryptobyte.String(data)

	var extensions cryptobyte.String
	if !s.Skip(4) || // message type and uint24 length field
		!s.ReadUint16LengthPrefixed(&extensions) || !s.Empty() {
		return false
	}

	seenExts := map[uint16]bool{}
	var extension uint16
	var extData cryptobyte.String
	var protoList cryptobyte.String
	var proto cryptobyte.String
	for !extensions.Empty() {
		if !extensions.ReadUint16(&extension) ||
			!extensions.ReadUint16LengthPrefixed(&extData) {
			return false
		}

		if seenExts[extension] {
			return false
		}
		seenExts[extension] = true

		switch extension {
		case extensionALPN:
			if !extData.ReadUint16LengthPrefixed(&protoList) || protoList.Empty() {
				return false
			}
			if !protoList.ReadUint8LengthPrefixed(&proto) ||
				proto.Empty() || !protoList.Empty() {
				return false
			}
			m.alpnProtocol = []byte(proto)
		case extensionQUICTransportParameters:
			m.quicTransportParameters = []byte{:len(extData)}
			if !extData.CopyBytes(m.quicTransportParameters) {
				return false
			}
		case extensionEarlyData:
			// RFC 8446, Section 4.2.10
			m.earlyData = true
		case extensionEncryptedClientHello:
			m.echRetryConfigs = []byte{:len(extData)}
			if !extData.CopyBytes(m.echRetryConfigs) {
				return false
			}
		case extensionServerName:
			if len(extData) != 0 {
				return false
			}
			m.serverNameAck = true
		default:
			// Ignore unknown extensions.
			continue
		}

		if !extData.Empty() {
			return false
		}
	}

	return true
}

type endOfEarlyDataMsg struct{}

func (m *endOfEarlyDataMsg) marshal() (rb []byte, rerr error) {
	x := []byte{:4}
	x[0] = typeEndOfEarlyData
	return x, nil
}

func (m *endOfEarlyDataMsg) unmarshal(data []byte) (rok bool) {
	return len(data) == 4
}

type keyUpdateMsg struct {
	updateRequested bool
}

func (m *keyUpdateMsg) marshal() (rb []byte, rerr error) {
	var b cryptobyte.Builder
	b.AddUint8(typeKeyUpdate)
	b.BeginUint24LengthPrefixed()
		if m.updateRequested {
			b.AddUint8(1)
		} else {
			b.AddUint8(0)
		}
	b.EndLengthPrefixed()

	return b.Bytes()
}

func (m *keyUpdateMsg) unmarshal(data []byte) (rok bool) {
	s := cryptobyte.String(data)

	var updateRequested uint8
	if !s.Skip(4) || // message type and uint24 length field
		!s.ReadUint8(&updateRequested) || !s.Empty() {
		return false
	}
	switch updateRequested {
	case 0:
		m.updateRequested = false
	case 1:
		m.updateRequested = true
	default:
		return false
	}
	return true
}

type newSessionTicketMsgTLS13 struct {
	lifetime     uint32
	ageAdd       uint32
	nonce        []byte
	label        []byte
	maxEarlyData uint32
}

func (m *newSessionTicketMsgTLS13) marshal() (rb []byte, rerr error) {
	var b cryptobyte.Builder
	b.AddUint8(typeNewSessionTicket)
	b.BeginUint24LengthPrefixed()
		b.AddUint32(m.lifetime)
		b.AddUint32(m.ageAdd)
		b.BeginUint8LengthPrefixed()
			b.AddBytes(m.nonce)
		b.EndLengthPrefixed()
		b.BeginUint16LengthPrefixed()
			b.AddBytes(m.label)
		b.EndLengthPrefixed()

		b.BeginUint16LengthPrefixed()
			if m.maxEarlyData > 0 {
				b.AddUint16(extensionEarlyData)
				b.BeginUint16LengthPrefixed()
					b.AddUint32(m.maxEarlyData)
				b.EndLengthPrefixed()
			}
		b.EndLengthPrefixed()
	b.EndLengthPrefixed()

	return b.Bytes()
}

func (m *newSessionTicketMsgTLS13) unmarshal(data []byte) (rok bool) {
	*m = newSessionTicketMsgTLS13{}
	s := cryptobyte.String(data)

	var extensions cryptobyte.String
	if !s.Skip(4) || // message type and uint24 length field
		!s.ReadUint32(&m.lifetime) ||
		!s.ReadUint32(&m.ageAdd) ||
		!readUint8LengthPrefixed(&s, &m.nonce) ||
		!readUint16LengthPrefixed(&s, &m.label) ||
		!s.ReadUint16LengthPrefixed(&extensions) ||
		!s.Empty() {
		return false
	}

	var extension uint16
	var extData cryptobyte.String
	for !extensions.Empty() {
		if !extensions.ReadUint16(&extension) ||
			!extensions.ReadUint16LengthPrefixed(&extData) {
			return false
		}

		switch extension {
		case extensionEarlyData:
			if !extData.ReadUint32(&m.maxEarlyData) {
				return false
			}
		default:
			// Ignore unknown extensions.
			continue
		}

		if !extData.Empty() {
			return false
		}
	}

	return true
}

type certificateRequestMsgTLS13 struct {
	ocspStapling                     bool
	scts                             bool
	supportedSignatureAlgorithms     []SignatureScheme
	supportedSignatureAlgorithmsCert []SignatureScheme
	certificateAuthorities           [][]byte
}

func (m *certificateRequestMsgTLS13) marshal() (rb []byte, rerr error) {
	var b cryptobyte.Builder
	b.AddUint8(typeCertificateRequest)
	b.BeginUint24LengthPrefixed()
		// certificate_request_context (SHALL be zero length unless used for
		// post-handshake authentication)
		b.AddUint8(0)

		b.BeginUint16LengthPrefixed()
			if m.ocspStapling {
				b.AddUint16(extensionStatusRequest)
				b.AddUint16(0) // empty extension_data
			}
			if m.scts {
				// RFC 8446, Section 4.4.2.1 makes no mention of
				// signed_certificate_timestamp in CertificateRequest, but
				// "Extensions in the Certificate message from the client MUST
				// correspond to extensions in the CertificateRequest message
				// from the server." and it appears in the table in Section 4.2.
				b.AddUint16(extensionSCT)
				b.AddUint16(0) // empty extension_data
			}
			if len(m.supportedSignatureAlgorithms) > 0 {
				b.AddUint16(extensionSignatureAlgorithms)
				b.BeginUint16LengthPrefixed()
					b.BeginUint16LengthPrefixed()
						for _, sigAlgo := range m.supportedSignatureAlgorithms {
							b.AddUint16(uint16(sigAlgo))
						}
					b.EndLengthPrefixed()
				b.EndLengthPrefixed()
			}
			if len(m.supportedSignatureAlgorithmsCert) > 0 {
				b.AddUint16(extensionSignatureAlgorithmsCert)
				b.BeginUint16LengthPrefixed()
					b.BeginUint16LengthPrefixed()
						for _, sigAlgo := range m.supportedSignatureAlgorithmsCert {
							b.AddUint16(uint16(sigAlgo))
						}
					b.EndLengthPrefixed()
				b.EndLengthPrefixed()
			}
			if len(m.certificateAuthorities) > 0 {
				b.AddUint16(extensionCertificateAuthorities)
				b.BeginUint16LengthPrefixed()
					b.BeginUint16LengthPrefixed()
						for _, ca := range m.certificateAuthorities {
							b.BeginUint16LengthPrefixed()
								b.AddBytes(ca)
							b.EndLengthPrefixed()
						}
					b.EndLengthPrefixed()
				b.EndLengthPrefixed()
			}
		b.EndLengthPrefixed()
	b.EndLengthPrefixed()

	return b.Bytes()
}

func (m *certificateRequestMsgTLS13) unmarshal(data []byte) (rok bool) {
	*m = certificateRequestMsgTLS13{}
	s := cryptobyte.String(data)

	var ctxBlob, extensions cryptobyte.String
	if !s.Skip(4) || // message type and uint24 length field
		!s.ReadUint8LengthPrefixed(&ctxBlob) || !ctxBlob.Empty() ||
		!s.ReadUint16LengthPrefixed(&extensions) ||
		!s.Empty() {
		return false
	}

	var extension uint16
	var extData cryptobyte.String
	var sigAndAlgs cryptobyte.String
	var sigAndAlg uint16
	var auths cryptobyte.String
	var ca []byte
	for !extensions.Empty() {
		if !extensions.ReadUint16(&extension) ||
			!extensions.ReadUint16LengthPrefixed(&extData) {
			return false
		}

		switch extension {
		case extensionStatusRequest:
			m.ocspStapling = true
		case extensionSCT:
			m.scts = true
		case extensionSignatureAlgorithms:
			if !extData.ReadUint16LengthPrefixed(&sigAndAlgs) || sigAndAlgs.Empty() {
				return false
			}
			for !sigAndAlgs.Empty() {
				if !sigAndAlgs.ReadUint16(&sigAndAlg) {
					return false
				}
				m.supportedSignatureAlgorithms = push(
					m.supportedSignatureAlgorithms, SignatureScheme(sigAndAlg))
			}
		case extensionSignatureAlgorithmsCert:
			if !extData.ReadUint16LengthPrefixed(&sigAndAlgs) || sigAndAlgs.Empty() {
				return false
			}
			for !sigAndAlgs.Empty() {
				if !sigAndAlgs.ReadUint16(&sigAndAlg) {
					return false
				}
				m.supportedSignatureAlgorithmsCert = push(
					m.supportedSignatureAlgorithmsCert, SignatureScheme(sigAndAlg))
			}
		case extensionCertificateAuthorities:
			if !extData.ReadUint16LengthPrefixed(&auths) || auths.Empty() {
				return false
			}
			for !auths.Empty() {
				if !readUint16LengthPrefixed(&auths, &ca) || len(ca) == 0 {
					return false
				}
				m.certificateAuthorities = mxutil.Ensure(m.certificateAuthorities, 1)
				m.certificateAuthorities = push(m.certificateAuthorities, ca)
			}
		default:
			// Ignore unknown extensions.
			continue
		}

		if !extData.Empty() {
			return false
		}
	}

	return true
}

type certificateMsg struct {
	certificates [][]byte
}

func (m *certificateMsg) marshal() (rb []byte, rerr error) {
	var i int32
	for _, slice := range m.certificates {
		i += len(slice)
	}

	length := 3 + 3*len(m.certificates) + i
	x := []byte{:4+length}
	x[0] = typeCertificate
	x[1] = uint8(length >> 16)
	x[2] = uint8(length >> 8)
	x[3] = uint8(length)

	certificateOctets := length - 3
	x[4] = uint8(certificateOctets >> 16)
	x[5] = uint8(certificateOctets >> 8)
	x[6] = uint8(certificateOctets)

	// By offset: y := x[7:] would be a copy once a sub-slice is a copy, and
	// the per-certificate writes would be lost.
	off := int32(7)
	for _, slice := range m.certificates {
		x[off+0] = uint8(len(slice) >> 16)
		x[off+1] = uint8(len(slice) >> 8)
		x[off+2] = uint8(len(slice))
		for j := int32(0); j < int32(len(slice)); j++ {
			x[off+3+j] = slice[j]
		}
		off += 3 + int32(len(slice))
	}

	return x, nil
}

func (m *certificateMsg) unmarshal(data []byte) (rok bool) {
	if len(data) < 7 {
		return false
	}

	certsLen := uint32(data[4])<<16 | uint32(data[5])<<8 | uint32(data[6])
	if uint32(len(data)) != certsLen+7 {
		return false
	}

	// d stays whole and off walks it: trimming d would copy the remainder of
	// the handshake message at every certificate.
	numCerts := 0
	d := data
	off := int32(7)
	var certLen uint32
	for certsLen > 0 {
		if int32(len(d))-off < 4 {
			return false
		}
		certLen = uint32(d[off+0])<<16 | uint32(d[off+1])<<8 | uint32(d[off+2])
		if uint32(int32(len(d))-off) < 3+certLen {
			return false
		}
		off += 3 + int32(certLen)
		certsLen -= 3 + certLen
		numCerts++
	}

	m.certificates = [][]byte{:numCerts}
	off = 7
	for i := 0; i < numCerts; i++ {
		certLen = uint32(d[off+0])<<16 | uint32(d[off+1])<<8 | uint32(d[off+2])
		m.certificates[i] = d[off+3 : off+3+int32(certLen)]
		off += 3 + int32(certLen)
	}

	return true
}

type certificateMsgTLS13 struct {
	certificate  Certificate
	ocspStapling bool
	scts         bool
}

func (m *certificateMsgTLS13) marshal() (rb []byte, rerr error) {
	var b cryptobyte.Builder
	b.AddUint8(typeCertificate)
	b.BeginUint24LengthPrefixed()
		b.AddUint8(0) // certificate_request_context

		certificate := m.certificate
		if !m.ocspStapling {
			certificate.OCSPStaple = nil
		}
		if !m.scts {
			certificate.SignedCertificateTimestamps = nil
		}
		marshalCertificate(&b, certificate)
	b.EndLengthPrefixed()

	return b.Bytes()
}

func marshalCertificate(b *cryptobyte.Builder, certificate Certificate) {
	b.BeginUint24LengthPrefixed()
	for i, cert := range certificate.Certificate {
		b.BeginUint24LengthPrefixed()
		b.AddBytes(cert)
		b.EndLengthPrefixed()
		b.BeginUint16LengthPrefixed()
		if i == 0 {
			// This library only supports OCSP and SCT for leaf certificates.
			if certificate.OCSPStaple != nil {
				b.AddUint16(extensionStatusRequest)
				b.BeginUint16LengthPrefixed()
				b.AddUint8(statusTypeOCSP)
				b.BeginUint24LengthPrefixed()
				b.AddBytes(certificate.OCSPStaple)
				b.EndLengthPrefixed()
				b.EndLengthPrefixed()
			}
			if certificate.SignedCertificateTimestamps != nil {
				b.AddUint16(extensionSCT)
				b.BeginUint16LengthPrefixed()
				b.BeginUint16LengthPrefixed()
				for _, sct := range certificate.SignedCertificateTimestamps {
					b.BeginUint16LengthPrefixed()
					b.AddBytes(sct)
					b.EndLengthPrefixed()
				}
				b.EndLengthPrefixed()
				b.EndLengthPrefixed()
			}
		}
		b.EndLengthPrefixed()
	}
	b.EndLengthPrefixed()
}

func (m *certificateMsgTLS13) unmarshal(data []byte) (rok bool) {
	*m = certificateMsgTLS13{}
	s := cryptobyte.String(data)

	var ctxBlob cryptobyte.String
	if !s.Skip(4) || // message type and uint24 length field
		!s.ReadUint8LengthPrefixed(&ctxBlob) || !ctxBlob.Empty() ||
		!unmarshalCertificate(&s, &m.certificate) ||
		!s.Empty() {
		return false
	}

	m.scts = m.certificate.SignedCertificateTimestamps != nil
	m.ocspStapling = m.certificate.OCSPStaple != nil

	return true
}

func unmarshalCertificate(s *cryptobyte.String, certificate *Certificate) (rok bool) {
	var certList cryptobyte.String
	if !s.ReadUint24LengthPrefixed(&certList) {
		return false
	}
	for !certList.Empty() {
		var cert []byte
		var extensions cryptobyte.String
		if !readUint24LengthPrefixed(&certList, &cert) ||
			!certList.ReadUint16LengthPrefixed(&extensions) {
			return false
		}
		certificate.Certificate = mxutil.Ensure(certificate.Certificate, 1)
		certificate.Certificate = push(certificate.Certificate, cert)
		for !extensions.Empty() {
			var extension uint16
			var extData cryptobyte.String
			if !extensions.ReadUint16(&extension) ||
				!extensions.ReadUint16LengthPrefixed(&extData) {
				return false
			}
			if len(certificate.Certificate) > 1 {
				// This library only supports OCSP and SCT for leaf certificates.
				continue
			}

			switch extension {
			case extensionStatusRequest:
				var statusType uint8
				if !extData.ReadUint8(&statusType) || statusType != statusTypeOCSP ||
					!readUint24LengthPrefixed(&extData, &certificate.OCSPStaple) ||
					len(certificate.OCSPStaple) == 0 {
					return false
				}
			case extensionSCT:
				var sctList cryptobyte.String
				if !extData.ReadUint16LengthPrefixed(&sctList) || sctList.Empty() {
					return false
				}
				for !sctList.Empty() {
					var sct []byte
					if !readUint16LengthPrefixed(&sctList, &sct) ||
						len(sct) == 0 {
						return false
					}
					certificate.SignedCertificateTimestamps = push(
						certificate.SignedCertificateTimestamps, sct)
				}
			default:
				// Ignore unknown extensions.
				continue
			}

			if !extData.Empty() {
				return false
			}
		}
	}
	return true
}

type serverKeyExchangeMsg struct {
	key []byte
}

func (m *serverKeyExchangeMsg) marshal() (rb []byte, rerr error) {
	length := len(m.key)
	x := []byte{:length+4}
	x[0] = typeServerKeyExchange
	x[1] = uint8(length >> 16)
	x[2] = uint8(length >> 8)
	x[3] = uint8(length)
	mxutil.CopyAt(x, 4, m.key)

	return x, nil
}

func (m *serverKeyExchangeMsg) unmarshal(data []byte) (rok bool) {
	if len(data) < 4 {
		return false
	}
	m.key = data[4:]
	return true
}

type certificateStatusMsg struct {
	response []byte
}

func (m *certificateStatusMsg) marshal() (rb []byte, rerr error) {
	var b cryptobyte.Builder
	b.AddUint8(typeCertificateStatus)
	b.BeginUint24LengthPrefixed()
		b.AddUint8(statusTypeOCSP)
		b.BeginUint24LengthPrefixed()
			b.AddBytes(m.response)
		b.EndLengthPrefixed()
	b.EndLengthPrefixed()

	return b.Bytes()
}

func (m *certificateStatusMsg) unmarshal(data []byte) (rok bool) {
	s := cryptobyte.String(data)

	var statusType uint8
	if !s.Skip(4) || // message type and uint24 length field
		!s.ReadUint8(&statusType) || statusType != statusTypeOCSP ||
		!readUint24LengthPrefixed(&s, &m.response) ||
		len(m.response) == 0 || !s.Empty() {
		return false
	}
	return true
}

type serverHelloDoneMsg struct{}

func (m *serverHelloDoneMsg) marshal() (rb []byte, rerr error) {
	x := []byte{:4}
	x[0] = typeServerHelloDone
	return x, nil
}

func (m *serverHelloDoneMsg) unmarshal(data []byte) (rok bool) {
	return len(data) == 4
}

type clientKeyExchangeMsg struct {
	ciphertext []byte
}

func (m *clientKeyExchangeMsg) marshal() (rb []byte, rerr error) {
	length := len(m.ciphertext)
	x := []byte{:length+4}
	x[0] = typeClientKeyExchange
	x[1] = uint8(length >> 16)
	x[2] = uint8(length >> 8)
	x[3] = uint8(length)
	mxutil.CopyAt(x, 4, m.ciphertext)

	return x, nil
}

func (m *clientKeyExchangeMsg) unmarshal(data []byte) (rok bool) {
	if len(data) < 4 {
		return false
	}
	l := int32(data[1])<<16 | int32(data[2])<<8 | int32(data[3])
	if l != len(data)-4 {
		return false
	}
	m.ciphertext = data[4:]
	return true
}

type finishedMsg struct {
	verifyData []byte
}

func (m *finishedMsg) marshal() (rb []byte, rerr error) {
	var b cryptobyte.Builder
	b.AddUint8(typeFinished)
	b.BeginUint24LengthPrefixed()
		b.AddBytes(m.verifyData)
	b.EndLengthPrefixed()

	return b.Bytes()
}

func (m *finishedMsg) unmarshal(data []byte) (rok bool) {
	s := cryptobyte.String(data)
	return s.Skip(1) &&
		readUint24LengthPrefixed(&s, &m.verifyData) &&
		s.Empty()
}

type certificateRequestMsg struct {
	// hasSignatureAlgorithm indicates whether this message includes a list of
	// supported signature algorithms. This change was introduced with TLS 1.2.
	hasSignatureAlgorithm bool

	certificateTypes             []byte
	supportedSignatureAlgorithms []SignatureScheme
	certificateAuthorities       [][]byte
}

func (m *certificateRequestMsg) marshal() (rb []byte, rerr error) {
	// See RFC 4346, Section 7.4.4.
	length := 1 + len(m.certificateTypes) + 2
	casLength := 0
	for _, ca := range m.certificateAuthorities {
		casLength += 2 + len(ca)
	}
	length += casLength

	if m.hasSignatureAlgorithm {
		length += 2 + 2*len(m.supportedSignatureAlgorithms)
	}

	x := []byte{:4+length}
	x[0] = typeCertificateRequest
	x[1] = uint8(length >> 16)
	x[2] = uint8(length >> 8)
	x[3] = uint8(length)

	x[4] = uint8(len(m.certificateTypes))

	// By offset: y := x[5+len(...):] would be a copy once a sub-slice is a
	// copy, and every write below would be lost.
	off := int32(5)
	for j := int32(0); j < int32(len(m.certificateTypes)); j++ {
		x[off+j] = m.certificateTypes[j]
	}
	off += int32(len(m.certificateTypes))

	if m.hasSignatureAlgorithm {
		n := len(m.supportedSignatureAlgorithms) * 2
		x[off+0] = uint8(n >> 8)
		x[off+1] = uint8(n)
		off += 2
		for _, sigAlgo := range m.supportedSignatureAlgorithms {
			x[off+0] = uint8(sigAlgo >> 8)
			x[off+1] = uint8(sigAlgo)
			off += 2
		}
	}

	x[off+0] = uint8(casLength >> 8)
	x[off+1] = uint8(casLength)
	off += 2
	for _, ca := range m.certificateAuthorities {
		x[off+0] = uint8(len(ca) >> 8)
		x[off+1] = uint8(len(ca))
		off += 2
		for j := int32(0); j < int32(len(ca)); j++ {
			x[off+j] = ca[j]
		}
		off += int32(len(ca))
	}

	return x, nil
}

func (m *certificateRequestMsg) unmarshal(data []byte) (rok bool) {
	if len(data) < 5 {
		return false
	}

	length := uint32(data[1])<<16 | uint32(data[2])<<8 | uint32(data[3])
	if uint32(len(data))-4 != length {
		return false
	}

	// data stays whole and off walks it: trimming data would copy the rest of
	// the message at every field.
	numCertTypes := int32(data[4])
	off := int32(5)
	if numCertTypes == 0 || int32(len(data))-off <= numCertTypes {
		return false
	}

	m.certificateTypes = []byte{:numCertTypes}
	for j := int32(0); j < numCertTypes; j++ {
		m.certificateTypes[j] = data[off+j]
	}
	off += numCertTypes

	if m.hasSignatureAlgorithm {
		if int32(len(data))-off < 2 {
			return false
		}
		sigAndHashLen := uint16(data[off])<<8 | uint16(data[off+1])
		off += 2
		if sigAndHashLen&1 != 0 || sigAndHashLen == 0 {
			return false
		}
		if int32(len(data))-off < int32(sigAndHashLen) {
			return false
		}
		numSigAlgos := sigAndHashLen / 2
		m.supportedSignatureAlgorithms = []SignatureScheme{:numSigAlgos}
		for i := range m.supportedSignatureAlgorithms {
			m.supportedSignatureAlgorithms[i] = SignatureScheme(data[off])<<8 | SignatureScheme(data[off+1])
			off += 2
		}
	}

	if int32(len(data))-off < 2 {
		return false
	}
	casLength := uint16(data[off])<<8 | uint16(data[off+1])
	off += 2
	if int32(len(data))-off < int32(casLength) {
		return false
	}
	casOff := off
	casEnd := off + int32(casLength)
	off = casEnd

	m.certificateAuthorities = nil
	var caLen uint16
	for casOff < casEnd {
		if casEnd-casOff < 2 {
			return false
		}
		caLen = uint16(data[casOff])<<8 | uint16(data[casOff+1])
		casOff += 2

		if casEnd-casOff < int32(caLen) {
			return false
		}

		m.certificateAuthorities = mxutil.Ensure(m.certificateAuthorities, 1)
		m.certificateAuthorities = push(m.certificateAuthorities, data[casOff:casOff+int32(caLen)])
		casOff += int32(caLen)
	}

	return int32(len(data))-off == 0
}

type certificateVerifyMsg struct {
	hasSignatureAlgorithm bool // format change introduced in TLS 1.2
	signatureAlgorithm    SignatureScheme
	signature             []byte
}

func (m *certificateVerifyMsg) marshal() (rb []byte, rerr error) {
	var b cryptobyte.Builder
	b.AddUint8(typeCertificateVerify)
	b.BeginUint24LengthPrefixed()
		if m.hasSignatureAlgorithm {
			b.AddUint16(uint16(m.signatureAlgorithm))
		}
		b.BeginUint16LengthPrefixed()
			b.AddBytes(m.signature)
		b.EndLengthPrefixed()
	b.EndLengthPrefixed()

	return b.Bytes()
}

func (m *certificateVerifyMsg) unmarshal(data []byte) (rok bool) {
	s := cryptobyte.String(data)

	if !s.Skip(4) { // message type and uint24 length field
		return false
	}
	if m.hasSignatureAlgorithm {
		if !s.ReadUint16((*uint16)(&m.signatureAlgorithm)) {
			return false
		}
	}
	return readUint16LengthPrefixed(&s, &m.signature) && s.Empty()
}

type newSessionTicketMsg struct {
	ticket []byte
}

func (m *newSessionTicketMsg) marshal() (rb []byte, rerr error) {
	// See RFC 5077, Section 3.3.
	ticketLen := len(m.ticket)
	length := 2 + 4 + ticketLen
	x := []byte{:4+length}
	x[0] = typeNewSessionTicket
	x[1] = uint8(length >> 16)
	x[2] = uint8(length >> 8)
	x[3] = uint8(length)
	x[8] = uint8(ticketLen >> 8)
	x[9] = uint8(ticketLen)
	mxutil.CopyAt(x, 10, m.ticket)

	return x, nil
}

func (m *newSessionTicketMsg) unmarshal(data []byte) (rok bool) {
	if len(data) < 10 {
		return false
	}

	length := uint32(data[1])<<16 | uint32(data[2])<<8 | uint32(data[3])
	if uint32(len(data))-4 != length {
		return false
	}

	ticketLen := int32(data[8])<<8 + int32(data[9])
	if len(data)-10 != ticketLen {
		return false
	}

	m.ticket = data[10:]

	return true
}

type helloRequestMsg struct {
}

func (*helloRequestMsg) marshal() (rb []byte, rerr error) {
	return []byte{typeHelloRequest, 0, 0, 0}, nil
}

func (*helloRequestMsg) unmarshal(data []byte) (rok bool) {
	return len(data) == 4
}

type transcriptHash interface {
	Write([]byte) (int32, error)
}

// transcriptMsg is a helper used to hash messages which are not hashed when
// they are read from, or written to, the wire. This is typically the case for
// messages which are either not sent, or need to be hashed out of order from
// when they are read/written.
//
// For most messages, the message is marshalled using their marshal method,
// since their wire representation is idempotent. For clientHelloMsg and
// serverHelloMsg, we store the original wire representation of the message and
// use that for hashing, since unmarshal/marshal are not idempotent due to
// extension ordering and other malleable fields, which may cause differences
// between what was received and what we marshal.
func transcriptMsg(msg handshakeMessage, h transcriptHash) (rerr error) {
	if msgWithOrig, ok := msg.(handshakeMessageWithOriginalBytes); ok {
		if orig := msgWithOrig.originalBytes(); orig != nil {
			h.Write(msgWithOrig.originalBytes())
			return nil
		}
	}

	data, err := msg.marshal()
	if err != nil {
		return err
	}
	h.Write(data)
	return nil
}
