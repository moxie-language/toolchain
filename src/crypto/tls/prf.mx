package tls

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"crypto"
	"crypto/hmac"
	"crypto/internal/fips140/tls12"
	"crypto/md5"
	"crypto/sha1"
	"crypto/sha256"
	"crypto/sha512"
	"errors"
	"fmt"
	"hash"
)

// prfFunc is the TLS 1.0-1.2 pseudo-random function. It is an interface rather
// than a func value because a closure carrying the hash constructor would
// capture the caller's frame, which Moxie does not allow.
type prfFunc interface {
	prf(secret []byte, label []byte, seed []byte, keyLen int32) (rb []byte)
}

// tls10PRF is the stateless TLS 1.0/1.1 PRF.
type tls10PRF struct{}

func (p *tls10PRF) prf(secret, label, seed []byte, keyLen int32) (rb []byte) {
	return prf10(secret, label, seed, keyLen)
}

// tls12PRF carries the hash constructor for the TLS 1.2 PRF.
type tls12PRF struct {
	hashFunc func() hash.Hash
}

func (p *tls12PRF) prf(secret, label, seed []byte, keyLen int32) (rb []byte) {
	return tls12.PRF(p.hashFunc, secret, label, seed, keyLen)
}

// Split a premaster secret in two as specified in RFC 4346, Section 5.
func splitPreMasterSecret(secret []byte) (s1, s2 []byte) {
	s1 = secret[0 : (len(secret)+1)/2]
	s2 = secret[len(secret)/2:]
	return
}

// pHash implements the P_hash function, as defined in RFC 4346, Section 5.
func pHash(result, secret, seed []byte, hfn func() hash.Hash) {
	h := hmac.New(hfn, secret)
	h.Write(seed)
	a := h.Sum(nil)

	j := 0
	for j < len(result) {
		h.Reset()
		h.Write(a)
		h.Write(seed)
		b := h.Sum(nil)
		copy(result[j:], b)
		j += len(b)

		h.Reset()
		h.Write(a)
		a = h.Sum(nil)
	}
}

// prf10 implements the TLS 1.0 pseudo-random function, as defined in RFC 2246, Section 5.
func prf10(secret []byte, label []byte, seed []byte, keyLen int32) (rb []byte) {
	result := []byte{:keyLen}
	hashSHA1 := sha1.New
	hashMD5 := md5.New

	labelAndSeed := []byte{:len(label)+len(seed)}
	copy(labelAndSeed, label)
	copy(labelAndSeed[len(label):], seed)

	s1, s2 := splitPreMasterSecret(secret)
	pHash(result, s1, labelAndSeed, hashMD5)
	result2 := []byte{:len(result)}
	pHash(result2, s2, labelAndSeed, hashSHA1)

	for i, b := range result2 {
		result[i] ^= b
	}

	return result
}

// prf12 implements the TLS 1.2 pseudo-random function, as defined in RFC 5246, Section 5.
func prf12(hashFunc func() hash.Hash) (rprfFunc prfFunc) {
	return &tls12PRF{hashFunc: hashFunc}
}

const (
	masterSecretLength   = 48 // Length of a master secret in TLS 1.1.
	finishedVerifyLength = 12 // Length of verify_data in a Finished message.
)

const masterSecretLabel = "master secret"
const extendedMasterSecretLabel = "extended master secret"
const keyExpansionLabel = "key expansion"
const clientFinishedLabel = "client finished"
const serverFinishedLabel = "server finished"

func prfAndHashForVersion(version uint16, suite *cipherSuite) (rprfFunc prfFunc, rhash crypto.Hash) {
	switch version {
	case VersionTLS10, VersionTLS11:
		return &tls10PRF{}, crypto.Hash(0)
	case VersionTLS12:
		if suite.flags&suiteSHA384 != 0 {
			return prf12(sha512.New384), crypto.SHA384
		}
		return prf12(sha256.New), crypto.SHA256
	default:
		panic("unknown version")
	}
}

func prfForVersion(version uint16, suite *cipherSuite) (rprfFunc prfFunc) {
	prf, _ := prfAndHashForVersion(version, suite)
	return prf
}

// masterFromPreMasterSecret generates the master secret from the pre-master
// secret. See RFC 5246, Section 8.1.
func masterFromPreMasterSecret(version uint16, suite *cipherSuite, preMasterSecret, clientRandom, serverRandom []byte) (rb []byte) {
	seed := []byte{:0:len(clientRandom)+len(serverRandom)}
	seed = mxutil.Ensure(seed, len(clientRandom))
	seed = push(seed, clientRandom...)
	seed = mxutil.Ensure(seed, len(serverRandom))
	seed = push(seed, serverRandom...)

	return prfForVersion(version, suite).prf(preMasterSecret, masterSecretLabel, seed, masterSecretLength)
}

// extMasterFromPreMasterSecret generates the extended master secret from the
// pre-master secret. See RFC 7627.
func extMasterFromPreMasterSecret(version uint16, suite *cipherSuite, preMasterSecret, transcript []byte) (rb []byte) {
	if version == VersionTLS12 {
		// Use the FIPS 140-3 module only for TLS 1.2 with EMS, which is the
		// only TLS 1.0-1.2 approved mode per IG D.Q.
		var hashFunc func() hash.Hash = sha256.New
		if suite.flags&suiteSHA384 != 0 {
			hashFunc = sha512.New384
		}
		return tls12.MasterSecret(hashFunc, preMasterSecret, transcript)
	}
	return prfForVersion(version, suite).prf(preMasterSecret, extendedMasterSecretLabel, transcript, masterSecretLength)
}

// keysFromMasterSecret generates the connection keys from the master
// secret, given the lengths of the MAC key, cipher key and IV, as defined in
// RFC 2246, Section 6.3.
func keysFromMasterSecret(version uint16, suite *cipherSuite, masterSecret, clientRandom, serverRandom []byte, macLen, keyLen, ivLen int32) (clientMAC, serverMAC, clientKey, serverKey, clientIV, serverIV []byte) {
	seed := []byte{:0:len(serverRandom)+len(clientRandom)}
	seed = mxutil.Ensure(seed, len(serverRandom))
	seed = push(seed, serverRandom...)
	seed = mxutil.Ensure(seed, len(clientRandom))
	seed = push(seed, clientRandom...)

	n := 2*macLen + 2*keyLen + 2*ivLen
	keyMaterial := prfForVersion(version, suite).prf(masterSecret, keyExpansionLabel, seed, n)
	clientMAC = keyMaterial[:macLen]
	keyMaterial = keyMaterial[macLen:]
	serverMAC = keyMaterial[:macLen]
	keyMaterial = keyMaterial[macLen:]
	clientKey = keyMaterial[:keyLen]
	keyMaterial = keyMaterial[keyLen:]
	serverKey = keyMaterial[:keyLen]
	keyMaterial = keyMaterial[keyLen:]
	clientIV = keyMaterial[:ivLen]
	keyMaterial = keyMaterial[ivLen:]
	serverIV = keyMaterial[:ivLen]
	return
}

func newFinishedHash(version uint16, cs *cipherSuite) (rfinishedHash finishedHash) {
	var buffer []byte
	if version >= VersionTLS12 {
		buffer = []byte{}
	}

	prf, h := prfAndHashForVersion(version, cs)
	if h != 0 {
		return finishedHash{crypto.HashNew(h), crypto.HashNew(h), nil, nil, buffer, version, prf}
	}

	return finishedHash{sha1.New(), sha1.New(), md5.New(), md5.New(), buffer, version, prf}
}

// A finishedHash calculates the hash of a set of handshake messages suitable
// for including in a Finished message.
type finishedHash struct {
	client hash.Hash
	server hash.Hash

	// Prior to TLS 1.2, an additional MD5 hash is required.
	clientMD5 hash.Hash
	serverMD5 hash.Hash

	// In TLS 1.2, a full buffer is sadly required.
	buffer []byte

	version uint16
	prf     prfFunc
}

func (h *finishedHash) Write(msg []byte) (n int32, err error) {
	h.client.Write(msg)
	h.server.Write(msg)

	if h.version < VersionTLS12 {
		h.clientMD5.Write(msg)
		h.serverMD5.Write(msg)
	}

	if h.buffer != nil {
		h.buffer = mxutil.Ensure(h.buffer, len(msg))
		h.buffer = push(h.buffer, msg...)
	}

	return len(msg), nil
}

func (h *finishedHash) Sum() (rb []byte) {
	if h.version >= VersionTLS12 {
		return h.client.Sum(nil)
	}

	out := []byte{:0:md5.Size+sha1.Size}
	out = h.clientMD5.Sum(out)
	return h.client.Sum(out)
}

// clientSum returns the contents of the verify_data member of a client's
// Finished message.
func (h *finishedHash) clientSum(masterSecret []byte) (rb []byte) {
	return h.prf.prf(masterSecret, clientFinishedLabel, h.Sum(), finishedVerifyLength)
}

// serverSum returns the contents of the verify_data member of a server's
// Finished message.
func (h *finishedHash) serverSum(masterSecret []byte) (rb []byte) {
	return h.prf.prf(masterSecret, serverFinishedLabel, h.Sum(), finishedVerifyLength)
}

// hashForClientCertificate returns the handshake messages so far, pre-hashed,
// suitable for signing by a TLS 1.0 and 1.1 client certificate.
func (h *finishedHash) hashForClientCertificate(sigType uint8) (rb []byte) {
	if sigType == signatureECDSA {
		return h.server.Sum(nil)
	}

	return h.Sum()
}

// discardHandshakeBuffer is called when there is no more need to
// buffer the entirety of the handshake messages.
func (h *finishedHash) discardHandshakeBuffer() {
	h.buffer = nil
}

// ekmFunc exports keying material, or fails for a policy reason. It is an
// interface rather than a func value because the closure would capture the
// enclosing frame, which Moxie does not allow.
type ekmFunc interface {
	ekm(label []byte, ctxInfo []byte, length int32) (rb []byte, rerr error)
}

// noEKMRenegotiation fails every key-material export when renegotiation is
// enabled.
type noEKMRenegotiation struct{}

func (n *noEKMRenegotiation) ekm(label []byte, ctxInfo []byte, length int32) (rb []byte, rerr error) {
	return nil, errors.New("crypto/tls: ExportKeyingMaterial is unavailable when renegotiation is enabled")
}

// noEKMNoEMS fails every key-material export when neither TLS 1.3 nor Extended
// Master Secret is negotiated.
type noEKMNoEMS struct{}

func (n *noEKMNoEMS) ekm(label []byte, ctxInfo []byte, length int32) (rb []byte, rerr error) {
	return nil, errors.New("crypto/tls: ExportKeyingMaterial is unavailable when neither TLS 1.3 nor Extended Master Secret are negotiated; override with GODEBUG=tlsunsafeekm=1")
}

// ekmFromMasterSecretState generates exported keying material as defined in
// RFC 5705.
type ekmFromMasterSecretState struct {
	version      uint16
	suite        *cipherSuite
	masterSecret []byte
	clientRandom []byte
	serverRandom []byte
}

// ekmFromMasterSecret generates exported keying material as defined in RFC 5705.
func ekmFromMasterSecret(version uint16, suite *cipherSuite, masterSecret, clientRandom, serverRandom []byte) (rekm ekmFunc) {
	return &ekmFromMasterSecretState{
		version:      version,
		suite:        suite,
		masterSecret: masterSecret,
		clientRandom: clientRandom,
		serverRandom: serverRandom,
	}
}

func (e *ekmFromMasterSecretState) ekm(label []byte, ctxInfo []byte, length int32) (rb []byte, rerr error) {
	switch label {
	case "client finished", "server finished", "master secret", "key expansion":
		// These values are reserved and may not be used.
		return nil, fmt.Errorf("crypto/tls: reserved ExportKeyingMaterial label: %s", label)
	}

	seedLen := len(e.serverRandom) + len(e.clientRandom)
	if ctxInfo != nil {
		seedLen += 2 + len(ctxInfo)
	}
	seed := []byte{:0:seedLen}

	seed = mxutil.Ensure(seed, len(e.clientRandom))
	seed = push(seed, e.clientRandom...)
	seed = mxutil.Ensure(seed, len(e.serverRandom))
	seed = push(seed, e.serverRandom...)

	if ctxInfo != nil {
		if len(ctxInfo) >= 1<<16 {
			return nil, fmt.Errorf("crypto/tls: ExportKeyingMaterial ctxInfo too long")
		}
		seed = mxutil.Ensure(seed, 1)
		seed = push(seed, byte(len(ctxInfo)>>8), byte(len(ctxInfo)))
		seed = mxutil.Ensure(seed, len(ctxInfo))
		seed = push(seed, ctxInfo...)
	}

	return prfForVersion(e.version, e.suite).prf(e.masterSecret, label, seed, length), nil
}
