// Moxie TLS stubs. Real TLS requires the full Go crypto/tls which
// depends on net — now that net compiles, we can use Go's real
// crypto/tls. For now, provide the minimal API surface needed by
// packages that import crypto/tls (like net/http).

package tls

import (
	"context"
	"errors"
	"net"
	"time"
)

// Client returns a new TLS client side connection.
func Client(conn net.Conn, config *Config) *Conn {
	return &Conn{conn: conn, config: config}
}

// Server returns a new TLS server side connection.
func Server(conn net.Conn, config *Config) *Conn {
	return &Conn{conn: conn, config: config, isClient: false}
}

// Conn represents a TLS connection. Stub implementation.
type Conn struct {
	conn     net.Conn
	config   *Config
	isClient bool
}

func (c *Conn) Read(b []byte) (int, error)  { return c.conn.Read(b) }
func (c *Conn) Write(b []byte) (int, error) { return c.conn.Write(b) }
func (c *Conn) Close() error                { return c.conn.Close() }
func (c *Conn) LocalAddr() net.Addr         { return c.conn.LocalAddr() }
func (c *Conn) RemoteAddr() net.Addr        { return c.conn.RemoteAddr() }

func (c *Conn) SetDeadline(t time.Time) error      { return c.conn.SetDeadline(t) }
func (c *Conn) SetReadDeadline(t time.Time) error  { return c.conn.SetReadDeadline(t) }
func (c *Conn) SetWriteDeadline(t time.Time) error { return c.conn.SetWriteDeadline(t) }

func (c *Conn) Handshake() error                         { return errors.New("tls: handshake not implemented") }
func (c *Conn) HandshakeContext(_ context.Context) error { return c.Handshake() }
func (c *Conn) ConnectionState() ConnectionState         { return ConnectionState{} }
func (c *Conn) CloseWrite() error                        { return nil }
func (c *Conn) NetConn() net.Conn                        { return c.conn }

// Types Config, Certificate, ConnectionState, ClientHelloInfo,
// ClientAuthType, RenegotiationSupport, version constants, and CurveID
// are all defined in common.go.

type listener struct {
	net.Listener
	config *Config
}

func NewListener(inner net.Listener, config *Config) net.Listener {
	return &listener{Listener: inner, config: config}
}

func (l *listener) Accept() (net.Conn, error) {
	c, err := l.Listener.Accept()
	if err != nil {
		return nil, err
	}
	return Server(c, l.config), nil
}

type Dialer struct {
	NetDialer *net.Dialer
	Config    *Config
}

func (d *Dialer) DialContext(ctx context.Context, network, addr []byte) (net.Conn, error) {
	return nil, errors.New("tls: dial not implemented")
}

func DialWithDialer(dialer *net.Dialer, network, addr []byte, config *Config) (*Conn, error) {
	return nil, errors.New("tls: dial not implemented")
}

func Dial(network, addr []byte, config *Config) (*Conn, error) {
	return nil, errors.New("tls: dial not implemented")
}

func LoadX509KeyPair(certFile, keyFile []byte) (Certificate, error) {
	return Certificate{}, errors.New("tls: LoadX509KeyPair not implemented")
}

func X509KeyPair(certPEM, keyPEM []byte) (Certificate, error) {
	return Certificate{}, errors.New("tls: X509KeyPair not implemented")
}

type RecordHeaderError struct {
	Msg          []byte
	RecordHeader [5]byte
	Conn         net.Conn
}

func (e RecordHeaderError) Error() string { return "tls: " + e.Msg }

type AlertError uint8

func (e AlertError) Error() string { return "tls: alert" }
