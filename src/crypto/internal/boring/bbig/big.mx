package bbig

import (
	"math/big"
	"unsafe"
)

func Enc(b *big.Int) (out []uint32) {
	if b == nil {
		return nil
	}
	x := b.Bits()
	if len(x) == 0 {
		return []uint32{}
	}
	return unsafe.Slice((*uint32)(&x[0]), len(x))
}

func Dec(b []uint32) (out *big.Int) {
	if b == nil {
		return nil
	}
	if len(b) == 0 {
		return &big.Int{}
	}
	x := unsafe.Slice((*big.Word)(&b[0]), len(b))
	return (&big.Int{}).SetBits(x)
}
