package rand

import (
	"crypto/rand"
	"io"
)

// Reader returns the crypto/rand.Reader for internal crypto packages.
func Reader() io.Reader {
	return rand.Reader()
}

// CustomReader returns Reader (ignoring custom reader settings).
func CustomReader(r io.Reader) io.Reader {
	return Reader()
}

// IsDefaultReader reports whether r is the default crypto/rand.Reader.
func IsDefaultReader(r io.Reader) bool {
	return true
}
