//:build js && wasm

package sysrand

const maxGetRandomRead = 64 << 10

//:wasmimport bridge subtle_random_bytes
func randomFill(ptr *byte, length int32, capacity int32)

func read(b []byte) (jerr error) {
	// Offset cursor, not b = b[size:]: a sub-slice is a copy under the slice
	// rule, so every chunk after the first filled a throwaway.
	off := int32(0)
	for off < int32(len(b)) {
		size := int32(len(b)) - off
		if size > maxGetRandomRead {
			size = maxGetRandomRead
		}
		randomFill(&b[off], size, size)
		off += size
	}
	return nil
}
