//:build js && wasm

package sysrand

const maxGetRandomRead = 64 << 10

//:wasmimport bridge subtle_random_bytes
func randomFill(ptr *byte, len int32, cap int32)

func read(b []byte) error {
	for len(b) > 0 {
		size := len(b)
		if size > maxGetRandomRead {
			size = maxGetRandomRead
		}
		randomFill(&b[0], int32(size), int32(size))
		b = b[size:]
	}
	return nil
}
