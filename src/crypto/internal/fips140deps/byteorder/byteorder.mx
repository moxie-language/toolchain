package byteorder

import (
	"internal/byteorder"
)

func LEUint16(b []byte) (v uint16) {
	return byteorder.LEUint16(b)
}

func BEUint32(b []byte) (v uint32) {
	return byteorder.BEUint32(b)
}

func BEUint64(b []byte) (v uint64) {
	return byteorder.BEUint64(b)
}

func LEUint64(b []byte) (v uint64) {
	return byteorder.LEUint64(b)
}

func BEPutUint16(b []byte, v uint16) {
	byteorder.BEPutUint16(b, v)
}

func BEPutUint32(b []byte, v uint32) {
	byteorder.BEPutUint32(b, v)
}

func BEPutUint64(b []byte, v uint64) {
	byteorder.BEPutUint64(b, v)
}

func LEPutUint64(b []byte, v uint64) {
	byteorder.LEPutUint64(b, v)
}

func BEAppendUint16(b []byte, v uint16) (out []byte) {
	return byteorder.BEAppendUint16(b, v)
}

func BEAppendUint32(b []byte, v uint32) (out []byte) {
	return byteorder.BEAppendUint32(b, v)
}

func BEAppendUint64(b []byte, v uint64) (out []byte) {
	return byteorder.BEAppendUint64(b, v)
}

// The At forms read and write at an offset inside a buffer the caller keeps
// whole. A cursor walk cannot pass b[off:] - a sub-slice is a copy, so the
// read would come from a copy and the write would land in one - which is why
// these are index-based rather than wrappers over the forms above.

func BEUint16At(b []byte, off int32) (v uint16) {
	return byteorder.BEUint16At(b, off)
}

func LEUint16At(b []byte, off int32) (v uint16) {
	return byteorder.LEUint16At(b, off)
}

func BEPutUint16At(b []byte, off int32, v uint16) {
	byteorder.BEPutUint16At(b, off, v)
}

func LEPutUint16At(b []byte, off int32, v uint16) {
	byteorder.LEPutUint16At(b, off, v)
}

func BEUint32At(b []byte, off int32) (v uint32) {
	return byteorder.BEUint32At(b, off)
}

func BEUint64At(b []byte, off int32) (v uint64) {
	return byteorder.BEUint64At(b, off)
}

func LEUint64At(b []byte, off int32) (v uint64) {
	return byteorder.LEUint64At(b, off)
}

func BEPutUint32At(b []byte, off int32, v uint32) {
	byteorder.BEPutUint32At(b, off, v)
}

func BEPutUint64At(b []byte, off int32, v uint64) {
	byteorder.BEPutUint64At(b, off, v)
}

func LEPutUint64At(b []byte, off int32, v uint64) {
	byteorder.LEPutUint64At(b, off, v)
}

func LEUint32At(b []byte, off int32) (v uint32) {
	return byteorder.LEUint32At(b, off)
}

func LEPutUint32At(b []byte, off int32, v uint32) {
	byteorder.LEPutUint32At(b, off, v)
}
