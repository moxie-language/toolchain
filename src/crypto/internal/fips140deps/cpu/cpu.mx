package cpu

import (
	"internal/cpu"
	"internal/goarch"
)

const (
	BigEndian = goarch.BigEndian
	AMD64     = goarch.IsAmd64 == 1
	ARM64     = goarch.IsArm64 == 1
	PPC64     = goarch.IsPpc64 == 1
	PPC64le   = goarch.IsPpc64le == 1
)

func ARM64HasAES() bool    { return cpu.ARM64.HasAES }
func ARM64HasPMULL() bool  { return cpu.ARM64.HasPMULL }
func ARM64HasSHA2() bool   { return cpu.ARM64.HasSHA2 }
func ARM64HasSHA512() bool { return cpu.ARM64.HasSHA512 }
func ARM64HasSHA3() bool   { return cpu.ARM64.HasSHA3 }

func LOONG64HasLSX() bool  { return cpu.Loong64.HasLSX }
func LOONG64HasLASX() bool { return cpu.Loong64.HasLASX }

func S390XHasAES() bool    { return cpu.S390X.HasAES }
func S390XHasAESCBC() bool { return cpu.S390X.HasAESCBC }
func S390XHasAESCTR() bool { return cpu.S390X.HasAESCTR }
func S390XHasAESGCM() bool { return cpu.S390X.HasAESGCM }
func S390XHasECDSA() bool  { return cpu.S390X.HasECDSA }
func S390XHasGHASH() bool  { return cpu.S390X.HasGHASH }
func S390XHasSHA256() bool { return cpu.S390X.HasSHA256 }
func S390XHasSHA3() bool   { return cpu.S390X.HasSHA3 }
func S390XHasSHA512() bool { return cpu.S390X.HasSHA512 }

func X86HasAES() bool       { return cpu.X86.HasAES }
func X86HasADX() bool       { return cpu.X86.HasADX }
func X86HasAVX() bool       { return cpu.X86.HasAVX }
func X86HasAVX2() bool      { return cpu.X86.HasAVX2 }
func X86HasBMI2() bool      { return cpu.X86.HasBMI2 }
func X86HasPCLMULQDQ() bool { return cpu.X86.HasPCLMULQDQ }
func X86HasSHA() bool       { return cpu.X86.HasSHA }
func X86HasSSE41() bool     { return cpu.X86.HasSSE41 }
func X86HasSSSE3() bool     { return cpu.X86.HasSSSE3 }
