package cpu

import (
	"internal/cpu"
	"internal/goarch"
)

const (
	BigEndian = goarch.BigEndian
	AMD64     = goarch.IsAmd64 == 1
	ARM64     = goarch.IsArm64 == 1
)

func ARM64HasAES() (has bool)    { return cpu.ARM64.HasAES }
func ARM64HasPMULL() (has bool)  { return cpu.ARM64.HasPMULL }
func ARM64HasSHA2() (has bool)   { return cpu.ARM64.HasSHA2 }
func ARM64HasSHA512() (has bool) { return cpu.ARM64.HasSHA512 }
func ARM64HasSHA3() (has bool)   { return cpu.ARM64.HasSHA3 }

func LOONG64HasLSX() (has bool)  { return cpu.Loong64.HasLSX }
func LOONG64HasLASX() (has bool) { return cpu.Loong64.HasLASX }

func S390XHasAES() (has bool)    { return cpu.S390X.HasAES }
func S390XHasAESCBC() (has bool) { return cpu.S390X.HasAESCBC }
func S390XHasAESCTR() (has bool) { return cpu.S390X.HasAESCTR }
func S390XHasAESGCM() (has bool) { return cpu.S390X.HasAESGCM }
func S390XHasECDSA() (has bool)  { return cpu.S390X.HasECDSA }
func S390XHasGHASH() (has bool)  { return cpu.S390X.HasGHASH }
func S390XHasSHA256() (has bool) { return cpu.S390X.HasSHA256 }
func S390XHasSHA3() (has bool)   { return cpu.S390X.HasSHA3 }
func S390XHasSHA512() (has bool) { return cpu.S390X.HasSHA512 }

func X86HasAES() (has bool)       { return cpu.X86.HasAES }
func X86HasADX() (has bool)       { return cpu.X86.HasADX }
func X86HasAVX() (has bool)       { return cpu.X86.HasAVX }
func X86HasAVX2() (has bool)      { return cpu.X86.HasAVX2 }
func X86HasBMI2() (has bool)      { return cpu.X86.HasBMI2 }
func X86HasPCLMULQDQ() (has bool) { return cpu.X86.HasPCLMULQDQ }
func X86HasSHA() (has bool)       { return cpu.X86.HasSHA }
func X86HasSSE41() (has bool)     { return cpu.X86.HasSSE41 }
func X86HasSSSE3() (has bool)     { return cpu.X86.HasSSSE3 }
