//:build (amd64 || arm64) && !purego

package aes

// Moxie has no assembler backend, so these are the generic block loops. The
// *[N]BlockSize parameters they used to carry existed only to hand a
// fixed-size array to asm - the Go slice bypass - and went with the arrays;
// the caller passes the block slices directly.

func ctrBlocks1(b *Block, dst []byte, dstOff int32, n int32, src []byte, srcOff int32, ivlo, ivhi uint64) {
	ctrBlocks(b, dst, dstOff, n, src, srcOff, ivlo, ivhi)
}

func ctrBlocks2(b *Block, dst []byte, dstOff int32, n int32, src []byte, srcOff int32, ivlo, ivhi uint64) {
	ctrBlocks(b, dst, dstOff, n, src, srcOff, ivlo, ivhi)
}

func ctrBlocks4(b *Block, dst []byte, dstOff int32, n int32, src []byte, srcOff int32, ivlo, ivhi uint64) {
	ctrBlocks(b, dst, dstOff, n, src, srcOff, ivlo, ivhi)
}

func ctrBlocks8(b *Block, dst []byte, dstOff int32, n int32, src []byte, srcOff int32, ivlo, ivhi uint64) {
	ctrBlocks(b, dst, dstOff, n, src, srcOff, ivlo, ivhi)
}
