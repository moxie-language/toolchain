//:build (!amd64 && !arm64) || purego

package gcm

func checkGenericIsExpected() {}

type gcmPlatformData struct{}

func initGCM(g *GCM) {}

func seal(g *GCM, nonce, plaintext, data []byte) (out []byte) {
	return sealGeneric(g, nonce, plaintext, data)
}

func open(g *GCM, nonce, ciphertext, data []byte) (out []byte, err error) {
	return openGeneric(g, nonce, ciphertext, data)
}
