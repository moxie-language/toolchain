package gcm

import (
	"crypto/internal/fips140/aes"
	"crypto/internal/fips140/subtle"
	"crypto/internal/fips140deps/byteorder"
)

func sealGeneric(g *GCM, nonce, plaintext, additionalData []byte) (out []byte) {
	H := []byte{:gcmBlockSize}
	counter := []byte{:gcmBlockSize}
	tagMask := []byte{:gcmBlockSize}
	aes.EncryptBlockInternal(&g.cipher, H, H)
	deriveCounterGeneric(H, counter, nonce)
	gcmCounterCryptGeneric(&g.cipher, tagMask, tagMask, counter)

	// Moxie has no aliasing: a slice handed back alongside another over the
	// same buffer is relocated, so writing through the out half of a
	// sliceForAppend pair comes back zeros at the caller. Seal into a slice
	// this function owns and return it; the caller copies it into place.
	out = []byte{:len(plaintext) + gcmTagSize}
	gcmCounterCryptGeneric(&g.cipher, out, plaintext, counter)

	tag := []byte{:gcmTagSize}
	gcmAuthGeneric(tag, H, tagMask, out[:len(plaintext)], additionalData)
	for i := int32(0); i < g.tagSize; i++ {
		out[len(plaintext)+i] = tag[i]
	}
	return out
}

func openGeneric(g *GCM, nonce, ciphertext, additionalData []byte) (out []byte, err error) {
	H := []byte{:gcmBlockSize}
	counter := []byte{:gcmBlockSize}
	tagMask := []byte{:gcmBlockSize}
	aes.EncryptBlockInternal(&g.cipher, H, H)
	deriveCounterGeneric(H, counter, nonce)
	gcmCounterCryptGeneric(&g.cipher, tagMask, tagMask, counter)

	tag := ciphertext[len(ciphertext)-g.tagSize:]
	ciphertext = resize(ciphertext, len(ciphertext)-g.tagSize)

	expectedTag := []byte{:gcmTagSize}
	gcmAuthGeneric(expectedTag, H, tagMask, ciphertext, additionalData)
	if subtle.ConstantTimeCompare(expectedTag[:g.tagSize], tag) != 1 {
		return nil, errOpen
	}

	out = []byte{:len(ciphertext)}
	gcmCounterCryptGeneric(&g.cipher, out, ciphertext, counter)
	return out, nil
}

// deriveCounterGeneric computes the initial GCM counter state from the given nonce.
// See NIST SP 800-38D, section 7.1. This assumes that counter is filled with
// zeros on entry.
func deriveCounterGeneric(H, counter []byte, nonce []byte) {
	// GCM has two modes of operation with respect to the initial counter
	// state: a "fast path" for 96-bit (12-byte) nonces, and a "slow path"
	// for nonces of other lengths. For a 96-bit nonce, the nonce, along
	// with a four-byte big-endian counter starting at one, is used
	// directly as the starting counter. For other nonce sizes, the counter
	// is computed by passing it through the GHASH function.
	if len(nonce) == gcmStandardNonceSize {
		copy(counter, nonce)
		counter[gcmBlockSize-1] = 1
	} else {
		lenBlock := []byte{:16}
		byteorder.BEPutUint64(lenBlock[8:], uint64(len(nonce))*8)
		ghash(counter, H, nonce, lenBlock)
	}
}

// gcmCounterCryptGeneric encrypts src using AES in counter mode with 32-bit
// wrapping (which is different from AES-CTR) and places the result into out.
// counter is the initial value and will be updated with the next value.
func gcmCounterCryptGeneric(b *aes.Block, out, src []byte, counter []byte) {
	mask := []byte{:gcmBlockSize}
	pos := int32(0)

	for len(src)-pos >= gcmBlockSize {
		aes.EncryptBlockInternal(b, mask, counter)
		gcmInc32(counter)

		subtle.XORBytesAt(out, pos, src, pos, mask, 0, gcmBlockSize)
		pos += gcmBlockSize
	}

	if n := int32(len(src)) - pos; n > 0 {
		aes.EncryptBlockInternal(b, mask, counter)
		gcmInc32(counter)
		subtle.XORBytesAt(out, pos, src, pos, mask, 0, n)
	}
}

// gcmInc32 treats the final four bytes of counterBlock as a big-endian value
// and increments it.
func gcmInc32(counterBlock []byte) {
	off := int32(len(counterBlock)) - 4
	byteorder.BEPutUint32At(counterBlock, off, byteorder.BEUint32At(counterBlock, off)+1)
}

// gcmAuthGeneric calculates GHASH(additionalData, ciphertext), masks the result
// with tagMask and writes the result to out.
func gcmAuthGeneric(out []byte, H, tagMask []byte, ciphertext, additionalData []byte) {
	checkGenericIsExpected()
	lenBlock := []byte{:16}
	byteorder.BEPutUint64(lenBlock[:8], uint64(len(additionalData))*8)
	byteorder.BEPutUint64(lenBlock[8:], uint64(len(ciphertext))*8)
	S := []byte{:gcmBlockSize}
	ghash(S, H, additionalData, ciphertext, lenBlock)
	subtle.XORBytes(out, S, tagMask)
}
