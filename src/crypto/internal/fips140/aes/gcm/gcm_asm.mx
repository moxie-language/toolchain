//:build (amd64 || arm64) && !purego

package gcm

import (
	"moxielang.dev/pkg/mxutil"
	"crypto/internal/fips140/aes"
	"crypto/internal/fips140/subtle"
	"crypto/internal/fips140deps/cpu"
)

// The following functions are defined in gcm_*.s.

func gcmAesInit(productTable []byte, ks []uint32) {
	panic("gcm: asm not available")
}

func gcmAesData(productTable []byte, data []byte, T []byte) {
	panic("gcm: asm not available")
}

func gcmAesEnc(productTable []byte, dst, src []byte, ctr, T []byte, ks []uint32) {
	panic("gcm: asm not available")
}

func gcmAesDec(productTable []byte, dst, src []byte, ctr, T []byte, ks []uint32) {
	panic("gcm: asm not available")
}

func gcmAesFinish(productTable []byte, tagMask, T []byte, pLen, dLen uint64) {
	panic("gcm: asm not available")
}

// Keep in sync with crypto/tls.hasAESGCMHardwareSupport.
func supportsAESGCM() (ret0 bool) {
	return cpu.X86HasAES() && cpu.X86HasPCLMULQDQ() && cpu.X86HasSSE41() && cpu.X86HasSSSE3() ||
		cpu.ARM64HasAES() && cpu.ARM64HasPMULL()
}

// checkGenericIsExpected is called by the variable-time implementation to make
// sure it is not used when hardware support is available. It shouldn't happen,
// but this way it's more evidently correct.
func checkGenericIsExpected() {
	if supportsAESGCM() {
		panic("gcm: internal error: using generic implementation despite hardware support")
	}
}

type gcmPlatformData struct {
	productTable []byte
}

func initGCM(g *GCM) {
	if !supportsAESGCM() {
		return
	}
	g.productTable = []byte{:256}
	gcmAesInit(g.productTable, aes.EncryptionKeySchedule(&g.cipher))
}

func seal(g *GCM, nonce, plaintext, data []byte) (out []byte) {
	if !supportsAESGCM() {
		return sealGeneric(g, nonce, plaintext, data)
	}

	counter := []byte{:gcmBlockSize}
	tagMask := []byte{:gcmBlockSize}

	if len(nonce) == gcmStandardNonceSize {
		// Init counter to nonce||1
		copy(counter, nonce)
		counter[gcmBlockSize-1] = 1
	} else {
		// Otherwise counter = GHASH(nonce)
		gcmAesData(g.productTable, nonce, counter)
		gcmAesFinish(g.productTable, tagMask, counter, uint64(len(nonce)), uint64(0))
	}

	aes.EncryptBlockInternal(&g.cipher, tagMask, counter)

	tagOut := []byte{:gcmTagSize}
	gcmAesData(g.productTable, data, tagOut)

	out = []byte{:len(plaintext) + gcmTagSize}
	if len(plaintext) > 0 {
		gcmAesEnc(g.productTable, out, plaintext, counter, tagOut, aes.EncryptionKeySchedule(&g.cipher))
	}
	gcmAesFinish(g.productTable, tagMask, tagOut, uint64(len(plaintext)), uint64(len(data)))
	mxutil.CopyAt(out, len(plaintext), tagOut)
	return out
}

func open(g *GCM, nonce, ciphertext, data []byte) (out []byte, err error) {
	if !supportsAESGCM() {
		return openGeneric(g, nonce, ciphertext, data)
	}

	tag := ciphertext[len(ciphertext)-g.tagSize:]
	ciphertext = resize(ciphertext, len(ciphertext)-g.tagSize)

	// See GCM spec, section 7.1.
	counter := []byte{:gcmBlockSize}
	tagMask := []byte{:gcmBlockSize}

	if len(nonce) == gcmStandardNonceSize {
		// Init counter to nonce||1
		copy(counter, nonce)
		counter[gcmBlockSize-1] = 1
	} else {
		// Otherwise counter = GHASH(nonce)
		gcmAesData(g.productTable, nonce, counter)
		gcmAesFinish(g.productTable, tagMask, counter, uint64(len(nonce)), uint64(0))
	}

	aes.EncryptBlockInternal(&g.cipher, tagMask, counter)

	expectedTag := []byte{:gcmTagSize}
	gcmAesData(g.productTable, data, expectedTag)

	out = []byte{:len(ciphertext)}
	if len(ciphertext) > 0 {
		gcmAesDec(g.productTable, out, ciphertext, counter, expectedTag, aes.EncryptionKeySchedule(&g.cipher))
	}
	gcmAesFinish(g.productTable, tagMask, expectedTag, uint64(len(ciphertext)), uint64(len(data)))

	if subtle.ConstantTimeCompare(expectedTag[:g.tagSize], tag) != 1 {
		return nil, errOpen
	}
	return out, nil
}
