package aes

import (
	"crypto/internal/fips140"
	"crypto/internal/fips140/alias"
)

type CBCEncrypter struct {
	b  Block
	iv []byte
}

// NewCBCEncrypter returns a [cipher.BlockMode] which encrypts in cipher block
// chaining mode, using the given Block.
func NewCBCEncrypter(b *Block, iv []byte) (ret0 *CBCEncrypter) {
	c := &CBCEncrypter{b: *b}
	c.iv = []byte{:BlockSize}
	copy(c.iv, iv)
	return c
}

func (c *CBCEncrypter) BlockSize() (ret0 int32) { return BlockSize }

func (c *CBCEncrypter) CryptBlocks(dst, src []byte) {
	if len(src)%BlockSize != 0 {
		panic("crypto/cipher: input not full blocks")
	}
	if len(dst) < len(src) {
		panic("crypto/cipher: output smaller than input")
	}
	if alias.InexactOverlap(dst[:len(src)], src) {
		panic("crypto/cipher: invalid buffer overlap")
	}
	fips140.RecordApproved()
	if len(src) == 0 {
		return
	}
	cryptBlocksEnc(&c.b, c.iv, dst, src)
}

func (x *CBCEncrypter) SetIV(iv []byte) {
	if len(iv) != len(x.iv) {
		panic("cipher: incorrect length IV")
	}
	copy(x.iv, iv)
}

func cryptBlocksEncGeneric(b *Block, civ []byte, dst, src []byte) {
	// The block walks by offset and stages the ciphertext in an array: a
	// sub-slice of dst or src is a copy, so dst[pos:pos+16] passed to the
	// block function would be a throwaway.
	blk := []byte{:BlockSize}
	pos := int32(0)
	for int32(len(src))-pos > 0 {
		for j := int32(0); j < BlockSize; j++ {
			blk[j] = src[pos+j] ^ civ[j]
		}
		encryptBlock(b, blk, blk)
		// The ciphertext is both the output and the next iv.
		for j := int32(0); j < BlockSize; j++ {
			dst[pos+j] = blk[j]
			civ[j] = blk[j]
		}
		pos += BlockSize
	}
}

type CBCDecrypter struct {
	b  Block
	iv []byte
}

// NewCBCDecrypter returns a [cipher.BlockMode] which decrypts in cipher block
// chaining mode, using the given Block.
func NewCBCDecrypter(b *Block, iv []byte) (ret0 *CBCDecrypter) {
	c := &CBCDecrypter{b: *b}
	c.iv = []byte{:BlockSize}
	copy(c.iv, iv)
	return c
}

func (c *CBCDecrypter) BlockSize() (ret0 int32) { return BlockSize }

func (c *CBCDecrypter) CryptBlocks(dst, src []byte) {
	if len(src)%BlockSize != 0 {
		panic("crypto/cipher: input not full blocks")
	}
	if len(dst) < len(src) {
		panic("crypto/cipher: output smaller than input")
	}
	if alias.InexactOverlap(dst[:len(src)], src) {
		panic("crypto/cipher: invalid buffer overlap")
	}
	fips140.RecordApproved()
	if len(src) == 0 {
		return
	}
	cryptBlocksDec(&c.b, c.iv, dst, src)
}

func (x *CBCDecrypter) SetIV(iv []byte) {
	if len(iv) != len(x.iv) {
		panic("cipher: incorrect length IV")
	}
	copy(x.iv, iv)
}

func cryptBlocksDecGeneric(b *Block, civ []byte, dst, src []byte) {
	// For each block, we need to xor the decrypted data with the previous
	// block's ciphertext (the iv). To avoid making a copy each time, we loop
	// over the blocks backwards.
	end := int32(len(src))
	start := end - BlockSize
	prev := start - BlockSize

	// Copy the last block of ciphertext as the IV of the next call.
	iv := []byte{:BlockSize}
	for j := int32(0); j < BlockSize; j++ {
		iv[j] = civ[j]
		civ[j] = src[start+j]
	}

	blk := []byte{:BlockSize}
	for start >= 0 {
		for j := int32(0); j < BlockSize; j++ {
			blk[j] = src[start+j]
		}
		decryptBlock(b, blk, blk)

		if start > 0 {
			for j := int32(0); j < BlockSize; j++ {
				dst[start+j] = blk[j] ^ src[prev+j]
			}
		} else {
			// The first block is special because it uses the saved iv.
			for j := int32(0); j < BlockSize; j++ {
				dst[start+j] = blk[j] ^ iv[j]
			}
		}

		end -= BlockSize
		start -= BlockSize
		prev -= BlockSize
	}
}
