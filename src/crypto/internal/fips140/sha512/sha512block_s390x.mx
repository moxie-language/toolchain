//go:build !purego

package sha512

import (
	"crypto/internal/fips140deps/cpu"
)

func useSHA512() bool { return cpu.S390XHasSHA512() }

//go:noescape
func blockS390X(dig *Digest, p []byte)

func block(dig *Digest, p []byte) {
	if useSHA512() {
		blockS390X(dig, p)
	} else {
		blockGeneric(dig, p)
	}
}
