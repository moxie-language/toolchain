//go:build (ppc64 || ppc64le) && !purego

package sha512

const ppc64sha512 = true

//go:noescape
func blockPOWER(dig *Digest, p []byte)

func block(dig *Digest, p []byte) {
	if ppc64sha512 {
		blockPOWER(dig, p)
	} else {
		blockGeneric(dig, p)
	}
}
