//:build !purego

package sha512

import (
	"crypto/internal/fips140deps/cpu"
)

func useSHA512() (ret0 bool) { return cpu.ARM64HasSHA512() }

//:noescape
func blockSHA512(dig *Digest, p []byte)

func block(dig *Digest, p []byte) {
	if useSHA512() {
		blockSHA512(dig, p)
	} else {
		blockGeneric(dig, p)
	}
}
