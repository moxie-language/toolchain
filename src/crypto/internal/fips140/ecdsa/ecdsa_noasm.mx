package ecdsa

func sign[P Point[P]](c *Curve[P], priv *PrivateKey, gen *hmacDRBG, digest []byte) (*Signature, error) {
	return signGeneric(c, priv, gen, digest)
}

func verify[P Point[P]](c *Curve[P], pub *PublicKey, digest []byte, sig *Signature) error {
	return verifyGeneric(c, pub, digest, sig)
}
