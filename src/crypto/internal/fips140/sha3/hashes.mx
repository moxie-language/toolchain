package sha3

// newDigest returns a Digest with its 200-byte permutation state allocated.
// The state is the digest's own storage, so it is allocated here and the
// return relocation carries it; a lazy allocation inside a method would land
// in the digest's sovereign arena instead.
func newDigest(rate, outputLen int32, dsbyte byte) (out *Digest) {
	return &Digest{a: []byte{:1600 / 8}, rate: rate, outputLen: outputLen, dsbyte: dsbyte}
}

// New224 returns a new Digest computing the SHA3-224 hash.
func New224() (ret0 *Digest) {
	return newDigest(rateK448, 28, dsbyteSHA3)
}

// New256 returns a new Digest computing the SHA3-256 hash.
func New256() (ret0 *Digest) {
	return newDigest(rateK512, 32, dsbyteSHA3)
}

// New384 returns a new Digest computing the SHA3-384 hash.
func New384() (ret0 *Digest) {
	return newDigest(rateK768, 48, dsbyteSHA3)
}

// New512 returns a new Digest computing the SHA3-512 hash.
func New512() (ret0 *Digest) {
	return newDigest(rateK1024, 64, dsbyteSHA3)
}

// TODO(fips): do this in the stdlib crypto/sha3 package.
//
//     crypto.RegisterHash(crypto.SHA3_224, New224)
//     crypto.RegisterHash(crypto.SHA3_256, New256)
//     crypto.RegisterHash(crypto.SHA3_384, New384)
//     crypto.RegisterHash(crypto.SHA3_512, New512)

const (
	dsbyteSHA3   = 0b00000110
	dsbyteKeccak = 0b00000001
	dsbyteShake  = 0b00011111
	dsbyteCShake = 0b00000100

	// rateK[c] is the rate in bytes for Keccak[c] where c is the capacity in
	// bits. Given the sponge size is 1600 bits, the rate is 1600 - c bits.
	rateK256  = (1600 - 256) / 8
	rateK448  = (1600 - 448) / 8
	rateK512  = (1600 - 512) / 8
	rateK768  = (1600 - 768) / 8
	rateK1024 = (1600 - 1024) / 8
)

// NewLegacyKeccak256 returns a new Digest computing the legacy, non-standard
// Keccak-256 hash.
func NewLegacyKeccak256() (ret0 *Digest) {
	return newDigest(rateK512, 32, dsbyteKeccak)
}

// NewLegacyKeccak512 returns a new Digest computing the legacy, non-standard
// Keccak-512 hash.
func NewLegacyKeccak512() (ret0 *Digest) {
	return newDigest(rateK1024, 64, dsbyteKeccak)
}
