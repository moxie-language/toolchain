// Package sha256 implements the SHA-224 and SHA-256 hash algorithms as defined
// in FIPS 180-4.
package sha256

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"crypto/internal/fips140"
	"crypto/internal/fips140deps/byteorder"
	"errors"
	"hash"
)

// The size of a SHA-256 checksum in bytes.
const size = 32

// The size of a SHA-224 checksum in bytes.
const size224 = 28

// The block size of SHA-256 and SHA-224 in bytes.
const blockSize = 64

// The maximum number of bytes that can be passed to block(). The limit exists
// because implementations that rely on assembly routines are not preemptible.
const maxAsmIters = 1024
const maxAsmSize = blockSize * maxAsmIters // 64KiB

const (
	chunk     = 64
	init0     = 0x6A09E667
	init1     = 0xBB67AE85
	init2     = 0x3C6EF372
	init3     = 0xA54FF53A
	init4     = 0x510E527F
	init5     = 0x9B05688C
	init6     = 0x1F83D9AB
	init7     = 0x5BE0CD19
	init0_224 = 0xC1059ED8
	init1_224 = 0x367CD507
	init2_224 = 0x3070DD17
	init3_224 = 0xF70E5939
	init4_224 = 0xFFC00B31
	init5_224 = 0x68581511
	init6_224 = 0x64F98FA7
	init7_224 = 0xBEFA4FA4
)

// Digest is a SHA-224 or SHA-256 [hash.Hash] implementation.
type Digest struct {
	h     []uint32
	x     []byte
	nx    int32
	len   uint64
	is224 bool // mark if this digest is SHA-224
}

// newDigest allocates the fixed-size state a digest always carries, so every
// digest value is usable without a zero-value special case.
func newDigest(is224 bool) (d *Digest) {
	d = &Digest{
		h:     []uint32{:8},
		x:     []byte{:chunk},
		is224: is224,
	}
	d.Reset()
	return d
}

// copyState returns an independent copy of the digest, so the original can keep
// being written while the copy is summed.
func (d *Digest) copyState() (c *Digest) {
	c = &Digest{
		h:     []uint32{:8},
		x:     []byte{:chunk},
		nx:    d.nx,
		len:   d.len,
		is224: d.is224,
	}
	for i := 0; i < len(d.h); i++ {
		c.h[i] = d.h[i]
	}
	for i := 0; i < len(d.x); i++ {
		c.x[i] = d.x[i]
	}
	return c
}

const (
	magic224      = "sha\x02"
	magic256      = "sha\x03"
	marshaledSize = 4 + 8*4 + chunk + 8
)

func (d *Digest) MarshalBinary() (ret0 []byte, ret1 error) {
	return d.AppendBinary([]byte{:0:marshaledSize})
}

func (d *Digest) AppendBinary(b []byte) (ret0 []byte, ret1 error) {
	if d.is224 {
		b = mxutil.Ensure(b, len(magic224))
		b = push(b, magic224...)
	} else {
		b = mxutil.Ensure(b, len(magic256))
		b = push(b, magic256...)
	}
	b = byteorder.BEAppendUint32(b, d.h[0])
	b = byteorder.BEAppendUint32(b, d.h[1])
	b = byteorder.BEAppendUint32(b, d.h[2])
	b = byteorder.BEAppendUint32(b, d.h[3])
	b = byteorder.BEAppendUint32(b, d.h[4])
	b = byteorder.BEAppendUint32(b, d.h[5])
	b = byteorder.BEAppendUint32(b, d.h[6])
	b = byteorder.BEAppendUint32(b, d.h[7])
	b = mxutil.Ensure(b, len(d.x[:d.nx]))
	b = push(b, d.x[:d.nx]...)
	b = mxutil.Ensure(b, 1)
	b = push(b, []byte{:len(d.x)-d.nx}...)
	b = byteorder.BEAppendUint64(b, d.len)
	return b, nil
}

func (d *Digest) UnmarshalBinary(b []byte) (ret0 error) {
	if len(b) < len(magic224) || (d.is224 && b[:len(magic224)] != magic224) || (!d.is224 && b[:len(magic256)] != magic256) {
		return errors.New("crypto/sha256: invalid hash state identifier")
	}
	if len(b) != marshaledSize {
		return errors.New("crypto/sha256: invalid hash state size")
	}
	b = b[len(magic224):]
	b, d.h[0] = consumeUint32(b)
	b, d.h[1] = consumeUint32(b)
	b, d.h[2] = consumeUint32(b)
	b, d.h[3] = consumeUint32(b)
	b, d.h[4] = consumeUint32(b)
	b, d.h[5] = consumeUint32(b)
	b, d.h[6] = consumeUint32(b)
	b, d.h[7] = consumeUint32(b)
	n := len(d.x)
	if n > len(b) {
		n = len(b)
	}
	for i := int32(0); i < n; i++ {
		d.x[i] = b[i]
	}
	b = b[n:]
	b, d.len = consumeUint64(b)
	d.nx = int32(d.len % chunk)
	return nil
}

func consumeUint64(b []byte) (ret0 []byte, ret1 uint64) {
	return b[8:], byteorder.BEUint64(b)
}

func consumeUint32(b []byte) (ret0 []byte, ret1 uint32) {
	return b[4:], byteorder.BEUint32(b)
}

func (d *Digest) Clone() (ret0 hash.Cloner, ret1 error) {
	return d.copyState(), nil
}

func (d *Digest) Reset() {
	if !d.is224 {
		d.h[0] = init0
		d.h[1] = init1
		d.h[2] = init2
		d.h[3] = init3
		d.h[4] = init4
		d.h[5] = init5
		d.h[6] = init6
		d.h[7] = init7
	} else {
		d.h[0] = init0_224
		d.h[1] = init1_224
		d.h[2] = init2_224
		d.h[3] = init3_224
		d.h[4] = init4_224
		d.h[5] = init5_224
		d.h[6] = init6_224
		d.h[7] = init7_224
	}
	d.nx = 0
	d.len = 0
}

// New returns a new Digest computing the SHA-256 hash.
func New() (ret0 *Digest) {
	return newDigest(false)
}

// New224 returns a new Digest computing the SHA-224 hash.
func New224() (ret0 *Digest) {
	return newDigest(true)
}

func (d *Digest) Size() (ret0 int32) {
	if !d.is224 {
		return size
	}
	return size224
}

func (d *Digest) BlockSize() (ret0 int32) { return blockSize }

func (d *Digest) Write(p []byte) (nn int32, err error) {
	nn = len(p)
	d.len += uint64(nn)
	// pos walks p: p = p[n:] / p[maxAsmSize:] would copy the whole remaining
	// input per chunk.
	pos := int32(0)
	if d.nx > 0 {
		n := len(d.x) - d.nx
		if n > len(p) {
			n = len(p)
		}
		for i := int32(0); i < n; i++ {
			d.x[d.nx+i] = p[i]
		}
		d.nx += n
		if d.nx == chunk {
			block(d, d.x[:])
			d.nx = 0
		}
		pos = n
	}
	if len(p)-pos >= chunk {
		n := (len(p) - pos) &^ (chunk - 1)
		for n > maxAsmSize {
			block(d, p[pos:pos+maxAsmSize])
			pos += maxAsmSize
			n -= maxAsmSize
		}
		block(d, p[pos:pos+n])
		pos += n
	}
	if len(p)-pos > 0 {
		d.nx = int32(len(p)) - pos
		for i := int32(0); i < d.nx; i++ {
			d.x[i] = p[pos+i]
		}
	}
	return
}

func (d *Digest) Sum(in []byte) (ret0 []byte) {
	fips140.RecordApproved()
	// Make a copy of d so that caller can keep writing and summing.
	d0 := d.copyState()
	sum := d0.checkSum()
	if d0.is224 {
		return push(in, sum[:size224]...)
	}
	return push(in, sum...)
}

func (d *Digest) checkSum() (ret0 []byte) {
	dlen := d.len
	// Padding. Add a 1 bit and 0 bits until 56 bytes mod 64.
	tmp := []byte{:64 + 8} // padding + length buffer
	tmp[0] = 0x80
	var t uint64
	if dlen%64 < 56 {
		t = 56 - dlen%64
	} else {
		t = 64 + 56 - dlen%64
	}

	// Length in bits.
	dlen <<= 3
	padlen := tmp[:t+8]
	byteorder.BEPutUint64At(padlen, int32(t), dlen)
	d.Write(padlen)

	if d.nx != 0 {
		panic("d.nx != 0")
	}

	digest := []byte{:size}

	byteorder.BEPutUint32At(digest, 0, d.h[0])
	byteorder.BEPutUint32At(digest, 4, d.h[1])
	byteorder.BEPutUint32At(digest, 8, d.h[2])
	byteorder.BEPutUint32At(digest, 12, d.h[3])
	byteorder.BEPutUint32At(digest, 16, d.h[4])
	byteorder.BEPutUint32At(digest, 20, d.h[5])
	byteorder.BEPutUint32At(digest, 24, d.h[6])
	if !d.is224 {
		byteorder.BEPutUint32At(digest, 28, d.h[7])
	}

	return digest
}
