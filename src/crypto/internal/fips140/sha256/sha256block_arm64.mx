//:build !purego

package sha256

import (
	"crypto/internal/fips140deps/cpu"
)

func useSHA2() (ret0 bool) { return cpu.ARM64HasSHA2() }

//:noescape
func blockSHA2(dig *Digest, p []byte)

func block(dig *Digest, p []byte) {
	if useSHA2() {
		blockSHA2(dig, p)
	} else {
		blockGeneric(dig, p)
	}
}
