//go:build !purego

package sha256

import (
	"crypto/internal/fips140deps/cpu"
)

func useAVX2() bool  { return cpu.X86HasAVX() && cpu.X86HasAVX2() && cpu.X86HasBMI2() }
func useSHANI() bool { return cpu.X86HasAVX() && cpu.X86HasSHA() && cpu.X86HasSSE41() && cpu.X86HasSSSE3() }

//go:noescape
func blockAVX2(dig *Digest, p []byte)

//go:noescape
func blockSHANI(dig *Digest, p []byte)

func block(dig *Digest, p []byte) {
	if useSHANI() {
		blockSHANI(dig, p)
	} else if useAVX2() {
		blockAVX2(dig, p)
	} else {
		blockGeneric(dig, p)
	}
}
