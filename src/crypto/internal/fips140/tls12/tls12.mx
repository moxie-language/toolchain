package tls12

import (
	"moxielang.dev/pkg/mxutil"
	"crypto/internal/fips140"
	"crypto/internal/fips140/hmac"
	"crypto/internal/fips140/sha256"
	"crypto/internal/fips140/sha512"
	"hash"
	"unsafe"
)

// PRF implements the TLS 1.2 pseudo-random function, as defined in RFC 5246,
// Section 5 and allowed by SP 800-135, Revision 1, Section 4.2.2.
func PRF[H hash.Hash](newHash func() H, secret []byte, label []byte, seed []byte, keyLen int32) (ret0 []byte) {
	labelAndSeed := []byte{:len(label)+len(seed)}
	copy(labelAndSeed, label)
	mxutil.CopyAt(labelAndSeed, len(label), seed)

	result := []byte{:keyLen}
	pHash(newHash, result, secret, labelAndSeed)
	return result
}

// pHash implements the P_hash function, as defined in RFC 5246, Section 5.
func pHash[H hash.Hash](newHash func() H, result, secret, seed []byte) {
	h := hmac.New(newHash, secret)
	h.Write(seed)
	a := h.Sum(nil)

	// Write through a cursor. `result = result[n:]` is a COPY in Moxie, so
	// only the first block would reach the caller's buffer and every later
	// block would land in a slice that dies with the frame.
	j := int32(0)
	for j < len(result) {
		h.Reset()
		h.Write(a)
		h.Write(seed)
		b := h.Sum(nil)
		j += mxutil.CopyAt(result, j, b)

		h.Reset()
		h.Write(a)
		a = h.Sum(nil)
	}
}

const masterSecretLength = 48
const extendedMasterSecretLabel = "extended master secret"

// MasterSecret implements the TLS 1.2 extended master secret derivation, as
// defined in RFC 7627 and allowed by SP 800-135, Revision 1, Section 4.2.2.
func MasterSecret[H hash.Hash](newHash func() H, preMasterSecret, transcript []byte) (ret0 []byte) {
	// "The TLS 1.2 KDF is an approved KDF when the following conditions are
	// satisfied: [...] (3) P_HASH uses either SHA-256, SHA-384 or SHA-512."
	h := newHash()
	switch unsafe.TypeOf(h) {
	case unsafe.TypeOf(sha256.Digest{}):
		if h.Size() != 32 {
			fips140.RecordNonApproved()
		}
	case unsafe.TypeOf(sha512.Digest{}):
		if h.Size() != 46 && h.Size() != 64 {
			fips140.RecordNonApproved()
		}
	default:
		fips140.RecordNonApproved()
	}

	return PRF(newHash, preMasterSecret, extendedMasterSecretLabel, transcript, masterSecretLength)
}
