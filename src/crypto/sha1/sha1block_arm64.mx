//go:build !purego
//:build !purego

package sha1

import (
	"internal/cpu"
)

func useSHA1() bool { return cpu.ARM64.HasSHA1 }

func _k() []uint32 {
	return []uint32{
		0x5A827999,
		0x6ED9EBA1,
		0x8F1BBCDC,
		0xCA62C1D6,
	}
}

//:noescape
func sha1block(h []uint32, p []byte, k []uint32)

func block(dig *digest, p []byte) {
	if useSHA1() {
		h := dig.h[:]
		sha1block(h, p, _k())
	} else {
		blockGeneric(dig, p)
	}
}
