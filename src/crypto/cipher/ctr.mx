// Counter (CTR) mode.

// CTR converts a block cipher into a stream cipher by
// repeatedly encrypting an incrementing counter and
// xoring the resulting stream of data with the input.

// See NIST SP 800-38A, pp 13-15

package cipher

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"bytes"
	"crypto/internal/fips140/aes"
	"crypto/internal/fips140/alias"
	"crypto/internal/fips140only"
	"crypto/subtle"
)

type ctr struct {
	b       Block
	ctr     []byte
	out     []byte
	outUsed int32
}

const streamBufferSize = 512

// ctrAble is an interface implemented by ciphers that have a specific optimized
// implementation of CTR. crypto/aes doesn't use this anymore, and we'd like to
// eventually remove it.
type ctrAble interface {
	NewCTR(iv []byte) Stream
}

// NewCTR returns a [Stream] which encrypts/decrypts using the given [Block] in
// counter mode. The length of iv must be the same as the [Block]'s block size.
func NewCTR(block Block, iv []byte) (s Stream) {
	if ab, ok := block.(*aes.Block); ok {
		return &aesCtrWrapper{aes.NewCTR(ab, iv)}
	}
	if fips140only.Enabled {
		panic("crypto/cipher: use of CTR with non-AES ciphers is not allowed in FIPS 140-only mode")
	}
	if ca, ok := block.(ctrAble); ok {
		return ca.NewCTR(iv)
	}
	if len(iv) != block.BlockSize() {
		panic("cipher.NewCTR: IV length must equal block size")
	}
	bufSize := streamBufferSize
	if bufSize < block.BlockSize() {
		bufSize = block.BlockSize()
	}
	return &ctr{
		b:       block,
		ctr:     bytes.Clone(iv),
		out:     []byte{:0:bufSize},
		outUsed: 0,
	}
}

// aesCtrWrapper hides extra methods from aes.CTR.
type aesCtrWrapper struct {
	c *aes.CTR
}

func (x *aesCtrWrapper) XORKeyStream(dst, src []byte) {
	x.c.XORKeyStream(dst, src)
}

func (x *ctr) refill() {
	remain := len(x.out) - x.outUsed
	mxutil.CopyFrom(x.out, x.out, x.outUsed)
	// resize, not x.out[:cap(x.out)]: a sub-slice is a copy, so the header
	// would point at a fresh copy of the keystream buffer.
	x.out = resize(x.out, cap(x.out))
	bs := x.b.BlockSize()
	var blk [16]byte
	for remain <= len(x.out)-bs {
		x.b.Encrypt(blk[:], x.ctr)
		for i := int32(0); i < bs; i++ {
			x.out[remain+i] = blk[i]
		}
		remain += bs

		// Increment counter
		for i := len(x.ctr) - 1; i >= 0; i-- {
			x.ctr[i]++
			if x.ctr[i] != 0 {
				break
			}
		}
	}
	x.out = resize(x.out, remain)
	x.outUsed = 0
}

func (x *ctr) XORKeyStream(dst, src []byte) {
	if len(dst) < len(src) {
		panic("crypto/cipher: output smaller than input")
	}
	if alias.InexactOverlapLen(dst, len(src), src, len(src)) {
		panic("crypto/cipher: invalid buffer overlap")
	}
	if _, ok := x.b.(*aes.Block); ok {
		panic("crypto/cipher: internal error: generic CTR used with AES")
	}
	// The walk keeps offsets: a sub-slice of dst would be a copy, so the write
	// would land in the copy after the first block.
	pos := int32(0)
	var n int32
	for pos < len(src) {
		if x.outUsed >= len(x.out)-x.b.BlockSize() {
			x.refill()
		}
		n = int32(len(src)) - pos
		if avail := int32(len(x.out)) - x.outUsed; n > avail {
			n = avail
		}
		subtle.XORBytesAt(dst, pos, src, pos, x.out, x.outUsed, n)
		pos += n
		x.outUsed += n
	}
}
