package x509

// The RFC 8448 (TLS 1.3, section 3) server CertificateVerify vector: a
// self-signed RSA certificate and a PSS signature over the TLS 1.3
// CertificateVerify content. It is here because the RSA/asn1 path had no test
// at all: the *big.Int fields of a parsed key were being built in a frame
// arena, the arithmetic that verifies PSS read a mask generated with a signed
// shift, and the PSS decoder tested the already-unmasked block. Each of those
// turned a valid signature into "crypto error", and the only thing that
// caught them was an out-of-tree probe.

import (
	"crypto"
	"crypto/rsa"
	"crypto/sha256"
	"encoding/hex"
	"testing"
)

const rfc8448CertHex = ""

const rfc8448SigHex = "5a747c5d88fa9bd2e55ab085a61015b7211f824cd484145ab3ff52f1fda8477b0b7abc90db78e2d33a5c141a078653fa6bef780c5ea248eeaaa785c4f394cab6d30bbe8d4859ee511f602957b15411ac027671459e46445c9ea58c181e818e95b8c3fb0bf3278409d3be152a3da5043e063dda65cdf5aea20d53dfacd42f74f3"

const rfc8448SignedHex = "20202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020544c5320312e332c2073657276657220436572746966696361746556657269667900764d6632b3c35c3f3205e3499ac3edbaabb88295fba751461d3678e2e5ea0687"

func TestRFC8448CertificatePSS(t *testing.T) {
	der, derr := hex.DecodeString([]byte(rfc8448CertHex))
	if derr != nil {
		t.Fatalf("certificate hex: %s", derr.Error())
	}
	cert, cerr := ParseCertificate(der)
	if cerr != nil {
		t.Fatalf("ParseCertificate: %s", cerr.Error())
	}
	pub, ok := cert.PublicKey.(*rsa.PublicKey)
	if !ok {
		t.Fatalf("certificate public key is not *rsa.PublicKey")
	}
	if pub.N.BitLen() != 1024 {
		t.Fatalf("N.BitLen = %d, want 1024", pub.N.BitLen())
	}
	if pub.E != 65537 {
		t.Fatalf("E = %d, want 65537", pub.E)
	}
	sig, serr := hex.DecodeString([]byte(rfc8448SigHex))
	if serr != nil {
		t.Fatalf("signature hex: %s", serr.Error())
	}
	signed, merr := hex.DecodeString([]byte(rfc8448SignedHex))
	if merr != nil {
		t.Fatalf("message hex: %s", merr.Error())
	}
	digest := sha256.Sum256(signed)
	if verr := rsa.VerifyPSS(pub, crypto.SHA256, digest, sig, nil); verr != nil {
		t.Fatalf("VerifyPSS (auto salt): %s", verr.Error())
	}
	opts := &rsa.PSSOptions{SaltLength: 32}
	if verr := rsa.VerifyPSS(pub, crypto.SHA256, digest, sig, opts); verr != nil {
		t.Fatalf("VerifyPSS (salt 32): %s", verr.Error())
	}
}
