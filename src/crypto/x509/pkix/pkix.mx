// Package pkix contains shared, low level structures used for ASN.1 parsing
// and serialization of X.509 certificates, CRL and OCSP.
package pkix

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"encoding/asn1"
	"encoding/hex"
	"fmt"
	"math/big"
	"time"
	"unsafe"
)


// AlgorithmIdentifier represents the ASN.1 structure of the same name. See RFC
// 5280, section 4.1.1.2.
type AlgorithmIdentifier struct {
	Algorithm  asn1.ObjectIdentifier
	Parameters asn1.RawValue `asn1:"optional"`
}


func _attributeTypeNames() (rm map[string]string) {
	return map[string]string{
		"2.5.4.6":  "C",
		"2.5.4.10": "O",
		"2.5.4.11": "OU",
		"2.5.4.3":  "CN",
		"2.5.4.5":  "SERIALNUMBER",
		"2.5.4.7":  "L",
		"2.5.4.8":  "ST",
		"2.5.4.9":  "STREET",
		"2.5.4.17": "POSTALCODE",
	}
}

// rdnSequenceString returns a string representation of the sequence r,
// roughly following the RFC 2253 Distinguished Names syntax.
func rdnSequenceString(r [][]AttributeTypeAndValue) (rs string) {
	s := ""
	for i := 0; i < len(r); i++ {
		rdn := r[len(r)-1-i]
		if i > 0 {
			s += ","
		}
		for j, tv := range rdn {
			if j > 0 {
				s += "+"
			}

			oidString := tv.Type.String()
			atn := _attributeTypeNames()
			typeName, ok := atn[oidString]
			if !ok {
				derBytes, err := asn1.Marshal(unsafe.TypeOf(tv.Value), unsafe.Pointer(&tv.Value))
				if err == nil {
					s += oidString + "=#" + hex.EncodeToString(derBytes)
					continue // No value escaping necessary.
				}

				typeName = oidString
			}

			valueString := fmt.Sprint(tv.Value)
			escaped := []byte{:0:len(valueString)}

			for k, c := range valueString {
				escape := false

				switch c {
				case ',', '+', '"', '\\', '<', '>', ';':
					escape = true

				case ' ':
					escape = k == 0 || k == len(valueString)-1

				case '#':
					escape = k == 0
				}

				if escape {
					escaped = mxutil.Ensure(escaped, 1)
					escaped = push(escaped, '\\', c)
				} else {
					escaped = mxutil.Ensure(escaped, 1)
					escaped = push(escaped, c)
				}
			}

			s += typeName + "=" + string(escaped)
		}
	}

	return s
}


// AttributeTypeAndValue mirrors the ASN.1 structure of the same name in
// RFC 5280, Section 4.1.2.4.
type AttributeTypeAndValue struct {
	Type  asn1.ObjectIdentifier
	Value []byte
}

// AttributeTypeAndValueSET represents a set of ASN.1 sequences of
// [AttributeTypeAndValue] sequences from RFC 2986 (PKCS #10).
type AttributeTypeAndValueSET struct {
	Type  asn1.ObjectIdentifier
	Value [][]AttributeTypeAndValue `asn1:"set"`
}

// Extension represents the ASN.1 structure of the same name. See RFC
// 5280, section 4.2.
type Extension struct {
	Id       asn1.ObjectIdentifier
	Critical bool `asn1:"optional"`
	Value    []byte
}

// Name represents an X.509 distinguished name. This only includes the common
// elements of a DN. Note that Name is only an approximation of the X.509
// structure. If an accurate representation is needed, asn1.Unmarshal the raw
// subject or issuer as an [[][]AttributeTypeAndValue].
type Name struct {
	Country, Organization, OrganizationalUnit [][]byte
	Locality, Province                        [][]byte
	StreetAddress, PostalCode                 [][]byte
	SerialNumber, CommonName                  string

	// Names contains all parsed attributes. When parsing distinguished names,
	// this can be used to extract non-standard attributes that are not parsed
	// by this package. When marshaling to RDNSequences, the Names field is
	// ignored, see ExtraNames.
	Names []AttributeTypeAndValue

	// ExtraNames contains attributes to be copied, raw, into any marshaled
	// distinguished names. Values override any attributes with the same OID.
	// The ExtraNames field is not populated when parsing, see Names.
	ExtraNames []AttributeTypeAndValue
}

// FillFromRDNSequence populates n from the provided [[][]AttributeTypeAndValue].
// Multi-entry RDNs are flattened, all entries are added to the
// relevant n fields, and the grouping is not preserved.
func (n *Name) FillFromRDNSequence(rdns *[][]AttributeTypeAndValue) {
	// Declared outside the loops: a declaration in the body of a self-mutating
	// method allocates in the sovereign arena on every iteration.
	var value []byte
	var t asn1.ObjectIdentifier
	for _, rdn := range *rdns {
		if len(rdn) == 0 {
			continue
		}

		for _, atv := range rdn {
			n.Names = mxutil.Ensure(n.Names, 1)
			n.Names = push(n.Names, atv)
			value = atv.Value

			t = atv.Type
			if len(t.OID) == 4 && t.OID[0] == 2 && t.OID[1] == 5 && t.OID[2] == 4 {
				switch t.OID[3] {
				case 3:
					n.CommonName = value
				case 5:
					n.SerialNumber = value
				case 6:
					n.Country = mxutil.Ensure(n.Country, 1)
					n.Country = push(n.Country, value)
				case 7:
					n.Locality = mxutil.Ensure(n.Locality, 1)
					n.Locality = push(n.Locality, value)
				case 8:
					n.Province = mxutil.Ensure(n.Province, 1)
					n.Province = push(n.Province, value)
				case 9:
					n.StreetAddress = mxutil.Ensure(n.StreetAddress, 1)
					n.StreetAddress = push(n.StreetAddress, value)
				case 10:
					n.Organization = mxutil.Ensure(n.Organization, 1)
					n.Organization = push(n.Organization, value)
				case 11:
					n.OrganizationalUnit = mxutil.Ensure(n.OrganizationalUnit, 1)
					n.OrganizationalUnit = push(n.OrganizationalUnit, value)
				case 17:
					n.PostalCode = mxutil.Ensure(n.PostalCode, 1)
					n.PostalCode = push(n.PostalCode, value)
				}
			}
		}
	}
}

func _oidCountry() (robjectIdentifier asn1.ObjectIdentifier) { return asn1.ObjectIdentifier{OID: []int32{2, 5, 4, 6}} }
func _oidOrganization() (robjectIdentifier asn1.ObjectIdentifier) { return asn1.ObjectIdentifier{OID: []int32{2, 5, 4, 10}} }
func _oidOrganizationalUnit() (robjectIdentifier asn1.ObjectIdentifier) { return asn1.ObjectIdentifier{OID: []int32{2, 5, 4, 11}} }
func _oidCommonName() (robjectIdentifier asn1.ObjectIdentifier) { return asn1.ObjectIdentifier{OID: []int32{2, 5, 4, 3}} }
func _oidSerialNumber() (robjectIdentifier asn1.ObjectIdentifier) { return asn1.ObjectIdentifier{OID: []int32{2, 5, 4, 5}} }
func _oidLocality() (robjectIdentifier asn1.ObjectIdentifier) { return asn1.ObjectIdentifier{OID: []int32{2, 5, 4, 7}} }
func _oidProvince() (robjectIdentifier asn1.ObjectIdentifier) { return asn1.ObjectIdentifier{OID: []int32{2, 5, 4, 8}} }
func _oidStreetAddress() (robjectIdentifier asn1.ObjectIdentifier) { return asn1.ObjectIdentifier{OID: []int32{2, 5, 4, 9}} }
func _oidPostalCode() (robjectIdentifier asn1.ObjectIdentifier) { return asn1.ObjectIdentifier{OID: []int32{2, 5, 4, 17}} }

// appendRDNs appends a relativeDistinguishedNameSET to the given [][]AttributeTypeAndValue
// and returns the new value. The relativeDistinguishedNameSET contains an
// attributeTypeAndValue for each of the given values. See RFC 5280, A.1, and
// search for AttributeTypeAndValue.
func (n *Name) appendRDNs(in [][]AttributeTypeAndValue, values [][]byte, oid asn1.ObjectIdentifier) (rrDNSequence [][]AttributeTypeAndValue) {
	if len(values) == 0 || oidInAttributeTypeAndValue(oid, n.ExtraNames) {
		return in
	}

	s := []AttributeTypeAndValue{:len(values)}
	for i, value := range values {
		s[i].Type = oid
		s[i].Value = value
	}

	return push(in, s)
}

// ToRDNSequence converts n into a single [[][]AttributeTypeAndValue]. The following
// attributes are encoded as multi-value RDNs:
//
//   - Country
//   - Organization
//   - OrganizationalUnit
//   - Locality
//   - Province
//   - StreetAddress
//   - PostalCode
//
// Each ExtraNames entry is encoded as an individual RDN.
func (n *Name) ToRDNSequence() (ret [][]AttributeTypeAndValue) {
	ret = n.appendRDNs(ret, n.Country, _oidCountry())
	ret = n.appendRDNs(ret, n.Province, _oidProvince())
	ret = n.appendRDNs(ret, n.Locality, _oidLocality())
	ret = n.appendRDNs(ret, n.StreetAddress, _oidStreetAddress())
	ret = n.appendRDNs(ret, n.PostalCode, _oidPostalCode())
	ret = n.appendRDNs(ret, n.Organization, _oidOrganization())
	ret = n.appendRDNs(ret, n.OrganizationalUnit, _oidOrganizationalUnit())
	if len(n.CommonName) > 0 {
		ret = n.appendRDNs(ret, [][]byte{n.CommonName}, _oidCommonName())
	}
	if len(n.SerialNumber) > 0 {
		ret = n.appendRDNs(ret, [][]byte{n.SerialNumber}, _oidSerialNumber())
	}
	for _, atv := range n.ExtraNames {
		ret = mxutil.Ensure(ret, 1)
		ret = push(ret, []AttributeTypeAndValue{atv})
	}

	return ret
}

// String returns the string form of n, roughly following
// the RFC 2253 Distinguished Names syntax.
func (n *Name) String() (rs string) {
	var rdns [][]AttributeTypeAndValue
	// If there are no ExtraNames, surface the parsed value (all entries in
	// Names) instead.
	if n.ExtraNames == nil {
		for _, atv := range n.Names {
			t := atv.Type
			if len(t.OID) == 4 && t.OID[0] == 2 && t.OID[1] == 5 && t.OID[2] == 4 {
				switch t.OID[3] {
				case 3, 5, 6, 7, 8, 9, 10, 11, 17:
					// These attributes were already parsed into named fields.
					continue
				}
			}
			// Place non-standard parsed values at the beginning of the sequence
			// so they will be at the end of the string. See Issue 39924.
			rdns = mxutil.Ensure(rdns, 1)
			rdns = push(rdns, []AttributeTypeAndValue{atv})
		}
	}
	rdns = mxutil.Ensure(rdns, 1)
	rdns = push(rdns, n.ToRDNSequence()...)
	return rdnSequenceString(rdns)
}

// oidInAttributeTypeAndValue reports whether a type with the given OID exists
// in atv.
func oidInAttributeTypeAndValue(oid asn1.ObjectIdentifier, atv []AttributeTypeAndValue) (rok bool) {
	for _, a := range atv {
		if a.Type.Equal(oid) {
			return true
		}
	}
	return false
}

// CertificateList represents the ASN.1 structure of the same name. See RFC
// 5280, section 5.1. Use Certificate.CheckCRLSignature to verify the
// signature.
//
// Deprecated: x509.RevocationList should be used instead.
type CertificateList struct {
	TBSCertList        TBSCertificateList
	SignatureAlgorithm AlgorithmIdentifier
	SignatureValue     asn1.BitString
}

// HasExpired reports whether certList should have been updated by now.
func (certList *CertificateList) HasExpired(now time.Time) (rok bool) {
	return !now.Before(certList.TBSCertList.NextUpdate)
}

// TBSCertificateList represents the ASN.1 structure of the same name. See RFC
// 5280, section 5.1.
//
// Deprecated: x509.RevocationList should be used instead.
type TBSCertificateList struct {
	Raw                 asn1.RawContent
	Version             int32 `asn1:"optional,default:0"`
	Signature           AlgorithmIdentifier
	Issuer              [][]AttributeTypeAndValue
	ThisUpdate          time.Time
	NextUpdate          time.Time            `asn1:"optional"`
	RevokedCertificates []RevokedCertificate `asn1:"optional"`
	Extensions          []Extension          `asn1:"tag:0,optional,explicit"`
}

// RevokedCertificate represents the ASN.1 structure of the same name. See RFC
// 5280, section 5.1.
type RevokedCertificate struct {
	SerialNumber   *big.Int
	RevocationTime time.Time
	Extensions     []Extension `asn1:"optional"`
}
