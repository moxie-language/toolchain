// hexNibble returns the value of a single hex digit, or -1 if invalid.
func hexNibble(c byte) (n int32) {
	if c >= '0' && c <= '9' {
		n = int32(c - '0'); return
	}
	if c >= 'a' && c <= 'f' {
		n = int32(c-'a') + 10; return
	}
	if c >= 'A' && c <= 'F' {
		n = int32(c-'A') + 10; return
	}
	return
}

// hexDecode parses a hex string. Returns (bytes, true) on success.
func hexDecode(s string) (out []byte, ok bool) {
	if len(s)%2 != 0 {
		return
	}
	out = []byte{:len(s)/2}
	for i := 0; i < len(s); i += 2 {
		hi := hexNibble(s[i])
		lo := hexNibble(s[i+1])
		if hi < 0 || lo < 0 {
			return
		}
		out[i/2] = byte(hi<<4 | lo)
	}
	ok = true
	return
}

// splitLines and splitFields replace strings package (removed in moxie).
func splitLines(b []byte) (out [][]byte) {
	start := 0
	for i := 0; i < len(b); i++ {
		if b[i] == '\n' {
			out = mxutil.Ensure(out, 1)
			push(out, b[start:i])
			start = i + 1
		}
	}
	if start < len(b) {
		out = mxutil.Ensure(out, 1)
		push(out, b[start:])
	}
	return
}

func splitCSVFields(line []byte) (out [][]byte) {
	start := 0
	for i := 0; i < len(line); i++ {
		if line[i] == ',' {
			out = mxutil.Ensure(out, 1)
			push(out, line[start:i])
			start = i + 1
		}
	}
	out = mxutil.Ensure(out, 1)
	push(out, line[start:])
	return
}

func trimCR(b []byte) (r []byte) {
	if len(b) > 0 && b[len(b)-1] == '\r' {
		return b[:len(b)-1]
	}
	return b
}

// TestBIP340Vectors runs the official BIP-340 test vectors against
// SignSchnorr / VerifySchnorr. Vectors are vendored from
// https://github.com/bitcoin/bips/blob/master/bip-0340/test-vectors.csv
// at testdata/bip0340.csv.
func TestBIP340Vectors(t *testing.T) {
	lines := splitLines([]byte(bip340CSVData))
	if len(lines) < 2 {
		t.Fatalf("CSV too short: %d lines", len(lines))
	}
	signCount := 0
	verifyCount := 0
	// Skip header.
	for i := 1; i < len(lines); i++ {
		line := trimCR(lines[i])
		if len(line) == 0 {
			continue
		}
		fields := splitCSVFields(line)
		if len(fields) < 7 {
			t.Errorf("line %d: only %d fields, expected >= 7", i, len(fields))
			continue
		}
		idx := string(fields[0])
		skHex := string(fields[1])
		pkHex := string(fields[2])
		auxHex := string(fields[3])
		msgHex := string(fields[4])
		sigHex := string(fields[5])
		want := bytes.Equal(fields[6], []byte("TRUE"))

		pk, hexOK := hexDecode(pkHex)
		if !hexOK || len(pk) != 32 {
			t.Errorf("vec %s: bad pubkey hex", idx)
			continue
		}

		msg, hexOK2 := hexDecode(msgHex)
		if !hexOK2 {
			t.Errorf("vec %s: bad msg hex", idx)
			continue
		}

		sig, hexOK3 := hexDecode(sigHex)
		if !hexOK3 || len(sig) != 64 {
			t.Errorf("vec %s: bad sig hex (%d bytes)", idx, len(sig))
			continue
		}

		// Sign vectors (those with a secret key) - check determinism.
		if skHex != "" {
			sk, hexOK4 := hexDecode(skHex)
			if !hexOK4 || len(sk) != 32 {
				t.Errorf("vec %s: bad sk hex", idx)
				continue
			}

			aux, hexOK5 := hexDecode(auxHex)
			if !hexOK5 || len(aux) != 32 {
				t.Errorf("vec %s: bad aux hex", idx)
				continue
			}

			gotSig, ok := SignSchnorrBytes(sk, msg, aux)
			if !ok {
				t.Errorf("vec %s: SignSchnorrBytes returned not ok", idx)
				continue
			}
			if !bytes.Equal(gotSig, sig) {
				t.Errorf("vec %s: sig mismatch\n want %x\n got  %x", idx, sig, gotSig)
				continue
			}

			// Sanity: derived pubkey matches expected.
			gotPK, ok := PubKeyFromSecKey(sk)
			if !ok {
				t.Errorf("vec %s: PubKeyFromSecKey not ok", idx)
				continue
			}
			if !bytes.Equal(gotPK, pk) {
				t.Errorf("vec %s: derived pubkey mismatch\n want %x\n got  %x", idx, pk, gotPK)
				continue
			}
			signCount++
		}
		verifyCount++

		// All vectors: verify and compare to expected TRUE/FALSE.
		got := VerifySchnorrBytes(pk, msg, sig)
		if got != want {
			t.Errorf("vec %s: VerifySchnorrBytes = %v, want %v", idx, got, want)
		}
	}
	// 8 sign vectors (0-3, 15-18), 19 verify vectors (0-18). Catches any silent
	// loop break or skipped lines.
	if signCount != 8 {
		t.Errorf("expected 8 sign vectors covered, got %d", signCount)
	}
	if verifyCount != 19 {
		t.Errorf("expected 19 verify vectors covered, got %d", verifyCount)
	}
}

// TestRadix16Carry exercises the constant-time ScalarMult digits[64]==1 carry
// edge case. Folded from the runtime helper TestSignedRadix16 (which remains
// callable from non-test contexts like web/mlstest).
func TestRadix16Carry(t *testing.T) {
	if err := TestSignedRadix16(); err != nil {
		t.Fatal(err)
	}
}

// TestNostrEventRoundtrip exercises the SignSchnorr/VerifySchnorr 32-byte
// API that Nostr uses (sha256 of canonical event JSON, then sign).
func TestNostrEventRoundtrip(t *testing.T) {
	sk := []byte{:32}
	sk[31] = 5
	pk, ok := PubKeyFromSecKey(sk)
	if !ok {
		t.Fatal("PubKeyFromSecKey failed")
	}
	msg := sha256.Sum([]byte(`[0,"deadbeef",1700000000,1,[],"hello"]`))
	aux := []byte{:32}
	sig, ok := SignSchnorr(sk, msg, aux)
	if !ok {
		t.Fatal("SignSchnorr failed")
	}
	if !VerifySchnorr(pk, msg, sig) {
		t.Fatal("VerifySchnorr returned false on own signature")
	}
	// Wrong msg should not verify.
	bad := sha256.Sum([]byte("different"))
	if VerifySchnorr(pk, bad, sig) {
		t.Fatal("VerifySchnorr accepted wrong message")
	}
}

// TestLiftXRejectsNonCanonicalX: BIP-340 fails a public key whose x is not a
// canonical field element ("fail if x >= p"). feFromBytes copies the bytes
// into the limb representation without reducing, so a raw caller could lift a
// point that no verifier accepts.
func TestLiftXRejectsNonCanonicalX(t *testing.T) {
	// p, p+1, and an all-ones x: every one of them is >= p.
	for _, h := range []string{
		"FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEFFFFFC2F",
		"FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEFFFFFC30",
		"FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF",
	} {
		raw, ok := hexDecode(h)
		if !ok {
			t.Fatalf("fixture %s is not hex", h)
			continue
		}
		if _, lifted := LiftX(feFromBytes(raw)); lifted {
			t.Errorf("LiftX accepted x = %s, which is >= p", h)
		}
	}
	// A canonical x still lifts: p-1 is a curve point, and so is the generator's.
	gx, okx := hexDecode("79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798")
	if !okx {
		t.Fatal("generator x fixture is not hex")
		return
	}
	if _, lifted := LiftX(feFromBytes(gx)); !lifted {
		t.Error("LiftX rejected the generator's x coordinate")
	}
	// ECDH must refuse the non-canonical key as well.
	sk := []byte{:32}
	sk[31] = 5
	bad := []byte{:32}
	for i := int32(0); i < 32; i++ {
		bad[i] = 0xFF
	}
	if _, ok := ECDH(sk, bad); ok {
		t.Error("ECDH accepted an x coordinate >= p")
	}
}
