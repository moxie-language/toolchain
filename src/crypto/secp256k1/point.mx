package secp256k1

// Point on secp256k1 in Jacobian coordinates (X, Y, Z).
// Affine point is (X/Z^2, Y/Z^3). Point at infinity has Z=0.
type Point struct {
	X, Y, Z Fe
}

// Affine point.
type AffinePoint struct {
	X, Y Fe
}

// G returns the generator point.
func G() (p AffinePoint) {
	p = AffinePoint{
		X: Fe{
			0x59F2815B16F81798,
			0x029BFCDB2DCE28D9,
			0x55A06295CE870B07,
			0x79BE667EF9DCBBAC,
		},
		Y: Fe{
			0x9C47D08FFB10D4B8,
			0xFD17B448A6855419,
			0x5DA4FBFC0E1108A8,
			0x483ADA7726A3C465,
		},
	}
	return
}

// curveN returns the curve order n.
func curveN() (n Fe) {
	n = Fe{
		0xBFD25E8CD0364141,
		0xBAAEDCE6AF48A03B,
		0xFFFFFFFFFFFFFFFE,
		0xFFFFFFFFFFFFFFFF,
	}
	return
}

// Infinity returns the point at infinity.
func Infinity() (p Point) {
	p = Point{_feZero(), _feOne(), _feZero()}
	return
}

// pointFromAffine converts an affine point to Jacobian.
func pointFromAffine(p AffinePoint) (r Point) {
	r = Point{p.X, p.Y, _feOne()}
	return
}

// toAffine converts a Jacobian point to affine.
func (p *Point) toAffine() (r AffinePoint) {
	if feIsZero(p.Z) {
		return
	}
	zInv := feInv(p.Z)
	z2 := feSqr(zInv)
	z3 := feMul(z2, zInv)
	r = AffinePoint{
		X: feMul(p.X, z2),
		Y: feMul(p.Y, z3),
	}
	return
}

// isInfinity returns true if the point is at infinity.
func (p *Point) isInfinity() (z bool) {
	z = feIsZero(p.Z)
	return
}

// pointDouble computes 2*P in Jacobian coordinates.
func pointDouble(p Point) (r Point) {
	if feIsZero(p.Z) {
		r = p
		return
	}

	a := feSqr(p.X)
	b := feSqr(p.Y)
	c := feSqr(b)

	xb := feAdd(p.X, b)
	xb2 := feSqr(xb)
	d := feSub(feSub(xb2, a), c)
	d = feAdd(d, d)

	e := feAdd(feAdd(a, a), a)

	f := feSqr(e)

	r.X = feSub(f, feAdd(d, d))

	r.Y = feMul(e, feSub(d, r.X))
	c8 := feAdd(c, c)
	c8 = feAdd(c8, c8)
	c8 = feAdd(c8, c8)
	r.Y = feSub(r.Y, c8)

	r.Z = feMul(p.Y, p.Z)
	r.Z = feAdd(r.Z, r.Z)

	return
}

// pointAdd computes P + Q in Jacobian coordinates.
func pointAdd(p, q Point) (r Point) {
	if feIsZero(p.Z) {
		r = q
		return
	}
	if feIsZero(q.Z) {
		r = p
		return
	}

	z1sq := feSqr(p.Z)
	z2sq := feSqr(q.Z)
	u1 := feMul(p.X, z2sq)
	u2 := feMul(q.X, z1sq)

	s1 := feMul(p.Y, feMul(z2sq, q.Z))
	s2 := feMul(q.Y, feMul(z1sq, p.Z))

	if u1 == u2 {
		if s1 == s2 {
			r = pointDouble(p)
			return
		}
		r = Infinity()
		return
	}

	h := feSub(u2, u1)
	rv := feSub(s2, s1)

	h2 := feSqr(h)
	h3 := feMul(h2, h)

	r.X = feSub(feSub(feSqr(rv), h3), feAdd(feMul(u1, h2), feMul(u1, h2)))

	r.Y = feSub(feMul(rv, feSub(feMul(u1, h2), r.X)), feMul(s1, h3))

	r.Z = feMul(feMul(p.Z, q.Z), h)

	return
}

// varTimeScalarMult computes k*P using variable-time double-and-add.
func varTimeScalarMult(p Point, k Fe) (r Point) {
	r = Infinity()
	current := p
	for i := 0; i < 4; i++ {
		w := k[i]
		for bit := 0; bit < 64; bit++ {
			if w&1 == 1 {
				r = pointAdd(r, current)
			}
			current = pointDouble(current)
			w >>= 1
		}
	}
	return
}

// constantTimeByteEq returns 1 if a == b, 0 otherwise. Constant-time.
func constantTimeByteEq(a, b uint8) (eq int32) {
	x := uint32(a ^ b)
	x |= x >> 4
	x |= x >> 2
	x |= x >> 1
	eq = int32(1 ^ (x & 1))
	return
}

// pointCondSelect returns b if cond==1, a if cond==0. Constant-time.
func pointCondSelect(a, b Point, cond int32) (r Point) {
	r = Point{
		feCondSelect(a.X, b.X, cond),
		feCondSelect(a.Y, b.Y, cond),
		feCondSelect(a.Z, b.Z, cond),
	}
	return
}

// pointCondNeg returns Point{X, -Y, Z} if cond==1, p unchanged if cond==0. Constant-time.
func pointCondNeg(p Point, cond int32) (r Point) {
	r = Point{p.X, feCondNeg(p.Y, cond), p.Z}
	return
}

// projLookupTable holds [1*Q, 2*Q, ..., 8*Q] for constant-time selection.
type projLookupTable struct {
	points [8]Point
}

func (t *projLookupTable) fromPoint(q Point) {
	t.points[0] = q
	for i := 0; i < 7; i++ {
		t.points[i+1] = pointAdd(q, t.points[i])
	}
}

// selectInto sets dest = x*Q for -8 <= x <= 8 in constant time.
// x == 0 yields the identity (Infinity).
func (t *projLookupTable) selectInto(dest *Point, x int8) {
	xmask := int32(x >> 7)          // 0 if x >= 0, -1 if x < 0
	xabs := uint8((x + int8(xmask)) ^ int8(xmask)) // |x|
	*dest = Infinity()
	for j := uint8(1); j <= 8; j++ {
		cond := constantTimeByteEq(xabs, j)
		*dest = pointCondSelect(*dest, t.points[j-1], cond)
	}
	*dest = pointCondNeg(*dest, xmask&1)
}

// pointAddCT adds p and q in constant time, handling identity (Z==0) via
// conditional select. Does NOT handle p == q (use pointDouble for that case).
func pointAddCT(p, q Point) (r Point) {
	pIsInf := ctIsZeroFe(p.Z)
	qIsInf := ctIsZeroFe(q.Z)

	z1sq := feSqr(p.Z)
	z2sq := feSqr(q.Z)
	u1 := feMul(p.X, z2sq)
	u2 := feMul(q.X, z1sq)
	s1 := feMul(p.Y, feMul(z2sq, q.Z))
	s2 := feMul(q.Y, feMul(z1sq, p.Z))
	h := feSub(u2, u1)
	rv := feSub(s2, s1)
	h2 := feSqr(h)
	h3 := feMul(h2, h)
	r.X = feSub(feSub(feSqr(rv), h3), feAdd(feMul(u1, h2), feMul(u1, h2)))
	r.Y = feSub(feMul(rv, feSub(feMul(u1, h2), r.X)), feMul(s1, h3))
	r.Z = feMul(feMul(p.Z, q.Z), h)

	r = pointCondSelect(r, q, pIsInf)
	r = pointCondSelect(r, p, qIsInf)
	return
}

// pointDoubleCT doubles p in constant time, handling identity (Z==0) via
// conditional select.
func pointDoubleCT(p Point) (r Point) {
	isInf := ctIsZeroFe(p.Z)

	a := feSqr(p.X)
	b := feSqr(p.Y)
	c := feSqr(b)
	xb := feAdd(p.X, b)
	xb2 := feSqr(xb)
	d := feSub(feSub(xb2, a), c)
	d = feAdd(d, d)
	e := feAdd(feAdd(a, a), a)
	f := feSqr(e)
	r.X = feSub(f, feAdd(d, d))
	r.Y = feMul(e, feSub(d, r.X))
	c8 := feAdd(c, c)
	c8 = feAdd(c8, c8)
	c8 = feAdd(c8, c8)
	r.Y = feSub(r.Y, c8)
	r.Z = feMul(p.Y, p.Z)
	r.Z = feAdd(r.Z, r.Z)

	r = pointCondSelect(r, p, isInf)
	return
}

// ScalarMult computes k*P in constant time using signed radix-16.
func ScalarMult(p Point, k Fe) (r Point) {
	var table projLookupTable
	table.fromPoint(p)

	digits := scalarToSignedRadix16(k)

	table.selectInto(&r, digits[64])

	for i := 63; i >= 0; i-- {
		r = pointDoubleCT(r)
		r = pointDoubleCT(r)
		r = pointDoubleCT(r)
		r = pointDoubleCT(r)

		var multiple Point
		table.selectInto(&multiple, digits[i])
		r = pointAddCT(r, multiple)
	}
	return
}

// ScalarBaseMult computes k*G in constant time.
func ScalarBaseMult(k Fe) (p AffinePoint) {
	pt := ScalarMult(pointFromAffine(G()), k)
	p = pt.toAffine()
	return
}

// LiftX recovers a point from x-coordinate only (BIP-340).
// Returns the point with even y.
func LiftX(x Fe) (p AffinePoint, ok bool) {
	// BIP-340: "fail if x >= p". feFromBytes copies 32 bytes into the limb
	// representation without reducing, so a caller handing over a raw
	// coordinate can present a non-canonical value: ECDH(0xFF*32) used to
	// succeed on a point no verifier accepts (p8k's ECDHRaw returned a shared
	// secret while InitPub rejected the same key).
	if feCmp(x, _feP()) >= 0 {
		return
	}
	x3 := feMul(feSqr(x), x)
	y2 := feAdd(x3, Fe{7, 0, 0, 0})
	y, ok := feSqrt(y2)
	if !ok {
		return
	}
	if !feIsEven(y) {
		y = feNeg(y)
	}
	p = AffinePoint{x, y}
	ok = true
	return
}
