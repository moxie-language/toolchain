package secp256k1

// Scalar arithmetic modulo the curve order n.
// n = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141

// scalarAdd returns (a + b) mod n.
func scalarAdd(a, b Fe) (r Fe) {
	var carry uint64
	r[0], carry = addWithCarry(a[0], b[0], 0)
	r[1], carry = addWithCarry(a[1], b[1], carry)
	r[2], carry = addWithCarry(a[2], b[2], carry)
	r[3], carry = addWithCarry(a[3], b[3], carry)

	n := curveN()
	if carry != 0 || feCmp(r, n) >= 0 {
		var borrow uint64
		r[0], borrow = subWithBorrow(r[0], n[0], 0)
		r[1], borrow = subWithBorrow(r[1], n[1], borrow)
		r[2], borrow = subWithBorrow(r[2], n[2], borrow)
		r[3], _ = subWithBorrow(r[3], n[3], borrow)
	}
	return
}

// scalarMul returns (a * b) mod n.
func scalarMul(a, b Fe) (r Fe) {
	var t [8]uint64
	for i := 0; i < 4; i++ {
		var carry uint64
		for j := 0; j < 4; j++ {
			hi, lo := mul64(a[i], b[j])
			lo, c1 := addWithCarry(lo, t[i+j], 0)
			hi += c1
			lo, c2 := addWithCarry(lo, carry, 0)
			hi += c2
			t[i+j] = lo
			carry = hi
		}
		t[i+4] = carry
	}
	r = scalarReduceFull(t)
	return
}

// scalarNeg returns -a mod n.
func scalarNeg(a Fe) (r Fe) {
	if a == _feZero() {
		return
	}
	r = scalarSub(curveN(), a)
	return
}

// scalarSub returns (a - b) mod n.
func scalarSub(a, b Fe) (r Fe) {
	var borrow uint64
	r[0], borrow = subWithBorrow(a[0], b[0], 0)
	r[1], borrow = subWithBorrow(r[1]+a[1], b[1], borrow)
	r[2], borrow = subWithBorrow(r[2]+a[2], b[2], borrow)
	r[3], borrow = subWithBorrow(r[3]+a[3], b[3], borrow)
	if borrow != 0 {
		n := curveN()
		var c uint64
		r[0], c = addWithCarry(r[0], n[0], 0)
		r[1], c = addWithCarry(r[1], n[1], c)
		r[2], c = addWithCarry(r[2], n[2], c)
		r[3], _ = addWithCarry(r[3], n[3], c)
	}
	return
}

// scalarInv returns a^(-1) mod n via Fermat: a^(n-2) mod n.
func scalarInv(a Fe) (r Fe) {
	nm2 := Fe{
		0xBFD25E8CD036413F,
		0xBAAEDCE6AF48A03B,
		0xFFFFFFFFFFFFFFFE,
		0xFFFFFFFFFFFFFFFF,
	}
	r = scalarExp(a, nm2)
	return
}

func scalarExp(base, exp Fe) (r Fe) {
	r = _feOne()
	b := base
	for i := 0; i < 4; i++ {
		w := exp[i]
		for bit := 0; bit < 64; bit++ {
			if w&1 == 1 {
				r = scalarMul(r, b)
			}
			b = scalarMul(b, b)
			w >>= 1
		}
	}
	return
}

// scalarReduceFull reduces a 512-bit number modulo n.
func scalarReduceFull(t [8]uint64) (res Fe) {
	cc := [3]uint64{
		0x402DA1732FC9BEBF,
		0x4551231950B75FC4,
		0x0000000000000001,
	}

	r := scalarFoldHigh(t, cc)
	r = scalarFoldHigh(r, cc)

	res[0] = r[0]
	res[1] = r[1]
	res[2] = r[2]
	res[3] = r[3]

	if r[4] != 0 {
		var carry uint64
		hi, lo := mul64(r[4], cc[0])
		lo, k := addWithCarry(lo, res[0], 0)
		hi += k
		res[0] = lo
		carry = hi

		hi, lo = mul64(r[4], cc[1])
		lo, k = addWithCarry(lo, res[1], 0)
		hi += k
		lo, k = addWithCarry(lo, carry, 0)
		hi += k
		res[1] = lo
		carry = hi

		hi, lo = mul64(r[4], cc[2])
		lo, k = addWithCarry(lo, res[2], 0)
		hi += k
		lo, k = addWithCarry(lo, carry, 0)
		hi += k
		res[2] = lo
		carry = hi

		res[3], _ = addWithCarry(res[3], carry, 0)
	}

	n := curveN()
	for feCmp(res, n) >= 0 {
		var borrow uint64
		res[0], borrow = subWithBorrow(res[0], n[0], 0)
		res[1], borrow = subWithBorrow(res[1], n[1], borrow)
		res[2], borrow = subWithBorrow(res[2], n[2], borrow)
		res[3], _ = subWithBorrow(res[3], n[3], borrow)
	}

	return
}

// scalarFoldHigh folds the upper 4 limbs of an 8-limb number down into
// the lower 4 limbs using the identity 2^256 ≡ cc (mod n).
func scalarFoldHigh(t [8]uint64, cc [3]uint64) (r [8]uint64) {
	r[0] = t[0]
	r[1] = t[1]
	r[2] = t[2]
	r[3] = t[3]

	for i := 0; i < 4; i++ {
		if t[i+4] == 0 {
			continue
		}
		var carry uint64
		for j := 0; j < 3; j++ {
			hi, lo := mul64(t[i+4], cc[j])
			lo, k := addWithCarry(lo, r[i+j], 0)
			hi += k
			lo, k = addWithCarry(lo, carry, 0)
			hi += k
			r[i+j] = lo
			carry = hi
		}
		for k := i + 3; carry != 0 && k < 8; k++ {
			r[k], carry = addWithCarry(r[k], carry, 0)
		}
	}

	return
}

// scalarIsZero returns true if s == 0.
func scalarIsZero(s Fe) (z bool) {
	z = s == _feZero()
	return
}

// scalarFromBytes reads a 32-byte big-endian scalar.
func scalarFromBytes(b []byte) (s Fe) {
	s = feFromBytes(b)
	return
}

// scalarToSignedRadix16 decomposes k into 65 signed digits in [-8, 8].
func scalarToSignedRadix16(k Fe) (digits [65]int8) {
	b := feToLEBytes(k)

	for i := 0; i < 32; i++ {
		digits[2*i] = int8(b[i] & 15)
		digits[2*i+1] = int8((b[i] >> 4) & 15)
	}

	for i := 0; i < 64; i++ {
		carry := (digits[i] + 8) >> 4
		digits[i] -= carry << 4
		digits[i+1] += carry
	}

	return
}
