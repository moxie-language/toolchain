// Package secp256k1 implements secp256k1 curve operations and BIP-340 Schnorr signatures.
// Pure Go, no math/big, no stdlib crypto.
package secp256k1

// Field element: 256-bit integer mod p, stored as 4 x uint64 (little-endian limbs).
// p = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEFFFFFC2F

type Fe [4]uint64

func _feZero() (r Fe) {
	return
}

func _feOne() (r Fe) {
	r[0] = 1
	return
}

func _feP() (r Fe) {
	r[0] = 0xFFFFFFFEFFFFFC2F
	r[1] = 0xFFFFFFFFFFFFFFFF
	r[2] = 0xFFFFFFFFFFFFFFFF
	r[3] = 0xFFFFFFFFFFFFFFFF
	return
}

// feAdd returns a + b mod p.
func feAdd(a, b Fe) (r Fe) {
	var carry uint64

	r[0], carry = addWithCarry(a[0], b[0], 0)
	r[1], carry = addWithCarry(a[1], b[1], carry)
	r[2], carry = addWithCarry(a[2], b[2], carry)
	r[3], carry = addWithCarry(a[3], b[3], carry)

	r = feReduce(r, carry)
	return
}

// feSub returns a - b mod p.
func feSub(a, b Fe) (r Fe) {
	var borrow uint64

	r[0], borrow = subWithBorrow(a[0], b[0], 0)
	r[1], borrow = subWithBorrow(a[1], b[1], borrow)
	r[2], borrow = subWithBorrow(a[2], b[2], borrow)
	r[3], borrow = subWithBorrow(a[3], b[3], borrow)

	if borrow != 0 {
		var c uint64
		r[0], c = addWithCarry(r[0], _feP()[0], 0)
		r[1], c = addWithCarry(r[1], _feP()[1], c)
		r[2], c = addWithCarry(r[2], _feP()[2], c)
		r[3], _ = addWithCarry(r[3], _feP()[3], c)
	}
	return
}

// feNeg returns -a mod p.
func feNeg(a Fe) (r Fe) {
	if a == _feZero() {
		return
	}
	r = feSub(_feP(), a)
	return
}

// feMul returns a * b mod p using schoolbook multiplication + Barrett-like reduction.
func feMul(a, b Fe) (r Fe) {
	var t [8]uint64

	for i := 0; i < 4; i++ {
		var carry uint64
		for j := 0; j < 4; j++ {
			hi, lo := mul64(a[i], b[j])
			lo, c1 := addWithCarry(lo, t[i+j], 0)
			hi += c1
			lo, c2 := addWithCarry(lo, carry, 0)
			hi += c2
			t[i+j] = lo
			carry = hi
		}
		t[i+4] = carry
	}

	r = feReduceFull(t)
	return
}

// feSqr returns a^2 mod p.
func feSqr(a Fe) (r Fe) {
	r = feMul(a, a)
	return
}

// feInv returns a^(-1) mod p using Fermat's little theorem: a^(p-2) mod p.
func feInv(a Fe) (r Fe) {
	pm2 := Fe{
		0xFFFFFFFEFFFFFC2D,
		0xFFFFFFFFFFFFFFFF,
		0xFFFFFFFFFFFFFFFF,
		0xFFFFFFFFFFFFFFFF,
	}
	r = feExp(a, pm2)
	return
}

// feExp computes a^e mod p via square-and-multiply.
func feExp(base, exp Fe) (r Fe) {
	r = _feOne()
	b := base
	for i := 0; i < 4; i++ {
		w := exp[i]
		for bit := 0; bit < 64; bit++ {
			if w&1 == 1 {
				r = feMul(r, b)
			}
			b = feSqr(b)
			w >>= 1
		}
	}
	return
}

// feSqrt computes sqrt(a) mod p. Returns (result, exists).
// p % 4 == 3, so sqrt(a) = a^((p+1)/4) mod p.
func feSqrt(a Fe) (r Fe, ok bool) {
	exp := Fe{
		0xFFFFFFFFBFFFFF0C,
		0xFFFFFFFFFFFFFFFF,
		0xFFFFFFFFFFFFFFFF,
		0x3FFFFFFFFFFFFFFF,
	}
	r = feExp(a, exp)
	check := feSqr(r)
	if check == a {
		ok = true
		return
	}
	return
}

// feFromBytes reads a 32-byte big-endian integer into an Fe.
func feFromBytes(b []byte) (r Fe) {
	if len(b) < 32 {
		return
	}
	r[3] = beUint64(b[0:8])
	r[2] = beUint64(b[8:16])
	r[1] = beUint64(b[16:24])
	r[0] = beUint64(b[24:32])
	return
}

// feToBytes writes an Fe as 32-byte big-endian.
//
// The limbs go in at an offset rather than through `b[0:8]`: a subslice is a
// COPY in Moxie, so `putBeUint64(b[0:8], limb)` wrote into a throwaway and the
// returned bytes were all zero. That is what made every secp256k1 public key
// and signature serialisation here produce zeros - TestRadix16Carry saw it as
// digits[64]==0 instead of 1, TestBIP340Vectors as 8 of 19 vectors failing -
// and it is why a signer's derived public key failed ValidatePubKey.
func feToBytes(a Fe) (b []byte) {
	b = []byte{:32}
	putBeUint64(b, 0, a[3])
	putBeUint64(b, 8, a[2])
	putBeUint64(b, 16, a[1])
	putBeUint64(b, 24, a[0])
	return
}

// feIsZero returns true if a == 0.
func feIsZero(a Fe) (z bool) {
	z = a == _feZero()
	return
}

// feIsEven returns true if a is even.
func feIsEven(a Fe) (e bool) {
	e = a[0]&1 == 0
	return
}

// feCmp returns -1, 0, or 1 comparing a and b.
func feCmp(a, b Fe) (c int32) {
	for i := 3; i >= 0; i-- {
		if a[i] < b[i] {
			c = -1
			return
		}
		if a[i] > b[i] {
			c = 1
			return
		}
	}
	return
}

// feReduce reduces r with carry into [0, p).
func feReduce(r Fe, carry uint64) (res Fe) {
	if carry != 0 || feCmp(r, _feP()) >= 0 {
		var borrow uint64
		res[0], borrow = subWithBorrow(r[0], _feP()[0], 0)
		res[1], borrow = subWithBorrow(r[1], _feP()[1], borrow)
		res[2], borrow = subWithBorrow(r[2], _feP()[2], borrow)
		res[3], _ = subWithBorrow(r[3], _feP()[3], borrow)
	} else {
		res = r
	}
	return
}

// feReduceFull reduces a 512-bit product modulo p.
// Uses the property: 2^256 ≡ 0x1000003D1 (mod p).
func feReduceFull(t [8]uint64) (r Fe) {
	const c = 0x1000003D1

	var carry uint64

	for i := 0; i < 4; i++ {
		hi, lo := mul64(t[i+4], c)
		lo, c1 := addWithCarry(lo, t[i], 0)
		hi += c1
		lo, c2 := addWithCarry(lo, carry, 0)
		hi += c2
		r[i] = lo
		carry = hi
	}

	if carry != 0 {
		hi, lo := mul64(carry, c)
		_ = hi
		var c3 uint64
		r[0], c3 = addWithCarry(r[0], lo, 0)
		r[1], c3 = addWithCarry(r[1], hi, c3)
		r[2], c3 = addWithCarry(r[2], 0, c3)
		r[3], _ = addWithCarry(r[3], 0, c3)
	}

	if feCmp(r, _feP()) >= 0 {
		var borrow uint64
		r[0], borrow = subWithBorrow(r[0], _feP()[0], 0)
		r[1], borrow = subWithBorrow(r[1], _feP()[1], borrow)
		r[2], borrow = subWithBorrow(r[2], _feP()[2], borrow)
		r[3], _ = subWithBorrow(r[3], _feP()[3], borrow)
	}

	return
}

// 64-bit arithmetic helpers.

func addWithCarry(a, b, carry uint64) (sum uint64, c uint64) {
	sum = a + b + carry
	if sum < a || (sum == a && (b|carry) != 0) {
		c = 1
	}
	return
}

func subWithBorrow(a, b, borrow uint64) (diff uint64, c uint64) {
	diff = a - b - borrow
	if a < b+borrow || (borrow != 0 && b == 0xFFFFFFFFFFFFFFFF) {
		c = 1
	}
	return
}

// mul64 returns the full 128-bit product of a * b as (hi, lo).
func mul64(a, b uint64) (hi, lo uint64) {
	aHi := a >> 32
	aLo := a & 0xFFFFFFFF
	bHi := b >> 32
	bLo := b & 0xFFFFFFFF

	ll := aLo * bLo
	hl := aHi * bLo
	lh := aLo * bHi
	hh := aHi * bHi

	mid := hl + (ll >> 32)
	if mid < hl {
		hh += 1 << 32
	}
	mid2 := mid + lh
	if mid2 < mid {
		hh += 1 << 32
	}

	lo = (mid2 << 32) | (ll & 0xFFFFFFFF)
	hi = hh + (mid2 >> 32)
	return
}

func beUint64(b []byte) (v uint64) {
	v = uint64(b[0])<<56 | uint64(b[1])<<48 | uint64(b[2])<<40 | uint64(b[3])<<32 |
		uint64(b[4])<<24 | uint64(b[5])<<16 | uint64(b[6])<<8 | uint64(b[7])
	return
}

func putBeUint64(b []byte, off int32, v uint64) {
	b[off+0] = byte(v >> 56)
	b[off+1] = byte(v >> 48)
	b[off+2] = byte(v >> 40)
	b[off+3] = byte(v >> 32)
	b[off+4] = byte(v >> 24)
	b[off+5] = byte(v >> 16)
	b[off+6] = byte(v >> 8)
	b[off+7] = byte(v)
}

func putLeUint64(b []byte, off int32, v uint64) {
	b[off+0] = byte(v)
	b[off+1] = byte(v >> 8)
	b[off+2] = byte(v >> 16)
	b[off+3] = byte(v >> 24)
	b[off+4] = byte(v >> 32)
	b[off+5] = byte(v >> 40)
	b[off+6] = byte(v >> 48)
	b[off+7] = byte(v >> 56)
}

// feToLEBytes converts Fe to 32 little-endian bytes.
func feToLEBytes(a Fe) (b []byte) {
	b = []byte{:32}
	putLeUint64(b, 0, a[0])
	putLeUint64(b, 8, a[1])
	putLeUint64(b, 16, a[2])
	putLeUint64(b, 24, a[3])
	return
}

// feCondSelect returns b if cond==1, a if cond==0. Constant-time.
func feCondSelect(a, b Fe, cond int32) (r Fe) {
	mask := uint64(-int64(cond))
	r[0] = a[0] ^ (mask & (a[0] ^ b[0]))
	r[1] = a[1] ^ (mask & (a[1] ^ b[1]))
	r[2] = a[2] ^ (mask & (a[2] ^ b[2]))
	r[3] = a[3] ^ (mask & (a[3] ^ b[3]))
	return
}

// feCondNeg returns -a if cond==1, a if cond==0. Constant-time.
func feCondNeg(a Fe, cond int32) (r Fe) {
	r = feCondSelect(a, feNeg(a), cond)
	return
}

// ctIsZeroFe returns 1 if a==0, 0 otherwise. Constant-time.
func ctIsZeroFe(a Fe) (z int32) {
	v := a[0] | a[1] | a[2] | a[3]
	v |= v >> 32
	v |= v >> 16
	v |= v >> 8
	v |= v >> 4
	v |= v >> 2
	v |= v >> 1
	z = int32(1 ^ (v & 1))
	return
}
