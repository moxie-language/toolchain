// Package sha256 implements the SHA224 and SHA256 hash algorithms as defined
// in FIPS 180-4.
package sha256

import (
	"crypto/internal/fips140/sha256"
	"hash"
)

// The size of a SHA256 checksum in bytes.
const Size = 32

// The size of a SHA224 checksum in bytes.
const Size224 = 28

// The blocksize of SHA256 and SHA224 in bytes.
const BlockSize = 64

// New returns a new [hash.Hash] computing the SHA256 checksum. The Hash
// also implements [encoding.BinaryMarshaler], [encoding.BinaryAppender] and
// [encoding.BinaryUnmarshaler] to marshal and unmarshal the internal
// state of the hash.
func New() (h hash.Hash) {
	return sha256.New()
}

// New224 returns a new [hash.Hash] computing the SHA224 checksum. The Hash
// also implements [encoding.BinaryMarshaler], [encoding.BinaryAppender] and
// [encoding.BinaryUnmarshaler] to marshal and unmarshal the internal
// state of the hash.
func New224() (h hash.Hash) {
	return sha256.New224()
}

// Sum returns the SHA256 checksum of the data. Alias for Sum256.
func Sum(data []byte) (sum [Size]byte) { return Sum256(data) }

// SumHex returns the SHA256 checksum of the data as a lowercase hex string.
func SumHex(data []byte) (hexsum string) {
	h := Sum256(data)
	const hextab = "0123456789abcdef"
	b := []byte{:Size * 2}
	for i := 0; i < Size; i++ {
		b[2*i] = hextab[h[i]>>4]
		b[2*i+1] = hextab[h[i]&0xf]
	}
	return string(b)
}

// Sum256 returns the SHA256 checksum of the data.
func Sum256(data []byte) (digest [Size]byte) {
	h := New()
	h.Write(data)
	var sum [Size]byte
	h.Sum(sum[:0])
	return sum
}

// Sum224 returns the SHA224 checksum of the data.
func Sum224(data []byte) (digest [Size224]byte) {
	h := New224()
	h.Write(data)
	var sum [Size224]byte
	h.Sum(sum[:0])
	return sum
}
