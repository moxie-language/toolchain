// nistPoint is a generic constraint for the nistec Point types.
// T's bound is a method interface: the upstream Go code binds T to `any`,
// and binding it to `comparable` makes the self-referential constraint
// invalid ("P does not satisfy comparable" - the recursion never bottoms out).
type nistPoint[T pointLike] interface {
	Bytes() []byte
	SetBytes([]byte) (T, error)
	Add(T, T) T
	Double(T) T
	ScalarMult(T, []byte) (T, error)
	ScalarBaseMult([]byte) (T, error)
}

// pointLike is the minimal method interface every nistec Point satisfies.
type pointLike interface {
	Bytes() []byte
}

// --- the Curve facade ---

func (curve *nistCurveImpl) Params() (out *CurveParams) {
	return curve.params
}

func (curve *nistCurveImpl) IsOnCurve(x, y *big.Int) (ok bool) {
	switch curve.kind {
	case curveP224:
		return nistIsOnCurve(nistec.NewP224Point, curve.params, x, y)
	case curveP256:
		return nistIsOnCurve(nistec.NewP256Point, curve.params, x, y)
	case curveP384:
		return nistIsOnCurve(nistec.NewP384Point, curve.params, x, y)
	}
	return nistIsOnCurve(nistec.NewP521Point, curve.params, x, y)
}

func (curve *nistCurveImpl) Add(x1, y1, x2, y2 *big.Int) (out *big.Int, res *big.Int) {
	switch curve.kind {
	case curveP224:
		return nistAdd(nistec.NewP224Point, curve.params, x1, y1, x2, y2)
	case curveP256:
		return nistAdd(nistec.NewP256Point, curve.params, x1, y1, x2, y2)
	case curveP384:
		return nistAdd(nistec.NewP384Point, curve.params, x1, y1, x2, y2)
	}
	return nistAdd(nistec.NewP521Point, curve.params, x1, y1, x2, y2)
}

func (curve *nistCurveImpl) Double(x1, y1 *big.Int) (out *big.Int, res *big.Int) {
	switch curve.kind {
	case curveP224:
		return nistDouble(nistec.NewP224Point, curve.params, x1, y1)
	case curveP256:
		return nistDouble(nistec.NewP256Point, curve.params, x1, y1)
	case curveP384:
		return nistDouble(nistec.NewP384Point, curve.params, x1, y1)
	}
	return nistDouble(nistec.NewP521Point, curve.params, x1, y1)
}

func (curve *nistCurveImpl) ScalarMult(Bx, By *big.Int, scalar []byte) (out *big.Int, res *big.Int) {
	switch curve.kind {
	case curveP224:
		return nistScalarMult(nistec.NewP224Point, curve.params, Bx, By, scalar)
	case curveP256:
		return nistScalarMult(nistec.NewP256Point, curve.params, Bx, By, scalar)
	case curveP384:
		return nistScalarMult(nistec.NewP384Point, curve.params, Bx, By, scalar)
	}
	return nistScalarMult(nistec.NewP521Point, curve.params, Bx, By, scalar)
}

func (curve *nistCurveImpl) ScalarBaseMult(scalar []byte) (out *big.Int, res *big.Int) {
	switch curve.kind {
	case curveP224:
		return nistScalarBaseMult(nistec.NewP224Point, curve.params, scalar)
	case curveP256:
		return nistScalarBaseMult(nistec.NewP256Point, curve.params, scalar)
	case curveP384:
		return nistScalarBaseMult(nistec.NewP384Point, curve.params, scalar)
	}
	return nistScalarBaseMult(nistec.NewP521Point, curve.params, scalar)
}

func (curve *nistCurveImpl) Unmarshal(data []byte) (x, y *big.Int) {
	switch curve.kind {
	case curveP224:
		return nistUnmarshal(nistec.NewP224Point, curve.params, data)
	case curveP256:
		return nistUnmarshal(nistec.NewP256Point, curve.params, data)
	case curveP384:
		return nistUnmarshal(nistec.NewP384Point, curve.params, data)
	}
	return nistUnmarshal(nistec.NewP521Point, curve.params, data)
}

func (curve *nistCurveImpl) UnmarshalCompressed(data []byte) (x, y *big.Int) {
	switch curve.kind {
	case curveP224:
		return nistUnmarshalCompressed(nistec.NewP224Point, curve.params, data)
	case curveP256:
		return nistUnmarshalCompressed(nistec.NewP256Point, curve.params, data)
	case curveP384:
		return nistUnmarshalCompressed(nistec.NewP384Point, curve.params, data)
	}
	return nistUnmarshalCompressed(nistec.NewP521Point, curve.params, data)
}

// --- the parametric arithmetic ---
//
// Each function is a wrapper over a nistec Point: points are encoded into and
// decoded from properly formatted byte slices, and all big.Int use stays in this
// package. Encoding and decoding is 1/1000th of the runtime of a scalar
// multiplication, so the overhead is acceptable.

func nistIsOnCurve[Point nistPoint[Point]](np func() Point, params *CurveParams, x, y *big.Int) (ok bool) {
	// IsOnCurve is documented to reject (0, 0), the conventional point at
	// infinity, which however is accepted by nistPointFromAffine.
	if x.Sign() == 0 && y.Sign() == 0 {
		return false
	}
	_, err := nistPointFromAffine(np, params, x, y)
	return err == nil
}

func nistPointFromAffine[Point nistPoint[Point]](np func() Point, params *CurveParams, x, y *big.Int) (p Point, err error) {
	// (0, 0) is by convention the point at infinity, which can't be represented
	// in affine coordinates. See Issue 37294.
	if x.Sign() == 0 && y.Sign() == 0 {
		return np(), nil
	}
	// Reject values that would not get correctly encoded.
	if x.Sign() < 0 || y.Sign() < 0 {
		return p, errors.New("negative coordinate")
	}
	if x.BitLen() > params.BitSize || y.BitLen() > params.BitSize {
		return p, errors.New("overflowing coordinate")
	}
	// Encode the coordinates and let SetBytes reject invalid points.
	byteLen := (params.BitSize + 7) / 8
	buf := []byte{:1 + 2*byteLen}
	buf[0] = 4 // uncompressed point
	x.FillBytesAt(buf, 1, byteLen)
	y.FillBytesAt(buf, 1+byteLen, byteLen)
	return np().SetBytes(buf)
}

func nistPointToAffine[Point nistPoint[Point]](params *CurveParams, p Point) (x, y *big.Int) {
	out := p.Bytes()
	if len(out) == 1 && out[0] == 0 {
		// This is the encoding of the point at infinity, which the affine
		// coordinates API represents as (0, 0) by convention.
		return &big.Int{}, &big.Int{}
	}
	byteLen := (params.BitSize + 7) / 8
	x = (&big.Int{}).SetBytes(out[1 : 1+byteLen])
	y = (&big.Int{}).SetBytes(out[1+byteLen:])
	return x, y
}

func nistAdd[Point nistPoint[Point]](np func() Point, params *CurveParams, x1, y1, x2, y2 *big.Int) (out *big.Int, res *big.Int) {
	p1, err := nistPointFromAffine(np, params, x1, y1)
	if err != nil {
		panic("crypto/elliptic: Add was called on an invalid point")
	}
	p2, err := nistPointFromAffine(np, params, x2, y2)
	if err != nil {
		panic("crypto/elliptic: Add was called on an invalid point")
	}
	return nistPointToAffine(params, p1.Add(p1, p2))
}

func nistDouble[Point nistPoint[Point]](np func() Point, params *CurveParams, x1, y1 *big.Int) (out *big.Int, res *big.Int) {
	p, err := nistPointFromAffine(np, params, x1, y1)
	if err != nil {
		panic("crypto/elliptic: Double was called on an invalid point")
	}
	return nistPointToAffine(params, p.Double(p))
}

// nistNormalizeScalar brings the scalar within the byte size of the order of the
// curve, as expected by the nistec scalar multiplication functions.
func nistNormalizeScalar(params *CurveParams, scalar []byte) (b []byte) {
	byteSize := (params.N.BitLen() + 7) / 8
	if len(scalar) == byteSize {
		return scalar
	}
	s := (&big.Int{}).SetBytes(scalar)
	if len(scalar) > byteSize {
		s.Mod(s, params.N)
	}
	out := []byte{:byteSize}
	return s.FillBytes(out)
}

func nistScalarMult[Point nistPoint[Point]](np func() Point, params *CurveParams, Bx, By *big.Int, scalar []byte) (out *big.Int, res *big.Int) {
	p, err := nistPointFromAffine(np, params, Bx, By)
	if err != nil {
		panic("crypto/elliptic: ScalarMult was called on an invalid point")
	}
	scalar = nistNormalizeScalar(params, scalar)
	p, err = p.ScalarMult(p, scalar)
	if err != nil {
		panic("crypto/elliptic: nistec rejected normalized scalar")
	}
	return nistPointToAffine(params, p)
}

func nistScalarBaseMult[Point nistPoint[Point]](np func() Point, params *CurveParams, scalar []byte) (out *big.Int, res *big.Int) {
	scalar = nistNormalizeScalar(params, scalar)
	p, err := np().ScalarBaseMult(scalar)
	if err != nil {
		panic("crypto/elliptic: nistec rejected normalized scalar")
	}
	return nistPointToAffine(params, p)
}

func nistUnmarshal[Point nistPoint[Point]](np func() Point, params *CurveParams, data []byte) (x, y *big.Int) {
	if len(data) == 0 || data[0] != 4 {
		return nil, nil
	}
	// Use SetBytes to check that data encodes a valid point.
	_, err := np().SetBytes(data)
	if err != nil {
		return nil, nil
	}
	// We don't use nistPointToAffine because it involves an expensive field
	// inversion to convert from Jacobian to affine coordinates, which we
	// already have.
	byteLen := (params.BitSize + 7) / 8
	x = (&big.Int{}).SetBytes(data[1 : 1+byteLen])
	y = (&big.Int{}).SetBytes(data[1+byteLen:])
	return x, y
}

func nistUnmarshalCompressed[Point nistPoint[Point]](np func() Point, params *CurveParams, data []byte) (x, y *big.Int) {
	if len(data) == 0 || (data[0] != 2 && data[0] != 3) {
		return nil, nil
	}
	p, err := np().SetBytes(data)
	if err != nil {
		return nil, nil
	}
	return nistPointToAffine(params, p)
}

func bigFromDecimal(s []byte) (out *big.Int) {
	b, ok := (&big.Int{}).SetString(string(s), 10)
	if !ok {
		panic("crypto/elliptic: internal error: invalid encoding")
	}
	return b
}

func bigFromHex(s []byte) (out *big.Int) {
	b, ok := (&big.Int{}).SetString(string(s), 16)
	if !ok {
		panic("crypto/elliptic: internal error: invalid encoding")
	}
	return b
}
