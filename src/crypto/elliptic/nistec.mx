package elliptic

import (
	"crypto/internal/fips140/nistec"
	"errors"
	"math/big"
)

// curveKind selects the nistec point type a curve forwards to.
type curveKind int32

const (
	curveP224 curveKind = iota
	curveP256
	curveP384
	curveP521
)

type nistCurves struct {
	p224 *nistCurveImpl
	p256 *nistCurveImpl
	p384 *nistCurveImpl
	p521 *nistCurveImpl
}

// nistCurveImpl is the elliptic.Curve implementation for a NIST curve.
//
// An implementation of an interface handed out as a value must be a NON-GENERIC
// type. An interface invoke compares the interface's type word against one arm
// per implementation, and the arms are enumerated from the type declarations of
// the link set. An instantiated generic type has no declaration to enumerate, so
// a boxed nistCurve[*nistec.P256Point] matched no arm at all and every
// elliptic.Curve method reached through the interface died with "interface
// dispatch: no impl for Params" (crypto/ecdsa, crypto/x509, crypto/tls).
//
// The point arithmetic stays generic and lives in free functions: a call to a
// generic function is monomorphized at the call site, so the type argument never
// becomes a value that has to survive a return or be boxed into an interface.
type nistCurveImpl struct {
	kind   curveKind
	params *CurveParams
}

func _curves() (out *nistCurves) {
	return &nistCurves{
		p224: &nistCurveImpl{kind: curveP224, params: &CurveParams{
			Name:    "P-224",
			BitSize: 224,
			// SP 800-186, Section 3.2.1.2
			P:  bigFromDecimal("26959946667150639794667015087019630673557916260026308143510066298881"),
			N:  bigFromDecimal("26959946667150639794667015087019625940457807714424391721682722368061"),
			B:  bigFromHex("b4050a850c04b3abf54132565044b0b7d7bfd8ba270b39432355ffb4"),
			Gx: bigFromHex("b70e0cbd6bb4bf7f321390b94a03c1d356c21122343280d6115c1d21"),
			Gy: bigFromHex("bd376388b5f723fb4c22dfe6cd4375a05a07476444d5819985007e34"),
		}},
		p256: &nistCurveImpl{kind: curveP256, params: &CurveParams{
