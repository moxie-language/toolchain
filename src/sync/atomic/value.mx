package atomic

import (
	"unsafe"
)

// Value provides a typed load/store. Single-threaded: no CAS loops needed.
type Value struct {
	v any
}

type efaceWords struct {
	typ  unsafe.Pointer
	data unsafe.Pointer
}

func (v *Value) Load() (val any) {
	return v.v
}

func (v *Value) Store(val any) {
	if val == nil {
		panic("sync/atomic: store of nil value into Value")
	}
	if v.v != nil {
		vp := (*efaceWords)(unsafe.Pointer(&v.v))
		np := (*efaceWords)(unsafe.Pointer(&val))
		if vp.typ != np.typ {
			panic("sync/atomic: store of inconsistently typed value into Value")
		}
	}
	v.v = val
}

func (v *Value) Swap(new any) (old any) {
	if new == nil {
		panic("sync/atomic: swap of nil value into Value")
	}
	if v.v != nil {
		vp := (*efaceWords)(unsafe.Pointer(&v.v))
		np := (*efaceWords)(unsafe.Pointer(&new))
		if vp.typ != np.typ {
			panic("sync/atomic: swap of inconsistently typed value into Value")
		}
	}
	old = v.v
	v.v = new
	return
}

func (v *Value) CompareAndSwap(old, new any) (swapped bool) {
	if new == nil {
		panic("sync/atomic: compare and swap of nil value into Value")
	}
	np := (*efaceWords)(unsafe.Pointer(&new))
	op := (*efaceWords)(unsafe.Pointer(&old))
	if op.typ != nil && np.typ != op.typ {
		panic("sync/atomic: compare and swap of inconsistently typed values")
	}
	if v.v == nil {
		if old != nil {
			return false
		}
		v.v = new
		return true
	}
	vp := (*efaceWords)(unsafe.Pointer(&v.v))
	if vp.typ != np.typ {
		panic("sync/atomic: compare and swap of inconsistently typed value into Value")
	}
	if v.v != old {
		return false
	}
	v.v = new
	return true
}

// Disable/enable preemption - no-ops in single-threaded.
func runtime_procPin() int32 { return 0 }
func runtime_procUnpin()   {}
