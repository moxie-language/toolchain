package sync

// WaitGroup: single-threaded, plain counter. Wait cannot block
// (no goroutines to call Done), so it just checks the counter.
type WaitGroup struct {
	counter int32
}

func (wg *WaitGroup) Add(delta int32) {
	wg.counter += int32(delta)
	if wg.counter < 0 {
		panic("sync: negative WaitGroup counter")
	}
}

func (wg *WaitGroup) Done() {
	wg.Add(-1)
}

func (wg *WaitGroup) Wait() {
	if wg.counter != 0 {
		panic("sync: WaitGroup.Wait in single-threaded runtime with non-zero counter")
	}
}
