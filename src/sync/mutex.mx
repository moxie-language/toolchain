package sync

import (
	"internal/task"
)

type Mutex = task.Mutex

//:linkname runtimePanic runtime.runtimePanic
func runtimePanic(msg []byte)

// RWMutex is a no-op in single-threaded Moxie. Read and write locks
// are tracked for correctness checking but never block.
type RWMutex struct {
	locked  bool
	readers int32
}

func (rw *RWMutex) Lock()      { rw.locked = true }
func (rw *RWMutex) Unlock()    { rw.locked = false }
func (rw *RWMutex) TryLock() bool {
	if rw.locked {
		return false
	}
	rw.locked = true
	return true
}

func (rw *RWMutex) RLock()   { rw.readers++ }
func (rw *RWMutex) RUnlock() {
	rw.readers--
	if rw.readers < 0 {
		runtimePanic("sync: RUnlock of unlocked RWMutex")
	}
}
func (rw *RWMutex) TryRLock() bool {
	if rw.locked {
		return false
	}
	rw.readers++
	return true
}

type Locker interface {
	Lock()
	Unlock()
}

func (rw *RWMutex) RLocker() Locker {
	return (*rlocker)(rw)
}

type rlocker RWMutex

func (r *rlocker) Lock()   { (*RWMutex)(r).RLock() }
func (r *rlocker) Unlock() { (*RWMutex)(r).RUnlock() }
