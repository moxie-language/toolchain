// This file implements unsigned multi-precision integers (natural
// numbers). They are the building blocks for the implementation
// of signed integers, rationals, and floating-point numbers.
//
// Caution: This implementation relies on the function "alias"
//          which assumes that (nat) slice capacities are never
//          changed (no 3-operand slice expressions). If that
//          changes, alias needs to be updated for correctness.

package big

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"internal/byteorder"
	"math/bits"
	"math/rand"
	"slices"
)

// An unsigned integer x of the form
//
//	x = x[n-1]*_B^(n-1) + x[n-2]*_B^(n-2) + ... + x[1]*_B + x[0]
//
// with 0 <= x[i] < _B and 0 <= i < n is stored in a slice of length n,
// with the digits x[i] as the slice elements.
//
// A number is normalized if the slice contains no leading 0 digits.
// During arithmetic operations, denormalized values may occur but are
// always normalized before returning the final result. The normalized
// representation of 0 is the empty or nil slice (length = 0).

func _natOne() (rnat []Word) { return []Word{1} }
func _natTwo() (rnat []Word) { return []Word{2} }
func _natFive() (rnat []Word) { return []Word{5} }
func _natTen() (rnat []Word) { return []Word{10} }

func natString(z []Word) (rs string) {
	return "0x" | string(natItoa(z, false, 16))
}

func natNorm(z []Word) (rnat []Word) {
	i := len(z)
	for i > 0 && z[i-1] == 0 {
		i--
	}
	return z[0:i]
}

func natAlloc(z []Word, n int32) (rnat []Word) {
	if n <= cap(z) {
		return z[:n]
	}
	if n == 1 {
		return []Word{:1}
	}
	const e = 4
	return []Word{:n:n+e}
}

func natSetWord(z []Word, x Word) (rnat []Word) {
	if x == 0 {
		return z[:0]
	}
	z = natAlloc(z, 1)
	z[0] = x
	return z
}

func natSetUint64(z []Word, x uint64) (rnat []Word) {
	// single-word value
	if w := Word(x); uint64(w) == x {
		return natSetWord(z, w)
	}
	// 2-word value
	z = natAlloc(z, 2)
	z[1] = Word(x >> 32)
	z[0] = Word(x)
	return z
}

func natSet(z []Word, x []Word) (rnat []Word) {
	z = natAlloc(z, len(x))
	copy(z, x)
	return z
}

func natAdd(z []Word, x, y []Word) (rnat []Word) {
	m := len(x)
	n := len(y)

	switch {
	case m < n:
		return natAdd(z, y, x)
	case m == 0:
		// n == 0 because m >= n; result is 0
		return z[:0]
	case n == 0:
		// result is x
		return natSet(z, x)
	}
	// m > 0

	z = natAlloc(z, m + 1)
	c := addVV(z[:n], x[:n], y[:n])
	if m > n {
		c = addVW(z[n:m], x[n:], c)
	}
	z[m] = c

	return natNorm(z)
}

func natSub(z []Word, x, y []Word) (rnat []Word) {
	m := len(x)
	n := len(y)

	switch {
	case m < n:
		panic("underflow")
	case m == 0:
		// n == 0 because m >= n; result is 0
		return z[:0]
	case n == 0:
		// result is x
		return natSet(z, x)
	}
	// m > 0

	z = natAlloc(z, m)
	c := subVV(z[:n], x[:n], y[:n])
	if m > n {
		c = subVW(z[n:], x[n:], c)
	}
	if c != 0 {
		panic("underflow")
	}

	return natNorm(z)
}

func natCmp(x []Word, y []Word) (r int32) {
	m := len(x)
	n := len(y)
	if m != n || m == 0 {
		switch {
		case m < n:
			r = -1
		case m > n:
			r = 1
		}
		return
	}

	i := m - 1
	for i > 0 && x[i] == y[i] {
		i--
	}

	switch {
	case x[i] < y[i]:
		r = -1
	case x[i] > y[i]:
		r = 1
	}
	return
}

// montgomery computes z mod m = x*y*2**(-n*_W) mod m,
// assuming k = -1/m mod 2**_W.
// z is used for storing the result which is returned;
// z must not alias x, y or m.
// See Gueron, "Efficient Software Implementations of Modular Exponentiation".
// https://eprint.iacr.org/2011/239.pdf
// In the terminology of that paper, this is an "Almost Montgomery Multiplication":
// x and y are required to satisfy 0 <= z < 2**(n*_W) and then the result
// z is guaranteed to satisfy 0 <= z < 2**(n*_W), but it may not be < m.
func natMontgomery(z []Word, x, y, m []Word, k Word, n int32) (rnat []Word) {
	// This code assumes x, y, m are all the same length, n.
	// (required by addMulVVW and the for loop).
	// It also assumes that x, y are already reduced mod m,
	// or else the result will not be properly reduced.
	if len(x) != n || len(y) != n || len(m) != n {
		panic("math/big: mismatched montgomery number lengths")
	}
	z = natAlloc(z, n * 2)
	clear(z)
	var c Word
	for i := 0; i < n; i++ {
		d := y[i]
		c2 := addMulVVWW(z[i:n+i], z[i:n+i], x, d, 0)
		t := z[i] * k
		c3 := addMulVVWW(z[i:n+i], z[i:n+i], m, t, 0)
		cx := c + c2
		cy := cx + c3
		z[n+i] = cy
		if cx < c2 || cy < c3 {
			c = 1
		} else {
			c = 0
		}
	}
	if c != 0 {
		subVV(z[:n], z[n:], m)
	} else {
		copy(z[:n], z[n:])
	}
	return z[:n]
}

// alias reports whether x and y share the same base array.
//
// Note: alias assumes that the capacity of underlying arrays
// is never changed for nat values; i.e. that there are
// no 3-operand slice expressions in this code (or worse,
// reflect-based operations to the same effect).
func alias(x, y []Word) (rok bool) {
	return cap(x) > 0 && cap(y) > 0 && &x[0:cap(x)][cap(x)-1] == &y[0:cap(y)][cap(y)-1]
}

// addTo implements z += x; z must be long enough.
// (we don't use nat.add because we need z to stay the same
// slice, and we don't need to normalize z after each addition)
func addTo(z, x []Word) {
	if n := len(x); n > 0 {
		if c := addVV(z[:n], z[:n], x[:n]); c != 0 {
			if n < len(z) {
				addVW(z[n:], z[n:], c)
			}
		}
	}
}

// mulRange computes the product of all the unsigned integers in the
// range [a, b] inclusively. If a > b (empty range), the result is 1.
// The caller may pass stk == nil to request that mulRange obtain and release one itself.
func natMulRange(z []Word, stk *stack, a, b uint64) (rnat []Word) {
	switch {
	case a == 0:
		// cut long ranges short (optimization)
		return natSetUint64(z, 0)
	case a > b:
		return natSetUint64(z, 1)
	case a == b:
		return natSetUint64(z, a)
	case a+1 == b:
		return natMul(z, stk, natSetUint64([]Word(nil), a), natSetUint64([]Word(nil), b))
	}

	if stk == nil {
		stk = getStack()
		defer stk.free()
	}

	m := a + (b-a)/2 // avoid overflow
	return natMul(z, stk, natMulRange([]Word(nil), stk, a, m), natMulRange([]Word(nil), stk, m+1, b))
}

// A stack provides temporary storage for complex calculations
// such as multiplication and division.
// The stack is a simple slice of words, extended as needed
// to hold all the temporary storage for a calculation.
// In general, if a function takes a *stack, it expects a non-nil *stack.
// However, certain functions may allow passing a nil *stack instead,
// so that they can handle trivial stack-free cases without forcing the
// caller to obtain and free a stack that will be unused. These functions
// document that they accept a nil *stack in their doc comments.
type stack struct {
	w []Word
}

func getStack() (rstack *stack) {
	return &stack{}
}

func (s *stack) free() {
}

// save returns the current stack pointer.
// A future call to restore with the same value
// frees any temporaries allocated on the stack after the call to save.
func (s *stack) save() (rn int32) {
	return len(s.w)
}

// restore restores the stack pointer to n.
// It is almost always invoked as
//
//	defer stk.restore(stk.save())
//
// which makes sure to pop any temporaries allocated in the current function
// from the stack before returning.
func (s *stack) restore(n int32) {
	s.w = resize(s.w, n)
}

// nat returns a nat of n words, allocated on the stack.
func (s *stack) nat(n int32) (rnat []Word) {
	nr := (n + 3) &^ 3 // round up to multiple of 4
	off := len(s.w)
	s.w = slices.Grow(s.w, nr)
	s.w = resize(s.w, off+nr)
	x := s.w[off : off+n : off+n]
	if n > 0 {
		x[0] = 0xfedcb
	}
	return x
}

// bitLen returns the length of x in bits.
// Unlike most methods, it works even if x is not normalized.
func natBitLen(x []Word) (rn int32) {
	// This function is used in cryptographic operations. It must not leak
	// anything but the Int's sign and bit size through side-channels. Any
	// changes must be reviewed by a security expert.
	if i := len(x) - 1; i >= 0 {
		// bits.Len uses a lookup table for the low-order bits on some
		// architectures. Neutralize any input-dependent behavior by setting all
		// bits after the first one bit.
		top := uint32(x[i])
		top |= top >> 1
		top |= top >> 2
		top |= top >> 4
		top |= top >> 8
		top |= top >> 16
		top |= top >> 16 >> 16 // ">> 32" doesn't compile on 32-bit architectures
		return i*_W + bits.Len(top)
	}
	return 0
}

// trailingZeroBits returns the number of consecutive least significant zero
// bits of x.
func natTrailingZeroBits(x []Word) (rn uint32) {
	if len(x) == 0 {
		return 0
	}
	var i uint32
	for x[i] == 0 {
		i++
	}
	// x[i] != 0
	return i*_W + uint32(bits.TrailingZeros(uint32(x[i])))
}

// isPow2 returns i, true when x == 2**i and 0, false otherwise.
func natIsPow2(x []Word) (rn uint32, rok bool) {
	var i uint32
	for x[i] == 0 {
		i++
	}
	if i == uint32(len(x))-1 && x[i]&(x[i]-1) == 0 {
		return i*_W + uint32(bits.TrailingZeros(uint32(x[i]))), true
	}
	return 0, false
}

func same(x, y []Word) (rok bool) {
	return len(x) == len(y) && len(x) > 0 && &x[0] == &y[0]
}

// z = x << s
func natLsh(z []Word, x []Word, s uint32) (rnat []Word) {
	if s == 0 {
		if same(z, x) {
			return z
		}
		if !alias(z, x) {
			return natSet(z, x)
		}
	}

	m := len(x)
	if m == 0 {
		return z[:0]
	}
	// m > 0

	n := m + int32(s/_W)
	z = natAlloc(z, n + 1)
	if s %= _W; s == 0 {
		copy(z[n-m:n], x)
		z[n] = 0
	} else {
		z[n] = lshVU(z[n-m:n], x, s)
	}
	clear(z[0 : n-m])

	return natNorm(z)
}

// z = x >> s
func natRsh(z []Word, x []Word, s uint32) (rnat []Word) {
	if s == 0 {
		if same(z, x) {
			return z
		}
		if !alias(z, x) {
			return natSet(z, x)
		}
	}

	m := len(x)
	n := m - int32(s/_W)
	if n <= 0 {
		return z[:0]
	}
	// n > 0

	z = natAlloc(z, n)
	if s %= _W; s == 0 {
		copy(z, x[m-n:])
	} else {
		rshVU(z, x[m-n:], s)
	}

	return natNorm(z)
}

func natSetBit(z []Word, x []Word, i uint32, b uint32) (rnat []Word) {
	j := int32(i / _W)
	m := Word(1) << (i % _W)
	n := len(x)
	switch b {
	case 0:
		z = natAlloc(z, n)
		copy(z, x)
		if j >= n {
			// no need to grow
			return z
		}
		z[j] &^= m
		return natNorm(z)
	case 1:
		if j >= n {
			z = natAlloc(z, j + 1)
			clear(z[n:])
		} else {
			z = natAlloc(z, n)
		}
		copy(z, x)
		z[j] |= m
		// no need to normalize
		return z
	}
	panic("set bit is not 0 or 1")
}

// bit returns the value of the i'th bit, with lsb == bit 0.
func natBit(x []Word, i uint32) (rn uint32) {
	j := i / _W
	if j >= uint32(len(x)) {
		return 0
	}
	// 0 <= j < len(x)
	return uint32(x[j] >> (i % _W) & 1)
}

// sticky returns 1 if there's a 1 bit within the
// i least significant bits, otherwise it returns 0.
func natSticky(x []Word, i uint32) (rn uint32) {
	j := i / _W
	if j >= uint32(len(x)) {
		if len(x) == 0 {
			return 0
		}
		return 1
	}
	// 0 <= j < len(x)
	for _, w := range x[:j] {
		if w != 0 {
			return 1
		}
	}
	if x[j]<<(_W-i%_W) != 0 {
		return 1
	}
	return 0
}

func natAnd(z []Word, x, y []Word) (rnat []Word) {
	m := len(x)
	n := len(y)
	if m > n {
		m = n
	}
	// m <= n

	z = natAlloc(z, m)
	for i := 0; i < m; i++ {
		z[i] = x[i] & y[i]
	}

	return natNorm(z)
}

// trunc returns z = x mod 2ⁿ.
func natTrunc(z []Word, x []Word, n uint32) (rnat []Word) {
	w := (n + _W - 1) / _W
	if uint32(len(x)) < w {
		return natSet(z, x)
	}
	z = natAlloc(z, int32(w))
	copy(z, x)
	if n%_W != 0 {
		z[len(z)-1] &= 1<<(n%_W) - 1
	}
	return natNorm(z)
}

func natAndNot(z []Word, x, y []Word) (rnat []Word) {
	m := len(x)
	n := len(y)
	if n > m {
		n = m
	}
	// m >= n

	z = natAlloc(z, m)
	for i := 0; i < n; i++ {
		z[i] = x[i] &^ y[i]
	}
	copy(z[n:m], x[n:m])

	return natNorm(z)
}

func natOr(z []Word, x, y []Word) (rnat []Word) {
	m := len(x)
	n := len(y)
	s := x
	if m < n {
		n, m = m, n
		s = y
	}
	// m >= n

	z = natAlloc(z, m)
	for i := 0; i < n; i++ {
		z[i] = x[i] | y[i]
	}
	copy(z[n:m], s[n:m])

	return natNorm(z)
}

func natXor(z []Word, x, y []Word) (rnat []Word) {
	m := len(x)
	n := len(y)
	s := x
	if m < n {
		n, m = m, n
		s = y
	}
	// m >= n

	z = natAlloc(z, m)
	for i := 0; i < n; i++ {
		z[i] = x[i] ^ y[i]
	}
	copy(z[n:m], s[n:m])

	return natNorm(z)
}

// random creates a random integer in [0..limit), using the space in z if
// possible. n is the bit length of limit.
func natRandom(z []Word, rnd *rand.Rand, limit []Word, n int32) (rnat []Word) {
	if alias(z, limit) {
		z = nil // z is an alias for limit - cannot reuse
	}
	z = natAlloc(z, len(limit))

	bitLengthOfMSW := uint32(n % _W)
	if bitLengthOfMSW == 0 {
		bitLengthOfMSW = _W
	}
	mask := Word((1 << bitLengthOfMSW) - 1)

	for {
		switch _W {
		case 32:
			for i := range z {
				z[i] = Word(rnd.Uint32())
			}
		case 64:
			for i := range z {
				z[i] = Word(rnd.Uint32()) | Word(rnd.Uint32())<<32
			}
		default:
			panic("unknown word size")
		}
		z[len(limit)-1] &= mask
		if natCmp(z, limit) < 0 {
			break
		}
	}

	return natNorm(z)
}

// If m != 0 (i.e., len(m) != 0), expNN sets z to x**y mod m;
// otherwise it sets z to x**y. The result is the value of z.
// The caller may pass stk == nil to request that expNN obtain and release one itself.
func natExpNN(z []Word, stk *stack, x, y, m []Word, slow bool) (rnat []Word) {
	if alias(z, x) || alias(z, y) {
		// We cannot allow in-place modification of x or y.
		z = nil
	}

	// x**y mod 1 == 0
	if len(m) == 1 && m[0] == 1 {
		return natSetWord(z, 0)
	}
	// m == 0 || m > 1

	// x**0 == 1
	if len(y) == 0 {
		return natSetWord(z, 1)
	}
	// y > 0

	// 0**y = 0
	if len(x) == 0 {
		return natSetWord(z, 0)
	}
	// x > 0

	// 1**y = 1
	if len(x) == 1 && x[0] == 1 {
		return natSetWord(z, 1)
	}
	// x > 1

	// x**1 == x
	if len(y) == 1 && y[0] == 1 && len(m) == 0 {
		return natSet(z, x)
	}
	if stk == nil {
		stk = getStack()
		defer stk.free()
	}
	if len(y) == 1 && y[0] == 1 { // len(m) > 0
		return natRem(z, stk, x, m)
	}

	// y > 1

	if len(m) != 0 {
		// We likely end up being as long as the modulus.
		z = natAlloc(z, len(m))

		// If the exponent is large, we use the Montgomery method for odd values,
		// and a 4-bit, windowed exponentiation for powers of two,
		// and a CRT-decomposed Montgomery method for the remaining values
		// (even values times non-trivial odd values, which decompose into one
		// instance of each of the first two cases).
		if len(y) > 1 && !slow {
			if m[0]&1 == 1 {
				return natExpNNMontgomery(z, stk, x, y, m)
			}
			if logM, ok := natIsPow2(m); ok {
				return natExpNNWindowed(z, stk, x, y, logM)
			}
			return natExpNNMontgomeryEven(z, stk, x, y, m)
		}
	}

	z = natSet(z, x)
	v := y[len(y)-1] // v > 0 because y is normalized and y > 0
	shift := nlz(v) + 1
	v <<= shift
	var q []Word

	const mask = 1 << (_W - 1)

	// We walk through the bits of the exponent one by one. Each time we
	// see a bit, we square, thus doubling the power. If the bit is a one,
	// we also multiply by x, thus adding one to the power.

	w := _W - int32(shift)
	// zz and r are used to avoid allocating in mul and div as
	// otherwise the arguments would alias.
	var zz, r []Word
	for j := 0; j < w; j++ {
		zz = natSqr(zz, stk, z)
		zz, z = z, zz

		if v&mask != 0 {
			zz = natMul(zz, stk, z, x)
			zz, z = z, zz
		}

		if len(m) != 0 {
			zz, r = natDiv(zz, stk, r, z, m)
			zz, r, q, z = q, z, zz, r
		}

		v <<= 1
	}

	for i := len(y) - 2; i >= 0; i-- {
		v = y[i]

		for j := 0; j < _W; j++ {
			zz = natSqr(zz, stk, z)
			zz, z = z, zz

			if v&mask != 0 {
				zz = natMul(zz, stk, z, x)
				zz, z = z, zz
			}

			if len(m) != 0 {
				zz, r = natDiv(zz, stk, r, z, m)
				zz, r, q, z = q, z, zz, r
			}

			v <<= 1
		}
	}

	return natNorm(z)
}

// expNNMontgomeryEven calculates x**y mod m where m = m1 × m2 for m1 = 2ⁿ and m2 odd.
// It uses two recursive calls to expNN for x**y mod m1 and x**y mod m2
// and then uses the Chinese Remainder Theorem to combine the results.
// The recursive call using m1 will use expNNWindowed,
// while the recursive call using m2 will use expNNMontgomery.
// For more details, see Ç. K. Koç, "Montgomery Reduction with Even Modulus",
// IEE Proceedings: Computers and Digital Techniques, 141(5) 314-316, September 1994.
// http://www.people.vcu.edu/~jwang3/CMSC691/j34monex.pdf
func natExpNNMontgomeryEven(z []Word, stk *stack, x, y, m []Word) (rnat []Word) {
	// Split m = m₁ × m₂ where m₁ = 2ⁿ
	n := natTrailingZeroBits(m)
	m1 := natLsh([]Word(nil), _natOne(), n)
	m2 := natRsh([]Word(nil), m, n)

	// We want z = x**y mod m.
	// z₁ = x**y mod m1 = (x**y mod m) mod m1 = z mod m1
	// z₂ = x**y mod m2 = (x**y mod m) mod m2 = z mod m2
	// (We are using the math/big convention for names here,
	// where the computation is z = x**y mod m, so its parts are z1 and z2.
	// The paper is computing x = a**e mod n; it refers to these as x2 and z1.)
	z1 := natExpNN([]Word(nil), stk, x, y, m1, false)
	z2 := natExpNN([]Word(nil), stk, x, y, m2, false)

	// Reconstruct z from z₁, z₂ using CRT, using algorithm from paper,
	// which uses only a single modInverse (and an easy one at that).
	//	p = (z₁ - z₂) × m₂⁻¹ (mod m₁)
	//	z = z₂ + p × m₂
	// The final addition is in range because:
	//	z = z₂ + p × m₂
	//	  ≤ z₂ + (m₁-1) × m₂
	//	  < m₂ + (m₁-1) × m₂
	//	  = m₁ × m₂
	//	  = m.
	z = natSet(z, z2)

	// Compute (z₁ - z₂) mod m1 [m1 == 2**n] into z1.
	z1 = natSubMod2N(z1, z1, z2, n)

	// Reuse z2 for p = (z₁ - z₂) [in z1] * m2⁻¹ (mod m₁ [= 2ⁿ]).
	m2inv := natModInverse([]Word(nil), m2, m1)
	z2 = natMul(z2, stk, z1, m2inv)
	z2 = natTrunc(z2, z2, n)

	// Reuse z1 for p * m2.
	z = natAdd(z, z, natMul(z1, stk, z2, m2))

	return z
}

// expNNWindowed calculates x**y mod m using a fixed, 4-bit window,
// where m = 2**logM.
func natExpNNWindowed(z []Word, stk *stack, x, y []Word, logM uint32) (rnat []Word) {
	if len(y) <= 1 {
		panic("big: misuse of expNNWindowed")
	}
	if x[0]&1 == 0 {
		// len(y) > 1, so y  > logM.
		// x is even, so x**y is a multiple of 2**y which is a multiple of 2**logM.
		return natSetWord(z, 0)
	}
	if logM == 1 {
		return natSetWord(z, 1)
	}

	// zz is used to avoid allocating in mul as otherwise
	// the arguments would alias.
	defer stk.restore(stk.save())
	w := int32((logM + _W - 1) / _W)
	zz := stk.nat(w)

	const n = 4
	// powers[i] contains x^i.
	var powers [1 << n][]Word
	for pi := range powers {
		powers[pi] = stk.nat(w)
	}
	powers[0] = natSet(powers[0], _natOne())
	powers[1] = natTrunc(powers[1], x, logM)
	for pi := 2; pi < 1<<n; pi += 2 {
		p2, p, p1 := &powers[pi/2], &powers[pi], &powers[pi+1]
		*p = natSqr(*p, stk, *p2)
		*p = natTrunc(*p, *p, logM)
		*p1 = natMul(*p1, stk, *p, x)
		*p1 = natTrunc(*p1, *p1, logM)
	}

	// Because phi(2**logM) = 2**(logM-1), x**(2**(logM-1)) = 1,
	// so we can compute x**(y mod 2**(logM-1)) instead of x**y.
	// That is, we can throw away all but the bottom logM-1 bits of y.
	// Instead of allocating a new y, we start reading y at the right word
	// and truncate it appropriately at the start of the loop.
	i := len(y) - 1
	mtop := int32((logM - 2) / _W) // -2 because the top word of N bits is the (N-1)/W'th word.
	mmask := ^Word(0)
	if mbits := (logM - 1) & (_W - 1); mbits != 0 {
		mmask = (1 << mbits) - 1
	}
	if i > mtop {
		i = mtop
	}
	advance := false
	z = natSetWord(z, 1)
	for ; i >= 0; i-- {
		yi := y[i]
		if i == mtop {
			yi &= mmask
		}
		for j := 0; j < _W; j += n {
			if advance {
				// Account for use of 4 bits in previous iteration.
				// Unrolled loop for significant performance
				// gain. Use go test -bench=".*" in crypto/rsa
				// to check performance before making changes.
				zz = natSqr(zz, stk, z)
				zz, z = z, zz
				z = natTrunc(z, z, logM)

				zz = natSqr(zz, stk, z)
				zz, z = z, zz
				z = natTrunc(z, z, logM)

				zz = natSqr(zz, stk, z)
				zz, z = z, zz
				z = natTrunc(z, z, logM)

				zz = natSqr(zz, stk, z)
				zz, z = z, zz
				z = natTrunc(z, z, logM)
			}

			zz = natMul(zz, stk, z, powers[yi>>(_W-n)])
			zz, z = z, zz
			z = natTrunc(z, z, logM)

			yi <<= n
			advance = true
		}
	}

	return natNorm(z)
}

// expNNMontgomery calculates x**y mod m using a fixed, 4-bit window.
// Uses Montgomery representation.
func natExpNNMontgomery(z []Word, stk *stack, x, y, m []Word) (rnat []Word) {
	numWords := len(m)

	// We want the lengths of x and m to be equal.
	// It is OK if x >= m as long as len(x) == len(m).
	if len(x) > numWords {
		_, x = natDiv([]Word(nil), stk, nil, x, m)
		// Note: now len(x) <= numWords, not guaranteed ==.
	}
	if len(x) < numWords {
		rr := []Word{:numWords}
		copy(rr, x)
		x = rr
	}

	// Ideally the precomputations would be performed outside, and reused
	// k0 = -m**-1 mod 2**_W. Algorithm from: Dumas, J.G. "On Newton-Raphson
	// Iteration for Multiplicative Inverses Modulo Prime Powers".
	k0 := 2 - m[0]
	t := m[0] - 1
	for i := 1; i < _W; i <<= 1 {
		t *= t
		k0 *= (t + 1)
	}
	k0 = -k0

	// RR = 2**(2*_W*len(m)) mod m
	RR := natSetWord([]Word(nil), 1)
	zz := natLsh([]Word(nil), RR, uint32(2*numWords*_W))
	_, RR = natDiv([]Word(nil), stk, RR, zz, m)
	if len(RR) < numWords {
		zz = natAlloc(zz, numWords)
		copy(zz, RR)
		RR = zz
	}
	// one = 1, with equal length to that of m
	one := []Word{:numWords}
	one[0] = 1

	const n = 4
	// powers[i] contains x^i
	var powers [1 << n][]Word
	powers[0] = natMontgomery(powers[0], one, RR, m, k0, numWords)
	powers[1] = natMontgomery(powers[1], x, RR, m, k0, numWords)
	for i := 2; i < 1<<n; i++ {
		powers[i] = natMontgomery(powers[i], powers[i-1], powers[1], m, k0, numWords)
	}

	// initialize z = 1 (Montgomery 1)
	z = natAlloc(z, numWords)
	copy(z, powers[0])

	zz = natAlloc(zz, numWords)

	// same windowed exponent, but with Montgomery multiplications
	for i := len(y) - 1; i >= 0; i-- {
		yi := y[i]
		for j := 0; j < _W; j += n {
			if i != len(y)-1 || j != 0 {
				zz = natMontgomery(zz, z, z, m, k0, numWords)
				z = natMontgomery(z, zz, zz, m, k0, numWords)
				zz = natMontgomery(zz, z, z, m, k0, numWords)
				z = natMontgomery(z, zz, zz, m, k0, numWords)
			}
			zz = natMontgomery(zz, z, powers[yi>>(_W-n)], m, k0, numWords)
			z, zz = zz, z
			yi <<= n
		}
	}
	// convert to regular number
	zz = natMontgomery(zz, z, one, m, k0, numWords)

	// One last reduction, just in case.
	// See golang.org/issue/13907.
	if natCmp(zz, m) >= 0 {
		// Common case is m has high bit set; in that case,
		// since zz is the same length as m, there can be just
		// one multiple of m to remove. Just subtract.
		// We think that the subtract should be sufficient in general,
		// so do that unconditionally, but double-check,
		// in case our beliefs are wrong.
		// The div is not expected to be reached.
		zz = natSub(zz, zz, m)
		if natCmp(zz, m) >= 0 {
			_, zz = natDiv([]Word(nil), stk, nil, zz, m)
		}
	}

	return natNorm(zz)
}

// bytes writes the value of z into buf using big-endian encoding.
// The value of z is encoded in the slice buf[i:]. If the value of z
// cannot be represented in buf, bytes panics. The number i of unused
// bytes at the beginning of buf is returned as result.
func natBytes(z []Word, buf []byte) (i int32) {
	// This function is used in cryptographic operations. It must not leak
	// anything but the Int's sign and bit size through side-channels. Any
	// changes must be reviewed by a security expert.
	i = len(buf)
	for _, d := range z {
		for j := 0; j < _S; j++ {
			i--
			if i >= 0 {
				buf[i] = byte(d)
			} else if byte(d) != 0 {
				panic("math/big: buffer too small to fit value")
			}
			d >>= 8
		}
	}

	if i < 0 {
		i = 0
	}
	for i < len(buf) && buf[i] == 0 {
		i++
	}

	return
}

// bigEndianWord returns the contents of buf interpreted as a big-endian encoded Word value.
func bigEndianWord(buf []byte) (rword Word) {
	if _W == 64 {
		return Word(byteorder.BEUint64(buf))
	}
	return Word(byteorder.BEUint32(buf))
}

// setBytes interprets buf as the bytes of a big-endian unsigned
// integer, sets z to that value, and returns z.
func natSetBytes(z []Word, buf []byte) (rnat []Word) {
	z = natAlloc(z, (len(buf) + _S - 1) / _S)

	i := len(buf)
	for k := 0; i >= _S; k++ {
		z[k] = bigEndianWord(buf[i-_S : i])
		i -= _S
	}
	if i > 0 {
		var d Word
		for s := uint32(0); i > 0; s += 8 {
			d |= Word(buf[i-1]) << s
			i--
		}
		z[len(z)-1] = d
	}

	return natNorm(z)
}

// sqrt sets z = ⌊√x⌋
// The caller may pass stk == nil to request that sqrt obtain and release one itself.
func natSqrt(z []Word, stk *stack, x []Word) (rnat []Word) {
	if natCmp(x, _natOne()) <= 0 {
		return natSet(z, x)
	}
	if alias(z, x) {
		z = nil
	}

	if stk == nil {
		stk = getStack()
		defer stk.free()
	}

	// Start with value known to be too large and repeat "z = ⌊(z + ⌊x/z⌋)/2⌋" until it stops getting smaller.
	// See Brent and Zimmermann, Modern Computer Arithmetic, Algorithm 1.13 (SqrtInt).
	// https://members.loria.fr/PZimmermann/mca/pub226.html
	// If x is one less than a perfect square, the sequence oscillates between the correct z and z+1;
	// otherwise it converges to the correct z and stays there.
	var z1, z2 []Word
	z1 = z
	z1 = natSetUint64(z1, 1)
	z1 = natLsh(z1, z1, uint32(natBitLen(x)+1)/2) // must be ≥ √x
	for n := 0; ; n++ {
		z2, _ = natDiv(z2, stk, nil, x, z1)
		z2 = natAdd(z2, z2, z1)
		z2 = natRsh(z2, z2, 1)
		if natCmp(z2, z1) >= 0 {
			// z1 is answer.
			// Figure out whether z1 or z2 is currently aliased to z by looking at loop count.
			if n&1 == 0 {
				return z1
			}
			return natSet(z, z1)
		}
		z1, z2 = z2, z1
	}
}

// subMod2N returns z = (x - y) mod 2ⁿ.
func natSubMod2N(z []Word, x, y []Word, n uint32) (rnat []Word) {
	if uint32(natBitLen(x)) > n {
		if alias(z, x) {
			// ok to overwrite x in place
			x = natTrunc(x, x, n)
		} else {
			x = natTrunc([]Word(nil), x, n)
		}
	}
	if uint32(natBitLen(y)) > n {
		if alias(z, y) {
			// ok to overwrite y in place
			y = natTrunc(y, y, n)
		} else {
			y = natTrunc([]Word(nil), y, n)
		}
	}
	if natCmp(x, y) >= 0 {
		return natSub(z, x, y)
	}
	// x - y < 0; x - y mod 2ⁿ = x - y + 2ⁿ = 2ⁿ - (y - x) = 1 + 2ⁿ-1 - (y - x) = 1 + ^(y - x).
	z = natSub(z, y, x)
	for uint32(len(z))*_W < n {
		z = mxutil.Ensure(z, 1)
		z = push(z, 0)
	}
	for i := range z {
		z[i] = ^z[i]
	}
	z = natTrunc(z, z, n)
	return natAdd(z, z, _natOne())
}
