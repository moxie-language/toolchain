//:build !math_big_pure_go

package big

import "internal/cpu"

var hasADX bool
var _hasADXChecked bool

func initCheckHasADX() (rok bool) {
	if !_hasADXChecked {
		hasADX = cpu.X86.HasADX && cpu.X86.HasBMI2
		_hasADXChecked = true
	}
	return hasADX
}
