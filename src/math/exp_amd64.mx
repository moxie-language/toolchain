//go:build amd64
//:build amd64

package math

import "internal/cpu"

var useFMA bool
var _useFMAChecked bool

func checkUseFMA() bool {
	if !_useFMAChecked {
		useFMA = cpu.X86.HasAVX && cpu.X86.HasFMA
		_useFMAChecked = true
	}
	return useFMA
}
