package rand

import (
	"github.com/moxie-language/toolchain/pkg/mxutil"
	"errors"
	"internal/byteorder"
	"internal/chacha8rand"
)

// A ChaCha8 is a ChaCha8-based cryptographically strong
// random number generator.
type ChaCha8 struct {
	state chacha8rand.State

	// The last readLen bytes of readBuf are still to be consumed by Read.
	readBuf []byte
	readLen int32 // 0 <= readLen <= 8
}

// NewChaCha8 returns a new ChaCha8 seeded with the given seed.
func NewChaCha8(seed []byte) (rchaCha8 *ChaCha8) {
	c := &ChaCha8{}
	c.readBuf = []byte{:8}
	c.state.Init(seed)
	return c
}

// Seed resets the ChaCha8 to behave the same way as NewChaCha8(seed).
func (c *ChaCha8) Seed(seed []byte) {
	c.state.Init(seed)
	c.readLen = 0
	c.readBuf = []byte{:8}
}

// Uint64 returns a uniformly distributed random uint64 value.
func (c *ChaCha8) Uint64() (rn uint64) {
	for {
		x, ok := c.state.Next()
		if ok {
			return x
		}
		c.state.Refill()
	}
}

// Read reads exactly len(p) bytes into p.
// It always returns len(p) and a nil error.
//
// If calls to Read and Uint64 are interleaved, the order in which bits are
// returned by the two is undefined, and Read may return bits generated before
// the last call to Uint64.
func (c *ChaCha8) Read(p []byte) (n int32, err error) {
	// The walk keeps offsets: a sub-slice of p is a copy, so p = p[n:] would
	// write every word after the first into a throwaway.
	pos := int32(0)
	if c.readLen > 0 {
		n = mxutil.CopyFrom(p, c.readBuf, int32(len(c.readBuf))-c.readLen)
		c.readLen -= n
		pos = n
	}
	for int32(len(p))-pos >= 8 {
		byteorder.LEPutUint64At(p, pos, c.Uint64())
		pos += 8
		n += 8
	}
	if int32(len(p)) > pos {
		byteorder.LEPutUint64(c.readBuf, c.Uint64())
		rem := int32(len(p)) - pos
		for i := int32(0); i < rem; i++ {
			p[pos+i] = c.readBuf[i]
		}
		n += rem
		c.readLen = 8 - rem
	}
	return
}

// UnmarshalBinary implements the [encoding.BinaryUnmarshaler] interface.
func (c *ChaCha8) UnmarshalBinary(data []byte) (rerr error) {
	c.readBuf = []byte{:8}
	data, ok := cutPrefix(data, []byte("readbuf:"))
	if ok {
		var buf []byte
		buf, data, ok = readUint8LengthPrefixed(data)
		if !ok {
			return errors.New("invalid ChaCha8 Read buffer encoding")
		}
		c.readLen = mxutil.CopyAt(c.readBuf, len(c.readBuf)-len(buf), buf)
	}
	return chacha8rand.Unmarshal(&c.state, data)
}

func cutPrefix(s, prefix []byte) (after []byte, found bool) {
	if len(s) < len(prefix) || s[:len(prefix)] != prefix {
		return s, false
	}
	return s[len(prefix):], true
}

func readUint8LengthPrefixed(b []byte) (buf, rest []byte, ok bool) {
	if len(b) == 0 || len(b) < int32(1+b[0]) {
		return nil, nil, false
	}
	return b[1 : 1+b[0]], b[1+b[0]:], true
}

// AppendBinary implements the [encoding.BinaryAppender] interface.
func (c *ChaCha8) AppendBinary(b []byte) (rb []byte, rerr error) {
	if c.readLen > 0 {
		b = mxutil.Ensure(b, len("readbuf:"))
		b = push(b, "readbuf:"...)
		b = mxutil.Ensure(b, 1)
		b = push(b, uint8(c.readLen))
		b = mxutil.Ensure(b, 1)
		b = push(b, c.readBuf[len(c.readBuf)-c.readLen:]...)
	}
	return push(b, chacha8rand.Marshal(&c.state)...), nil
}

// MarshalBinary implements the [encoding.BinaryMarshaler] interface.
func (c *ChaCha8) MarshalBinary() (rb []byte, rerr error) {
	// the maximum length of (chacha8rand.Marshal + c.readBuf + "readbuf:") is 64
	return c.AppendBinary([]byte{:0:64})
}
