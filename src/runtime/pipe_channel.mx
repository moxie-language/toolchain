//:build linux

package runtime

// Spawn channel IPC - bridges channels across spawn domain boundaries
// over shared SPSC ring buffers (mmap MAP_SHARED). No socketpair, no
// pipe: a domain is a thread, both ends share the address space, so the
// ring is the one true transport. This file is the ring-routing layer
// the compiler-emitted chan ops dispatch through.
//
// A frame is the element's own bytes when the element holds no references, and
// its codec's output otherwise (see PipeChanSendRaw). The ring does not care
// which: it carries a length-prefixed frame.
//
// Control signals ride the same shared memory:
//   - channel close  -> ringClose (the ring header's closed flag)
//   - child-ready    -> a shared spawnCtl.ready atomic
//   - child death    -> the child's DomainClosed flag, published as it returns

import (
	"moxie"
	"unsafe"
)

// ringMaxMsg caps the size of a single chan-IPC frame. The ring is sized
// to carry it (32MB ring, lazily faulted, so the virtual reservation is
// cheap). Frames over this limit are rejected fail-loud so the protocol
// never silently truncates.
const ringMaxMsg = 32 << 20

// channelIsPipeBound reports whether the channel is on a spawn boundary.
// chSendRing and chRecvRing resolve a channel's direction for THIS domain.
// The parent sends on the parent->child ring and receives on the other; a spawn
// target does the reverse. One shared object, role-based direction.
func chSendRing(ch *channel) uintptr {
	if childSpawnTarget {
		return ch.ringB
	}
	return ch.ringA
}

func chRecvRing(ch *channel) uintptr {
	if childSpawnTarget {
		return ch.ringA
	}
	return ch.ringB
}

// A spawn-bound channel always has both rings bound; the compiler
// and chan.mx dispatch on spawnBound to route off the in-runtime queue.
func channelIsPipeBound(ch *channel) bool {
	return ch != nil && ch.spawnBound
}

// MarkChannelPipeBound tags ch as spawn-bound at chanID. Both the
// parent's and the child's view of the same logical channel call this
// with the same chanID; each then binds its own ring halves.
func MarkChannelPipeBound(ch *channel, chanID uint16) {
	if ch == nil {
		return
	}
	ch.spawnBound = true
	ch.spawnChanID = chanID
}

// MarkChildPipeChannel is the child-side variant emitted by
// setupNativeSpawnTargetChannels: it binds ch to the shared rings if and
// only if the function is running as a spawn target (childSpawnTarget).
// Calling the function as a regular local invocation leaves the
// parameter as a plain local channel.
func MarkChildPipeChannel(ch *channel, chanID uint16) {
	if !childSpawnTarget {
		return
	}
	MarkChannelPipeBound(ch, chanID)
	// One pair, bound identically from either side: chSendRing/chRecvRing pick
	// the direction by role, because both domains hold this same object.
	idx := int32(chanID) - 1
	if idx >= 0 && idx < spawnRingCount {
		ch.ringA = spawnRingSet[idx][0] // parent->child
		ch.ringB = spawnRingSet[idx][1] // child->parent
	}
	ch.spawnPid = 0 // threads: the peer is this process, liveness is the closed flag
}

// MarkParentPipeChannel binds ch to the most recently spawned child's
// ring pair at chanID. Emitted by createSpawn after spawnDomain returns.
// No-op if no spawn has occurred (defensive - should not happen).
func MarkParentPipeChannel(ch *channel, chanID uint16) {
	MarkChannelPipeBound(ch, chanID)
	idx := int32(chanID) - 1
	if idx >= 0 && idx < spawnRingCount {
		ch.ringA = spawnRingSet[idx][0] // parent->child
		ch.ringB = spawnRingSet[idx][1] // child->parent
	}
	ch.spawnPid = 0 // threads: the peer is this process, liveness is the closed flag
}

// peerAlive reports whether this domain should keep WAITING on ch. A spawn
// target's peer is its parent in the same process - there is no pid to poll, so
// the domain's own breaker is the signal: once the parent closes DomainClosed,
// every blocking operation in the target must return instead of parking
// forever. That is what makes termination observable inside a work loop, which
// is where a cooperative domain actually spends its time: a worker parked on
// its inbox has not returned to the top-level select and never will on its own.
//
// In the parent the peer cannot be observed this way (a channel does not know
// which domain owns it); the parent's liveness test is the breaker it holds,
// and a parent that must not block uses a non-blocking poll.
func peerAlive(ch *channel) bool {
	if childSpawnTarget && DomainClosed != nil {
		return !ringIsClosed(DomainClosed.ringA) && !DomainClosed.closed
	}
	if ch != nil && ch.ownerBreaker != nil {
		return !ringIsClosed(ch.ownerBreaker.ringA) && !ch.ownerBreaker.closed
	}
	return true
}

// breakerSendReason puts the reason a domain stopped onto its breaker as a
// structural []byte frame, BEFORE the breaker closes, so the parent reads it
// with an ordinary receive on the channel spawn returned: it learns why the
// child stopped before it loses the ability to ask. The frame is encoded, not a
// raw slice header, because the reason must be copied into the parent's arena -
// a header would point into the dead child's pages.
func breakerSendReason(ch *channel, code int32, msg string) {
	if ch == nil {
		return
	}
	// The first space-separated token is the process exit code, the standard
	// unix return value: a panic aborts (134), a clean stop is 0, a killed
	// domain is 128+signal. The rest is the diagnostic, printed to the shared
	// stderr by the component that failed.
	text := codecItoa(code) | " " | msg
	n := len(text)
	if n > breakerReasonMax {
		n = breakerReasonMax
	}
	reason := []byte(text[:n])
	var cb CodecBuf
	var ss codecSeenSet
	codecSeenInit(&ss)
	var rt RawType
	rt = RawType{meta: uint8(KindBytes)}
	// Cross-domain: a stable-slice frame would hand the parent a header pointing
	// into this dying domain's arena. The parent needs its own copy.
	codecCrossDomain = true
	codecEncodeValue(&cb, &ss, unsafe.Pointer(&reason), &rt)
	codecCrossDomain = false
	PipeChanSend(ch, cb.data)
}

// breakerFallback is the native answer to a nil breaker: the target was called
// instead of spawned, so no domain and no breaker exist. Fail loud.
func breakerFallback() *channel {
	runtimePanic("spawn target called directly: closed breaker is nil; spawn it instead of calling it")
	return nil
}

// PipeChanSend is the runtime entry the compiler emits in place of the
// in-runtime queue send for spawn-bound channels. Writes the encoded
// bytes to the send ring. The channel's declared capacity is how many
// messages may be OUTSTANDING - sent and not yet received - so a send
// returns as soon as its frame is in the ring and parks only when that
// many are already waiting. Parks on the ring's read index, which the
// receiver advances on every consume; the park is bounded and the loop
// rechecks liveness after each return, so a crashed peer surfaces as a
// failed send rather than a hang. Returns false on close or peer death.
// Fail-loud on frames that can never fit the ring.
func PipeChanSend(ch *channel, encoded []byte) bool {
	if ch == nil || !ch.spawnBound {
		return false
	}
	if chSendRing(ch) == 0 {
		return false
	}
	// The ring is sized from this budget, so a message over it means the
	// declared cap dimensions do not describe this value. Both sides of a spawn
	// channel are trusted code, and the budget is the bound the declaration
	// promised: overrun it and the programmer is taking the piss, so the send
	// dies naming the actual size, the budget and the fields to fix. The budget
	// is checked before the ring size so the declaration-level message is the
	// one a programmer sees.
	if uintptr(len(encoded)) > ch.frameBudget {
		pipeBudgetPanic(ch, uintptr(len(encoded)))
	}
	if !ringFits(chSendRing(ch), int32(len(encoded))) {
		runtimePanic("PipeChanSend: frame exceeds ring size")
	}
	// One slot is the default (`chan T{}`): the mailbox the event-loop model
	// needs, where the first send never blocks and the second waits for the
	// receiver to take the first. A deeper buffer trades latency for slack.
	slots := uint32(ch.bufCap)
	need := ringAlign8(4 + uint32(len(encoded)))
	for {
		if ringIsClosed(chSendRing(ch)) {
			return false
		}
		if ringDepth(chSendRing(ch)) < slots && ringSend(chSendRing(ch), encoded) {
			return true
		}
		if !peerAlive(ch) {
			ringClose(chSendRing(ch))
			return false
		}
		ringParkRead(chSendRing(ch), need)
	}
}

// pipeBudgetPanic is the loud failure for a frame that overruns the channel's
// declared frame budget. Both sides of a spawn channel are trusted - the code
// is fixed at compile time - so an overrun is a declaration that does not
// describe the data, and the programmer is expected to fix the cap tag rather
// than have the ring quietly wrap. The note carried on the channel is the
// compiler's list of the variable-length fields and the caps they declare.
func pipeBudgetPanic(ch *channel, actual uintptr) {
	head := "spawn channel: encoded frame of " | codecItoa(int32(actual)) | " bytes exceeds the "
	tail := "-byte frame budget. Variable-length fields and their cap tags: " | ch.frameNote
	runtimePanic(head | codecItoa(int32(ch.frameBudget)) | tail)
}

// PipeChanRecv is the runtime entry the compiler emits in place of the
// in-runtime queue recv for spawn-bound channels. Parks on the recv
// ring's write index until data arrives, the channel closes, or the
// bounded wait elapses; the loop rechecks both ring state and peer
// liveness on every return, so a dead peer is reported, never waited
// on forever. Returns (encoded_bytes, ok). ok=false means closed/dead.
func PipeChanRecv(ch *channel) ([]byte, bool) {
	if ch == nil || !ch.spawnBound {
		return nil, false
	}
	if chRecvRing(ch) == 0 {
		return nil, false
	}
	for {
		data, ok := ringRecv(chRecvRing(ch))
		if ok {
			return data, true
		}
		if ringIsClosed(chRecvRing(ch)) {
			return nil, false
		}
		if !peerAlive(ch) {
			// The final reason may have landed on the ring just before the
			// close; deliver it before declaring the channel dead.
			if lateData, late := ringRecv(chRecvRing(ch)); late {
				return lateData, true
			}
			ringClose(chRecvRing(ch))
			// ok=false is the answer. A forked child used to exit() the PROCESS
			// here, which is right for a process and fatal for a thread: it
			// terminated every other domain in the program. The target gets
			// false and returns, which is its termination arm.
			return nil, false
		}
		ringParkWrite(chRecvRing(ch))
	}
}

// PipeChanCloseSignal notifies the remote end that the local end of ch
// has been closed. Ring-only: closes both rings so the peer's recv
// observes ringIsClosed and its send observes ringIsClosed.
func PipeChanCloseSignal(ch *channel) {
	if ch == nil || !ch.spawnBound {
		return
	}
	if chSendRing(ch) != 0 {
		ringClose(chSendRing(ch))
	}
	if chRecvRing(ch) != 0 {
		ringClose(chRecvRing(ch))
	}
}

// PipeChanSendRaw routes a raw memory-layout chan send through the send
// ring. Non-blocking with retry-and-yield, same as PipeChanSend.
//
// This is the extent path, and it is the whole protocol for an element type
// that holds no references: both ends are threads in one address space running
// the same binary, so the value's bytes ARE its wire form, and the codec that
// used to re-encode them was paying a method dispatch and a tag per field to
// reproduce bytes that were already there. An element that holds references
// stays on the codec path - its pointers point into the sender's arena, and the
// relocation the codec performs is the point.
func PipeChanSendRaw(ch *channel, ptr unsafe.Pointer, size int32) bool {
	if ch == nil || !ch.spawnBound {
		return false
	}
	frame, ok := codecFrameEncode(nil, nil, ptr, uintptr(size))
	if !ok {
		return false
	}
	return PipeChanSend(ch, frame)
}

// PipeChanRecvRaw routes a raw chan recv through the recv ring into ptr
// (which must point to a buffer of size bytes). Returns ok (true on
// receive, false on closed/dead).
//
// A frame whose length is not the element size means the two ends disagree
// about the element type. Both ends are generated from one declaration, so that
// is a compiler bug, and it is reported as one: returning false here would
// present it as an ordinary close and the receiver would loop or exit on a
// channel that is perfectly alive.
func PipeChanRecvRaw(ch *channel, ptr unsafe.Pointer, size int32) bool {
	if ch == nil || !ch.spawnBound {
		return false
	}
	data, ok := PipeChanRecv(ch)
	if !ok {
		return false
	}
	return codecFrameDecode(nil, nil, ptr, uintptr(size), data)
}

// SharedBuffer maps n bytes of MAP_SHARED anonymous memory and returns it as a
// slice. Both sides of a fork see the same pages, which is what makes it usable
// as a queue-owned slot ring: the parent writes a message into slot i and sends
// the INDEX, and the worker reads the bytes without a second copy and without an
// allocation. An ordinary arena cannot serve this: after fork the child's copy
// of the parent's arenas is private (copy-on-write), so a slot written after the
// fork is invisible to the child.
//
// Must be called BEFORE the spawn that will use it: pages mapped afterwards are
// not inherited.
func SharedBuffer(n int32) (b []byte) {
	if n <= 0 {
		return nil
	}
	p := sysMapShared(uintptr(n))
	if uintptr(p) == 0 {
		runtimePanic("SharedBuffer: mmap failed")
	}
	return unsafe.Slice((*byte)(p), n)
}

// --- structural codec at the spawn boundary ---
//
// A channel element that holds a slice, map, interface or pointer CANNOT cross
// the boundary as raw bytes: the raw bytes are a reference into this domain's
// arenas, and the receiver's frame that owns them is gone by the time it looks.
// Measured under fork (where the reference read the CHILD's copy-on-write view):
// the child received the right length and the bytes [4, 0, 0, ...] - 4 is the
// first-batch floor of the push allocator, i.e. allocator metadata, not the
// payload.
//
// So such an element is encoded - with its own Codec when the type has one, with
// the STRUCTURAL codec (codecEncodeValue / codecDecodeValue, the same walk
// spawn's argument codec uses) when it does not - and decoded into the
// receiver's arena. The decode is the relocation: the payload crosses by value
// and the receiver owns the bytes it gets.
//
// ChanSendStructural / ChanRecvStructural are the compiler's entries for such
// elements. They dispatch exactly like ChanSendDual / ChanRecvDual: a local
// channel keeps the in-runtime queue path, where no encoding is needed.

// PipeChanSendStructural encodes one value structurally onto the send ring.
func PipeChanSendStructural(ch *channel, td *RawType, value unsafe.Pointer) bool {
	if ch == nil || !ch.spawnBound || td == nil || value == nil {
		return false
	}
	frame, ok := codecFrameEncode(nil, td, value, ch.elementSize)
	if !ok {
		return false
	}
	return PipeChanSend(ch, frame)
}

// PipeChanRecvStructural drains one frame and decodes it into value, which is
// the receiver's own T-sized slot. A slice element therefore arrives with a
// fresh backing in the receiver's current arena.
func PipeChanRecvStructural(ch *channel, td *RawType, value unsafe.Pointer) bool {
	if ch == nil || !ch.spawnBound || td == nil || value == nil {
		return false
	}
	data, ok := PipeChanRecv(ch)
	if !ok {
		return false
	}
	return codecFrameDecode(nil, td, value, ch.elementSize, data)
}

// ChanSendStructural is ChanSendDual's structural counterpart, emitted for chan
// elements that hold pointers. A local channel takes the raw in-runtime queue
// path: only a spawn boundary needs the encode.
func ChanSendStructural(ch *channel, td *RawType, value unsafe.Pointer, op *channelOp) {
	if ch != nil && ch.spawnBound {
		PipeChanSendStructural(ch, td, value)
		return
	}
	chanSend(ch, value, op)
}

// ChanRecvStructural is ChanRecvDual's structural counterpart.
func ChanRecvStructural(ch *channel, td *RawType, value unsafe.Pointer, op *channelOp) bool {
	if ch != nil && ch.spawnBound {
		return PipeChanRecvStructural(ch, td, value)
	}
	return chanRecv(ch, value, op)
}

// tryPipeSend attempts a NON-blocking send on a spawn-bound channel, encoding
// the element at the moment the select arm fires - a frame premised on an arm
// that may never win would pay the encode for nothing, and EncodeTo is a
// caller-written method.
//
// It must not block: the cooperative event loop would deadlock, since the peer
// that would unblock it is the one this loop has to keep servicing.
func (ch *channel) tryPipeSend(value unsafe.Pointer, c moxie.Codec, td *RawType) bool {
	frame, ok := codecFrameEncode(c, td, value, ch.elementSize)
	if !ok {
		return false
	}
	if chSendRing(ch) == 0 || ringDepth(chSendRing(ch)) >= uint32(ch.bufCap) {
		return false
	}
	if uintptr(len(frame)) > ch.frameBudget {
		pipeBudgetPanic(ch, uintptr(len(frame)))
	}
	if !ringFits(chSendRing(ch), int32(len(frame))) {
		runtimePanic("PipeChanSend: frame exceeds ring size")
	}
	return ringSend(chSendRing(ch), frame)
}

// tryPipeRecv attempts a non-blocking receive on a spawn-bound channel.
// Returns:
//   (true, true)  : data received into value
//   (true, false) : channel closed
//   (false, _)    : no data right now, would block; caller should retry
func (ch *channel) tryPipeRecv(value unsafe.Pointer, c moxie.Codec, td *RawType) (received, ok bool) {
	if chRecvRing(ch) == 0 {
		return false, false
	}
	data, rok := ringRecv(chRecvRing(ch))
	if rok {
		// value is nil for a select case that binds nothing
		// (`case <-closed:`), so there is nowhere to put the payload.
		if value == nil {
			return true, true
		}
		if !codecFrameDecode(c, td, value, ch.elementSize, data) {
			return true, false
		}
		return true, true
	}
	if ringIsClosed(chRecvRing(ch)) {
		if value != nil {
			recvZero(value, ch.elementSize)
		}
		return true, false
	}
	return false, false
}

// ChanSendDual is the runtime dispatch the compiler emits for any
// chan-send whose element type implements moxie.Codec. It branches
// on ch.spawnBound to pick the path:
//   spawnBound -> PipeChanSendCodec (codec encode + ring write)
//   otherwise  -> chanSend (in-runtime queue, the existing path)
//
// Runtime dispatch instead of compile-time SSA tracking so chans
// stored in arrays / slices / struct fields still route correctly:
// the compiler can't always tell from the SSA value whether a given
// chan-op site refers to a spawn-bound chan, but the channel struct
// itself always knows.
func ChanSendDual(ch *channel, c moxie.Codec, value unsafe.Pointer, op *channelOp) {
	if ch != nil && ch.spawnBound {
		PipeChanSendCodec(ch, c)
		return
	}
	chanSend(ch, value, op)
}

// ChanRecvDual is the recv counterpart of ChanSendDual.
func ChanRecvDual(ch *channel, c moxie.Codec, value unsafe.Pointer, op *channelOp) bool {
	if ch != nil && ch.spawnBound {
		return PipeChanRecvCodec(ch, c)
	}
	return chanRecv(ch, value, op)
}

// PipeChanSendCodec is the runtime entry the compiler emits for chan
// sends on spawn-bound channels. Encodes c via Codec.EncodeTo into a
// PipeWriter, then writes the bytes to the send ring. Returns false on
// EncodeTo error or ring write failure.
func PipeChanSendCodec(ch *channel, c moxie.Codec) bool {
	if ch == nil || !ch.spawnBound {
		return false
	}
	frame, ok := codecFrameEncode(c, nil, nil, ch.elementSize)
	if !ok {
		return false
	}
	return PipeChanSend(ch, frame)
}

// PipeChanRecvCodec drains a frame from the recv ring and decodes into c
// (which must be a Codec interface wrapping a *T pointer so DecodeFrom
// can mutate the underlying value).
//
// Returns ok (true on successful receive+decode, false on closed/decode
// error).
func PipeChanRecvCodec(ch *channel, c moxie.Codec) bool {
	if ch == nil || !ch.spawnBound {
		return false
	}
	data, ok := PipeChanRecv(ch)
	if !ok {
		return false
	}
	return codecFrameDecode(c, nil, nil, ch.elementSize, data)
}

// PipeChildReady sets the shared ready flag so the parent's
// PipeWaitChildReady unblocks. Called by compiler-emitted code in the
// child's prologue after all MarkChildPipeChannel calls complete.
func PipeChildReady() {
	if !childSpawnTarget || spawnCtlPtr == 0 {
		return
	}
	ctl := (*spawnCtl)(unsafe.Pointer(spawnCtlPtr))
	atomicStoreU32(&ctl.ready, 1)
	moxie_futex_wake_all_shared(&ctl.ready)
}

// PipeWaitChildReady blocks until the child sets the shared ready flag
// (i.e. its channels are marked and it is running), or the child dies
// first. Uses non-blocking yield + waitpid for the liveness check.
func PipeWaitChildReady() bool {
	if spawnCtlPtr == 0 {
		return false
	}
	ctl := (*spawnCtl)(unsafe.Pointer(spawnCtlPtr))
	for i := 0; i < 500; i++ {
		if atomicLoadU32(&ctl.ready) != 0 {
			return true
		}
		// Block on the ready word itself: the child wakes it the moment its
		// channels are bound. Polling with a timer sleep made every spawn pay
		// the full timeout whenever the parent got there before the child.
		moxie_futex_wait_timeout_shared(&ctl.ready, 0, 1_000_000)
	}
	return false
}

// ChildPipeClosed returns true once the parent has died (the child is
// orphaned), signaling that the child should terminate. The child's
// event loop should poll this and exit cleanly when it returns true,
// rather than blocking forever on a recv that will never come.
//
func ChildPipeClosed() bool {
	// A domain thread cannot be orphaned: its parent is the same process. The
	// process ending ends the thread with it.
	return false
}
