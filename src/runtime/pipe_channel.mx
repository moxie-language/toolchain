//:build linux

package runtime

// Spawn channel IPC - bridges channels across spawn domain boundaries
// over shared SPSC ring buffers (mmap MAP_SHARED). No socketpair, no
// pipe: both arm and amd targets have threads and shared memory, so the
// ring is the one true transport. This file is the ring-routing layer
// the compiler-emitted chan ops dispatch through.
//
// Control signals ride the same shared memory:
//   - channel close  -> ringClose (the ring header's closed flag)
//   - child-ready    -> a shared spawnCtl.ready atomic
//   - child death    -> waitpid on the parent, getppid on the child

import (
	"moxie"
	"unsafe"
)

// ringMaxMsg caps the size of a single chan-IPC frame. The ring is sized
// to carry it (32MB ring, lazily faulted, so the virtual reservation is
// cheap). Frames over this limit are rejected fail-loud so the protocol
// never silently truncates.
const ringMaxMsg = 32 << 20

// channelIsPipeBound reports whether the channel is on a spawn boundary.
// A spawn-bound channel always has ringSend/ringRecv bound; the compiler
// and chan.mx dispatch on spawnBound to route off the in-runtime queue.
func channelIsPipeBound(ch *channel) bool {
	return ch != nil && ch.spawnBound
}

// MarkChannelPipeBound tags ch as spawn-bound at chanID. Both the
// parent's and the child's view of the same logical channel call this
// with the same chanID; each then binds its own ring halves.
func MarkChannelPipeBound(ch *channel, chanID uint16) {
	if ch == nil {
		return
	}
	ch.spawnBound = true
	ch.spawnChanID = chanID
}

// MarkChildPipeChannel is the child-side variant emitted by
// setupNativeSpawnTargetChannels: it binds ch to the shared rings if and
// only if the function is running as a spawn target (childSpawnTarget).
// Calling the function as a regular local invocation leaves the
// parameter as a plain local channel.
func MarkChildPipeChannel(ch *channel, chanID uint16) {
	if !childSpawnTarget {
		return
	}
	MarkChannelPipeBound(ch, chanID)
	// Bind ring buffers (child reverses send/recv vs parent).
	idx := int32(chanID) - 1
	if idx >= 0 && idx < spawnRingCount {
		ch.ringRecv = spawnRingSet[idx][0] // parent→child = child receives
		ch.ringSend = spawnRingSet[idx][1] // child→parent = child sends
	}
	ch.spawnPid = childParentPid // peer is the parent
}

// MarkParentPipeChannel binds ch to the most recently spawned child's
// ring pair at chanID. Emitted by createSpawn after spawnDomain returns.
// No-op if no spawn has occurred (defensive - should not happen).
func MarkParentPipeChannel(ch *channel, chanID uint16) {
	if lastSpawnPid <= 0 {
		return
	}
	MarkChannelPipeBound(ch, chanID)
	// Bind ring buffers (parent perspective).
	idx := int32(chanID) - 1
	if idx >= 0 && idx < spawnRingCount {
		ch.ringSend = spawnRingSet[idx][0] // parent→child = parent sends
		ch.ringRecv = spawnRingSet[idx][1] // child→parent = parent receives
	}
	ch.spawnPid = lastSpawnPid // peer is the child
}

// childAlive reports whether a child pid is still alive (parent side).
// Reaps via waitpid(WNOHANG) first so the domain entry reflects death.
func childAlive(pid int32) bool {
	if pid <= 0 {
		return true
	}
	domainReapChildren()
	e := domainLookupByPid(pid)
	return e == nil || e.alive
}

// parentAlive reports whether our original spawn parent is still alive
// (child side). Detects orphaning: getppid() stops returning the pid we
// captured at spawn once the parent dies and we are reparented.
func parentAlive() bool {
	return !childSpawnTarget || moxie_getppid() == childParentPid
}

// peerAlive reports whether the channel's remote peer is still alive.
func peerAlive(ch *channel) bool {
	if ch.spawnPid <= 0 {
		return true
	}
	if childSpawnTarget {
		return parentAlive()
	}
	return childAlive(ch.spawnPid)
}

// PipeChanSend is the runtime entry the compiler emits in place of the
// in-runtime queue send for spawn-bound channels. Writes the encoded
// bytes to the send ring. Parks on the ring's read index when the ring
// is full; the park is bounded and the loop rechecks liveness after
// each return, so a crashed peer surfaces as a failed send rather than
// a hang. Returns false on close or peer death. Fail-loud on frames
// that can never fit the ring.
func PipeChanSend(ch *channel, encoded []byte) bool {
	if ch == nil || !ch.spawnBound {
		return false
	}
	if ch.ringSend == 0 {
		return false
	}
	if !ringFits(ch.ringSend, int32(len(encoded))) {
		runtimePanic("PipeChanSend: frame exceeds ring size")
	}
	need := ringAlign8(4 + uint32(len(encoded)))
	for {
		if ringIsClosed(ch.ringSend) {
			return false
		}
		if ringSend(ch.ringSend, encoded) {
			break
		}
		if !peerAlive(ch) {
			ringClose(ch.ringSend)
			return false
		}
		ringParkRead(ch.ringSend, need)
	}
	// Unbuffered send: the frame is in the ring, and the send is not complete
	// until the receiver has taken it. The ack is the receiver advancing the
	// read index past the frame - no extra message and no extra memory. A
	// buffered channel (bufCap > 0) returns here: the ring holding N+1 frames
	// is what the buffer is for, and parking happens only when it is full.
	if ch.bufCap == 0 {
		for !ringAcked(ch.ringSend) {
			if ringIsClosed(ch.ringSend) {
				return false
			}
			if !peerAlive(ch) {
				return false
			}
			ringParkAck(ch.ringSend)
		}
	}
	return true
}

// PipeChanRecv is the runtime entry the compiler emits in place of the
// in-runtime queue recv for spawn-bound channels. Parks on the recv
// ring's write index until data arrives, the channel closes, or the
// bounded wait elapses; the loop rechecks both ring state and peer
// liveness on every return, so a dead peer is reported, never waited
// on forever. Returns (encoded_bytes, ok). ok=false means closed/dead.
func PipeChanRecv(ch *channel) ([]byte, bool) {
	if ch == nil || !ch.spawnBound {
		return nil, false
	}
	if ch.ringRecv == 0 {
		return nil, false
	}
	for {
		data, ok := ringRecv(ch.ringRecv)
		if ok {
			return data, true
		}
		if ringIsClosed(ch.ringRecv) {
			return nil, false
		}
		if !peerAlive(ch) {
			ringClose(ch.ringRecv)
			if childSpawnTarget {
				// The domain is orphaned: append its own counters before
				// leaving, the parent's table does not hold them.
				coverBeforeExit()
				exit(0)
			}
			return nil, false
		}
		ringParkWrite(ch.ringRecv)
	}
}

// PipeChanCloseSignal notifies the remote end that the local end of ch
// has been closed. Ring-only: closes both rings so the peer's recv
// observes ringIsClosed and its send observes ringIsClosed.
func PipeChanCloseSignal(ch *channel) {
	if ch == nil || !ch.spawnBound {
		return
	}
	if ch.ringSend != 0 {
		ringClose(ch.ringSend)
	}
	if ch.ringRecv != 0 {
		ringClose(ch.ringRecv)
	}
}

// PipeChanSendRaw routes a raw memory-layout chan send through the send
// ring. Non-blocking with retry-and-yield, same as PipeChanSend.
// Native-only - both endpoints share the same architecture (fork
// inherits the binary), so raw layout is portable.
func PipeChanSendRaw(ch *channel, ptr unsafe.Pointer, size int32) bool {
	if ch == nil || !ch.spawnBound {
		return false
	}
	var data []byte
	if size > 0 {
		data = unsafe.Slice((*byte)(ptr), size)
	}
	return PipeChanSend(ch, data)
}

// PipeChanRecvRaw routes a raw chan recv through the recv ring into ptr
// (which must point to a buffer of size bytes). Returns ok (true on
// receive, false on closed/dead). On size mismatch it also returns
// false - the protocol invariant that both ends know the element
// layout has been violated.
func PipeChanRecvRaw(ch *channel, ptr unsafe.Pointer, size int32) bool {
	if ch == nil || !ch.spawnBound {
		return false
	}
	data, ok := PipeChanRecv(ch)
	if !ok {
		return false
	}
	if size <= 0 {
		return true
	}
	if int32(len(data)) != size {
		return false
	}
	recvStore(ptr, unsafe.Pointer(&data[0]), uintptr(size))
	return true
}

// SharedBuffer maps n bytes of MAP_SHARED anonymous memory and returns it as a
// slice. Both sides of a fork see the same pages, which is what makes it usable
// as a queue-owned slot ring: the parent writes a message into slot i and sends
// the INDEX, and the worker reads the bytes without a second copy and without an
// allocation. An ordinary arena cannot serve this: after fork the child's copy
// of the parent's arenas is private (copy-on-write), so a slot written after the
// fork is invisible to the child.
//
// Must be called BEFORE the spawn that will use it: pages mapped afterwards are
// not inherited.
func SharedBuffer(n int32) (b []byte) {
	if n <= 0 {
		return nil
	}
	p := sysMapShared(uintptr(n))
	if uintptr(p) == 0 {
		runtimePanic("SharedBuffer: mmap failed")
	}
	return unsafe.Slice((*byte)(p), n)
}

// --- structural codec at the spawn boundary ---
//
// A channel element that holds a slice, map, interface or pointer CANNOT cross
// the boundary as raw bytes: the raw bytes are an address, and the child's
// address space is a fork of the parent's taken at spawn, so the child reads
// whatever happens to be at that address in its own copy-on-write view. Measured
// on a runtime-built []byte: the child received the right length and the bytes
// [4, 0, 0, ...] - 4 is the first-batch floor of the push allocator, i.e. the
// child was reading allocator metadata, not the payload.
//
// So such an element is encoded with the STRUCTURAL codec (codecEncodeValue /
// codecDecodeValue, the same walk spawn's argument codec uses) and decoded into
// the receiver's arena. This is the codec's slice encode/decode at the boundary,
// not a caller-side workaround: the payload crosses by value and the child owns
// the bytes it gets.
//
// ChanSendStructural / ChanRecvStructural are the compiler's entries for such
// elements. They dispatch exactly like ChanSendDual / ChanRecvDual: a local
// channel keeps the in-runtime queue path, where no encoding is needed.

// PipeChanSendStructural encodes one value structurally onto the send ring.
func PipeChanSendStructural(ch *channel, td *RawType, value unsafe.Pointer) bool {
	if ch == nil || !ch.spawnBound || td == nil || value == nil {
		return false
	}
	var cb CodecBuf
	var ss codecSeenSet
	codecSeenInit(&ss)
	// Nothing may be aliased across a domain boundary: the receiver is a fork,
	// and a stable-slice frame would hand it a pointer into this address space.
	codecCrossDomain = true
	codecEncodeValue(&cb, &ss, value, td)
	codecCrossDomain = false
	return PipeChanSend(ch, cb.data)
}

// PipeChanRecvStructural drains one frame and decodes it into value, which is
// the receiver's own T-sized slot. A slice element therefore arrives with a
// fresh backing in the receiver's current arena.
func PipeChanRecvStructural(ch *channel, td *RawType, value unsafe.Pointer) bool {
	if ch == nil || !ch.spawnBound || td == nil || value == nil {
		return false
	}
	data, ok := PipeChanRecv(ch)
	if !ok {
		return false
	}
	var cb CodecBuf
	cb.data = data
	var ds codecDecodeSeen
	codecDecodeSeenInit(&ds)
	p := codecDecodeValue(&cb, &ds, td)
	if p == nil {
		return false
	}
	memcpy(value, p, td.Size())
	return true
}

// ChanSendStructural is ChanSendDual's structural counterpart, emitted for chan
// elements that hold pointers. A local channel takes the raw in-runtime queue
// path: only a spawn boundary needs the encode.
func ChanSendStructural(ch *channel, td *RawType, value unsafe.Pointer, op *channelOp) {
	if ch != nil && ch.spawnBound {
		PipeChanSendStructural(ch, td, value)
		return
	}
	chanSend(ch, value, op)
}

// ChanRecvStructural is ChanRecvDual's structural counterpart.
func ChanRecvStructural(ch *channel, td *RawType, value unsafe.Pointer, op *channelOp) bool {
	if ch != nil && ch.spawnBound {
		return PipeChanRecvStructural(ch, td, value)
	}
	return chanRecv(ch, value, op)
}

// tryPipeSend attempts a NON-blocking send on a spawn-bound channel.
// Used by trySend / chanSelect on spawn channels - must not block, or
// the cooperative event loop deadlocks (the parent can't pivot to recv
// from the worker that would unblock this send).
func (ch *channel) tryPipeSend(value unsafe.Pointer) bool {
	sz := int32(ch.elementSize)
	var data []byte
	if sz > 0 {
		data = unsafe.Slice((*byte)(value), sz)
	}
	if ch.ringSend != 0 {
		return ringSend(ch.ringSend, data)
	}
	return false
}

// tryPipeRecv attempts a non-blocking receive on a spawn-bound channel.
// Returns:
//   (true, true)  : data received into value
//   (true, false) : channel closed
//   (false, _)    : no data right now, would block; caller should retry
func (ch *channel) tryPipeRecv(value unsafe.Pointer) (received, ok bool) {
	if ch.ringRecv != 0 {
		data, rok := ringRecv(ch.ringRecv)
		if rok {
			if uintptr(len(data)) == ch.elementSize {
				recvStore(value, unsafe.Pointer(&data[0]), ch.elementSize)
			} else {
				memzero(value, ch.elementSize)
			}
			return true, true
		}
		if ringIsClosed(ch.ringRecv) {
			recvZero(value, ch.elementSize)
			return true, false
		}
		return false, false
	}
	return false, false
}

// ChanSendDual is the runtime dispatch the compiler emits for any
// chan-send whose element type implements moxie.Codec. It branches
// on ch.spawnBound to pick the path:
//   spawnBound -> PipeChanSendCodec (codec encode + ring write)
//   otherwise  -> chanSend (in-runtime queue, the existing path)
//
// Runtime dispatch instead of compile-time SSA tracking so chans
// stored in arrays / slices / struct fields still route correctly:
// the compiler can't always tell from the SSA value whether a given
// chan-op site refers to a spawn-bound chan, but the channel struct
// itself always knows.
func ChanSendDual(ch *channel, c moxie.Codec, value unsafe.Pointer, op *channelOp) {
	if ch != nil && ch.spawnBound {
		PipeChanSendCodec(ch, c)
		return
	}
	chanSend(ch, value, op)
}

// ChanRecvDual is the recv counterpart of ChanSendDual.
func ChanRecvDual(ch *channel, c moxie.Codec, value unsafe.Pointer, op *channelOp) bool {
	if ch != nil && ch.spawnBound {
		return PipeChanRecvCodec(ch, c)
	}
	return chanRecv(ch, value, op)
}

// PipeChanSendCodec is the runtime entry the compiler emits for chan
// sends on spawn-bound channels. Encodes c via Codec.EncodeTo into a
// PipeWriter, then writes the bytes to the send ring. Returns false on
// EncodeTo error or ring write failure.
func PipeChanSendCodec(ch *channel, c moxie.Codec) bool {
	if ch == nil || !ch.spawnBound {
		return false
	}
	var w moxie.PipeWriter
	if err := c.EncodeTo(&w); err != nil {
		return false
	}
	return PipeChanSend(ch, w.Buf)
}

// PipeChanRecvCodec drains a frame from the recv ring and decodes into c
// (which must be a Codec interface wrapping a *T pointer so DecodeFrom
// can mutate the underlying value).
//
// Returns ok (true on successful receive+decode, false on closed/decode
// error).
func PipeChanRecvCodec(ch *channel, c moxie.Codec) bool {
	if ch == nil || !ch.spawnBound {
		return false
	}
	data, ok := PipeChanRecv(ch)
	if !ok {
		return false
	}
	var r moxie.PipeReader
	r.Buf = data
	if err := c.DecodeFrom(&r); err != nil {
		return false
	}
	return true
}

// PipeChildReady sets the shared ready flag so the parent's
// PipeWaitChildReady unblocks. Called by compiler-emitted code in the
// child's prologue after all MarkChildPipeChannel calls complete.
func PipeChildReady() {
	if !childSpawnTarget || spawnCtlPtr == 0 {
		return
	}
	ctl := (*spawnCtl)(unsafe.Pointer(spawnCtlPtr))
	atomicStoreU32(&ctl.ready, 1)
	moxie_futex_wake_all_shared(&ctl.ready)
}

// PipeWaitChildReady blocks until the child sets the shared ready flag
// (i.e. its channels are marked and it is running), or the child dies
// first. Uses non-blocking yield + waitpid for the liveness check.
func PipeWaitChildReady() bool {
	if lastSpawnPid <= 0 {
		return false
	}
	if spawnCtlPtr == 0 {
		return false
	}
	ctl := (*spawnCtl)(unsafe.Pointer(spawnCtlPtr))
	for i := 0; i < 500; i++ {
		if atomicLoadU32(&ctl.ready) != 0 {
			return true
		}
		if !childAlive(lastSpawnPid) {
			return false
		}
		// Block on the ready word itself: the child wakes it the moment its
		// channels are bound. Polling with a timer sleep made every spawn pay
		// the full timeout whenever the parent got there before the child.
		moxie_futex_wait_timeout_shared(&ctl.ready, 0, 1_000_000)
	}
	return false
}

// ChildPipeClosed returns true once the parent has died (the child is
// orphaned), signaling that the child should terminate. The child's
// event loop should poll this and exit cleanly when it returns true,
// rather than blocking forever on a recv that will never come.
//
// Implementation: getppid() comparison. Once the original parent dies,
// the child is reparented (to init or a subreaper) and getppid() stops
// returning the pid captured at spawn time.
func ChildPipeClosed() bool {
	return !parentAlive()
}
