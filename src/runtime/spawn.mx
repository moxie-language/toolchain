//:build linux

package runtime

import "unsafe"

// spawnDomain creates a new isolated domain by forking the current process.
// The child process executes fn(args) with its own cooperative scheduler.
//
// Inter-domain channel communication is carried exclusively over shared
// SPSC ring buffers (mmap MAP_SHARED). No socketpair, no pipe - both arm
// and amd targets have threads and shared memory, so the ring is the one
// true transport. Control signals (channel close, child-ready handshake)
// ride the same shared memory: the ring header's closed flag and a small
// shared spawn-control block. Lifecycle (child death) is detected via
// waitpid on the parent side and getppid on the child side.
//
// The secalloc lockdown pipe is still created: the child auto-routes its
// guard-page fault notifications to the write end via SetSecureLockdownFd
// before user code runs. The parent retrieves the read fd via
// runtime.LastSpawnedLockdownFd(). If pipe creation fails the child
// falls back to the stderr sink and the parent gets -1; spawn does not
// fail on a lockdown-pipe failure, only observability degrades.
// spawnChanSet holds the channel pointers of the spawn being established. The
// compiler notes each channel argument before it calls spawnDomain, so each
// ring is sized from that channel's declared depth (`chan T{:N}`) and its
// compiler-computed frame budget - both of which live on the channel itself.
var spawnChanSet [16]*channel

// NoteSpawnChan records a channel argument for the spawn about to start. The
// compiler emits one call per channel argument, in argument order, before
// spawnDomain; spawnDomain clears the slot once the ring pair is created.
func NoteSpawnChan(idx int32, ch *channel) {
	if idx < 0 || idx >= 16 {
		return
	}
	spawnChanSet[idx] = ch
}

// spawnRingDataSize is the power-of-two data area for one direction of a spawn
// channel: room for the declared depth plus one in-flight frame, each frame
// being the length prefix plus the channel's frame budget. The mask arithmetic
// in ringWrite/ringRead requires a power of two, and the area may not exceed
// ringMaxMsg, which is the largest frame the protocol can carry at all.
func spawnRingDataSize(slots, budget uintptr) uint32 {
	frame := uintptr(ringAlign8(4 + uint32(budget)))
	if frame < 16 {
		frame = 16
	}
	need := (slots + 1) * frame
	size := uintptr(4096)
	for size < need {
		size = size << 1
	}
	if size > ringMaxMsg {
		runtimePanic("spawn: channel frame budget exceeds ringMaxMsg: declare the slice/map dimension with a cap tag that fits")
	}
	return uint32(size)
}

func spawnDomain(fn uintptr, argp unsafe.Pointer, nChans int32) {
	// The breaker is created BEFORE the fork: the parent's handle (returned by
	// SpawnLifecycleChannel) and the child's DomainClosed must be one object, so
	// a close by either side is visible to both.
	spawnCtlRing = ringCreate(4096)
	spawnBreaker = spawnBreakerMake()

	// Create ring buffer pairs for each channel before fork.
	// mmap(MAP_SHARED) so both processes share the same physical memory.
	spawnRingCount = nChans
	for i := int32(0); i < nChans && i < 16; i++ {
		// One page and one slot when the channel is nil or was never noted:
		// that is the documented default for an unstated capacity.
		budget := uintptr(4096)
		slots := uintptr(1)
		ch := spawnChanSet[i]
		spawnChanSet[i] = nil
		if ch != nil {
			if ch.frameBudget > 0 {
				budget = ch.frameBudget
			}
			if ch.bufCap > 0 {
				slots = ch.bufCap
			}
		}
		dataSize := spawnRingDataSize(slots, budget)
		spawnRingSet[i][0] = ringCreate(dataSize) // parent→child
		spawnRingSet[i][1] = ringCreate(dataSize) // child→parent
	}

	// Shared control block for the child-ready handshake (MAP_SHARED).
	spawnCtlPtr = spawnCtlCreate()

	// Create the lockdown pipe (parent reads, child writes). Best
	// effort: a failure here just leaves the child pointed at stderr.
	lockdownFds := []int32{:2}
	lockdownFds[0] = -1
	lockdownFds[1] = -1
	if moxie_pipe(unsafe.Pointer(&lockdownFds[0])) < 0 {
		lockdownFds[0] = -1
		lockdownFds[1] = -1
	}

	pid := moxie_fork()
	if pid < 0 {
		runtimePanic("spawn: fork failed")
	}

	if pid == 0 {
		// Child process - run the spawned function directly.
		childSpawnTarget = true
		childParentPid = moxie_getppid()
		DomainClosed = spawnBreaker

		// Reaper: the one supervision gap the capability model cannot close is a
		// parent that dies WITHOUT closing the terminate channel - a SIGKILL, a
		// crash - because the holder of that channel is gone. The kernel is the
		// only witness left, and it must be given a kill, not a signal to
		// handle: SIGTERM only raises the sigint flag, and a domain parked in a
		// select on its `closed` breaker never wakes to see it (it has no arm on
		// sigint, by design). Measured: with SIGTERM here, `kill -9` of a parent
		// left the child domain alive indefinitely - a relay that is respawned
		// while its old worker is wedged accumulated 2,600+ parked domains
		// before any of them died.
		//
		// SIGKILL makes the guarantee unconditional and recursive: every child
		// has its own pdeathsig, so a whole tree dies with its root. A parent
		// that is merely stopping closes the breakers instead and its children
		// exit cleanly, which is the normal path and is unaffected.
		moxie_set_pdeathsig(9) // SIGKILL
		if moxie_getppid() != childParentPid {
			exit(0)
		}

		// Wire the lockdown channel: close the read end (parent's side),
		// route fault notifications to the write end. Done before
		// spawnCall so any allocation made by user code is covered.
		if lockdownFds[0] >= 0 {
			moxie_close(lockdownFds[0])
			SetSecureLockdownFd(lockdownFds[1])
		}

		// Call the function directly. With no scheduler, the child
		// domain is single-threaded and runs to completion.
		spawnCall(fn, argp)

		// Exit child process. Its counters are a private copy of the table
		// made at fork, so append them to the coverage dump before the
		// process goes away; the parent cannot report them.
		coverBeforeExit()
		exit(0)
	}

	// Parent process.
	lastSpawnPid = pid
	if lockdownFds[1] >= 0 {
		moxie_close(lockdownFds[1]) // close child's write end
	}

	domainRegister(pid, lockdownFds[0])
}

// spawnCtl is the shared spawn-control block: one per spawn, mmap'd
// MAP_SHARED before fork so parent and child both see the same memory.
// The child sets ready=1 after its channels are marked; the parent spins
// on it for the synchronous spawn rendezvous.
type spawnCtl struct {
	ready uint32
}

var spawnCtlPtr uintptr // most recent spawn's control block (0 = none)

// lastSpawnPid is the parent's most recently spawned child pid. Read by
// MarkParentPipeChannel to tag the channel with its peer pid for death
// detection, and by PipeWaitChildReady to check child liveness.
var lastSpawnPid int32

// childSpawnTarget is true iff this process is running as a spawn child.
// Replaces the old ChildPipeFd sentinel: a child has no fd to check, it
// has a flag set in the child branch of spawnDomain.
var childSpawnTarget bool

// childParentPid is the child's parent pid (via getppid at spawn time),
// used to detect parent death (orphaning) on the child side.
var childParentPid int32

func spawnCtlCreate() uintptr {
	p := sysMapShared(unsafe.Sizeof(spawnCtl{}))
	if uintptr(p) == 0 {
		return 0
	}
	ctl := (*spawnCtl)(p)
	ctl.ready = 0
	return uintptr(p)
}

// spawnCall invokes fn(args) directly via a C trampoline. The C side
// takes a raw `void (*)(void *)` and calls it without the extra context
// parameter that a Moxie `func(unsafe.Pointer)` value expects. Doing
// the cast in Moxie itself is broken: `func(unsafe.Pointer)` is a
// 2-word {funcptr, context} fat pointer, so reinterpreting an 8-byte
// uintptr as a funcType reads 16 bytes and scrambles both fields.
func spawnCall(fn uintptr, argp unsafe.Pointer) {
	moxie_spawn_call(fn, argp)
}

//export moxie_spawn_call
func moxie_spawn_call(fn uintptr, argp unsafe.Pointer)

//export moxie_set_pdeathsig
func moxie_set_pdeathsig(sig uint32)

// spawnTerminatePid ends one child domain and reaps it. The breaker is the
// parent's termination handle, so closing it must END the domain rather than
// merely signal it: a target parked in its select wakes on the closed flag and
// returns, but a target wedged inside a long operation (a hung network fetch, a
// blocking syscall) will never run Moxie code again, and the parent has no other
// way to reclaim it. The kernel is the only mechanism that reaches such a
// process, so the close escalates SIGTERM -> SIGKILL with a short grace and
// reaps the child, leaving no zombie and no live domain behind.
//
// Measured without this: a relay that replaced a stuck worker left the old
// domain running forever (the parent overwrote the slot and dropped the handle),
// and one relay accumulated 2,600+ live domains, each its own process.
func spawnTerminatePid(pid int32) {
	if pid <= 0 {
		return
	}
	var status int32
	if moxie_waitpid(pid, unsafe.Pointer(&status), 1) > 0 { // WNOHANG: already gone
		domainReapChildren()
		return
	}
	moxie_kill(pid, 15) // SIGTERM
	for i := 0; i < 20; i++ {
		if moxie_waitpid(pid, unsafe.Pointer(&status), 1) > 0 {
			domainReapChildren()
			return
		}
		sleepTicks(timeUnit(1_000_000)) // 1ms
	}
	moxie_kill(pid, 9) // SIGKILL
	moxie_waitpid(pid, unsafe.Pointer(&status), 0)
	domainReapChildren()
}

// MakePipe creates a unidirectional pipe via libc pipe(2). Returns the
// (read, write) fds, or (-1, -1) on failure. The fds are inherited by
// children created via spawn (which uses fork internally), so a parent
// domain can hand the write end to a child for fault notification.
func MakePipe() (int32, int32) {
	fds := []int32{:2}
	r := moxie_pipe(unsafe.Pointer(&fds[0]))
	if r < 0 {
		return -1, -1
	}
	return fds[0], fds[1]
}

// Fork wraps the fork syscall for tests and bare cross-process plumbing
// that don't want the full spawn machinery. Returns 0 in the child, the
// child's pid in the parent, or -1 on failure.
func Fork() int32 {
	return moxie_fork()
}

// Close wraps close(2). Returns 0 on success, -1 on failure.
func Close(fd int32) int32 {
	return moxie_close(fd)
}

// Waitpid blocks until the child with the given pid exits. Returns the
// raw status integer (caller decodes via shell convention). Used by test
// harnesses and parent domains that need to know when a child died.
func Waitpid(pid int32) int32 {
	var status int32
	r := moxie_waitpid(pid, unsafe.Pointer(&status), 0)
	if r < 0 {
		return -1
	}
	return status
}

// C functions defined in spawn_unix.c

//export moxie_fork
func moxie_fork() int32

//export moxie_close
func moxie_close(fd int32) int32

//export moxie_getppid
func moxie_getppid() int32

//export moxie_pipe
func moxie_pipe(fds unsafe.Pointer) int32

// moxie_waitpid is declared in domain.mx.

// MoxieWrite / MoxieRead are the generic fd read/write wrappers (defined in
// spawn_unix.c). Used by spawnhandshake and the cross-binary type-server;
// not part of the spawn channel transport (which is rings-only).

//export MoxieWrite
func MoxieWrite(fd int32, buf unsafe.Pointer, count int32) int32

//export MoxieRead
func MoxieRead(fd int32, buf unsafe.Pointer, count int32) int32
