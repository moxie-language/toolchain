//:build linux

package runtime

import "unsafe"

// spawnDomain creates a new isolated domain by forking the current process.
// The child process executes fn(args) with its own cooperative scheduler.
//
// Inter-domain channel communication is carried exclusively over shared
// SPSC ring buffers (mmap MAP_SHARED). No socketpair, no pipe - both arm
// and amd targets have threads and shared memory, so the ring is the one
// true transport. Control signals (channel close, child-ready handshake)
// ride the same shared memory: the ring header's closed flag and a small
// shared spawn-control block. Lifecycle (child death) is detected via
// waitpid on the parent side and getppid on the child side.
//
// The secalloc lockdown pipe is still created: the child auto-routes its
// guard-page fault notifications to the write end via SetSecureLockdownFd
// before user code runs. The parent retrieves the read fd via
// runtime.LastSpawnedLockdownFd(). If pipe creation fails the child
// falls back to the stderr sink and the parent gets -1; spawn does not
// fail on a lockdown-pipe failure, only observability degrades.
// spawnChanSet holds the channel pointers of the spawn being established. The
// compiler notes each channel argument before it calls spawnDomain, so each
// ring is sized from that channel's declared depth (`chan T{:N}`) and its
// compiler-computed frame budget - both of which live on the channel itself.
var spawnChanSet [16]*channel

// NoteSpawnChan records a channel argument for the spawn about to start. The
// compiler emits one call per channel argument, in argument order, before
// spawnDomain; spawnDomain clears the slot once the ring pair is created.
func NoteSpawnChan(idx int32, ch *channel) {
	if idx < 0 || idx >= 16 {
		return
	}
	spawnChanSet[idx] = ch
}

// spawnRingDataSize is the power-of-two data area for one direction of a spawn
// channel: room for the declared depth plus one in-flight frame, each frame
// being the length prefix plus the channel's frame budget. The mask arithmetic
// in ringWrite/ringRead requires a power of two, and the area may not exceed
// ringMaxMsg, which is the largest frame the protocol can carry at all.
func spawnRingDataSize(slots, budget uintptr) uint32 {
	frame := uintptr(ringAlign8(4 + uint32(budget)))
	if frame < 16 {
		frame = 16
	}
	need := (slots + 1) * frame
	size := uintptr(4096)
	for size < need {
		size = size << 1
	}
	if size > ringMaxMsg {
		runtimePanic("spawn: channel frame budget exceeds ringMaxMsg: declare the slice/map dimension with a cap tag that fits")
	}
	return uint32(size)
}

// spawnHandoff is what a forked child used to inherit for free: the breaker,
// the ring pairs, the control block and the target. A thread starts with zeroed
// TLS, so the values are copied into it explicitly before the target runs.
type spawnHandoff struct {
	fn      uintptr
	argp    unsafe.Pointer
	breaker *channel
	ctl     uintptr
	nChans  int32
	childID uintptr // this domain's id in the process-wide sequence
	seqPtr  uintptr // the shared counter, so this domain can spawn too
	rings   [16][2]uintptr
}

// spawnDomain starts one domain THREAD running fn(args).
//
// A domain is a thread, not a process: same address space, its own TLS block
// (domain root, arenas, package globals) and its own stack. That is the whole
// concurrency model made literal - one thread of execution per domain, a closed
// breaker observed by the loop, and no PID, no reaper, no orphan. The channels
// are still SPSC ring buffers and values still cross them through the codec;
// the only thing that changes is that the rings are ordinary memory instead of
// a window into another process.
func spawnDomain(fn uintptr, argp unsafe.Pointer, nChans int32) {
	// The control ring and the breaker first: the breaker rides that ring, and
	// both threads must hold the same pointers.
	spawnCtlRing = ringCreate(4096)
	// The breaker is the parent's handle to the domain and the child's
	// DomainClosed: one object, in the root arena because it outlives the frame.
	spawnBreaker = spawnBreakerMake()

	// Ring pairs, sized from each channel's declared depth and frame budget.
	// The sizing rules do not change with threads; only the mapping does.
	spawnRingCount = nChans
	for i := int32(0); i < nChans && i < 16; i++ {
		// One page and one slot when the channel is nil or was never noted:
		// that is the documented default for an unstated capacity.
		budget := uintptr(4096)
		slots := uintptr(1)
		ch := spawnChanSet[i]
		spawnChanSet[i] = nil
		if ch != nil {
			// One channel belongs to the child it was handed to; the parent's
			// waits consult that child's breaker for liveness.
			ch.ownerBreaker = spawnBreaker
			// A channel that already sits on a boundary KEEPS its rings, the
			// same rule the wasm side learns per channel (SpawnChannelHandle).
			// Both domains hold this struct, so "re-ringed" would mean every
			// holder silently follows the newest pair: a manager passing a
			// worker's channel on would detach the worker it came from.
			if ch.spawnBound && ch.ringA != 0 && ch.ringB != 0 {
				spawnRingSet[i][0] = ch.ringA
				spawnRingSet[i][1] = ch.ringB
				continue
			}
			if ch.frameBudget > 0 {
				budget = ch.frameBudget
			}
			if ch.bufCap > 0 {
				slots = ch.bufCap
			}
		}
		dataSize := spawnRingDataSize(slots, budget)
		spawnRingSet[i][0] = ringCreate(dataSize) // parent->child
		spawnRingSet[i][1] = ringCreate(dataSize) // child->parent
	}

	// Control block for the child-ready handshake. Both threads see it directly
	// now; the handshake remains because it is what makes the channel bindings
	// visible before the parent sends its first frame.
	spawnCtlPtr = spawnCtlCreate()

	// The handoff lives in the ROOT arena: the child reads it before it has an
	// arena of its own, and it must survive the spawning frame returning.
	save := CurrentArena()
	SetCurrentArena(trueRootArena())
	h := (*spawnHandoff)(alloc(unsafe.Sizeof(spawnHandoff{}), nil))
	SetCurrentArena(save)
	// The child's domain id is taken BEFORE the handoff: the parent's channel
	// markers run as soon as spawnDomain returns and record it, and the child
	// reads the same number from the handoff.
	h.childID = nextDomainID()
	h.seqPtr = domainSeqPtr
	lastChildDomain = h.childID
	h.fn = fn
	h.argp = argp
	h.breaker = spawnBreaker
	h.ctl = spawnCtlPtr
	h.nChans = spawnRingCount
	for i := int32(0); i < 16; i++ {
		h.rings[i][0] = spawnRingSet[i][0]
		h.rings[i][1] = spawnRingSet[i][1]
	}

	if moxie_thread_spawn(unsafe.Pointer(h)) != 0 {
		runtimePanic("spawn: thread create failed")
	}
}

// moxie_runtime_thread_entry is the child side of a spawn. It runs on the new
// thread with zeroed TLS, so it builds the domain here: InitCShared gives this
// thread its own root arena, heap and package initialisers, and the handoff
// fills in the spawn state that would otherwise have come from fork.
//
//export moxie_runtime_thread_entry
func moxie_runtime_thread_entry(arg unsafe.Pointer) {
	h := (*spawnHandoff)(arg)
	domainID = h.childID
	domainSeqPtr = h.seqPtr
	childSpawnTarget = true
	DomainClosed = h.breaker
	spawnBreaker = h.breaker
	spawnCtlPtr = h.ctl
	spawnRingCount = h.nChans
	for i := int32(0); i < 16; i++ {
		spawnRingSet[i][0] = h.rings[i][0]
		spawnRingSet[i][1] = h.rings[i][1]
	}
	InitCShared()
	spawnCall(h.fn, h.argp)
	// The domain is done: close the breaker if the target did not, so the parent
	// observes the end exactly as it would from a forked child's exit. The
	// closed flag is one object both threads hold.
	if !ringIsClosed(h.breaker.ringA) {
		SpawnClose(h.breaker)
	}
	// Returning ends THIS thread: the C trampoline calls pthread_exit on the
	// result. The process and every other domain keep running, and the process
	// exits when main returns.
}

//export moxie_thread_spawn
func moxie_thread_spawn(arg unsafe.Pointer) int32


// spawnCtl is the shared spawn-control block: one per spawn, mmap'd
// MAP_SHARED before fork so parent and child both see the same memory.
// The child sets ready=1 after its channels are marked; the parent spins
// on it for the synchronous spawn rendezvous.
type spawnCtl struct {
	ready uint32
}

var spawnCtlPtr uintptr // most recent spawn's control block (0 = none)


// childSpawnTarget is true iff this DOMAIN is a spawn target. It is TLS, so it
// is set in the new thread by moxie_runtime_thread_entry and is false in the
// parent. Nothing about it is process-scoped any more.
var childSpawnTarget bool

// spawnBreaker is the handle of the spawn being established (or the most
// recent one): what spawn returns to the parent and DomainClosed names in the
// child. Root-arena object, TLS pointer.
var spawnBreaker *channel

// domainID names THIS domain in a channel's role test: the root is 1, and every
// spawned domain takes the next number from one process-wide sequence, assigned
// at spawn and never reused. A domain that spawns a child is still a child of its
// own parent, so the role of a channel is decided per channel by comparing this
// token with the channel's childDomain - not by a per-domain flag, which cannot
// express both roles - and the token is the same domain id the page's hub uses
// for its lineage, so a debugging session reads one number everywhere.
var domainID uintptr

// lastChildDomain is the id the spawn just started took from the sequence; the
// parent's channel markers record it as their channels' childDomain.
var lastChildDomain uintptr

// domainSeqPtr is the shared counter the ids come from. A thread's TLS is
// zeroed, so a child receives the pointer in its handoff; the root maps it on
// its first spawn.
var domainSeqPtr uintptr

//export moxie_atomic_add_u32
func moxie_atomic_add_u32(p *uint32, v uint32) uint32

// nextDomainID takes the next id in the process-wide sequence. The first add to
// a counter initialised to 1 yields 2, so the root is 1 and no id repeats.
func nextDomainID() (id uintptr) {
	if domainSeqPtr == 0 {
		p := sysMapShared(4)
		if uintptr(p) == 0 {
			runtimePanic("spawn: cannot map the domain id counter")
		}
		*(*uint32)(p) = 1
		domainSeqPtr = uintptr(p)
		domainID = 1
	}
	return uintptr(moxie_atomic_add_u32((*uint32)(unsafe.Pointer(domainSeqPtr)), 1))
}

func spawnCtlCreate() uintptr {
	p := sysMapShared(unsafe.Sizeof(spawnCtl{}))
	if uintptr(p) == 0 {
		return 0
	}
	ctl := (*spawnCtl)(p)
	ctl.ready = 0
	return uintptr(p)
}

// spawnCall invokes fn(args) directly via a C trampoline. The C side
// takes a raw `void (*)(void *)` and calls it without the extra context
// parameter that a Moxie `func(unsafe.Pointer)` value expects. Doing
// the cast in Moxie itself is broken: `func(unsafe.Pointer)` is a
// 2-word {funcptr, context} fat pointer, so reinterpreting an 8-byte
// uintptr as a funcType reads 16 bytes and scrambles both fields.
func spawnCall(fn uintptr, argp unsafe.Pointer) {
	moxie_spawn_call(fn, argp)
}

//export moxie_spawn_call
func moxie_spawn_call(fn uintptr, argp unsafe.Pointer)


// MakePipe creates a unidirectional pipe via libc pipe(2). Returns the
// (read, write) fds, or (-1, -1) on failure. A domain thread inherits the
// process's fd table, so a domain can hand the write end to another domain.
func MakePipe() (int32, int32) {
	fds := []int32{:2}
	r := moxie_pipe(unsafe.Pointer(&fds[0]))
	if r < 0 {
		return -1, -1
	}
	return fds[0], fds[1]
}

// Fork wraps the fork syscall for tests and bare cross-process plumbing
// that don't want the full spawn machinery. Returns 0 in the child, the
// child's pid in the parent, or -1 on failure.
func Fork() int32 {
	return moxie_fork()
}

// Close wraps close(2). Returns 0 on success, -1 on failure.
func Close(fd int32) int32 {
	return moxie_close(fd)
}

// Waitpid blocks until the child with the given pid exits. Returns the
// raw status integer (caller decodes via shell convention). Used by test
// harnesses and parent domains that need to know when a child died.
func Waitpid(pid int32) int32 {
	var status int32
	r := moxie_waitpid(pid, unsafe.Pointer(&status), 0)
	if r < 0 {
		return -1
	}
	return status
}

// C functions defined in spawn_unix.c

//export moxie_fork
func moxie_fork() int32

//export moxie_close
func moxie_close(fd int32) int32

//export moxie_getppid
func moxie_getppid() int32

//export moxie_pipe
func moxie_pipe(fds unsafe.Pointer) int32

//export moxie_waitpid
func moxie_waitpid(pid int32, status unsafe.Pointer, options int32) int32


// MoxieWrite / MoxieRead are the generic fd read/write wrappers (defined in
// spawn_unix.c). Used by spawnhandshake and the cross-binary type-server;
// not part of the spawn channel transport (which is rings-only).

//export MoxieWrite
func MoxieWrite(fd int32, buf unsafe.Pointer, count int32) int32

//export MoxieRead
func MoxieRead(fd int32, buf unsafe.Pointer, count int32) int32
