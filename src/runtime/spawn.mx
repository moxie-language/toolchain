//:build linux

package runtime

import "unsafe"

// spawnDomain creates a new isolated domain by forking the current process.
// The child process executes fn(args) with its own cooperative scheduler.
// Communication between parent and child happens over a Unix socketpair,
// plus a one-shot lockdown pipe used by the secure allocator.
//
// The lockdown pipe is always created. The child auto-routes its
// secalloc fault notifications to the write end via SetSecureLockdownFd
// before user code runs, so any guard-page fault inside the child wipes
// the arena synchronously and notifies the parent on the read end. The
// parent retrieves the read fd via runtime.LastSpawnedLockdownFd().
//
// If pipe creation fails (e.g. RLIMIT_NOFILE) the child still spawns
// with the default fd-2 (stderr) lockdown sink and the parent gets -1
// for the lockdown fd. Spawn does not fail just because the lockdown
// channel could not be created — the program is still functional, only
// observability is degraded.
func spawnDomain(fn uintptr, args unsafe.Pointer, nChans int32) {
	// Create ring buffer pairs for each channel before fork.
	// mmap(MAP_SHARED) so both processes share the same physical memory.
	spawnRingCount = nChans
	for i := int32(0); i < nChans && i < 16; i++ {
		spawnRingSet[i][0] = ringCreate(ringDefaultSize) // parent→child
		spawnRingSet[i][1] = ringCreate(ringDefaultSize) // child→parent
	}

	// Create a socketpair for control messages and lifecycle detection.
	var fds [2]int32
	r := moxie_socketpair(1, 1, 0, unsafe.Pointer(&fds[0])) // AF_UNIX=1, SOCK_STREAM=1
	if r < 0 {
		runtimePanic("spawn: socketpair failed")
	}
	moxie_set_spawn_bufs(fds[0], fds[1])

	// Create the lockdown pipe (parent reads, child writes). Best
	// effort: a failure here just leaves the child pointed at stderr.
	var lockdownFds [2]int32
	lockdownFds[0] = -1
	lockdownFds[1] = -1
	if moxie_pipe(unsafe.Pointer(&lockdownFds[0])) < 0 {
		lockdownFds[0] = -1
		lockdownFds[1] = -1
	}

	pid := moxie_fork()
	if pid < 0 {
		runtimePanic("spawn: fork failed")
	}

	if pid == 0 {
		// Child process — run the spawned function directly.
		moxie_close(fds[0])  // close parent's end of socketpair
		ChildPipeFd = fds[1] // child-side pipe fd, read by setupNativeSpawnTargetChannels-emitted prologue

		// Wire the lockdown channel: close the read end (parent's side),
		// route fault notifications to the write end. Done before
		// spawnCall so any allocation made by user code is covered.
		if lockdownFds[0] >= 0 {
			moxie_close(lockdownFds[0])
			SetSecureLockdownFd(lockdownFds[1])
		}

		// Call the function directly. With no scheduler, the child
		// domain is single-threaded and runs to completion.
		spawnCall(fn, args)

		// Exit child process.
		exit(0)
	}

	// Parent process.
	moxie_close(fds[1]) // close child's end of socketpair
	if lockdownFds[1] >= 0 {
		moxie_close(lockdownFds[1]) // close child's write end
	}

	domainRegister(pid, fds[0], lockdownFds[0])
}

// spawnCall invokes fn(args) directly via a C trampoline. The C side
// takes a raw `void (*)(void *)` and calls it without the extra context
// parameter that a Moxie `func(unsafe.Pointer)` value expects. Doing
// the cast in Moxie itself is broken: `func(unsafe.Pointer)` is a
// 2-word {funcptr, context} fat pointer, so reinterpreting an 8-byte
// uintptr as a funcType reads 16 bytes and scrambles both fields.
func spawnCall(fn uintptr, args unsafe.Pointer) {
	moxie_spawn_call(fn, args)
}

//export moxie_spawn_call
func moxie_spawn_call(fn uintptr, args unsafe.Pointer)

// MakePipe creates a unidirectional pipe via libc pipe(2). Returns the
// (read, write) fds, or (-1, -1) on failure. The fds are inherited by
// children created via spawn (which uses fork internally), so a parent
// domain can hand the write end to a child for fault notification.
func MakePipe() (int32, int32) {
	var fds [2]int32
	r := moxie_pipe(unsafe.Pointer(&fds[0]))
	if r < 0 {
		return -1, -1
	}
	return fds[0], fds[1]
}

// Fork wraps the fork syscall for tests and bare cross-process plumbing
// that don't want the full spawn machinery. Returns 0 in the child, the
// child's pid in the parent, or -1 on failure.
func Fork() int32 {
	return moxie_fork()
}

// Close wraps close(2). Returns 0 on success, -1 on failure.
func Close(fd int32) int32 {
	return moxie_close(fd)
}

// Waitpid blocks until the child with the given pid exits. Returns the
// raw status integer (caller decodes via shell convention). Used by test
// harnesses and parent domains that need to know when a child died.
func Waitpid(pid int32) int32 {
	var status int32
	r := moxie_waitpid(pid, unsafe.Pointer(&status), 0)
	if r < 0 {
		return -1
	}
	return status
}

// C functions defined in spawn_unix.c

//export moxie_fork
func moxie_fork() int32

//export moxie_close
func moxie_close(fd int32) int32

//export moxie_socketpair
func moxie_socketpair(domain, typ, protocol int32, fds unsafe.Pointer) int32

//export moxie_set_spawn_bufs
func moxie_set_spawn_bufs(fd0, fd1 int32)

//export moxie_pipe
func moxie_pipe(fds unsafe.Pointer) int32

// moxie_waitpid is declared in domain.mx.
