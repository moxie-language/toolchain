//:build linux

package runtime

import "unsafe"

// SPSC ring buffer for lock-free cross-domain channel transport.
// Allocated via mmap(MAP_SHARED) and mapped into both domains, which are
// threads in one address space: the ring is ordinary memory both sides can
// reach, and the shared mapping is what makes the same bytes the transport.
//
// Layout (D2): 384-byte header, then data[size] bytes.
//
//   line 0   [0:4]    writeIdx    producer-written
//            [4:8]    sentFrames  producer-written
//   line 1   [128:132] readIdx    consumer-written
//            [132:136] recvFrames consumer-written
//   line 2   [256:260] size       data area, power of two, fixed at creation
//            [260:264] closed
//            [264:268] recvSleeper
//            [268:272] sendSleeper
//            [272:276] refcount  one per end (phase 7)
//   data     [384:]
//
// The two indices are on separate lines because the producer publishes one and
// the consumer publishes the other on every operation. With both in the first
// eight bytes, as this header used to be, every publish by one side invalidates
// the other side's line and the channel costs more than the work it carries.
// That is a correctness-of-performance requirement, not a tuning choice, and
// ringLayoutCheck enforces it at every creation.
//
// Frames are chained, the ring stays small (D3/D4). A message larger than half
// the ring is written as a sequence of chunks; each chunk is
// [len u32][flags u32][payload][pad to 8] and all but the last carry flags=0.
// The receiver consumes chunks as they arrive, which frees space for the next
// chunk, so maximum message size is bounded by receiver memory rather than by
// the ring. The index advance IS the commit: the single writer publishes a
// chunk by storing writeIdx with release, and no committed flag is needed.
//
// The index word is also the parking word (L21: signal is the operation). A
// receiver waits on writeIdx, a writer on readIdx, each with the value it just
// loaded as FUTEX_WAIT's expectation, so a publish that lands between the check
// and the sleep turns the wait into an immediate EAGAIN instead of a lost
// wakeup. The sleeper flags are only a wake-elision hint: they keep the
// uncontended publish free of the FUTEX_WAKE syscall.
//
// Messages: [len u32][flags u32][payload:len][pad to align 8].

const (
	ringHeaderSize  = 384
	ringChunkHdr    = 8
	ringFlagFinal   = uint32(1)
	flag_MAP_SHARED = 0x1
)

// pipeParkTimeoutNs bounds every ring park. A crashed peer can never issue the
// wake, so an unbounded sleep would be a permanent hang; the caller rechecks
// ring state and peer liveness after each return.
const pipeParkTimeoutNs = 20_000_000 // 20ms

// ringDefaultDataSize is the ring's data area (D4): 128 KiB natively, 64 KiB on
// wasm. It is independent of message size because frames chain, so address
// space is no longer a function of the worst message a channel might carry.
func ringDefaultDataSize() uint32 {
	return 128 * 1024
}

// ringBuf is the shared header. The pad fields are layout constants, not data
// structures: they are what put writeIdx and readIdx 128 bytes apart.
type ringBuf struct {
	writeIdx    uint32 // producer line
	sentFrames  uint32
	padProducer [120]byte

	readIdx    uint32 // consumer line
	recvFrames uint32
	padConsumer [120]byte

	size        uint32 // shared line
	closed      uint32
	recvSleeper uint32
	sendSleeper uint32
	refcount    uint32
	padShared   [108]byte
}

// ringLayoutCheck is the compile-time-intent assertion of D2, run once per ring
// creation because the runtime has no const-assert form. A layout that puts the
// indices on one line is the bug this check exists to make loud.
func ringLayoutCheck() {
	var h ringBuf
	if unsafe.Offsetof(h.writeIdx) != 0 ||
		unsafe.Offsetof(h.sentFrames) != 4 ||
		unsafe.Offsetof(h.readIdx) != 128 ||
		unsafe.Offsetof(h.recvFrames) != 132 ||
		unsafe.Offsetof(h.size) != 256 ||
		unsafe.Offsetof(h.closed) != 260 ||
		unsafe.Offsetof(h.recvSleeper) != 264 ||
		unsafe.Offsetof(h.sendSleeper) != 268 ||
		unsafe.Offsetof(h.refcount) != 272 ||
		unsafe.Sizeof(ringBuf{}) != ringHeaderSize {
		runtimePanic("ring: write and read indices must be on separate cache lines")
	}
}

// ringCreate maps a ring whose data area is dataSize bytes. The data area is
// half the ring's chunk class: a chunk occupies at most half of it, so a chunk
// can always be written when the ring is otherwise empty and the reader always
// has room to consume the chunk that is blocking the writer.
func ringCreate(dataSize uint32) uintptr {
	ringLayoutCheck()
	if dataSize < 2*ringChunkHdr {
		dataSize = 2 * ringChunkHdr
	}
	if dataSize&(dataSize-1) != 0 {
		runtimePanic("ring: data area must be a power of two")
	}
	total := uintptr(ringHeaderSize) + uintptr(dataSize)
	p := sysMapShared(total)
	if uintptr(p) == 0 {
		return 0
	}
	hdr := (*ringBuf)(p)
	hdr.writeIdx = 0
	hdr.readIdx = 0
	hdr.size = dataSize
	hdr.closed = 0
	hdr.recvSleeper = 0
	hdr.sendSleeper = 0
	hdr.sentFrames = 0
	hdr.recvFrames = 0
	hdr.refcount = 2
	RecordSegmentAdd(segKindChannel, total)
	return uintptr(p)
}

// ringRetain adds one holder to a ring. A ring is created with two references
// (one per end); a channel handed to a second child adds one more for that
// child, so the ring is never released while a live domain still holds it.
func ringRetain(ring uintptr) {
	if ring == 0 {
		return
	}
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	moxie_atomic_add_u32(&hdr.refcount, 1)
}

// ringEndDrop drops one holder's reference. The mapping is released exactly by
// the holder that decrements the count to zero, so a domain that ends while the
// other end is still open decrements and never frees (section 11, risk 14).
func ringEndDrop(ring uintptr) {
	if ring == 0 {
		return
	}
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	if moxie_atomic_add_u32(&hdr.refcount, 0xFFFFFFFF) == 0 {
		ringDestroy(ring)
	}
}

func ringDestroy(ring uintptr) {
	if ring == 0 {
		return
	}
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	total := uintptr(ringHeaderSize) + uintptr(hdr.size)
	RecordSegmentFree(segKindChannel, total)
	sysUnmap(unsafe.Pointer(ring), total)
}

func ringDataPtr(ring uintptr) unsafe.Pointer {
	return unsafe.Pointer(ring + ringHeaderSize)
}

func ringAvail(ring uintptr) uint32 {
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	w := atomicLoadU32(&hdr.writeIdx)
	r := atomicLoadU32(&hdr.readIdx)
	return w - r
}

func ringSpace(ring uintptr) uint32 {
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	w := atomicLoadU32(&hdr.writeIdx)
	r := atomicLoadU32(&hdr.readIdx)
	return hdr.size - (w - r)
}

func ringIsClosed(ring uintptr) bool {
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	return atomicLoadU32(&hdr.closed) != 0
}

func ringClose(ring uintptr) {
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	atomicStoreU32(&hdr.closed, 1)
	// Unpark both sides: a peer parked on either index must learn about the
	// close now, not at its next timeout.
	moxie_futex_wake_all_shared(&hdr.writeIdx)
	moxie_futex_wake_all_shared(&hdr.readIdx)
}

// ringWakeReaders wakes a receiver parked on writeIdx after a publish. The
// sleeper flag keeps the uncontended publish syscall-free.
func ringWakeReaders(ring uintptr) {
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	if atomicLoadU32(&hdr.recvSleeper) != 0 {
		moxie_futex_wake_all_shared(&hdr.writeIdx)
	}
}

// ringWakeWriters wakes a writer parked on readIdx after a consume.
func ringWakeWriters(ring uintptr) {
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	if atomicLoadU32(&hdr.sendSleeper) != 0 {
		moxie_futex_wake_all_shared(&hdr.readIdx)
	}
}

// ringParkWrite parks the calling receiver on the write index until a producer
// publishes, the ring closes, or the bounded timeout elapses. The flag is set
// before the index is loaded, and the wait carries that loaded value as its
// expectation, so a publish racing with the park is either seen by the reload
// or rejected by the kernel's expected-value check - it cannot be lost.
func ringParkWrite(ring uintptr) {
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	atomicStoreU32(&hdr.recvSleeper, 1)
	cmp := atomicLoadU32(&hdr.writeIdx)
	if ringAvail(ring) < ringChunkHdr && !ringIsClosed(ring) {
		moxie_futex_wait_timeout_shared(&hdr.writeIdx, cmp, pipeParkTimeoutNs)
	}
	atomicStoreU32(&hdr.recvSleeper, 0)
}

// ringParkRead parks the calling writer on the read index until the consumer
// frees need bytes AND takes a frame, the ring closes, or the bounded timeout
// elapses.
//
// The slot count belongs in the park condition. A writer blocked because the
// channel already holds its declared number of outstanding messages has plenty
// of space in BYTES, so a park keyed on bytes alone returns immediately and the
// send loop spins at 100% CPU on both ends - the sender burning a core, and the
// receiver failing to advance because the exchange cannot complete. The
// consumer advances readIdx as it takes each chunk, so one wake covers both
// conditions.
func ringParkRead(ring uintptr, need uint32, slots uint32) {
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	atomicStoreU32(&hdr.sendSleeper, 1)
	cmp := atomicLoadU32(&hdr.readIdx)
	if (ringSpace(ring) < need || ringDepth(ring) >= slots) && !ringIsClosed(ring) {
		moxie_futex_wait_timeout_shared(&hdr.readIdx, cmp, pipeParkTimeoutNs)
	}
	atomicStoreU32(&hdr.sendSleeper, 0)
}

// ringDepth is the number of messages published and not yet consumed: the
// outstanding message count the channel's declared capacity limits. Only the
// producer writes sentFrames (once, on the first chunk of a message) and only
// the consumer writes recvFrames (once, on FINAL), so the difference is an SPSC
// count that needs no read-modify-write to be shared.
func ringDepth(ring uintptr) uint32 {
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	return atomicLoadU32(&hdr.sentFrames) - atomicLoadU32(&hdr.recvFrames)
}

func ringAlign8(n uint32) uint32 {
	return (n + 7) &^ 7
}

// ringChunkCap is the largest payload one chunk may carry. Half the data area
// leaves the other half as room for the reader to consume it.
func ringChunkCap(ring uintptr) (n int32) {
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	n = int32(hdr.size/2) - ringChunkHdr
	if n < 1 {
		n = 1
	}
	return n
}

func ringPutU32(b []byte, off int32, v uint32) {
	b[off] = byte(v >> 24)
	b[off+1] = byte(v >> 16)
	b[off+2] = byte(v >> 8)
	b[off+3] = byte(v)
}

func ringGetU32(b []byte, off int32) (v uint32) {
	v = uint32(b[off])<<24 | uint32(b[off+1])<<16 | uint32(b[off+2])<<8 | uint32(b[off+3])
	return
}

// ringWrite copies src[0:n] into the ring at offset pos, handling wrap.
func ringWrite(ring uintptr, pos, n uint32, src unsafe.Pointer) {
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	data := ringDataPtr(ring)
	mask := hdr.size - 1
	start := pos & mask
	if start+n <= hdr.size {
		memcpy(unsafe.Add(data, uintptr(start)), src, uintptr(n))
	} else {
		first := hdr.size - start
		memcpy(unsafe.Add(data, uintptr(start)), src, uintptr(first))
		memcpy(data, unsafe.Add(src, uintptr(first)), uintptr(n-first))
	}
}

// ringRead copies n bytes from the ring at offset pos into dst, handling wrap.
func ringRead(ring uintptr, pos, n uint32, dst unsafe.Pointer) {
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	data := ringDataPtr(ring)
	mask := hdr.size - 1
	start := pos & mask
	if start+n <= hdr.size {
		memcpy(dst, unsafe.Add(data, uintptr(start)), uintptr(n))
	} else {
		first := hdr.size - start
		memcpy(dst, unsafe.Add(data, uintptr(start)), uintptr(first))
		memcpy(unsafe.Add(dst, uintptr(first)), data, uintptr(n-first))
	}
}

// ringSendChunk writes one chunk of a message and returns the payload bytes it
// carried. ok=false means the ring has no room for a chunk right now, so the
// caller parks on the read index; n=0 with ok=true is the empty message.
//
// first counts the message in sentFrames before the commit store. The index
// advance is the commit, so a consumer that sees the first chunk can never see
// a depth that has not counted it - counting after the store would let a
// single-chunk message complete on the far side before the sender's count and
// make depth underflow.
func ringSendChunk(ring uintptr, payload []byte, off int32, first, final bool) (n int32, ok bool) {
	if ring == 0 || ringIsClosed(ring) {
		return 0, false
	}
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	maxPayload := ringChunkCap(ring)
	n = int32(len(payload)) - off
	if n < 0 {
		n = 0
	}
	if n > maxPayload {
		n = maxPayload
	}
	total := ringAlign8(uint32(ringChunkHdr) + uint32(n))
	if ringSpace(ring) < total {
		return 0, false
	}
	w := atomicLoadU32(&hdr.writeIdx)
	if first {
		atomicStoreU32(&hdr.sentFrames, atomicLoadU32(&hdr.sentFrames)+1)
	}
	hb := []byte{:ringChunkHdr}
	ringPutU32(hb, 0, uint32(n))
	if final {
		ringPutU32(hb, 4, ringFlagFinal)
	} else {
		ringPutU32(hb, 4, 0)
	}
	ringWrite(ring, w, ringChunkHdr, unsafe.Pointer(&hb[0]))
	if n > 0 {
		ringWrite(ring, w+ringChunkHdr, uint32(n), unsafe.Add(unsafe.Pointer(&payload[0]), uintptr(off)))
	}
	atomicStoreU32(&hdr.writeIdx, w+total)
	ringWakeReaders(ring)
	return n, true
}

// ringRecvChunk reads exactly one chunk. ok=false means no complete chunk is
// currently available. The caller reassembles until FINAL is set.
func ringRecvChunk(ring uintptr) (chunk []byte, final bool, ok bool) {
	if ring == 0 {
		return nil, false, false
	}
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	if ringAvail(ring) < ringChunkHdr {
		return nil, false, false
	}
	r := atomicLoadU32(&hdr.readIdx)
	hb := []byte{:ringChunkHdr}
	ringRead(ring, r, ringChunkHdr, unsafe.Pointer(&hb[0]))
	n := int32(ringGetU32(hb, 0))
	flags := ringGetU32(hb, 4)
	if n < 0 || n > ringChunkCap(ring) {
		// Both ends are generated from one declaration in one binary, so a
		// chunk length outside the class is a protocol bug, not bad input.
		runtimePanic("ring: chunk length outside the chunk class")
	}
	total := ringAlign8(uint32(ringChunkHdr) + uint32(n))
	if ringAvail(ring) < total {
		// The commit store publishes the whole chunk, so a header without its
		// payload cannot be observed. Fail loud rather than decode garbage.
		runtimePanic("ring: torn chunk visible above the commit index")
	}
	if n > 0 {
		chunk = []byte{:n}
		ringRead(ring, r+ringChunkHdr, uint32(n), unsafe.Pointer(&chunk[0]))
	}
	atomicStoreU32(&hdr.readIdx, r+total)
	final = flags&ringFlagFinal != 0
	if final {
		atomicStoreU32(&hdr.recvFrames, atomicLoadU32(&hdr.recvFrames)+1)
	}
	ringWakeWriters(ring)
	return chunk, final, true
}

// Atomic operations - use C builtins for cross-process visibility.
// On x86_64 regular aligned loads/stores are atomic but we use explicit
// atomics for ARM64 correctness and to prevent compiler reordering.

//:noinline
func atomicLoadU32(p *uint32) uint32 {
	return moxie_atomic_load_u32(p)
}

//:noinline
func atomicStoreU32(p *uint32, val uint32) {
	moxie_atomic_store_u32(p, val)
}

//export moxie_atomic_load_u32
func moxie_atomic_load_u32(p *uint32) uint32

//export moxie_atomic_store_u32
func moxie_atomic_store_u32(p *uint32, val uint32)

// spawnRingSet holds ring buffer pairs for the most recent spawn call.
// Set before the thread starts, read by the child through the handoff. Each
// pair: [0]=parent→child, [1]=child→parent.
var spawnRingSet [16][2]uintptr
var spawnRingCount int32
