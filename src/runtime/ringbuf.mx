//:build linux

package runtime

import "unsafe"

// SPSC ring buffer for lock-free cross-domain channel IPC.
// Allocated via mmap(MAP_SHARED) so the buffer survives fork and both
// parent and child access the same physical memory. One ring per
// channel direction - no multiplexing, no chanID headers.
//
// Layout: 32-byte header followed by data[size] bytes.
//   [0:4]   writeIdx - monotonically increasing, producer-written
//   [4:8]   readIdx  - monotonically increasing, consumer-written
//   [8:12]  size     - data area size (power of 2)
//   [12:16] closed   - 0=open, 1=closed
//   [16:20] recvSleeper - reader is parked on writeIdx (waiting for data)
//   [20:24] sendSleeper - writer is parked on readIdx (waiting for space)
//   [24:28] sentFrames - frames published, producer-written
//   [28:32] recvFrames - frames consumed, consumer-written
//   [32:]   data
//
// The frame counters give the channel its declared depth: outstanding frames
// are sentFrames-recvFrames, and the sender refuses (parks) while that reaches
// the channel's capacity. Each counter has exactly one writer, so the
// difference needs no read-modify-write between the two processes.
//
// Messages: [len:4][payload:len][pad to align 8].
// Indices wrap via mask (size-1). Both sides use atomic load/store
// for cross-process visibility.
//
// The index word is also the parking word (L21: signal is the operation). A
// receiver waits on writeIdx, a writer on readIdx, each with the value it just
// loaded as FUTEX_WAIT's expectation, so a publish that lands between the check
// and the sleep turns the wait into an immediate EAGAIN instead of a lost
// wakeup. The sleeper flags are only a wake-elision hint: they keep the
// uncontended publish free of the FUTEX_WAKE syscall.

const (
	ringHeaderSize  = 32
	ringDefaultSize = 1 << 25 // 32MB data area (lazily faulted; matches ringMaxMsg)
	flag_MAP_SHARED = 0x1
)

// pipeParkTimeoutNs bounds every ring park. A crashed peer can never issue the
// wake, so an unbounded sleep would be a permanent hang; the caller rechecks
// ring state and peer liveness after each return.
const pipeParkTimeoutNs = 20_000_000 // 20ms

type ringBuf struct {
	writeIdx    uint32
	readIdx     uint32
	size        uint32
	closed      uint32
	recvSleeper uint32
	sendSleeper uint32
	sentFrames  uint32
	recvFrames  uint32
}

func ringCreate(dataSize uint32) uintptr {
	total := uintptr(ringHeaderSize) + uintptr(dataSize)
	p := sysMapShared(total)
	if uintptr(p) == 0 {
		return 0
	}
	hdr := (*ringBuf)(p)
	hdr.writeIdx = 0
	hdr.readIdx = 0
	hdr.size = dataSize
	hdr.closed = 0
	hdr.recvSleeper = 0
	hdr.sendSleeper = 0
	hdr.sentFrames = 0
	hdr.recvFrames = 0
	return uintptr(p)
}

func ringDestroy(ring uintptr) {
	if ring == 0 {
		return
	}
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	total := uintptr(ringHeaderSize) + uintptr(hdr.size)
	sysUnmap(unsafe.Pointer(ring), total)
}

func ringDataPtr(ring uintptr) unsafe.Pointer {
	return unsafe.Pointer(ring + ringHeaderSize)
}

func ringAvail(ring uintptr) uint32 {
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	w := atomicLoadU32(&hdr.writeIdx)
	r := atomicLoadU32(&hdr.readIdx)
	return w - r
}

func ringSpace(ring uintptr) uint32 {
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	w := atomicLoadU32(&hdr.writeIdx)
	r := atomicLoadU32(&hdr.readIdx)
	return hdr.size - (w - r)
}

func ringIsClosed(ring uintptr) bool {
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	return atomicLoadU32(&hdr.closed) != 0
}

func ringClose(ring uintptr) {
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	atomicStoreU32(&hdr.closed, 1)
	// Unpark both sides: a peer parked on either index must learn about the
	// close now, not at its next timeout.
	moxie_futex_wake_all_shared(&hdr.writeIdx)
	moxie_futex_wake_all_shared(&hdr.readIdx)
}

// ringWakeReaders wakes a receiver parked on writeIdx after a publish. The
// sleeper flag keeps the uncontended publish syscall-free.
func ringWakeReaders(ring uintptr) {
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	if atomicLoadU32(&hdr.recvSleeper) != 0 {
		moxie_futex_wake_all_shared(&hdr.writeIdx)
	}
}

// ringWakeWriters wakes a writer parked on readIdx after a consume.
func ringWakeWriters(ring uintptr) {
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	if atomicLoadU32(&hdr.sendSleeper) != 0 {
		moxie_futex_wake_all_shared(&hdr.readIdx)
	}
}

// ringParkWrite parks the calling receiver on the write index until a producer
// publishes, the ring closes, or the bounded timeout elapses. The flag is set
// before the index is loaded, and the wait carries that loaded value as its
// expectation, so a publish racing with the park is either seen by the reload
// or rejected by the kernel's expected-value check - it cannot be lost.
func ringParkWrite(ring uintptr) {
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	atomicStoreU32(&hdr.recvSleeper, 1)
	cmp := atomicLoadU32(&hdr.writeIdx)
	if ringAvail(ring) < 4 && !ringIsClosed(ring) {
		moxie_futex_wait_timeout_shared(&hdr.writeIdx, cmp, pipeParkTimeoutNs)
	}
	atomicStoreU32(&hdr.recvSleeper, 0)
}

// ringParkRead parks the calling writer on the read index until the consumer
// frees need bytes, the ring closes, or the bounded timeout elapses.
func ringParkRead(ring uintptr, need uint32) {
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	atomicStoreU32(&hdr.sendSleeper, 1)
	cmp := atomicLoadU32(&hdr.readIdx)
	if ringSpace(ring) < need && !ringIsClosed(ring) {
		moxie_futex_wait_timeout_shared(&hdr.readIdx, cmp, pipeParkTimeoutNs)
	}
	atomicStoreU32(&hdr.sendSleeper, 0)
}

// ringDepth is the number of frames published and not yet consumed: the
// outstanding message count the channel's declared capacity limits. Only the
// producer writes sentFrames and only the consumer writes recvFrames, so the
// difference is an SPSC count that needs no read-modify-write to be shared.
func ringDepth(ring uintptr) uint32 {
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	return atomicLoadU32(&hdr.sentFrames) - atomicLoadU32(&hdr.recvFrames)
}

func ringAlign8(n uint32) uint32 {
	return (n + 7) &^ 7
}

// ringWrite copies src[0:n] into the ring at offset pos, handling wrap.
func ringWrite(ring uintptr, pos, n uint32, src unsafe.Pointer) {
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	data := ringDataPtr(ring)
	mask := hdr.size - 1
	start := pos & mask
	if start+n <= hdr.size {
		memcpy(unsafe.Add(data, uintptr(start)), src, uintptr(n))
	} else {
		first := hdr.size - start
		memcpy(unsafe.Add(data, uintptr(start)), src, uintptr(first))
		memcpy(data, unsafe.Add(src, uintptr(first)), uintptr(n-first))
	}
}

// ringRead copies n bytes from the ring at offset pos into dst, handling wrap.
func ringRead(ring uintptr, pos, n uint32, dst unsafe.Pointer) {
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	data := ringDataPtr(ring)
	mask := hdr.size - 1
	start := pos & mask
	if start+n <= hdr.size {
		memcpy(dst, unsafe.Add(data, uintptr(start)), uintptr(n))
	} else {
		first := hdr.size - start
		memcpy(dst, unsafe.Add(data, uintptr(start)), uintptr(first))
		memcpy(unsafe.Add(dst, uintptr(first)), data, uintptr(n-first))
	}
}

// ringFits returns true if payload could ever fit in this ring buffer.
func ringFits(ring uintptr, payloadLen int32) bool {
	if ring == 0 {
		return false
	}
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	return ringAlign8(4+uint32(payloadLen)) <= hdr.size
}

// ringSend writes a length-prefixed message to the ring. Returns false
// if the ring is full (backpressure) or closed.
func ringSend(ring uintptr, payload []byte) bool {
	if ring == 0 || ringIsClosed(ring) {
		return false
	}
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	msgLen := uint32(len(payload))
	total := ringAlign8(4 + msgLen)
	if total > hdr.size {
		return false
	}
	if ringSpace(ring) < total {
		return false
	}
	w := atomicLoadU32(&hdr.writeIdx)
	// Write length prefix.
	lenBuf := []byte{:4}
	lenBuf[0] = byte(msgLen >> 24)
	lenBuf[1] = byte(msgLen >> 16)
	lenBuf[2] = byte(msgLen >> 8)
	lenBuf[3] = byte(msgLen)
	ringWrite(ring, w, 4, unsafe.Pointer(&lenBuf[0]))
	// Write payload.
	if msgLen > 0 {
		ringWrite(ring, w+4, msgLen, unsafe.Pointer(&payload[0]))
	}
	// Publish: advance writeIdx with release semantics, then count the frame so
	// a sender blocked on the declared depth sees this send in flight.
	atomicStoreU32(&hdr.writeIdx, w+total)
	atomicStoreU32(&hdr.sentFrames, atomicLoadU32(&hdr.sentFrames)+1)
	ringWakeReaders(ring)
	return true
}

// ringRecv reads one length-prefixed message from the ring. Returns
// (data, true) on success, (nil, false) if empty or closed.
func ringRecv(ring uintptr) ([]byte, bool) {
	if ring == 0 {
		return nil, false
	}
	hdr := (*ringBuf)(unsafe.Pointer(ring))
	if ringAvail(ring) < 4 {
		if ringIsClosed(ring) {
			return nil, false
		}
		return nil, false
	}
	r := atomicLoadU32(&hdr.readIdx)
	// Read length prefix.
	lenBuf := []byte{:4}
	ringRead(ring, r, 4, unsafe.Pointer(&lenBuf[0]))
	msgLen := uint32(lenBuf[0])<<24 | uint32(lenBuf[1])<<16 | uint32(lenBuf[2])<<8 | uint32(lenBuf[3])
	total := ringAlign8(4 + msgLen)
	if ringAvail(ring) < total {
		return nil, false
	}
	var data []byte
	if msgLen > 0 {
		data = []byte{:msgLen}
		ringRead(ring, r+4, msgLen, unsafe.Pointer(&data[0]))
	}
	// Consume: advance readIdx with release semantics, then count the frame so a
	// sender parked on the depth limit wakes to a free slot.
	atomicStoreU32(&hdr.readIdx, r+total)
	atomicStoreU32(&hdr.recvFrames, atomicLoadU32(&hdr.recvFrames)+1)
	ringWakeWriters(ring)
	return data, true
}

// Atomic operations - use C builtins for cross-process visibility.
// On x86_64 regular aligned loads/stores are atomic but we use explicit
// atomics for ARM64 correctness and to prevent compiler reordering.

//:noinline
func atomicLoadU32(p *uint32) uint32 {
	return moxie_atomic_load_u32(p)
}

//:noinline
func atomicStoreU32(p *uint32, val uint32) {
	moxie_atomic_store_u32(p, val)
}

//export moxie_atomic_load_u32
func moxie_atomic_load_u32(p *uint32) uint32

//export moxie_atomic_store_u32
func moxie_atomic_store_u32(p *uint32, val uint32)

// spawnRingSet holds ring buffer pairs for the most recent spawn call.
// Set before fork, inherited by child. Each pair: [0]=parent→child, [1]=child→parent.
var spawnRingSet [16][2]uintptr
var spawnRingCount int32
