package runtime

// ArenaStats reports memory allocation statistics for the arena allocator.
type ArenaStats struct {
	Alloc      uint64 // bytes currently allocated (same as ArenaInuse)
	Sys        uint64 // total bytes obtained from OS
	ArenaAlloc uint64 // bytes allocated in arenas
	ArenaSys   uint64 // ArenaInuse + ArenaIdle
	ArenaIdle  uint64 // always 0 (arenas have no idle pages)
	ArenaInuse uint64 // bytes in active arena regions
	ArenaFreed uint64 // always 0 (individual free not supported)
	TotalAlloc uint64 // cumulative bytes allocated
	Allocs     uint64 // cumulative count of allocations
	Frees      uint64 // always 0 (arena bulk-frees at munmap)
}

// MemStats is kept as an alias so existing code compiles.
type MemStats = ArenaStats
