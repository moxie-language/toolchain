package runtime

// Memory statistics for the free-list allocator.

type MemStats struct {
	Alloc        uint64
	Sys          uint64
	HeapAlloc    uint64
	HeapSys      uint64
	HeapIdle     uint64
	HeapInuse    uint64
	HeapReleased uint64
	TotalAlloc   uint64
	Mallocs      uint64
	Frees        uint64
	GCSys        uint64 // always 0, kept for API compat
}
