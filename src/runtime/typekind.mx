package runtime

// Minimal type introspection for interface equality and hashmap hashing.
// Replaces the reflectlite dependency in runtime.
// These constants and types mirror internal/reflectlite but are defined
// locally to break the runtime→reflectlite→runtime cycle.
//
// CRITICAL: struct layouts must exactly match those in
// internal/reflectlite/type.mx - the compiler generates type descriptors
// in that format.

import (
	"array"
	"unsafe"
)

type Kind uint8

const (
	Invalid Kind = iota
	Bool
	Int
	Int8
	Int16
	Int32
	Int64
	Uint
	Uint8
	Uint16
	Uint32
	Uint64
	Uintptr
	Float32
	Float64
	Complex64
	Complex128
	KindBytes // kind 17: unified string=[]byte
	KindUnsafePointer
	KindChan
	KindInterface
	KindPointer
	KindSlice
	KindArray
	KindFunc
	KindMap
	KindStruct
)

const (
	kindMask       = 31
	flagNamed      = 32
	flagComparable = 64
	flagIsBinary   = 128
)

// RawType is the base type descriptor. All type descriptors start with this.
type RawType struct {
	meta uint8
}

// rtElemType: named, chan, slice, array, map - types with elem pointer.
// Layout: meta(1) pad(1) numMethod(2) pad(4) ptrTo(8) elem(8) = 24 bytes
type rtElemType struct {
	RawType
	numMethod uint16
	ptrTo     *RawType
	elem      *RawType
}

// rtPtrType: pointer types - no ptrTo field.
// Layout: meta(1) pad(1) numMethod(2) pad(4) elem(8) = 16 bytes
type rtPtrType struct {
	RawType
	numMethod uint16
	elem      *RawType
}

// rtArrayType: array types.
// Layout: meta(1) pad(1) numMethod(2) pad(4) ptrTo(8) elem(8) arrayLen(8) slicePtr(8) = 40 bytes
type rtArrayType struct {
	rtElemType
	arrayLen uintptr
	slicePtr *RawType
}

// rtStructType: struct types. Does NOT have elem field - has pkgpath instead.
// Layout: meta(1) pad(1) numMethod(2) pad(4) ptrTo(8) pkgpath(8) size(4) numField(2) pad(2) fields(...)
type rtStructType struct {
	RawType
	numMethod uint16
	ptrTo     *RawType
	pkgpath   *byte
	size      uint32
	numField  uint16
	fields    [1]rtStructFieldDesc // flexible array member
}

// rtStructFieldDesc is a struct field descriptor.
type rtStructFieldDesc struct {
	fieldType *RawType
	data      unsafe.Pointer
}

func (t *RawType) IsNamed() (r0 bool) {
	if uintptr(unsafe.Pointer(t))&0b11 != 0 {
		return false
	}
	return t.meta&flagNamed != 0
}

func (t *RawType) Kind() (r0 Kind) {
	if t == nil {
		return Invalid
	}
	if tag := uintptr(unsafe.Pointer(t)) & 0b11; tag != 0 {
		return KindPointer
	}
	return Kind(t.meta & kindMask)
}

func (t *RawType) Size() (r0 uintptr) {
	switch t.Kind() {
	case Bool, Int8, Uint8:
		return 1
	case Int16, Uint16:
		return 2
	case Int32, Uint32, Float32:
		return 4
	case Int64, Uint64, Float64:
		return 8
	case Int, Uint:
		return unsafe.Sizeof(int32(0))
	case Uintptr:
		return unsafe.Sizeof(uintptr(0))
	case Complex64:
		return 8
	case Complex128:
		return 16
	case KindBytes:
		return unsafe.Sizeof("")
	case KindUnsafePointer, KindChan, KindMap, KindPointer:
		return unsafe.Sizeof(uintptr(0))
	case KindSlice:
		return unsafe.Sizeof([]int32{})
	case KindInterface:
		return 2 * unsafe.Sizeof(uintptr(0))
	case KindFunc:
		var f func()
		return unsafe.Sizeof(f)
	case KindArray:
		return t.Elem().Size() * uintptr(t.ArrayLen())
	case KindStruct:
		return uintptr(t.StructSize())
	default:
		return 0
	}
}

// minLen returns the minimum encoded data length in bytes for values of t.
// Variable-length kinds (string, slice, map, pointer, interface) contribute 0.
// A type is fixed-width iff minLen() == maxLen(); that shared value is the
// width. Encoders can then omit the length field (it is implied by the
// schema/type descriptor).
func (t *RawType) MinLen() (r0 uintptr) {
	switch t.Kind() {
	case Bool, Int8, Uint8:
		return 1
	case Int16, Uint16:
		return 2
	case Int32, Uint32, Float32:
		return 4
	case Int64, Uint64, Float64, Complex64:
		return 8
	case Complex128:
		return 16
	case Int, Uint:
		return unsafe.Sizeof(int32(0))
	case Uintptr:
		return unsafe.Sizeof(uintptr(0))
	case KindUnsafePointer, KindChan, KindFunc:
		return unsafe.Sizeof(uintptr(0))
	case KindArray:
		return t.Elem().MinLen() * uintptr(t.ArrayLen())
	case KindStruct:
		var sum uintptr
		for i := int32(0); i < t.NumField(); i++ {
			sum += t.StructFieldType(i).MinLen()
		}
		return sum
	default:
		return 0
	}
}

// maxLen returns the maximum encoded data length in bytes. Fixed-width types
// return the same value as minLen; variable-length kinds return ^uintptr(0).
func (t *RawType) MaxLen() (r0 uintptr) {
	switch t.Kind() {
	case Bool, Int8, Uint8:
		return 1
	case Int16, Uint16:
		return 2
	case Int32, Uint32, Float32:
		return 4
	case Int64, Uint64, Float64, Complex64:
		return 8
	case Complex128:
		return 16
	case Int, Uint:
		return unsafe.Sizeof(int32(0))
	case Uintptr:
		return unsafe.Sizeof(uintptr(0))
	case KindUnsafePointer, KindChan, KindFunc:
		return unsafe.Sizeof(uintptr(0))
	case KindArray:
		m := t.Elem().MaxLen()
		if m == ^uintptr(0) {
			return ^uintptr(0)
		}
		return m * uintptr(t.ArrayLen())
	case KindStruct:
		var sum uintptr
		for i := int32(0); i < t.NumField(); i++ {
			m := t.StructFieldType(i).MaxLen()
			if m == ^uintptr(0) {
				return ^uintptr(0)
			}
			sum += m
		}
		return sum
	default:
		return ^uintptr(0)
	}
}

// underlying returns the underlying type. For named types, follows the
// elem pointer in the namedType/elemType layout to the underlying type.
func (t *RawType) Underlying() (r0 *RawType) {
	// Follow the whole named chain: a type alias (type A = B) can emit
	// A -> B -> struct, so one step is not enough for layout accessors.
	for t.IsNamed() {
		// namedType has same layout as elemType: elem is at the same offset.
		t = (*rtElemType)(unsafe.Pointer(t)).elem
		if t == nil {
			return nil
		}
	}
	return t
}

// elem returns the element type for pointer, chan, slice, array, map types.
func (t *RawType) Elem() (r0 *RawType) {
	if tag := uintptr(unsafe.Pointer(t)) & 0b11; tag != 0 {
		// Tagged pointer: peel one pointer level.
		return (*RawType)(unsafe.Pointer(uintptr(unsafe.Pointer(t)) - 1))
	}
	u := t.Underlying()
	switch u.Kind() {
	case KindPointer:
		return (*rtPtrType)(unsafe.Pointer(u)).elem
	default:
		return (*rtElemType)(unsafe.Pointer(u)).elem
	}
}

func (t *RawType) ArrayLen() (r0 int32) {
	u := t.Underlying()
	return int32((*rtArrayType)(unsafe.Pointer(u)).arrayLen)
}

func (t *RawType) StructSize() (r0 uint32) {
	u := t.Underlying()
	return (*rtStructType)(unsafe.Pointer(u)).size
}

func (t *RawType) NumField() (r0 int32) {
	u := t.Underlying()
	return int32((*rtStructType)(unsafe.Pointer(u)).numField)
}

// structFieldType returns the type of the i-th field of a struct.
func (t *RawType) StructFieldType(i int32) (r0 *RawType) {
	u := t.Underlying()
	st := (*rtStructType)(unsafe.Pointer(u))
	fields := array.At[rtStructFieldDesc](unsafe.Pointer(&st.fields[0]), int32(st.numField))
	return fields.Index(i).fieldType
}

// StructFieldName returns the i-th field's name, decoded from the field
// descriptor's data pointer. Data format: flags(1 byte) + varint(offset) +
// name(null-term) + optional tag.
func (t *RawType) StructFieldName(i int32) (s string) {
	u := t.Underlying()
	st := (*rtStructType)(unsafe.Pointer(u))
	fields := array.At[rtStructFieldDesc](unsafe.Pointer(&st.fields[0]), int32(st.numField))
	p := (*uint8)(fields.Index(i).data)
	// skip flags byte
	p = (*uint8)(unsafe.Add(unsafe.Pointer(p), 1))
	// skip varint-encoded offset
	for {
		b := *p
		p = (*uint8)(unsafe.Add(unsafe.Pointer(p), 1))
		if b&0x80 == 0 {
			break
		}
	}
	start := unsafe.Pointer(p)
	n := int32(0)
	for {
		if *(*uint8)(unsafe.Add(start, uintptr(n))) == 0 {
			break
		}
		n++
	}
	out := []byte{:n}
	copy(out, unsafe.Slice((*byte)(start), n))
	return string(out)
}

// structFieldOffset returns the offset of the i-th field by reading the
// varint-encoded offset from the field descriptor's data pointer.
// Data format: flags(1 byte) + varint(offset) + name(null-term) + ...
func (t *RawType) StructFieldOffset(i int32) (r0 uintptr) {
	u := t.Underlying()
	st := (*rtStructType)(unsafe.Pointer(u))
	fields := array.At[rtStructFieldDesc](unsafe.Pointer(&st.fields[0]), int32(st.numField))
	p := (*uint8)(fields.Index(i).data)
	// skip flags byte
	p = (*uint8)(unsafe.Add(unsafe.Pointer(p), 1))
	// read varint-encoded offset
	var offset uintptr
	var shift uint32
	for {
		b := *p
		offset |= uintptr(b&0x7f) << shift
		if b&0x80 == 0 {
			break
		}
		shift += 7
		p = (*uint8)(unsafe.Add(unsafe.Pointer(p), 1))
	}
	return offset
}
