package runtime

import (
	"internal/task"
	"runtime/interrupt"
	"moxie"
	"unsafe"
)

// trap is a compiler hint that this function cannot be executed. It is
// translated into either a trap instruction or a call to abort().
//
//export llvm.trap
func trap()

// Inline assembly stub. It is essentially C longjmp but modified a bit for the
// purposes of Moxie. It restores the stack pointer and jumps to the given pc.
//
//export moxie_longjmp
func moxie_longjmp(frame *deferFrame)

func panicStrategy() uint8 { return 1 }

// printFD is the descriptor printstring/printptr write through. It is stdout
// until a panic redirects it: a panic's diagnostic belongs on stderr, the one
// stream the shell or supervisor that started the binary always shows, and
// every panic path sets this before its first character.
var printFD int32 = 1

// PrintFDValue reports the descriptor printstring writes through in this
// domain. A spawned domain that never ran the package initializer sees 0.
func PrintFDValue() (fd int32) { return printFD }

// DeferFrame is a stack allocated object that stores information for the
// current "defer frame", which is used in functions that use the `defer`
// keyword.
// The compiler knows about the JumpPC struct offset, so it should not be moved
// without also updating compiler/defer.go.
type deferFrame struct {
	JumpSP     unsafe.Pointer                 // stack pointer to return to
	JumpPC     unsafe.Pointer                 // pc to return to
	ExtraRegs  [deferExtraRegs]unsafe.Pointer // extra registers (depending on the architecture)
	Previous   *deferFrame                    // previous recover buffer pointer
	Panicking  panicState                     // not panicking, panicking, or in Goexit
	PanicValue string                         // panic value, might be "" for panic(nil) for example
}

type panicState uint8

const (
	panicFalse panicState = iota
	panicTrue
	panicGoexit
)

// Builtin function panic(msg), used as a compiler intrinsic.
func _panic(message string) {
	panicOrGoexit(message, panicTrue)
}

// _panicIface raises a panic whose operand the type checker boxed into the
// empty interface. A deferred builtin call is checked against panic's
// signature `func(any)`, so `defer panic("literal")` reaches the compiler as
// an interface value and the defer record stores the box; replaying
// `_panic(typecode, value)` then hands two pointers to a function that takes a
// string, which the verifier rejects. The only operand that can arrive here is
// a string (the language has no other printable panic reason), so unwrap it;
// anything else is named as a non-string panic rather than reported as the
// wrong text.
func _panicIface(typecode, value unsafe.Pointer) {
	if typecode != nil && value != nil {
		if (*RawType)(typecode).Kind() == KindBytes {
			_panic(*(*string)(value))
			return
		}
	}
	_panic("panic: non-string value")
}

func panicOrGoexit(message string, panicking panicState) {
	if panicStrategy() == moxie.PanicStrategyTrap {
		trap()
	}
	// Panic is FATAL: Moxie has no recover, so there is no unwinding jump to a
	// deferred function. The defer frames still exist for ordinary deferred
	// calls, but nothing here longjmps into a landing pad.
	if panicking == panicGoexit {
		// Call to Goexit() instead of a panic.
		// Exit the goroutine instead of printing a panic message.
		deadlock()
	}
	printFD = 2
	printstring("panic: ")
	printstring(message)
	printnl()
	abort()
}

// _panicstr is the compiler-visible panic entry point.
// Called by generated panic code and by internal/task.
func _panicstr(msg string) {
	runtimePanicAt(returnAddress(0), msg)
}

// Cause a runtime panic, which is (currently) always a string.
func runtimePanic(msg string) {
	// Print FIRST. Native has one process and a panic aborts it, so no other
	// domain can read a reason from a breaker: the shell that started the
	// binary sees the message only through fd 2. Wasm has no process, so the
	// same diagnostic crosses the host boundary as the page's stderr and the
	// trap that follows is the page's cue to stop every domain it spawned -
	// report first, tear down second, on both targets.
	_panicstr(msg)
}

func runtimePanicAt(addr unsafe.Pointer, msg string) {
	if panicStrategy() == moxie.PanicStrategyTrap {
		trap()
	}
	printFD = 2
	if hasReturnAddr {
		// Note: the string "panic: runtime error at " is also used in
		// runtime_cortexm_hardfault.go. It is kept the same so that the string
		// can be deduplicated by the compiler.
		printstring("panic: runtime error at ")
		printptr(uintptr(addr) - callInstSize)
		printstring(": ")
	} else {
		printstring("panic: runtime error: ")
	}
	printstring(msg)
	printnl()
	abort()
}

// Called at the start of a function that includes a deferred call.
// It gets passed in the stack-allocated defer frame and configures it.
// Note that the frame is not zeroed yet, so we need to initialize all values
// that will be used.
//
//:inline
//:nobounds
func setupDeferFrame(frame *deferFrame, jumpSP unsafe.Pointer) {
	if interrupt.In() {
		// Defer is not currently allowed in interrupts.
		// We could add support for this, but since defer might also allocate
		// (especially in loops) it might not be a good idea anyway.
		runtimePanicAt(returnAddress(0), "defer in interrupt")
	}
	currentTask := task.Current()
	frame.Previous = (*deferFrame)(currentTask.DeferFrame)
	frame.JumpSP = jumpSP
	frame.Panicking = panicFalse
	currentTask.DeferFrame = unsafe.Pointer(frame)
}

// Called right before the return instruction. It pops the defer frame from the
// linked list of defer frames. It also re-raises a panic if the goroutine is
// still panicking.
//
//:inline
//:nobounds
func destroyDeferFrame(frame *deferFrame) {
	task.Current().DeferFrame = unsafe.Pointer(frame.Previous)
	if frame.Panicking != panicFalse {
		// We're still panicking!
		// Re-raise the panic now.
		panicOrGoexit(frame.PanicValue, frame.Panicking)
	}
}


// Panic when trying to dereference a nil pointer.
func nilPanic() {
	runtimePanicAt(returnAddress(0), "nil pointer dereference")
}

// Panic when trying to add an entry to a nil map
func nilMapPanic() {
	runtimePanicAt(returnAddress(0), "assignment to entry in nil map")
}

// Panic when trying to access an array or slice out of bounds.
func lookupPanic() {
	runtimePanicAt(returnAddress(0), "index out of range")
}

// lookupCheck traps when an element index is not below the collection length.
// Moxie carries no inline branch for index checks: a store past len used to
// write into spare capacity and leave len unchanged, so the value silently
// vanished at the next push. The compilers call this for every index that
// loads or stores an element; an address formed from an index is pointer
// arithmetic and is not checked.
func lookupCheck(idx, length uintptr) {
	if idx >= length {
		lookupPanic()
	}
}

// lookupCheck64 is lookupCheck for an index wider than uintptr (a 64-bit index
// on a 32-bit target). The caller zero-extends the length, so the unsigned
// compare is exact and a huge index stays out of range. It is a separate entry
// because a call whose argument types do not match the declaration is not a
// diagnostic: the wasm link replaces it with a trap stub that fires even when
// the index is in bounds.
func lookupCheck64(idx, length uint64) {
	if idx >= length {
		lookupPanic()
	}
}

// Panic when trying to slice a slice out of bounds.
func slicePanic() {
	runtimePanicAt(returnAddress(0), "slice out of range")
}

// capExternal is the capacity sentinel for slice storage this program does not
// own: a //:linkdata binding, whose bytes are an external symbol with a length
// fixed at build time. The header carries all-ones capacity, which cap() reads
// as -1, and every builtin that would change the length refuses instead of
// writing past the external blob.
func sliceExternalCap(capacity uintptr) (ok bool) {
	return capacity == ^uintptr(0)
}

func sliceFixedPanic() {
	runtimePanicAt(returnAddress(0), "slice length is fixed: the storage is not ours")
}

// sliceCheckPop traps when a pop is attempted on an empty slice, or on a slice
// whose storage is external and therefore has a fixed length. The pop and
// resize builtins used to emit the panic call inline behind an icmp, which
// panics on every execution: the runtime panic entries are unconditional, so
// the test has to run inside the entry, not at the call site.
func sliceCheckPop(length, capacity uintptr) {
	if sliceExternalCap(capacity) {
		sliceFixedPanic()
	}
	if length == 0 {
		slicePanic()
	}
}

// sliceCheckResize traps when a resize would exceed the slice capacity, or when
// the slice's storage is external: its length is fixed at build time, so no
// resize - not even a shrinking one - is allowed.
func sliceCheckResize(newLen, length, capacity uintptr) {
	if sliceExternalCap(capacity) {
		sliceFixedPanic()
	}
	if newLen > capacity {
		slicePanic()
	}
}

// Panic when trying to convert a slice to an array pointer (Go 1.17+) and the
// slice is shorter than the array.
func sliceToArrayPointerPanic() {
	runtimePanicAt(returnAddress(0), "slice smaller than array")
}

// Panic when calling unsafe.Slice() (Go 1.17+) or unsafe.String() (Go 1.20+)
// with a len that's too large (which includes if the ptr is nil and len is
// nonzero).
func unsafeSlicePanic() {
	runtimePanicAt(returnAddress(0), "unsafe.Slice/String: len out of range")
}

// Panic when trying to create a new channel that is too big.
func chanMakePanic() {
	runtimePanicAt(returnAddress(0), "new channel is too big")
}

// Panic when a shift value is negative.
func negativeShiftPanic() {
	runtimePanicAt(returnAddress(0), "negative shift")
}

// Panic when there is a divide by zero.
func divideByZeroPanic() {
	runtimePanicAt(returnAddress(0), "divide by zero")
}

func blockingPanic() {
	runtimePanicAt(returnAddress(0), "trying to do blocking operation in exported function")
}

//:linkname fips_fatal crypto/internal/fips140.fatal
func fips_fatal(msg string) {
	runtimePanic(msg)
}
