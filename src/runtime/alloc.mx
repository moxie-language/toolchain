// Free-list allocator with block-scoped deallocation. No garbage collector.
// Freed blocks are reused. Scope tracking via blockHeader.next chain.

package runtime

import (
	"unsafe"
)

const needsStaticHeap = true

var heapptr uintptr
var gcTotalAlloc uint64
var gcMallocs uint64
var gcFrees uint64

// Free-list node. Stored in-place in freed blocks (minimum block size = 16 bytes).
type freeNode struct {
	size uintptr
	next *freeNode
}

// Segregated free lists by size class.
// Classes: 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, >4096
const nSizeClasses = 10

var freeLists [nSizeClasses]*freeNode

// Block header prepended to every allocation. 16 bytes to maintain
// alignment. The next field doubles as the scope chain link.
type blockHeader struct {
	size uintptr           // allocation size; high bit = escaped flag
	next unsafe.Pointer    // next allocation in scope chain
}

const headerSize = 16
const escapedBit = uintptr(1) << (unsafe.Sizeof(uintptr(0))*8 - 1)

func sizeClass(size uintptr) int32 {
	switch {
	case size <= 16:
		return 0
	case size <= 32:
		return 1
	case size <= 64:
		return 2
	case size <= 128:
		return 3
	case size <= 256:
		return 4
	case size <= 512:
		return 5
	case size <= 1024:
		return 6
	case size <= 2048:
		return 7
	case size <= 4096:
		return 8
	default:
		return 9
	}
}

func classSize(class int32) uintptr {
	switch class {
	case 0:
		return 16
	case 1:
		return 32
	case 2:
		return 64
	case 3:
		return 128
	case 4:
		return 256
	case 5:
		return 512
	case 6:
		return 1024
	case 7:
		return 2048
	case 8:
		return 4096
	default:
		return 0 // large: exact size
	}
}

//:noinline
func alloc(size uintptr, layout unsafe.Pointer) unsafe.Pointer {
	if size == 0 {
		size = 1
	}

	size = align(size)
	totalSize := size + uintptr(headerSize)
	class := sizeClass(size)

	// Check segregated free list for reuse.
	if class < 9 {
		if node := freeLists[class]; node != nil {
			freeLists[class] = node.next
			hdr := (*blockHeader)(unsafe.Pointer(node))
			hdr.size = size
			hdr.next = nil
			ptr := unsafe.Pointer(uintptr(unsafe.Pointer(hdr)) + uintptr(headerSize))
			memzero(ptr, size)
			gcMallocs++
			gcTotalAlloc += uint64(size)
			return ptr
		}
	} else if node := freeLists[9]; node != nil && node.size >= totalSize {
		freeLists[9] = node.next
		hdr := (*blockHeader)(unsafe.Pointer(node))
		hdr.size = size
		hdr.next = nil
		ptr := unsafe.Pointer(uintptr(unsafe.Pointer(hdr)) + uintptr(headerSize))
		memzero(ptr, size)
		gcMallocs++
		gcTotalAlloc += uint64(size)
		return ptr
	}

	// Bump allocate.
	addr := heapptr
	heapptr += totalSize
	for heapptr >= heapEnd {
		if growHeap() {
			continue
		}
		runtimePanic("out of memory")
	}
	gcMallocs++
	gcTotalAlloc += uint64(size)

	hdr := (*blockHeader)(unsafe.Pointer(addr))
	hdr.size = size
	ptr := unsafe.Pointer(addr + uintptr(headerSize))
	memzero(ptr, size)
	return ptr
}

func free(ptr unsafe.Pointer) {
	if ptr == nil {
		return
	}
	hdr := (*blockHeader)(unsafe.Add(ptr, -int32(headerSize)))
	size := hdr.size & ^escapedBit
	if size == 0 {
		return
	}
	totalSize := size + uintptr(headerSize)
	class := sizeClass(size)
	node := (*freeNode)(unsafe.Pointer(hdr))
	if class < 9 {
		node.size = classSize(class)
		node.next = freeLists[class]
		freeLists[class] = node
	} else {
		node.size = totalSize
		node.next = freeLists[9]
		freeLists[9] = node
	}
	gcFrees++
}

func realloc(ptr unsafe.Pointer, size uintptr) unsafe.Pointer {
	newAlloc := alloc(size, nil)
	if ptr == nil {
		return newAlloc
	}
	hdr := (*blockHeader)(unsafe.Add(ptr, -int32(headerSize)))
	oldSize := hdr.size & ^escapedBit
	copySize := oldSize
	if size < copySize {
		copySize = size
	}
	memcpy(newAlloc, ptr, copySize)
	// old array not freed: scope system handles it when the slice
	// variable's scope exits. freeing here causes UAF when other
	// references to the old backing array still exist.
	return newAlloc
}

func markRoots(start, end uintptr) {
	// No GC scanning.
}

func ReadMemStats(m *MemStats) {
	m.HeapIdle = 0
	m.HeapInuse = gcTotalAlloc
	m.HeapReleased = 0
	m.HeapSys = m.HeapInuse + m.HeapIdle
	m.GCSys = 0
	m.TotalAlloc = gcTotalAlloc
	m.Mallocs = gcMallocs
	m.Frees = gcFrees
	m.Sys = uint64(heapEnd - heapStart)
	m.HeapAlloc = gcTotalAlloc
	m.Alloc = m.HeapAlloc
}

func GC() {
	// No-op: deterministic deallocation, no collector.
}

func SetFinalizer(obj interface{}, finalizer interface{}) {
	// No-op.
}

func initHeap() {
	heapptr = heapStart
}

func setHeapEnd(newHeapEnd uintptr) {
	heapEnd = newHeapEnd
}

//:export moxie_scanstack
func scanstack(sp uintptr) {
	// No-op: no GC scanning.
}
