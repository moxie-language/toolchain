// Bump allocator with chainable arena support.
// No free lists. No individual free. Arena bulk-frees at munmap.

package runtime

import (
	"unsafe"
)

const needsStaticHeap = true

var heapptr uintptr
var totalAlloc uint64
var mallocs uint64

// currentArena: when set, alloc() bump-allocates from this arena.
var currentArena *Arena

//:noinline
func alloc(size uintptr, _ unsafe.Pointer) unsafe.Pointer {
	if size == 0 {
		size = 1
	}
	if currentArena != nil {
		return ArenaAlloc(currentArena, align(size))
	}
	// Startup bump allocator: used before any arena is created.
	size = align(size)
	addr := heapptr
	heapptr += size
	for heapptr >= heapEnd {
		if growHeap() {
			continue
		}
		runtimePanic("out of memory")
	}
	mallocs++
	totalAlloc += uint64(size)
	ptr := unsafe.Pointer(addr)
	memzero(ptr, size)
	return ptr
}

func ReadMemStats(m *MemStats) {
	m.ArenaIdle = 0
	m.ArenaInuse = totalAlloc
	m.ArenaFreed = 0
	m.ArenaSys = m.ArenaInuse + m.ArenaIdle
	m.TotalAlloc = totalAlloc
	m.Allocs = mallocs
	m.Frees = 0
	m.Sys = uint64(heapEnd - heapStart)
	m.ArenaAlloc = totalAlloc
	m.Alloc = m.ArenaAlloc
}

func initHeap() {
	heapptr = heapStart
	// initRootArena is platform-specific: unix creates an mmap-backed
	// arena, wasm leaves currentArena nil (bump allocator is the arena).
	initRootArena()
}

// rootArena is the process-lifetime arena created at init.
var rootArena *Arena

// Arena is a chainable bump-pointer allocator backed by mmap.
// When the current region fills, a new region is chained via prev.
// ArenaFree walks the chain and munmaps all regions.
type Arena struct {
	base uintptr
	off  uintptr
	cap  uintptr
	prev *Arena // previous region in chain (nil for first)
}

// CurrentArena returns the active arena (for save/restore on nesting).
func CurrentArena() (a *Arena) {
	return currentArena
}

// SetCurrentArena sets the global arena for alloc().
func SetCurrentArena(a *Arena) {
	currentArena = a
}

// ArenaMark returns the current offset of the active arena.
func ArenaMark() (mark uintptr) {
	if currentArena == nil {
		return 0
	}
	return currentArena.off
}

// ArenaRestore resets the active arena to a previously saved offset.
func ArenaRestore(mark uintptr) {
	if currentArena == nil {
		return
	}
	currentArena.off = mark
}

const arenaDefaultRegion = uintptr(64) * 1024 // 64KB per chain link

// ArenaNew creates an arena with the given initial capacity via mmap.
func ArenaNew(capacity uintptr) (a *Arena) {
	capacity = (capacity + 4095) &^ 4095
	addr := mmap(nil, capacity, flag_PROT_READ|flag_PROT_WRITE,
		flag_MAP_PRIVATE|flag_MAP_ANONYMOUS, -1, 0)
	if addr == unsafe.Pointer(^uintptr(0)) {
		runtimePanic("arena: mmap failed")
	}
	a = (*Arena)(heapAlloc(unsafe.Sizeof(Arena{})))
	a.base = uintptr(addr)
	a.off = 0
	a.cap = capacity
	a.prev = nil
	return a
}

// ArenaAlloc allocates size bytes from the arena, 16-byte aligned, zeroed.
// If the current region is full, chains a new region.
func ArenaAlloc(a *Arena, size uintptr) unsafe.Pointer {
	if a == nil {
		runtimePanic("ArenaAlloc: nil arena")
	}
	size = align(size)
	if a.off+size > a.cap {
		// Chain a new region. New region becomes the head.
		newCap := arenaDefaultRegion
		if size > newCap {
			newCap = (size + 4095) &^ 4095
		}
		addr := mmap(nil, newCap, flag_PROT_READ|flag_PROT_WRITE,
			flag_MAP_PRIVATE|flag_MAP_ANONYMOUS, -1, 0)
		if addr == unsafe.Pointer(^uintptr(0)) {
			runtimePanic("arena: chain mmap failed")
		}
		// Save current region as prev, repoint arena to new region.
		old := (*Arena)(heapAlloc(unsafe.Sizeof(Arena{})))
		old.base = a.base
		old.off = a.off
		old.cap = a.cap
		old.prev = a.prev
		a.base = uintptr(addr)
		a.off = 0
		a.cap = newCap
		a.prev = old
	}
	ptr := unsafe.Pointer(a.base + a.off)
	a.off += size
	memzero(ptr, size)
	return ptr
}

// heapAlloc: direct startup bump allocation bypassing currentArena.
func heapAlloc(size uintptr) unsafe.Pointer {
	saved := currentArena
	currentArena = nil
	p := alloc(size, nil)
	currentArena = saved
	return p
}

// ArenaFree unmaps all regions in the chain.
func ArenaFree(a *Arena) {
	if a == nil {
		return
	}
	// Free chained previous regions.
	p := a.prev
	for p != nil {
		next := p.prev
		munmap(unsafe.Pointer(p.base), p.cap)
		p = next
	}
	// Free the head region.
	munmap(unsafe.Pointer(a.base), a.cap)
}

// ArenaReset resets the arena for reuse. Frees chained regions,
// keeps only the head region.
func ArenaReset(a *Arena) {
	if a == nil {
		return
	}
	// If chained, free all prev regions and keep just the current base.
	// But the current head might be a chained region. We need to find the
	// original (oldest) region. Walk to the end of the chain.
	if a.prev != nil {
		// The original region is at the end of the chain.
		// Free all regions including the current head, then restore original.
		var original *Arena
		p := a.prev
		for p.prev != nil {
			next := p.prev
			munmap(unsafe.Pointer(p.base), p.cap)
			p = next
		}
		original = p
		// Free current head.
		munmap(unsafe.Pointer(a.base), a.cap)
		// Restore original as head.
		a.base = original.base
		a.cap = original.cap
		a.prev = nil
	}
	a.off = 0
}

// arenaCopySliceIfLocal copies a slice's backing array to the current arena
// position only if its data pointer is in the source arena region.
func arenaCopySliceIfLocal(s string, mark uintptr) (r string) {
	if len(s) == 0 || currentArena == nil {
		return s
	}
	p := uintptr(unsafe.Pointer(unsafe.SliceData([]byte(s))))
	if !arenaContains(currentArena, p, mark) {
		return s
	}
	buf := []byte{:len(s)}
	copy(buf, s)
	return string(buf)
}

// arenaCopyPtrIfLocal copies size bytes at ptr only if in source region.
func arenaCopyPtrIfLocal(ptr unsafe.Pointer, mark uintptr, size uintptr) unsafe.Pointer {
	if ptr == nil || currentArena == nil {
		return ptr
	}
	p := uintptr(ptr)
	if !arenaContains(currentArena, p, mark) {
		return ptr
	}
	dst := alloc(size, nil)
	memcpy(dst, ptr, size)
	return dst
}

// arenaContains checks if ptr is in any region of the arena chain above mark.
func arenaContains(a *Arena, ptr uintptr, mark uintptr) (ok bool) {
	// Check head region.
	if ptr >= a.base+mark && ptr < a.base+a.cap {
		return true
	}
	// Check chained regions (all of these are fully above mark).
	p := a.prev
	for p != nil {
		if ptr >= p.base && ptr < p.base+p.cap {
			return true
		}
		p = p.prev
	}
	return false
}

func setHeapEnd(newHeapEnd uintptr) {
	heapEnd = newHeapEnd
}

//:export moxie_scanstack
func scanstack(sp uintptr) {}
