//:build moxie.wasm

package runtime

import "unsafe"

//:nobounds
func trap_arch() {
	*(*int32)(unsafe.Pointer(uintptr(0))) = 0
}

func moxie_longjmp_arch(frame *deferFrame) {
	trap_arch()
}

// moxie_longjmp_checkpoint is the setjmp half of the defer mechanism. On
// native it is an inline asm sequence that records the resume PC in the defer
// frame and returns 0, so control continues; a later longjmp makes it return
// non-zero and the caller branches to its landing pad.
//
// wasm has no equivalent: moxie_longjmp_arch above traps, so a defer can
// never resume and the checkpoint only ever returns 0. It exists so the
// emitter has an architecture-neutral symbol to call and does not have to
// carry x86 asm into a wasm module.
//
//:nobounds
func moxie_longjmp_checkpoint(frame *deferFrame) int64 {
	_ = frame
	return 0
}
