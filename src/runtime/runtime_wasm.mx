//:build wasm

package runtime

import "unsafe"

// putchar writes a single byte to stdout via WASI fd_write.
//
//:wasmimport wasi_snapshot_preview1 fd_write
func fd_write(fd int32, iovs unsafe.Pointer, iovs_len int32, nwritten unsafe.Pointer) int32

func putchar(c byte) {
	buf := [1]byte{c}
	iov := [2]uintptr{uintptr(unsafe.Pointer(&buf[0])), 1}
	var nw int32
	fd_write(1, unsafe.Pointer(&iov[0]), 1, unsafe.Pointer(&nw))
}

//:wasmimport wasi_snapshot_preview1 fd_read
func fd_read(fd int32, iovs unsafe.Pointer, iovs_len int32, nread unsafe.Pointer) int32

// stdinPeek holds the byte buffered() read ahead for getchar().
var stdinPeek byte

// buffered reports whether a byte is available on stdin without consuming it.
// The byte is held in stdinPeek for getchar.
func buffered() int32 {
	var n int32
	var b [1]byte
	iov := [2]uintptr{uintptr(unsafe.Pointer(&b[0])), 1}
	if fd_read(0, unsafe.Pointer(&iov[0]), 1, unsafe.Pointer(&n)) != 0 || n == 0 {
		return 0
	}
	stdinPeek = b[0]
	return 1
}

// getchar reads one byte from stdin.
func getchar() byte {
	if buffered() != 0 {
		return stdinPeek
	}
	return 0
}

// abort terminates the program.
//
//export abort
func abort() {
	trap()
}

// hardwareRand returns a random uint64. On WASM/JS, we use a simple
// xorshift fallback since there's no hardware RNG instruction.
var randState uint64

func hardwareRand() (n uint64, ok bool) {
	if randState == 0 {
		randState = 0x853c49e6748fea9b
	}
	// xorshift64*
	randState ^= randState >> 12
	randState ^= randState << 25
	randState ^= randState >> 27
	return randState * 0x2545F4914F6CDD1D, true
}

// wasm_memory_size returns the current memory size in pages (64KB each).
//
//:linkname wasm_memory_size llvm.wasm.memory.size.i32
func wasm_memory_size(index int32) int32

// wasm_memory_grow grows memory by delta pages. Returns previous size or -1.
//
//:linkname wasm_memory_grow llvm.wasm.memory.grow.i32
func wasm_memory_grow(index int32, delta int32) int32

const wasmPageSize = 64 * 1024

// allocateHeap initializes the domain root arena backed by WASM linear memory.
// Replaces the old heap startup allocator.
func allocateHeap() {
	// WASM: reserve 8 pages (512KB) for initial domain root arena.
	// The domain root embeds the root arena inline; further regions
	// are added via grow + ArenaAlloc when the region fills.
	initDomain(8 * wasmPageSize)
}

// Timing functions for WASM.
var wasmTickOffset int64

func ticks() timeUnit {
	return timeUnit(monotime())
}

//:wasmimport wasi_snapshot_preview1 clock_time_get
func clock_time_get(clockID int32, precision int64, time unsafe.Pointer) int32

func monotime() int64 {
	var t int64
	clock_time_get(1, 0, unsafe.Pointer(&t)) // CLOCK_MONOTONIC = 1
	return t
}

func nanosecondsToTicks(ns int64) timeUnit {
	return timeUnit(ns)
}

func ticksToNanoseconds(t timeUnit) int64 {
	return int64(t)
}

func sleepTicks(d timeUnit) {
	// No-op on WASM - cooperative scheduling handles yields.
}

func now() (int64, int32, int64) {
	var t int64
	clock_time_get(0, 0, unsafe.Pointer(&t)) // CLOCK_REALTIME = 0
	sec := t / 1000000000
	nsec := int32(t % 1000000000)
	mono := monotime()
	return sec, nsec, mono
}

// libc_errno_location is not available on WASM.
func libc_errno_location() *int32 {
	return &wasmErrno
}

var wasmErrno int32

var savedStackPointer uintptr
var stackTop uintptr

var wasmExportsReady bool

func wasmExportCheckRun() {
	if !wasmExportsReady {
		runtimePanic("wasmexport called before runtime initialization")
	}
}

//export __alloc
func wasmAlloc(size int32) int32 {
	if size <= 0 {
		return 0
	}
	ptr := alloc(uintptr(size), nil)
	return int32(uintptr(ptr))
}

// _start is the WASI entry point for WASM executables.
// WASM is single-threaded, so we bypass the scheduler and call main directly.
//
//export _start
func _start() {
	// Initialize non-zero runtime state before anything else.
	randState = 0x853c49e6748fea9b

	allocateHeap()
	initRand()
	initAll()
	wasmExportsReady = true
	callMain()
}
