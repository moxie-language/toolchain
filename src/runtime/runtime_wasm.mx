//:build wasm

package runtime

import "unsafe"

// putchar writes a single byte to stdout via WASI fd_write.
//
//:wasmimport wasi_snapshot_preview1 fd_write
func fd_write(fd int32, iovs unsafe.Pointer, iovs_len int32, nwritten unsafe.Pointer) int32

// putchar's buffers are package state, not locals. Taking the address of a
// local to hand to an import marks it escaping, so every character printed
// allocated four bytes for `nw` (measured in the wasm IR: putchar called
// runtime.alloc). That is fatal in one place: the allocator's own diagnostics
// print, so an allocator failure recursed putchar -> alloc -> print -> putchar
// until the stack ran out, and the message that would have named the failure
// was never printed.
var (
	putcharBuf byte
	putcharIOV [2]uintptr
	putcharNW  int32
)

func putchar(c byte) {
	putcharBuf = c
	putcharIOV[0] = uintptr(unsafe.Pointer(&putcharBuf))
	putcharIOV[1] = 1
	fd_write(1, unsafe.Pointer(&putcharIOV[0]), 1, unsafe.Pointer(&putcharNW))
}

//:wasmimport wasi_snapshot_preview1 fd_read
func fd_read(fd int32, iovs unsafe.Pointer, iovs_len int32, nread unsafe.Pointer) int32

// MoxieWrite is the runtime's raw fd write; the codec uses it for diagnostics
// on fd 2. On wasm the descriptors are WASI's, so this is a real fd_write and
// a codec-escape or leaked-arena warning reaches the host console instead of
// being dropped. The stub it replaces returned -1, which made that whole class
// of runtime warnings invisible on this target - a fixture that hit one looked
// like it simply had nothing to say.
//
// The iovec and the count are package state for the reason putchar's are:
// taking the address of a local to hand to an import allocates, and this is
// called from the allocator's own failure paths.
var (
	moxieWriteIOV [2]uintptr
	moxieWriteNW  int32
)

func MoxieWrite(fd int32, buf unsafe.Pointer, count int32) int32 {
	if count <= 0 {
		return 0
	}
	moxieWriteIOV[0] = uintptr(buf)
	moxieWriteIOV[1] = uintptr(count)
	moxieWriteNW = 0
	fd_write(fd, unsafe.Pointer(&moxieWriteIOV[0]), 1, unsafe.Pointer(&moxieWriteNW))
	return moxieWriteNW
}

// MoxieRead is the runtime's raw fd read, next to fd_read for the same reason
// MoxieWrite sits next to fd_write: on wasm the descriptors are WASI's, so a
// read of fd 0 is a real read of whatever the host piped in.
//
// The stub it replaces returned -1 with no wasm caller. That was true of the
// spawn handshake, which has no wasm path, but it also meant a wasm program
// could not read its stdin at all: `getchar` reads byte by byte through
// fd_read, and anything that wanted `MoxieRead`'s block read had no way to ask
// for one. The iovec and the count are package state for the same reason
// MoxieWrite's are - taking the address of a local to hand to an import
// allocates, and a read can be reached from the allocator's failure paths.
var (
	moxieReadIOV [2]uintptr
	moxieReadNR  int32
)

func MoxieRead(fd int32, buf unsafe.Pointer, count int32) int32 {
	if count <= 0 {
		return 0
	}
	moxieReadIOV[0] = uintptr(buf)
	moxieReadIOV[1] = uintptr(count)
	moxieReadNR = 0
	errno := fd_read(fd, unsafe.Pointer(&moxieReadIOV[0]), 1, unsafe.Pointer(&moxieReadNR))
	if errno != 0 {
		// A browser has no stdin and no filesystem: the descriptor does not
		// exist, and a read of it must say so. Returning 0 reported that as
		// end-of-input, which reads as "the stream is empty" and hides the fact
		// that there is no stream at all - a caller then loops forever on a
		// read that can never make progress.
		panicNoDescriptor()
	}
	return moxieReadNR
}

// panicNoDescriptor is the single message for "this wasm target has no such
// descriptor", so a stdin read in a browser says what happened.
func panicNoDescriptor() {
	runtimePanic("wasm: read failed: no such descriptor (a browser has no stdin and no filesystem)")
}

// stdinPeek holds the byte buffered() read ahead for getchar().
var stdinPeek byte

// buffered reports whether a byte is available on stdin without consuming it.
// The byte is held in stdinPeek for getchar.
func buffered() int32 {
	var n int32
	var b [1]byte
	iov := [2]uintptr{uintptr(unsafe.Pointer(&b[0])), 1}
	if errno := fd_read(0, unsafe.Pointer(&iov[0]), 1, unsafe.Pointer(&n)); errno != 0 {
		// No fd 0 at all: see MoxieRead. EOF (n == 0 with a successful read) is
		// still just "nothing to read".
		panicNoDescriptor()
	}
	if n == 0 {
		return 0
	}
	stdinPeek = b[0]
	return 1
}

// getchar reads one byte from stdin.
func getchar() byte {
	if buffered() != 0 {
		return stdinPeek
	}
	return 0
}

// abort terminates the program.
//
//export abort
func abort() {
	trap()
}

// hardwareRand returns a random uint64. On WASM/JS, we use a simple
// xorshift fallback since there's no hardware RNG instruction.
var randState uint64

func hardwareRand() (n uint64, ok bool) {
	if randState == 0 {
		randState = 0x853c49e6748fea9b
	}
	// xorshift64*
	randState ^= randState >> 12
	randState ^= randState << 25
	randState ^= randState >> 27
	return randState * 0x2545F4914F6CDD1D, true
}

// wasm_memory_size returns the current memory size in pages (64KB each).
//
//:linkname wasm_memory_size llvm.wasm.memory.size.i32
func wasm_memory_size(index int32) int32

// wasm_memory_grow grows memory by delta pages. Returns previous size or -1.
//
//:linkname wasm_memory_grow llvm.wasm.memory.grow.i32
func wasm_memory_grow(index int32, delta int32) int32

const wasmPageSize = 64 * 1024

// allocateHeap initializes the domain root arena backed by WASM linear memory.
// Replaces the old heap startup allocator.
func allocateHeap() {
	// WASM: reserve 8 pages (512KB) for initial domain root arena.
	// The domain root embeds the root arena inline; further regions
	// are added via grow + ArenaAlloc when the region fills.
	initDomain(8 * wasmPageSize)
}

// Timing functions for WASM.
var wasmTickOffset int64

func ticks() timeUnit {
	return timeUnit(monotime())
}

//:wasmimport wasi_snapshot_preview1 clock_time_get
func clock_time_get(clockID int32, precision int64, time unsafe.Pointer) int32

func monotime() int64 {
	var t int64
	clock_time_get(1, 0, unsafe.Pointer(&t)) // CLOCK_MONOTONIC = 1
	return t
}

func nanosecondsToTicks(ns int64) timeUnit {
	return timeUnit(ns)
}

func ticksToNanoseconds(t timeUnit) int64 {
	return int64(t)
}

func sleepTicks(d timeUnit) {
	// No-op on WASM - cooperative scheduling handles yields.
}

func now() (int64, int32, int64) {
	var t int64
	clock_time_get(0, 0, unsafe.Pointer(&t)) // CLOCK_REALTIME = 0
	sec := t / 1000000000
	nsec := int32(t % 1000000000)
	mono := monotime()
	return sec, nsec, mono
}

// libc_errno_location is not available on WASM.
func libc_errno_location() *int32 {
	return &wasmErrno
}

var wasmErrno int32

var savedStackPointer uintptr
var stackTop uintptr

var wasmExportsReady bool

func wasmExportCheckRun() {
	if !wasmExportsReady {
		runtimePanic("wasmexport called before runtime initialization")
	}
}

//export __alloc
func wasmAlloc(size int32) int32 {
	if size <= 0 {
		return 0
	}
	ptr := alloc(uintptr(size), nil)
	return int32(uintptr(ptr))
}

// _start is the WASI entry point for WASM executables.
// WASM is single-threaded, so we bypass the scheduler and call main directly.
//
//export _start
func _start() {
	// Initialize non-zero runtime state before anything else.
	randState = 0x853c49e6748fea9b

	allocateHeap()
	initRand()
	initAll()
	wasmExportsReady = true
	callMain()
}
