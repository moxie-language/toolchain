//:build js && wasm

package runtime

import (
	"moxie"
	"unsafe"
)

// Bridge imports for spawn-boundary SAB channels and domain creation.
// These are provided by jsruntime/host.mjs, which builds the bridge for the
// page and for every domain Worker.

//:wasmimport bridge channel_create
func bridgeChannelCreate(slotSize, slotCount int32) int32

//:wasmimport bridge channel_send
func bridgeChannelSend(handle int32, srcPtr *byte, srcLen int32)

//:wasmimport bridge channel_recv
func bridgeChannelRecv(handle int32, dstPtr *byte, dstCap int32) int32

//:wasmimport bridge channel_try_recv
func bridgeChannelTryRecv(handle int32, dstPtr *byte, dstCap int32) int32

//:wasmimport bridge channel_close
func bridgeChannelClose(handle int32)

//:wasmimport bridge spawn_domain
func bridgeSpawnDomain(fnIdx int32, argPtr *byte, argLen int32, chanHandlesPtr *byte, nChans int32, breakerHandle int32)

//:wasmimport bridge is_worker_context
func bridgeIsWorkerContext() int32

// SpawnChannelCreate creates a SAB-backed channel for use across a spawn
// boundary. slotSize and slotCount must both be powers of two; slotSize
// >= 64. Returns an opaque int32 handle stored as a uintptr.
func SpawnChannelCreate(slotSize, slotCount int32) uintptr {
	return uintptr(bridgeChannelCreate(slotSize, slotCount))
}

// SpawnChannelSend sends bytes to a SAB channel identified by handle.
func SpawnChannelSend(handle uintptr, data unsafe.Pointer, n int32) {
	bridgeChannelSend(int32(handle), (*byte)(data), n)
}

// SpawnChannelRecv receives into dst from a SAB channel. Returns byte count
// or -1 if the channel is closed.
func SpawnChannelRecv(handle uintptr, dst unsafe.Pointer, nbytes int32) int32 {
	return bridgeChannelRecv(int32(handle), (*byte)(dst), nbytes)
}

// SpawnChannelTryRecv is the non-blocking probe: -2 means nothing is queued,
// -1 means closed. A select arm uses it, because a domain has one thread and
// blocking on one arm would stop it from ever looking at the others.
func SpawnChannelTryRecv(handle uintptr, dst unsafe.Pointer, nbytes int32) int32 {
	return bridgeChannelTryRecv(int32(handle), (*byte)(dst), nbytes)
}

// SpawnChannelClose marks a SAB channel as closed.
func SpawnChannelClose(handle uintptr) {
	bridgeChannelClose(int32(handle))
}

// SpawnDomain creates a new Worker running the spawned function at fnIdx.
// argPtr/argLen carry serialized scalar args; chanHandlesPtr/nChans carry
// int32 SAB handles. Called by compiler-emitted spawn site code.
//
// Panics if not running inside a Web Worker: channel_recv uses Atomics.wait
// which is forbidden on the main browser thread. See moxie/wasm deployment docs.
func SpawnDomain(fnIdx int32, argPtr unsafe.Pointer, argLen int32, chanHandlesPtr unsafe.Pointer, nChans int32, breakerHandle int32) {
	if bridgeIsWorkerContext() == 0 {
		runtimePanic("moxie/spawn: wasm binary must be loaded inside a Web Worker - channel_recv uses Atomics.wait which is blocked on the main thread")
	}
	bridgeSpawnDomain(fnIdx, (*byte)(argPtr), argLen, (*byte)(chanHandlesPtr), nChans, breakerHandle)
}

// --- spawn-boundary channel behaviour ---
//
// chan.mx routes a channel whose spawnBound flag is set through
// tryPipeSend/tryPipeRecv/PipeChanCloseSignal instead of the in-runtime queue.
// On native those move bytes through mmap'd SPSC rings; on wasm the same rings
// live in JavaScript behind an opaque int32 handle, so this file supplies the
// wasm implementation of that same seam. Nothing in chan.mx changes per
// target - only these three symbols differ.

// sabHandleOf returns the boundary handle for a channel, or 0 if it is local.
func sabHandleOf(ch *channel) uintptr {
	if ch == nil || !ch.spawnBound {
		return 0
	}
	return ch.sabHandle
}

// MarkChannelSAB tags a channel as sitting on a wasm spawn boundary and
// records the ring handle the host created for it. The parent calls this for
// each channel it passes to spawn(); afterwards send and receive on that
// channel reach the far side without the compiler having to track the value
// through every copy and reload.
func MarkChannelSAB(ch *channel, handle uintptr) {
	if ch == nil {
		return
	}
	ch.spawnBound = true
	ch.sabHandle = handle
}

// breakerFallback on wasm: the host owns the domain boundary, so a target that
// is running at all gets a live breaker; there is no fork to detect.
func breakerFallback() *channel {
	// The breaker's element is the empty struct and nothing is ever sent on it,
	// so the ring carries no frame; one slot is the mailbox rule.
	return chanMake(0, 1, 0, nil, 0)
}

// sigintPending on wasm: a browser module is stopped by the host tearing down
// the Worker, not by a process signal, so the termination channel never closes
// from here. `sigint` is still a valid channel, so a main that selects on it
// compiles and simply never takes that arm.
func sigintPending() (ok bool) { return false }


// SpawnChannelWrap builds the child's view of a boundary channel from the
// handle that arrived in the spawn argument list. __spawn_entry calls it so
// the target function receives an ordinary channel it can send, receive and
// close on; the handle inside routes those operations to the same ring.
func SpawnChannelWrap(handle uintptr, elementSize uintptr) (ch *channel) {
	if handle == 0 {
		return nil
	}
	// A boundary channel is a mailbox with at least one slot; the host owns the
	// ring's depth, so the wrapper reports the minimum capacity rather than the
	// parent's declared size, which the handle does not carry.
	ch = chanMake(elementSize, 1, elementSize, nil, 0)
	ch.spawnBound = true
	ch.sabHandle = handle
	return ch
}

// The domain's breaker crosses the same SAB boundary as its channels: the
// parent creates the ring and keeps the handle spawn returns, and the handle
// travels in the spawn arguments, so the child's `closed` is the SAME ring
// rather than a local channel nobody else can close. That is what makes
// close(done) stop a worker, and what makes `<-done` return when it exits.
var wasmBreakerHandle uintptr

// WasmBreakerSet binds this domain's breaker to the parent's ring. Called by
// __spawn_entry before the target runs, so the target's `closed` result is the
// shared ring from its first instruction.
func WasmBreakerSet(handle uintptr) {
	if handle == 0 {
		return
	}
	wasmBreakerHandle = handle
	DomainClosed = SpawnChannelWrap(handle, 0)
}

// WasmBreakerClose reports the domain finished: closing the ring wakes the
// parent's `<-done` and every other holder of the breaker. Idempotent, because
// the target may already have closed it with close(closed).
func WasmBreakerClose() {
	if wasmBreakerHandle == 0 {
		return
	}
	SpawnChannelClose(wasmBreakerHandle)
}

// tryPipeSend writes one value to the boundary ring, encoding it when the
// element holds references: the frame must be the one the peer's direct receive
// decodes. Both encode and decode live in chan.mx (codecFrameEncode /
// codecFrameDecode) because the select ABI needs them on both targets.
func (ch *channel) tryPipeSend(value unsafe.Pointer, c moxie.Codec, td *RawType) bool {
	h := sabHandleOf(ch)
	if h == 0 {
		return false
	}
	if c == nil && td == nil {
		SpawnChannelSend(h, value, int32(ch.elementSize))
		return true
	}
	frame, ok := codecFrameEncode(c, td, value, ch.elementSize)
	if !ok {
		return false
	}
	if len(frame) == 0 {
		SpawnChannelSend(h, nil, 0)
		return true
	}
	SpawnChannelSend(h, unsafe.Pointer(&frame[0]), int32(len(frame)))
	return true
}

// tryPipeRecv reads one value from the boundary ring. A closed ring (-1)
// reports ok=false, matching the local receiver's behaviour on a closed
// channel.
func (ch *channel) tryPipeRecv(value unsafe.Pointer, c moxie.Codec, td *RawType) (received, ok bool) {
	h := sabHandleOf(ch)
	if h == 0 {
		return false, false
	}
	if c == nil && td == nil {
		// `got`, not `n`: the no-shadowing rule takes a name for the whole
		// block, so a nested `n` here would shadow the function-body `n` below.
		// Non-blocking: this is the select path. A direct receive goes through
		// PipeChanRecvRaw, which waits.
		got := SpawnChannelTryRecv(h, value, int32(ch.elementSize))
		if got < 0 {
			return false, false
		}
		return true, true
	}
	buf := []byte{:sabFrameMax}
	n := SpawnChannelTryRecv(h, unsafe.Pointer(&buf[0]), int32(len(buf)))
	if n < 0 {
		return false, false
	}
	if n > int32(len(buf)) {
		runtimePanic("moxie/spawn: boundary frame exceeds the receive buffer")
	}
	if value == nil {
		return true, true
	}
	if !codecFrameDecode(c, td, value, ch.elementSize, buf[:n]) {
		return true, false
	}
	return true, true
}

// PipeChanCloseSignal closes the boundary ring.
func PipeChanCloseSignal(ch *channel) {
	h := sabHandleOf(ch)
	if h == 0 {
		return
	}
	SpawnChannelClose(h)
}

// --- codec channel operations across the boundary ---
//
// The compiler emits ChanSendDual/ChanRecvDual for any channel whose element
// type implements moxie.Codec. On native those live in pipe_channel.mx and
// route through mmap'd rings; here they route through the SAB bridge. Values
// cross encoded, exactly as they do natively, so the wire format is the same.

// sabFrameMax bounds one boundary frame. The native transport chunks larger
// messages through its ring; the SAB bridge hands a whole message to a single
// receive, so a frame must fit the buffer the receiver offers. Overflowing it
// is a fail-loud panic, not a silent truncation.
const sabFrameMax = 1 << 20

// PipeChanSendRaw / PipeChanRecvRaw are the routes chanSend/chanRecv take for
// a spawn-bound channel whose element holds no references: the element's bytes
// ARE the message. On native they use the mmap rings; on wasm the same message
// goes over the SAB bridge. They must NOT be stubs - a false return drops the
// value silently, which is how every wasm spawn channel sent into the void
// while its receiver waited on an empty ring.
func PipeChanSendRaw(ch *channel, ptr unsafe.Pointer, size int32) bool {
	if ch == nil || !ch.spawnBound {
		return false
	}
	return ch.tryPipeSend(ptr, nil, nil)
}

func PipeChanRecvRaw(ch *channel, ptr unsafe.Pointer, size int32) bool {
	if ch == nil || !ch.spawnBound {
		return false
	}
	// The direct receive waits: the ring blocks in Atomics.wait until a frame
	// arrives or the peer closes, which is what `<-ch` means. The select path
	// uses tryPipeRecv, which never waits.
	h := sabHandleOf(ch)
	if h == 0 {
		return false
	}
	return SpawnChannelRecv(h, ptr, int32(ch.elementSize)) >= 0
}

// SharedBuffer is native-only. WASM has no anonymous shared mapping it can hand
// out as a slice (the SAB bridge copies bytes across the boundary itself), and
// the queue-owned slot ring the spawned pool uses needs memory that the forked
// worker inherits. Fail loud rather than hand back a private buffer that the
// other side would read as unrelated bytes.
func SharedBuffer(n int32) (b []byte) {
	runtimePanic("runtime.SharedBuffer: no shared mapping on wasm")
	return nil
}

// ChanSendStructural / ChanRecvStructural are the structural-codec boundary
// entries the compiler emits for channel elements that hold pointers (see
// pipe_channel.mx for why raw bytes cannot cross). The SAB bridge always
// carries an encoded frame, so these encode with the structural codec and hand
// the bytes to the bridge.
func ChanSendStructural(ch *channel, td *RawType, value unsafe.Pointer, op *channelOp) {
	if ch != nil && ch.spawnBound && ch.sabHandle != 0 {
		frame, ok := codecFrameEncode(nil, td, value, ch.elementSize)
		if !ok {
			return
		}
		if len(frame) == 0 {
			SpawnChannelSend(ch.sabHandle, nil, 0)
			return
		}
		SpawnChannelSend(ch.sabHandle, unsafe.Pointer(&frame[0]), int32(len(frame)))
		return
	}
	chanSend(ch, value, op)
}

func ChanRecvStructural(ch *channel, td *RawType, value unsafe.Pointer, op *channelOp) bool {
	if ch != nil && ch.spawnBound && ch.sabHandle != 0 {
		buf := []byte{:sabFrameMax}
		n := SpawnChannelRecv(ch.sabHandle, unsafe.Pointer(&buf[0]), int32(len(buf)))
		if n <= 0 {
			return false
		}
		if n > int32(len(buf)) {
			runtimePanic("moxie/spawn: boundary frame exceeds the receive buffer")
		}
		return codecFrameDecode(nil, td, value, ch.elementSize, buf[:n])
	}
	return chanRecv(ch, value, op)
}

// ChanSendDual is declared below.

func ChanSendDual(ch *channel, c moxie.Codec, value unsafe.Pointer, op *channelOp) {
	if ch != nil && ch.spawnBound && ch.sabHandle != 0 {
		frame, ok := codecFrameEncode(c, nil, value, ch.elementSize)
		if !ok {
			return
		}
		if len(frame) == 0 {
			SpawnChannelSend(ch.sabHandle, nil, 0)
			return
		}
		SpawnChannelSend(ch.sabHandle, unsafe.Pointer(&frame[0]), int32(len(frame)))
		return
	}
	chanSend(ch, value, op)
}

func ChanRecvDual(ch *channel, c moxie.Codec, value unsafe.Pointer, op *channelOp) bool {
	if ch != nil && ch.spawnBound && ch.sabHandle != 0 {
		buf := []byte{:sabFrameMax}
		n := SpawnChannelRecv(ch.sabHandle, unsafe.Pointer(&buf[0]), int32(len(buf)))
		if n <= 0 {
			return false
		}
		if n > int32(len(buf)) {
			runtimePanic("moxie/spawn: boundary frame exceeds the receive buffer")
		}
		return codecFrameDecode(c, nil, value, ch.elementSize, buf[:n])
	}
	return chanRecv(ch, value, op)
}
