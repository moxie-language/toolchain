//:build !moxie.wasm && !baremetal

package runtime

import "unsafe"

// coverOutFD returns the descriptor coverBeforeExit dumps to: the file named by
// MOXIE_COVER_OUT when it is set and can be opened, stderr otherwise. The two
// C helpers read the environment and open the path with the mode bits from the
// C headers, so no platform constants live in Moxie.
func coverOutFD() (fd int32) {
	name := []byte("MOXIE_COVER_OUT")
	name = name | []byte{0}
	p := moxieCoverEnv(unsafe.Pointer(&name[0]))
	if p == nil {
		return 2
	}
	ofd := moxieCoverOpen(p)
	if ofd < 0 {
		return 2
	}
	return ofd
}

//export moxie_cover_env
func moxieCoverEnv(name unsafe.Pointer) (p unsafe.Pointer)

//export moxie_cover_open
func moxieCoverOpen(path unsafe.Pointer) (fd int32)
