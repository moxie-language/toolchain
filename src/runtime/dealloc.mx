package runtime

import "unsafe"

// Free explicitly frees a heap-allocated value.
// The compiler emits calls to runtime.free at scope exit points.
func Free(ptr unsafe.Pointer) {
	free(ptr)
}

// scopeFreeTo is a backward-compat stub for binaries built before GC exorcism.
// Old stage4 compilers emit calls to this symbol at scope boundaries.
//
//export runtime.scopeFreeTo
func scopeFreeTo(tag int32) {}
