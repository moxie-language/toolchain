//:build !alloc_trace

package runtime

// logAlloc is the untagged counterpart of the instrumented implementation in
// alloc_trace.mx. -print-allocs emits calls to it in every build, so the
// compiler does not need to know which runtime files a build selects; without
// the alloc_trace tag there is nothing to count and no tables to read.
func logAlloc(siteID int32, size uintptr) {
}

// PrintAllocCounters prints the per-site counts in an instrumented build.
// Without the alloc_trace tag there is nothing to print, but the function
// exists so a program can call it unconditionally.
func PrintAllocCounters() {
}
