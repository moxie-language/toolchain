package runtime

// This file implements compiler builtins for slices: copy(), push(),
// and the | concatenation operator. push is the ONLY way to write
// elements into a slice. It grows geometrically on overflow (see
// slicePush); a slice that must not grow is presized with []T{:n} and
// written through a cursor.

import (
	"unsafe"
)

// Builtin copy(dst, src) function: copy bytes from dst to src.
func sliceCopy(dst, src unsafe.Pointer, dstLen, srcLen uintptr, elemSize uintptr) int32 {
	// n = min(srcLen, dstLen)
	n := srcLen
	if n > dstLen {
		n = dstLen
	}
	memmove(dst, src, n*elemSize)
	return int32(n)
}

// slicePush handles push() builtin.
//
// Nil slice: lazy-init with capacity for the first push batch (min 4).
// Non-nil overflow (len+n > cap): reallocate with geometric growth. The
// abandoned backing stays in the arena that allocated it, and that arena
// decides whether that is a leak: a function frame arena releases it at
// return, and a sovereign receiver's arena records it as dead so the group's
// compaction (codecSovereignCompact) reclaims it - which is why growth is
// acceptable there. Only a bare package-level slice accumulates its abandoned
// backings in the root arena, which is never reclaimed; an accumulator that
// must survive many appends belongs in a self-mutating holder so its arena
// compacts, or must be presized.
//
// Making overflow panic instead (c8fb6a2b, re-applied by d93685c1) turned
// every dynamic accumulator in the app into a crash the moment its code path
// ran: the browser client's signerCBs, the feed/notif/profile workers, and
// nostr Tags.GetAll all push into lists whose size is unknowable at
// declaration time.
func slicePush(ptr unsafe.Pointer, slen, scap, n, elemSize uintptr) (unsafe.Pointer, uintptr, uintptr) {
	newLen := slen + n
	if scap == 0 {
		// Lazy init: capacity for the first push batch.
		scap = n
		if scap < 4 {
			scap = 4
		}
		ptr = alloc(scap*elemSize, nil)
		return ptr, newLen, scap
	}
	if newLen <= scap {
		return ptr, newLen, scap
	}
	for newLen > scap {
		newCap := scap * 2
		if newCap < 4 {
			newCap = 4
		}
		scap = newCap
	}
	newPtr := alloc(scap*elemSize, nil)
	memmove(newPtr, ptr, slen*elemSize)
	return newPtr, newLen, scap
}

// sliceConcat concatenates two slices (the | operator on arbitrary slice
// types). When x is empty and has capacity, the result is written into
// x's backing (the append-into-buffer idiom). Otherwise allocates a fresh
// buffer of exactly len(x)+len(y) elements and copies both halves.
func sliceConcat(xPtr, yPtr unsafe.Pointer, xLen, yLen, xCap, elemSize uintptr) (unsafe.Pointer, uintptr, uintptr) {
	newLen := xLen + yLen
	if newLen == 0 {
		return nil, 0, 0
	}
	if xLen == 0 && xCap >= newLen {
		if yLen > 0 {
			memmove(xPtr, yPtr, yLen*elemSize)
		}
		return xPtr, newLen, xCap
	}
	buf := alloc(newLen*elemSize, nil)
	if xLen > 0 {
		memmove(buf, xPtr, xLen*elemSize)
	}
	if yLen > 0 {
		memmove(unsafe.Add(buf, xLen*elemSize), yPtr, yLen*elemSize)
	}
	return buf, newLen, newLen
}
