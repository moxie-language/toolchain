package runtime

// This file implements compiler builtins for slices: copy(), push(),
// and the | concatenation operator. push is the ONLY way to write
// elements into a slice. It never grows: reaching the end of a slice's
// capacity panics. To extend a slice, allocate a new backing array with
// the required capacity, copy the old data, and assign the new slice.

import (
	"unsafe"
)

// Builtin copy(dst, src) function: copy bytes from dst to src.
func sliceCopy(dst, src unsafe.Pointer, dstLen, srcLen uintptr, elemSize uintptr) int32 {
	// n = min(srcLen, dstLen)
	n := srcLen
	if n > dstLen {
		n = dstLen
	}
	memmove(dst, src, n*elemSize)
	return int32(n)
}

// slicePush handles push() builtin.
//
// push(s, v...) writes elements at len; if the slice is nil it is
// lazily initialized to the exact capacity needed (min 4 elements).
// Once a slice has been initialized, writing past its capacity panics:
// there is no automatic growth. To extend a slice beyond its capacity,
// allocate a new backing array and copy.
func slicePush(ptr unsafe.Pointer, slen, scap, n, elemSize uintptr) (unsafe.Pointer, uintptr, uintptr) {
	newLen := slen + n
	if scap == 0 {
		// Lazy init: exact capacity for the first push batch.
		scap = n
		if scap < 4 {
			scap = 4
		}
		ptr = alloc(scap*elemSize, nil)
		return ptr, newLen, scap
	}
	if newLen > scap {
		runtimePanicAt(returnAddress(0), "slice: push past end of slice capacity")
	}
	return ptr, newLen, scap
}

// sliceConcat concatenates two slices (the | operator on arbitrary slice
// types). Allocates a fresh buffer of exactly len(x)+len(y) elements and
// copies both halves. No growth, no reuse of input buffers.
func sliceConcat(xPtr, yPtr unsafe.Pointer, xLen, yLen, elemSize uintptr) (unsafe.Pointer, uintptr, uintptr) {
	newLen := xLen + yLen
	if newLen == 0 {
		return nil, 0, 0
	}
	buf := alloc(newLen*elemSize, nil)
	if xLen > 0 {
		memmove(buf, xPtr, xLen*elemSize)
	}
	if yLen > 0 {
		memmove(unsafe.Add(buf, xLen*elemSize), yPtr, yLen*elemSize)
	}
	return buf, newLen, newLen
}
