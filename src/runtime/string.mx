package runtime

// This file implements functions related to Go strings.

import (
	"unsafe"
)

// The underlying struct for the Go string type.
// Moxie: 3-word struct matching []byte layout (ptr, len, cap).
type _string struct {
	ptr    *byte
	length uintptr
	cap    uintptr
}

// The iterator state for a range over a string.
type stringIterator struct {
	byteindex uintptr
}

// Return true iff the strings match.
//
// If either operand's backing pointer lives inside a registered secure
// allocation, the comparison is promoted to a constant-time walk of the
// full length. Otherwise the fast first-mismatch-escape path is used.
// Pointer-based detection: a subslice of a secure slice is secure because
// its pointer is still inside the arena. A heap copy of a secure slice is
// NOT secure - callers who need to preserve constant-time semantics across
// a copy must allocate the destination with SecureAlloc.
//
//:nobounds
func stringEqual(x, y string) bool {
	if len(x) != len(y) {
		return false
	}
	if len(x) == 0 {
		return true
	}
	xPtr := unsafe.Pointer((*_string)(unsafe.Pointer(&x)).ptr)
	yPtr := unsafe.Pointer((*_string)(unsafe.Pointer(&y)).ptr)
	if isSecurePtr(xPtr) || isSecurePtr(yPtr) {
		return memequalCT(xPtr, yPtr, uintptr(len(x)))
	}
	for i := 0; i < len(x); i++ {
		if x[i] != y[i] {
			return false
		}
	}
	return true
}

// sliceEqual compares two slices of any comparable element type.
// Checks lengths first, then compares raw memory (elemSize * length bytes).
func sliceEqual(xPtr, yPtr unsafe.Pointer, xLen, yLen, elemSize uintptr) bool {
	if xLen != yLen {
		return false
	}
	if xLen == 0 {
		return true
	}
	return memequal(xPtr, yPtr, xLen*elemSize)
}

// Return true iff x < y.
//
// Secure-aware: if either operand is in a registered secure arena, the
// comparison is promoted to a constant-time lex compare that walks the full
// min-length without early exit.
//
//:nobounds
func stringLess(x, y string) bool {
	if len(x) > 0 && len(y) > 0 {
		xPtr := unsafe.Pointer((*_string)(unsafe.Pointer(&x)).ptr)
		yPtr := unsafe.Pointer((*_string)(unsafe.Pointer(&y)).ptr)
		if isSecurePtr(xPtr) || isSecurePtr(yPtr) {
			return memcompareCT(xPtr, uintptr(len(x)), yPtr, uintptr(len(y))) < 0
		}
	}
	l := len(x)
	if m := len(y); m < l {
		l = m
	}
	for i := 0; i < l; i++ {
		if x[i] < y[i] {
			return true
		}
		if x[i] > y[i] {
			return false
		}
	}
	return len(x) < len(y)
}

// Concatenate two strings. Always allocates a fresh buffer - no shared backing.
func stringConcat(x, y _string) _string {
	if x.length == 0 && y.length == 0 {
		return _string{}
	}
	length := x.length + y.length
	buf := alloc(length, nil, nil)
	if x.length > 0 {
		memcpy(buf, unsafe.Pointer(x.ptr), x.length)
	}
	if y.length > 0 {
		memcpy(unsafe.Add(buf, x.length), unsafe.Pointer(y.ptr), y.length)
	}
	return _string{ptr: (*byte)(buf), length: length, cap: length}
}

// Concatenate two byte slices. Used for | pipe concat.
//
// Secure-aware: if either operand is in a registered secure arena, the
// destination is allocated via SecureAlloc so the concatenated result
// inherits guard-page + wipe protection and its pointer lives inside a
// registered arena (so subsequent comparisons promote to constant-time).
// bytesConcat: borrow semantics (z := x | y). When x is empty and has
// capacity, the result is written into x's backing (the append-into-
// buffer idiom, e.g. Sum(dst[:0])). Otherwise allocates a new buffer with
// 2x capacity so subsequent move-concats in a chain can extend in place.
func bytesConcat(x, y []byte) []byte {
	if len(x) == 0 && len(y) == 0 {
		return nil
	}
	needed := len(x) + len(y)
	if len(x) == 0 && cap(x) >= needed {
		if len(y) > 0 {
			xPtr := unsafe.Pointer((*_string)(unsafe.Pointer(&x)).ptr)
			yPtr := unsafe.Pointer((*_string)(unsafe.Pointer(&y)).ptr)
			memmove(xPtr, yPtr, uintptr(len(y)))
		}
		return x[:needed]
	}
	length := needed
	bufCap := uintptr(length) * 2
	if bufCap < 64 {
		bufCap = 64
	}
	buf := alloc(bufCap, nil, nil)
	if len(x) > 0 {
		memcpy(buf, unsafe.Pointer(&x[0]), uintptr(len(x)))
	}
	if len(y) > 0 {
		memcpy(unsafe.Add(buf, uintptr(len(x))),
			unsafe.Pointer(&y[0]), uintptr(len(y)))
	}
	return unsafe.Slice((*byte)(buf), int32(bufCap))[:int32(length)]
}

// bytesConcatMove: move semantics (x = x | y / x |= y). Extends x
// in place if capacity allows. Otherwise grows via sliceGrow which
// frees the old buffer. x is consumed - caller must not use old x.
func bytesConcatMove(x, y []byte) []byte {
	if len(y) == 0 {
		return x
	}
	if len(x) == 0 {
		// Fresh copy so result owns its buffer.
		result := unsafe.Slice((*byte)(alloc(uintptr(len(y)), nil, nil)), int32(len(y)))
		memcpy(unsafe.Pointer(&result[0]), unsafe.Pointer(&y[0]), uintptr(len(y)))
		return result
	}
	needed := len(x) + len(y)
	xBuf := unsafe.Pointer(&x[0])
	yBuf := unsafe.Pointer(&y[0])
	if cap(x) >= needed {
		memmove(unsafe.Add(xBuf, uintptr(len(x))), yBuf, uintptr(len(y)))
		return x[:needed]
	}
	// No growth: allocate a fresh buffer of exactly the needed capacity,
	// copy both halves. Old buffer is left to the arena.
	buf := alloc(uintptr(needed), nil, nil)
	memcpy(buf, xBuf, uintptr(len(x)))
	memcpy(unsafe.Add(buf, uintptr(len(x))), yBuf, uintptr(len(y)))
	return unsafe.Slice((*byte)(buf), int32(needed))
}


// Convert a []rune slice to a string.
func stringFromRunes(runeSlice []rune) (s _string) {
	// Count the number of characters that will be in the string.
	for _, r := range runeSlice {
		s.length += uintptr(utf8Len(r))
	}
	s.cap = s.length

	// Allocate memory for the string.
	s.ptr = (*byte)(alloc(s.length, nil, nil))

	// Encode runes to UTF-8 straight into it.
	dst := unsafe.Slice(s.ptr, int32(s.length))
	off := int32(0)
	for _, r := range runeSlice {
		off += encodeUTF8At(dst, off, r)
	}

	return
}

// Convert a string to []rune slice.
//
// A Moxie string is []byte, so `for range s` walks BYTES; the conversion is
// over code points, so every step decodes one UTF-8 sequence. Reading the bytes
// directly made []rune("aüc") four runes long (one per byte) with the second
// value 0xC3 - the lead byte of ü - instead of three runes ending in 0xFC.
func stringToRunes(s string) []int32 {
	n := int32(0)
	for i := uintptr(0); i < uintptr(len(s)); {
		_, w := decodeUTF8(s, i)
		i += w
		n++
	}
	r := []int32{:n}
	j := int32(0)
	for i := uintptr(0); i < uintptr(len(s)); {
		ru, w := decodeUTF8(s, i)
		r[j] = int32(ru)
		j++
		i += w
	}
	return r
}

// Create a string from a Unicode code point.
func stringFromUnicode(x rune) _string {
	length := utf8Len(x)
	buf := alloc(uintptr(length), nil, nil)
	dst := unsafe.Slice((*byte)(buf), length)
	encodeUTF8At(dst, 0, x)
	return _string{ptr: (*byte)(buf), length: uintptr(length), cap: uintptr(length)}
}

// Iterate over a string.
// Returns (ok, key, value).
func stringNext(s string, it *stringIterator) (bool, int32, rune) {
	if len(s) <= int32(it.byteindex) {
		return false, 0, 0
	}
	i := int32(it.byteindex)
	r, length := decodeUTF8(s, it.byteindex)
	it.byteindex += length
	return true, i, r
}

// utf8Len is the number of bytes encodeUTF8At writes for x.
func utf8Len(x rune) (n int32) {
	switch {
	case x <= 0x7f:
		return 1
	case x <= 0x7ff:
		return 2
	case 0xd800 <= x && x <= 0xdfff:
		// utf-16 surrogates are replaced with "invalid code point"
		return 3
	case x <= 0xffff:
		return 3
	case x <= 0x10ffff:
		return 4
	}
	// Invalid Unicode code point.
	return 3
}

// encodeUTF8At writes the UTF-8 encoding of x at off in dst and returns the
// number of bytes written. dst must have room for four bytes at off.
//
// This used to RETURN a [4]byte. A fixed extent is a slice header in Moxie, so
// that spelling was an array type in the runtime's hottest path AND a copy per
// code point; writing into the destination the caller already owns is the same
// work minus the copy. Written at an offset rather than through dst[off:] for
// the plain reason that a sub-slice is a copy in Moxie.
func encodeUTF8At(dst []byte, off int32, x rune) (n int32) {
	switch {
	case x <= 0x7f:
		dst[off] = byte(x)
		return 1
	case x <= 0x7ff:
		dst[off] = 0xc0 | byte(x>>6)
		dst[off+1] = 0x80 | byte(x&0x3f)
		return 2
	case 0xd800 <= x && x <= 0xdfff:
		dst[off] = 0xef
		dst[off+1] = 0xbf
		dst[off+2] = 0xbd
		return 3
	case x <= 0xffff:
		dst[off] = 0xe0 | byte(x>>12)
		dst[off+1] = 0x80 | byte((x>>6)&0x3f)
		dst[off+2] = 0x80 | byte(x&0x3f)
		return 3
	case x <= 0x10ffff:
		dst[off] = 0xf0 | byte(x>>18)
		dst[off+1] = 0x80 | byte((x>>12)&0x3f)
		dst[off+2] = 0x80 | byte((x>>6)&0x3f)
		dst[off+3] = 0x80 | byte(x&0x3f)
		return 4
	}
	// Invalid Unicode code point.
	dst[off] = 0xef
	dst[off+1] = 0xbf
	dst[off+2] = 0xbd
	return 3
}

// Decode a single UTF-8 character from a string.
//
//:nobounds
func decodeUTF8(s string, index uintptr) (rune, uintptr) {
	remaining := uintptr(len(s)) - index // must be >= 1 before calling this function
	x := s[index]
	switch {
	case x&0x80 == 0x00: // 0xxxxxxx
		return rune(x), 1
	case x&0xe0 == 0xc0: // 110xxxxx
		if remaining < 2 || !isContinuation(s[index+1]) {
			return 0xfffd, 1
		}
		r := (rune(x&0x1f) << 6) | (rune(s[index+1]) & 0x3f)
		if r >= 1<<7 {
			// Check whether the rune really needed to be encoded as a two-byte
			// sequence. UTF-8 requires every rune to be encoded in the smallest
			// sequence possible.
			return r, 2
		}
	case x&0xf0 == 0xe0: // 1110xxxx
		if remaining < 3 || !isContinuation(s[index+1]) || !isContinuation(s[index+2]) {
			return 0xfffd, 1
		}
		r := (rune(x&0x0f) << 12) | ((rune(s[index+1]) & 0x3f) << 6) | (rune(s[index+2]) & 0x3f)
		if r >= 1<<11 && !(r >= 0xD800 && r <= 0xDFFF) {
			// Check whether the rune really needed to be encoded as a
			// three-byte sequence and check that this is not a Unicode
			// surrogate pair (which are not allowed by UTF-8).
			return r, 3
		}
	case x&0xf8 == 0xf0: // 11110xxx
		if remaining < 4 || !isContinuation(s[index+1]) || !isContinuation(s[index+2]) || !isContinuation(s[index+3]) {
			return 0xfffd, 1
		}
		r := (rune(x&0x07) << 18) | ((rune(s[index+1]) & 0x3f) << 12) | ((rune(s[index+2]) & 0x3f) << 6) | (rune(s[index+3]) & 0x3f)
		if r >= 1<<16 && r <= '\U0010FFFF' {
			// Check whether this rune really needed to be encoded as a four
			// byte sequence and check that the resulting rune is in the valid
			// range (up to at most U+10FFFF).
			return r, 4
		}
	}

	// Failed to decode. Return the Unicode replacement character and a length of 1.
	return 0xfffd, 1
}

// isContinuation returns true if (and only if) this is a UTF-8 continuation
// byte.
func isContinuation(b byte) bool {
	// Continuation bytes have their topmost bits set to 0b10.
	return b&0xc0 == 0x80
}

// Functions used in CGo.

// Convert a Go string to a C string.
func cgo_CString(s _string) unsafe.Pointer {
	buf := malloc(s.length + 1)
	memcpy(buf, unsafe.Pointer(s.ptr), s.length)
	*(*byte)(unsafe.Add(buf, s.length)) = 0 // trailing 0 byte
	return buf
}

// Convert a C string to a Go string.
func cgo_GoString(cstr unsafe.Pointer) _string {
	if cstr == nil {
		return _string{}
	}
	return makeGoString(cstr, strlen(cstr))
}

// Convert a C data buffer to a Go string (that possibly contains 0 bytes).
func cgo_GoStringN(cstr unsafe.Pointer, length uintptr) _string {
	return makeGoString(cstr, length)
}

// Make a Go string given a source buffer and a length.
func makeGoString(cstr unsafe.Pointer, length uintptr) _string {
	s := _string{
		length: length,
		cap:    length,
	}
	if s.length != 0 {
		buf := []byte{:s.length}
		s.ptr = &buf[0]
		memcpy(unsafe.Pointer(s.ptr), cstr, s.length)
	}
	return s
}

// Convert a C data buffer to a Go byte slice.
func cgo_GoBytes(ptr unsafe.Pointer, length uintptr) []byte {
	// Note: don't return nil if length is 0, to match the behavior of C.GoBytes
	// of upstream Go.
	buf := []byte{:length}
	if length != 0 {
		memcpy(unsafe.Pointer(&buf[0]), ptr, uintptr(length))
	}
	return buf
}

func cgo_CBytes(b []byte) unsafe.Pointer {
	p := malloc(uintptr(len(b)))
	s := unsafe.Slice((*byte)(p), len(b))
	copy(s, b)
	return p
}
