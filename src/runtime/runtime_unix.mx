//:build linux && !baremetal

package runtime

import (
	"moxielang.dev/pkg/mxutil"
	"array"
	"moxie"
	"unsafe"
)

type futex struct {
	v uint32
}

func (f *futex) Swap(new uint32) (r0 uint32) {
	old := f.v
	f.v = new
	return old
}

func (f *futex) Wait(cmp uint32) {
	moxie_futex_wait((*uint32)(unsafe.Pointer(&f.v)), cmp)
}

func (f *futex) WaitUntil(cmp uint32, timeout uint64) {
	moxie_futex_wait_timeout((*uint32)(unsafe.Pointer(&f.v)), cmp, timeout)
}

func (f *futex) WakeAll() {
	moxie_futex_wake_all((*uint32)(unsafe.Pointer(&f.v)))
}

// WaitUntilShared parks on a word inside MAP_SHARED memory. The private
// variants above carry FUTEX_PRIVATE_FLAG, which keys the wait queue per mm,
// so a wake from a forked child can never reach a parent's wait (and vice
// versa). Every word that crosses a spawn boundary must use these.
func (f *futex) WaitUntilShared(cmp uint32, timeout uint64) {
	moxie_futex_wait_timeout_shared((*uint32)(unsafe.Pointer(&f.v)), cmp, timeout)
}

func (f *futex) WakeAllShared() {
	moxie_futex_wake_all_shared((*uint32)(unsafe.Pointer(&f.v)))
}

