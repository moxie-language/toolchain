//export clock_gettime
func libc_clock_gettime(clk_id int32, ts *timespec)

func clock_gettime(clk_id int32, ts *timespec) {
	libc_clock_gettime(clk_id, ts)
}

// Note: tv_sec and tv_nsec normally vary in size by platform. However, we're
// using the time64 variant (see clock_gettime above), so the formats are the
// same between 32-bit and 64-bit architectures.
// There is one issue though: on big-endian systems, tv_nsec would be incorrect.
// But we don't support big-endian systems yet (as of 2021) so this is fine.
type timespec struct {
	tv_sec  int64 // time_t with time64 support (always 64-bit)
	tv_nsec int64 // unsigned 64-bit integer on all time64 platforms
}

// Highest address of the stack of the main thread.
var stackTop uintptr

// RefreshStackTop captures the current stack pointer as the stack top.
func RefreshStackTop() {
	stackTop = getCurrentStackPointer()
}

var csharedInitDone bool

// InitCShared initializes the runtime for c-shared mode where main() never runs.
// Call once at the start of the first exported function.
func InitCShared() {
	if csharedInitDone {
		return
	}
	csharedInitDone = true
	epfd = -1
	secLockdownFd = 2
	allocateHeap()
	initDomain(256 * 1024 * 1024)
	initRand()
	initAll()
}

// Entry point for Go. Initialize all packages and call main.main().
//
//export main
func main(argc int32, argv *unsafe.Pointer) (r0 int32) {
	// Initialize sentinel values that must differ from zero.
	epfd = -1
	secLockdownFd = 2

	allocateHeap()
	initDomain(256 * 1024 * 1024)

	rl := []uint64{:2}
	libc_getrlimit(3, &rl[0])
	if rl[0] < 268435456 {
		rl[0] = 268435456
		if rl[1] != 0xFFFFFFFFFFFFFFFF && rl[0] > rl[1] {
			rl[0] = rl[1]
		}
		libc_setrlimit(3, &rl[0])
	}

	// Store argc and argv for later use.
	main_argc = argc
	main_argv = argv

	// Register some fatal signals, so that we can print slightly better error
	// messages.
	moxie_register_fatal_signals()

	// The signals that mean "stop" raise a flag the domain polls; it closes
	// its termination channel there, so `shutdown` fires in normal context.
	moxie_shutdown_install()

	// Obtain the initial stack pointer right before calling the run() function.
	// The run function has been moved to a separate (non-inlined) function so
	// that the correct stack pointer is read.
	stackTop = getCurrentStackPointer()
	runMain()

	// For libc compatibility.
	return 0
}

var (
	main_argc int32
	main_argv *unsafe.Pointer
	args      []string
)

//:linkname os_runtime_args os.runtime_args
func os_runtime_args() (r0 []string) {
	if len(args) == 0 {
		args = []string{:main_argc}
		argv := array.At[unsafe.Pointer](unsafe.Pointer(main_argv), main_argc)
		for i := int32(0); i < main_argc; i++ {
			cstr := *argv.Index(i)
			n := strlen(cstr)
			s := []byte{:n}
			memmove(unsafe.Pointer(unsafe.SliceData(s)), cstr, uintptr(n))
			args[i] = string(s)
		}
	}
	return args
}

// Must be a separate function to get the correct stack pointer.
//
//:noinline
func runMain() {
	run()
}

//export moxie_register_fatal_signals
func moxie_register_fatal_signals()

// The stop signals (SIGINT, SIGTERM) raise a flag; the domain closes its
// termination channel at the next point where it waits.
//export moxie_shutdown_install
func moxie_shutdown_install()

//export moxie_shutdown_pending
func moxie_shutdown_pending() int32

func shutdownPending() (ok bool) { return moxie_shutdown_pending() != 0 }

// Print fatal errors when they happen, including the instruction location.
// With the particular formatting below, `moxie run` can extract the location
// where the signal happened and try to show the source location based on DWARF
// information.
//
//export moxie_handle_fatal_signal
func moxie_handle_fatal_signal(sig int32, addr uintptr) {
	if panicStrategy() == moxie.PanicStrategyTrap {
		trap()
	}

	// Print signal including the faulting instruction.
	if addr != 0 {
		printstring("panic: runtime error at ")
		printptr(addr)
	} else {
		printstring("panic: runtime error")
	}
	printstring(": caught signal ")
	switch sig {
	case sig_SIGBUS:
		println("SIGBUS")
	case sig_SIGILL:
		println("SIGILL")
	case sig_SIGSEGV:
		println("SIGSEGV")
	default:
		println(sig)
	}

	// TODO: it might be interesting to also print the invalid address for
	// SIGSEGV and SIGBUS.

	// Do *not* abort here, instead raise the same signal again. The signal is
	// registered with SA_RESETHAND which means it executes only once. So when
	// we raise the signal again below, the signal isn't handled specially but
	// is handled in the default way (probably exiting the process, maybe with a
	// core dump).
	raise(sig)
}

//:extern environ
var environ *unsafe.Pointer

//:linkname syscall_runtime_envs syscall.runtime_envs
func syscall_runtime_envs() (r0 []string) {
	// Count how many environment variables there are.
	envArr := array.At[unsafe.Pointer](unsafe.Pointer(environ), 0)
	numEnvs := 0
	for *envArr.Index(numEnvs) != nil {
		numEnvs++
	}

	// Create a string slice of all environment variables.
	envs := []string{:0:numEnvs}
	for i := 0; i < numEnvs; i++ {
		ptr := *envArr.Index(i)
		length := strlen(ptr)
		s := _string{
			ptr:    (*byte)(ptr),
			length: length,
			cap:    length,
		}
		envs = mxutil.Ensure(envs, 1)
		push(envs, *(*string)(unsafe.Pointer(&s)))
	}

	return envs
}

// putcharBuf is ONE byte: the putchar staging cell. It was a [1]byte, which is
// a slice header where the kernel expects a byte.
var putcharBuf byte

func putchar(c byte) {
	putcharBuf = c
	libc_write(printFD, unsafe.Pointer(&putcharBuf), 1)
}

func ticksToNanoseconds(t timeUnit) (r0 int64) {
	// The OS API works in nanoseconds so no conversion necessary.
	return int64(t)
}

func nanosecondsToTicks(ns int64) (r0 timeUnit) {
	// The OS API works in nanoseconds so no conversion necessary.
	return timeUnit(ns)
}

func sleepTicks(d timeUnit) {
	until := ticks() + d

	for {
		if hasPoll {
			// Use epoll_wait instead of futex so I/O-parked goroutines
			// (e.g. Accept) get woken during timer sleeps.
			ms := int32(ticksToNanoseconds(d) / 1000000)
			if ms < 1 {
				ms = 1
			}
			netpollBlock(ms)
		} else {
			// No netpoller: sleep on a futex nobody wakes - it is a timer.
			sleepFutex.WaitUntil(0, uint64(ticksToNanoseconds(d)))
		}

		// Set duration (in next loop iteration) to the remaining time.
		d = until - ticks()
		if d <= 0 {
			return
		}
	}
}

// clockScratch is the timespec the clock readers write into.
//
// A local `timespec{}` whose address is passed to clock_gettime has an escaping
// address, so the compiler allocates it through runtime.alloc on every clock
// read - two arena allocations per time.Now (wall and monotonic). One domain is
// one thread, so a package-level scratch cannot be raced; it is per-process, and
// spawn forks.
var clockScratch timespec

func getTime(clock int32) (r0 uint64) {
	clock_gettime(clock, &clockScratch)
	return uint64(clockScratch.tv_sec)*1000*1000*1000 + uint64(clockScratch.tv_nsec)
}

// Return monotonic time in nanoseconds.
func monotime() (r0 uint64) {
	return getTime(clock_MONOTONIC_RAW)
}

func ticks() (r0 timeUnit) {
	return timeUnit(monotime())
}

//:linkname now time.now
func now() (sec int64, nsec int32, mono int64) {
	clock_gettime(clock_REALTIME, &clockScratch)
	sec = int64(clockScratch.tv_sec)
	nsec = int32(clockScratch.tv_nsec)
	mono = nanotime()
	return
}

//:linkname syscall_Exit syscall.Exit
func syscall_Exit(code int32) {
	coverBeforeExit()
	exit(code)
}

// procPin/procUnpin: no-ops, defined directly in sync/atomic.

func allocateHeap() {
	// No-op: heap is removed. Arena only.
}
// sleepFutex is the no-netpoller timer: WaitUntil times it out and nothing
// wakes it, so it is a sleep with a deadline.
var sleepFutex futex

func waitForEvents() {
	if hasPoll {
		// Block on epoll (100ms timeout) to avoid busy-spinning.
		netpollBlock(100)
		return
	}
	runtimePanic("deadlocked: no event source")
}

// --- Arena memory mapping ---

// arenaChainCap is the capacity a chained (overflow) arena region asks for.
// Native maps are virtual and overcommitted, so a large granule costs nothing
// until it is touched and saves the mapping churn.
func arenaChainCap() (n uintptr) {
	return arenaDefaultRegion
}

// sysMap returns a zeroed, page-aligned region of size bytes, or nil on
// failure. Anonymous private memory: the caller owns it outright.
//
// The arena allocator needs a single primitive that both platforms can
// provide. Native pages come from mmap; wasm derives them from linear
// memory growth.
func sysMap(size uintptr) unsafe.Pointer {
	p := mmap(nil, size, flag_PROT_READ|flag_PROT_WRITE,
		flag_MAP_PRIVATE|flag_MAP_ANONYMOUS, -1, 0)
	if uintptr(p) == ^uintptr(0) {
		return nil
	}
	RecordSysMap(size)
	return p
}

// sysMapShared is sysMap with MAP_SHARED, for memory both sides of a
// process boundary write to. Only meaningful where fork exists.
func sysMapShared(size uintptr) unsafe.Pointer {
	p := mmap(nil, size, flag_PROT_READ|flag_PROT_WRITE,
		flag_MAP_SHARED|flag_MAP_ANONYMOUS, -1, 0)
	if uintptr(p) == ^uintptr(0) {
		return nil
	}
	return p
}

// sysUnmap releases a region from sysMap or sysMapShared.
func sysUnmap(p unsafe.Pointer, size uintptr) {
	RecordSysUnmap(size)
	munmap(p, size)
}
