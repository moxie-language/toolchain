//export clock_gettime
func libc_clock_gettime(clk_id int32, ts *timespec)

func clock_gettime(clk_id int32, ts *timespec) {
	libc_clock_gettime(clk_id, ts)
}

// Note: tv_sec and tv_nsec normally vary in size by platform. However, we're
// using the time64 variant (see clock_gettime above), so the formats are the
// same between 32-bit and 64-bit architectures.
// There is one issue though: on big-endian systems, tv_nsec would be incorrect.
// But we don't support big-endian systems yet (as of 2021) so this is fine.
type timespec struct {
	tv_sec  int64 // time_t with time64 support (always 64-bit)
	tv_nsec int64 // unsigned 64-bit integer on all time64 platforms
}

// Highest address of the stack of the main thread.
var stackTop uintptr

// RefreshStackTop captures the current stack pointer as the stack top.
func RefreshStackTop() {
	stackTop = getCurrentStackPointer()
}

var csharedInitDone bool

// InitCShared initializes the runtime for c-shared mode where main() never runs.
// Call once at the start of the first exported function.
func InitCShared() {
	if csharedInitDone {
		return
	}
	csharedInitDone = true
	epfd = -1
	secLockdownFd = 2
	allocateHeap()
	initDomain(256 * 1024 * 1024)
	initRand()
	initAll()
}

// Entry point for Go. Initialize all packages and call main.main().
//
//export main
func main(argc int32, argv *unsafe.Pointer) (r0 int32) {
	// Initialize sentinel values that must differ from zero.
	epfd = -1
	secLockdownFd = 2

	allocateHeap()
	initDomain(256 * 1024 * 1024)

	var rl [2]uint64
	libc_getrlimit(3, &rl)
	if rl[0] < 268435456 {
		rl[0] = 268435456
		if rl[1] != 0xFFFFFFFFFFFFFFFF && rl[0] > rl[1] {
			rl[0] = rl[1]
		}
		libc_setrlimit(3, &rl)
	}

	// Store argc and argv for later use.
	main_argc = argc
	main_argv = argv

	// Register some fatal signals, so that we can print slightly better error
	// messages.
	moxie_register_fatal_signals()

	// Obtain the initial stack pointer right before calling the run() function.
	// The run function has been moved to a separate (non-inlined) function so
	// that the correct stack pointer is read.
	stackTop = getCurrentStackPointer()
	runMain()

	// For libc compatibility.
	return 0
}

var (
	main_argc int32
	main_argv *unsafe.Pointer
	args      []string
)

//:linkname os_runtime_args os.runtime_args
func os_runtime_args() (r0 []string) {
	if len(args) == 0 {
		args = []string{:main_argc}
		argv := array.At[unsafe.Pointer](unsafe.Pointer(main_argv), main_argc)
		for i := int32(0); i < main_argc; i++ {
			cstr := *argv.Index(i)
			n := strlen(cstr)
			s := []byte{:n}
			memmove(unsafe.Pointer(unsafe.SliceData(s)), cstr, uintptr(n))
			args[i] = string(s)
		}
	}
	return args
}

// Must be a separate function to get the correct stack pointer.
//
//:noinline
func runMain() {
	run()
}

//export moxie_register_fatal_signals
func moxie_register_fatal_signals()

// Print fatal errors when they happen, including the instruction location.
// With the particular formatting below, `moxie run` can extract the location
// where the signal happened and try to show the source location based on DWARF
// information.
//
//export moxie_handle_fatal_signal
func moxie_handle_fatal_signal(sig int32, addr uintptr) {
	if panicStrategy() == moxie.PanicStrategyTrap {
		trap()
	}

	// Print signal including the faulting instruction.
	if addr != 0 {
		printstring("panic: runtime error at ")
		printptr(addr)
	} else {
		printstring("panic: runtime error")
	}
	printstring(": caught signal ")
	switch sig {
	case sig_SIGBUS:
		println("SIGBUS")
	case sig_SIGILL:
		println("SIGILL")
	case sig_SIGSEGV:
		println("SIGSEGV")
	default:
		println(sig)
	}

	// TODO: it might be interesting to also print the invalid address for
	// SIGSEGV and SIGBUS.

	// Do *not* abort here, instead raise the same signal again. The signal is
	// registered with SA_RESETHAND which means it executes only once. So when
	// we raise the signal again below, the signal isn't handled specially but
	// is handled in the default way (probably exiting the process, maybe with a
	// core dump).
	raise(sig)
}

//:extern environ
var environ *unsafe.Pointer

//:linkname syscall_runtime_envs syscall.runtime_envs
func syscall_runtime_envs() (r0 []string) {
	// Count how many environment variables there are.
	envArr := array.At[unsafe.Pointer](unsafe.Pointer(environ), 0)
	numEnvs := 0
	for *envArr.Index(numEnvs) != nil {
		numEnvs++
	}

	// Create a string slice of all environment variables.
	envs := []string{:0:numEnvs}
	for i := 0; i < numEnvs; i++ {
		ptr := *envArr.Index(i)
		length := strlen(ptr)
		s := _string{
			ptr:    (*byte)(ptr),
			length: length,
			cap:    length,
		}
		envs = mxutil.Ensure(envs, 1)
		push(envs, *(*string)(unsafe.Pointer(&s)))
	}

	return envs
}

var putcharBuf [1]byte

func putchar(c byte) {
	putcharBuf[0] = c
	libc_write(1, unsafe.Pointer(&putcharBuf[0]), 1)
}

func ticksToNanoseconds(t timeUnit) (r0 int64) {
	// The OS API works in nanoseconds so no conversion necessary.
	return int64(t)
}

func nanosecondsToTicks(ns int64) (r0 timeUnit) {
	// The OS API works in nanoseconds so no conversion necessary.
	return timeUnit(ns)
}

func sleepTicks(d timeUnit) {
	until := ticks() + d

	for {
		if hasPoll {
			// Use epoll_wait instead of futex so I/O-parked goroutines
			// (e.g. Accept) get woken during timer sleeps.
			ms := int32(ticksToNanoseconds(d) / 1000000)
			if ms < 1 {
				ms = 1
			}
			netpollBlock(ms)
		} else {
			// No netpoller - fall back to futex sleep.
			// If a signal arrived before or during sleep, it exits early.
			signalFutex.WaitUntil(0, uint64(ticksToNanoseconds(d)))
		}

		// Check whether there was a signal before or during the sleep.
		if signalFutex.Swap(0) != 0 {
			if checkSignals() && hasScheduler {
				// We got a signal, so return to the scheduler.
				// (If there is no scheduler, there is no other goroutine that
				// might need to run now).
				return
			}
		}

		// Set duration (in next loop iteration) to the remaining time.
		d = until - ticks()
		if d <= 0 {
			return
		}
	}
}

func getTime(clock int32) (r0 uint64) {
	ts := timespec{}
	clock_gettime(clock, &ts)
	return uint64(ts.tv_sec)*1000*1000*1000 + uint64(ts.tv_nsec)
}

// Return monotonic time in nanoseconds.
func monotime() (r0 uint64) {
	return getTime(clock_MONOTONIC_RAW)
}

func ticks() (r0 timeUnit) {
	return timeUnit(monotime())
}

//:linkname now time.now
func now() (sec int64, nsec int32, mono int64) {
	ts := timespec{}
	clock_gettime(clock_REALTIME, &ts)
	sec = int64(ts.tv_sec)
	nsec = int32(ts.tv_nsec)
	mono = nanotime()
	return
}

//:linkname syscall_Exit syscall.Exit
func syscall_Exit(code int32) {
	exit(code)
}

// procPin/procUnpin: no-ops, defined directly in sync/atomic.

func allocateHeap() {
	// No-op: heap is removed. Arena only.
}

// Indicate whether signals have been registered.
var hasSignals bool

// Futex for the signal handler.
// The value is 0 when there are no new signals, or 1 when there are unhandled
// signals and the main thread doesn't know about it yet.
// When a signal arrives, the futex value is changed to 1 and if it was 0
// before, all waiters are awoken.
// When a wait exits, the value is changed to 0 and if it wasn't 0 before, the
// signals are checked.
var signalFutex futex

// Mask of signals that have been received. The signal handler atomically ORs
// signals into this value.
var receivedSignals uint32

//:linkname signal_enable os/signal.signal_enable
func signal_enable(s uint32) {
	if s >= 32 {
		// TODO: to support higher signal numbers, we need to turn
		// receivedSignals into a uint32 array.
		runtimePanicAt(returnAddress(0), "unsupported signal number")
	}

	// This is intentonally a non-atomic store. This is safe, since hasSignals
	// is only used in waitForEvents which is only called when there's a
	// scheduler (and therefore there is no parallelism).
	hasSignals = true

	// It's easier to implement this function in C.
	moxie_signal_enable(s)
}

//:linkname signal_ignore os/signal.signal_ignore
func signal_ignore(s uint32) {
	if s >= 32 {
		// TODO: to support higher signal numbers, we need to turn
		// receivedSignals into a uint32 array.
		runtimePanicAt(returnAddress(0), "unsupported signal number")
	}
	moxie_signal_ignore(s)
}

//:linkname signal_disable os/signal.signal_disable
func signal_disable(s uint32) {
	if s >= 32 {
		// TODO: to support higher signal numbers, we need to turn
		// receivedSignals into a uint32 array.
		runtimePanicAt(returnAddress(0), "unsupported signal number")
	}
	moxie_signal_disable(s)
}

//:linkname signal_waitUntilIdle os/signal.signalWaitUntilIdle
func signal_waitUntilIdle() {
	// Wait until signal_recv has processed all signals.
	for receivedSignals != 0 {
		// TODO: this becomes a busy loop when using threads.
		// We might want to pause until signal_recv has no more incoming signals
		// to process.
		Gosched()
	}
}

//export moxie_signal_enable
func moxie_signal_enable(s uint32)

//export moxie_signal_ignore
func moxie_signal_ignore(s uint32)

//export moxie_signal_disable
func moxie_signal_disable(s uint32)

// void moxie_signal_handler(int32 sig);
//
//export moxie_signal_handler
func moxie_signal_handler(s int32) {
	receivedSignals |= uint32(1) << uint32(s)

	// Notify the main thread that there was a signal.
	// This will exit the call to Wait or WaitUntil early.
	if signalFutex.Swap(1) == 0 {
		// Changed from 0 to 1, so there may have been a waiting goroutine.
		// This could be optimized to avoid a syscall when there are no waiting
		// goroutines.
		signalFutex.WakeAll()
	}
}

// Task waiting for a signal to arrive, or nil if it is running or there are no
// signals.
var signalRecvWaiter *task.Task

//:linkname signal_recv os/signal.signal_recv
func signal_recv() (r0 uint32) {
	// Function called from os/signal to get the next received signal.
	for {
		if receivedSignals == 0 {
			old := signalRecvWaiter
			signalRecvWaiter = task.Current()
			if old != nil {
				runtimePanic("signal_recv called concurrently")
			}
			task.Pause()
			continue
		}

		num := uint32(bits.TrailingZeros32(receivedSignals))
		receivedSignals &^= 1 << num

		return num
	}
}

// Reactivate the goroutine waiting for signals, if there are any.
// Return true if it was reactivated (and therefore the scheduler should run
// again), and false otherwise.
func checkSignals() (r0 bool) {
	if receivedSignals != 0 {
		waiter := signalRecvWaiter
		signalRecvWaiter = nil
		if waiter != nil {
			scheduleTask(waiter)
			return true
		}
	}
	return false
}

func waitForEvents() {
	if hasPoll {
		// Block on epoll (100ms timeout) to avoid busy-spinning.
		netpollBlock(100)
		// Also check signals if applicable.
		if hasSignals && signalFutex.Swap(0) != 0 {
			checkSignals()
		}
		return
	}
	if hasSignals {
		signalFutex.Wait(0)
		if signalFutex.Swap(0) != 0 {
			checkSignals()
		}
	} else {
		runtimePanic("deadlocked: no event source")
	}
}

// --- Arena memory mapping ---

// sysMap returns a zeroed, page-aligned region of size bytes, or nil on
// failure. Anonymous private memory: the caller owns it outright.
//
// The arena allocator needs a single primitive that both platforms can
// provide. Native pages come from mmap; wasm derives them from linear
// memory growth.
// TEMPORARY build-memory instrumentation: live mapping count and bytes, so a
// leak can be attributed to a mapping instead of inferred.
var dbgMapLive int32
var dbgMapBytes int64

// DbMapLive reports the number of live arena mappings and their total bytes.
func DbMapLive() (n int32, bytes int64) { return dbgMapLive, dbgMapBytes }

// Arena lifecycle counters, temporary.
var dbgArenaNew int32
var dbgArenaFree int32
var dbgArenaRelease int32
var dbgArenaReset int32
var dbgArenaAcquire int32
var dbgArenaPooled int32
var dbgSovAcq int32
var dbgSovFree int32

// DbArenaCounters reports arena lifecycle totals.
func DbArenaCounters() (nw, fr, rel, rst, acq, pooled, sovNew, sovFree int32) {
	return dbgArenaNew, dbgArenaFree, dbgArenaRelease, dbgArenaReset, dbgArenaAcquire, dbgArenaPooled, dbgSovAcq, dbgSovFree
}

// Sovereign-group lifecycle counters, temporary.
var dbgSovNewGroups int32
var dbgSovCtxNil int32
var dbgSovInvalCalls int32
var dbgSovInvalEarly int32
var dbgSovInvalListed int32
var dbgSovInvalSkip int32
var dbgSovInvalFreed int32

// Where unattributed receivers live: root arena, current arena, or nowhere
// on the frame stack.
var dbgSovNilRoot int32
var dbgSovNilCur int32
var dbgSovNilNone int32
var dbgSovNilOther int32

// DbSovNilCounters reports the location split for unattributed receivers.
func DbSovNilCounters() (inRoot, inCur, noWhere, other int32) {
	return dbgSovNilRoot, dbgSovNilCur, dbgSovNilNone, dbgSovNilOther
}

// DbSovNilBump increments one unattributed-location counter (1..4).
func DbSovNilBump(which int32) {
	switch which {
	case 1:
		dbgSovNilRoot++
	case 2:
		dbgSovNilCur++
	case 3:
		dbgSovNilNone++
	case 4:
		dbgSovNilOther++
	}
}

// DbSovCounters reports sovereign-group lifecycle totals.
func DbSovCounters() (newG, ctxNil, invalCalls, invalEarly, invalListed, invalSkip, invalFreed int32) {
	return dbgSovNewGroups, dbgSovCtxNil, dbgSovInvalCalls, dbgSovInvalEarly, dbgSovInvalListed, dbgSovInvalSkip, dbgSovInvalFreed
}

// DbSovBump increments one sovereign counter by name (1..7).
func DbSovBump(which int32) {
	switch which {
	case 1:
		dbgSovNewGroups++
	case 2:
		dbgSovCtxNil++
	case 3:
		dbgSovInvalCalls++
	case 4:
		dbgSovInvalEarly++
	case 5:
		dbgSovInvalListed++
	case 6:
		dbgSovInvalSkip++
	case 7:
		dbgSovInvalFreed++
	}
}

// DbArenaBump increments one lifecycle counter by name (1..8).
func DbArenaBump(which int32) {
	switch which {
	case 1:
		dbgArenaNew++
	case 2:
		dbgArenaFree++
	case 3:
		dbgArenaRelease++
	case 4:
		dbgArenaReset++
	case 5:
		dbgArenaAcquire++
	case 6:
		dbgArenaPooled++
	case 7:
		dbgSovAcq++
	case 8:
		dbgSovFree++
	}
}

func sysMap(size uintptr) unsafe.Pointer {
	p := mmap(nil, size, flag_PROT_READ|flag_PROT_WRITE,
		flag_MAP_PRIVATE|flag_MAP_ANONYMOUS, -1, 0)
	if uintptr(p) == ^uintptr(0) {
		return nil
	}
	dbgMapLive++
	dbgMapBytes += int64(size)
	return p
}

// sysMapShared is sysMap with MAP_SHARED, for memory both sides of a
// process boundary write to. Only meaningful where fork exists.
func sysMapShared(size uintptr) unsafe.Pointer {
	p := mmap(nil, size, flag_PROT_READ|flag_PROT_WRITE,
		flag_MAP_SHARED|flag_MAP_ANONYMOUS, -1, 0)
	if uintptr(p) == ^uintptr(0) {
		return nil
	}
	return p
}

// sysUnmap releases a region from sysMap or sysMapShared.
func sysUnmap(p unsafe.Pointer, size uintptr) {
	dbgMapLive--
	dbgMapBytes -= int64(size)
	munmap(p, size)
}
