package runtime

import "internal/task"

const hasScheduler = false
const hasParallelism = false

var mainExited bool

func run() {
	initRand()
	initAll()
	callMain()
	domainShutdownAll()
	mainExited = true
}

//:linkname sleep time.Sleep
func sleep(duration int64) {
	if duration <= 0 {
		return
	}
	target := ticks() + nanosecondsToTicks(duration)
	for {
		cur := ticks()
		remaining := target - cur
		if remaining <= 0 {
			break
		}
		if timerQueue != nil {
			nextTimer := timerQueue.whenTicks() - cur
			if nextTimer < remaining {
				remaining = nextTimer
			}
		}
		if remaining > 0 {
			sleepTicks(remaining)
		}
		fireTimers()
	}
	fireTimers()
}

func fireTimers() {
	cur := ticks()
	for timerQueue != nil && timerQueue.whenTicks() <= cur {
		tn := timerQueue
		timerQueue = tn.next
		tn.next = nil
		tn.callback(tn, int64(ticksToNanoseconds(cur-tn.whenTicks())))
	}
}

func addTimer(tim *timerNode) {
	timerQueueAdd(tim)
}

func removeTimer(tim *timer) *timerNode {
	return timerQueueRemove(tim)
}

func deadlock() {
	runtimePanic("deadlock")
}

func entersyscall() {}
func exitsyscall() {}

func scheduleTask(t *task.Task) {}

func Gosched() {
	fireTimers()
}

func NumCPU() int32 { return 1 }

func printlock()   {}
func printunlock() {}

func eventLoopTick() {
	fireTimers()
}
