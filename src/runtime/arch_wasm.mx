//:build wasm

package runtime

const GOARCH = "wasm"

// The bitness of the CPU (pointers are 32-bit in wasm32).
const TargetBits = 32

const deferExtraRegs = 0

// WASM instructions are variable-length, but call instructions
// are typically encoded as a single opcode + index.
const callInstSize = 1

// align aligns a pointer to 16-byte boundary.
func align(ptr uintptr) uintptr {
	return (ptr + 15) &^ 15
}

func getCurrentStackPointer() uintptr {
	return uintptr(stacksave())
}
