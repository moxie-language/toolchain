//:build moxie.stringer
// String() for the builtin types, so every value satisfies fmt.Stringer and
// fmt can format it by calling the method. byte and rune are aliases of uint8
// and int32 (as in Go), so they use those methods; uintptr is its own type.
//
// The formatting itself is in numfmt.mx, untagged: the structural renderer
// (type_render.mx) needs the same text on every target, including wasm, where
// these method bodies are not compiled.
package runtime

func (b bool) String() string { return BoolText(b) }

func (n int8) String() string  { return Int64Text(int64(n)) }
func (n int16) String() string { return Int64Text(int64(n)) }
func (n int32) String() string { return Int64Text(int64(n)) }
func (n int64) String() string { return Int64Text(n) }

func (n uint8) String() string  { return Uint64Text(uint64(n)) }
func (n uint16) String() string { return Uint64Text(uint64(n)) }
func (n uint32) String() string { return Uint64Text(uint64(n)) }
func (n uint64) String() string { return Uint64Text(n) }

func (v float32) String() string { return Float32Text(v) }
func (v float64) String() string { return Float64Text(v) }

func (s string) String() string { return s }

func (n uintptr) String() string { return UintptrText(n) }
