const Compiler = "moxie"

// Unit for the 'ticks' and 'sleepTicks' functions.
//
// This is the native time unit for the given system. One timeUnit tick might be
// 1ns or 100ns on a desktop system, or 1/32768s on baremetal systems with a
// low-power RTC. Many other tick durations are possible.
//
// Conversion from time units to nanoseconds and back is done using
// ticksToNanoseconds and nanosecondsToTicks, which need to be implemented for
// each system as needed.
type timeUnit int64

// The compiler will fill this with calls to the initialization function of each
// package.
func initAll()

//:linkname callMain main.main
func callMain()

func GOMAXPROCS(n int32) int32 {
	// Note: setting GOMAXPROCS is ignored.
	return 1
}

func GOROOT() string {
	// TODO: don't hardcode but take the one at compile time.
	return "/usr/local/go"
}

// Copy size bytes from src to dst. The memory areas must not overlap.
func memcpy(dst, src unsafe.Pointer, size uintptr) {
	d := (*byte)(dst)
	s := (*byte)(src)
	for i := uintptr(0); i < size; i++ {
		*(*byte)(unsafe.Add(unsafe.Pointer(d), int32(i))) = *(*byte)(unsafe.Add(unsafe.Pointer(s), int32(i)))
	}
}

func memmove(dst, src unsafe.Pointer, size uintptr) {
	if uintptr(dst) <= uintptr(src) {
		memcpy(dst, src, size)
	} else {
		d := (*byte)(dst)
		s := (*byte)(src)
		for i := size; i > 0; i-- {
			*(*byte)(unsafe.Add(unsafe.Pointer(d), int32(i-1))) = *(*byte)(unsafe.Add(unsafe.Pointer(s), int32(i-1)))
		}
	}
}

func memzero(ptr unsafe.Pointer, size uintptr) {
	p := (*byte)(ptr)
	for i := uintptr(0); i < size; i++ {
		*(*byte)(unsafe.Add(unsafe.Pointer(p), int32(i))) = 0
	}
}

// recvStore stores a received value at the receiver's destination. A nil
// destination is a receive whose value is discarded (`<-ch` with no
// assignment): the legacy compiler's codegen passes nil for the unused
// operand while stage4 passes a scratch pointer, so the runtime has to accept
// both. Writing through nil used to fault in memcpy the moment the peer
// delivered a value, which is how a legacy-built spawn program died right
// after its first exchange.
func recvStore(dst, src unsafe.Pointer, size uintptr) {
	if dst == nil || size == 0 {
		return
	}
	memcpy(dst, src, size)
}

// recvZero is recvStore's counterpart for a closed channel, where the
// receiver's slot is zeroed instead of filled.
func recvZero(dst unsafe.Pointer, size uintptr) {
	if dst == nil || size == 0 {
		return
	}
	memzero(dst, size)
}

