package runtime

// Number and boolean text, shared by the builtin String() methods and by the
// structural renderer (type_render.mx).
//
// The builtin String() bodies live in stringer.mx under the moxie.stringer
// build tag; the wasm target compiles identity thunks instead. The renderer
// runs on every target, so the formatting itself cannot be tag-gated: it lives
// here, untagged, and the tagged methods are one-line delegates.

import "git.smesh.lol/moxie/pkg/mxutil"

func BoolText(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

func Int64Text(n int64) string {
	if n == 0 {
		return "0"
	}
	neg := n < 0
	if neg {
		n = -n
		if n < 0 {
			return "-9223372036854775808"
		}
	}
	buf := []byte{:0:20}
	for n > 0 {
		buf = mxutil.Ensure(buf, 1)
		push(buf, byte('0'+n%10))
		n /= 10
	}
	if neg {
		buf = mxutil.Ensure(buf, 1)
		push(buf, '-')
	}
	for i, j := int32(0), int32(len(buf)-1); i < j; i, j = i+1, j-1 {
		buf[i], buf[j] = buf[j], buf[i]
	}
	return string(buf)
}

func Uint64Text(n uint64) string {
	if n == 0 {
		return "0"
	}
	buf := []byte{:0:20}
	for n > 0 {
		buf = mxutil.Ensure(buf, 1)
		push(buf, byte('0'+n%10))
		n /= 10
	}
	for i, j := int32(0), int32(len(buf)-1); i < j; i, j = i+1, j-1 {
		buf[i], buf[j] = buf[j], buf[i]
	}
	return string(buf)
}

func UintptrText(n uintptr) string {
	if n == 0 {
		return "0x0"
	}
	buf := []byte{:0:18}
	for n > 0 {
		d := byte(n & 0xf)
		if d < 10 {
			buf = mxutil.Ensure(buf, 1)
			push(buf, '0'+d)
		} else {
			buf = mxutil.Ensure(buf, 1)
			push(buf, 'a'+d-10)
		}
		n >>= 4
	}
	for i, j := int32(0), int32(len(buf)-1); i < j; i, j = i+1, j-1 {
		buf[i], buf[j] = buf[j], buf[i]
	}
	return "0x" | string(buf)
}

func Float32Text(v float32) string {
	switch {
	case v != v:
		return "NaN"
	case v+v == v && v > 0:
		return "+Inf"
	case v+v == v && v < 0:
		return "-Inf"
	}
	const digits = 7
	buf := []byte{:digits + 7:digits + 7}
	buf[0] = '+'
	e := int32(0)
	if v == 0 {
		if 1/v < 0 {
			buf[0] = '-'
		}
	} else {
		if v < 0 {
			v = -v
			buf[0] = '-'
		}
		for v >= 10 {
			e++
			v /= 10
		}
		for v < 1 {
			e--
			v *= 10
		}
		h := float32(5.0)
		for i := int32(0); i < digits; i++ {
			h /= 10
		}
		v += h
		if v >= 10 {
			e++
			v /= 10
		}
	}
	for i := int32(0); i < digits; i++ {
		s := int32(v)
		buf[i+2] = byte(s + '0')
		v -= float32(s)
		v *= 10
	}
	buf[1] = buf[2]
	buf[2] = '.'
	buf[digits+2] = 'e'
	buf[digits+3] = '+'
	if e < 0 {
		e = -e
		buf[digits+3] = '-'
	}
	buf[digits+4] = byte(e/100) + '0'
	buf[digits+5] = byte(e/10)%10 + '0'
	buf[digits+6] = byte(e%10) + '0'
	return string(buf)
}

func Float64Text(v float64) string {
	switch {
	case v != v:
		return "NaN"
	case v+v == v && v > 0:
		return "+Inf"
	case v+v == v && v < 0:
		return "-Inf"
	}
	const digits = 15
	buf := []byte{:digits + 7:digits + 7}
	buf[0] = '+'
	e := int32(0)
	if v == 0 {
		if 1/v < 0 {
			buf[0] = '-'
		}
	} else {
		if v < 0 {
			v = -v
			buf[0] = '-'
		}
		for v >= 10 {
			e++
			v /= 10
		}
		for v < 1 {
			e--
			v *= 10
		}
		h := 5.0
		for i := int32(0); i < digits; i++ {
			h /= 10
		}
		v += h
		if v >= 10 {
			e++
			v /= 10
		}
	}
	for i := int32(0); i < digits; i++ {
		s := int32(v)
		buf[i+2] = byte(s + '0')
		v -= float64(s)
		v *= 10
	}
	buf[1] = buf[2]
	buf[2] = '.'
	buf[digits+2] = 'e'
	buf[digits+3] = '+'
	if e < 0 {
		e = -e
		buf[digits+3] = '-'
	}
	buf[digits+4] = byte(e/100) + '0'
	buf[digits+5] = byte(e/10)%10 + '0'
	buf[digits+6] = byte(e%10) + '0'
	return string(buf)
}
