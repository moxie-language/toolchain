//go:build baremetal || js || wasm_unknown || nintendoswitch
//:build baremetal || js || wasm_unknown || nintendoswitch

package runtime

// This file is for non-hosted environments, that don't support command line
// parameters or environment variables. To still be able to run certain tests,
// command line parameters and environment variables can be passed to the binary
// by setting the variables `runtime.osArgs` and `runtime.osEnv`, both of which
// are strings separated by newlines.
//
// The primary use case is `moxie test`, which takes some parameters (such as
// -test.v).

// This is the default set of arguments, if nothing else has been set.
var args []string
var argsDone bool
var env []string
var osArgs string
var osEnv string
var nonhostedInited bool

func _ensureArgs() {
	if !argsDone {
		argsDone = true
		args = []string{"/proc/self/exe"}
	}
}

func ensureNonhosted() {
	if nonhostedInited {
		return
	}
	nonhostedInited = true
	_ensureArgs()
	if osArgs != "" {
		s := osArgs
		start := 0
		for i := 0; i < len(s); i++ {
			if s[i] == 0 {
				args = append(args, s[start:i])
				start = i + 1
			}
		}
		args = append(args, s[start:])
	}

	if osEnv != "" {
		s := osEnv
		start := 0
		for i := 0; i < len(s); i++ {
			if s[i] == 0 {
				env = append(env, s[start:i])
				start = i + 1
			}
		}
		env = append(env, s[start:])
	}
}

//:linkname os_runtime_args os.runtime_args
func os_runtime_args() []string {
	ensureNonhosted()
	return args
}

//:linkname syscall_runtime_envs syscall.runtime_envs
func syscall_runtime_envs() []string {
	ensureNonhosted()
	return env
}
