//:build baremetal || js || wasm_unknown || nintendoswitch

package runtime

import "git.smesh.lol/moxie/pkg/mxutil"

// This file is for non-hosted environments, that don't support command line
// parameters or environment variables. To still be able to run certain tests,
// command line parameters and environment variables can be passed to the binary
// by setting the variables `runtime.osArgs` and `runtime.osEnv`, both of which
// are null-separated strings.

var args []string
var argsDone bool
var env []string
var osArgs string
var osEnv string
var nonhostedInited bool

func _ensureArgs() {
	if !argsDone {
		argsDone = true
		args = []string{"/proc/self/exe"}
	}
}

func ensureNonhosted() {
	if nonhostedInited {
		return
	}
	nonhostedInited = true
	_ensureArgs()
	if osArgs != "" {
		s := osArgs
		start := 0
		for i := 0; i < len(s); i++ {
			if s[i] == 0 {
				if len(args) >= cap(args) { args = mxutil.GrowCap(args) }
				push(args, s[start:i])
				start = i + 1
			}
		}
		if len(args) >= cap(args) { args = mxutil.GrowCap(args) }
		push(args, s[start:])
	}

	if osEnv != "" {
		s := osEnv
		start := 0
		for i := 0; i < len(s); i++ {
			if s[i] == 0 {
				if len(env) >= cap(env) { env = mxutil.GrowCap(env) }
				push(env, s[start:i])
				start = i + 1
			}
		}
		if len(env) >= cap(env) { env = mxutil.GrowCap(env) }
		push(env, s[start:])
	}
}

//:linkname os_runtime_args os.runtime_args
func os_runtime_args() []string {
	ensureNonhosted()
	return args
}

//:linkname syscall_runtime_envs syscall.runtime_envs
func syscall_runtime_envs() []string {
	ensureNonhosted()
	return env
}
