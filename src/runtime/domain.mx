//:build linux

package runtime

import "unsafe"

// A domain is a THREAD. There is no registry of child pids, no waitpid, no
// reaper and no lifecycle pipe: a thread lives in this process, so a domain
// that returns is finished and a process that exits takes every domain with it.
// What survives from the fork era is the breaker: one channel object shared by
// the parent (the handle spawn returns) and the child (DomainClosed), whose
// close is how either side says "terminate".

// spawnCtlRing is the control ring of the spawn being established: the
// breaker's closed flag lives in it, and both threads hold the same pointer.
var spawnCtlRing uintptr

// spawnBreakerMake creates the one breaker channel shared by a spawn: the
// parent holds the handle spawn returns, the child binds the same object as
// DomainClosed, and closing either end closes both views. It lives in the root
// arena because it outlives the frame that spawns.
func spawnBreakerMake() *channel {
	// string = {ptr, len, cap} = 3 pointers
	ptrSize := unsafe.Sizeof(uintptr(0))
	save := CurrentArena()
	SetCurrentArena(trueRootArena())
	// The element is a []byte reason (a slice header on the wire), and the
	// budget must fit the encoded reason plus its tags, not just the header.
	oneReason := ptrSize*3 + 64 + breakerReasonMax
	ch := chanMake(ptrSize*3, 1, oneReason, nil, 0)
	SetCurrentArena(save)
	// The breaker rides the control ring (chanID 0) rather than a channel's own
	// closed word: the flag is one object both ends hold, so a close by either
	// is visible to both without a message.
	ch.spawnBound = true
	ch.spawnChanID = 0
	ch.ringA = spawnCtlRing
	ch.ringB = spawnCtlRing
	return ch
}

// SpawnLifecycleChannel returns the breaker of the spawn that just started. The
// compiler emits a call to it after spawnDomain; the parent keeps what it
// returns as the domain's termination handle and its reason channel.
func SpawnLifecycleChannel() (ch *channel) {
	if spawnBreaker == nil {
		spawnBreaker = spawnBreakerMake()
	}
	return spawnBreaker
}

// LastSpawnedLockdownFd has no fd to report: the secalloc lockdown pipe existed
// to carry a child PROCESS's guard-page fault back to its parent. A domain is a
// thread now, so a fault is the process's fault and reaches stderr like any
// other diagnostic.
func LastSpawnedLockdownFd() int32 { return -1 }
