package runtime

import (
	"unsafe"
	"git.smesh.lol/moxie/pkg/mxutil"
)

// Recursive value serializer with back-references for shared/cyclic pointers.
// Encode-side tags emitted per non-trivial value:
const (
	codecTagPtr    = 0x00  // non-nil pointer: inner value follows
	codecTagStr    = 0x01  // string/[]byte: uint32 len + bytes
	codecTagSlice  = 0x02  // slice: uint32 len + uint32 cap + elements
	codecTagIface  = 0x03  // interface: 8 bytes typecode + inner value
	codecTagStruct = 0x04  // struct: uint32 nf + field encodings
	codecTagBackref = 0x05 // back-reference: uint32 index into seen set
	codecTagNil    = 0x06  // nil pointer
	codecTagStable   = 0x07 // stable pointer: 8 raw address bytes, identity preserved
	codecTagStableSlice = 0x08 // stable string/[]byte: raw 24-byte header, no copy
)

// codecArenaContains reports whether addr lies in any allocated region of a.
func codecArenaContains(a *Arena, p uintptr) (ok bool) {
	if a == nil {
		return false
	}
	for i := int32(0); i < a.nregions; i++ {
		if p >= a.regions[i].base && p < a.regions[i].base+a.regions[i].cap {
			return true
		}
	}
	return false
}

// codecIsStableAddr reports whether addr lives outside all transient
// function arenas (i.e. in the root arena, a global, the stack, or a
// sovereign arena currently borrowed / registered stable by a method).
// When codecTopOnlyTransient is set (sovereign store-backs), only the
// CURRENT fn arena (the method's scratch) counts as transient: data in
// the caller's arenas must keep its identity instead of being copied.
func codecIsStableAddr(p uintptr) (ok bool) {
	if domainRoot == nil {
		return true
	}
	if domainRoot.stableArena != nil && codecArenaContains(domainRoot.stableArena, p) {
		return true
	}
	if codecTopOnlyTransient {
		// Sovereign store-back: only sovereign scratch fn arenas (the
		// method's own plus any ancestor sovereign method's scratch) are
		// transient. Regular fn arenas (non-sovereign callers) keep their
		// identity.
		for i := int32(1); i <= domainRoot.fnTop; i++ {
			if domainRoot.sovScratch[i>>6]&(1 << (i & 63)) == 0 {
				continue
			}
			if codecArenaContains(domainRoot.fnStack[i], p) {
				return false
			}
		}
		return true
	}
	nreg := domainRoot.fnTop
	if nreg < 0 {
		nreg = 0
	}
	for i := int32(1); i <= nreg; i++ {
		if domainRoot.fnBorrow[i>>6]&(1<<(i&63)) != 0 {
			continue
		}
		if codecArenaContains(domainRoot.fnStack[i], p) {
			return false
		}
	}
	return true
}

// codecTopOnlyTransient: see codecIsStableAddr.
var codecTopOnlyTransient bool

// codecNoteStable marks the owner arena of a stable emission as escaped
// when the pointer targets a sovereign data arena: external holders now
// reference it, so it must not be compacted.
func codecNoteStable(p uintptr) {
	if domainRoot == nil || domainRoot.stableArena == nil {
		return
	}
	a := domainRoot.stableArena
	if a.sovereign != 0 && a.owner != nil && codecArenaContains(a, p) {
		a.owner.escaped = true
	}
}

type CodecBuf struct {
	data    []byte
	pos     int32
}

// codecEscapePtr is set when a pointer into a transient fn arena escapes
// with a basic (unknown-length) pointee. The fn arena must then be leaked
// instead of released.
var codecEscapePtr bool

// codecEscapeOccurred reports and clears the escape flag.
func codecEscapeOccurred() (b bool) {
	b = codecEscapePtr
	codecEscapePtr = false
	return b
}

func codecBufInit(cb *CodecBuf) {
	cb.data = []byte{:0:256}
	cb.pos = 0
	codecEscapePtr = false
}

// codecEnsure is a free function (params are immutable borrows): it
// returns a slice with room for n more bytes, allocating a fresh backing
// array (doubling) when needed. The caller stores the result into the
// CodecBuf field. Old backing arrays are left to the arena.
func codecEnsure(data []byte, n int32) (r0 []byte) {
	if len(data)+n <= cap(data) {
		return data
	}
	need := (len(data) + n) * 2
	if need < 256 {
		need = 256
	}
	nb := []byte{:need}
	copy(nb, data)
	r0 = nb[:len(data)]
	return r0
}

func codecWriteU32(cb *CodecBuf, v uint32) {
	cb.data = codecEnsure(cb.data, 4)
	if len(cb.data) >= cap(cb.data) { cb.data = mxutil.GrowCap(cb.data) }
	push(cb.data, byte(v), byte(v>>8), byte(v>>16), byte(v>>24))
}

func codecReadU32(cb *CodecBuf) (v uint32) {
	v = uint32(cb.data[cb.pos]) | uint32(cb.data[cb.pos+1])<<8 |
		uint32(cb.data[cb.pos+2])<<16 | uint32(cb.data[cb.pos+3])<<24
	cb.pos += 4; return
}

// codecWriteVarint writes v as a LEB128 unsigned varint (1-10 bytes).
// Used for type tags and encoded lengths; u64 range future-proofs the format.
func codecWriteVarint(cb *CodecBuf, v uint64) {
	cb.data = codecEnsure(cb.data, 10)
	for {
		b := byte(v & 0x7f)
		v >>= 7
		if v == 0 {
			push(cb.data, b)
			break
		}
		push(cb.data, b|0x80)
	}
}

func codecReadVarint(cb *CodecBuf) (v uint64) {
	var shift uint32
	for {
		b := cb.data[cb.pos]
		cb.pos++
		v |= uint64(b&0x7f) << shift
		if b&0x80 == 0 {
			break
		}
		shift += 7
	}
	return
}

func codecWriteBytes(cb *CodecBuf, v []byte) {
	codecWriteVarint(cb, uint64(uint32(len(v))))
	if len(v) > 0 {
		codecWriteRaw(cb, unsafe.Pointer(&v[0]), uintptr(len(v)))
	}
}

func codecReadBytes(cb *CodecBuf) (v []byte) {
	n := int32(codecReadVarint(cb))
	if n == 0 { return nil }
	if int32(len(cb.data)) < cb.pos+n { runtimePanic("codec underflow") }
	v = []byte{:n}
	memcpy(unsafe.Pointer(&v[0]), unsafe.Pointer(&cb.data[cb.pos]), uintptr(n))
	cb.pos += n; return
}

type codecSeenSet struct {
	ptrs  []unsafe.Pointer
	count int32
}

const codecSeenCap = 65536

func codecSeenInit(ss *codecSeenSet) {
	ss.ptrs = []unsafe.Pointer{:0:256}
	ss.count = 0
}

func codecSeenLookup(ss *codecSeenSet, p unsafe.Pointer) int32 {
	for i := int32(0); i < ss.count; i++ {
		if ss.ptrs[i] == p { return i }
	}
	return -1
}

func codecSeenAdd(ss *codecSeenSet, p unsafe.Pointer) int32 {
	if ss.count >= codecSeenCap { return -1 }
	if len(ss.ptrs) >= cap(ss.ptrs) { ss.ptrs = mxutil.GrowCap(ss.ptrs) }
	ss.ptrs = push(ss.ptrs, p)
	n := ss.count
	ss.count++
	return n
}

type codecDecodeSeen struct {
	ptrs  []unsafe.Pointer
	count int32
}

func codecDecodeSeenInit(ds *codecDecodeSeen) {
	ds.ptrs = []unsafe.Pointer{:0:256}
	ds.count = 0
}

func codecDecodeSeenAdd(ds *codecDecodeSeen, p unsafe.Pointer) int32 {
	if ds.count >= codecSeenCap { return -1 }
	if len(ds.ptrs) >= cap(ds.ptrs) { ds.ptrs = mxutil.GrowCap(ds.ptrs) }
	ds.ptrs = push(ds.ptrs, p)
	n := ds.count
	ds.count++
	return n
}

func codecDecodeSeenLookup(ds *codecDecodeSeen, idx int32) unsafe.Pointer {
	if idx >= ds.count { return nil }
	return ds.ptrs[idx]
}

func isBasicKind(k Kind) bool {
	return k == Bool || k == Int || k == Int8 || k == Int16 || k == Int32 || k == Int64 ||
		k == Uint || k == Uint8 || k == Uint16 || k == Uint32 || k == Uint64 || k == Uintptr ||
		k == Float32 || k == Float64 || k == kindUnsafePointer || k == kindChan || k == kindFunc
}

func codecEncodeValue(cb *CodecBuf, ss *codecSeenSet, ptr unsafe.Pointer, typ *RawType) {
	if typ == nil {
		runtimePanic("codecEncodeValue nil typ")
	}
	badPtr := ptr == nil || uintptr(ptr) < 1048576
	k := typ.Kind()
	if badPtr && k != kindStruct {
		switch k {
	case kindBytes:
			codecWriteVarint(cb, codecTagStr)
			codecWriteVarint(cb, uint64(0))
			codecWriteVarint(cb, uint64(0))
			return
		case kindSlice:
			codecWriteVarint(cb, codecTagSlice)
			codecWriteVarint(cb, uint64(0))
			codecWriteVarint(cb, uint64(0))
			return
		case kindPointer:
			codecWriteVarint(cb, codecTagNil)
			return
		case kindStruct:
			codecWriteVarint(cb, codecTagStruct)
			codecWriteVarint(cb, uint64(0))
			return
		case kindMap:
			codecWriteVarint(cb, codecTagNil)
			return
		case kindInterface:
			codecWriteVarint(cb, codecTagIface)
			codecWriteVarint(cb, uint64(0))
			return
		default:
			codecWriteVarint(cb, codecTagNil)
			return
		}
	}
	if isBasicKind(k) {
		sz := typ.Size()
		if sz > 65536 {
			runtimePanic("codec basic bad size")
		}
		codecWriteRaw(cb, ptr, uintptr(sz))
		return
	}
	switch k {
	case kindBytes:
		s := *(*_string)(ptr)
		if s.length > 0 && s.ptr != nil && codecIsStableAddr(uintptr(unsafe.Pointer(s.ptr))) {
			codecNoteStable(uintptr(unsafe.Pointer(s.ptr)))
			codecWriteVarint(cb, codecTagStableSlice)
			codecWriteRaw(cb, unsafe.Pointer(&s), 24)
			return
		}
		if s.length > 0 && (s.ptr == nil || uintptr(unsafe.Pointer(s.ptr)) < 65536) {
			codecWriteVarint(cb, codecTagStr)
			codecWriteVarint(cb, uint64(0))
			codecWriteVarint(cb, uint64(0))
			return
		}
		if s.length > 2*1024*1024*1024 {
			n := uint32(0)
			if s.cap > 0 && s.cap <= 65536 { n = uint32(s.cap) }
			codecWriteVarint(cb, codecTagStr)
			codecWriteVarint(cb, uint64(n))
			codecWriteVarint(cb, uint64(n))
			for i := uint32(0); i < n; i++ {
				codecWriteU8(cb, 0)
			}
			return
		}
		codecWriteVarint(cb, codecTagStr)
		codecWriteVarint(cb, uint64(uint32(s.length)))
		codecWriteVarint(cb, uint64(uint32(s.cap)))
		if s.length > 0 {
			codecWriteRaw(cb, unsafe.Pointer(s.ptr), uintptr(s.length))
		}
	case kindSlice:
		sl := *(*_string)(ptr)
		elemType := typ.Elem()
		// A stable backing array is only a safe shortcut when the elements
		// cannot themselves reference transient data. During a sovereign
		// store-back (codecTopOnlyTransient) a slice's backing may already
		// live in the data arena while a freshly-pushed element points into
		// the scratch fn arena; walk such elements so the pointer targets
		// get relocated.
		if sl.ptr != nil && codecIsStableAddr(uintptr(unsafe.Pointer(sl.ptr))) &&
			!(sl.length > 0 && codecTopOnlyTransient && elemType != nil && sovTypeHasPtrs(elemType)) {
			codecNoteStable(uintptr(unsafe.Pointer(sl.ptr)))
			codecWriteVarint(cb, codecTagStableSlice)
			codecWriteRaw(cb, unsafe.Pointer(&sl), 24)
			return
		}
		codecWriteVarint(cb, codecTagSlice)
		codecWriteVarint(cb, uint64(uint32(sl.length)))
		codecWriteVarint(cb, uint64(uint32(sl.cap)))
		for i := int32(0); i < int32(sl.length); i++ {
			ep := unsafe.Add(unsafe.Pointer(sl.ptr), uintptr(i)*elemType.Size())
			codecEncodeValue(cb, ss, ep, elemType)
		}
	case kindPointer:
		// Bad pointer check: if ptr looks invalid (low address, nil, etc.)
		// emit nil instead of dereferencing.
		if ptr == nil || uintptr(ptr) < 1048576 {
			codecWriteVarint(cb, codecTagNil)
			return
		}
		p := *(*unsafe.Pointer)(ptr)
		if p == nil {
			codecWriteVarint(cb, codecTagNil)
			return
		}
		idx := codecSeenLookup(ss, p)
		if idx >= 0 {
			codecWriteVarint(cb, codecTagBackref)
			codecWriteVarint(cb, uint64(uint32(idx)))
			return
		}
		codecSeenAdd(ss, p)
		if codecIsStableAddr(uintptr(p)) {
			codecNoteStable(uintptr(p))
			codecWriteVarint(cb, codecTagStable)
			codecWriteRaw(cb, unsafe.Pointer(&p), 8)
			return
		}
		// Pointer into a transient fn arena whose pointee is a basic
		// (unknown-length, e.g. *byte into a byte buffer) cannot be
		// deep-copied: the pointee's declared size does not capture the
		// real object. Preserve the address and leak the fn arena so
		// the pointee stays alive for the caller.
		if et := typ.Elem(); et != nil && isBasicKind(et.Kind()) {
			codecEscapePtr = true
			codecWriteVarint(cb, codecTagStable)
			codecWriteRaw(cb, unsafe.Pointer(&p), 8)
			return
		}
		codecWriteVarint(cb, codecTagPtr)
		codecEncodeValue(cb, ss, p, typ.Elem())
	case kindInterface:
		iface := *(*_interface)(ptr)
		codecWriteVarint(cb, codecTagIface)
		codecWriteBytes(cb, unsafe.Slice((*byte)(unsafe.Pointer(&iface.typecode)), 8))
		if iface.typecode != nil && uintptr(iface.typecode) > 4096 && uintptr(iface.typecode) < (uintptr(1)<<48) {
			tc := uintptr(iface.typecode)
			if tc > 0x1000 && tc < 0x40000000 {
				ct := (*RawType)(iface.typecode)
				if ct.Kind() != Invalid && ct.Size() <= 65536 {
					// Zero-size structs (e.g. empty context markers) still
					// emit their struct tag + field count so the decode
					// side stays in lockstep with the wire format.
					if ct.Size() <= unsafe.Sizeof(uintptr(0)) {
						codecEncodeValue(cb, ss, unsafe.Pointer(&iface.value), ct)
					} else {
						codecEncodeValue(cb, ss, iface.value, ct)
					}
				}
			}
		}
	case kindMap:
		m := *(*unsafe.Pointer)(ptr)
		if m == nil {
			codecWriteVarint(cb, codecTagNil)
			return
		}
		codecWriteVarint(cb, codecTagPtr)
		hm := (*hashmap)(m)
		fixupFlags := uint8(0)
		kt := hashmapKeyType(typ)
		vt := typ.Elem()
		if kt != nil && (kt.Kind() == kindBytes) { fixupFlags |= 8 }
		if vt != nil && (vt.Kind() == kindBytes) { fixupFlags |= 1 }
		if vt != nil && (vt.Kind() == kindPointer) { fixupFlags |= 2 }
		if vt != nil && (vt.Kind() == kindInterface) { fixupFlags |= 4 }
		var valElemType *RawType
		if vt != nil && vt.Kind() == kindPointer { valElemType = vt.Elem() }
		codecEncodeMap(hm, cb, ss, fixupFlags, valElemType)
	case kindStruct:
		if ptr == nil || uintptr(ptr) < 1048576 {
			codecWriteVarint(cb, codecTagStruct)
			codecWriteVarint(cb, uint64(0))
			return
		}
		nf := typ.NumField()
		codecWriteVarint(cb, codecTagStruct)
		codecWriteVarint(cb, uint64(uint32(nf)))
		// Register all field addresses in the seen-set so that pointer
		// fields referencing other fields within the same struct (e.g.,
		// fmt.buf *buffer pointing to pp.buf) are handled as back-references
		// instead of serializing duplicate copies.
		for i := int32(0); i < nf; i++ {
			off := typ.StructFieldOffset(i)
			fp := unsafe.Add(ptr, off)
			codecSeenAdd(ss, fp)
		}
		for i := int32(0); i < nf; i++ {
			ft := typ.StructFieldType(i)
			off := typ.StructFieldOffset(i)
			fp := unsafe.Add(ptr, off)
			codecEncodeValue(cb, ss, fp, ft)
		}
	case kindArray:
		elemType := typ.Elem()
		elemSize := elemType.Size()
		length := typ.ArrayLen()
		for i := int32(0); i < length; i++ {
			ep := unsafe.Add(ptr, uintptr(i)*elemSize)
			codecEncodeValue(cb, ss, ep, elemType)
		}
	default:
		sz := typ.Size()
		if sz <= 0 || sz > 65536 {
			runtimePanic("codec default bad size")
		}
		codecWriteRaw(cb, ptr, uintptr(sz))
	}
}

func codecDecodeValue(cb *CodecBuf, ds *codecDecodeSeen, typ *RawType) unsafe.Pointer {
	k := typ.Kind()
	if isBasicKind(k) {
		sz := typ.Size()
		buf := alloc(sz, unsafe.Pointer(typ))
		memcpy(buf, unsafe.Pointer(&cb.data[cb.pos]), sz)
		cb.pos += int32(sz)
		return buf
	}
	switch k {
	case kindBytes:
		startPos := cb.pos
		tag := codecReadVarint(cb)
		if tag == codecTagStableSlice {
			hdr := alloc(typ.Size(), unsafe.Pointer(typ))
			memcpy(hdr, unsafe.Pointer(&cb.data[cb.pos]), 24)
			cb.pos += 24
			return hdr
		}
		if tag == codecTagStr {
			n := int32(codecReadVarint(cb))
			ncp := int32(codecReadVarint(cb))
			hdr := alloc(typ.Size(), unsafe.Pointer(typ))
			if n > 0 {
				dataPtr := alloc(uintptr(n), nil)
				memcpy(dataPtr, unsafe.Pointer(&cb.data[cb.pos]), uintptr(n))
				cb.pos += n
				*(*unsafe.Pointer)(hdr) = dataPtr
			} else if ncp > 0 {
				*(*unsafe.Pointer)(hdr) = alloc(uintptr(ncp), nil)
			}
			*(*uintptr)(unsafe.Add(hdr, 8)) = uintptr(n)
			if typ.Size() > 16 {
				*(*uintptr)(unsafe.Add(hdr, 16)) = uintptr(ncp)
			}
			return hdr
		}
		cb.pos = startPos
		sz := typ.Size()
		buf := alloc(sz, unsafe.Pointer(typ))
		memcpy(buf, unsafe.Pointer(&cb.data[cb.pos]), sz)
		cb.pos += int32(sz)
		return buf
	case kindSlice:
		startPos := cb.pos
		tag := codecReadVarint(cb)
		if tag == codecTagStableSlice {
			hdr := alloc(typ.Size(), unsafe.Pointer(typ))
			memcpy(hdr, unsafe.Pointer(&cb.data[cb.pos]), 24)
			cb.pos += 24
			return hdr
		}
		if tag == codecTagSlice {
			elemType := typ.Elem()
			hdr := alloc(typ.Size(), unsafe.Pointer(typ))
			ln := int32(codecReadVarint(cb))
			cp := int32(codecReadVarint(cb))
			if cp > 0 {
				elemSize := elemType.Size()
				arr := alloc(uintptr(cp)*elemSize, nil)
				*(*unsafe.Pointer)(hdr) = arr
				for i := int32(0); i < ln; i++ {
					ep := unsafe.Add(arr, uintptr(i)*elemSize)
					dec := codecDecodeValue(cb, ds, elemType)
					memcpy(ep, dec, elemSize)
				}
			}
			*(*uintptr)(unsafe.Add(hdr, 8)) = uintptr(ln)
			*(*uintptr)(unsafe.Add(hdr, 16)) = uintptr(cp)
			return hdr
		}
		cb.pos = startPos
		sz := typ.Size()
		buf := alloc(sz, unsafe.Pointer(typ))
		memcpy(buf, unsafe.Pointer(&cb.data[cb.pos]), sz)
		cb.pos += int32(sz)
		return buf
	case kindPointer:
		tag := codecReadVarint(cb)
		switch tag {
		case codecTagNil:
			buf := alloc(typ.Size(), unsafe.Pointer(typ))
			*(*unsafe.Pointer)(buf) = nil
			return buf
		case codecTagBackref:
			idx := int32(codecReadVarint(cb))
			orig := codecDecodeSeenLookup(ds, idx)
			if orig == nil {
				runtimePanic("codec backref nil")
			}
			buf := alloc(typ.Size(), unsafe.Pointer(typ))
			*(*unsafe.Pointer)(buf) = orig
			codecDecodeSeenAdd(ds, orig)
			return buf
		case codecTagPtr:
			inner := codecDecodeValue(cb, ds, typ.Elem())
			codecDecodeSeenAdd(ds, inner)
			buf := alloc(typ.Size(), unsafe.Pointer(typ))
			*(*unsafe.Pointer)(buf) = inner
			return buf
		case codecTagStable:
			if cb.pos+8 > int32(len(cb.data)) {
				runtimePanic("codec stable underflow")
			}
			sp := *(*unsafe.Pointer)(unsafe.Pointer(&cb.data[cb.pos]))
			cb.pos += 8
			buf := alloc(typ.Size(), unsafe.Pointer(typ))
			*(*unsafe.Pointer)(buf) = sp
			codecDecodeSeenAdd(ds, sp)
			return buf
		}
		runtimePanic("codec bad pointer tag")
		return nil
	case kindInterface:
		tag := codecReadVarint(cb)
		if tag != codecTagIface {
			runtimePanic("codec expected iface tag")
		}
		typRaw := codecReadBytes(cb)
		buf := alloc(typ.Size(), unsafe.Pointer(typ))
		if len(typRaw) == 0 {
			return buf
		}
		*(*unsafe.Pointer)(buf) = *(*unsafe.Pointer)(unsafe.Pointer(&typRaw[0]))
		ct := (*RawType)(*(*unsafe.Pointer)(unsafe.Pointer(&typRaw[0])))
		if ct == nil {
			// nil concrete value but non-nil interface type
			return buf
		}
		if ct.Size() <= unsafe.Sizeof(uintptr(0)) {
			inner := codecDecodeValue(cb, ds, ct)
			memcpy(unsafe.Add(buf, 8), inner, ct.Size())
		} else {
			inner := codecDecodeValue(cb, ds, ct)
			*(*unsafe.Pointer)(unsafe.Add(buf, 8)) = inner
		}
		return buf
	case kindStruct:
		tag := codecReadVarint(cb)
		if tag != codecTagStruct {
			runtimePanic("codec expected struct tag")
		}
		nf := int32(codecReadVarint(cb))
		buf := alloc(typ.Size(), unsafe.Pointer(typ))
		// Register decoded struct and all its field addresses in the
		// decode seen-set, matching the encode side's registration order
		// so that back-references are resolved correctly.
		codecDecodeSeenAdd(ds, buf)
		for i := int32(0); i < nf; i++ {
			off := typ.StructFieldOffset(i)
			fp := unsafe.Add(buf, off)
			codecDecodeSeenAdd(ds, fp)
		}
		// Decode fields in order using type descriptors
		expectedNf := typ.NumField()
		if nf != expectedNf {
			runtimePanic("codec struct field count mismatch")
		}
		for i := int32(0); i < nf; i++ {
			ft := typ.StructFieldType(i)
			off := typ.StructFieldOffset(i)
			fp := unsafe.Add(buf, off)
			dec := codecDecodeValue(cb, ds, ft)
			memcpy(fp, dec, ft.Size())
		}
		return buf
	case kindArray:
		elemType := typ.Elem()
		elemSize := elemType.Size()
		length := typ.ArrayLen()
		buf := alloc(typ.Size(), unsafe.Pointer(typ))
		for i := int32(0); i < length; i++ {
			ep := unsafe.Add(buf, uintptr(i)*elemSize)
			dec := codecDecodeValue(cb, ds, elemType)
			memcpy(ep, dec, elemSize)
		}
		return buf
	case kindMap:
		buf := alloc(typ.Size(), unsafe.Pointer(typ))
		kt := hashmapKeyType(typ)
		vt := typ.Elem()
		keySz := kt.Size()
		valSz := vt.Size()
		alg := uint8(0)
		if kt.Kind() == kindBytes { alg = 1 }
		if kt.Kind() == kindInterface { alg = 2 }
		flags := uint8(0)
		if kt.Kind() == kindBytes { flags |= 8 }
		if vt.Kind() == kindBytes { flags |= 1 }
		if vt.Kind() == kindPointer { flags |= 2 }
		if vt.Kind() == kindInterface { flags |= 4 }
		decoded := codecDecodeMapValue(cb, ds, keySz, valSz, alg, flags, kt, vt)
		*(*unsafe.Pointer)(buf) = unsafe.Pointer(decoded)
		return buf
	default:
		sz := typ.Size()
		buf := alloc(sz, unsafe.Pointer(typ))
		memcpy(buf, unsafe.Pointer(&cb.data[cb.pos]), sz)
		cb.pos += int32(sz)
		return buf
	}
}

// codecDecodeMapValue decodes a map from the codec buffer, creating a new hashmap.
// This is a standalone function to avoid function instance specialization issues.
func codecDecodeMapValue(cb *CodecBuf, ds *codecDecodeSeen, keySz, valSz uintptr, alg uint8, flags uint8, kt, vt *RawType) (m *hashmap) {
	tag := codecReadVarint(cb)
	if tag == codecTagNil { return nil }
	if tag != codecTagPtr { runtimePanic("codec: map expected ptr tag") }
	cnt := int32(codecReadVarint(cb))
	m = hashmapMake(keySz, valSz, uintptr(cnt), alg)
	if cnt == 0 { return }
	fixKey := flags&8 != 0; fixStrVal := flags&1 != 0; fixVal := flags&2 != 0; fixIface := flags&4 != 0
	for i := int32(0); i < cnt; i++ {
		var key, val []byte
		if fixKey { raw := codecReadBytes(cb)
			hdr := []byte{:keySz}
			*(*unsafe.Pointer)(unsafe.Pointer(&hdr[0])) = unsafe.Pointer(&raw[0])
			*(*uintptr)(unsafe.Pointer(&hdr[8])) = uintptr(len(raw))
			if keySz > 16 { *(*uintptr)(unsafe.Pointer(&hdr[16])) = uintptr(len(raw)) }
			key = hdr
		} else { key = []byte{:keySz}
			memcpy(unsafe.Pointer(&key[0]), unsafe.Pointer(&cb.data[cb.pos]), keySz)
			cb.pos += int32(keySz) }
		if fixStrVal {
			raw := codecReadBytes(cb)
			hdr := []byte{:valSz}
			*(*unsafe.Pointer)(unsafe.Pointer(&hdr[0])) = unsafe.Pointer(&raw[0])
			*(*uintptr)(unsafe.Pointer(&hdr[8])) = uintptr(len(raw))
			if valSz > 16 { *(*uintptr)(unsafe.Pointer(&hdr[16])) = uintptr(len(raw)) }
			val = hdr
		} else if fixVal {
			tag := codecReadVarint(cb)
			if tag == codecTagNil { val = []byte{:valSz} } else
			if tag == codecTagPtr {
				var valElemType *RawType
				if vt != nil && vt.Kind() == kindPointer { valElemType = vt.Elem() }
				inner := codecDecodeValue(cb, ds, valElemType)
				buf := []byte{:valSz}
				*(*unsafe.Pointer)(unsafe.Pointer(&buf[0])) = inner
				val = buf
			} else { runtimePanic("codec bad fixVal tag") }
		} else if fixIface {
			tag := codecReadVarint(cb)
			if tag != codecTagIface { runtimePanic("codec expected iface tag") }
			typRaw := codecReadBytes(cb)
			buf := []byte{:valSz}
			if len(typRaw) > 0 {
				*(*unsafe.Pointer)(unsafe.Pointer(&buf[0])) = *(*unsafe.Pointer)(unsafe.Pointer(&typRaw[0]))
				ct := (*RawType)(*(*unsafe.Pointer)(unsafe.Pointer(&typRaw[0])))
				if ct.Size() <= unsafe.Sizeof(uintptr(0)) {
					inner := codecDecodeValue(cb, ds, ct)
					memcpy(unsafe.Pointer(&buf[8]), inner, ct.Size())
				} else {
					inner := codecDecodeValue(cb, ds, ct)
					*(*unsafe.Pointer)(unsafe.Pointer(&buf[8])) = inner
				}
			}
			val = buf
		} else { val = []byte{:valSz}
			memcpy(unsafe.Pointer(&val[0]), unsafe.Pointer(&cb.data[cb.pos]), valSz)
			cb.pos += int32(valSz) }
		h := m.keyHash(unsafe.Pointer(&key[0]), keySz, m.seed)
		hashmapSet(m, unsafe.Pointer(&key[0]), unsafe.Pointer(&val[0]), h)
	}
	return
}

func codecEncodeMap(m *hashmap, cb *CodecBuf, ss *codecSeenSet, fixupFlags uint8, valElemType *RawType) {
	// Entry count
	cnt := int32(0)
	if m != nil {
		keySz := m.keySize; valSz := m.valueSize
		bucketSz := unsafe.Sizeof(hashmapBucket{}) + keySz*8 + valSz*8
		nb := uintptr(1) << m.bucketBits
		for bi := uintptr(0); bi < nb; bi++ {
			for b := (*hashmapBucket)(unsafe.Add(m.buckets, bucketSz*bi)); b != nil; b = b.next {
				for i := uint8(0); i < 8; i++ { if b.tophash[i] != 0 { cnt++ } }
			}
		}
	}
	codecWriteVarint(cb, uint64(uint32(cnt)))
	if cnt == 0 { return }

	fixKey := fixupFlags&8 != 0; fixStrVal := fixupFlags&1 != 0; fixVal := fixupFlags&2 != 0; fixIface := fixupFlags&4 != 0
	keySz := m.keySize; valSz := m.valueSize
	bucketSz := unsafe.Sizeof(hashmapBucket{}) + keySz*8 + valSz*8
	nb := uintptr(1) << m.bucketBits

	for bi := uintptr(0); bi < nb; bi++ {
		for b := (*hashmapBucket)(unsafe.Add(m.buckets, bucketSz*bi)); b != nil; b = b.next {
			for i := uint8(0); i < 8; i++ {
				if b.tophash[i] != 0 {
					kp := hashmapSlotKey(m, b, i)
					vp := hashmapSlotValue(m, b, i)
					if fixKey {
						_sh := *(*_string)(kp)
						codecWriteBytes(cb, unsafe.Slice((*byte)(_sh.ptr), _sh.length))
					} else {
						codecWriteRaw(cb, kp, uintptr(keySz))
					}
					if fixStrVal {
						sv := *(*_string)(vp)
						codecWriteBytes(cb, unsafe.Slice((*byte)(sv.ptr), sv.length))
					} else if fixVal {
						p := *(*unsafe.Pointer)(vp)
						if p == nil {
							codecWriteVarint(cb, codecTagNil)
						} else {
							codecWriteVarint(cb, codecTagPtr)
							codecEncodeValue(cb, ss, p, valElemType)
						}
					} else if fixIface {
						iface := *(*_interface)(vp)
						codecWriteVarint(cb, codecTagIface)
						codecWriteBytes(cb, unsafe.Slice((*byte)(unsafe.Pointer(&iface.typecode)), 8))
						if iface.typecode != nil {
							ct := (*RawType)(iface.typecode)
							if ct.Size() <= unsafe.Sizeof(uintptr(0)) {
								codecEncodeValue(cb, ss, unsafe.Pointer(&iface.value), ct)
							} else {
								codecEncodeValue(cb, ss, iface.value, ct)
							}
						}
					} else {
						codecWriteRaw(cb, vp, uintptr(valSz))
					}
				}
			}
		}
	}
}

// --- Compiler-generated return value encode/decode primitives ---
// Called from compiler-emitted code to serialize return values across
// arena boundaries. These replace the old 3-pass Reloc* system.

func codecWriteU8(cb *CodecBuf, v uint8) {
	cb.data = codecEnsure(cb.data, 1)
	if len(cb.data) >= cap(cb.data) { cb.data = mxutil.GrowCap(cb.data) }
	push(cb.data, v)
}

func codecWriteRaw(cb *CodecBuf, ptr unsafe.Pointer, sz uintptr) {
	if sz > 0 {
		cb.data = codecEnsure(cb.data, int32(sz))
		off := len(cb.data)
		cb.data = cb.data[:off+int32(sz)]
		memcpy(unsafe.Pointer(&cb.data[off]), ptr, sz)
	}
}

func codecReadU8(cb *CodecBuf) (v uint8) {
	v = cb.data[cb.pos]; cb.pos++
	return
}

func codecReadRaw(cb *CodecBuf, ptr unsafe.Pointer, sz uintptr) {
	if sz > 0 {
		memcpy(ptr, unsafe.Pointer(&cb.data[cb.pos]), sz)
		cb.pos += int32(sz)
	}
}


// codecEncodePtrValue encodes a pointer from its value.
func codecEncodePtrValue(cb *CodecBuf, ss *codecSeenSet, ptr unsafe.Pointer, elemType *RawType) {
	if ptr == nil {
		codecWriteVarint(cb, codecTagNil)
		return
	}
	idx := codecSeenLookup(ss, ptr)
	if idx >= 0 {
		codecWriteVarint(cb, codecTagBackref)
		codecWriteVarint(cb, uint64(uint32(idx)))
		return
	}
	codecSeenAdd(ss, ptr)
	codecWriteVarint(cb, codecTagPtr)
	codecEncodeValue(cb, ss, ptr, elemType)
}

// codecEncodeIfaceValue encodes an interface from its typecode and value fields.
func codecEncodeIfaceValue(cb *CodecBuf, ss *codecSeenSet, typecode, value unsafe.Pointer, typ *RawType) {
	codecWriteVarint(cb, codecTagIface)
	codecWriteBytes(cb, unsafe.Slice((*byte)(unsafe.Pointer(&typecode)), 8))
	if typecode != nil {
		ct := (*RawType)(typecode)
		if ct.Size() <= unsafe.Sizeof(uintptr(0)) {
			codecEncodeValue(cb, ss, unsafe.Pointer(&value), ct)
		} else {
			codecEncodeValue(cb, ss, value, ct)
		}
	}
}

// codecEncodeMapValue encodes a map from its pointer value.
func codecEncodeMapValue(cb *CodecBuf, ss *codecSeenSet, mptr unsafe.Pointer, typ *RawType) {
	if mptr == nil {
		codecWriteVarint(cb, codecTagNil)
		return
	}
	codecWriteVarint(cb, codecTagPtr)
	hm := (*hashmap)(mptr)
	fixupFlags := uint8(0)
	kt := hashmapKeyType(typ)
	vt := typ.Elem()
	if kt != nil && (kt.Kind() == kindBytes) { fixupFlags |= 8 }
	if vt != nil && (vt.Kind() == kindBytes) { fixupFlags |= 1 }
	if vt != nil && (vt.Kind() == kindPointer) { fixupFlags |= 2 }
	if vt != nil && (vt.Kind() == kindInterface) { fixupFlags |= 4 }
	var valElemType *RawType
	if vt != nil && vt.Kind() == kindPointer { valElemType = vt.Elem() }
	codecEncodeMap(hm, cb, ss, fixupFlags, valElemType)
}

// codecDecodeString decodes a string from the buffer.
// Returns pointer to a _string header allocated in the current arena.
func codecDecodeString(cb *CodecBuf, ds *codecDecodeSeen) (hdr unsafe.Pointer) {
	tag := codecReadVarint(cb)
	if tag != codecTagStr { runtimePanic("codec: expected string tag") }
	ln := int32(codecReadVarint(cb))
	hdr = alloc(unsafe.Sizeof(_string{}), nil)
	if ln == 0 {
		return
	}
	ptr := alloc(uintptr(ln), nil)
	codecReadRaw(cb, ptr, uintptr(ln))
	sh := (*_string)(hdr)
	sh.ptr = (*byte)(ptr)
	sh.length = uintptr(ln)
	sh.cap = uintptr(ln)
	return
}

// codecDecodePtr reads a pointer from the buffer.
// The resulting pointer value may be nil, a backreference, or fresh allocation.
func codecDecodePtr(cb *CodecBuf, ds *codecDecodeSeen) (ptr unsafe.Pointer) {
	tag := codecReadVarint(cb)
	switch tag {
	case codecTagNil:
		return nil
	case codecTagBackref:
		idx := int32(codecReadVarint(cb))
		return codecDecodeSeenLookup(ds, idx)
	case codecTagPtr:
		var buf [8]byte
		codecReadRaw(cb, unsafe.Pointer(&buf[0]), unsafe.Sizeof(uintptr(0)))
		return *(*unsafe.Pointer)(unsafe.Pointer(&buf[0]))
	}
	runtimePanic("codecDecodePtr: bad tag")
	return nil
}

// codecDecodeSlice decodes a slice from the buffer.
// Returns pointer to a slice header allocated in the current arena.
func codecDecodeSlice(cb *CodecBuf, ds *codecDecodeSeen) (hdr unsafe.Pointer) {
	tag := codecReadVarint(cb)
	if tag != codecTagSlice { runtimePanic("codec: expected slice tag") }
	ln := int32(codecReadVarint(cb))
	cp := int32(codecReadVarint(cb))
	hdr = alloc(unsafe.Sizeof(_string{}), nil)
	if ln == 0 {
		return
	}
	ptr := alloc(uintptr(cp), nil)
	codecReadRaw(cb, ptr, uintptr(ln))
	sh := (*_string)(hdr)
	sh.ptr = (*byte)(ptr)
	sh.length = uintptr(ln)
	sh.cap = uintptr(cp)
	return
}

// codecDecodeInterface decodes an interface value from the buffer.
// Returns pointer to an _interface header in the current arena.
func codecDecodeInterface(cb *CodecBuf, ds *codecDecodeSeen) (ifacePtr unsafe.Pointer) {
	tag := codecReadVarint(cb)
	if tag != codecTagIface { runtimePanic("codec: expected iface tag") }
	ifacePtr = alloc(unsafe.Sizeof(_interface{}), nil)
	iface := (*_interface)(ifacePtr)
	// Read typecode (8 raw bytes)
	var tcBuf [8]byte
	codecReadRaw(cb, unsafe.Pointer(&tcBuf[0]), 8)
	iface.typecode = *(*unsafe.Pointer)(unsafe.Pointer(&tcBuf[0]))
	if iface.typecode != nil {
		ct := (*RawType)(iface.typecode)
		// Decode concrete value using runtime type info from typecode
		inner := codecDecodeValue(cb, ds, ct)
		iface.value = inner
	}
	return
}

// codecEncodeIfacePayload encodes the concrete value behind an interface.
// Uses the interface's own typecode (*RawType) for recursive type info.
func codecEncodeIfacePayload(cb *CodecBuf, ss *codecSeenSet, ifaceAddr unsafe.Pointer) {
	iface := *(*_interface)(ifaceAddr)
	if iface.typecode == nil {
		return
	}
	t := (*RawType)(iface.typecode)
	if t.Kind() == kindPointer || t.Size() > unsafe.Sizeof(uintptr(0)) {
		// Large value: iface.value is a pointer to the data
		codecEncodeValue(cb, ss, iface.value, t)
	} else {
		// Small value: iface.value IS the data
		codecEncodeValue(cb, ss, unsafe.Pointer(&iface.value), t)
	}
}

// codecReadStructTag validates a struct header (tag + field count).
func codecReadStructTag(cb *CodecBuf, expectedFields int32) {
	tag := codecReadVarint(cb)
	if tag != codecTagStruct {
		runtimePanic("codec: expected struct tag")
	}
	nf := int32(codecReadVarint(cb))
	if nf != expectedFields {
		runtimePanic("codec: struct field count mismatch")
	}
}

// allocRead allocates sz bytes and reads them from the codec buffer.
func allocRead(cb *CodecBuf, sz uintptr) (buf []byte) {
	buf = []byte{:sz}
	memcpy(unsafe.Pointer(&buf[0]), unsafe.Pointer(&cb.data[cb.pos]), sz)
	cb.pos += int32(sz)
	return
}

func codecDecodeMapFlagged(cb *CodecBuf, ds *codecDecodeSeen, keySz, valSz uintptr, alg uint8, fixupFlags uint8) (m *hashmap) {
	cnt := int32(codecReadVarint(cb))
	m = hashmapMake(keySz, valSz, uintptr(cnt), alg)
	if cnt == 0 { return }
	fixKey := fixupFlags&8 != 0; fixStrVal := fixupFlags&1 != 0; fixVal := fixupFlags&2 != 0; fixIface := fixupFlags&4 != 0
	for i := int32(0); i < cnt; i++ {
		var key, val []byte
		if fixKey {
			raw := codecReadBytes(cb)
			hdr := []byte{:keySz}
			*(*unsafe.Pointer)(unsafe.Pointer(&hdr[0])) = unsafe.Pointer(&raw[0])
			*(*uintptr)(unsafe.Pointer(&hdr[8])) = uintptr(len(raw))
			if keySz > 16 {
				*(*uintptr)(unsafe.Pointer(&hdr[16])) = uintptr(len(raw))
			}
			key = hdr
		} else {
			key = []byte{:keySz}
			memcpy(unsafe.Pointer(&key[0]), unsafe.Pointer(&cb.data[cb.pos]), keySz)
			cb.pos += int32(keySz)
		}
		if fixStrVal {
			raw := codecReadBytes(cb)
			hdr := []byte{:valSz}
			*(*unsafe.Pointer)(unsafe.Pointer(&hdr[0])) = unsafe.Pointer(&raw[0])
			*(*uintptr)(unsafe.Pointer(&hdr[8])) = uintptr(len(raw))
			if valSz > 16 { *(*uintptr)(unsafe.Pointer(&hdr[16])) = uintptr(len(raw)) }
			val = hdr
		} else if fixVal {
			tag := codecReadVarint(cb)
			if tag == codecTagNil {
				val = []byte{:valSz}
			} else if tag == codecTagPtr {
				// Decode pointer value; val slot gets {new_ptr}
				inner := codecDecodeValue(cb, ds, nil)
				buf := []byte{:valSz}
				*(*unsafe.Pointer)(unsafe.Pointer(&buf[0])) = inner
				val = buf
			} else {
				runtimePanic("codec bad fixVal tag")
			}
		} else if fixIface {
			tag := codecReadVarint(cb)
			if tag != codecTagIface {
				runtimePanic("codec expected iface tag for fixIface")
			}
			typRaw := codecReadBytes(cb)
			buf := []byte{:valSz}
			if len(typRaw) > 0 {
				*(*unsafe.Pointer)(unsafe.Pointer(&buf[0])) = *(*unsafe.Pointer)(unsafe.Pointer(&typRaw[0]))
				ct := (*RawType)(*(*unsafe.Pointer)(unsafe.Pointer(&typRaw[0])))
				if ct.Size() <= unsafe.Sizeof(uintptr(0)) {
					inner := codecDecodeValue(cb, ds, ct)
					memcpy(unsafe.Pointer(&buf[8]), inner, ct.Size())
				} else {
					inner := codecDecodeValue(cb, ds, ct)
					*(*unsafe.Pointer)(unsafe.Pointer(&buf[8])) = inner
				}
			}
			val = buf
		} else {
			val = []byte{:valSz}
			memcpy(unsafe.Pointer(&val[0]), unsafe.Pointer(&cb.data[cb.pos]), valSz)
			cb.pos += int32(valSz)
		}
		if uintptr(len(key)) == keySz && uintptr(len(val)) == valSz {
			h := m.keyHash(unsafe.Pointer(&key[0]), keySz, m.seed)
			hashmapSet(m, unsafe.Pointer(&key[0]), unsafe.Pointer(&val[0]), h)
		}
	}
	return
}

// codecEncodeRecvWrites encodes the receiver write table into cb.
func codecEncodeRecvWrites(cb *CodecBuf, ss *codecSeenSet, table unsafe.Pointer, count int32) {
	codecWriteVarint(cb, uint64(uint32(count)))
	entrySize := uintptr(24)
	for i := int32(0); i < count; i++ {
		ep := unsafe.Add(table, uintptr(i)*entrySize)
		valPtr := *(*unsafe.Pointer)(unsafe.Add(ep, 8))
		typeDesc := *(*unsafe.Pointer)(unsafe.Add(ep, 16))
		if typeDesc != nil {
			codecEncodeValue(cb, ss, valPtr, (*RawType)(typeDesc))
		}
	}
}

// codecDecodeRecvWrites decodes receiver writes from cb and stores decoded
// pointers back into the receiver field addresses recorded in the table.
func codecDecodeRecvWrites(cb *CodecBuf, ds *codecDecodeSeen, table unsafe.Pointer) {
	n := int32(codecReadVarint(cb))
	entrySize := uintptr(24)
	for i := int32(0); i < n; i++ {
		ep := unsafe.Add(table, uintptr(i)*entrySize)
		fieldAddr := *(*unsafe.Pointer)(unsafe.Pointer(ep))
		typeDesc := *(*unsafe.Pointer)(unsafe.Add(ep, 16))
		if typeDesc != nil && fieldAddr != nil {
			dec := codecDecodeValue(cb, ds, (*RawType)(typeDesc))
			*(*unsafe.Pointer)(fieldAddr) = dec
		}
	}
}

// codecSetTopOnlyTransient sets the store-back transient mode.
func codecSetTopOnlyTransient(b bool) {
	codecTopOnlyTransient = b
}

