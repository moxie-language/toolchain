package runtime

import "unsafe"

type CodecBuf struct {
	data    []byte
	pos     int32
}

func codecBufInit(cb *CodecBuf) {
	cb.data = make([]byte, 0, 256)
	cb.pos = 0
}

func codecWriteU32(cb *CodecBuf, v uint32) {
	cb.data = append(cb.data, byte(v), byte(v>>8), byte(v>>16), byte(v>>24))
}

func codecReadU32(cb *CodecBuf) (v uint32) {
	if int32(len(cb.data)) < cb.pos+4 { runtimePanic("codec underflow") }
	v = uint32(cb.data[cb.pos]) | uint32(cb.data[cb.pos+1])<<8 |
		uint32(cb.data[cb.pos+2])<<16 | uint32(cb.data[cb.pos+3])<<24
	cb.pos += 4; return
}

func codecWriteBytes(cb *CodecBuf, v []byte) {
	codecWriteU32(cb, uint32(len(v)))
	cb.data = append(cb.data, v...)
}

func codecReadBytes(cb *CodecBuf) (v []byte) {
	n := int32(codecReadU32(cb))
	if n == 0 { return nil }
	if int32(len(cb.data)) < cb.pos+n { runtimePanic("codec underflow") }
	v = make([]byte, n)
	memcpy(unsafe.Pointer(&v[0]), unsafe.Pointer(&cb.data[cb.pos]), uintptr(n))
	cb.pos += n; return
}

type codecSeenSet struct {
	ptrs  [64]unsafe.Pointer
	count int32
}

func codecSeenInit(ss *codecSeenSet) { ss.count = 0 }

type codecDecodeSeen struct {
	ptrs  [64]unsafe.Pointer
	count int32
}

func codecDecodeSeenInit(ds *codecDecodeSeen) { ds.count = 0 }

func codecEncodeMap(m *hashmap, cb *CodecBuf, ss *codecSeenSet, fixupFlags uint8) {
	if m == nil || m.bucketBits == 0 {
		codecWriteU32(cb, 0); return
	}
	keySz := m.keySize; valSz := m.valueSize
	bucketSz := unsafe.Sizeof(hashmapBucket{}) + keySz*8 + valSz*8
	fixKey := fixupFlags&8 != 0; fixVal := fixupFlags&2 != 0; fixIface := fixupFlags&4 != 0

	cnt := int32(0)
	nb := uintptr(1) << m.bucketBits
	for bi := uintptr(0); bi < nb; bi++ {
		for b := (*hashmapBucket)(unsafe.Add(m.buckets, bucketSz*bi)); b != nil; b = b.next {
			for i := uint8(0); i < 8; i++ { if b.tophash[i] != 0 { cnt++ } }
		}
	}
	codecWriteU32(cb, uint32(cnt))
	if cnt == 0 { return }

	for bi := uintptr(0); bi < nb; bi++ {
		for b := (*hashmapBucket)(unsafe.Add(m.buckets, bucketSz*bi)); b != nil; b = b.next {
			for i := uint8(0); i < 8; i++ {
				if b.tophash[i] != 0 {
					kp := hashmapSlotKey(m, b, i)
					vp := hashmapSlotValue(m, b, i)
					if fixKey {
						// Deep-encode string key: write actual bytes, not pointer+len
						_sh := *(*_string)(kp)
						codecWriteBytes(cb, unsafe.Slice((*byte)(_sh.ptr), _sh.length))
					} else {
						codecWriteBytes(cb, unsafe.Slice((*byte)(kp), keySz))
					}
					if fixVal {
						// Value is a pointer - encode the pointed-to data
						p := *(*unsafe.Pointer)(vp)
						if p == nil {
							codecWriteU32(cb, 0)
						} else {
							codecWriteU32(cb, uint32(valSz))
							codecWriteBytes(cb, unsafe.Slice((*byte)(p), valSz))
						}
					} else if fixIface {
						// Deep-encode interface value: follow value pointer, serialize concrete data.
						iface := *(*_interface)(vp)
						if iface.typecode == nil {
							codecWriteU32(cb, 0)
							codecWriteU32(cb, 0)
						} else {
							tc := (*rawType)(iface.typecode)
							dataSz := tc.elem().size()  // size of the pointed-to concrete type
							codecWriteBytes(cb, unsafe.Slice((*byte)(unsafe.Pointer(&iface.typecode)), 8))
							codecWriteU32(cb, uint32(dataSz))
							codecWriteBytes(cb, unsafe.Slice((*byte)(iface.value), dataSz))
						}
					} else {
						codecWriteBytes(cb, unsafe.Slice((*byte)(vp), valSz))
					}
				}
			}
		}
	}
}

func codecDecodeMapFlagged(cb *CodecBuf, ds *codecDecodeSeen, keySz, valSz uintptr, alg uint8, fixupFlags uint8) (m *hashmap) {
	cnt := int32(codecReadU32(cb))
	m = hashmapMake(keySz, valSz, uintptr(cnt), alg)
	if cnt == 0 { return }
	fixKey := fixupFlags&8 != 0; fixVal := fixupFlags&2 != 0; fixIface := fixupFlags&4 != 0
	for i := int32(0); i < cnt; i++ {
		var key, val []byte
		if fixKey {
			// Deep-decoded string key: bytes are actual string data
			raw := codecReadBytes(cb)
			// Build a fresh string header with the new allocation
			hdr := make([]byte, keySz)
			*(*unsafe.Pointer)(unsafe.Pointer(&hdr[0])) = unsafe.Pointer(&raw[0])
			*(*uintptr)(unsafe.Pointer(&hdr[8])) = uintptr(len(raw))
			if keySz > 16 {
				*(*uintptr)(unsafe.Pointer(&hdr[16])) = uintptr(len(raw))
			}
			key = hdr
		} else {
			key = codecReadBytes(cb)
		}
		if fixVal {
			n := int32(codecReadU32(cb))
			if n == 0 {
				val = make([]byte, valSz)
			} else {
				raw := codecReadBytes(cb)
				buf := make([]byte, valSz)
				*(*unsafe.Pointer)(unsafe.Pointer(&buf[0])) = unsafe.Pointer(&raw[0])
				val = buf
			}
		} else if fixIface {
			typRaw := codecReadBytes(cb)
			n := int32(codecReadU32(cb))
			if n == 0 || len(typRaw) == 0 {
				val = make([]byte, valSz)
			} else {
				raw := codecReadBytes(cb)
				buf := make([]byte, valSz)
				*(*unsafe.Pointer)(unsafe.Pointer(&buf[0])) = *(*unsafe.Pointer)(unsafe.Pointer(&typRaw[0]))
				// Allocate new memory for the concrete data and copy
				dataAlloc := alloc(uintptr(n), nil)
				memcpy(dataAlloc, unsafe.Pointer(&raw[0]), uintptr(n))
				*(*unsafe.Pointer)(unsafe.Pointer(&buf[8])) = dataAlloc
				val = buf
			}
		} else {
			val = codecReadBytes(cb)
		}
		if uintptr(len(key)) == keySz && uintptr(len(val)) == valSz {
			h := m.keyHash(unsafe.Pointer(&key[0]), keySz, m.seed)
			hashmapSet(m, unsafe.Pointer(&key[0]), unsafe.Pointer(&val[0]), h)
		}
	}
	return
}
