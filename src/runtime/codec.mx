package runtime

import (
	"unsafe"
	"moxielang.dev/pkg/mxutil"
)

// Recursive value serializer with back-references for shared/cyclic pointers.
// Encode-side tags emitted per non-trivial value:
const (
	codecTagPtr    = 0x00  // non-nil pointer: inner value follows
	codecTagStr    = 0x01  // string/[]byte: uint32 len + bytes
	codecTagSlice  = 0x02  // slice: uint32 len + uint32 cap + elements
	codecTagIface  = 0x03  // interface: 8 bytes typecode + inner value
	codecTagStruct = 0x04  // struct: uint32 nf + field encodings
	codecTagBackref = 0x05 // back-reference: uint32 index into seen set
	codecTagNil    = 0x06  // nil pointer
	codecTagStable   = 0x07 // stable pointer: raw target-word address, identity preserved
	codecTagStableSlice = 0x08 // stable string/[]byte: raw target-word header (3 words), no copy
)

// codecStrHdr is the byte width of a string/slice header ({ptr, len, cap}).
// It is three target words, not three 64-bit words: on wasm32 the header is
// 12 bytes, and encoding or decoding 24 would run past both the local and the
// allocation the decode side makes from typ.Size().
func codecStrHdr() uintptr { return unsafe.Sizeof(_string{}) }

// codecPtrSize is the target's word size. Tables of raw pointers inside the
// codec are laid out in target words.
func codecPtrSize() uintptr { return unsafe.Sizeof(uintptr(0)) }

// codecDataFloor is the lowest address a real object can occupy on this target.
// It is a property of the TARGET, not a constant, and the constant was wrong on
// wasm32: wasm-ld places the first data segment at 1024, so descriptors and
// string data legitimately live below 0x1000 there. Measured: a wasm build's
// interface type descriptor sat at 0xAC8, the encoder's plausibility guard
// (tc > 0x1000) refused it, wrote an interface tag with NO value, and the
// decoder then ran off the end of its buffer in codecReadVarint - every wasm
// program trapped in package init, which is why the wasm half of phase 5 had
// been skipped rather than failing. Native keeps the first page: mmap_min_addr
// is never below it.
func codecDataFloor() uintptr {
	if codecPtrSize() < 8 {
		return 1024
	}
	return 0x1000
}

// codecBadPtrFloor is the lowest address a pointer held IN a value may have
// before the codec calls it stale. Native keeps the 1 MiB heuristic it has
// always used: no real object is mapped below it, and a pointer there is the
// zeroed residue of a half-built frame. wasm32 cannot use it - wasm-ld places
// the stack and first data below 1 MiB, so the address of a local slot is
// routinely ~0x10000, and treating that as invalid made the encoder write
// codecTagNil for every pointer-to-pointer it was handed: fmt's newPrinter
// returned a valid *pp that the caller received as nil.
func codecBadPtrFloor() uintptr {
	if codecPtrSize() < 8 {
		return codecDataFloor()
	}
	return 1048576
}

// codecVoidPtr reports an address no allocation can start at. The native floor
// is 64 KiB, the value this check has always used to tell a stale or synthetic
// base from a live one; wasm32's data base is 1024, and using the native floor
// there silently encoded every string below 64 KiB as EMPTY - a data-loss path
// that a target-aware floor removes.
func codecVoidPtr(addr uintptr) (ok bool) {
	if codecPtrSize() < 8 {
		return addr < 1024
	}
	return addr < 65536
}

// codecArenaContains reports whether addr lies in any allocated region of a.
func codecArenaContains(a *Arena, p uintptr) (ok bool) {
	if a == nil {
		return false
	}
	for i := int32(0); i < a.nregions; i++ {
		if p >= a.regions[i].base && p < a.regions[i].base+a.regions[i].cap {
			return true
		}
	}
	return false
}

// codecArenaContainsAddr is codecArenaContains with the arena as an address, for
// callers on the stability test's hot path, where fetching a pointer-typed arena
// would pay the very protocol the test exists to skip.
func codecArenaContainsAddr(a, p uintptr) (ok bool) {
	if a == 0 {
		return false
	}
	ar := (*Arena)(unsafe.Pointer(a))
	for i := int32(0); i < ar.nregions; i++ {
		if p >= ar.regions[i].base && p < ar.regions[i].base+ar.regions[i].cap {
			return true
		}
	}
	return false
}

// codecIsStableAddr reports whether addr lives outside all transient
// function arenas (i.e. in the root arena, a global, the stack, or a
// sovereign arena currently borrowed / registered stable by a method).
// When codecTopOnlyTransient is set (sovereign store-backs), only the
// CURRENT fn arena (the method's scratch) counts as transient: data in
// the caller's arenas must keep its identity instead of being copied.
// codecIsStableAddr reports whether a pointer may be kept by identity
// (aliased) instead of being copied. Stack memory is never stable: frames are
// reclaimed on return but are not arenas, so the arena scans below cannot see
// them. Without this, returning a slice of a local array (sha256.Sum256(x)[:]
// in event.Hash and every similar helper) handed the caller a pointer into a
// frame that had already returned.
func codecIsStableAddr(p uintptr) (ok bool) {
	if codecOnStack(p) {
		return false
	}
	return codecIsStableArenaAddr(p)
}

// codecIsStableArenaAddr is the arena-only half of codecIsStableAddr.
func codecIsStableArenaAddr(p uintptr) (ok bool) {
	if domainRoot == nil {
		return true
	}
	if codecCrossDomain {
		// A spawn payload is read by a forked process: an alias is an address
		// in THIS address space, so the receiver would read its own copy of
		// that page. Measured as a zeroed payload with the right length.
		return false
	}
	// The ROOT arena never dies, so a pointer into it is never transient, in
	// any encode mode: not at a return, not in a sovereign store-back, not as
	// a plain value. The root can only appear ON the fn stack through a
	// temporary SetCurrentArena(RootArena()) switch - the root-arena idiom in
	// src/net/hosts.mx and net/http's mux registration - and treating it as a
	// callee's frame made every pointer such a function built get COPIED into
	// the caller's arena while the receiver stored the original. Measured on
	// the classic ServeMux: the child registration returned and the child the
	// tree stored were different nodes, the method level was written to the
	// copy, and every registration shape (exact, subtree, method, host)
	// answered pattern=[].
	if codecArenaContainsAddr(rootArenaAddr(), p) {
		return true
	}
	if codecRetTransient {
		// Return-value encoding. The callee's working arena is the top of the
		// fn stack, and it dies at return in both shapes: a plain frame is
		// popped and released, and a borrowed sovereign data arena has this
		// call's batch reclaimed by codecSovereignEndCall (and any later method
		// boundary on the same receiver can copy-compact it). Aliasing data
		// from it hands the caller memory the receiver is free to reclaim, so
		// the top frame is always transient - borrowed or not. This must be
		// decided before the stableArena test: a mutating method registers the
		// same borrowed arena as stable, and that early "true" is what handed
		// back an event whose ID slice pointed into a reclaimed data arena.
		// Ancestor arenas keep identity: caller locals passed as receivers to
		// nested calls must still alias.
		if domainRoot.fnTop >= 1 {
			top := domainRoot.fnStack[domainRoot.fnTop]
			if codecArenaContains(top, p) {
				return false
			}
			// A sovereign group whose receiver lives in the frame being
			// released is freed with it (sovInvalidateArena). Data owned by
			// such a group must be copied, not aliased.
			if sovGroupInDyingArena(top, p) {
				return false
			}
		}
		if codecOnStack(p) {
			return false
		}
	}
	if domainRoot.stableArena != nil && codecArenaContains(domainRoot.stableArena, p) {
		return true
	}
	if codecTopOnlyTransient {
		// Sovereign store-back. A pointer written into the receiver is aliased
		// only when the arena holding it outlives the receiver's own arena.
		//
		// The receiver's arena is the borrowed sovereign scratch frame nearest
		// the top of the stack; everything above it is the method's own frame
		// and its callees' frames, all of which die at the method's return, so
		// data from them must be copied. Treating every non-sovereign frame as
		// stable aliased helper results into the receiver's data arena, and
		// they dangled the moment the helper returned - a parsed filter kept
		// kind and tag lists that pointed at a released helper frame, which is
		// the SIGSEGV in the store scan and in tag.(*T).Len.
		owner := int32(-1)
		for i := domainRoot.fnTop; i >= 1; i-- {
			if domainRoot.sovScratch[i>>6]&(1<<(i&63)) != 0 {
				owner = i
				break
			}
		}
		for i := owner + 1; i <= domainRoot.fnTop; i++ {
			if codecArenaContains(domainRoot.fnStack[i], p) {
				return false
			}
		}
		// Ancestors below the receiver's arena keep identity, except the
		// sovereign scratch frames, which the store-back reclaims itself.
		for i := int32(1); i <= owner; i++ {
			if domainRoot.sovScratch[i>>6]&(1<<(i&63)) == 0 {
				continue
			}
			if codecArenaContains(domainRoot.fnStack[i], p) {
				return false
			}
		}
		return true
	}
	if codecRetTransient {
		// Data in a sovereign data arena belongs to a receiver and can be
		// reclaimed by that receiver's compaction at any later method
		// boundary, so the caller must get a copy. The receiver's own arena
		// was handled above and keeps identity (that is the read-only view
		// case), so this only fires for arenas the current frame does not own.
		if sovInSovereignDataArena(p) {
			return false
		}
		return true
	}
	nreg := domainRoot.fnTop
	if nreg < 0 {
		nreg = 0
	}
	for i := int32(1); i <= nreg; i++ {
		if domainRoot.fnBorrow[i>>6]&(1<<(i&63)) != 0 {
			continue
		}
		if codecArenaContains(domainRoot.fnStack[i], p) {
			return false
		}
	}
	return true
}

// codecSovDataAlias reports whether p points at an object that lives in a
// live sovereign data arena and may therefore be kept by identity across the
// current return. Identity is what makes one object one object: copying it
// splits the receiver's state in two, and both halves keep mutating.
// png.Encode lost its bufio.Writer this way - the encoder's own `bw` field and
// the writer zlib held through flate's dictWriter became two buffers, so the
// compressed block went into the copy's buffer and the flush emitted an
// 18-byte IDAT where Go emits 29.
//
// The arena belongs to a receiver, so an alias handed outward must not be
// moved: the group is marked escaped, which is the same promise the other
// stable paths make (codecNoteStable). A group that dies with the frame being
// released is never aliased - codecIsStableArenaAddr already answered "copy"
// for it before this is asked - so the alias cannot outlive its arena.
// Value data (byte/slice backing) is still copied on return; only objects are
// aliased, because a copied object is a wrong program while a copied byte
// range is only a copied value.
func codecSovDataAlias(p uintptr) (ok bool) {
	return codecSovDataLive(p)
}

// codecSovDataLive reports whether p points into a sovereign data arena that
// outlives the frame now returning, and marks that group escaped so nothing
// compacts the block away while an alias of it is in the caller's hands.
//
// A sovereign arena lives exactly as long as its receiver, so a pointer into
// one is not transient just because this frame is returning: it is transient
// only when the RECEIVER itself lives in the frame being released, which is
// what sovGroupInDyingArena answers. Without this, a struct aliased by identity
// (a read-only method returning its receiver's objects) was still declared
// "dying" by retPointeeDies purely because one of its fields pointed into the
// pointee's OWN sovereign arena, and the whole object was deep-copied: every
// mutation after the return landed on the copy. The store's
// Engine.allFiles -> flushSidecars path lost every flush bookkeeping update
// that way, while the copies still wrote to the same file descriptors, so the
// .buf sidecar accumulated duplicate records and a range scan that sized
// itself from Count() silently dropped the newest event.
func codecSovDataLive(p uintptr) (ok bool) {
	if !codecRetTransient || domainRoot == nil {
		return false
	}
	g := sovRangeOwner(p)
	if g == nil || g.released || g.data == nil {
		return false
	}
	if domainRoot.fnTop >= 1 && sovGroupInDyingArena(domainRoot.fnStack[domainRoot.fnTop], p) {
		return false
	}
	g.escaped = true
	return true
}

// codecOnStack reports whether p addresses the current thread's stack. Stack
// frames are not arenas, so callers must copy stack-backed data rather than
// alias it across a return.
func codecOnStack(p uintptr) (ok bool) {
	if stackTop == 0 {
		return false
	}
	sp := getCurrentStackPointer()
	return p >= sp && p < stackTop
}

// codecCrossDomain: the value is being encoded to cross a DOMAIN boundary (a
// spawn channel), where the receiver is a forked process and an aliased pointer
// names memory in the sender's address space. No stable shortcut is legal
// there: every slice/string/pointer must be written out by value.
var codecCrossDomain bool

// codecTopOnlyTransient: see codecIsStableAddr.
var codecTopOnlyTransient bool

// codecRetTransient: see codecIsStableAddr. Set by the compiler around
// return-value encoding.
var codecRetTransient bool

// codecNoteStable marks the owner arena of a stable emission as escaped
// when the pointer targets a sovereign data arena: external holders now
// reference it, so it must not be compacted.
func codecNoteStable(p uintptr) {
	if domainRoot == nil || domainRoot.stableArena == nil {
		return
	}
	a := domainRoot.stableArena
	if a.sovereign != 0 && a.owner != nil && codecArenaContains(a, p) {
		a.owner.escaped = true
	}
}

type CodecBuf struct {
	data    []byte
	pos     int32
}

// codecEscapePtr is set when a pointer into a transient fn arena escapes
// with a basic (unknown-length) pointee. The fn arena must then be leaked
// instead of released.
var codecEscapePtr bool

// codecEscapeOccurred reports and clears the escape flag.
func codecEscapeOccurred() (b bool) {
	b = codecEscapePtr
	codecEscapePtr = false
	return b
}

// An escape used to be silent. Before the leak it dangled and the process died
// later in an unrelated frame - the SIGSEGV in tag.(*T).Len was this pointer -
// and after it the only symptom is a slow RSS climb, which is exactly the kind
// of quiet failure that should be loud. Warn once (a hot loop can escape on
// every iteration), then report the running count every 1024 so the rate stays
// measurable without flooding stderr.
var codecEscapeWarned bool
var codecEscapeCount int32

func codecEscWarn(msg string) {
	if len(msg) == 0 {
		return
	}
	MoxieWrite(2, unsafe.Pointer(&([]byte(msg))[0]), int32(len(msg)))
}

func codecEscWarnInt(msg string, n int32) {
	codecEscWarn(msg)
	buf := []byte{:12}
	i := int32(len(buf))
	if n == 0 {
		i--
		buf[i] = '0'
	}
	for n > 0 {
		i--
		buf[i] = byte('0' + (n % 10))
		n = n / 10
	}
	MoxieWrite(2, unsafe.Pointer(&buf[i]), int32(len(buf))-i)
	codecEscWarn("\n")
}

func codecEscapeNote() {
	codecEscapePtr = true
	codecEscapeCount++
	if codecEscapeCount == 1 {
		codecEscWarn("moxie: codec arena escape: pointer into a transient frame arena preserved instead of copied (unknown-extent pointee); that frame arena is leaked for the pointer's lifetime\n")
		return
	}
	if codecEscapeCount%1024 == 0 {
		codecEscWarnInt("moxie: codec arena escapes so far: ", codecEscapeCount)
	}
}

// codecRetStable reports whether a returned value needs no relocation at all:
// every pointer it holds is nil, or already stable by identity, so the encode
// would take its codecTagStable branch for each of them and the decode would
// hand the same addresses back. When that is true the epilogue can skip the
// whole return protocol - buffer init, seen-set init, the descriptor walk, the
// encode, the decode and the seen-set teardown - and return the value.
//
// It mirrors codecEncodeValue's own decisions field by field, in return mode: a
// stable pointer encodes raw, a slice encodes raw unless its elements can hold
// transient data (the codec walks those), and anything the codec necessarily
// walks - a map, an interface, a function value, an array - answers false so the
// real protocol runs. A pointer that looks invalid answers false for the same
// reason: the encode turns those into nil, and this must not hand the caller a
// pointer the codec would have dropped.
func codecRetStable(ptr unsafe.Pointer, typ *RawType) (ok bool) {
	if typ == nil || ptr == nil {
		return false
	}
	save := codecRetTransient
	codecRetTransient = true
	ok = codecRetStableInner(ptr, uintptr(unsafe.Pointer(typ)))
	codecRetTransient = save
	return ok
}

// retUnderAddr follows the named chain to the underlying descriptor and returns
// it as an ADDRESS, not a pointer.
//
// The type kind accessors (Underlying, StructFieldType, Elem) all return
// *RawType, and every pointer-returning call pays the return protocol: about
// 100 ns each even on round 283's fast path. The walk makes a dozen of them for
// a three-field struct, which was 900 ns of time.Now's 1250 (measured by forcing
// this helper to answer true: 345 ns). Scalars in, scalars out.
func retUnderAddr(tp uintptr) (u uintptr) {
	for {
		if tp == 0 {
			return 0
		}
		t := (*RawType)(unsafe.Pointer(tp))
		if !t.IsNamed() {
			return tp
		}
		tp = uintptr(unsafe.Pointer((*rtElemType)(unsafe.Pointer(t)).elem))
	}
}

// retFieldOffset decodes a field descriptor's varint offset.
func retFieldOffset(data unsafe.Pointer) (off uintptr) {
	p := (*uint8)(unsafe.Add(data, 1)) // skip flags byte
	var shift uint32
	for {
		b := *p
		off |= uintptr(b&0x7f) << shift
		if b&0x80 == 0 {
			return off
		}
		shift += 7
		p = (*uint8)(unsafe.Add(unsafe.Pointer(p), 1))
	}
}

// retKindOf reads the kind straight out of the descriptor's meta byte. A named
// descriptor carries its underlying kind there (which is why codecEncodeValue
// switches on Kind() for named structs), so this is the same answer Kind() gives
// without a call: on the return path the check is measured in call overhead, not
// in work.
func retKindOf(tp uintptr) (k Kind) {
	if tp == 0 {
		return Invalid
	}
	if tp&0b11 != 0 {
		return KindPointer
	}
	return Kind((*RawType)(unsafe.Pointer(tp)).meta & kindMask)
}

// retFieldOffsetAt decodes field i's varint offset from the struct descriptor.
func retFieldOffsetAt(st *rtStructType, i int32) (off uintptr) {
	fd := (*rtStructFieldDesc)(unsafe.Add(unsafe.Pointer(&st.fields[0]), uintptr(i)*unsafe.Sizeof(rtStructFieldDesc{})))
	p := (*uint8)(unsafe.Add(fd.data, 1)) // skip flags byte
	var shift uint32
	for {
		b := *p
		off |= uintptr(b&0x7f) << shift
		if b&0x80 == 0 {
			return off
		}
		shift += 7
		p = (*uint8)(unsafe.Add(unsafe.Pointer(p), 1))
	}
}

func codecRetStableInner(ptr unsafe.Pointer, tp uintptr) (ok bool) {
	if ptr == nil || tp == 0 {
		return false
	}
	switch retKindOf(tp) {
	case KindPointer:
		p := *(*unsafe.Pointer)(ptr)
		if p == nil {
			return true
		}
		if uintptr(p) < codecBadPtrFloor() {
			return false
		}
		if !codecIsStableAddr(uintptr(p)) {
			return false
		}
		return !retPointeeDies(p, retElemAddr(tp))
	case KindBytes:
		sv := *(*_string)(ptr)
		if sv.ptr == nil {
			return true
		}
		if uintptr(unsafe.Pointer(sv.ptr)) < 65536 {
			return false
		}
		return codecIsStableAddr(uintptr(unsafe.Pointer(sv.ptr)))
	case KindSlice:
		sl := *(*_string)(ptr)
		u := retUnderAddr(tp)
		if u == 0 {
			return false
		}
		elem := uintptr(unsafe.Pointer((*rtElemType)(unsafe.Pointer(u)).elem))
		if elem == 0 {
			return false
		}
		// A nil base is stable whatever the length; a base in the frame is not,
		// even at length zero. Answering stable for an EMPTY slice with a frame
		// base hands the caller a pointer into a released arena, and the first
		// write through it lands in whatever the next allocation put there -
		// measured as an ASN.1 integer whose first byte read 00 instead of 02.
		if sl.ptr == nil {
			return true
		}
		if sl.length > 0 && retKindHasPtrs(elem, 0) {
			return false
		}
		return codecIsStableAddr(uintptr(unsafe.Pointer(sl.ptr)))
	case KindStruct:
		u := retUnderAddr(tp)
		if u == 0 {
			return false
		}
		st := (*rtStructType)(unsafe.Pointer(u))
		nf := int32(st.numField)
		for i := int32(0); i < nf; i++ {
			fd := (*rtStructFieldDesc)(unsafe.Add(unsafe.Pointer(&st.fields[0]), uintptr(i)*unsafe.Sizeof(rtStructFieldDesc{})))
			if fd.fieldType == nil {
				return false
			}
			if !codecRetStableInner(unsafe.Add(ptr, retFieldOffsetAt(st, i)), uintptr(unsafe.Pointer(fd.fieldType))) {
				return false
			}
		}
		return true
	}
	return isBasicKind(retKindOf(tp))
}

// retPointeeDies reports whether a value of type tp at p holds a reference into
// memory that dies with this return.
//
// This is the check the return protocol was missing: a pointer that itself
// lives in an ancestor arena was aliased, and its referents were never looked
// at. NewUnauthenticatedCipher allocates its Cipher in its own frame, the inner
// constructor fills in c.key from ITS frame and hands c back - c is an ancestor
// address, stable by identity, so the encode wrote the pointer raw - and the
// inner frame was then released and reused by the Poly1305 work. The struct
// survived, the key it pointed at read all zeros. A slice field whose backing
// store is in the dying frame is exactly as transient as the struct itself
// would have been.
//
// One level deep is enough. The answer only chooses between aliasing the whole
// graph and re-encoding it, and the re-encode walks every level; a reference
// that is already stable cannot become transient later, because a return is the
// only sanctioned way to move data out of a frame and every return is checked
// by this same rule.
func retPointeeDies(p unsafe.Pointer, tp uintptr) (ok bool) {
	if p == nil || tp == 0 {
		return false
	}
	switch retKindOf(tp) {
	case KindPointer, KindUnsafePointer:
		q := *(*unsafe.Pointer)(p)
		return q != nil && uintptr(q) >= codecBadPtrFloor() && !codecIsStableAddr(uintptr(q)) &&
			!codecSovDataLive(uintptr(q))
	case KindBytes, KindSlice:
		sv := *(*_string)(p)
		return sv.ptr != nil && !codecIsStableAddr(uintptr(unsafe.Pointer(sv.ptr))) &&
			!codecSovDataLive(uintptr(unsafe.Pointer(sv.ptr)))
	case KindStruct:
		u := retUnderAddr(tp)
		if u == 0 {
			return false
		}
		st := (*rtStructType)(unsafe.Pointer(u))
		nf := int32(st.numField)
		for i := int32(0); i < nf; i++ {
			fd := (*rtStructFieldDesc)(unsafe.Add(unsafe.Pointer(&st.fields[0]), uintptr(i)*unsafe.Sizeof(rtStructFieldDesc{})))
			ft := uintptr(unsafe.Pointer(fd.fieldType))
			if ft == 0 || !retKindHasPtrs(ft, 0) {
				continue
			}
			if retPointeeDies(unsafe.Add(p, retFieldOffsetAt(st, i)), ft) {
				return true
			}
		}
		return false
	case KindArray:
		u := retUnderAddr(tp)
		if u == 0 {
			return false
		}
		elem := uintptr(unsafe.Pointer((*rtElemType)(unsafe.Pointer(u)).elem))
		if elem == 0 || !retKindHasPtrs(elem, 0) {
			return false
		}
		eu := retUnderAddr(elem)
		if eu == 0 {
			return false
		}
		esz := (*RawType)(unsafe.Pointer(eu)).Size()
		if esz == 0 {
			return false
		}
		n := (*RawType)(unsafe.Pointer(u)).ArrayLen()
		for i := int32(0); i < n; i++ {
			if retPointeeDies(unsafe.Add(p, uintptr(i)*esz), elem) {
				return true
			}
		}
		return false
	case KindMap, KindChan, KindFunc:
		q := *(*unsafe.Pointer)(p)
		return q != nil && uintptr(q) >= codecBadPtrFloor() && !codecIsStableAddr(uintptr(q)) &&
			!codecSovDataLive(uintptr(q))
	}
	return false
}

// retElemAddr returns the element type of tp as an address, without a pointer
// return (the return protocol costs ~100 ns each and this is asked per pointer
// result). Mirrors RawType.Elem.
func retElemAddr(tp uintptr) (r0 uintptr) {
	if tp == 0 {
		return 0
	}
	if tag := tp & 0b11; tag != 0 {
		return tp - 1
	}
	for {
		t := (*RawType)(unsafe.Pointer(tp))
		if !t.IsNamed() {
			break
		}
		tp = uintptr(unsafe.Pointer((*rtElemType)(unsafe.Pointer(t)).elem))
		if tp == 0 {
			return 0
		}
	}
	if retKindOf(tp) == KindPointer {
		return uintptr(unsafe.Pointer((*rtPtrType)(unsafe.Pointer(tp)).elem))
	}
	return uintptr(unsafe.Pointer((*rtElemType)(unsafe.Pointer(tp)).elem))
}

// retKindHasPtrs is sovTypeHasPtrs with an address in and no pointer returns, for
// the slice case above: a slice whose elements can hold pointers is walked by the
// codec, so the check has to answer false for it.
func retKindHasPtrs(tp uintptr, depth int32) (ok bool) {
	if tp == 0 || depth > 8 {
		return false
	}
	switch retKindOf(tp) {
	case KindBytes, KindPointer, KindSlice, KindInterface, KindMap, KindChan, KindFunc:
		return true
	case KindArray:
		u := retUnderAddr(tp)
		if u == 0 {
			return false
		}
		elem := uintptr(unsafe.Pointer((*rtElemType)(unsafe.Pointer(u)).elem))
		return retKindHasPtrs(elem, depth+1)
	case KindStruct:
		u := retUnderAddr(tp)
		if u == 0 {
			return false
		}
		st := (*rtStructType)(unsafe.Pointer(u))
		nf := int32(st.numField)
		for i := int32(0); i < nf; i++ {
			fd := (*rtStructFieldDesc)(unsafe.Add(unsafe.Pointer(&st.fields[0]), uintptr(i)*unsafe.Sizeof(rtStructFieldDesc{})))
			if retKindHasPtrs(uintptr(unsafe.Pointer(fd.fieldType)), depth+1) {
				return true
			}
		}
	}
	return false
}

// codecBufScratch is the reusable encode buffer. The structural codec never
// re-enters compiled code, so only one encode is in flight at a time, and the
// epilogue reads the encoded bytes during its decode before the next encode
// begins. A fresh 256-byte buffer per call is 2 KiB of waste for the encode
// and decode pair, on every call that returns a pointer-containing value -
// which for the compiler is every call, inside a per-frame arena that never
// reclaims it. Growth past 256 bytes still allocates, as before.
var codecBufScratch [256]byte

func codecBufInit(cb *CodecBuf) {
	cb.data = codecBufScratch[:0]
	cb.pos = 0
	codecEscapePtr = false
}

// codecEnsure is a free function that returns the grown slice: the new backing
// array is allocated in ITS frame, and only a RETURN value is relocated into
// the caller's arena. Writing the new header through a parameter would leave
// the array in this frame to be released with it. The caller stores the result
// into the CodecBuf field; old backing arrays are left to the arena.
func codecEnsure(data []byte, n int32) (r0 []byte) {
	if len(data)+n <= cap(data) {
		return data
	}
	need := (len(data) + n) * 2
	if need < 256 {
		need = 256
	}
	nb := []byte{:need}
	copy(nb, data)
	r0 = resize(nb, len(data))
	return r0
}

func codecWriteU32(cb *CodecBuf, v uint32) {
	cb.data = codecEnsure(cb.data, 4)
	cb.data = mxutil.Ensure(cb.data, 1)
	push(cb.data, byte(v), byte(v>>8), byte(v>>16), byte(v>>24))
}

func codecReadU32(cb *CodecBuf) (v uint32) {
	v = uint32(cb.data[cb.pos]) | uint32(cb.data[cb.pos+1])<<8 |
		uint32(cb.data[cb.pos+2])<<16 | uint32(cb.data[cb.pos+3])<<24
	cb.pos += 4; return
}

// codecWriteVarint writes v as a LEB128 unsigned varint (1-10 bytes).
// Used for type tags and encoded lengths; u64 range future-proofs the format.
func codecWriteVarint(cb *CodecBuf, v uint64) {
	cb.data = codecEnsure(cb.data, 10)
	for {
		b := byte(v & 0x7f)
		v >>= 7
		if v == 0 {
			push(cb.data, b)
			break
		}
		push(cb.data, b|0x80)
	}
}

func codecReadVarint(cb *CodecBuf) (v uint64) {
	var shift uint32
	for {
		b := cb.data[cb.pos]
		cb.pos++
		v |= uint64(b&0x7f) << shift
		if b&0x80 == 0 {
			break
		}
		shift += 7
	}
	return
}

func codecWriteBytes(cb *CodecBuf, v []byte) {
	codecWriteVarint(cb, uint64(uint32(len(v))))
	if len(v) > 0 {
		codecWriteRaw(cb, unsafe.Pointer(&v[0]), uintptr(len(v)))
	}
}

func codecReadBytes(cb *CodecBuf) (v []byte) {
	n := int32(codecReadVarint(cb))
	if n == 0 { return nil }
	if int32(len(cb.data)) < cb.pos+n { runtimePanic("codec underflow") }
	v = []byte{:n}
	memcpy(unsafe.Pointer(&v[0]), unsafe.Pointer(&cb.data[cb.pos]), uintptr(n))
	cb.pos += n; return
}

type codecSeenSet struct {
	ptrs  []unsafe.Pointer
	count int32
}

const codecSeenCap = 65536

// codecSeenTab is the reusable encode-side seen table (the same 256-entry
// capacity the per-call table had; a larger graph still grows it). A seen set is live
// only for the duration of one encode (or decode), so a fresh 256-pointer
// table per call is pure waste - and it is 2 KiB the per-frame arena never
// reclaims. The compiler runs the codec on every call that returns a pointer,
// inside a per-package arena, so that waste was 3.8 GB of a ~5 GB peak.
var codecSeenTab [256]unsafe.Pointer

func codecSeenInit(ss *codecSeenSet) {
	ss.ptrs = codecSeenTab[:0]
	ss.count = 0
}

// Seen entries are (address, encoded object size) PAIRS stored back to back in
// the ptrs slice, with count counting pairs. The struct layout is unchanged: the
// epilogue allocates codecSeenSet from the emitted IR of both compilers.
//
// The size is part of the key. An address alone over-claims identity in one
// direction: a struct shares its address with its first field, so when only the
// smaller object has been registered the back-reference resolves to a block that
// is missing the enclosing object's tail. crypto/ecdh.PrivateKey holds
// *fips140/ecdh.PrivateKey, whose first field is its PublicKey; the outer key's
// fips pointer back-referenced the PublicKey entry, the PrivateKey was never
// encoded, and the decoded key's private scalar read as a 16-byte slice over the
// neighbouring allocation ("invalid scalar length" out of ECDH). A pointer to a
// SMALLER object at a registered address is the other direction and must stay a
// back-reference: fmt's printer holds `buf *[]byte` pointing at its own first
// field, and re-encoding that slice instead of preserving the address left every
// formatted argument writing into a copy that never reached the printer's
// buffer.
//
// So: a back-reference is correct exactly when the registered object covers the
// pointee, entrySize >= pointeeSize. The decoder's table stays one word per
// entry (it only needs the address), and the pair index is the back-reference
// index, so the two tables stay position-aligned.
func codecSeenLookup(ss *codecSeenSet, p unsafe.Pointer, sz uintptr) int32 {
	for i := int32(0); i < ss.count; i++ {
		if ss.ptrs[i*2] == p && uintptr(ss.ptrs[i*2+1]) >= sz { return i }
	}
	return -1
}

func codecSeenAdd(ss *codecSeenSet, p unsafe.Pointer, sz uintptr) int32 {
	if ss.count >= codecSeenCap { return -1 }
	ss.ptrs = mxutil.Ensure(ss.ptrs, 2)
	ss.ptrs = push(ss.ptrs, p, unsafe.Pointer(sz))
	n := ss.count
	ss.count++
	return n
}

// codecPointeeSize is the encoded size of the object a pointer type addresses.
func codecPointeeSize(typ *RawType) (sz uintptr) {
	et := typ.Elem()
	if et == nil {
		return 0
	}
	return uintptr(et.Size())
}

type codecDecodeSeen struct {
	ptrs  []unsafe.Pointer
	count int32
}

// codecDecodeSeenTab is the reusable decode-side seen table.
var codecDecodeSeenTab [256]unsafe.Pointer

func codecDecodeSeenInit(ds *codecDecodeSeen) {
	ds.ptrs = codecDecodeSeenTab[:0]
	ds.count = 0
}

func codecDecodeSeenAdd(ds *codecDecodeSeen, p unsafe.Pointer) int32 {
	if ds.count >= codecSeenCap { return -1 }
	ds.ptrs = mxutil.Ensure(ds.ptrs, 1)
	ds.ptrs = push(ds.ptrs, p)
	n := ds.count
	ds.count++
	return n
}

func codecDecodeSeenLookup(ds *codecDecodeSeen, idx int32) unsafe.Pointer {
	if idx >= ds.count { return nil }
	return ds.ptrs[idx]
}

func isBasicKind(k Kind) bool {
	return k == Bool || k == Int || k == Int8 || k == Int16 || k == Int32 || k == Int64 ||
		k == Uint || k == Uint8 || k == Uint16 || k == Uint32 || k == Uint64 || k == Uintptr ||
		k == Float32 || k == Float64 || k == KindUnsafePointer || k == KindChan || k == KindFunc
}

func codecEncodeValue(cb *CodecBuf, ss *codecSeenSet, ptr unsafe.Pointer, typ *RawType) {
	if typ == nil {
		runtimePanic("codecEncodeValue nil typ")
	}
	badPtr := ptr == nil || uintptr(ptr) < codecBadPtrFloor()
	k := typ.Kind()
	if badPtr && k != KindStruct {
		switch k {
	case KindBytes:
			codecWriteVarint(cb, codecTagStr)
			codecWriteVarint(cb, uint64(0))
			codecWriteVarint(cb, uint64(0))
			return
		case KindSlice:
			codecWriteVarint(cb, codecTagSlice)
			codecWriteVarint(cb, uint64(0))
			codecWriteVarint(cb, uint64(0))
			return
		case KindPointer:
			codecWriteVarint(cb, codecTagNil)
			return
		case KindStruct:
			codecWriteVarint(cb, codecTagStruct)
			codecWriteVarint(cb, uint64(0))
			return
		case KindMap:
			codecWriteVarint(cb, codecTagNil)
			return
		case KindInterface:
			codecWriteVarint(cb, codecTagIface)
			codecWriteVarint(cb, uint64(0))
			return
		default:
			codecWriteVarint(cb, codecTagNil)
			return
		}
	}
	if isBasicKind(k) {
		sz := typ.Size()
		if sz > 65536 {
			runtimePanic("codec basic bad size")
		}
		codecWriteRaw(cb, ptr, uintptr(sz))
		return
	}
	switch k {
	case KindBytes:
		s := *(*_string)(ptr)
		if s.length > 0 && s.ptr != nil && codecIsStableAddr(uintptr(unsafe.Pointer(s.ptr))) {
			codecNoteStable(uintptr(unsafe.Pointer(s.ptr)))
			codecWriteVarint(cb, codecTagStableSlice)
			codecWriteRaw(cb, unsafe.Pointer(&s), codecStrHdr())
			return
		}
		if s.length > 0 && (s.ptr == nil || codecVoidPtr(uintptr(unsafe.Pointer(s.ptr)))) {
			codecWriteVarint(cb, codecTagStr)
			codecWriteVarint(cb, uint64(0))
			codecWriteVarint(cb, uint64(0))
			return
		}
		if s.length > 2*1024*1024*1024 {
			n := uint32(0)
			if s.cap > 0 && s.cap <= 65536 { n = uint32(s.cap) }
			codecWriteVarint(cb, codecTagStr)
			codecWriteVarint(cb, uint64(n))
			codecWriteVarint(cb, uint64(n))
			for i := uint32(0); i < n; i++ {
				codecWriteU8(cb, 0)
			}
			return
		}
		codecWriteVarint(cb, codecTagStr)
		codecWriteVarint(cb, uint64(uint32(s.length)))
		codecWriteVarint(cb, uint64(uint32(s.cap)))
		if s.length > 0 {
			codecWriteRaw(cb, unsafe.Pointer(s.ptr), uintptr(s.length))
		}
	case KindSlice:
		sl := *(*_string)(ptr)
		elemType := typ.Elem()
		// A stable backing array is only a safe shortcut when the elements
		// cannot themselves reference transient data. During a sovereign
		// store-back (codecTopOnlyTransient) a slice's backing may already
		// live in the data arena while a freshly-pushed element points into
		// the scratch fn arena; walk such elements so the pointer targets
		// get relocated.
		//
		// The same holds during a return (codecRetTransient). The callee's
		// frame is released right after the encode, and FnArenaPop hands its
		// region to the next callee, so an element allocated in that frame is
		// dead even though the backing array it was pushed into lives in the
		// caller's arena and is therefore "stable". Skipping the walk left
		// every element after the first pointing at one recycled slot:
		// `Ret(nil,..)` three times returned rows that all read the third
		// call's row (`d1 a1 a1`). The element walk is O(len) instead of O(1)
		// for such slices, which is the trade-off already accepted for the
		// sovereign store-back.
		if sl.ptr != nil && codecIsStableAddr(uintptr(unsafe.Pointer(sl.ptr))) &&
			!(sl.length > 0 && (codecTopOnlyTransient || codecRetTransient) && elemType != nil && sovTypeHasPtrs(elemType)) {
			codecNoteStable(uintptr(unsafe.Pointer(sl.ptr)))
			codecWriteVarint(cb, codecTagStableSlice)
			codecWriteRaw(cb, unsafe.Pointer(&sl), codecStrHdr())
			return
		}
		codecWriteVarint(cb, codecTagSlice)
		codecWriteVarint(cb, uint64(uint32(sl.length)))
		codecWriteVarint(cb, uint64(uint32(sl.cap)))
		for i := int32(0); i < int32(sl.length); i++ {
			ep := unsafe.Add(unsafe.Pointer(sl.ptr), uintptr(i)*elemType.Size())
			codecEncodeValue(cb, ss, ep, elemType)
		}
	case KindPointer:
		// Bad pointer check: if ptr looks invalid (low address, nil, etc.)
		// emit nil instead of dereferencing.
		if ptr == nil || uintptr(ptr) < codecBadPtrFloor() {
			codecWriteVarint(cb, codecTagNil)
			return
		}
		p := *(*unsafe.Pointer)(ptr)
		if p == nil {
			codecWriteVarint(cb, codecTagNil)
			return
		}
		idx := codecSeenLookup(ss, p, codecPointeeSize(typ))
		if idx >= 0 {
			codecWriteVarint(cb, codecTagBackref)
			codecWriteVarint(cb, uint64(uint32(idx)))
			return
		}
		// The target is registered only by the paths that do NOT descend into
		// it (stable, escaped). A descending pointer leaves registration to the
		// pointee's own branch, which registers its address BEFORE its children
		// on both sides - adding it here as well was a second entry the decoder
		// did not make, and that asymmetry is what shifted back-references.
		//
		// A stable ADDRESS is not a stable OBJECT: the pointee can be an
		// ancestor's struct that this frame filled with slices of its own
		// memory (retPointeeDies), and aliasing that hands back a struct whose
		// fields point into a released frame. Below the same 1 MiB threshold the
		// bad-pointer check at the top of this branch uses, there is nothing to
		// read: those values were aliased as garbage before this check existed
		// and reading them is the SIGSEGV (a zeroed pointer field of a partially
		// built TLS state).
		if codecIsStableAddr(uintptr(p)) &&
			(uintptr(p) < codecBadPtrFloor() || !retPointeeDies(p, retElemAddr(uintptr(unsafe.Pointer(typ))))) {
			codecSeenAdd(ss, p, codecPointeeSize(typ))
			codecNoteStable(uintptr(p))
			codecWriteVarint(cb, codecTagStable)
			codecWriteRaw(cb, unsafe.Pointer(&p), codecPtrSize())
			return
		}
		// Pointer into a transient fn arena whose pointee is a basic
		// (unknown-length, e.g. *byte into a byte buffer) cannot be
		// deep-copied: the pointee's declared size does not capture the
		// real object. Preserve the address and leak the fn arena so
		// the pointee stays alive for the caller.
		if et := typ.Elem(); et != nil && isBasicKind(et.Kind()) {
			// A pointee inside a sovereign DATA arena is NOT transient: the
			// arena lives as long as its receiver, so the address is stable and
			// nothing needs leaking. The stable registration is LIFO and can
			// already have been popped by the time a caller encodes a pointer
			// into a callee's arena, so ask the registered regions rather than
			// the registration - this is the path the relay reported three times
			// a run (pointee arena class 1), leaking a frame for every one.
			//
			// This must NOT be asked of sovFindContainingArena: that scans every
			// arena on the fn stack, including the one being released right now,
			// so `var d digest; return &d` (hash/adler32.New) was answered
			// "sovereign, stable" for its own dying frame - the pointer was
			// aliased, no escape was armed, the arena went back to the pool, and
			// the caller's digest was overwritten by the next frame to acquire
			// that arena. Every png IDAT ended in an Adler-32 of whatever had
			// been written into the recycled block.
			if domainRoot != nil && sovInSovereignDataArena(uintptr(p)) {
				codecSeenAdd(ss, p, codecPointeeSize(typ))
				codecNoteStable(uintptr(p))
				codecWriteVarint(cb, codecTagStable)
				codecWriteRaw(cb, unsafe.Pointer(&p), codecPtrSize())
				return
			}
			codecSeenAdd(ss, p, codecPointeeSize(typ))
			codecEscapeNote()
			codecWriteVarint(cb, codecTagStable)
			codecWriteRaw(cb, unsafe.Pointer(&p), codecPtrSize())
			return
		}
		if codecSovDataAlias(uintptr(p)) {
			codecSeenAdd(ss, p, codecPointeeSize(typ))
			codecWriteVarint(cb, codecTagStable)
			codecWriteRaw(cb, unsafe.Pointer(&p), codecPtrSize())
			return
		}
		codecWriteVarint(cb, codecTagPtr)
		codecEncodeValue(cb, ss, p, typ.Elem())
	case KindInterface:
		iface := *(*_interface)(ptr)
		codecWriteVarint(cb, codecTagIface)
		codecWriteBytes(cb, unsafe.Slice((*byte)(unsafe.Pointer(&iface.typecode)), codecPtrSize()))
		// Plausibility bound for a type descriptor pointer: above the
		// target's data floor (codecDataFloor - 1024 on wasm32, the native
		// first page elsewhere) and below the top of the address space. On a
		// 32-bit target the whole space is plausible, so there is no upper
		// bound to apply: 2^48 does not fit a uintptr there, and shifting a
		// 32-bit value by 48 is not expressible at all.
		tc := uintptr(iface.typecode)
		tcMax := ^uintptr(0)
		if codecPtrSize() >= 8 {
			tcMax = ^uintptr(0) >> 16
		}
		if tc >= codecDataFloor() && tc < tcMax {
			ct := (*RawType)(iface.typecode)
			if ct.Kind() != Invalid && ct.Size() <= 65536 {
				// Zero-size structs (e.g. empty context markers) still
				// emit their struct tag + field count so the decode
				// side stays in lockstep with the wire format.
				if ct.Size() <= unsafe.Sizeof(uintptr(0)) {
					codecEncodeValue(cb, ss, unsafe.Pointer(&iface.value), ct)
				} else {
					codecEncodeValue(cb, ss, iface.value, ct)
				}
			}
		}
	case KindMap:
		m := *(*unsafe.Pointer)(ptr)
		if m == nil {
			codecWriteVarint(cb, codecTagNil)
			return
		}
		codecWriteVarint(cb, codecTagPtr)
		hm := (*hashmap)(m)
		fixupFlags := uint8(0)
		kt := hashmapKeyType(typ)
		vt := typ.Elem()
		if kt != nil && (kt.Kind() == KindBytes) { fixupFlags |= 8 }
		if vt != nil && (vt.Kind() == KindBytes) { fixupFlags |= 1 }
		if vt != nil && (vt.Kind() == KindPointer) { fixupFlags |= 2 }
		if vt != nil && (vt.Kind() == KindInterface) { fixupFlags |= 4 }
		if codecMapValNeedsCopy(vt) { fixupFlags |= codecMapValDeep }
		codecEncodeMap(hm, cb, ss, fixupFlags, vt)
	case KindStruct:
		if ptr == nil || uintptr(ptr) < codecBadPtrFloor() {
			codecWriteVarint(cb, codecTagStruct)
			codecWriteVarint(cb, uint64(0))
			return
		}
		nf := typ.NumField()
		codecWriteVarint(cb, codecTagStruct)
		codecWriteVarint(cb, uint64(uint32(nf)))
		// Register the struct's own address FIRST, then every field address.
		// The decode side registers in exactly this order (codecDecodeValue's
		// KindStruct case and codecDecodeInto's), and the two tables are
		// position-indexed: a back-reference carries the encoder's index and the
		// decoder resolves it by position, so any extra or missing entry on
		// either side shifts every later back-reference to the WRONG object.
		//
		// Registering the base is what makes a self-referential struct work:
		// the address is in the table before its fields are walked, so a field
		// pointing back at the struct - or at an enclosing slice element - is
		// encoded as a back-reference rather than recursively re-encoded.
		codecSeenAdd(ss, ptr, uintptr(typ.Size()))
		for i := int32(0); i < nf; i++ {
			off := typ.StructFieldOffset(i)
			if off == 0 {
				// Field 0 sits AT the struct's address, so the base entry
				// above already covers it. Registering both would add one
				// entry per struct that the other side would have to mirror
				// and that every later back-reference index would have to
				// step over - the tables are position-indexed and looked up
				// by a linear scan, so extra entries are both a correctness
				// hazard and a cost.
				continue
			}
			fp := unsafe.Add(ptr, off)
			codecSeenAdd(ss, fp, uintptr(typ.StructFieldType(i).Size()))
		}
		for i := int32(0); i < nf; i++ {
			ft := typ.StructFieldType(i)
			off := typ.StructFieldOffset(i)
			fp := unsafe.Add(ptr, off)
			codecEncodeValue(cb, ss, fp, ft)
		}
	case KindArray:
		elemType := typ.Elem()
		elemSize := elemType.Size()
		length := typ.ArrayLen()
		for i := int32(0); i < length; i++ {
			ep := unsafe.Add(ptr, uintptr(i)*elemSize)
			codecEncodeValue(cb, ss, ep, elemType)
		}
	default:
		sz := typ.Size()
		if sz <= 0 || sz > 65536 {
			runtimePanic("codec default bad size")
		}
		codecWriteRaw(cb, ptr, uintptr(sz))
	}
}

// codecDecodeInto decodes the next value into dst instead of returning a
// freshly allocated block for it.
//
// Callers that place an element or a field inline decoded with
// codecDecodeValue and then memcpy'd the result, abandoning one allocation per
// value: for a []*K of n elements that is n abandoned blocks per copy. When
// the target arena is a sovereign receiver's, every one of those blocks is
// also recorded in its allocation map, which is how a 3000-element fill grew
// the map to tens of millions of entries and allocated gigabytes. Basic
// values and pointers (nil, back-reference, fresh or stable) are written
// directly; anything with interior structure still decodes through
// codecDecodeValue and is copied in.
func codecDecodeInto(cb *CodecBuf, ds *codecDecodeSeen, dst unsafe.Pointer, typ *RawType) {
	k := typ.Kind()
	if isBasicKind(k) {
		sz := typ.Size()
		if sz > 65536 {
			runtimePanic("codec basic bad size")
		}
		memcpy(dst, unsafe.Pointer(&cb.data[cb.pos]), sz)
		cb.pos += int32(sz)
		return
	}
	if k == KindStruct {
		// Decoded IN PLACE, exactly like codecDecodeValue's KindStruct case:
		// the seen-set entry for a struct must be the address its fields and any
		// back-references end up living at. Registering a temporary buffer and
		// then memcpy-ing it into the field left every internal back-reference
		// pointing at that temporary, and shifted the decode-side table against
		// the encode side's.
		tag := codecReadVarint(cb)
		if tag != codecTagStruct {
			runtimePanic("codec expected struct tag")
		}
		nf := int32(codecReadVarint(cb))
		codecDecodeSeenAdd(ds, dst)
		for i := int32(0); i < nf; i++ {
			off := typ.StructFieldOffset(i)
			if off == 0 {
				continue // covered by the base entry, as on the encode side
			}
			fp := unsafe.Add(dst, off)
			codecDecodeSeenAdd(ds, fp)
		}
		expectedNf := typ.NumField()
		if nf != expectedNf {
			runtimePanic("codec struct field count mismatch")
		}
		for i := int32(0); i < nf; i++ {
			ft := typ.StructFieldType(i)
			off := typ.StructFieldOffset(i)
			fp := unsafe.Add(dst, off)
			codecDecodeInto(cb, ds, fp, ft)
		}
		return
	}
	if k == KindPointer {
		tag := codecReadVarint(cb)
		switch tag {
		case codecTagNil:
			*(*unsafe.Pointer)(dst) = nil
			return
		case codecTagBackref:
			idx := int32(codecReadVarint(cb))
			orig := codecDecodeSeenLookup(ds, idx)
			if orig == nil {
				runtimePanic("codec backref nil")
			}
			*(*unsafe.Pointer)(dst) = orig
			return
		case codecTagPtr:
			// The pointee's own decode registers its address (before its
			// children); adding it again here desynchronised the two tables.
			inner := codecDecodeValue(cb, ds, typ.Elem())
			*(*unsafe.Pointer)(dst) = inner
			return
		case codecTagStable:
			if cb.pos+int32(codecPtrSize()) > int32(len(cb.data)) {
				runtimePanic("codec stable underflow")
			}
			sp := *(*unsafe.Pointer)(unsafe.Pointer(&cb.data[cb.pos]))
			cb.pos += int32(codecPtrSize())
			*(*unsafe.Pointer)(dst) = sp
			codecDecodeSeenAdd(ds, sp)
			return
		}
		runtimePanic("codec bad pointer tag")
	}
	dec := codecDecodeValue(cb, ds, typ)
	memcpy(dst, dec, typ.Size())
}

func codecDecodeValue(cb *CodecBuf, ds *codecDecodeSeen, typ *RawType) unsafe.Pointer {
	k := typ.Kind()
	if isBasicKind(k) {
		sz := typ.Size()
		buf := alloc(sz, unsafe.Pointer(typ))
		memcpy(buf, unsafe.Pointer(&cb.data[cb.pos]), sz)
		cb.pos += int32(sz)
		return buf
	}
	switch k {
	case KindBytes:
		startPos := cb.pos
		tag := codecReadVarint(cb)
		if tag == codecTagStableSlice {
			hdr := alloc(typ.Size(), unsafe.Pointer(typ))
			memcpy(hdr, unsafe.Pointer(&cb.data[cb.pos]), codecStrHdr())
			cb.pos += int32(codecStrHdr())
			return hdr
		}
		if tag == codecTagStr {
			n := int32(codecReadVarint(cb))
			ncp := int32(codecReadVarint(cb))
			hdr := alloc(typ.Size(), unsafe.Pointer(typ))
			// The backing allocation must cover the capacity, not just
			// the length: push() never grows and writes at len, up to
			// cap. Allocating only n when ncp > n hands out a truncated
			// buffer whose tail writes land in the next allocation and
			// are destroyed by the next alloc's memzero.
			allocN := ncp
			if allocN < n {
				allocN = n
			}
			if allocN > 0 {
				dataPtr := alloc(uintptr(allocN), nil)
				memcpy(dataPtr, unsafe.Pointer(&cb.data[cb.pos]), uintptr(n))
				cb.pos += n
				*(*unsafe.Pointer)(hdr) = dataPtr
			}
			// Header fields are target words: {ptr, len, cap}. The cap
			// slot only exists for the three-word form.
			*(*uintptr)(unsafe.Add(hdr, codecPtrSize())) = uintptr(n)
			if typ.Size() > codecPtrSize()*2 {
				*(*uintptr)(unsafe.Add(hdr, codecPtrSize()*2)) = uintptr(ncp)
			}
			return hdr
		}
		cb.pos = startPos
		sz := typ.Size()
		buf := alloc(sz, unsafe.Pointer(typ))
		memcpy(buf, unsafe.Pointer(&cb.data[cb.pos]), sz)
		cb.pos += int32(sz)
		return buf
	case KindSlice:
		startPos := cb.pos
		tag := codecReadVarint(cb)
		if tag == codecTagStableSlice {
			hdr := alloc(typ.Size(), unsafe.Pointer(typ))
			memcpy(hdr, unsafe.Pointer(&cb.data[cb.pos]), codecStrHdr())
			cb.pos += int32(codecStrHdr())
			return hdr
		}
		if tag == codecTagSlice {
			elemType := typ.Elem()
			hdr := alloc(typ.Size(), unsafe.Pointer(typ))
			ln := int32(codecReadVarint(cb))
			cp := int32(codecReadVarint(cb))
			if cp > 0 {
				elemSize := elemType.Size()
				arr := alloc(uintptr(cp)*elemSize, nil)
				*(*unsafe.Pointer)(hdr) = arr
				for i := int32(0); i < ln; i++ {
					ep := unsafe.Add(arr, uintptr(i)*elemSize)
					codecDecodeInto(cb, ds, ep, elemType)
				}
			}
			*(*uintptr)(unsafe.Add(hdr, codecPtrSize())) = uintptr(ln)
			*(*uintptr)(unsafe.Add(hdr, codecPtrSize()*2)) = uintptr(cp)
			return hdr
		}
		cb.pos = startPos
		sz := typ.Size()
		buf := alloc(sz, unsafe.Pointer(typ))
		memcpy(buf, unsafe.Pointer(&cb.data[cb.pos]), sz)
		cb.pos += int32(sz)
		return buf
	case KindPointer:
		tag := codecReadVarint(cb)
		switch tag {
		case codecTagNil:
			buf := alloc(typ.Size(), unsafe.Pointer(typ))
			*(*unsafe.Pointer)(buf) = nil
			return buf
		case codecTagBackref:
			idx := int32(codecReadVarint(cb))
			orig := codecDecodeSeenLookup(ds, idx)
			if orig == nil {
				runtimePanic("codec backref nil")
			}
			buf := alloc(typ.Size(), unsafe.Pointer(typ))
			*(*unsafe.Pointer)(buf) = orig
			return buf
		case codecTagPtr:
			inner := codecDecodeValue(cb, ds, typ.Elem())
			buf := alloc(typ.Size(), unsafe.Pointer(typ))
			*(*unsafe.Pointer)(buf) = inner
			return buf
		case codecTagStable:
			if cb.pos+int32(codecPtrSize()) > int32(len(cb.data)) {
				runtimePanic("codec stable underflow")
			}
			sp := *(*unsafe.Pointer)(unsafe.Pointer(&cb.data[cb.pos]))
			cb.pos += int32(codecPtrSize())
			buf := alloc(typ.Size(), unsafe.Pointer(typ))
			*(*unsafe.Pointer)(buf) = sp
			codecDecodeSeenAdd(ds, sp)
			return buf
		}
		runtimePanic("codec bad pointer tag")
		return nil
	case KindInterface:
		tag := codecReadVarint(cb)
		if tag != codecTagIface {
			runtimePanic("codec expected iface tag")
		}
		typRaw := codecReadBytes(cb)
		buf := alloc(typ.Size(), unsafe.Pointer(typ))
		if len(typRaw) == 0 {
			return buf
		}
		*(*unsafe.Pointer)(buf) = *(*unsafe.Pointer)(unsafe.Pointer(&typRaw[0]))
		ct := (*RawType)(*(*unsafe.Pointer)(unsafe.Pointer(&typRaw[0])))
		if ct == nil {
			// nil concrete value but non-nil interface type
			return buf
		}
		if ct.Size() <= unsafe.Sizeof(uintptr(0)) {
			inner := codecDecodeValue(cb, ds, ct)
			memcpy(unsafe.Add(buf, codecPtrSize()), inner, ct.Size())
		} else {
			inner := codecDecodeValue(cb, ds, ct)
			*(*unsafe.Pointer)(unsafe.Add(buf, codecPtrSize())) = inner
		}
		return buf
	case KindStruct:
		tag := codecReadVarint(cb)
		if tag != codecTagStruct {
			runtimePanic("codec expected struct tag")
		}
		nf := int32(codecReadVarint(cb))
		buf := alloc(typ.Size(), unsafe.Pointer(typ))
		// Register decoded struct and all its field addresses in the
		// decode seen-set, matching the encode side's registration order
		// so that back-references are resolved correctly.
		codecDecodeSeenAdd(ds, buf)
		for i := int32(0); i < nf; i++ {
			off := typ.StructFieldOffset(i)
			if off == 0 {
				continue // covered by the base entry, as on the encode side
			}
			fp := unsafe.Add(buf, off)
			codecDecodeSeenAdd(ds, fp)
		}
		// Decode fields in order using type descriptors
		expectedNf := typ.NumField()
		if nf != expectedNf {
			runtimePanic("codec struct field count mismatch")
		}
		for i := int32(0); i < nf; i++ {
			ft := typ.StructFieldType(i)
			off := typ.StructFieldOffset(i)
			fp := unsafe.Add(buf, off)
			codecDecodeInto(cb, ds, fp, ft)
		}
		return buf
	case KindArray:
		elemType := typ.Elem()
		elemSize := elemType.Size()
		length := typ.ArrayLen()
		buf := alloc(typ.Size(), unsafe.Pointer(typ))
		// A basic element encodes as raw bytes with no tag, so the array's
		// payload is its elements back to back. Decoding element by element
		// allocated a fresh block per element only to memcpy it into buf and
		// abandon it: 64 leaked blocks per [64]byte, each one recorded in the
		// receiver's allocation map when the target arena is sovereign.
		if elemType != nil && isBasicKind(elemType.Kind()) {
			memcpy(buf, unsafe.Pointer(&cb.data[cb.pos]), typ.Size())
			cb.pos += int32(typ.Size())
			return buf
		}
		for i := int32(0); i < length; i++ {
			ep := unsafe.Add(buf, uintptr(i)*elemSize)
			codecDecodeInto(cb, ds, ep, elemType)
		}
		return buf
	case KindMap:
		buf := alloc(typ.Size(), unsafe.Pointer(typ))
		kt := hashmapKeyType(typ)
		vt := typ.Elem()
		keySz := kt.Size()
		valSz := vt.Size()
		alg := uint8(0)
		if kt.Kind() == KindBytes { alg = 1 }
		if kt.Kind() == KindInterface { alg = 2 }
		flags := uint8(0)
		if kt.Kind() == KindBytes { flags |= 8 }
		if vt.Kind() == KindBytes { flags |= 1 }
		if vt.Kind() == KindPointer { flags |= 2 }
		if vt.Kind() == KindInterface { flags |= 4 }
		if codecMapValNeedsCopy(vt) { flags |= codecMapValDeep }
		decoded := codecDecodeMapValue(cb, ds, keySz, valSz, alg, flags, kt, vt)
		*(*unsafe.Pointer)(buf) = unsafe.Pointer(decoded)
		return buf
	default:
		sz := typ.Size()
		buf := alloc(sz, unsafe.Pointer(typ))
		memcpy(buf, unsafe.Pointer(&cb.data[cb.pos]), sz)
		cb.pos += int32(sz)
		return buf
	}
}

// codecDecodeMapValue decodes a map from the codec buffer, creating a new hashmap.
// This is a standalone function to avoid function instance specialization issues.
func codecDecodeMapValue(cb *CodecBuf, ds *codecDecodeSeen, keySz, valSz uintptr, alg uint8, flags uint8, kt, vt *RawType) (m *hashmap) {
	tag := codecReadVarint(cb)
	if tag == codecTagNil { return nil }
	if tag != codecTagPtr { runtimePanic("codec: map expected ptr tag") }
	cnt := int32(codecReadVarint(cb))
	m = hashmapMake(keySz, valSz, uintptr(cnt), alg)
	if cnt == 0 { return }
	fixKey := flags&8 != 0; fixStrVal := flags&1 != 0; fixVal := flags&2 != 0; fixIface := flags&4 != 0
	fixDeep := flags&codecMapValDeep != 0
	for i := int32(0); i < cnt; i++ {
		var key, val []byte
		if fixKey { raw := codecReadBytes(cb)
			hdr := []byte{:keySz}
			*(*unsafe.Pointer)(unsafe.Pointer(&hdr[0])) = unsafe.Pointer(&raw[0])
			// A string/[]byte header is {ptr, len, cap} in TARGET words: the
			// len/cap offsets are 8/16 only where a word is 8 bytes. Reading
			// them at 8/16 on wasm wrote the length into the cap slot and left
			// the length zero, so every map key decoded empty.
			*(*uintptr)(unsafe.Add(unsafe.Pointer(&hdr[0]), codecPtrSize())) = uintptr(len(raw))
			if keySz > codecPtrSize()*2 {
				*(*uintptr)(unsafe.Add(unsafe.Pointer(&hdr[0]), codecPtrSize()*2)) = uintptr(len(raw))
			}
			key = hdr
		} else { key = []byte{:keySz}
			memcpy(unsafe.Pointer(&key[0]), unsafe.Pointer(&cb.data[cb.pos]), keySz)
			cb.pos += int32(keySz) }
		if fixStrVal {
			raw := codecReadBytes(cb)
			hdr := []byte{:valSz}
			*(*unsafe.Pointer)(unsafe.Pointer(&hdr[0])) = unsafe.Pointer(&raw[0])
			*(*uintptr)(unsafe.Add(unsafe.Pointer(&hdr[0]), codecPtrSize())) = uintptr(len(raw))
			if valSz > codecPtrSize()*2 {
				*(*uintptr)(unsafe.Add(unsafe.Pointer(&hdr[0]), codecPtrSize()*2)) = uintptr(len(raw))
			}
			val = hdr
		} else if fixVal {
			vTag := codecReadVarint(cb)
			if vTag == codecTagNil { val = []byte{:valSz} } else
			if vTag == codecTagPtr {
				var valElemType *RawType
				if vt != nil && vt.Kind() == KindPointer { valElemType = vt.Elem() }
				inner := codecDecodeValue(cb, ds, valElemType)
				buf := []byte{:valSz}
				*(*unsafe.Pointer)(unsafe.Pointer(&buf[0])) = inner
				val = buf
			} else { runtimePanic("codec bad fixVal tag") }
		} else if fixIface {
			ifaceTag := codecReadVarint(cb)
			if ifaceTag != codecTagIface { runtimePanic("codec expected iface tag") }
			typRaw := codecReadBytes(cb)
			buf := []byte{:valSz}
			if len(typRaw) > 0 {
				*(*unsafe.Pointer)(unsafe.Pointer(&buf[0])) = *(*unsafe.Pointer)(unsafe.Pointer(&typRaw[0]))
				ct := (*RawType)(*(*unsafe.Pointer)(unsafe.Pointer(&typRaw[0])))
				if ct.Size() <= unsafe.Sizeof(uintptr(0)) {
					inner := codecDecodeValue(cb, ds, ct)
					memcpy(unsafe.Add(unsafe.Pointer(&buf[0]), codecPtrSize()), inner, ct.Size())
				} else {
					inner := codecDecodeValue(cb, ds, ct)
					*(*unsafe.Pointer)(unsafe.Add(unsafe.Pointer(&buf[0]), codecPtrSize())) = inner
				}
			}
			val = buf
		} else if fixDeep {
			dec := codecDecodeValue(cb, ds, vt)
			val = []byte{:valSz}
			if valSz > 0 {
				memcpy(unsafe.Pointer(&val[0]), dec, valSz)
			}
		} else { val = []byte{:valSz}
			memcpy(unsafe.Pointer(&val[0]), unsafe.Pointer(&cb.data[cb.pos]), valSz)
			cb.pos += int32(valSz) }
		h := m.keyHash(unsafe.Pointer(&key[0]), keySz, m.seed)
		hashmapSet(m, unsafe.Pointer(&key[0]), unsafe.Pointer(&val[0]), h)
	}
	return
}

// codecMapValDeep marks a map whose value type cannot be raw-copied: the value
// owns a backing array or embeds pointers, so a raw copy hands the caller a
// pointer into the callee's released arena. Bytes values are copied by
// fixStrVal, pointers/interfaces by fixVal/fixIface, and basic kinds are
// self-contained; everything else is delegated to codecEncodeValue.
const codecMapValDeep = uint8(16)

// codecMapValNeedsCopy reports whether a map value of type vt must be
// re-encoded rather than raw-copied. A raw copy of a slice/struct/map/array
// value copies the header, which points at (or into) the dying fn arena; the
// next function to acquire that arena then overwrites the caller's live data.
func codecMapValNeedsCopy(vt *RawType) (ok bool) {
	if vt == nil {
		return false
	}
	switch vt.Kind() {
	case KindSlice, KindStruct, KindMap, KindArray:
		return true
	}
	return false
}

func codecEncodeMap(m *hashmap, cb *CodecBuf, ss *codecSeenSet, fixupFlags uint8, vt *RawType) {
	// Entry count
	cnt := int32(0)
	if m != nil {
		cKeySz := m.keySize; cValSz := m.valueSize
		cBucketSz := unsafe.Sizeof(hashmapBucket{}) + cKeySz*8 + cValSz*8
		cNb := uintptr(1) << m.bucketBits
		for bi := uintptr(0); bi < cNb; bi++ {
			for b := (*hashmapBucket)(unsafe.Add(m.buckets, cBucketSz*bi)); b != nil; b = b.next {
				for i := uint8(0); i < 8; i++ { if b.tophash[i] != 0 { cnt++ } }
			}
		}
	}
	codecWriteVarint(cb, uint64(uint32(cnt)))
	if cnt == 0 { return }

	fixKey := fixupFlags&8 != 0; fixStrVal := fixupFlags&1 != 0; fixVal := fixupFlags&2 != 0; fixIface := fixupFlags&4 != 0
	fixDeep := fixupFlags&codecMapValDeep != 0
	var valElemType *RawType
	if vt != nil && vt.Kind() == KindPointer { valElemType = vt.Elem() }
	keySz := m.keySize; valSz := m.valueSize
	bucketSz := unsafe.Sizeof(hashmapBucket{}) + keySz*8 + valSz*8
	nb := uintptr(1) << m.bucketBits

	for bi := uintptr(0); bi < nb; bi++ {
		for b := (*hashmapBucket)(unsafe.Add(m.buckets, bucketSz*bi)); b != nil; b = b.next {
			for i := uint8(0); i < 8; i++ {
				if b.tophash[i] != 0 {
					kp := hashmapSlotKey(m, b, i)
					vp := hashmapSlotValue(m, b, i)
					if fixKey {
						_sh := *(*_string)(kp)
						codecWriteBytes(cb, unsafe.Slice((*byte)(_sh.ptr), _sh.length))
					} else {
						codecWriteRaw(cb, kp, uintptr(keySz))
					}
					if fixStrVal {
						sv := *(*_string)(vp)
						codecWriteBytes(cb, unsafe.Slice((*byte)(sv.ptr), sv.length))
					} else if fixVal {
						p := *(*unsafe.Pointer)(vp)
						if p == nil {
							codecWriteVarint(cb, codecTagNil)
						} else {
							codecWriteVarint(cb, codecTagPtr)
							codecEncodeValue(cb, ss, p, valElemType)
						}
					} else if fixIface {
						iface := *(*_interface)(vp)
						codecWriteVarint(cb, codecTagIface)
						codecWriteBytes(cb, unsafe.Slice((*byte)(unsafe.Pointer(&iface.typecode)), codecPtrSize()))
						if iface.typecode != nil {
							ct := (*RawType)(iface.typecode)
							if ct.Size() <= unsafe.Sizeof(uintptr(0)) {
								codecEncodeValue(cb, ss, unsafe.Pointer(&iface.value), ct)
							} else {
								codecEncodeValue(cb, ss, iface.value, ct)
							}
						}
					} else if fixDeep {
						codecEncodeValue(cb, ss, vp, vt)
					} else {
						codecWriteRaw(cb, vp, uintptr(valSz))
					}
				}
			}
		}
	}
}

// --- Compiler-generated return value encode/decode primitives ---
// Called from compiler-emitted code to serialize return values across
// arena boundaries. These replace the old 3-pass Reloc* system.

func codecWriteU8(cb *CodecBuf, v uint8) {
	cb.data = codecEnsure(cb.data, 1)
	cb.data = mxutil.Ensure(cb.data, 1)
	push(cb.data, v)
}

func codecWriteRaw(cb *CodecBuf, ptr unsafe.Pointer, sz uintptr) {
	if sz > 0 {
		cb.data = codecEnsure(cb.data, int32(sz))
		off := len(cb.data)
		cb.data = resize(cb.data, off+int32(sz))
		memcpy(unsafe.Pointer(&cb.data[off]), ptr, sz)
	}
}

func codecReadU8(cb *CodecBuf) (v uint8) {
	v = cb.data[cb.pos]; cb.pos++
	return
}

func codecReadRaw(cb *CodecBuf, ptr unsafe.Pointer, sz uintptr) {
	if sz > 0 {
		memcpy(ptr, unsafe.Pointer(&cb.data[cb.pos]), sz)
		cb.pos += int32(sz)
	}
}


// codecEncodePtrValue encodes a pointer from its value.
func codecEncodePtrValue(cb *CodecBuf, ss *codecSeenSet, ptr unsafe.Pointer, elemType *RawType) {
	if ptr == nil {
		codecWriteVarint(cb, codecTagNil)
		return
	}
	idx := codecSeenLookup(ss, ptr, uintptr(elemType.Size()))
	if idx >= 0 {
		codecWriteVarint(cb, codecTagBackref)
		codecWriteVarint(cb, uint64(uint32(idx)))
		return
	}
	// No registration here: the pointee's own branch registers its address
	// before its children, which is the entry the decoder creates too.
	codecWriteVarint(cb, codecTagPtr)
	codecEncodeValue(cb, ss, ptr, elemType)
}

// codecEncodeIfaceValue encodes an interface from its typecode and value fields.
func codecEncodeIfaceValue(cb *CodecBuf, ss *codecSeenSet, typecode, value unsafe.Pointer, typ *RawType) {
	codecWriteVarint(cb, codecTagIface)
	codecWriteBytes(cb, unsafe.Slice((*byte)(unsafe.Pointer(&typecode)), codecPtrSize()))
	if typecode != nil {
		ct := (*RawType)(typecode)
		if ct.Size() <= unsafe.Sizeof(uintptr(0)) {
			codecEncodeValue(cb, ss, unsafe.Pointer(&value), ct)
		} else {
			codecEncodeValue(cb, ss, value, ct)
		}
	}
}

// codecEncodeMapValue encodes a map from its pointer value.
func codecEncodeMapValue(cb *CodecBuf, ss *codecSeenSet, mptr unsafe.Pointer, typ *RawType) {
	if mptr == nil {
		codecWriteVarint(cb, codecTagNil)
		return
	}
	codecWriteVarint(cb, codecTagPtr)
	hm := (*hashmap)(mptr)
	fixupFlags := uint8(0)
	kt := hashmapKeyType(typ)
	vt := typ.Elem()
	if kt != nil && (kt.Kind() == KindBytes) { fixupFlags |= 8 }
	if vt != nil && (vt.Kind() == KindBytes) { fixupFlags |= 1 }
	if vt != nil && (vt.Kind() == KindPointer) { fixupFlags |= 2 }
	if vt != nil && (vt.Kind() == KindInterface) { fixupFlags |= 4 }
	if codecMapValNeedsCopy(vt) { fixupFlags |= codecMapValDeep }
	codecEncodeMap(hm, cb, ss, fixupFlags, vt)
}

// codecDecodeString decodes a string from the buffer.
// Returns pointer to a _string header allocated in the current arena.
func codecDecodeString(cb *CodecBuf, ds *codecDecodeSeen) (hdr unsafe.Pointer) {
	tag := codecReadVarint(cb)
	if tag != codecTagStr { runtimePanic("codec: expected string tag") }
	ln := int32(codecReadVarint(cb))
	hdr = alloc(unsafe.Sizeof(_string{}), nil)
	if ln == 0 {
		return
	}
	ptr := alloc(uintptr(ln), nil)
	codecReadRaw(cb, ptr, uintptr(ln))
	sh := (*_string)(hdr)
	sh.ptr = (*byte)(ptr)
	sh.length = uintptr(ln)
	sh.cap = uintptr(ln)
	return
}

// codecDecodePtr reads a pointer from the buffer.
// The resulting pointer value may be nil, a backreference, or fresh allocation.
func codecDecodePtr(cb *CodecBuf, ds *codecDecodeSeen) (ptr unsafe.Pointer) {
	tag := codecReadVarint(cb)
	switch tag {
	case codecTagNil:
		return nil
	case codecTagBackref:
		idx := int32(codecReadVarint(cb))
		return codecDecodeSeenLookup(ds, idx)
	case codecTagPtr:
		buf := []byte{:8}
		codecReadRaw(cb, unsafe.Pointer(&buf[0]), unsafe.Sizeof(uintptr(0)))
		return *(*unsafe.Pointer)(unsafe.Pointer(&buf[0]))
	}
	runtimePanic("codecDecodePtr: bad tag")
	return nil
}

// codecDecodeSlice decodes a slice from the buffer.
// Returns pointer to a slice header allocated in the current arena.
func codecDecodeSlice(cb *CodecBuf, ds *codecDecodeSeen) (hdr unsafe.Pointer) {
	tag := codecReadVarint(cb)
	if tag != codecTagSlice { runtimePanic("codec: expected slice tag") }
	ln := int32(codecReadVarint(cb))
	cp := int32(codecReadVarint(cb))
	hdr = alloc(unsafe.Sizeof(_string{}), nil)
	if ln == 0 {
		return
	}
	ptr := alloc(uintptr(cp), nil)
	codecReadRaw(cb, ptr, uintptr(ln))
	sh := (*_string)(hdr)
	sh.ptr = (*byte)(ptr)
	sh.length = uintptr(ln)
	sh.cap = uintptr(cp)
	return
}

// codecDecodeInterface decodes an interface value from the buffer.
// Returns pointer to an _interface header in the current arena.
func codecDecodeInterface(cb *CodecBuf, ds *codecDecodeSeen) (ifacePtr unsafe.Pointer) {
	tag := codecReadVarint(cb)
	if tag != codecTagIface { runtimePanic("codec: expected iface tag") }
	ifacePtr = alloc(unsafe.Sizeof(_interface{}), nil)
	iface := (*_interface)(ifacePtr)
	// Read typecode (8 raw bytes)
	tcBuf := []byte{:8}
	codecReadRaw(cb, unsafe.Pointer(&tcBuf[0]), 8)
	iface.typecode = *(*unsafe.Pointer)(unsafe.Pointer(&tcBuf[0]))
	if iface.typecode != nil {
		ct := (*RawType)(iface.typecode)
		// Decode concrete value using runtime type info from typecode
		inner := codecDecodeValue(cb, ds, ct)
		iface.value = inner
	}
	return
}

// codecEncodeIfacePayload encodes the concrete value behind an interface.
// Uses the interface's own typecode (*RawType) for recursive type info.
func codecEncodeIfacePayload(cb *CodecBuf, ss *codecSeenSet, ifaceAddr unsafe.Pointer) {
	iface := *(*_interface)(ifaceAddr)
	if iface.typecode == nil {
		return
	}
	t := (*RawType)(iface.typecode)
	if t.Kind() == KindPointer || t.Size() > unsafe.Sizeof(uintptr(0)) {
		// Large value: iface.value is a pointer to the data
		codecEncodeValue(cb, ss, iface.value, t)
	} else {
		// Small value: iface.value IS the data
		codecEncodeValue(cb, ss, unsafe.Pointer(&iface.value), t)
	}
}

// codecReadStructTag validates a struct header (tag + field count).
func codecReadStructTag(cb *CodecBuf, expectedFields int32) {
	tag := codecReadVarint(cb)
	if tag != codecTagStruct {
		runtimePanic("codec: expected struct tag")
	}
	nf := int32(codecReadVarint(cb))
	if nf != expectedFields {
		runtimePanic("codec: struct field count mismatch")
	}
}


// codecSetTopOnlyTransient sets the store-back transient mode.
func codecSetTopOnlyTransient(b bool) {
	codecTopOnlyTransient = b
}

// codecSetRetTransient sets the return-value encode transient mode.
func codecSetRetTransient(b bool) {
	codecRetTransient = b
}


// SpawnArgCopy is the spawn boundary's value-parameter handoff: it encodes one
// value, checks the encoding against the budget the declaration states, and
// decodes it back into a copy in the ROOT arena. A spawn call then packs that
// copy's bytes instead of the caller's own, which is what makes "values are
// copied" true for the contents too: a slice or pointer field would otherwise
// hand the child a window into the parent's frames, which pop when the
// spawning function returns.
//
// The budget is the compiler's frameBudget walk over the parameter type: the
// same number, from the same cap tags, that sizes a spawn channel's ring. A
// value parameter is part of the spawn's footprint, so it is not exempt from
// sizing; an overrun panics naming the fields whose tags set it, before the
// fork, in the process that made the mistake.
func SpawnArgCopy(val unsafe.Pointer, typ *RawType, budget int32, notePtr unsafe.Pointer, noteLen uintptr) (dup unsafe.Pointer) {
	var cb CodecBuf
	var ss codecSeenSet
	codecSeenInit(&ss)
	// Cross-domain: the child gets this memory after a fork, so a stable-slice
	// frame (a header into the encoder's own arena) is exactly what must not be
	// produced. Everything reachable is written out and read back.
	codecCrossDomain = true
	codecEncodeValue(&cb, &ss, val, typ)
	codecCrossDomain = false
	n := int32(len(cb.data))
	if n > budget {
		spawnArgBudgetPanic(n, budget, notePtr, noteLen)
	}
	var ds codecDecodeSeen
	codecDecodeSeenInit(&ds)
	cb.pos = 0
	// The copy outlives this frame: the child reads it, and the frame pops as
	// soon as the spawning function returns. The root arena lives as long as
	// the domain, so that is where the decoded graph goes.
	save := CurrentArena()
	SetCurrentArena(trueRootArena())
	dup = codecDecodeValue(&cb, &ds, typ)
	SetCurrentArena(save)
	return dup
}

// spawnArgBudgetPanic reports a value parameter that encoded past its budget.
func spawnArgBudgetPanic(actual, budget int32, notePtr unsafe.Pointer, noteLen uintptr) {
	var note []byte
	if notePtr != nil && noteLen > 0 {
		note = unsafe.Slice((*byte)(notePtr), noteLen)
	}
	runtimePanic("spawn argument: encoded value of " | codecItoa(actual) | " bytes exceeds the " | codecItoa(budget) | "-byte budget. Variable-length fields and their cap tags: " | note)
}

// codecItoa renders an int32 in decimal. The runtime's itoa lives in a
// linux-only file, and this panic is shared code: a wasm build must be able to
// name the same mistake.
func codecItoa(n int32) (s string) {
	if n == 0 {
		return "0"
	}
	neg := n < 0
	u := uint32(n)
	if neg {
		u = uint32(-n)
	}
	var d []byte
	d = []byte{:0:12}
	for u > 0 {
		d = push(d, byte('0'+u%10))
		u /= 10
	}
	if neg {
		d = push(d, '-')
	}
	out := []byte{:0:int32(len(d))}
	for i := int32(0); i < int32(len(d)); i++ {
		out = push(out, d[int32(len(d))-1-i])
	}
	return string(out)
}
