package runtime

// This is a hashmap implementation for the map[T]T type.
// It is very roughly based on the implementation of the Go hashmap:
//
//     https://golang.org/src/runtime/map.go

import (
	"moxie"
	"unsafe"
)

// The underlying hashmap structure for Go.
type hashmap struct {
	buckets    unsafe.Pointer // pointer to array of buckets
	seed       uintptr
	count      uintptr
	keySize    uintptr
	valueSize  uintptr
	bucketBits uint8
	keyEqual   func(x, y unsafe.Pointer, n uintptr) bool
	keyHash    func(key unsafe.Pointer, size, seed uintptr) uint32
	keyLess    func(x, y unsafe.Pointer, n uintptr) bool
	owner      *Arena // arena that owns this map's allocations
}

// A hashmap bucket. A bucket is a container of 8 key/value pairs: first the
// following two entries, then the 8 keys, then the 8 values. This somewhat odd
// ordering is to make sure the keys and values are well aligned when one of
// them is smaller than the system word size.
type hashmapBucket struct {
	tophash [8]uint8
	next    *hashmapBucket // next bucket (if there are more than 8 in a chain)
	// Followed by the actual keys, and then the actual values. These are
	// allocated but as they're of variable size they can't be shown here.
}

type hashmapIterator struct {
	sortedKeys unsafe.Pointer // allocated buffer of sorted keys
	count      uintptr        // total number of keys
	index      uintptr        // current position in sorted keys
	keySize    uintptr        // size of each key (copied from hashmap)
	valueSize  uintptr        // size of each value (copied from hashmap)
	_pad       [8]uint8       // pad to 48 bytes
}

func hashmapNewIterator() unsafe.Pointer {
	return unsafe.Pointer(&hashmapIterator{})
}

// Get the topmost 8 bits of the hash, without using a special value (like 0).
func hashmapTopHash(hash uint32) uint8 {
	tophash := uint8(hash >> 24)
	if tophash < 1 {
		// 0 means empty slot, so make it bigger.
		tophash += 1
	}
	return tophash
}

// Create a new hashmap with the given keySize and valueSize.
func hashmapMake(keySize, valueSize uintptr, sizeHint uintptr, alg uint8) *hashmap {
	bucketBits := uint8(0)
	for hashmapHasSpaceToGrow(bucketBits) && hashmapOverLoadFactor(sizeHint, bucketBits) {
		bucketBits++
	}

	bucketBufSize := unsafe.Sizeof(hashmapBucket{}) + keySize*8 + valueSize*8
	buckets := alloc(bucketBufSize*(1<<bucketBits), nil)

	keyHash := hashmapKeyHashAlg(moxie.HashmapAlgorithm(alg))
	keyEqual := hashmapKeyEqualAlg(moxie.HashmapAlgorithm(alg))
	keyLess := hashmapKeyLessAlg(moxie.HashmapAlgorithm(alg))

	return &hashmap{
		buckets:    buckets,
		seed:       uintptr(fastrand()),
		keySize:    keySize,
		valueSize:  valueSize,
		bucketBits: bucketBits,
		keyEqual:   keyEqual,
		keyHash:    keyHash,
		keyLess:    keyLess,
		owner:      CurrentArena(),
	}
}

// hashmapOwner returns the arena a map should allocate its index (bucket
// arrays) and items (key copies) in. A map is sovereign over its own storage:
// it derives its home arena from its current header address rather than
// trusting the arena captured at construction, which may have been freed after
// the map was relocated into another arena. Falls back to the recorded owner
// (for a data-arena map whose header is not on the frame stack), then to the
// root arena so an allocation can never target a dead arena.
func hashmapOwner(m *hashmap) (a *Arena) {
	p := uintptr(unsafe.Pointer(m))
	a = sovFindContainingArena(p)
	if a != nil {
		return a
	}
	// The header may live in a sovereign data arena, which is not on the
	// function arena stack. The current method's stable arena (and the
	// enclosing stable stack) are the registered data arenas.
	if domainRoot.stableArena != nil && sovInArena(domainRoot.stableArena, p) {
		return domainRoot.stableArena
	}
	for i := int32(0); i < domainRoot.stableTop; i++ {
		if domainRoot.stableStack[i] != nil && sovInArena(domainRoot.stableStack[i], p) {
			return domainRoot.stableStack[i]
		}
	}
	if m.owner != nil {
		return m.owner
	}
	return domainRoot.fnStack[0]
}

// Remove all entries from the map, without actually deallocating the space for
// it. This is used for the clear builtin, and can be used to reuse a map (to
// avoid extra heap allocations).
func hashmapClear(m *hashmap) {
	if m == nil {
		// Nothing to do. According to the spec:
		// > If the map or slice is nil, clear is a no-op.
		return
	}

	m.count = 0
	numBuckets := uintptr(1) << m.bucketBits
	bucketSize := hashmapBucketSize(m)
	for i := uintptr(0); i < numBuckets; i++ {
		bucket := hashmapBucketAddr(m, m.buckets, i)
		for bucket != nil {
			// Clear the tophash, to mark these keys/values as removed.
			bucket.tophash = [8]uint8{}

			// Clear the keys and values in the bucket.
			memzero(unsafe.Add(unsafe.Pointer(bucket), unsafe.Sizeof(hashmapBucket{})), bucketSize-unsafe.Sizeof(hashmapBucket{}))

			// Move on to the next bucket in the chain.
			bucket = bucket.next
		}
	}
}

func hashmapKeyEqualAlg(alg moxie.HashmapAlgorithm) func(x, y unsafe.Pointer, n uintptr) bool {
	switch alg {
	case moxie.HashmapAlgorithmBinary:
		return memequal
	case moxie.HashmapAlgorithmContent:
		return hashmapContentEqual
	case moxie.HashmapAlgorithmInterface:
		return hashmapInterfaceEqual
	default:
		// compiler bug :(
		return nil
	}
}

func hashmapKeyHashAlg(alg moxie.HashmapAlgorithm) func(key unsafe.Pointer, n, seed uintptr) uint32 {
	switch alg {
	case moxie.HashmapAlgorithmBinary:
		return hash32
	case moxie.HashmapAlgorithmContent:
		return hashmapContentPtrHash
	case moxie.HashmapAlgorithmInterface:
		return hashmapInterfacePtrHash
	default:
		// compiler bug :(
		return nil
	}
}

func hashmapKeyLessAlg(alg moxie.HashmapAlgorithm) func(x, y unsafe.Pointer, n uintptr) bool {
	switch alg {
	case moxie.HashmapAlgorithmBinary:
		return memless
	case moxie.HashmapAlgorithmContent:
		return hashmapContentLess
	case moxie.HashmapAlgorithmInterface:
		return memless
	default:
		return memless
	}
}

func memless(x, y unsafe.Pointer, n uintptr) bool {
	for i := uintptr(0); i < n; i++ {
		cx := *(*uint8)(unsafe.Add(x, i))
		cy := *(*uint8)(unsafe.Add(y, i))
		if cx < cy {
			return true
		}
		if cx > cy {
			return false
		}
	}
	return false
}

func hashmapContentLess(x, y unsafe.Pointer, n uintptr) bool {
	sx := *(*_string)(x)
	sy := *(*_string)(y)
	lx := uintptr(sx.length)
	ly := uintptr(sy.length)
	min := lx
	if ly < min {
		min = ly
	}
	for i := uintptr(0); i < min; i++ {
		cx := *(*uint8)(unsafe.Add(unsafe.Pointer(sx.ptr), i))
		cy := *(*uint8)(unsafe.Add(unsafe.Pointer(sy.ptr), i))
		if cx < cy {
			return true
		}
		if cx > cy {
			return false
		}
	}
	return lx < ly
}

func hashmapHasSpaceToGrow(bucketBits uint8) bool {
	// Over this limit, we're likely to overflow uintptrs during calculations
	// or numbers of hash elements.   Don't allow any more growth.
	// With 29 bits, this is 2^32 elements anyway.
	return bucketBits <= uint8((unsafe.Sizeof(uintptr(0))*8)-3)
}

func hashmapOverLoadFactor(n uintptr, bucketBits uint8) bool {
	// "maximum" number of elements is 0.75 * buckets * elements per bucket
	// to avoid overflow, this is calculated as
	// max = 3 * (1/4 * buckets * elements per bucket)
	//     = 3 * (buckets * (elements per bucket)/4)
	//     = 3 * (buckets * (8/4)
	//     = 3 * (buckets * 2)
	//     = 6 * buckets
	max := (uintptr(6) << bucketBits)
	return n > max
}

// Return the number of entries in this hashmap, called from the len builtin.
// A nil hashmap is defined as having length 0.
//
//:inline
func hashmapLen(m *hashmap) int32 {
	if m == nil {
		return 0
	}
	return int32(m.count)
}

//:inline
func hashmapBucketSize(m *hashmap) uintptr {
	return unsafe.Sizeof(hashmapBucket{}) + uintptr(m.keySize)*8 + uintptr(m.valueSize)*8
}

//:inline
func hashmapBucketAddr(m *hashmap, buckets unsafe.Pointer, n uintptr) *hashmapBucket {
	bucketSize := hashmapBucketSize(m)
	bucket := (*hashmapBucket)(unsafe.Add(buckets, bucketSize*n))
	return bucket
}

//:inline
func hashmapBucketAddrForHash(m *hashmap, hash uint32) *hashmapBucket {
	numBuckets := uintptr(1) << m.bucketBits
	bucketNumber := (uintptr(hash) & (numBuckets - 1))
	return hashmapBucketAddr(m, m.buckets, bucketNumber)
}

//:inline
func hashmapSlotKey(m *hashmap, bucket *hashmapBucket, slot uint8) unsafe.Pointer {
	slotKeyOffset := unsafe.Sizeof(hashmapBucket{}) + uintptr(m.keySize)*uintptr(slot)
	slotKey := unsafe.Add(unsafe.Pointer(bucket), slotKeyOffset)
	return slotKey
}

//:inline
func hashmapSlotValue(m *hashmap, bucket *hashmapBucket, slot uint8) unsafe.Pointer {
	slotValueOffset := unsafe.Sizeof(hashmapBucket{}) + uintptr(m.keySize)*8 + uintptr(m.valueSize)*uintptr(slot)
	slotValue := unsafe.Add(unsafe.Pointer(bucket), slotValueOffset)
	return slotValue
}

// hashmapKeyType returns the key type descriptor from a map type descriptor.
// Map descriptors have layout: RawType, numMethod, ptrTo, elem(value type), key type.
// The key type is at offset sizeof(rtElemType) from the underlying type pointer.
func hashmapKeyType(t *RawType) (kt *RawType) {
	u := t.Underlying()
	p := *(*unsafe.Pointer)(unsafe.Add(unsafe.Pointer(u), unsafe.Sizeof(rtElemType{})))
	kt = (*RawType)(p)
	return
}

// Set a specified key to a given value. Grow the map if necessary.
//
//:nobounds
func hashmapSet(m *hashmap, key unsafe.Pointer, value unsafe.Pointer, hash uint32) {
	if hashmapHasSpaceToGrow(m.bucketBits) && hashmapOverLoadFactor(m.count, m.bucketBits) {
		hashmapGrow(m)
		// seed changed when we grew; rehash key with new seed
		hash = m.keyHash(key, m.keySize, m.seed)
	}

	tophash := hashmapTopHash(hash)
	bucket := hashmapBucketAddrForHash(m, hash)
	var lastBucket *hashmapBucket

	// See whether the key already exists somewhere.
	var emptySlotKey unsafe.Pointer
	var emptySlotValue unsafe.Pointer
	var emptySlotTophash *byte
	for bucket != nil {
		for i := uint8(0); i < 8; i++ {
			slotKey := hashmapSlotKey(m, bucket, i)
			slotValue := hashmapSlotValue(m, bucket, i)
			if bucket.tophash[i] == 0 && emptySlotKey == nil {
				// Found an empty slot, store it for if we couldn't find an
				// existing slot.
				emptySlotKey = slotKey
				emptySlotValue = slotValue
				emptySlotTophash = &bucket.tophash[i]
			}
			if bucket.tophash[i] == tophash {
				// Could be an existing key that's the same.
				if m.keyEqual(key, slotKey, m.keySize) {
					// found same key, replace it
					memcpy(slotValue, value, m.valueSize)
					return
				}
			}
		}
		lastBucket = bucket
		bucket = bucket.next
	}
	if emptySlotKey == nil {
		// Add a new bucket to the bucket chain.
		// TODO: rebalance if necessary to avoid O(n) insert and lookup time.
		lastBucket.next = (*hashmapBucket)(hashmapInsertIntoNewBucket(m, key, value, tophash))
		return
	}
	m.count++
	memcpy(emptySlotKey, key, m.keySize)
	memcpy(emptySlotValue, value, m.valueSize)
	*emptySlotTophash = tophash
}

// hashmapInsertIntoNewBucket creates a new bucket, inserts the given key and
// value into the bucket, and returns a pointer to this bucket.
func hashmapInsertIntoNewBucket(m *hashmap, key, value unsafe.Pointer, tophash uint8) *hashmapBucket {
	bucketBufSize := hashmapBucketSize(m)
	saved := CurrentArena()
	SetCurrentArena(hashmapOwner(m))
	bucketBuf := alloc(bucketBufSize, nil)
	SetCurrentArena(saved)
	bucket := (*hashmapBucket)(bucketBuf)

	// Insert into the first slot, which is empty as it has just been allocated.
	slotKey := hashmapSlotKey(m, bucket, 0)
	slotValue := hashmapSlotValue(m, bucket, 0)
	m.count++
	memcpy(slotKey, key, m.keySize)
	memcpy(slotValue, value, m.valueSize)
	bucket.tophash[0] = tophash
	return bucket
}

func hashmapGrow(m *hashmap) {
	if m == nil {
		runtimePanic("hashmapGrow: m is nil")
	}
	oldBuckets := m.buckets
	oldBits := m.bucketBits
	bucketSize := hashmapBucketSize(m)

	// Allocate new buckets in the map's owning arena.
	saved := CurrentArena()
	SetCurrentArena(hashmapOwner(m))

	m.bucketBits = oldBits + 1
	m.count = 0
	m.seed = uintptr(fastrand())
	m.buckets = alloc(bucketSize*(uintptr(1)<<m.bucketBits), nil)

	// Re-insert all entries from old buckets into the new array.
	numOldBuckets := uintptr(1) << oldBits
	for bi := uintptr(0); bi < numOldBuckets; bi++ {
		bucket := (*hashmapBucket)(unsafe.Add(oldBuckets, bucketSize*bi))
		for bucket != nil {
			for i := uint8(0); i < 8; i++ {
				if bucket.tophash[i] != 0 {
					kp := hashmapSlotKey(m, bucket, i)
					vp := hashmapSlotValue(m, bucket, i)
					hash := m.keyHash(kp, m.keySize, m.seed)
					hashmapSet(m, kp, vp, hash)
				}
			}
			bucket = bucket.next
		}
	}

	SetCurrentArena(saved)
}

// hashmapDestroy, hashmapFreeBuckets, hashmapDeepFree removed:
// arena-per-function model, no individual free. Arena bulk-frees at munmap.

//:linkname hashmapClone maps.clone
func hashmapClone(intf _interface) _interface {
	typ, val := decomposeInterface(intf)
	m := (*hashmap)(val)
	// Heap-allocate destination so the interface value doesn't point to stack.
	dst := (*hashmap)(alloc(unsafe.Sizeof(hashmap{}), nil))
	hashmapCopyTo(m, dst, m.bucketBits)
	return composeInterface(typ, unsafe.Pointer(dst))
}

// hashmapCopy allocates a new hashmap and copies all entries from src.
// Used by the deep-copy-on-return codegen for map types.
func hashmapCopy(src unsafe.Pointer) unsafe.Pointer {
	m := (*hashmap)(src)
	if m == nil {
		return nil
	}
	dst := (*hashmap)(alloc(unsafe.Sizeof(hashmap{}), nil))
	hashmapCopyTo(m, dst, m.bucketBits)
	return unsafe.Pointer(dst)
}

// hashmapCopyTo copies all entries from src into dst. dst is written through
// a pointer - no by-value struct return, no SRET aliasing. Fields are
// assigned individually so dst.buckets never transiently shares src.buckets.
func hashmapCopyTo(src, dst *hashmap, sizeBits uint8) {
	dst.keySize = src.keySize
	dst.valueSize = src.valueSize
	dst.keyEqual = src.keyEqual
	dst.keyHash = src.keyHash
	dst.keyLess = src.keyLess
	dst.owner = CurrentArena()
	dst.bucketBits = sizeBits
	dst.count = 0
	dst.seed = uintptr(fastrand())

	numBuckets := uintptr(1) << sizeBits
	bucketBufSize := hashmapBucketSize(src)
	dst.buckets = alloc(bucketBufSize*numBuckets, nil)

	var it hashmapIterator
	var key = alloc(src.keySize, nil)
	var value = alloc(src.valueSize, nil)

	for hashmapNext(src, &it, key, value) {
		h := dst.keyHash(key, uintptr(dst.keySize), dst.seed)
		hashmapSet(dst, key, value, h)
	}
}

// Get the value of a specified key, or zero the value if not found.
//
//:nobounds
func hashmapGet(m *hashmap, key, value unsafe.Pointer, valueSize uintptr, hash uint32) bool {
	if m == nil {
		// Getting a value out of a nil map is valid. From the spec:
		// > if the map is nil or does not contain such an entry, a[x] is the
		// > zero value for the element type of M
		memzero(value, uintptr(valueSize))
		return false
	}

	tophash := hashmapTopHash(hash)
	bucket := hashmapBucketAddrForHash(m, hash)

	// Try to find the key.
	for bucket != nil {
		for i := uint8(0); i < 8; i++ {
			slotKey := hashmapSlotKey(m, bucket, i)
			slotValue := hashmapSlotValue(m, bucket, i)
			if bucket.tophash[i] == tophash {
				if m.keyEqual(key, slotKey, m.keySize) {
					memcpy(value, slotValue, m.valueSize)
					return true
				}
			}
		}
		bucket = bucket.next
	}

	// Did not find the key.
	memzero(value, m.valueSize)
	return false
}

// Delete a given key from the map. No-op when the key does not exist in the
// map.
//
//:nobounds
func hashmapDelete(m *hashmap, key unsafe.Pointer, hash uint32) {
	if m == nil {
		// The delete builtin is defined even when the map is nil. From the spec:
		// > If the map m is nil or the element m[k] does not exist, delete is a
		// > no-op.
		return
	}

	tophash := hashmapTopHash(hash)
	bucket := hashmapBucketAddrForHash(m, hash)

	// Try to find the key.
	for bucket != nil {
		for i := uint8(0); i < 8; i++ {
			slotKey := hashmapSlotKey(m, bucket, i)
			if bucket.tophash[i] == tophash {
				// This could be the key we're looking for.
				if m.keyEqual(key, slotKey, m.keySize) {
					// Found the key, delete it.
					bucket.tophash[i] = 0
					// Zero out the key and value.
					memzero(slotKey, m.keySize)
					slotValue := hashmapSlotValue(m, bucket, i)
					memzero(slotValue, m.valueSize)
					m.count--
					return
				}
			}
		}
		bucket = bucket.next
	}
}

// Iterate over a hashmap in lexicographic key order.
//
//:nobounds
func hashmapNext(m *hashmap, it *hashmapIterator, key, value unsafe.Pointer) bool {
	if m == nil {
		return false
	}

	if it.sortedKeys == nil {
		// First call: collect all keys, sort them.
		n := m.count
		if n == 0 {
			return false
		}
		it.keySize = m.keySize
		it.valueSize = m.valueSize
		it.count = n
		it.index = 0

		buf := alloc(m.keySize*n, nil)
		it.sortedKeys = buf

		// Walk all buckets and collect keys.
		numBuckets := uintptr(1) << m.bucketBits
		pos := uintptr(0)
		for bi := uintptr(0); bi < numBuckets; bi++ {
			bucket := hashmapBucketAddr(m, m.buckets, bi)
			for bucket != nil {
				for si := uint8(0); si < 8; si++ {
					if bucket.tophash[si] != 0 {
						slotKey := hashmapSlotKey(m, bucket, si)
						dst := unsafe.Add(buf, pos*m.keySize)
						memcpy(dst, slotKey, m.keySize)
						pos++
					}
				}
				bucket = bucket.next
			}
		}
		it.count = pos

		// Insertion sort by keyLess.
		less := m.keyLess
		ks := m.keySize
		tmp := alloc(ks, nil)
		for i := uintptr(1); i < pos; i++ {
			for j := i; j > 0; j-- {
				kj := unsafe.Add(buf, j*ks)
				kjm1 := unsafe.Add(buf, (j-1)*ks)
				if !less(kj, kjm1, ks) {
					break
				}
				memcpy(tmp, kj, ks)
				memcpy(kj, kjm1, ks)
				memcpy(kjm1, tmp, ks)
			}
		}
	}

	if it.index >= it.count {
		it.sortedKeys = nil
		return false
	}

	// Copy sorted key, look up current value from the live map.
	sortedKey := unsafe.Add(it.sortedKeys, it.index*it.keySize)
	memcpy(key, sortedKey, it.keySize)
	hash := m.keyHash(key, m.keySize, m.seed)
	hashmapGet(m, key, value, m.valueSize, hash)
	it.index++
	return true
}

// Hashmap with plain binary data keys (not containing strings etc.).
func hashmapBinarySet(m *hashmap, key, value unsafe.Pointer) {
	if m == nil {
		nilMapPanic()
	}
	hash := hash32(key, m.keySize, m.seed)
	hashmapSet(m, key, value, hash)
}

func hashmapBinaryGet(m *hashmap, key, value unsafe.Pointer, valueSize uintptr) bool {
	if m == nil {
		memzero(value, uintptr(valueSize))
		return false
	}
	hash := hash32(key, m.keySize, m.seed)
	return hashmapGet(m, key, value, valueSize, hash)
}

func hashmapBinaryDelete(m *hashmap, key unsafe.Pointer) {
	if m == nil {
		return
	}
	hash := hash32(key, m.keySize, m.seed)
	hashmapDelete(m, key, hash)
}

// Hashmap with string keys (a common case).

func hashmapContentEqual(x, y unsafe.Pointer, n uintptr) bool {
	sx := *(*_string)(x)
	sy := *(*_string)(y)
	if sx.length != sy.length {
		return false
	}
	return memequal(unsafe.Pointer(sx.ptr), unsafe.Pointer(sy.ptr), uintptr(sx.length))
}

func hashmapContentHash(s string, seed uintptr) uint32 {
	_s := (*_string)(unsafe.Pointer(&s))
	return hash32(unsafe.Pointer(_s.ptr), uintptr(_s.length), seed)
}

func hashmapContentPtrHash(sptr unsafe.Pointer, size uintptr, seed uintptr) uint32 {
	_s := *(*_string)(sptr)
	return hash32(unsafe.Pointer(_s.ptr), uintptr(_s.length), seed)
}

func hashmapContentSet(m *hashmap, key string, value unsafe.Pointer) {
	if m == nil {
		nilMapPanic()
	}
	hash := hashmapContentHash(key, m.seed)
	// Deep-copy the key bytes into the map's owner arena: the key is a
	// borrowed view and may die with its frame. Always copy (cheap for
	// short strings) to avoid a nil-value-pointer issue with the
	// existence-check path.
	var st _string
	_s := (*_string)(unsafe.Pointer(&key))
	if _s.length > 0 {
		saved := CurrentArena()
		SetCurrentArena(hashmapOwner(m))
		kb := alloc(uintptr(_s.length), nil)
		memcpy(kb, unsafe.Pointer(_s.ptr), uintptr(_s.length))
		SetCurrentArena(saved)
		st.ptr = (*uint8)(kb)
		st.length = _s.length
	}
	hashmapSet(m, unsafe.Pointer(&st), value, hash)
}

func hashmapContentGet(m *hashmap, key string, value unsafe.Pointer, valueSize uintptr) bool {
	if m == nil {
		memzero(value, uintptr(valueSize))
		return false
	}
	hash := hashmapContentHash(key, m.seed)
	return hashmapGet(m, unsafe.Pointer(&key), value, valueSize, hash)
}

func hashmapContentDelete(m *hashmap, key string) {
	if m == nil {
		return
	}
	hash := hashmapContentHash(key, m.seed)
	hashmapDelete(m, unsafe.Pointer(&key), hash)
}

// Hashmap with interface keys (for everything else).

// This is a method that is intentionally unexported in the reflect package. It
// is identical to the Interface() method call, except it doesn't check whether
// a field is exported and thus allows circumventing the type system.
// The hash function needs it as it also needs to hash unexported struct fields.
//
func hashmapFloat32Hash(ptr unsafe.Pointer, seed uintptr) uint32 {
	f := *(*uint32)(ptr)
	if f == 0x80000000 {
		// convert -0 to 0 for hashing
		f = 0
	}
	return hash32(unsafe.Pointer(&f), 4, seed)
}

func hashmapFloat64Hash(ptr unsafe.Pointer, seed uintptr) uint32 {
	f := *(*uint64)(ptr)
	if f == 0x8000000000000000 {
		// convert -0 to 0 for hashing
		f = 0
	}
	return hash32(unsafe.Pointer(&f), 8, seed)
}

func hashmapInterfaceHash(itf _interface, seed uintptr) uint32 {
	iface := (*_interface)(unsafe.Pointer(&itf))
	if iface.typecode == nil {
		return 0 // nil interface
	}

	t := (*RawType)(iface.typecode)
	value := iface.value

	// Convert interface value to direct data pointer.
	ptr := value
	if t.Size() <= unsafe.Sizeof(uintptr(0)) {
		ptr = unsafe.Pointer(&value)
	}

	return hashmapPtrHash(t, ptr, seed)
}

// hashmapPtrHash hashes the value at ptr. ptr always points directly to the
// value data - no interface packing. Used for recursive struct/array hashing.
func hashmapPtrHash(t *RawType, ptr unsafe.Pointer, seed uintptr) uint32 {
	k := t.Kind()

	switch k {
	case Int, Int8, Int16, Int32, Int64:
		return hash32(ptr, t.Size(), seed)
	case Bool, Uint, Uint8, Uint16, Uint32, Uint64, Uintptr:
		return hash32(ptr, t.Size(), seed)
	case Float32:
		return hashmapFloat32Hash(ptr, seed)
	case Float64:
		return hashmapFloat64Hash(ptr, seed)
	case Complex64:
		rptr, iptr := ptr, unsafe.Add(ptr, 4)
		return hashmapFloat32Hash(rptr, seed) ^ hashmapFloat32Hash(iptr, seed)
	case Complex128:
		rptr, iptr := ptr, unsafe.Add(ptr, 8)
		return hashmapFloat64Hash(rptr, seed) ^ hashmapFloat64Hash(iptr, seed)
	case KindBytes:
		return hashmapContentHash(*(*string)(ptr), seed)
	case KindChan, KindPointer, KindUnsafePointer:
		return hash32(ptr, t.Size(), seed)
	case KindArray:
		elemType := t.Elem()
		elemSize := elemType.Size()
		length := t.ArrayLen()
		var hash uint32
		for i := 0; i < length; i++ {
			ep := unsafe.Add(ptr, uintptr(i)*elemSize)
			hash ^= hashmapPtrHash(elemType, ep, seed)
		}
		return hash
	case KindStruct:
		nf := t.NumField()
		var hash uint32
		for i := 0; i < nf; i++ {
			ft := t.StructFieldType(i)
			off := t.StructFieldOffset(i)
			fp := unsafe.Add(ptr, off)
			hash ^= hashmapPtrHash(ft, fp, seed)
		}
		return hash
	case KindInterface:
		return hashmapInterfaceHash(*(*_interface)(ptr), seed)
	default:
		runtimePanic("comparing un-comparable type")
		return 0
	}
}

func hashmapInterfacePtrHash(iptr unsafe.Pointer, size uintptr, seed uintptr) uint32 {
	_i := *(*_interface)(iptr)
	return hashmapInterfaceHash(_i, seed)
}

func hashmapInterfaceEqual(x, y unsafe.Pointer, n uintptr) bool {
	return interfaceEqual(*(*_interface)(x), *(*_interface)(y))
}

func hashmapInterfaceSet(m *hashmap, key _interface, value unsafe.Pointer) {
	if m == nil {
		nilMapPanic()
	}
	hash := hashmapInterfaceHash(key, m.seed)
	hashmapSet(m, unsafe.Pointer(&key), value, hash)
}

func hashmapInterfaceGet(m *hashmap, key _interface, value unsafe.Pointer, valueSize uintptr) bool {
	if m == nil {
		memzero(value, uintptr(valueSize))
		return false
	}
	hash := hashmapInterfaceHash(key, m.seed)
	return hashmapGet(m, unsafe.Pointer(&key), value, valueSize, hash)
}

func hashmapInterfaceDelete(m *hashmap, key _interface) {
	if m == nil {
		return
	}
	hash := hashmapInterfaceHash(key, m.seed)
	hashmapDelete(m, unsafe.Pointer(&key), hash)
}
