//:build moxie.wasm || baremetal

package runtime

// coverOutFD has no file to open on wasm or baremetal: counts stay in the table
// and the host reads them through __moxie_cover_counters_ptr. MoxieWrite is a
// stub there, so the dump to fd 2 is a no-op too.
func coverOutFD() (fd int32) {
	return 2
}
