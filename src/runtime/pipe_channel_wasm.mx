//:build js && wasm

package runtime

// WASM stubs for native-only domain functions that chan.mx and the
// scheduler call unconditionally. The spawn-bound channel transport for
// WASM lives in spawn_wasm.mx (SAB rings); only the OS process surface
// has no WASM equivalent.

// domainShutdownAll is a no-op on WASM: no OS child processes.
func domainShutdownAll() {}
