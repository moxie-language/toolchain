//:build go1.23

package runtime

import "unsafe"

// Time functions for Go 1.23 and above.

// This is the timer that's used internally inside the runtime.
type timer struct {
	// When to call the timer, and the interval for the ticker.
	when   int64
	period int64

	// Callback from the time package.
	f   func(arg unsafe.Pointer, seq uintptr, delta int64)
	arg unsafe.Pointer
}

func (tim *timer) callCallback(delta int64) {
	tim.f(tim.arg, 0, delta)
}

// This is the struct used internally in the runtime. The first two fields are
// the same as time.Timer and time.Ticker so it can be used as-is in the time
// package.
type timeTimer struct {
	c    unsafe.Pointer // <-chan time.Time
	init bool
	timer
}

//:linkname newTimer time.newTimer
func newTimer(when, period int64, f func(a unsafe.Pointer, seq uintptr, delta int64), arg unsafe.Pointer, c unsafe.Pointer) *timeTimer {
	// The timer and its queue node are owned by the runtime and outlive the
	// frame that created them: allocate both in the root arena. Allocating
	// them with the caller's current arena put the node in a frame arena that
	// was released and reused while the node was still queued, and
	// timerQueueRemove then walked a queue whose node pointer was a recycled
	// address (SIGSEGV at cmp %rcx,0x8(%rax) with rax=0x73, reached from
	// net.DialTimeout -> context.WithDeadline's Timer.Stop).
	prevArena := CurrentArena()
	SetCurrentArena(trueRootArena())
	tim := &timeTimer{
		c:    c,
		init: true,
		timer: timer{
			when:   when,
			period: period,
			f:      f,
			arg:    arg,
		},
	}
	scheduleLog("new timer")
	addTimer(&timerNode{
		timer:    &tim.timer,
		callback: timerCallback,
	})
	SetCurrentArena(prevArena)
	return tim
}

//:linkname stopTimer time.stopTimer
func stopTimer(tim *timeTimer) bool {
	return removeTimer(&tim.timer) != nil
}

//:linkname resetTimer time.resetTimer
func resetTimer(t *timeTimer, when, period int64) bool {
	t.timer.when = when
	t.timer.period = period
	n := removeTimer(&t.timer)
	removed := n != nil
	if n == nil {
		// Same lifetime rule as newTimer: the node is re-queued and must not
		// live in the caller's frame arena.
		prevArena := CurrentArena()
		SetCurrentArena(trueRootArena())
		n = &timerNode{}
		SetCurrentArena(prevArena)
	}
	n.timer = &t.timer
	n.callback = timerCallback
	addTimer(n)
	return removed
}
