package runtime

// This file implements the 'chan' type and send/receive/select operations.
//
// Every channel has a list of senders and a list of receivers, and possibly a
// queue. There is no 'channel state', the state is inferred from the available
// senders/receivers and values in the buffer.
//
// - A sender will first try to send the value to a waiting receiver if there is
//   one, but only if there is nothing in the queue (to keep the values flowing
//   in the correct order). If it can't, it will add the value in the queue and
//   possibly wait as a sender if there's no space available.
// - A receiver will first try to read a value from the queue, but if there is
//   none it will try to read from a sender in the list. It will block if it
//   can't proceed.
//
// State is kept in various ways:
//
// - The sender value is stored in the sender 'channelOp', which is really a
//   queue entry. This works for both senders and select operations: a select
//   operation has a separate value to send for each case.
// - The receiver value is stored inside Task.Ptr. This works for receivers, and
//   importantly also works for select which has a single buffer for every
//   receive operation.
// - The `Task.Data` value stores how the channel operation proceeded. For
//   normal send/receive operations, it starts at chanOperationWaiting and then
//   is changed to chanOperationOk or chanOperationClosed depending on whether
//   the send/receive proceeded normally or because it was closed. For a select
//   operation, it also stores the 'case' index in the upper bits (zero for
//   non-select operations) so that the select operation knows which case did
//   proceed.
//   The value is at the same time also a way that goroutines can be the first
//   (and only) goroutine to 'take' a channel operation using an atomic CAS
//   operation to change it from 'waiting' to any other value. This is important
//   for the select statement because multiple goroutines could try to let
//   different channels in the select statement proceed at the same time. By
//   using Task.Data, only a single channel operation in the select statement
//   can proceed.
// - It is possible for the channel queues to contain already-processed senders
//   or receivers. This can happen when the select statement managed to proceed
//   but the goroutine doing the select has not yet cleaned up the stale queue
//   entries before returning. This should therefore only happen for a short
//   period.

import (
	"internal/task"
	"moxie"
	"runtime/interrupt"
	"unsafe"
)

// The runtime implementation of the Go 'chan' type.
type channel struct {
	closed      bool
	elementSize uintptr
	bufCap       uintptr // 'cap'
	bufLen       uintptr // 'len'
	bufHead      uintptr
	bufTail      uintptr
	senders      chanQueue
	receivers    chanQueue
	buf unsafe.Pointer

	// Spawn-boundary metadata (native targets only). When spawnBound is
	// true the channel is on a fork + shared-ring boundary, not a local
	// in-runtime queue. send/recv route through the ring buffers with
	// codec-encoded bytes. Zero values = local channel, existing
	// behavior unchanged.
	spawnBound  bool
	spawnChanID uint16
	spawnPid    int32    // peer pid for death detection (0 = local/none)
	// A spawn channel carries one SPSC ring per DIRECTION, and both domains
	// hold the SAME channel object - a domain is a thread, so parent and child
	// share memory. The pair is therefore stored once and the direction is
	// chosen by role: a forked child used to get its own copy of this struct
	// with the two fields swapped, which two threads cannot do.
	ringA       uintptr  // parent->child direction (0 = local channel)
	ringB       uintptr  // child->parent direction (0 = local channel)
	// ownerBreaker is the termination breaker of the domain on the other end of
	// this spawn channel, recorded by spawnDomain. A parked parent rechecks it
	// exactly as the fork runtime rechecked the child pid: when the domain ends,
	// its breaker closes, and the parent's wait returns instead of parking
	// forever on a peer that no longer exists.
	ownerBreaker *channel
	// frameBudget is the compiler-computed byte ceiling on one structurally
	// encoded message. The ring a spawn channel carries is sized from it (the
	// declared depth plus one in-flight frame), so a message that overruns it
	// is a loud failure rather than a silently undersized ring. frameNote is
	// the compiler's list of the variable-length fields and cap tags that set
	// that budget, so the failure names the declaration to change.
	frameBudget uintptr
	frameNote   []byte
	// On wasm a spawn-bound channel's ring lives in JavaScript behind an
	// opaque int32 handle (see spawn_wasm.mx), so there is no ring address to
	// hold: sabHandle carries that handle instead. Zero means local.
	sabHandle   uintptr
}

const (
	chanOperationWaiting = 0b00 // waiting for a send/receive operation to continue
	chanOperationOk      = 0b01 // successfully sent or received (not closed)
	chanOperationClosed  = 0b10 // channel was closed, the value has been zeroed
	chanOperationMask    = 0b11
)

type chanQueue struct {
	first *channelOp
}

// Pus the next channel operation to the queue. All appropriate fields must have
// been initialized already.
// This function must be called with interrupts disabled and the channel lock
// held.
func (q *chanQueue) push(node *channelOp) {
	node.next = q.first
	q.first = node
}

// Pop the next waiting channel from the queue. Channels that are no longer
// waiting (for example, when they're part of a select operation) will be
// skipped.
// This function must be called with interrupts disabled.
func (q *chanQueue) pop(chanOp uint32) *channelOp {
	var popped *channelOp
	var newDataValue uint32
	var swapped bool
	for {
		if q.first == nil {
			return nil
		}

		// Pop next from the queue.
		popped = q.first
		q.first = q.first.next

		// The new value for the 'data' field will be a combination of the
		// channel operation and the select index. (The select index is 0 for
		// non-select channel operations).
		newDataValue = chanOp | popped.index<<2

		// Try to be the first to proceed with this goroutine.
		swapped = popped.taskRef.CompareAndSwapDataUint32(0, newDataValue)
		if swapped {
			return popped
		}
	}
}

// Remove the given to-be-removed node from the queue if it is part of the
// queue. If there are multiple, only one will be removed.
// This function must be called with interrupts disabled and the channel lock
// held.
func (q *chanQueue) remove(remove *channelOp) {
	n := &q.first
	for *n != nil {
		if *n == remove {
			*n = (*n).next
			return
		}
		n = &((*n).next)
	}
}

type channelOp struct {
	next  *channelOp
	taskRef *task.Task
	index uint32         // select index, 0 for non-select operation
	value unsafe.Pointer // if this is a sender, this is the value to send
}

type chanSelectState struct {
	ch    *channel
	value unsafe.Pointer
	// A spawn-bound arm moves a FRAME, and an element that holds references
	// must be encoded with the same format the peer's direct receive decodes.
	// codec is the element's own codec when its type has one; td is the
	// structural codec's type descriptor when it does not. Both nil means the
	// element is self-contained and its extent IS the frame. They are set by
	// the compiler, which knows the element type of every arm.
	codec moxie.Codec
	td    *RawType
}

// codecFrameEncode renders one channel element as the frame the peer's decode
// expects. Exactly one of c and td is set for an element that holds references -
// its own codec when the type has one, the structural codec otherwise - and both
// are nil when the element is self-contained, in which case its extent IS the
// frame. size is the element's size in bytes.
func codecFrameEncode(c moxie.Codec, td *RawType, value unsafe.Pointer, size uintptr) (frame []byte, ok bool) {
	if c != nil {
		var w moxie.PipeWriter
		if err := c.EncodeTo(&w); err != nil {
			return nil, false
		}
		return w.Buf, true
	}
	if td != nil {
		var cb CodecBuf
		var ss codecSeenSet
		codecSeenInit(&ss)
		// Nothing may be aliased across a domain boundary: a stable-slice frame
		// would hand the receiver a reference into this side's memory.
		codecCrossDomain = true
		codecEncodeValue(&cb, &ss, value, td)
		codecCrossDomain = false
		return cb.data, true
	}
	if size == 0 {
		return nil, true
	}
	if value == nil {
		return nil, false
	}
	return unsafe.Slice((*byte)(value), size), true
}

// codecFrameDecode places one received frame into value, the receiver's own
// T-sized slot. The codec route decodes through the codec's own value pointer
// (which is that same slot); the structural route relocates into value; an
// extent frame is exactly the element's bytes, and a length that disagrees with
// the element type is a compiler bug that is reported as one.
func codecFrameDecode(c moxie.Codec, td *RawType, value unsafe.Pointer, size uintptr, frame []byte) (ok bool) {
	if c != nil {
		var r moxie.PipeReader
		r.Buf = frame
		return c.DecodeFrom(&r) == nil
	}
	if td != nil {
		var cb CodecBuf
		cb.data = frame
		var ds codecDecodeSeen
		codecDecodeSeenInit(&ds)
		p := codecDecodeValue(&cb, &ds, td)
		if p == nil {
			return false
		}
		memcpy(value, p, td.Size())
		return true
	}
	if uintptr(len(frame)) != size {
		runtimePanic("spawn extent frame size mismatch: received " | codecItoa(int32(len(frame))) | " bytes for a " | codecItoa(int32(size)) | "-byte element")
	}
	if size > 0 && value != nil {
		recvStore(value, unsafe.Pointer(&frame[0]), size)
	}
	return true
}

func chanMake(elementSize uintptr, bufSize uintptr, frameBudget uintptr, notePtr unsafe.Pointer, noteLen uintptr) *channel {
	// A channel is a mailbox with at least one slot. A Moxie domain has one
	// thread, so an unbuffered channel has no possible listener and its first
	// send could never complete. The literal rewrite makes `chan T{}` one slot
	// and the compilers reject a constant below one; this catches a capacity
	// computed at run time, before any send can hang on it.
	if bufSize == 0 {
		runtimePanic("chanMake: channel capacity must be at least 1: a Moxie domain has one thread, so an unbuffered channel has no possible listener")
	}
	var note []byte
	if notePtr != nil && noteLen > 0 {
		note = unsafe.Slice((*byte)(notePtr), noteLen)
	}
	return &channel{
		elementSize: elementSize,
		bufCap:      bufSize,
		frameBudget: frameBudget,
		frameNote:   note,
		buf:         alloc(elementSize*bufSize, nil),
	}
}

// Return the number of entries in this chan, called from the len builtin.
// A nil chan is defined as having length 0.
func chanLen(c *channel) int32 {
	if c == nil {
		return 0
	}
	return int32(c.bufLen)
}

// Return the capacity of this chan, called from the cap builtin.
// A nil chan is defined as having capacity 0.
func chanCap(c *channel) int32 {
	if c == nil {
		return 0
	}
	return int32(c.bufCap)
}

// Push the value to the channel buffer array, for a send operation.
// This function may only be called when interrupts are disabled, the channel is
// locked and it is known there is space available in the buffer.
func (ch *channel) bufferPush(value unsafe.Pointer) {
	elemAddr := unsafe.Add(ch.buf, ch.bufHead*ch.elementSize)
	ch.bufLen++
	ch.bufHead++
	if ch.bufHead == ch.bufCap {
		ch.bufHead = 0
	}

	memcpy(elemAddr, value, ch.elementSize)
}

// Pop a value from the channel buffer and store it in the 'value' pointer, for
// a receive operation.
// This function may only be called when interrupts are disabled, the channel is
// locked and it is known there is at least one value available in the buffer.
func (ch *channel) bufferPop(value unsafe.Pointer) {
	elemAddr := unsafe.Add(ch.buf, ch.bufTail*ch.elementSize)
	ch.bufLen--
	ch.bufTail++
	if ch.bufTail == ch.bufCap {
		ch.bufTail = 0
	}

	recvStore(value, elemAddr, ch.elementSize)

	// Zero the slot after read.
	memzero(elemAddr, ch.elementSize)
}

// Try to proceed with this send operation without blocking, and return whether
// the send succeeded. Interrupts must be disabled and the lock must be held
// when calling this function.
func (ch *channel) trySend(value unsafe.Pointer) bool {
	// To make sure we send values in the correct order, we can only send
	// directly to a receiver when there are no values in the buffer.

	// Do not allow sending on a closed channel.
	if ch.closed {
		// Note: we cannot currently recover from this panic.
		// There's some state in the select statement especially that would be
		// corrupted if we allowed recovering from this panic.
		runtimePanic("send on closed channel")
	}

	// There is no value in the buffer and we have a receiver available. Copy
	// the value directly into the receiver.
	if ch.bufLen == 0 {
		if receiver := ch.receivers.pop(chanOperationOk); receiver != nil {
			recvStore(receiver.taskRef.Ptr, value, ch.elementSize)
			scheduleTask(receiver.taskRef)
			return true
		}
	}

	// If there is space in the buffer (if this is a buffered channel), we can
	// store the value in the buffer and continue.
	if ch.bufLen < ch.bufCap {
		ch.bufferPush(value)
		return true
	}
	return false
}

func chanSend(ch *channel, value unsafe.Pointer, op *channelOp) {
	if ch == nil {
		// A nil channel blocks forever. Do not schedule this goroutine again.
		deadlock()
	}

	// Spawn-bound channels carry their payload in the shared ring, not in
	// the in-runtime queue. tryPipeSend is a single non-blocking attempt, so
	// parking on ch.senders after it fails would never be woken: the remote
	// end writes the ring, it does not know about this domain's senders.
	// Retry in the pipe helper, which knows how to distinguish backpressure
	// from a closed or dead peer.
	if ch.spawnBound {
		PipeChanSendRaw(ch, value, int32(ch.elementSize))
		return
	}

	mask := interrupt.Disable()

	// See whether we can proceed immediately, and if so, return early.
	if ch.trySend(value) {
		interrupt.Restore(mask)
		return
	}

	// Can't proceed. Add us to the list of senders and wait until we're awoken.
	t := task.Current()
	t.SetDataUint32(chanOperationWaiting)
	op.taskRef = t
	op.index = 0
	op.value = value
	ch.senders.push(op)
	interrupt.Restore(mask)

	// Wait until a receiver picks up the value.
	if !hasScheduler {
		for t.DataUint32() == chanOperationWaiting {
			sigintPoll()
			if hasPoll {
				netpollBlock(100)
			} else {
				sleepTicks(nanosecondsToTicks(100_000_000))
			}
			fireTimers()
		}
	} else {
		sigintPoll()
		task.Pause()
	}

	// Check whether the sent happened normally (not because the channel was
	// closed while sending).
	if t.DataUint32() == chanOperationClosed {
		// Oops, this channel was closed while sending!
		runtimePanic("send on closed channel")
	}
}

// Try to proceed with this receive operation without blocking, and return
// whether the receive operation succeeded. Interrupts must be disabled and the
// lock must be held when calling this function.
func (ch *channel) tryRecv(value unsafe.Pointer) (received, ok bool) {
	// To make sure we keep the values in the channel in the correct order, we
	// first have to read values from the buffer before we can look at the
	// senders.

	// If there is a value available in the buffer, we can pull it out and
	// proceed immediately.
	if ch.bufLen > 0 {
		ch.bufferPop(value)

		// Check for the next sender available and push it to the buffer.
		if sender := ch.senders.pop(chanOperationOk); sender != nil {
			ch.bufferPush(sender.value)
			scheduleTask(sender.taskRef)
		}

		return true, true
	}

	if ch.closed {
		// Channel is closed, so proceed immediately.
		recvZero(value, ch.elementSize)
		return true, false
	}

	// If there is a sender, we can proceed with the channel operation
	// immediately.
	if sender := ch.senders.pop(chanOperationOk); sender != nil {
		recvStore(value, sender.value, ch.elementSize)
		scheduleTask(sender.taskRef)
		return true, true
	}

	return false, false
}

func chanRecv(ch *channel, value unsafe.Pointer, op *channelOp) bool {
	if ch == nil {
		// A nil channel blocks forever. Do not schedule this goroutine again.
		deadlock()
	}

	// Spawn-bound channels deliver through the shared ring and have no
	// in-runtime waker. Parking on ch.receivers after one empty ring read
	// would hang forever; poll the ring instead. PipeChanRecvRaw also
	// reports closed and dead-peer as ok=false, matching chanRecv.
	if ch.spawnBound {
		return PipeChanRecvRaw(ch, value, int32(ch.elementSize))
	}

	mask := interrupt.Disable()

	if received, ok := ch.tryRecv(value); received {
		interrupt.Restore(mask)
		return ok
	}

	// We can't proceed, so we add ourselves to the list of receivers and wait
	// until we're awoken.
	t := task.Current()
	t.Ptr = value
	t.SetDataUint32(chanOperationWaiting)
	op.taskRef = t
	op.index = 0
	ch.receivers.push(op)
	interrupt.Restore(mask)

	// Wait until a sender provides a value.
	if !hasScheduler {
		for t.DataUint32() == chanOperationWaiting {
			sigintPoll()
			if hasPoll {
				netpollBlock(100)
			} else {
				sleepTicks(nanosecondsToTicks(100_000_000))
			}
			fireTimers()
		}
	} else {
		sigintPoll()
		task.Pause()
	}

	// Return whether the receive happened from a closed channel.
	return t.DataUint32() != chanOperationClosed
}

// chanClose closes the given channel. If this channel has a receiver or is
// empty, it closes the channel. Else, it panics.

// DomainClosed is the breaker channel of the domain being run: in a spawn child
// it is the same object the parent received from spawn, so a close by either
// side is visible to both. Nil in the root domain. It is a signal, not a
// message: `chan struct{}` with nothing ever sent on it.
var DomainClosed *channel

// ClosedBreakerChan is the domain's breaker, bound to a spawn target's `closed`
// result in the function prologue.
func ClosedBreakerChan() *channel { return DomainClosed }

// sigintChan is the domain's termination channel. The predeclared word `sigint`
// names it, so it must outlive every frame that selects on it: it is created on
// first use in the root arena.
var sigintChan *channel

// sigintFired records that the termination channel has been closed, so a flag
// observed at two poll sites closes once.
var sigintFired bool

// SigintChan is the termination channel; the compiler lowers `sigint` to this
// call. A receive on it fires when the process is told to stop, and a select
// arm on it runs then like any arm on a closed channel.
func SigintChan() (ch *channel) {
	if sigintChan != nil {
		return sigintChan
	}
	save := CurrentArena()
	SetCurrentArena(trueRootArena())
	sigintChan = chanMake(0, 1, 0, nil, 0)
	SetCurrentArena(save)
	return sigintChan
}

// sigintPoll closes the termination channel once the signal handler has raised
// the flag. The handler itself cannot: it may interrupt an allocation, a
// channel operation or a held lock. Every point where the domain waits calls
// this, so the close happens in normal context and receivers wake through the
// ordinary closed-channel path.
func sigintPoll() {
	if sigintChan == nil || sigintFired {
		return
	}
	if !sigintPending() {
		return
	}
	sigintFired = true
	chanClose(sigintChan)
}

// AssertBreaker binds a spawn target's closed result and fails loud when the
// function was called directly instead of spawned: a nil breaker disables the
// closed arm of the select and the loop then runs forever with no symptom.
func AssertBreaker(ch *channel) *channel {
	if ch == nil {
		return breakerFallback()
	}
	return ch
}

// SpawnClose closes a breaker once; nil is a no-op because a spawn that failed
// has no child to terminate.
func SpawnClose(ch *channel) {
	if ch == nil {
		return
	}
	if ch.spawnBound {
		// The breaker rides the control ring both sides read, not a
		// copy-on-write flag: closing it means closing that ring.
		PipeChanCloseSignal(ch)
		return
	}
	if ch.closed {
		return
	}
	chanClose(ch)
}

func chanClose(ch *channel) {
	if ch == nil {
		// Not allowed by the language spec.
		runtimePanic("close of nil channel")
	}

	mask := interrupt.Disable()

	if ch.closed {
		// Not allowed by the language spec.
		interrupt.Restore(mask)
		runtimePanic("close of closed channel")
	}

	// Proceed all receiving operations that are blocked.
	for {
		receiver := ch.receivers.pop(chanOperationClosed)
		if receiver == nil {
			// Processed all receivers.
			break
		}

		// Zero the value that the receiver is getting.
		memzero(receiver.taskRef.Ptr, ch.elementSize)

		// Wake up the receiving goroutine.
		scheduleTask(receiver.taskRef)
	}

	// Let all senders panic.
	for {
		sender := ch.senders.pop(chanOperationClosed)
		if sender == nil {
			break // processed all senders
		}

		// Wake up the sender.
		scheduleTask(sender.taskRef)
	}

	ch.closed = true

	interrupt.Restore(mask)

	// Spawn-boundary: if this is a pipe-bound channel, signal the remote
	// end so its receiver-side bridge / chan recv observes the close.
	if ch.spawnBound {
		PipeChanCloseSignal(ch)
		// A control breaker is its domain's termination handle. A domain is a
		// thread in this process, so the close is observed by its loop where it
		// runs Moxie code; there is no process to signal and nothing to reap.
	}
}

// Lock all channels (taking care to skip duplicate channels).
// No-op: Moxie is single-threaded, hasParallelism is always false.
func lockAllStates(states []chanSelectState) {
}

// Unlock all channels (taking care to skip duplicate channels).
// No-op: Moxie is single-threaded, hasParallelism is always false.
func unlockAllStates(states []chanSelectState) {
}

// chanSelect implements blocking or non-blocking select operations.
// The 'ops' slice must be set if (and only if) this is a blocking select.
func chanSelect(recvbuf unsafe.Pointer, states []chanSelectState, ops []channelOp) (uint32, bool) {
	mask := interrupt.Disable()

	// Lock everything.
	lockAllStates(states)

	var selectNoIndex uint32 = 4294967295
	selectIndex := selectNoIndex
	selectOk := true

	// Iterate over each state, and see if it can proceed.
	// Deterministic: first ready channel in source order wins.
	for i, state := range states {
		if state.ch == nil {
			// A nil channel blocks forever, so it won't take part of the select
			// operation.
			continue
		}

		if state.ch.spawnBound {
			// The boundary arm moves a frame, not the element's extent: an
			// element that holds references is encoded here, exactly as its
			// direct send would encode it, and the peer decodes one format.
			if state.value == nil { // chan receive
				if received, ok := state.ch.tryPipeRecv(recvbuf, state.codec, state.td); received {
					selectIndex = uint32(i)
					selectOk = ok
					break
				}
			} else if state.ch.tryPipeSend(state.value, state.codec, state.td) { // chan send
				selectIndex = uint32(i)
				break
			}
			continue
		}

		if state.value == nil { // chan receive
			if received, ok := state.ch.tryRecv(recvbuf); received {
				selectIndex = uint32(i)
				selectOk = ok
				break
			}
		} else { // chan send
			if state.ch.trySend(state.value) {
				selectIndex = uint32(i)
				break
			}
		}
	}

	// If this select can immediately proceed, or is a non-blocking select,
	// return early.
	blocking := len(ops) != 0
	if selectIndex != selectNoIndex || !blocking {
		unlockAllStates(states)
		interrupt.Restore(mask)
		return selectIndex, selectOk
	}

	// The select is blocking and no channel operation can proceed, so things
	// become more complicated.
	// We add ourselves as a sender/receiver to every channel, and wait for the
	// first one to complete. Only one will successfully complete, because
	// senders and receivers use a compare-and-exchange atomic operation on
	// t.Data so that only one will be able to "take" this select operation.
	t := task.Current()
	t.Ptr = recvbuf
	t.SetDataUint32(chanOperationWaiting)
	for i, state := range states {
		if state.ch == nil {
			continue
		}
		op := &ops[i]
		op.taskRef = t
		op.index = uint32(i)
		if state.value == nil { // chan receive
			state.ch.receivers.push(op)
		} else { // chan send
			op.value = state.value
			state.ch.senders.push(op)
		}
	}

	// Now we wait until one of the send/receive operations can proceed.
	unlockAllStates(states)
	interrupt.Restore(mask)

	// Single-threaded event loop: poll for I/O and timers until a
	// channel operation completes (changes t.Data from waiting).
	// Pipe-bound channels have no in-runtime waker; we re-check them
	// each poll iteration via pipeSelectRecheck.
	hasPipeBound := false
	for _, state := range states {
		if state.ch != nil && state.ch.spawnBound {
			hasPipeBound = true
			break
		}
	}
	if !hasScheduler {
		for t.DataUint32() == chanOperationWaiting {
			// The termination channel is one of the arms only if the program
			// selected on it; closing it otherwise is harmless and leaves this
			// select waiting on the channels it actually named.
			sigintPoll()
			if hasPipeBound {
				if pipeSelectRecheck(t, states, recvbuf) {
					break
				}
			}
			if hasPoll {
				netpollBlock(100)
			} else if hasPipeBound {
				// A select over several channels cannot park on one ring's
				// index word without going deaf on the others, and it has to
				// keep servicing timers while it waits. The bounded timer
				// poll is the deliberate shape here; the dedicated
				// single-exchange domains (PipeChanSend/Recv) park on the
				// index word instead.
				sleepTicks(nanosecondsToTicks(1_000_000)) // 1ms
			} else {
				sleepTicks(nanosecondsToTicks(100_000_000))
			}
			fireTimers()
		}
	} else {
		if hasPipeBound {
			// Same recheck loop for the scheduler.tasks variant. Yields
			// between checks via Gosched to share the CPU.
			for t.DataUint32() == chanOperationWaiting {
				sigintPoll()
				if pipeSelectRecheck(t, states, recvbuf) {
					break
				}
				Gosched()
				sleepTicks(nanosecondsToTicks(1_000_000))
			}
		} else {
			sigintPoll()
			task.Pause()
		}
	}

	// Resumed, so one channel operation must have progressed.

	// Make sure all channel ops are removed from the senders/receivers
	// queue before we return and the memory of them becomes invalid.
	lockAllStates(states)
	for i, state := range states {
		if state.ch == nil {
			continue
		}
		op := &ops[i]
		selMask := interrupt.Disable()
		if state.value == nil {
			state.ch.receivers.remove(op)
		} else {
			state.ch.senders.remove(op)
		}
		interrupt.Restore(selMask)
	}
	unlockAllStates(states)

	// Pull the return values out of t.Data (which contains two bitfields).
	selectIndex = t.DataUint32() >> 2
	selectOk = t.DataUint32()&chanOperationMask != chanOperationClosed

	return selectIndex, selectOk
}

// pipeSelectRecheck is called from chanSelect's blocking poll loop to
// detect readiness on spawn-bound channels (which have no in-runtime
// waker mechanism). It returns true if any state proceeded, with t.Data
// updated to encode the case index + completion status.
//
// It is platform-independent: the boundary transport is the only
// difference between targets, and that is behind tryPipeSend/tryPipeRecv.
//
// Single-threaded scheduler: the CAS always wins. The CAS is kept for
// correctness if/when this is ported to a multi-thread scheduler.
func pipeSelectRecheck(t *task.Task, states []chanSelectState, recvbuf unsafe.Pointer) bool {
	for i, state := range states {
		if state.ch == nil || !state.ch.spawnBound {
			continue
		}
		var newDataValue uint32
		if state.value == nil {
			received, ok := state.ch.tryPipeRecv(recvbuf, state.codec, state.td)
			if !received {
				continue
			}
			newDataValue = uint32(uint32(i) << 2)
			if !ok {
				newDataValue |= chanOperationClosed
			} else {
				newDataValue |= chanOperationOk
			}
		} else {
			if !state.ch.tryPipeSend(state.value, state.codec, state.td) {
				continue
			}
			newDataValue = uint32(uint32(i)<<2) | chanOperationOk
		}
		if t.CompareAndSwapDataUint32(0, newDataValue) {
			return true
		}
	}
	return false
}
