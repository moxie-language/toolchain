package runtime

import (
	"unsafe"
)


// Per-arena scope attribution.
//
// The question this answers, concretely and without guessing: WHICH function's
// arena is holding the bytes that N requests left behind?
//
// An arena is tagged with the scope that was current when it was pushed, and
// every allocation into it and every reclaim of it is charged to that tag. A
// scope normally opens and closes with a function: the shell sets one around a
// phase of request handling so a retained byte is charged to the phase that
// allocated it. The report then shows, per scope, allocated vs reclaimed - and
// the difference is exactly the retention, with a name attached.
//
// Cost: one int32 store on push, one 64-bit add per allocation, one add plus a
// reset on reclaim. Nothing here allocates, so the instrument cannot perturb
// what it measures.

const arenaScopeMax = int32(64)

// Scopes the runtime itself names. Everything else is the shell's: leaving 0
// unnamed is deliberate, so that an allocation nobody accounted for is visible
// as scope 0 instead of hiding inside the root arena's row (which is exactly how
// the group leak was misread as "root retention" for several rounds).
const ArenaScopeRoot = int32(5)

type arenaScopeRec struct {
	alloc  uint64
	freed  uint64
	resets int32
	arenas int32
}

var arenaScopes [arenaScopeMax]arenaScopeRec
var arenaScopeCurrent int32

// --- allocation-size histogram (phase 0b) ---
//
// The phase 4 header size (D8), the slab decision (D9) and the frame budget
// question are all read from this, so it is always on. The cost is one bin
// computation and two adds per allocation; the bin is floor(log2(size)), so a
// question about "objects at or below 32 bytes" is bins 0..5 and "just above
// 64 KiB" is bin 16.
//
// The two slices are carved from the DOMAIN segment by initDomain and are
// therefore per-domain TLS, like every other runtime table: a worker's
// histogram is its own.
const allocHistBins = int32(64)

var allocHistCount []uint64
var allocHistBytes []uint64

// sizeBin is floor(log2(size)) without a library call or a loop. TargetBits
// gates the 64-bit step because a shift of a 32-bit uintptr by 32 is not that
// comparison on wasm.
func sizeBin(size uintptr) (b int32) {
	if TargetBits == 64 && size > 0xFFFFFFFF {
		b = b + 32
		size = size >> 32
	}
	if size >= 1<<16 {
		b = b + 16
		size = size >> 16
	}
	if size >= 1<<8 {
		b = b + 8
		size = size >> 8
	}
	if size >= 1<<4 {
		b = b + 4
		size = size >> 4
	}
	if size >= 1<<2 {
		b = b + 2
		size = size >> 2
	}
	if size >= 1<<1 {
		b = b + 1
	}
	return b
}

// recordAllocSize charges one allocation to its size bin. A zero-length table
// is the pre-initDomain state: initDomain itself allocates nothing through the
// allocator, so nothing is ever dropped.
func recordAllocSize(size uintptr) {
	if len(allocHistCount) == 0 {
		return
	}
	recordFineAlloc(size)
	b := sizeBin(size)
	if b >= allocHistBins {
		b = allocHistBins - 1
	}
	allocHistCount[b]++
	allocHistBytes[b] += uint64(size)
}

// AllocHistogram returns the size histogram (floor(log2) bins, count and
// bytes). It is the measurement D8 and D9 are decided from.
func AllocHistogram() (counts []uint64, bytes []uint64) {
	return allocHistCount, allocHistBytes
}

// fineAllocCount counts allocations by EXACT size 1..192. The floor(log2) bins
// cannot separate 32 from 63, and a compiler-emit probe found the entire
// per-fragment cost (region.md 0.3j) inside one such bin, so the exact size is
// what identifies the site.
var fineAllocCount [193]uint32

func recordFineAlloc(size uintptr) {
	if size >= 1 && size <= 192 {
		fineAllocCount[size]++
	}
}

// FineAllocAt reports how many allocations of exactly size n have happened.
func FineAllocAt(n int32) (c uint32) {
	if n < 1 || n > 192 {
		return 0
	}
	return fineAllocCount[n]
}

// SegmentStats is the per-kind ledger: live segments, bytes reserved and
// bytes allocated. A segment is a mapping; the arena's region table is its
// descriptor, so these counters and that table must agree at every quiescent
// point.
type SegmentStats struct {
	FnCount     uint64
	FnBytes     uint64
	RootCount   uint64
	RootBytes   uint64
	LargeCount  uint64
	LargeBytes  uint64
	DomainCount uint64
	DomainBytes uint64
	ChanCount   uint64
	ChanBytes   uint64
}

var segFnCount uint64
var segFnBytes uint64
var segRootCount uint64
var segRootBytes uint64
var segLargeCount uint64
var segLargeBytes uint64
var segDomainCount uint64
var segDomainBytes uint64
var segChanCount uint64
var segChanBytes uint64

// RecordSegmentAdd charges one mapping to its kind.
func RecordSegmentAdd(kind int32, bytes uintptr) {
	switch kind {
	case segKindFn:
		segFnCount++
		segFnBytes += uint64(bytes)
	case segKindRoot:
		segRootCount++
		segRootBytes += uint64(bytes)
	case segKindLarge:
		segLargeCount++
		segLargeBytes += uint64(bytes)
	case segKindDomain:
		segDomainCount++
		segDomainBytes += uint64(bytes)
	case segKindChannel:
		segChanCount++
		segChanBytes += uint64(bytes)
	}
}

// RecordSegmentFree retires one mapping from its kind's ledger.
func RecordSegmentFree(kind int32, bytes uintptr) {
	switch kind {
	case segKindFn:
		segFnCount--
		segFnBytes -= uint64(bytes)
	case segKindRoot:
		segRootCount--
		segRootBytes -= uint64(bytes)
	case segKindLarge:
		segLargeCount--
		segLargeBytes -= uint64(bytes)
	case segKindDomain:
		segDomainCount--
		segDomainBytes -= uint64(bytes)
	case segKindChannel:
		segChanCount--
		segChanBytes -= uint64(bytes)
	}
}

// ReadSegmentStats copies the ledger into s.
func ReadSegmentStats(s *SegmentStats) {
	s.FnCount = segFnCount
	s.FnBytes = segFnBytes
	s.RootCount = segRootCount
	s.RootBytes = segRootBytes
	s.LargeCount = segLargeCount
	s.LargeBytes = segLargeBytes
	s.DomainCount = segDomainCount
	s.DomainBytes = segDomainBytes
	s.ChanCount = segChanCount
	s.ChanBytes = segChanBytes
}

// ArenaLedger reports the function-tier book balance: pushes, releases, the
// live frame depth and the pooled arenas. At quiescence pushed == released and
// depth == 0; anything else is a release path that did not run, and the two
// numbers name it.
func ArenaLedger() (pushed, released, depth, pooled uint64) {
	pushed = fnPushCount
	released = fnReleaseCount
	if domainRoot != nil {
		depth = uint64(uint32(domainRoot.fnTop))
	}
	pooled = uint64(uint32(arenaPoolN))
	return
}

// SysMapStats reports the process-level mapping ledger. Phase 2's exit
// criterion is that a warm allocating loop stops mapping: two reads around the
// loop with equal counts is that evidence, and it is the one measurement the
// segment pool exists to make true.
func SysMapStats() (maps, unmaps, mapBytes, unmapBytes uint64) {
	maps = sysMapCount
	unmaps = sysUnmapCount
	mapBytes = sysMapBytes
	unmapBytes = sysUnmapBytes
	return
}

// ArenaDomainExitCheck runs at the end of a spawned domain, where the thread is
// about to end and every frame it owns should already be gone. It reports only
// when the ledger does not balance and only under the trace gate, because a
// correct program's exit must stay silent.
func ArenaDomainExitCheck() {
	if domainRoot == nil || !arenaTraceWanted() {
		return
	}
	pushed, released, depth, pooled := ArenaLedger()
	if pushed == released && depth == 0 {
		return
	}
	printstring("arena domain-exit pushed=")
	printuint64(pushed)
	printstring(" released=")
	printuint64(released)
	printstring(" depth=")
	printuint64(depth)
	printstring(" pooled=")
	printuint64(pooled)
	printstring("\n")
}

// SetArenaScope names the scope that arenas pushed from now on belong to, and
// returns the previous one so a caller can restore it.
func SetArenaScope(id int32) (prev int32) {
	prev = arenaScopeCurrent
	if id >= 0 && id < arenaScopeMax {
		arenaScopeCurrent = id
	}
	return prev
}

// ArenaScope reports the current scope.
func ArenaScope() (id int32) {
	return arenaScopeCurrent
}

// --- region accounting ---
//
// A region is the unit an arena grows by. One that is added and never unmapped
// costs its whole mapping whether or not its bytes are reported as "used", which
// is why the byte counters can look clean while RSS climbs.
var regionAddCount [arenaScopeMax]uint64
var regionAddBytes [arenaScopeMax]uint64
var regionFreeCount [arenaScopeMax]uint64
var regionFreeBytes [arenaScopeMax]uint64
var sysMapCount uint64
var sysMapBytes uint64
var sysUnmapCount uint64
var sysUnmapBytes uint64

// RecordRegionAdd charges one region acquisition to a scope.
func RecordRegionAdd(id int32, bytes uintptr) {
	if id >= 0 && id < arenaScopeMax {
		regionAddCount[id]++
		regionAddBytes[id] += uint64(bytes)
	}
}

// RecordRegionFree charges region releases to a scope.
func RecordRegionFree(id int32, count uintptr, bytes uintptr) {
	if id >= 0 && id < arenaScopeMax {
		regionFreeCount[id] += uint64(count)
		regionFreeBytes[id] += uint64(bytes)
	}
}

// RecordSysMap / RecordSysUnmap count the process-level mappings.
func RecordSysMap(bytes uintptr) {
	sysMapCount++
	sysMapBytes += uint64(bytes)
}

func RecordSysUnmap(bytes uintptr) {
	sysUnmapCount++
	sysUnmapBytes += uint64(bytes)
}

// --- sovereign group accounting ---
//
// A sovereign group is the arena set that a self-mutating type's receiver owns.
// Its arenas are the only ones that double (growDouble), so their region adds
// are counted apart from the ordinary 64MB ones, and created vs released is
// the direct test of the binding rule: a group lives exactly as long as the
// arena that holds its receiver. If created climbs and released does not, the
// groups outlive their receivers, and `regionadd` says how fast the arenas they
// keep alive are growing.
var sovCreated uint64
var sovReleased uint64
var sovRegionAdd uint64
var sovRegionAddBytes uint64
var sovRegionFree uint64
var sovRegionFreeBytes uint64

func RecordSovCreate() {
	sovCreated++
}

func RecordSovRelease() {
	sovReleased++
}

// The three ways a group can escape release, counted separately so a residual
// leak names its own path instead of being inferred:
//
//   untracked - created for a receiver that was in no live arena, so no arena
//               list ever names it (the documented ctxArena == nil case);
//   miss      - its receiver was not in the receiver map at release time;
//   refused   - its receiver was nil or attributed to another arena.
var sovUntracked uint64
var sovReleaseMiss uint64
var sovReleaseRefused uint64

func RecordSovUntracked() {
	sovUntracked++
}

func RecordSovReleaseMiss() {
	sovReleaseMiss++
}

func RecordSovReleaseRefused() {
	sovReleaseRefused++
}

// sovMetaBytes is the group bookkeeping (group struct, record slice, batch
// stack, slot table) charged to the arena that owns the receiver. It is not a
// retention number: it is the proof that the bookkeeping follows the receiver
// instead of the process.
var sovMetaBytes uint64

func RecordSovMeta(size uintptr) {
	sovMetaBytes += uint64(size)
}

// RecordSovRegionAdd charges a doubling arena's new region to the group
// accounting.
func RecordSovRegionAdd(bytes uintptr) {
	sovRegionAdd++
	sovRegionAddBytes += uint64(bytes)
}

// RecordSovRegionFree charges a doubling arena's released regions.
func RecordSovRegionFree(count uintptr, bytes uintptr) {
	sovRegionFree += uint64(count)
	sovRegionFreeBytes += uint64(bytes)
}

func arenaScopeAlloc(id int32, size uintptr) {
	if id >= 0 && id < arenaScopeMax {
		arenaScopes[id].alloc += uint64(size)
	}
}

func arenaScopeFreed(id int32, size uintptr) {
	if id >= 0 && id < arenaScopeMax {
		arenaScopes[id].freed += uint64(size)
		arenaScopes[id].resets++
	}
}

// --- trace gate ---
//
// SetArenaTrace turns the DIRECT-allocation size recorder on. Kept because a
// size histogram is the one thing the scope counters cannot show: a single
// large allocation (a codec buffer, a bucket array) is one event, not a pattern.

var arenaTraceOn bool
var rootTraceBusy bool

// SetArenaTrace turns allocation-size capture on or off.
func SetArenaTrace(on bool) {
	arenaTraceOn = on
}

// RecordRootSize charges one DIRECT allocation into the root arena, keyed by
// size. Powers of two are the hashmap bucket signature; variable sizes are codec
// buffers. It answers "is the root taking bytes", not "from where": the scope
// rows answer that, and the group counters answer "for whom".
const rootSizeMax = int32(24)

type rootSizeRec struct {
	size  uintptr
	count uint64
	bytes uint64
}

var rootSizes [rootSizeMax]rootSizeRec
var rootSizeN int32

// RecordRootSize records one direct allocation into the root arena.
func RecordRootSize(size uintptr) {
	if rootTraceBusy {
		return
	}
	rootTraceBusy = true
	var i int32 = 0
	for i = 0; i < rootSizeN; i++ {
		if rootSizes[i].size == size {
			rootSizes[i].count++
			rootSizes[i].bytes += uint64(size)
			rootTraceBusy = false
			return
		}
	}
	if rootSizeN < rootSizeMax {
		rootSizes[rootSizeN].size = size
		rootSizes[rootSizeN].count = 1
		rootSizes[rootSizeN].bytes = uint64(size)
		rootSizeN++
	}
	rootTraceBusy = false
}

// --- large-allocation census ---
//
// The scope rows say how much a phase allocated; the size histogram says which
// size class it came from; this says which EXACT sizes it came from, with the
// scope that asked. A compiler that allocates 188MB in one function while
// emitting 7MB of text is not leaking a lifetime - it is asking for the same
// large block over and over, and the count times the size is the bill. Only
// allocations of 64KiB or more are recorded, so the hot path pays one compare
// and the table stays small enough to read.
const bigAllocMin = uintptr(1) << 16
const bigAllocMax = int32(24)

type bigAllocRec struct {
	size  uintptr
	scope int32
	count uint64
}

var bigAllocs [bigAllocMax]bigAllocRec
var bigAllocN int32
var bigAllocOverflow uint64

// RecordBigAlloc charges one allocation of size bytes to a scope. Linear scan of
// at most 24 entries: this must not allocate, because it is called from the
// allocation path.
func RecordBigAlloc(size uintptr, scope int32) {
	if size < bigAllocMin {
		return
	}
	var i int32 = 0
	for i = 0; i < bigAllocN; i++ {
		if bigAllocs[i].size == size && bigAllocs[i].scope == scope {
			bigAllocs[i].count++
			return
		}
	}
	if bigAllocN < bigAllocMax {
		bigAllocs[bigAllocN].size = size
		bigAllocs[bigAllocN].scope = scope
		bigAllocs[bigAllocN].count = 1
		bigAllocN++
		return
	}
	bigAllocOverflow++
}

// ResetBigAllocs starts a fresh per-package census.
func ResetBigAllocs() {
	bigAllocN = 0
	bigAllocOverflow = 0
}

// BigAllocReport renders the census in insertion order. Insertion order is the
// order the sizes were first seen, so a package's first big allocation is the
// first row; sorting would need storage this function must not take, and the
// table is short enough to read as it stands.
func BigAllocReport() (out []byte) {
	for i := int32(0); i < bigAllocN; i++ {
		out = appendScopeStr(out, "big size=")
		out = appendScopeUint(out, uint64(bigAllocs[i].size))
		out = appendScopeStr(out, " scope=")
		out = appendScopeUint(out, uint64(uint32(bigAllocs[i].scope)))
		out = appendScopeStr(out, " n=")
		out = appendScopeUint(out, bigAllocs[i].count)
		out = appendScopeStr(out, " mb=")
		out = appendScopeUint(out, bigAllocs[i].count*uint64(bigAllocs[i].size)>>20)
		out = appendScopeStr(out, "\n")
	}
	if bigAllocOverflow > 0 {
		out = appendScopeStr(out, "big overflow=")
		out = appendScopeUint(out, bigAllocOverflow)
		out = appendScopeStr(out, "\n")
	}
	return out
}

// arenaTraceWanted reports whether site capture is on.
func arenaTraceWanted() (on bool) {
	return arenaTraceOn
}

func arenaScopeArena(id int32) {
	if id >= 0 && id < arenaScopeMax {
		arenaScopes[id].arenas++
	}
}

// resetArenaScopeStats clears the counters so a measurement can start from zero.
func ResetArenaScopeStats() {
	for i := int32(0); i < arenaScopeMax; i++ {
		arenaScopes[i].alloc = 0
		arenaScopes[i].freed = 0
		arenaScopes[i].resets = 0
		arenaScopes[i].arenas = 0
	}
}

// ArenaScopeReport writes one line per scope that has seen any traffic:
//
//	scope=<id> allocated=<bytes> reclaimed=<bytes> retained=<bytes> resets=<n> arenas=<n>
//
// retained is the number the whole instrument exists for: bytes this scope's
// arenas have allocated and no reset or free has reclaimed. A scope that
// retains across many requests is the leak, and its id says which phase of the
// port it belongs to (net/http's chanpath.mx assigns the ids).
func ArenaScopeReport() (out []byte) {
	for i := int32(0); i < arenaScopeMax; i++ {
		r := arenaScopes[i]
		if r.alloc == 0 && r.freed == 0 && r.arenas == 0 {
			continue
		}
		out = appendScopeStr(out, "scope=")
		out = appendScopeUint(out, uint64(i))
		out = appendScopeStr(out, " allocated=")
		out = appendScopeUint(out, r.alloc)
		out = appendScopeStr(out, " reclaimed=")
		out = appendScopeUint(out, r.freed)
		out = appendScopeStr(out, " retained=")
		if r.alloc > r.freed {
			out = appendScopeUint(out, r.alloc-r.freed)
		} else {
			out = appendScopeUint(out, 0)
		}
		out = appendScopeStr(out, " resets=")
		out = appendScopeUint(out, uint64(uint32(r.resets)))
		out = appendScopeStr(out, " arenas=")
		out = appendScopeUint(out, uint64(uint32(r.arenas)))
		out = appendScopeStr(out, "\n")
	}
	if domainRoot != nil {
		for i := int32(0); i <= domainRoot.fnTop; i++ {
			out = emitLiveArena(out, domainRoot.fnStack[i], "live")
		}
		out = emitLiveArena(out, trueRootArena(), "root")
	}
	for i := int32(0); i < arenaPoolN; i++ {
		out = emitLiveArena(out, arenaPool[i], "pooled")
	}
	out = appendScopeStr(out, "fnarena pushed=")
	out = appendScopeUint(out, fnPushCount)
	out = appendScopeStr(out, " released=")
	out = appendScopeUint(out, fnReleaseCount)
	out = appendScopeStr(out, " leaked=")
	out = appendScopeUint(out, fnPushCount-fnReleaseCount)
	out = appendScopeStr(out, "\n")
	out = appendScopeStr(out, "sovhome root=")
	out = appendScopeUint(out, sovHomeRoot)
	out = appendScopeStr(out, " sov=")
	out = appendScopeUint(out, sovHomeSov)
	out = appendScopeStr(out, " frame=")
	out = appendScopeUint(out, sovHomeFrame)
	out = appendScopeStr(out, "\n")
	out = appendScopeStr(out, "sysmap count=")
	out = appendScopeUint(out, sysMapCount)
	out = appendScopeStr(out, " bytes=")
	out = appendScopeUint(out, sysMapBytes)
	out = appendScopeStr(out, "\n")
	out = appendScopeStr(out, "sysunmap count=")
	out = appendScopeUint(out, sysUnmapCount)
	out = appendScopeStr(out, " bytes=")
	out = appendScopeUint(out, sysUnmapBytes)
	out = appendScopeStr(out, "\n")
	out = appendScopeStr(out, "mapped sysmap_bytes=")
	out = appendScopeUint(out, sysMapBytes)
	out = appendScopeStr(out, " sysunmap_bytes=")
	out = appendScopeUint(out, sysUnmapBytes)
	out = appendScopeStr(out, " net=")
	if sysMapBytes > sysUnmapBytes {
		out = appendScopeUint(out, sysMapBytes-sysUnmapBytes)
	} else {
		out = appendScopeUint(out, 0)
	}
	out = appendScopeStr(out, " livecap=")
	out = appendScopeUint(out, uint64(liveArenaCapBytes()))
	out = appendScopeStr(out, "\n")
	out = appendScopeStr(out, "sov created=")
	out = appendScopeUint(out, sovCreated)
	out = appendScopeStr(out, " released=")
	out = appendScopeUint(out, sovReleased)
	out = appendScopeStr(out, " live=")
	if sovCreated > sovReleased {
		out = appendScopeUint(out, sovCreated-sovReleased)
	} else {
		out = appendScopeUint(out, 0)
	}
	out = appendScopeStr(out, " regionadd=")
	out = appendScopeUint(out, sovRegionAdd)
	out = appendScopeStr(out, "/")
	out = appendScopeUint(out, sovRegionAddBytes)
	out = appendScopeStr(out, " untracked=")
	out = appendScopeUint(out, sovUntracked)
	out = appendScopeStr(out, " miss=")
	out = appendScopeUint(out, sovReleaseMiss)
	out = appendScopeStr(out, " refused=")
	out = appendScopeUint(out, sovReleaseRefused)
	out = appendScopeStr(out, " meta=")
	out = appendScopeUint(out, sovMetaBytes)
	out = appendScopeStr(out, " recycled=")
	out = appendScopeUint(out, sovGroupRecycleCount())
	out = appendScopeStr(out, " regionfree=")
	out = appendScopeUint(out, sovRegionFree)
	out = appendScopeStr(out, "/")
	out = appendScopeUint(out, sovRegionFreeBytes)
	out = appendScopeStr(out, "\n")
	for i := int32(0); i < arenaScopeMax; i++ {
		if regionAddCount[i] == 0 && regionFreeCount[i] == 0 {
			continue
		}
		out = appendScopeStr(out, "region scope=")
		out = appendScopeUint(out, uint64(i))
		out = appendScopeStr(out, " added=")
		out = appendScopeUint(out, regionAddCount[i])
		out = appendScopeStr(out, "/")
		out = appendScopeUint(out, regionAddBytes[i])
		out = appendScopeStr(out, " freed=")
		out = appendScopeUint(out, regionFreeCount[i])
		out = appendScopeStr(out, "/")
		out = appendScopeUint(out, regionFreeBytes[i])
		out = appendScopeStr(out, "\n")
	}
	for i := int32(0); i < rootSizeN; i++ {
		out = appendScopeStr(out, "rootsize=")
		out = appendScopeUint(out, uint64(rootSizes[i].size))
		out = appendScopeStr(out, " count=")
		out = appendScopeUint(out, rootSizes[i].count)
		out = appendScopeStr(out, " bytes=")
		out = appendScopeUint(out, rootSizes[i].bytes)
		out = appendScopeStr(out, "\n")
	}
	return out
}

// emitLiveArena writes one arena that is currently holding memory: its scope,
// what kind of arena it is, how many regions it holds and how many bytes it has
// used, and how much it has reserved.
func emitLiveArena(out []byte, a *Arena, tag []byte) (res []byte) {
	res = out
	if a == nil {
		return res
	}
	used := uintptr(0)
	for i := int32(0); i < a.nregions; i++ {
		used += a.regions[i].off
	}
	if used == 0 {
		return res
	}
	res = appendScopeStr(res, tag)
	res = appendScopeStr(res, " scope=")
	res = appendScopeUint(res, uint64(uint32(a.scope)))
	res = appendScopeStr(res, " sovereign=")
	res = appendScopeUint(res, uint64(uint32(a.sovereign)))
	// kind0/root/gdbl identify the arena without needing its address: a chained
	// ordinary arena (kind segKindFn, 64MB links) and a doubling sovereign data
	// arena are the two shapes that grow, and they grow for different reasons.
	res = appendScopeStr(res, " kind0=")
	res = appendScopeUint(res, uint64(uint32(a.regions[0].kind)))
	res = appendScopeStr(res, " root=")
	res = appendScopeUint(res, uint64(uint32(a.isRoot)))
	res = appendScopeStr(res, " gdbl=")
	res = appendScopeUint(res, uint64(uint32(a.growDouble)))
	res = appendScopeStr(res, " tbl=")
	res = appendScopeUint(res, uint64(uint32(len(a.regions))))
	res = appendScopeStr(res, " n=")
	res = appendScopeUint(res, uint64(uint32(a.nregions)))
	res = appendScopeStr(res, " groups=")
	res = appendScopeUint(res, uint64(uint32(a.sovGroups)))
	res = appendScopeStr(res, " used=")
	res = appendScopeUint(res, uint64(used))
	reserved := uintptr(0)
	for i := int32(0); i < a.nregions; i++ {
		reserved += a.regions[i].cap
	}
	res = appendScopeStr(res, " cap=")
	res = appendScopeUint(res, uint64(reserved))
	res = appendScopeStr(res, "\n")
	return res
}

// liveArenaCapBytes is every byte of arena memory currently reserved, over
// EVERY live arena: the root, the function stack, manual phase scopes,
// owned/sovereign data arenas and package graph arenas.
//
// It used to walk fnStack and the pool only, on the theory that everything live
// is on the stack. Parked arenas are not: a graph arena, a phase arena and a
// sovereign group's data arena are all live with no stack slot, and on a cold
// self-build the old rule reported 262MB while /proc/self/maps showed 2.8GB - so
// the one number that could have named the growth was blind to it (region.md
// D9). arenaLiveAdd/arenaLiveDel maintain the list at every creation and
// release, so walking it is the arena system's mapping footprint, and the report
// can be compared against the kernel instead of being trusted.
func liveArenaCapBytes() (n uintptr) {
	if domainRoot == nil {
		return 0
	}
	n, _ = liveArenaLedger()
	// A pooled arena is still mapped. It is bounded (arenaPoolN entries, one
	// chain each) and counting it is what keeps this number equal to the
	// kernel's rather than merely proportional to it.
	for i := int32(0); i < arenaPoolN; i++ {
		p := arenaPool[i]
		if p == nil || p.liveIn != 0 {
			continue
		}
		for j := int32(0); j < p.nregions; j++ {
			n += p.regions[j].cap
		}
	}
	return n
}

// ArenaLiveCount reports how many arenas the ledger is accounting for, so a
// report can say "35 arenas, 412MB" instead of a total nobody can check.
func ArenaLiveCount() (n int32) {
	_, n = liveArenaLedger()
	return n
}

// LiveArenaTop writes the n largest live arenas by used bytes, then the totals
// for the whole live set. LiveArenaCap says a build is holding 490MB; this says
// WHICH arenas hold it, which is the difference between a number and a finding.
// It runs at a phase boundary, never per allocation, so its own cost (one walk
// of the live list per selection round) is irrelevant to what it measures.
//
// The walk carries its own generation mark, exactly like liveArenaLedger, so a
// corrupt link costs one repeated node instead of a hang.
func LiveArenaTop(n int32) (out []byte) {
	if domainRoot == nil {
		return out
	}
	liveWalkBegin()
	gen := liveWalkGen
	a := liveArenaHead
	count := int32(0)
	var totUse, totCap uint64
	for a != nil {
		if a.liveGen == gen {
			break
		}
		a.liveGen = gen
		count++
		used, capb := arenaUseCap(a)
		totUse += used
		totCap += capb
		a = a.liveNext
	}
	picked := []*Arena{:0:16}
	for round := int32(0); round < n; round++ {
		var best *Arena
		var bestUsed uint64
		liveWalkBegin()
		gen = liveWalkGen
		a = liveArenaHead
		for a != nil {
			if a.liveGen == gen {
				break
			}
			a.liveGen = gen
			u, _ := arenaUseCap(a)
			seen := false
			for _, p := range picked {
				if p == a {
					seen = true
					break
				}
			}
			if !seen && u > bestUsed {
				best = a
				bestUsed = u
			}
			a = a.liveNext
		}
		if best == nil || bestUsed == 0 {
			break
		}
		push(picked, best)
		out = emitLiveArena(out, best, "live")
		// How much of what this arena has handed out is still ZERO? Every
		// allocation is zeroed by arenaBump, so a byte that is zero at a phase
		// boundary was either never written after allocation or was released.
		// A high fraction says the memory bill is ALLOCATION VOLUME, not live
		// data - which is a different defect from a leak, and a different fix.
		used, _ := arenaUseCap(best)
		z := arenaZeroBytes(best)
		out = appendScopeStr(out, "livezero used=")
		out = appendScopeUint(out, used)
		out = appendScopeStr(out, " zero=")
		out = appendScopeUint(out, z)
		out = appendScopeStr(out, "\n")
	}
	out = appendScopeStr(out, "livetot n=")
	out = appendScopeUint(out, uint64(uint32(count)))
	out = appendScopeStr(out, " used=")
	out = appendScopeUint(out, totUse)
	out = appendScopeStr(out, " cap=")
	out = appendScopeUint(out, totCap)
	// The same question over the whole live set, skipping arenas below 1MiB:
	// the scan is O(used) and the small ones cannot dominate a 490MB floor.
	var zUse, zZero uint64
	liveWalkBegin()
	gen = liveWalkGen
	a = liveArenaHead
	for a != nil {
		if a.liveGen == gen {
			break
		}
		a.liveGen = gen
		u, _ := arenaUseCap(a)
		if u >= 1<<20 {
			zUse += u
			zZero += arenaZeroBytes(a)
		}
		a = a.liveNext
	}
	out = appendScopeStr(out, " scanned=")
	out = appendScopeUint(out, zUse)
	out = appendScopeStr(out, " zero=")
	out = appendScopeUint(out, zZero)
	out = appendScopeStr(out, " zeropermille=")
	if zUse > 0 {
		out = appendScopeUint(out, zZero*1000/zUse)
	} else {
		out = appendScopeUint(out, 0)
	}
	out = appendScopeStr(out, "\n")
	return out
}

// arenaZeroBytes counts bytes of the arena's USED space that sit in 4KiB pages
// whose every 8-byte word is zero. Whole pages, not bytes, because a page is the
// unit the kernel compresses and the cgroup charges: a page with one live word
// costs the same as a full one.
func arenaZeroBytes(a *Arena) (zero uint64) {
	if a == nil {
		return 0
	}
	for j := int32(0); j < a.nregions; j++ {
		base := a.regions[j].base
		off := a.regions[j].off
		p := uintptr(0)
		for p+4096 <= off {
			z := true
			for w := uintptr(0); w < 4096; w += 8 {
				if *(*uint64)(unsafe.Pointer(base + p + w)) != 0 {
					z = false
					break
				}
			}
			if z {
				zero += 4096
			}
			p += 4096
		}
	}
	return zero
}

func arenaUseCap(a *Arena) (used, capb uint64) {
	for j := int32(0); j < a.nregions; j++ {
		used += uint64(a.regions[j].off)
		capb += uint64(a.regions[j].cap)
	}
	return used, capb
}

// LiveArenaCensus answers the question the total cannot: how much of the
// reserved bytes is FIXED COST rather than data. Every arena carries a header
// and a region table, and its first region is never smaller than one page, so
// an arena that holds a 40-byte object still costs its header plus a mapping.
// A build with twenty thousand live arenas is therefore paying a tax that has
// nothing to do with the data it is holding, and this line separates the two.
//
// tiny counts arenas reserving <= 64KiB and tinycap what they reserve in total:
// when the count is large and tinycap is small, the arenas exist at a fixed cost
// and no amount of data reduction will touch them.
func LiveArenaCensus() (out []byte) {
	if domainRoot == nil {
		return out
	}
	hdr := align(unsafe.Sizeof(Arena{}))
	liveWalkBegin()
	gen := liveWalkGen
	a := liveArenaHead
	var n int32
	var tinyN, tinyCap, hdrTotal, sovN, tabBig, capTotal uint64
	for a != nil {
		if a.liveGen == gen {
			break
		}
		a.liveGen = gen
		n++
		_, c := arenaUseCap(a)
		capTotal += c
		if c <= 64*1024 {
			tinyN++
			tinyCap += c
		}
		hdrTotal += uint64(hdr) + uint64(len(a.regions))*uint64(unsafe.Sizeof(ArenaRegion{}))
		if a.sovereign != 0 {
			sovN++
		}
		if len(a.regions) > int32(arenaStdRegions) {
			tabBig++
		}
		a = a.liveNext
	}
	out = appendScopeStr(out, "census n=")
	out = appendScopeUint(out, uint64(uint32(n)))
	out = appendScopeStr(out, " tiny=")
	out = appendScopeUint(out, tinyN)
	out = appendScopeStr(out, " tinycap=")
	out = appendScopeUint(out, tinyCap)
	out = appendScopeStr(out, " hdr=")
	out = appendScopeUint(out, hdrTotal)
	out = appendScopeStr(out, " sov=")
	out = appendScopeUint(out, sovN)
	out = appendScopeStr(out, " tab256=")
	out = appendScopeUint(out, tabBig)
	out = appendScopeStr(out, " cap=")
	out = appendScopeUint(out, capTotal)
	out = appendScopeStr(out, "\n")
	// Per-scope totals: an arena with no name in a total is exactly how a
	// permanent arena hides, so each scope's live arenas are summed by the tag
	// the creating code set. A scope that only grows across packages is the
	// finding; one that appears and vanishes is a phase doing its job.
	for s := int32(0); s < arenaScopeMax; s++ {
		var sn uint64
		var suu, scc uint64
		liveWalkBegin()
		gen = liveWalkGen
		a = liveArenaHead
		for a != nil {
			if a.liveGen == gen {
				break
			}
			a.liveGen = gen
			if a.scope == s {
				sn++
				u, c := arenaUseCap(a)
				suu += u
				scc += c
			}
			a = a.liveNext
		}
		if sn == 0 {
			continue
		}
		out = appendScopeStr(out, "scopebytes id=")
		out = appendScopeUint(out, uint64(uint32(s)))
		out = appendScopeStr(out, " n=")
		out = appendScopeUint(out, sn)
		out = appendScopeStr(out, " used=")
		out = appendScopeUint(out, suu)
		out = appendScopeStr(out, " cap=")
		out = appendScopeUint(out, scc)
		out = appendScopeStr(out, "\n")
	}
	return out
}

func appendScopeStr(b []byte, s []byte) (out []byte) {
	out = b
	for i := 0; i < len(s); i++ {
		out = push(out, s[i])
	}
	return out
}

func appendScopeUint(b []byte, v uint64) (out []byte) {
	out = b
	if v == 0 {
		return push(out, '0')
	}
	d := []byte{:24}
	n := int32(0)
	for v > 0 {
		d[n] = byte('0' + v%10)
		n = n + 1
		v = v / 10
	}
	for n > 0 {
		n = n - 1
		out = push(out, d[n])
	}
	return out
}
