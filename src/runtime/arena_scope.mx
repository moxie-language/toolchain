package runtime

// Per-arena scope attribution.
//
// The question this answers, concretely and without guessing: WHICH function's
// arena is holding the bytes that N requests left behind?
//
// An arena is tagged with the scope that was current when it was pushed, and
// every allocation into it and every reclaim of it is charged to that tag. A
// scope normally opens and closes with a function: the shell sets one around a
// phase of request handling so a retained byte is charged to the phase that
// allocated it. The report then shows, per scope, allocated vs reclaimed - and
// the difference is exactly the retention, with a name attached.
//
// Cost: one int32 store on push, one 64-bit add per allocation, one add plus a
// reset on reclaim. Nothing here allocates, so the instrument cannot perturb
// what it measures.

const arenaScopeMax = int32(64)

type arenaScopeRec struct {
	alloc  uint64
	freed  uint64
	resets int32
	arenas int32
}

var arenaScopes [arenaScopeMax]arenaScopeRec
var arenaScopeCurrent int32

// SetArenaScope names the scope that arenas pushed from now on belong to, and
// returns the previous one so a caller can restore it.
func SetArenaScope(id int32) (prev int32) {
	prev = arenaScopeCurrent
	if id >= 0 && id < arenaScopeMax {
		arenaScopeCurrent = id
	}
	return prev
}

// ArenaScope reports the current scope.
func ArenaScope() (id int32) {
	return arenaScopeCurrent
}

func arenaScopeAlloc(id int32, size uintptr) {
	if id >= 0 && id < arenaScopeMax {
		arenaScopes[id].alloc += uint64(size)
	}
}

func arenaScopeFreed(id int32, size uintptr) {
	if id >= 0 && id < arenaScopeMax {
		arenaScopes[id].freed += uint64(size)
		arenaScopes[id].resets++
	}
}

// --- root-site recorder ---
//
// The root arena is the only arena nothing resets, so any allocation charged to
// it is retained for the life of the process. Recording the PC of the code that
// made such an allocation names the site, once, instead of leaving it to
// inference. Gated by SetArenaTrace: the PC capture walks the stack.

const rootSiteMax = int32(32)

type rootSiteRec struct {
	pc    uintptr
	count uint64
	bytes uint64
}

var rootSites [rootSiteMax]rootSiteRec
var rootSiteN int32
var arenaTraceOn bool
var rootTraceBusy bool

// SetArenaTrace turns allocating-site capture on or off.
func SetArenaTrace(on bool) {
	arenaTraceOn = on
}

// RecordRootSize charges one DIRECT allocation (ArenaAllocTD, which bypasses
// alloc() and therefore the site recorder) of size bytes into a long-lived
// arena, keyed by size. Powers of two are the hashmap bucket signature; variable
// sizes are codec buffers.
const rootSizeMax = int32(24)

type rootSizeRec struct {
	size  uintptr
	count uint64
	bytes uint64
}

var rootSizes [rootSizeMax]rootSizeRec
var rootSizeN int32

// RecordRootSize records one direct allocation into the root arena.
func RecordRootSize(size uintptr) {
	if rootTraceBusy {
		return
	}
	rootTraceBusy = true
	var i int32 = 0
	for i = 0; i < rootSizeN; i++ {
		if rootSizes[i].size == size {
			rootSizes[i].count++
			rootSizes[i].bytes += uint64(size)
			rootTraceBusy = false
			return
		}
	}
	if rootSizeN < rootSizeMax {
		rootSizes[rootSizeN].size = size
		rootSizes[rootSizeN].count = 1
		rootSizes[rootSizeN].bytes = uint64(size)
		rootSizeN++
	}
	rootTraceBusy = false
}

// RecordRootSite charges one allocation of size bytes into the root arena to
// the PC of the code that made it.
func RecordRootSite(pc uintptr, size uintptr) {
	if rootTraceBusy {
		return
	}
	rootTraceBusy = true
	var i int32 = 0
	for i = 0; i < rootSiteN; i++ {
		if rootSites[i].pc == pc {
			rootSites[i].count++
			rootSites[i].bytes += uint64(size)
			rootTraceBusy = false
			return
		}
	}
	if rootSiteN < rootSiteMax {
		rootSites[rootSiteN].pc = pc
		rootSites[rootSiteN].count = 1
		rootSites[rootSiteN].bytes = uint64(size)
		rootSiteN++
	}
	rootTraceBusy = false
}

// arenaTraceWanted reports whether site capture is on.
func arenaTraceWanted() (on bool) {
	return arenaTraceOn
}

func arenaScopeArena(id int32) {
	if id >= 0 && id < arenaScopeMax {
		arenaScopes[id].arenas++
	}
}

// resetArenaScopeStats clears the counters so a measurement can start from zero.
func ResetArenaScopeStats() {
	for i := int32(0); i < arenaScopeMax; i++ {
		arenaScopes[i].alloc = 0
		arenaScopes[i].freed = 0
		arenaScopes[i].resets = 0
		arenaScopes[i].arenas = 0
	}
}

// ArenaScopeReport writes one line per scope that has seen any traffic:
//
//	scope=<id> allocated=<bytes> reclaimed=<bytes> retained=<bytes> resets=<n> arenas=<n>
//
// retained is the number the whole instrument exists for: bytes this scope's
// arenas have allocated and no reset or free has reclaimed. A scope that
// retains across many requests is the leak, and its id says which phase of the
// port it belongs to (net/http's chanpath.mx assigns the ids).
func ArenaScopeReport() (out []byte) {
	for i := int32(0); i < arenaScopeMax; i++ {
		r := arenaScopes[i]
		if r.alloc == 0 && r.freed == 0 && r.arenas == 0 {
			continue
		}
		out = appendScopeStr(out, "scope=")
		out = appendScopeUint(out, uint64(i))
		out = appendScopeStr(out, " allocated=")
		out = appendScopeUint(out, r.alloc)
		out = appendScopeStr(out, " reclaimed=")
		out = appendScopeUint(out, r.freed)
		out = appendScopeStr(out, " retained=")
		if r.alloc > r.freed {
			out = appendScopeUint(out, r.alloc-r.freed)
		} else {
			out = appendScopeUint(out, 0)
		}
		out = appendScopeStr(out, " resets=")
		out = appendScopeUint(out, uint64(uint32(r.resets)))
		out = appendScopeStr(out, " arenas=")
		out = appendScopeUint(out, uint64(uint32(r.arenas)))
		out = appendScopeStr(out, "\n")
	}
	if domainRoot != nil {
		for i := int32(0); i <= domainRoot.fnTop; i++ {
			out = emitLiveArena(out, domainRoot.fnStack[i], "live")
		}
		out = emitLiveArena(out, trueRootArena(), "root")
	}
	for i := int32(0); i < arenaPoolN; i++ {
		out = emitLiveArena(out, arenaPool[i], "pooled")
	}
	for i := int32(0); i < rootSizeN; i++ {
		out = appendScopeStr(out, "rootsize=")
		out = appendScopeUint(out, uint64(rootSizes[i].size))
		out = appendScopeStr(out, " count=")
		out = appendScopeUint(out, rootSizes[i].count)
		out = appendScopeStr(out, " bytes=")
		out = appendScopeUint(out, rootSizes[i].bytes)
		out = appendScopeStr(out, "\n")
	}
	for i := int32(0); i < rootSiteN; i++ {
		out = appendScopeStr(out, "rootsite_pc=")
		out = appendScopeUint(out, uint64(rootSites[i].pc))
		out = appendScopeStr(out, " count=")
		out = appendScopeUint(out, rootSites[i].count)
		out = appendScopeStr(out, " bytes=")
		out = appendScopeUint(out, rootSites[i].bytes)
		out = appendScopeStr(out, "\n")
	}
	return out
}

// emitLiveArena writes one arena that is currently holding memory: its scope,
// the pc of the function that pushed it, and how many bytes it has used.
func emitLiveArena(out []byte, a *Arena, tag []byte) (res []byte) {
	res = out
	if a == nil {
		return res
	}
	used := uintptr(0)
	for i := int32(0); i < a.nregions; i++ {
		used += a.regions[i].off
	}
	if used == 0 {
		return res
	}
	res = appendScopeStr(res, tag)
	res = appendScopeStr(res, " scope=")
	res = appendScopeUint(res, uint64(uint32(a.scope)))
	res = appendScopeStr(res, " site=")
	res = appendScopeUint(res, uint64(a.site))
	res = appendScopeStr(res, " used=")
	res = appendScopeUint(res, uint64(used))
	res = appendScopeStr(res, "\n")
	return res
}

func appendScopeStr(b []byte, s []byte) (out []byte) {
	out = b
	for i := 0; i < len(s); i++ {
		out = push(out, s[i])
	}
	return out
}

func appendScopeUint(b []byte, v uint64) (out []byte) {
	out = b
	if v == 0 {
		return push(out, '0')
	}
	d := []byte{:24}
	n := int32(0)
	for v > 0 {
		d[n] = byte('0' + v%10)
		n = n + 1
		v = v / 10
	}
	for n > 0 {
		n = n - 1
		out = push(out, d[n])
	}
	return out
}
