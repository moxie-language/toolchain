//:build linux

package net

import (
	"internal/poll"
	"io"
	"syscall"
)

// sendFile copies the contents of r to c using the sendfile
// system call to minimize copies.
//
// if handled == true, sendFile returns the number (potentially zero) of bytes
// copied and any non-EOF error.
//
// if handled == false, sendFile performed no work.
func sendFile(c *netFD, r io.Reader) (written int64, err error, handled bool) {
	if !supportsSendfile() {
		return 0, nil, false
	}
	var remain int64 = 0 // 0 writes the entire file
	lr, ok := r.(*io.LimitedReader)
	if ok {
		remain, r = lr.N, lr.R
		if remain <= 0 {
			return 0, nil, true
		}
	}
	// r might be an *os.File or an os.fileWithoutWriteTo.
	// Type assert to an interface rather than *os.File directly to handle the latter case.
	f, ok := r.(syscall.Conn)
	if !ok {
		return 0, nil, false
	}

	sc, err := f.SyscallConn()
	if err != nil {
		return 0, nil, false
	}

	act := &sendFileAction{c: c, remain: remain}
	err = sc.Read(act)
	if err == nil {
		err = act.werr
	}
	written = act.written
	handled = act.handled

	if lr != nil {
		lr.N = remain - written
	}

	return written, wrapSyscallError("sendfile", err), handled
}

// sendFileAction performs the sendfile syscall inside the connection's
// syscall.RawConn.Read hook. The netFD, the remaining byte count and the
// results travel with it because the hook is a method, not a func value.
type sendFileAction struct {
	c       *netFD
	remain  int64
	written int64
	werr    error
	handled bool
}

func (a *sendFileAction) rawAction(fd uintptr) (rdone bool) {
	a.written, a.werr, a.handled = poll.SendFile(&a.c.pfd, fd, a.remain)
	return true
}
