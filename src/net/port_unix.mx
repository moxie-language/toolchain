//:build unix || (js && wasm)

// Read system port mappings from /etc/services

package net

import (
	"internal/bytealg"
)

var readServicesDone bool

func readServices() {
	file1, err := open("/etc/services")
	if err != nil {
		return
	}
	defer file1.close()

	for line, ok3 := file1.readLine(); ok3; line, ok3 = file1.readLine() {
		// "http 80/tcp www www-http # World Wide Web HTTP"
		if i := bytealg.IndexByteString(line, '#'); i >= 0 {
			line = line[:i]
		}
		f := getFields(line)
		if len(f) < 2 {
			continue
		}
		portnet := f[1] // "80/tcp"
		port, j, ok2 := dtoi(portnet)
		if !ok2 || port <= 0 || j >= len(portnet) || portnet[j] != '/' {
			continue
		}
		netw := portnet[j+1:] // "tcp"
		sv := _services()
		m, ok1 := sv[netw]
		if !ok1 {
			m = map[string]int32{}
			sv[netw] = m
		}
		for i := 0; i < len(f); i++ {
			if i != 1 { // f[1] was port/net
				m[f[i]] = port
			}
		}
	}
}

// goLookupPort is the native Go implementation of LookupPort.
func goLookupPort(network, service []byte) (port int32, err error) {
	if !readServicesDone {
		readServicesDone = true
		readServices()
	}
	return lookupPortMap(network, service)
}
