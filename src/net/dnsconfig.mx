package net

import (
	"time"
)

// _defaultNS is the default name servers to use in the absence of DNS configuration.
type dnsConfig struct {
	servers       [][]byte      // server addresses (in host:port form) to use
	search        [][]byte      // rooted suffixes to append to local name
	ndots         int32           // number of dots in name to trigger absolute lookup
	timeout       time.Duration // wait before giving up on a query, including retries
	attempts      int32           // lost packets before giving up on server
	rotate        bool          // round robin among servers
	unknownOpt    bool          // anything unknown was encountered
	lookup        [][]byte      // OpenBSD top-level database "lookup" order
	err           error         // any error that occurs during open of resolv.conf
	mtime         time.Time     // time of resolv.conf modification
	soffset       uint32        // used by serverOffset
	singleRequest bool          // use sequential A and AAAA queries instead of parallel queries
	useTCP        bool          // force usage of TCP for DNS resolutions
	trustAD       bool          // add AD flag to queries
	noReload      bool          // do not check for config file updates
}

// serverOffset returns an offset that can be used to determine
// indices of servers in c.servers when making queries.
// When the rotate option is enabled, this offset increases.
// Otherwise it is always 0.
func (c *dnsConfig) serverOffset() (rn uint32) {
	if c.rotate {
		c.soffset++
		return c.soffset - 1 // return 0 to start
	}
	return 0
}

// The fixed-extent tables below are storage, built once in init() and read
// through the package variable. A Moxie package variable carries no
// initializer, so the literals live in init(); callers keep the accessor
// and pay a header load instead of a copy of the whole table.
var (
	defaultNSTbl [][]byte
)


func _defaultNS() (r [][]byte) { return defaultNSTbl }
