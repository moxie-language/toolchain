// Read system DNS config from /etc/resolv.conf

package net

import (
	"github.com/moxie-language/toolchain/pkg/mxutil"
	"internal/bytealg"
	"internal/stringslite"
	"net/netip"
	"os"
	"time"
)

// See resolv.conf(5) on a Linux machine.
func dnsReadConfig(filename string) (rdnsConfig *dnsConfig) {
	conf1 := &dnsConfig{
		ndots:    1,
		timeout:  5 * time.Second,
		attempts: 2,
	}
	file1, err3 := open(filename)
	if err3 != nil {
		dns := _defaultNS()
		conf1.servers = dns
		conf1.search = dnsDefaultSearch()
		conf1.err = err3
		return conf1
	}
	defer file1.close()
	if fi, err2 := file1.file.Stat(); err2 == nil {
		conf1.mtime = fi.ModTime()
	} else {
		dns := _defaultNS()
		conf1.servers = dns
		conf1.search = dnsDefaultSearch()
		conf1.err = err2
		return conf1
	}
	for line, ok := file1.readLine(); ok; line, ok = file1.readLine() {
		if len(line) > 0 && (line[0] == ';' || line[0] == '#') {
			// comment.
			continue
		}
		f := getFields(line)
		if len(f) < 1 {
			continue
		}
		switch f[0] {
		case "nameserver": // add one name server
			if len(f) > 1 && len(conf1.servers) < 3 { // small, but the standard limit
				// One more check: make sure server name is
				// just an IP address. Otherwise we need DNS
				// to look it up.
				if _, err1 := netip.ParseAddr(f[1]); err1 == nil {
					conf1.servers = mxutil.Ensure(conf1.servers, 1)
					conf1.servers = push(conf1.servers, JoinHostPort(f[1], "53"))
				}
			}

		case "domain": // set search path to just this domain
			if len(f) > 1 {
				conf1.search = [][]byte{ensureRooted(f[1])}
			}

		case "search": // set search path to given servers
			conf1.search = [][]byte{:0:len(f)-1}
			for i := 1; i < len(f); i++ {
				name := ensureRooted(f[i])
				if name == "." {
					continue
				}
				conf1.search = mxutil.Ensure(conf1.search, 1)
				conf1.search = push(conf1.search, name)
			}

		case "options": // magic options
			for _, s := range f[1:] {
				switch {
				case stringslite.HasPrefix(s, "ndots:"):
					n, _, _ := dtoi(s[6:])
					if n < 0 {
						n = 0
					} else if n > 15 {
						n = 15
					}
					conf1.ndots = n
				case stringslite.HasPrefix(s, "timeout:"):
					n, _, _ := dtoi(s[8:])
					if n < 1 {
						n = 1
					}
					conf1.timeout = time.Duration(n) * time.Second
				case stringslite.HasPrefix(s, "attempts:"):
					n, _, _ := dtoi(s[9:])
					if n < 1 {
						n = 1
					}
					conf1.attempts = n
				case s == "rotate":
					conf1.rotate = true
				case s == "single-request" || s == "single-request-reopen":
					// Linux option:
					// http://man7.org/linux/man-pages/man5/resolv.conf.5.html
					// "By default, glibc performs IPv4 and IPv6 lookups in parallel [...]
					//  This option disables the behavior and makes glibc
					//  perform the IPv6 and IPv4 requests sequentially."
					conf1.singleRequest = true
				case s == "use-vc" || s == "usevc" || s == "tcp":
					// Linux (use-vc), FreeBSD (usevc) and OpenBSD (tcp) option:
					// http://man7.org/linux/man-pages/man5/resolv.conf.5.html
					// "Sets RES_USEVC in _res.options.
					//  This option forces the use of TCP for DNS resolutions."
					// https://www.freebsd.org/cgi/man.cgi?query=resolv.conf&sektion=5&manpath=freebsd-release-ports
					// https://man.openbsd.org/resolv.conf.5
					conf1.useTCP = true
				case s == "trust-ad":
					conf1.trustAD = true
				case s == "edns0":
					// We use EDNS by default.
					// Ignore this option.
				case s == "no-reload":
					conf1.noReload = true
				default:
					conf1.unknownOpt = true
				}
			}

		case "lookup":
			// OpenBSD option:
			// https://www.openbsd.org/cgi-bin/man.cgi/OpenBSD-current/man5/resolv.conf.5
			// "the legal space-separated values are: bind, file, yp"
			conf1.lookup = f[1:]

		default:
			conf1.unknownOpt = true
		}
	}
	if len(conf1.servers) == 0 {
		dns := _defaultNS()
		conf1.servers = dns
	}
	if len(conf1.search) == 0 {
		conf1.search = dnsDefaultSearch()
	}
	return conf1
}

func dnsDefaultSearch() (rbyte [][]byte) {
	hn, err := os.Hostname()
	if err != nil {
		// best effort
		return nil
	}
	if i := bytealg.IndexByteString(hn, '.'); i >= 0 && i < len(hn)-1 {
		return [][]byte{ensureRooted(hn[i+1:])}
	}
	return nil
}

func ensureRooted(s string) (rs string) {
	if len(s) > 0 && s[len(s)-1] == '.' {
		return s
	}
	return s + "."
}
