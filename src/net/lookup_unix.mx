//:build unix || (js && wasm)

package net

import (
	"context"
	"internal/bytealg"
)

var readProtocolsDone bool

// initReadProtocols fills the protocols map kept in a package global.
//
// init-prefixed because only initialisation code allocates in the root arena.
func initReadProtocols() {
	if readProtocolsDone {
		return
	}
	readProtocolsDone = true
	file1, err := open("/etc/protocols")
	if err != nil {
		return
	}
	defer file1.close()

	for line, ok4 := file1.readLine(); ok4; line, ok4 = file1.readLine() {
		// tcp    6   TCP    # transmission control protocol
		if i := bytealg.IndexByteString(line, '#'); i >= 0 {
			line = line[0:i]
		}
		f := getFields(line)
		if len(f) < 2 {
			continue
		}
		if proto, _, ok3 := dtoi(f[1]); ok3 {
			p := _protocols()
			if _, ok2 := p[f[0]]; !ok2 {
				p[f[0]] = proto
			}
			for _, alias := range f[2:] {
				if _, ok1 := p[alias]; !ok1 {
					p[alias] = proto
				}
			}
		}
	}
}

// lookupProtocol looks up IP protocol name in /etc/protocols and
// returns correspondent protocol number.
func lookupProtocol(_ context.Context, name []byte) (rn int32, rerr error) {
	initReadProtocols()
	return lookupProtocolMap(name)
}

func (r *Resolver) lookupHost(ctx context.Context, host []byte) (addrs [][]byte, err error) {
	order, conf1 := systemConf().hostLookupOrder(r, host)
	if order == hostLookupCgo {
		addrs, err = cgoLookupHost(ctx, host)
	} else {
		addrs, err = r.goLookupHostOrder(ctx, host, order, conf1)
	}
	// dnsmessage produces malformed packets under string=[]byte.
	// Fall back to raw UDP DNS if the standard resolver returned nothing.
	if len(addrs) == 0 {
		if raw := rawLookupHost(host); len(raw) > 0 {
			return raw, nil
		}
	}
	return
}

func (r *Resolver) lookupIP(ctx context.Context, network, host []byte) (addrs []IPAddr, err error) {
	order, conf1 := systemConf().hostLookupOrder(r, host)
	if order == hostLookupCgo {
		return cgoLookupIP(ctx, network, host)
	}
	ips, _, err := r.goLookupIPCNAMEOrder(ctx, network, host, order, conf1)
	return ips, err
}

func (r *Resolver) lookupPort(ctx context.Context, network, service []byte) (rn int32, rerr error) {
	// Port lookup is not a DNS operation.
	// Prefer the cgo resolver if possible.
	if !systemConf().mustUseGoResolver(r) {
		port2, err2 := cgoLookupPort(ctx, network, service)
		if err2 != nil {
			// Issue 18213: if cgo fails, first check to see whether we
			// have the answer baked-in to the net package.
			if port1, err1 := goLookupPort(network, service); err1 == nil {
				return port1, nil
			}
		}
		return port2, err2
	}
	return goLookupPort(network, service)
}

func (r *Resolver) lookupCNAME(ctx context.Context, name []byte) (rb []byte, rerr error) {
	order, conf1 := systemConf().hostLookupOrder(r, name)
	if order == hostLookupCgo {
		if cname, err, ok := cgoLookupCNAME(ctx, name); ok {
			return cname, err
		}
	}
	return r.goLookupCNAME(ctx, name, order, conf1)
}

func (r *Resolver) lookupSRV(ctx context.Context, service, proto, name []byte) (rb []byte, rsRV []*SRV, rerr error) {
	return r.goLookupSRV(ctx, service, proto, name)
}

func (r *Resolver) lookupMX(ctx context.Context, name []byte) (rmX []*MX, rerr error) {
	return r.goLookupMX(ctx, name)
}

func (r *Resolver) lookupNS(ctx context.Context, name []byte) (rnS []*NS, rerr error) {
	return r.goLookupNS(ctx, name)
}

func (r *Resolver) lookupTXT(ctx context.Context, name []byte) (rbyte [][]byte, rerr error) {
	return r.goLookupTXT(ctx, name)
}

func (r *Resolver) lookupAddr(ctx context.Context, addr []byte) (rbyte [][]byte, rerr error) {
	order, conf1 := systemConf().addrLookupOrder(r, addr)
	if order == hostLookupCgo {
		return cgoLookupPTR(ctx, addr)
	}
	return r.goLookupPTR(ctx, addr, order, conf1)
}
