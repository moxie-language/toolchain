//:build js && wasm

// rawLookupHost reports that the raw UDP resolver is unavailable, which is the
// truth on js/wasm: there are no sockets (syscall.Socket and friends all return
// ENOSYS) and no syscall.SetsockoptTimeval at all.
//
// rawdns.mx, the real one, is `//:build unix`. Its two callers
// (lookup_unix.mx:69 and dnsclient_unix.mx:556) use it only as a fallback when
// the standard resolver returned nothing:
//
//	if len(addrs) == 0 {
//		if raw := rawLookupHost(host); len(raw) > 0 {
//			return raw, nil
//		}
//	}
//
// so returning nil here leaves them exactly as they were, minus a fallback that
// could never have worked.
package net

func rawLookupHost(host string) (rbyte [][]byte) {
	return nil
}
