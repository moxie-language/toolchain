package http

// Spawned dispatch: the same one-call-per-request handler, run by a fixed pool
// of worker routines instead of in the connection's domain.
//
// The pool exists because a spawn is a fork, not a coroutine: a worker is an OS
// thread with its own domain and its own arenas, so one spawn per request would
// cost a thread per request (measured by tests/netsmoke/spawncost). The pool is
// spawned once, workers pull from their own queue, and the connection shell
// picks a worker per request.
//
// The boundary carries an int32 STREAM, not framed byte slices, and that is a
// workaround for a runtime defect: a []byte built at run time does not survive
// a spawn channel. Measured (docs/OPEN_WORK.md): a literal crosses intact,
// while the same bytes built with push arrive with the right LENGTH and
// allocator metadata as their content. Scalars cross correctly, so a message is
// encoded as its kind and then each field as int32 values - byte strings packed
// four bytes to a word. The honest fix is the runtime defect, not this encoding.
//
// The router table is a package global read by the workers, which is sound
// because spawn forks: every worker inherits the table as it stands when the
// pool starts, and the table is built at startup and only read afterwards.

import (
	"errors"
	"runtime"
)

// chanGlobalMux is the table the pool workers read.
var chanGlobalMux *ChanMux

func chanRouteHandler(id int32) (h ChanHandler) {
	if chanGlobalMux == nil || id < 0 || id >= int32(len(chanGlobalMux.routes)) {
		return nil
	}
	return chanGlobalMux.routes[id].h
}

// --- int32 stream framing ---

// packBytes is the words of s: length first, then four bytes to a word,
// little-endian inside the word.
func packBytes(s string) (w []int32) {
	n := int32(len(s))
	w = []int32{:1 + (n+3)/4}
	w[0] = n
	for i := int32(0); i < n; i++ {
		wi := 1 + i/4
		w[wi] = w[wi] | (int32(s[i]) << ((i % 4) * 8))
	}
	return w
}

func sendBytes(ch chan int32, s string) {
	w := packBytes(s)
	for i := 0; i < len(w); i++ {
		ch <- w[i]
	}
}

func recvBytes(ch chan int32) (s string) {
	n := <-ch
	nw := (n + 3) / 4
	w := []int32{:nw}
	for i := int32(0); i < nw; i++ {
		w[i] = <-ch
	}
	s = []byte{:n}
	for i := int32(0); i < n; i++ {
		s[i] = byte((w[i/4] >> ((i % 4) * 8)) & 0xff)
	}
	return s
}

func sendHeaders(ch chan int32, h Header) {
	if h == nil {
		ch <- 0
		return
	}
	ch <- int32(len(h))
	for k, vv := range h {
		sendBytes(ch, k)
		ch <- int32(len(vv))
		for i := 0; i < len(vv); i++ {
			sendBytes(ch, vv[i])
		}
	}
}

func recvHeaders(ch chan int32) (h Header) {
	n := <-ch
	if n == 0 {
		return nil
	}
	h = Header{}
	for i := int32(0); i < n; i++ {
		k := recvBytes(ch)
		vn := <-ch
		vv := [][]byte{:vn}
		for j := int32(0); j < vn; j++ {
			vv[j] = recvBytes(ch)
		}
		h[k] = vv
	}
	return h
}

// chanWorkerLoop is one pool worker. It owns no socket and no connection state:
// it decodes a request into ITS request arena, makes the route's one handler
// call there, streams the response back and resets the arena, so a worker that
// served a million requests holds no more memory than one that served one.
func chanWorkerLoop(jobs chan int32, results chan int32) {
	arena := runtime.ArenaAcquire(chanRequestArenaBytes)
	done := false
	for !done {
		kind := <-jobs
		if kind == 0 {
			break
		}
		if kind != MsgReqHead {
			// A stream that is not at a message boundary cannot be resynced;
			// the shell only ever sends well-formed requests, so this is a
			// programming error and stopping is the loud answer.
			break
		}
		runtime.ManualArenaEnter(arena)
		rq := &Req{}
		rq.Method = recvBytes(jobs)
		rq.Path = recvBytes(jobs)
		rq.Proto = recvBytes(jobs)
		routeID := <-jobs
		rq.Headers = recvHeaders(jobs)
		tail := <-jobs
		if tail == MsgReqBody {
			rq.Body = recvBytes(jobs)
			tail = <-jobs
		}
		h := chanRouteHandler(routeID)
		var resp *Resp
		if h != nil && tail == MsgReqEnd {
			resp = h.Handle(rq)
		}
		if resp == nil {
			results <- MsgRespAbort
			sendBytes(results, "http: channel handler: no route")
		} else {
			results <- MsgRespHead
			results <- resp.Status
			sendHeaders(results, resp.Headers)
			results <- MsgRespBody
			sendBytes(results, resp.Body)
			results <- MsgRespEnd
		}
		runtime.ManualArenaExit(arena)
		runtime.ArenaReset(arena)
	}
	runtime.ArenaRelease(arena)
}

// chanPool is a fixed set of workers with their own queues. next rotates so a
// connection does not always land on the same worker.
type chanPool struct {
	mux     *ChanMux
	jobs    []chan int32
	results []chan int32
	next    int32
}

func (p *chanPool) pick() (i int32) {
	i = p.next % int32(len(p.jobs))
	p.next = p.next + 1
	return i
}

// call hands one decoded request to a worker and returns the response it
// streamed back. The response's slices are allocated in the CALLER's request
// arena, so the shell can write them and then free the arena.
func (p *chanPool) call(routeID int32, rq *Req) (resp *Resp) {
	i := p.pick()
	j := p.jobs[i]
	j <- MsgReqHead
	sendBytes(j, rq.Method)
	sendBytes(j, rq.Path)
	sendBytes(j, rq.Proto)
	j <- routeID
	sendHeaders(j, rq.Headers)
	j <- MsgReqBody
	sendBytes(j, rq.Body)
	j <- MsgReqEnd
	return recvResp(p.results[i])
}

// recvResp reads one response off the stream. It is a free function because
// chanPool is self-mutating and a ':=' inside a loop of one of its methods is
// rejected.
func recvResp(ch chan int32) (resp *Resp) {
	resp = &Resp{}
	done := false
	for !done {
		kind := <-ch
		switch kind {
		case MsgRespHead:
			resp.Status = <-ch
			resp.Headers = recvHeaders(ch)
		case MsgRespBody:
			resp.Body = recvBytes(ch)
		case MsgRespEnd:
			done = true
		case MsgRespAbort:
			chanReportAbort(errors.New(recvBytes(ch)))
			resp = nil
			done = true
		default:
			done = true
			resp = nil
		}
	}
	return resp
}
