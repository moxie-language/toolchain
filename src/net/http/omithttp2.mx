//:build nethttpomithttp2

package http

import (
	"time"
)


const noHTTP2 = "no bundled HTTP/2" // should never see this

var http2errRequestCanceled error

func _http2goAwayTimeout() (rduration time.Duration) { return 1 * time.Second }

const http2NextProtoTLS = "h2"

type http2Transport struct {
	MaxHeaderListSize uint32
	ConnPool          struct{}
}

func (*http2Transport) RoundTrip(*Request) (rresponse *Response, rerr error) { panic(noHTTP2) }
func (*http2Transport) CloseIdleConnections()                 {}

type http2noDialH2RoundTripper struct{}

func (http2noDialH2RoundTripper) RoundTrip(*Request) (rresponse *Response, rerr error) { panic(noHTTP2) }

type http2noDialClientConnPool struct {
	http2clientConnPool http2clientConnPool
}

type http2clientConnPool struct {
	conns map[string][]*http2clientConn
}

type http2clientConn struct{}

type http2clientConnIdleState struct {
	canTakeNewRequest bool
}

func (cc *http2clientConn) idleState() (rhttp2clientConnIdleState http2clientConnIdleState) { return http2clientConnIdleState{} }

func http2configureTransports(*Transport) (rhttp2Transport *http2Transport, rerr error) { panic(noHTTP2) }

func http2isNoCachedConnError(err error) (rok bool) {
	_, ok := err.(interface{ IsHTTP2NoCachedConnError() })
	return ok
}

type http2Server struct {
	NewWriteScheduler func() http2WriteScheduler
}

type http2WriteScheduler struct{}

func http2NewPriorityWriteScheduler(struct{}) (rhttp2WriteScheduler http2WriteScheduler) { panic(noHTTP2) }

func http2ConfigureServer(s *Server, conf *http2Server) (rerr error) { panic(noHTTP2) }

func http2ErrNoCachedConn() (rerr error) { return http2noCachedConnError{} }

type http2noCachedConnError struct{}

func (http2noCachedConnError) IsHTTP2NoCachedConnError() {}

func (http2noCachedConnError) Error() (rs string) { return "http2: no cached connection was available" }
func (http2noCachedConnError) String() (rs string) { return http2noCachedConnError{}.Error() }
