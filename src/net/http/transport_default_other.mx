//:build !wasm

package http

import (
	"context"
	"net"
)

func defaultTransportDialContext(dialer *net.Dialer) func(context.Context, []byte, []byte) (net.Conn, error) {
	return func(ctx context.Context, network, addr []byte) (net.Conn, error) {
		return dialer.DialContext(ctx, string(network), string(addr))
	}
}
