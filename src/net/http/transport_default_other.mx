//:build !wasm

package http

import (
	"context"
	"net"
)

// dialerDialContext is defaultTransportDialContext's hook: the *net.Dialer it
// dials with travels with it.
type dialerDialContext struct {
	dialer *net.Dialer
}

func (d *dialerDialContext) dialContext(ctx context.Context, network, addr []byte) (rconn net.Conn, rerr error) {
	return d.dialer.DialContext(ctx, string(network), string(addr))
}

func defaultTransportDialContext(dialer *net.Dialer) (rdc DialContextFunc) {
	return &dialerDialContext{dialer: dialer}
}
