// Package httptrace provides mechanisms to trace the events within
// HTTP client requests.
package httptrace

import (
	"crypto/tls"
	"net"
	"net/textproto"
	"time"
)

// ClientTrace is a set of hooks to run at various stages of an outgoing
// HTTP request. Any particular hook may be nil. Functions may be
// called concurrently from different goroutines and some may be called
// after the request has completed or failed.
//
// ClientTrace currently traces a single HTTP request & response
// during a single round trip and has no hooks that span a series
// of redirected requests.
//
// See https://blog.golang.org/http-tracing for more.
type ClientTrace struct {
	// prev is the trace this one composes: Compose links the old trace here and
	// the dispatch helpers call every hook along the chain. Composition used to
	// be sixteen closures, each closing over the two hooks it composed - which
	// is exactly what a Moxie function value cannot carry.
	prev *ClientTrace

	// Every hook receives the ClientTrace it belongs to as its LAST argument,
	// so a hook can reach trace state through the parameter instead of closing
	// over it.
	//
	// GetConn is called before a connection is created or
	// retrieved from an idle pool. The hostPort is the
	// "host:port" of the target or proxy. GetConn is called even
	// if there's already an idle cached connection available.
	GetConn func(hostPort string, ct *ClientTrace)

	// GotConn is called after a successful connection is
	// obtained. There is no hook for failure to obtain a
	// connection; instead, use the error from
	// Transport.RoundTrip.
	GotConn func(info GotConnInfo, ct *ClientTrace)

	// PutIdleConn is called when the connection is returned to
	// the idle pool. If err is nil, the connection was
	// successfully returned to the idle pool. If err is non-nil,
	// it describes why not. PutIdleConn is not called if
	// connection reuse is disabled via Transport.DisableKeepAlives.
	// PutIdleConn is called before the caller's Response.Body.Close
	// call returns.
	// For HTTP/2, this hook is not currently used.
	PutIdleConn func(err error, ct *ClientTrace)

	// GotFirstResponseByte is called when the first byte of the response
	// headers is available.
	GotFirstResponseByte func(ct *ClientTrace)

	// Got100Continue is called if the server replies with a "100
	// Continue" response.
	Got100Continue func(ct *ClientTrace)

	// Got1xxResponse is called for each 1xx informational response header
	// returned before the final non-1xx response. Got1xxResponse is called
	// for "100 Continue" responses, even if Got100Continue is also defined.
	// If it returns an error, the client request is aborted with that error value.
	Got1xxResponse func(code int32, header textproto.MIMEHeader, ct *ClientTrace) error

	// DNSStart is called when a DNS lookup begins.
	DNSStart func(info DNSStartInfo, ct *ClientTrace)

	// DNSDone is called when a DNS lookup ends.
	DNSDone func(info DNSDoneInfo, ct *ClientTrace)

	// ConnectStart is called when a new connection's Dial begins.
	// If net.Dialer.DualStack (IPv6 "Happy Eyeballs") support is
	// enabled, this may be called multiple times.
	ConnectStart func(network, addr []byte, ct *ClientTrace)

	// ConnectDone is called when a new connection's Dial
	// completes. The provided err indicates whether the
	// connection completed successfully.
	// If net.Dialer.DualStack ("Happy Eyeballs") support is
	// enabled, this may be called multiple times.
	ConnectDone func(network, addr []byte, err error, ct *ClientTrace)

	// TLSHandshakeStart is called when the TLS handshake is started. When
	// connecting to an HTTPS site via an HTTP proxy, the handshake happens
	// after the CONNECT request is processed by the proxy.
	TLSHandshakeStart func(ct *ClientTrace)

	// TLSHandshakeDone is called after the TLS handshake with either the
	// successful handshake's connection state, or a non-nil error on handshake
	// failure.
	TLSHandshakeDone func(state tls.ConnectionState, err error, ct *ClientTrace)

	// WroteHeaderField is called after the Transport has written
	// each request header. At the time of this call the values
	// might be buffered and not yet written to the network.
	WroteHeaderField func(key string, value [][]byte, ct *ClientTrace)

	// WroteHeaders is called after the Transport has written
	// all request headers.
	WroteHeaders func(ct *ClientTrace)

	// Wait100Continue is called if the Request specified
	// "Expect: 100-continue" and the Transport has written the
	// request headers but is waiting for "100 Continue" from the
	// server before writing the request body.
	Wait100Continue func(ct *ClientTrace)

	// WroteRequest is called with the result of writing the
	// request and any body. It may be called multiple times
	// in the case of retried requests.
	WroteRequest func(info WroteRequestInfo, ct *ClientTrace)
}

// WroteRequestInfo contains information provided to the WroteRequest
// hook.
type WroteRequestInfo struct {
	// Err is any error encountered while writing the Request.
	Err error
}

// Compose modifies t such that it respects the previously-registered hooks in
// old, calling t's hooks before old's. It replaces the context-based
// WithClientTrace: a request carries its ClientTrace in a concrete field, and
// composing a new trace with the one already there keeps the same semantics.
func (t *ClientTrace) Compose(old *ClientTrace) {
	if old == nil {
		return
	}
	// Chain, do not nest. The hooks stay exactly as they are and the dispatch
	// helpers below walk the whole chain, which is what the sixteen composing
	// closures did: this trace's hook first, then the older trace's.
	t.prev = old
}

// The helpers below are how hooks are called from net/http and from any code
// holding a ClientTrace. Each walks the composed chain, skips nil hooks and
// tolerates a nil trace, so a call site needs neither a nil guard nor a value
// that would have to close over one.

func GetConn(t *ClientTrace, hostPort string) {
	for c := t; c != nil; c = c.prev {
		if c.GetConn != nil {
			c.GetConn(hostPort, c)
		}
	}
}

func GotConn(t *ClientTrace, info GotConnInfo) {
	for c := t; c != nil; c = c.prev {
		if c.GotConn != nil {
			c.GotConn(info, c)
		}
	}
}

func PutIdleConn(t *ClientTrace, err error) {
	for c := t; c != nil; c = c.prev {
		if c.PutIdleConn != nil {
			c.PutIdleConn(err, c)
		}
	}
}

func GotFirstResponseByte(t *ClientTrace) {
	for c := t; c != nil; c = c.prev {
		if c.GotFirstResponseByte != nil {
			c.GotFirstResponseByte(c)
		}
	}
}

func Got100Continue(t *ClientTrace) {
	for c := t; c != nil; c = c.prev {
		if c.Got100Continue != nil {
			c.Got100Continue(c)
		}
	}
}

// HasGot1xxResponse reports whether any trace in the composed chain has a
// Got1xxResponse hook. The HTTP/2 layer uses the hook's PRESENCE to decide who
// limits the size of 1xx responses, so it cannot be folded into the call.
func HasGot1xxResponse(t *ClientTrace) (ok bool) {
	for c := t; c != nil; c = c.prev {
		if c.Got1xxResponse != nil {
			return true
		}
	}
	return false
}

func Got1xxResponse(t *ClientTrace, code int32, header textproto.MIMEHeader) (err error) {
	for c := t; c != nil; c = c.prev {
		if c.Got1xxResponse != nil {
			if e := c.Got1xxResponse(code, header, c); e != nil {
				return e
			}
		}
	}
	return nil
}

func DNSStart(t *ClientTrace, info DNSStartInfo) {
	for c := t; c != nil; c = c.prev {
		if c.DNSStart != nil {
			c.DNSStart(info, c)
		}
	}
}

func DNSDone(t *ClientTrace, info DNSDoneInfo) {
	for c := t; c != nil; c = c.prev {
		if c.DNSDone != nil {
			c.DNSDone(info, c)
		}
	}
}

func ConnectStart(t *ClientTrace, network, addr []byte) {
	for c := t; c != nil; c = c.prev {
		if c.ConnectStart != nil {
			c.ConnectStart(network, addr, c)
		}
	}
}

func ConnectDone(t *ClientTrace, network, addr []byte, err error) {
	for c := t; c != nil; c = c.prev {
		if c.ConnectDone != nil {
			c.ConnectDone(network, addr, err, c)
		}
	}
}

func TLSHandshakeStart(t *ClientTrace) {
	for c := t; c != nil; c = c.prev {
		if c.TLSHandshakeStart != nil {
			c.TLSHandshakeStart(c)
		}
	}
}

func TLSHandshakeDone(t *ClientTrace, state tls.ConnectionState, err error) {
	for c := t; c != nil; c = c.prev {
		if c.TLSHandshakeDone != nil {
			c.TLSHandshakeDone(state, err, c)
		}
	}
}

func WroteHeaderField(t *ClientTrace, key string, value [][]byte) {
	for c := t; c != nil; c = c.prev {
		if c.WroteHeaderField != nil {
			c.WroteHeaderField(key, value, c)
		}
	}
}

func WroteHeaders(t *ClientTrace) {
	for c := t; c != nil; c = c.prev {
		if c.WroteHeaders != nil {
			c.WroteHeaders(c)
		}
	}
}

func Wait100Continue(t *ClientTrace) {
	for c := t; c != nil; c = c.prev {
		if c.Wait100Continue != nil {
			c.Wait100Continue(c)
		}
	}
}

func WroteRequest(t *ClientTrace, info WroteRequestInfo) {
	for c := t; c != nil; c = c.prev {
		if c.WroteRequest != nil {
			c.WroteRequest(info, c)
		}
	}
}

// DNSStartInfo contains information about a DNS request.
type DNSStartInfo struct {
	Host string
}

// DNSDoneInfo contains information about the results of a DNS lookup.
type DNSDoneInfo struct {
	// Addrs are the IPv4 and/or IPv6 addresses found in the DNS
	// lookup. The contents of the slice should not be mutated.
	Addrs []net.IPAddr

	// Err is any error that occurred during the DNS lookup.
	Err error

	// Coalesced is whether the Addrs were shared with another
	// caller who was doing the same DNS lookup concurrently.
	Coalesced bool
}

// GotConnInfo is the argument to the [ClientTrace.GotConn] function and
// contains information about the obtained connection.
type GotConnInfo struct {
	// Conn is the connection that was obtained. It is owned by
	// the http.Transport and should not be read, written or
	// closed by users of ClientTrace.
	Conn net.Conn

	// Reused is whether this connection has been previously
	// used for another HTTP request.
	Reused bool

	// WasIdle is whether this connection was obtained from an
	// idle pool.
	WasIdle bool

	// IdleTime reports how long the connection was previously
	// idle, if WasIdle is true.
	IdleTime time.Duration
}
