// This file implements a decision tree for fast matching of requests to
// patterns.
//
// The root of the tree branches on the host of the request.
// The next level branches on the method.
// The remaining levels branch on consecutive segments of the path.
//
// The "more specific wins" precedence rule can result in backtracking.
// For example, given the patterns
//     /a/b/z
//     /a/{x}/c
// we will first try to match the path "/a/b/c" with /a/b/z, and
// when that fails we will try against /a/{x}/c.

package http

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"bytes"
	"runtime"
	"unsafe"
)

// newNode allocates one routing node with process lifetime, in the ROOT arena.
//
// A node written as a composite literal inside a mutating method lands in the
// receiver's SOVEREIGN data arena, because that is the allocation scope the
// compiler gives a mutating method's direct allocations - and the codec must
// not alias sovereign data out of a call, since a later compaction on that
// receiver can move it. So the child a registration call returned was a COPY of
// the child the tree stored: the next level was written to the copy, the tree
// never received it, and every registration shape answered pattern=[] (exact,
// subtree, method and host alike; measured with diagnostics inside addPattern).
//
// A root-arena node is process-lifetime and is not sovereign data, so the codec
// keeps its identity across the return and the caller mutates the node the tree
// holds. The tree needs process lifetime anyway - it is read on every request.
func newNode() (n *routingNode) {
	p := runtime.ArenaAlloc(runtime.RootArena(), unsafe.Sizeof(routingNode{}))
	return (*routingNode)(p)
}

// A childMap holds a node's children: a slice while there are few, a map once
// there are many. It is concrete rather than the generic mapping[K, V] it
// replaces because it has exactly one instantiation and that instantiation
// stored the receiver in the value slot (see addChild's parent print in
// OPEN_WORK round 267).
type childMap struct {
	s []childEntry
	m map[string]*routingNode
}

type childEntry struct {
	key   string
	value *routingNode
}

// maxChildSlice is the largest child count kept in the slice representation.
const maxChildSlice = 8

func (h *childMap) add(k string, v *routingNode) {
	if h.m == nil && len(h.s) < maxChildSlice {
		h.s = mxutil.Ensure(h.s, 1)
		h.s = push(h.s, childEntry{k, v})
		return
	}
	if h.m == nil {
		h.m = map[string]*routingNode{}
		for _, e := range h.s {
			h.m[e.key] = e.value
		}
		h.s = nil
	}
	h.m[k] = v
}

func (h *childMap) find(k string) (v *routingNode, found bool) {
	if h == nil {
		return nil, false
	}
	if h.m != nil {
		v, found = h.m[k]
		return v, found
	}
	for _, e := range h.s {
		if e.key == k {
			return e.value, true
		}
	}
	return nil, false
}

// A routingNode is a node in the decision tree.
// The same struct is used for leaf and interior nodes.
type routingNode struct {
	// A leaf node holds a single pattern and the Handler it was registered
	// with.
	pattern *pattern
	handler Handler

	// An interior node maps parts of the incoming request to child nodes.
	// special children keys:
	//     "/"	trailing slash (resulting from {$})
	//	   ""   single wildcard
	children   childMap
	multiChild *routingNode // child with multi wildcard
	emptyChild *routingNode // optimization: child with key ""
}

// addPattern adds a pattern and its associated Handler to the tree
// at root.
func (root *routingNode) addPattern(p *pattern, h Handler) {
	// First level of tree is host.
	n := root.addChild(p.host)
	// Second level of tree is method.
	n = n.addChild(p.method)
	// Remaining levels are path.
	n.addSegments(p.segments, p, h)
}

// addSegments adds the given segments to the tree rooted at n.
// If there are no segments, then n is a leaf node that holds
// the given pattern and handler.
func (n *routingNode) addSegments(segs []segment, p *pattern, h Handler) {
	if len(segs) == 0 {
		n.set(p, h)
		return
	}
	seg := segs[0]
	if seg.multi {
		if len(segs) != 1 {
			panic("multi wildcard not last")
		}
		c := newNode()
		n.multiChild = c
		c.set(p, h)
	} else if seg.wild {
		n.addChild("").addSegments(segs[1:], p, h)
	} else {
		n.addChild(seg.s).addSegments(segs[1:], p, h)
	}
}

// set sets the pattern and handler for n, which
// must be a leaf node.
func (n *routingNode) set(p *pattern, h Handler) {
	if n.pattern != nil || n.handler != nil {
		panic("non-nil leaf fields")
	}
	n.pattern = p
	n.handler = h
}

// addChild adds a child node with the given key to n
// if one does not exist, and returns the child.
func (n *routingNode) addChild(key []byte) (rroutingNode *routingNode) {
	if key == "" {
		if n.emptyChild == nil {
			n.emptyChild = newNode()
		}
		return n.emptyChild
	}
	if a := n.findChild(key); a != nil {
		return a
	}
	c := newNode()
	n.children.add(key, c)
	return c
}

// findChild returns the child of n with the given key, or nil
// if there is no child with that key.
func (n *routingNode) findChild(key []byte) (rroutingNode *routingNode) {
	if key == "" {
		return n.emptyChild
	}
	r, _ := n.children.find(key)
	return r
}

// match returns the leaf node under root that matches the arguments, and a list
// of values for pattern wildcards in the order that the wildcards appear.
// For example, if the request path is "/a/b/c" and the pattern is "/{x}/b/{y}",
// then the second return value will be [][]byte{"a", "c"}.
func (root *routingNode) match(host, method, pat2 []byte) (rroutingNode *routingNode, rbyte [][]byte) {
	if host != "" {
		// There is a host. If there is a pattern that specifies that host and it
		// matches, we are done. If the pattern doesn't match, fall through to
		// try patterns with no host.
		if l, m := root.findChild(host).matchMethodAndPath(method, pat2); l != nil {
			return l, m
		}
	}
	return root.emptyChild.matchMethodAndPath(method, pat2)
}

// matchMethodAndPath matches the method and path.
// Its return values are the same as [routingNode.match].
// The receiver should be a child of the root.
func (n *routingNode) matchMethodAndPath(method, pat3 []byte) (rroutingNode *routingNode, rbyte [][]byte) {
	if n == nil {
		return nil, nil
	}
	if l, m := n.findChild(method).matchPath(pat3, nil); l != nil {
		// Exact match of method name.
		return l, m
	}
	if method == "HEAD" {
		// GET matches HEAD too.
		if l, m := n.findChild("GET").matchPath(pat3, nil); l != nil {
			return l, m
		}
	}
	// No exact match; try patterns with no method.
	return n.emptyChild.matchPath(pat3, nil)
}

// matchPath matches a path.
// Its return values are the same as [routingNode.match].
// matchPath calls itself recursively. The matches argument holds the wildcard matches
// found so far.
func (n *routingNode) matchPath(pat4 []byte, matches [][]byte) (rroutingNode *routingNode, rbyte [][]byte) {
	if n == nil {
		return nil, nil
	}
	// If path is empty, then we are done.
	// If n is a leaf node, we found a match; return it.
	// If n is an interior node (which means it has a nil pattern),
	// then we failed to match.
	if pat4 == "" {
		if n.pattern == nil {
			return nil, nil
		}
		return n, matches
	}
	// Get the first segment of path.
	seg, rest := firstSegment(pat4)
	// First try matching against patterns that have a literal for this position.
	// We know by construction that such patterns are more specific than those
	// with a wildcard at this position (they are either more specific, equivalent,
	// or overlap, and we ruled out the first two when the patterns were registered).
	if b, m := n.findChild(seg).matchPath(rest, matches); b != nil {
		return b, m
	}
	// If matching a literal fails, try again with patterns that have a single
	// wildcard (represented by an empty string in the child mapping).
	// Again, by construction, patterns with a single wildcard must be more specific than
	// those with a multi wildcard.
	// We skip this step if the segment is a trailing slash, because single wildcards
	// don't match trailing slashes.
	if seg != "/" {
		if d, m := n.emptyChild.matchPath(rest, push(matches, seg)); d != nil {
			return d, m
		}
	}
	// Lastly, match the pattern (there can be at most one) that has a multi
	// wildcard in this position to the rest of the path.
	if c := n.multiChild; c != nil {
		// Don't record a match for a nameless wildcard (which arises from a
		// trailing slash in the pattern).
		if c.pattern.lastSegment().s != "" {
			matches = mxutil.Ensure(matches, 1)
			matches = push(matches, pathUnescape(pat4[1:])) // remove initial slash
		}
		return c, matches
	}
	return nil, nil
}

// firstSegment splits path into its first segment, and the rest.
// The path must begin with "/".
// If path consists of only a slash, firstSegment returns ("/", "").
// The segment is returned unescaped, if possible.
func firstSegment(pat5 []byte) (seg, rest []byte) {
	if pat5 == "/" {
		return "/", ""
	}
	pat5 = pat5[1:] // drop initial slash
	i := bytes.IndexByte(pat5, '/')
	if i < 0 {
		i = len(pat5)
	}
	return pathUnescape(pat5[:i]), pat5[i:]
}

// matchingMethods adds to methodSet all the methods that would result in a
// match if passed to routingNode.match with the given host and path.
func (root *routingNode) matchingMethods(host, pat6 []byte, methodSet map[string]bool) {
	if host != "" {
		root.findChild(host).matchingMethodsPath(pat6, methodSet)
	}
	root.emptyChild.matchingMethodsPath(pat6, methodSet)
	if methodSet["GET"] {
		methodSet["HEAD"] = true
	}
}

func (n *routingNode) matchingMethodsPath(pat7 []byte, set map[string]bool) {
	if n == nil {
		return
	}
	if n.children.m != nil {
		for method, c := range n.children.m {
			mp, _ := c.matchPath(pat7, nil)
			if mp != nil {
				set[method] = true
			}
		}
	} else {
		for _, e := range n.children.s {
			mp, _ := e.value.matchPath(pat7, nil)
			if mp != nil {
				set[e.key] = true
			}
		}
	}
	// Don't look at the empty child. If there were an empty
	// child, it would match on any method, but we only
	// call this when we fail to match on a method.
}
