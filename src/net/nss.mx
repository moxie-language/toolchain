package net

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"errors"
	"internal/bytealg"
	"os"
	"time"
)

const (
	nssConfigPath = "/etc/nsswitch.conf"
)

var nssConfig nsswitchConfig

type nsswitchConfig struct {
	initDone bool // guards init of nsswitchConfig

	// ch is used as a semaphore that only allows one lookup at a
	// time to recheck nsswitch.conf
	ch          chan struct{} // guards lastChecked and modTime
	lastChecked time.Time     // last time nsswitch.conf was checked

	nssConf *nssConf
}

func getSystemNSS() (rnssConf *nssConf) {
	nssConfig.tryUpdate()
	conf1 := nssConfig.nssConf
	return conf1
}

// init initializes conf and is only called via conf.initOnce.
func (conf *nsswitchConfig) init() {
	conf.nssConf = parseNSSConfFile("/etc/nsswitch.conf")
	conf.lastChecked = time.Now()
	conf.ch = chan struct{}{1}
}

// tryUpdate tries to update conf.
func (conf *nsswitchConfig) tryUpdate() {
	if !conf.initDone { conf.initDone = true; conf.init() }

	// Ensure only one update at a time checks nsswitch.conf
	if !conf.tryAcquireSema() {
		return
	}
	defer conf.releaseSema()

	now := time.Now()
	if conf.lastChecked.After(now.Add(-5 * time.Second)) {
		return
	}
	conf.lastChecked = now

	var mtime time.Time
	if fi, err := os.Stat(nssConfigPath); err == nil {
		mtime = fi.ModTime()
	}
	if mtime.Equal(conf.nssConf.mtime) {
		return
	}

	nssConf1 := parseNSSConfFile(nssConfigPath)
	conf.nssConf = nssConf1
}

func (conf *nsswitchConfig) acquireSema() {
	conf.ch <- struct{}{}
}

func (conf *nsswitchConfig) tryAcquireSema() (rok bool) {
	select {
	case conf.ch <- struct{}{}:
		return true
	default:
		return false
	}
}

func (conf *nsswitchConfig) releaseSema() {
	<-conf.ch
}

// nssConf represents the state of the machine's /etc/nsswitch.conf file.
type nssConf struct {
	mtime   time.Time              // time of nsswitch.conf modification
	err     error                  // any error encountered opening or parsing the file
	sources map[string][]nssSource // keyed by database (e.g. "hosts")
}

type nssSource struct {
	source   string // e.g. "compat", "files", "mdns4_minimal"
	criteria []nssCriterion
}

// standardCriteria reports all specified criteria have the default
// status actions.
func (s *nssSource) standardCriteria() (rok bool) {
	for i, crit := range s.criteria {
		if !crit.standardStatusAction(i == len(s.criteria)-1) {
			return false
		}
	}
	return true
}

// nssCriterion is the parsed structure of one of the criteria in brackets
// after an NSS source name.
type nssCriterion struct {
	negate bool   // if "!" was present
	status string // e.g. "success", "unavail" (lowercase)
	action string // e.g. "return", "continue" (lowercase)
}

// standardStatusAction reports whether c is equivalent to not
// specifying the criterion at all. last is whether this criteria is the
// last in the list.
func (c *nssCriterion) standardStatusAction(last bool) (rok bool) {
	if c.negate {
		return false
	}
	var def string
	switch c.status {
	case "success":
		def = "return"
	case "notfound", "unavail", "tryagain":
		def = "continue"
	default:
		// Unknown status
		return false
	}
	if last && c.action == "return" {
		return true
	}
	return c.action == def
}

func parseNSSConfFile(file string) (rnssConf *nssConf) {
	f, err := open(file)
	if err != nil {
		return &nssConf{err: err}
	}
	defer f.close()
	mtime, _, err := f.stat()
	if err != nil {
		return &nssConf{err: err}
	}

	conf1 := parseNSSConf(f)
	conf1.mtime = mtime
	return conf1
}

func parseNSSConf(f *parseFile) (rnssConf *nssConf) {
	conf1 := &nssConf{}
	for line, ok := f.readLine(); ok; line, ok = f.readLine() {
		line = trimSpace(removeComment(line))
		if len(line) == 0 {
			continue
		}
		colon := bytealg.IndexByteString(line, ':')
		if colon == -1 {
			conf1.err = errors.New("no colon on line")
			return conf1
		}
		db := trimSpace(line[:colon])
		srcs := line[colon+1:]
		for {
			srcs = trimSpace(srcs)
			if len(srcs) == 0 {
				break
			}
			sp := bytealg.IndexByteString(srcs, ' ')
			var src string
			if sp == -1 {
				src = srcs
				srcs = "" // done
			} else {
				src = srcs[:sp]
				srcs = trimSpace(srcs[sp+1:])
			}
			var criteria []nssCriterion
			// See if there's a criteria block in brackets.
			if len(srcs) > 0 && srcs[0] == '[' {
				bclose := bytealg.IndexByteString(srcs, ']')
				if bclose == -1 {
					conf1.err = errors.New("unclosed criterion bracket")
					return conf1
				}
				var err error
				criteria, err = parseCriteria(srcs[1:bclose])
				if err != nil {
					conf1.err = errors.New("invalid criteria: " + srcs[1:bclose])
					return conf1
				}
				srcs = srcs[bclose+1:]
			}
			if conf1.sources == nil {
				conf1.sources = map[string][]nssSource{}
			}
			conf1.sources[db] = push(conf1.sources[db], nssSource{
				source:   src,
				criteria: criteria,
			})
		}
	}
	return conf1
}

// parses "foo=bar !foo=bar"
// criteriaBuilder accumulates the criteria parseCriteria produces. The parse used
// to hand foreachField a closure that pushed onto its local slice; that closure's
// environment is what a Moxie function value cannot carry.
type criteriaBuilder struct {
	c []nssCriterion
}

func (b *criteriaBuilder) add(f string) (err error) {
	not := false
	if len(f) > 0 && f[0] == '!' {
		not = true
		f = f[1:]
	}
	if len(f) < 3 {
		return errors.New("criterion too short")
	}
	eq := bytealg.IndexByteString(f, '=')
	if eq == -1 {
		return errors.New("criterion lacks equal sign")
	}
	if hasUpperCase(f) {
		lower := []byte(f)
		lowerASCIIBytes(lower)
		f = string(lower)
	}
	b.c = mxutil.Ensure(b.c, 1)
	b.c = push(b.c, nssCriterion{
		negate: not,
		status: f[:eq],
		action: f[eq+1:],
	})
	return nil
}

func parseCriteria(x string) (c []nssCriterion, err error) {
	b := &criteriaBuilder{}
	err = foreachField(x, b)
	return b.c, err
}
