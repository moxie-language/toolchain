// Simple file i/o and string manipulation, to avoid
// depending on strconv and bufio and strings.

package net

import (
	"github.com/moxie-language/toolchain/pkg/mxutil"
	"internal/bytealg"
	"io"
	"os"
	"time"
)

type parseFile struct {
	file  *os.File
	data  []byte
	atEOF bool
}

func (f *parseFile) close() { f.file.Close() }

func (f *parseFile) getLineFromData() (s string, ok bool) {
	data := f.data
	i := 0
	// Declared outside the loop: a declaration in the body of a self-mutating
	// method allocates in the sovereign arena on every iteration.
	var n int32
	for i = 0; i < len(data); i++ {
		if data[i] == '\n' {
			s = string(data[0:i])
			ok = true
			// move data
			i++
			n = len(data) - i
			mxutil.CopyFrom(data, data, i)
			f.data = data[0:n]
			return
		}
	}
	if f.atEOF && len(f.data) > 0 {
		// EOF, return all we have
		s = string(data)
		f.data = f.data[0:0]
		ok = true
	}
	return
}

func (f *parseFile) readLine() (s string, ok bool) {
	if s, ok = f.getLineFromData(); ok {
		return
	}
	if len(f.data) < cap(f.data) {
		ln := len(f.data)
		// resize, not a bounded sub-slice: ReadFullInto validates off+n against
		// len(dst), and f.data's length is the bytes already buffered, not the
		// room left. Passing f.data itself made every read answer
		// io.ErrShortBuffer with got=0, so readLine returned ok=false on the
		// first call and every /etc file this package parses came back empty -
		// /etc/hosts (no hosts-file name resolved, localhost included),
		// /etc/resolv.conf (DNS ran on the 127.0.0.1 default), and
		// /etc/nsswitch.conf (the lookup order silently took its fallback).
		n, err := io.ReadFullIntoN(f.file, resize(f.data, cap(f.data)), ln, cap(f.data)-ln)
		if n >= 0 {
			f.data = f.data[0 : ln+n]
		}
		if err == io.EOF || err == io.ErrUnexpectedEOF {
			f.atEOF = true
		}
	}
	s, ok = f.getLineFromData()
	return
}

func (f *parseFile) stat() (mtime time.Time, size int64, err error) {
	st, err := f.file.Stat()
	if err != nil {
		return time.Time{}, 0, err
	}
	return st.ModTime(), st.Size(), nil
}

func open(name string) (rparseFile *parseFile, rerr error) {
	fd, err := os.Open(name)
	if err != nil {
		return nil, err
	}
	return &parseFile{fd, []byte{:0:64*1024}, false}, nil
}

func stat(name string) (mtime time.Time, size int64, err error) {
	st, err := os.Stat(name)
	if err != nil {
		return time.Time{}, 0, err
	}
	return st.ModTime(), st.Size(), nil
}

// Count occurrences in s of any bytes in t.
func countAnyByte(s string, t string) (rn int32) {
	n := 0
	for i := 0; i < len(s); i++ {
		if bytealg.IndexByteString(t, s[i]) >= 0 {
			n++
		}
	}
	return n
}

// Split s at any bytes in t.
func splitAtBytes(s string, t string) (rbyte [][]byte) {
	a := [][]byte{:1+countAnyByte(s, t)}
	n := 0
	last := 0
	for i := 0; i < len(s); i++ {
		if bytealg.IndexByteString(t, s[i]) >= 0 {
			if last < i {
				a[n] = s[last:i]
				n++
			}
			last = i + 1
		}
	}
	if last < len(s) {
		a[n] = s[last:]
		n++
	}
	return a[0:n]
}

func getFields(s string) (rbyte [][]byte) { return splitAtBytes(s, " \r\t\n") }

// Bigger than we need, not too big to worry about overflow
const big = 0xFFFFFF

// Decimal to integer.
// Returns number, characters consumed, success.
func dtoi(s string) (n int32, i int32, ok bool) {
	n = 0
	for i = 0; i < len(s) && '0' <= s[i] && s[i] <= '9'; i++ {
		n = n*10 + int32(s[i]-'0')
		if n >= big {
			return big, i, false
		}
	}
	if i == 0 {
		return 0, 0, false
	}
	return n, i, true
}

// Hexadecimal to integer.
// Returns number, characters consumed, success.
func xtoi(s string) (n int32, i int32, ok bool) {
	n = 0
	for i = 0; i < len(s); i++ {
		if '0' <= s[i] && s[i] <= '9' {
			n *= 16
			n += int32(s[i] - '0')
		} else if 'a' <= s[i] && s[i] <= 'f' {
			n *= 16
			n += int32(s[i]-'a') + 10
		} else if 'A' <= s[i] && s[i] <= 'F' {
			n *= 16
			n += int32(s[i]-'A') + 10
		} else {
			break
		}
		if n >= big {
			return 0, i, false
		}
	}
	if i == 0 {
		return 0, i, false
	}
	return n, i, true
}

// xtoi2 converts the next two hex digits of s into a byte.
// If s is longer than 2 bytes then the third byte must be e.
// If the first two bytes of s are not hex digits or the third byte
// does not match e, false is returned.
func xtoi2(s string, e byte) (rn byte, rok bool) {
	if len(s) > 2 && s[2] != e {
		return 0, false
	}
	n, ei, ok := xtoi(s[:2])
	return byte(n), ok && ei == 2
}

// hasUpperCase tells whether the given string contains at least one upper-case.
func hasUpperCase(s string) (rok bool) {
	for i := range s {
		if 'A' <= s[i] && s[i] <= 'Z' {
			return true
		}
	}
	return false
}

// lowerASCIIBytes makes x ASCII lowercase in-place.
func lowerASCIIBytes(x []byte) {
	for i, b := range x {
		if 'A' <= b && b <= 'Z' {
			x[i] += 'a' - 'A'
		}
	}
}

// lowerASCII returns the ASCII lowercase version of b.
func lowerASCII(b byte) (rn byte) {
	if 'A' <= b && b <= 'Z' {
		return b + ('a' - 'A')
	}
	return b
}

// trimSpace returns x without any leading or trailing ASCII whitespace.
func trimSpace(x string) (rs string) {
	// One prefix slice for the leading run: a `x = x[1:]` per space is a copy
	// of the rest of the line.
	ip := int32(0)
	for ip < len(x) && isSpace(x[ip]) {
		ip++
	}
	if ip > 0 {
		x = x[ip:]
	}
	for len(x) > 0 && isSpace(x[len(x)-1]) {
		x = resize(x, len(x)-1)
	}
	return x
}

// isSpace reports whether b is an ASCII space character.
func isSpace(b byte) (rok bool) {
	return b == ' ' || b == '\t' || b == '\n' || b == '\r'
}

// removeComment returns line, removing any '#' byte and any following
// bytes.
func removeComment(line string) (rs string) {
	if i := bytealg.IndexByteString(line, '#'); i != -1 {
		return line[:i]
	}
	return line
}

// fieldSink receives each field. It is an interface rather than a func because
// the caller that accumulates fields has to MUTATE state: a closure that pushed
// onto a local slice is exactly the capture a Moxie function value cannot carry,
// so the state lives in the sink and foreachField calls it directly.
type fieldSink interface {
	add(field string) (err error)
}

// foreachField runs sink.add on each non-empty run of non-space bytes in x.
// It returns the first non-nil error.
func foreachField(x string, sink fieldSink) (rerr error) {
	x = trimSpace(x)
	for len(x) > 0 {
		sp := bytealg.IndexByteString(x, ' ')
		if sp == -1 {
			return sink.add(x)
		}
		if field := trimSpace(x[:sp]); len(field) > 0 {
			if err := sink.add(field); err != nil {
				return err
			}
		}
		x = trimSpace(x[sp+1:])
	}
	return nil
}

// stringsHasSuffixFold reports whether s ends in suffix,
// ASCII-case-insensitively.
func stringsHasSuffixFold(s, suffix string) (rok bool) {
	return len(s) >= len(suffix) && stringsEqualFold(s[len(s)-len(suffix):], suffix)
}

// stringsEqualFold is strings.EqualFold, ASCII only. It reports whether s and t
// are equal, ASCII-case-insensitively.
func stringsEqualFold(s, t string) (rok bool) {
	if len(s) != len(t) {
		return false
	}
	for i := 0; i < len(s); i++ {
		if lowerASCII(s[i]) != lowerASCII(t[i]) {
			return false
		}
	}
	return true
}
