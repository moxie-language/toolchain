//:build unix

package net

import (
	"internal/poll"
	"os"
	"syscall"
)

const _SO_TYPE = syscall.SO_TYPE

func dupFileSocket(f *os.File) (int32, error) {
	s, call, err2 := poll.DupCloseOnExec(int32(f.Fd()))
	if err2 != nil {
		if call != "" {
			err2 = os.NewSyscallError(call, err2)
		}
		return -1, err2
	}
	if err1 := syscall.SetNonblock(s, true); err1 != nil {
		syscall.Close(s)
		return -1, os.NewSyscallError("setnonblock", err1)
	}
	return s, nil
}
