//:build js

package net

import (
	"os"
	"syscall"
)

func fileConn(f *os.File) (rconn Conn, rerr error)             { return nil, syscall.ENOPROTOOPT }
func fileListener(f *os.File) (rlistener Listener, rerr error)     { return nil, syscall.ENOPROTOOPT }
func filePacketConn(f *os.File) (rpacketConn PacketConn, rerr error) { return nil, syscall.ENOPROTOOPT }
