// DNS client: see RFC 1035.
// Has to be linked into package net for Dial.

// TODO(rsc):
//	Could potentially handle many outstanding lookups faster.
//	Random UDP source port (net.Dial should do that for us).
//	Random request IDs.

package net

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"context"
	"errors"
	"internal/bytealg"
	"internal/itoa"
	"internal/stringslite"
	"io"
	"os"
	"time"

	"golang.org/x/net/dns/dnsmessage"
)

const (
	// to be used as a useTCP parameter to exchange
	useTCPOnly  = true
	useUDPOrTCP = false

	// Maximum DNS packet size.
	// Value taken from https://dnsflagday.net/2020/.
	maxDNSPacketSize = 1232
)


func errServerTemporarilyMisbehaving() (rerr error) { return &temporaryError{"server misbehaving"} }

func newRequest(q dnsmessage.Question, ad bool) (id uint16, udpReq, tcpReq []byte, err error) {
	id = uint16(randInt())
	b := dnsmessage.NewBuilder([]byte{:2:514}, dnsmessage.Header{ID: id, RecursionDesired: true, AuthenticData: ad})
	if err5 := b.StartQuestions(); err5 != nil {
		return 0, nil, nil, err5
	}
	if err4 := b.Question(q); err4 != nil {
		return 0, nil, nil, err4
	}

	// Always send EDNS0 additional header. Accept packets up to maxDNSPacketSize. RFC 6891.
	if err3 := b.StartAdditionals(); err3 != nil {
		return 0, nil, nil, err3
	}
	var rh dnsmessage.ResourceHeader
	if err2 := rh.SetEDNS0(maxDNSPacketSize, dnsmessage.RCodeSuccess, false); err2 != nil {
		return 0, nil, nil, err2
	}
	if err1 := b.OPTResource(rh, dnsmessage.OPTResource{}); err1 != nil {
		return 0, nil, nil, err1
	}

	tcpReq, err = b.Finish()
	if err != nil {
		return 0, nil, nil, err
	}
	udpReq = tcpReq[2:]
	l := len(tcpReq) - 2
	tcpReq[0] = byte(l >> 8)
	tcpReq[1] = byte(l)
	return id, udpReq, tcpReq, nil
}

func checkResponse(reqID uint16, reqQues dnsmessage.Question, respHdr dnsmessage.Header, respQues dnsmessage.Question) (rok bool) {
	if !respHdr.Response {
		return false
	}
	if reqID != respHdr.ID {
		return false
	}
	if reqQues.Type != respQues.Type || reqQues.Class != respQues.Class || !equalASCIIName(reqQues.Name, respQues.Name) {
		return false
	}
	return true
}

func dnsPacketRoundTrip(c Conn, id uint16, query dnsmessage.Question, b []byte) (rparser dnsmessage.Parser, rheader dnsmessage.Header, rerr error) {
	if _, err := c.Write(b); err != nil {
		return dnsmessage.Parser{}, dnsmessage.Header{}, err
	}

	b = []byte{:maxDNSPacketSize}
	for {
		n, err := c.Read(b)
		if err != nil {
			return dnsmessage.Parser{}, dnsmessage.Header{}, err
		}
		var p dnsmessage.Parser
		// Ignore invalid responses as they may be malicious
		// forgery attempts. Instead continue waiting until
		// timeout. See golang.org/issue/13281.
		h, err := p.Start(b[:n])
		if err != nil {
			continue
		}
		q, err := p.Question()
		if err != nil || !checkResponse(id, query, h, q) {
			continue
		}
		return p, h, nil
	}
}

func dnsStreamRoundTrip(c Conn, id uint16, query dnsmessage.Question, b []byte) (rparser dnsmessage.Parser, rheader dnsmessage.Header, rerr error) {
	if _, err5 := c.Write(b); err5 != nil {
		return dnsmessage.Parser{}, dnsmessage.Header{}, err5
	}

	b = []byte{:1280} // 1280 is a reasonable initial size for IP over Ethernet, see RFC 4035
	if _, err4 := io.ReadFull(c, b[:2]); err4 != nil {
		return dnsmessage.Parser{}, dnsmessage.Header{}, err4
	}
	l := int32(b[0])<<8 | int32(b[1])
	if l > len(b) {
		b = []byte{:l}
	}
	n, err3 := io.ReadFull(c, b[:l])
	if err3 != nil {
		return dnsmessage.Parser{}, dnsmessage.Header{}, err3
	}
	var p dnsmessage.Parser
	h, err2 := p.Start(b[:n])
	if err2 != nil {
		return dnsmessage.Parser{}, dnsmessage.Header{}, errCannotUnmarshalDNSMessage
	}
	q, err1 := p.Question()
	if err1 != nil {
		return dnsmessage.Parser{}, dnsmessage.Header{}, errCannotUnmarshalDNSMessage
	}
	if !checkResponse(id, query, h, q) {
		return dnsmessage.Parser{}, dnsmessage.Header{}, errInvalidDNSResponse
	}
	return p, h, nil
}

// exchange sends a query on the connection and hopes for a response.
func (r *Resolver) exchange(ctx context.Context, server string, q dnsmessage.Question, timeout time.Duration, useTCP, ad bool) (rparser dnsmessage.Parser, rheader dnsmessage.Header, rerr error) {
	q.Class = dnsmessage.ClassINET
	id, udpReq, tcpReq, err3 := newRequest(q, ad)
	if err3 != nil {
		return dnsmessage.Parser{}, dnsmessage.Header{}, errCannotMarshalDNSMessage
	}
	var networks [][]byte
	if useTCP {
		networks = [][]byte{"tcp"}
	} else {
		networks = [][]byte{"udp", "tcp"}
	}
	for _, network := range networks {
		ctx1, cancel := context.WithDeadline(ctx, time.Now().Add(timeout))
		defer cancel.Cancel()

		c, err2 := r.dial(ctx1, network, server)
		if err2 != nil {
			return dnsmessage.Parser{}, dnsmessage.Header{}, err2
		}
		if d, ok := ctx1.Deadline(); ok && !d.IsZero() {
			c.SetDeadline(d)
		}
		var p dnsmessage.Parser
		var h dnsmessage.Header
		if _, ok := c.(PacketConn); ok {
			p, h, err2 = dnsPacketRoundTrip(c, id, q, udpReq)
		} else {
			p, h, err2 = dnsStreamRoundTrip(c, id, q, tcpReq)
		}
		c.Close()
		if err2 != nil {
			return dnsmessage.Parser{}, dnsmessage.Header{}, mapErr(err2)
		}
		if err1 := p.SkipQuestion(); err1 != dnsmessage.ErrSectionDone {
			return dnsmessage.Parser{}, dnsmessage.Header{}, errInvalidDNSResponse
		}
		// RFC 5966 indicates that when a client receives a UDP response with
		// the TC flag set, it should take the TC flag as an indication that it
		// should retry over TCP instead.
		// The case when the TC flag is set in a TCP response is not well specified,
		// so this implements the glibc resolver behavior, returning the existing
		// dns response instead of returning a "errNoAnswerFromDNSServer" error.
		// See go.dev/issue/64896
		if h.Truncated && network == "udp" {
			continue
		}
		return p, h, nil
	}
	return dnsmessage.Parser{}, dnsmessage.Header{}, errNoAnswerFromDNSServer
}

// checkHeader performs basic sanity checks on the header.
func checkHeader(p *dnsmessage.Parser, h dnsmessage.Header) (rerr error) {
	rcode, hasAdd := extractExtendedRCode(*p, h)

	if rcode == dnsmessage.RCodeNameError {
		return errNoSuchHost()
	}

	_, err := p.AnswerHeader()
	if err != nil && err != dnsmessage.ErrSectionDone {
		return errCannotUnmarshalDNSMessage
	}

	// libresolv continues to the next server when it receives
	// an invalid referral response. See golang.org/issue/15434.
	if rcode == dnsmessage.RCodeSuccess && !h.Authoritative && !h.RecursionAvailable && err == dnsmessage.ErrSectionDone && !hasAdd {
		return errLameReferral
	}

	if rcode != dnsmessage.RCodeSuccess && rcode != dnsmessage.RCodeNameError {
		// None of the error codes make sense
		// for the query we sent. If we didn't get
		// a name error and we didn't get success,
		// the server is behaving incorrectly or
		// having temporary trouble.
		if rcode == dnsmessage.RCodeServerFailure {
			return errServerTemporarilyMisbehaving()
		}
		return errServerMisbehaving
	}

	return nil
}

func skipToAnswer(p *dnsmessage.Parser, qtype dnsmessage.Type) (rerr error) {
	for {
		h, err2 := p.AnswerHeader()
		if err2 == dnsmessage.ErrSectionDone {
			return errNoSuchHost()
		}
		if err2 != nil {
			return errCannotUnmarshalDNSMessage
		}
		if h.Type == qtype {
			return nil
		}
		if err1 := p.SkipAnswer(); err1 != nil {
			return errCannotUnmarshalDNSMessage
		}
	}
}

// extractExtendedRCode extracts the extended RCode from the OPT resource (EDNS(0))
// If an OPT record is not found, the RCode from the hdr is returned.
// Another return value indicates whether an additional resource was found.
func extractExtendedRCode(p dnsmessage.Parser, hdr dnsmessage.Header) (rrCode dnsmessage.RCode, rok bool) {
	p.SkipAllAnswers()
	p.SkipAllAuthorities()
	hasAdd := false
	for {
		ahdr, err2 := p.AdditionalHeader()
		if err2 != nil {
			return hdr.RCode, hasAdd
		}
		hasAdd = true
		if ahdr.Type == dnsmessage.TypeOPT {
			return ahdr.ExtendedRCode(hdr.RCode), hasAdd
		}
		if err1 := p.SkipAdditional(); err1 != nil {
			return hdr.RCode, hasAdd
		}
	}
}

// Do a lookup for a single name, which must be rooted
// (otherwise answer will not find the answers).
func (r *Resolver) tryOneName(ctx context.Context, cfg *dnsConfig, name string, qtype dnsmessage.Type) (rparser dnsmessage.Parser, rs string, rerr error) {
	var lastErr error
	serverOffset := cfg.serverOffset()
	sLen := uint32(len(cfg.servers))

	n, err4 := dnsmessage.NewName(name)
	if err4 != nil {
		return dnsmessage.Parser{}, "", &DNSError{Err: errCannotMarshalDNSMessage.String(), Name: name}
	}
	q := dnsmessage.Question{
		Name:  n,
		Type:  qtype,
		Class: dnsmessage.ClassINET,
	}

	for i := 0; i < cfg.attempts; i++ {
		for j := uint32(0); j < sLen; j++ {
			server := cfg.servers[(serverOffset+j)%sLen]

			p, h, err3 := r.exchange(ctx, server, q, cfg.timeout, cfg.useTCP, cfg.trustAD)
			if err3 != nil {
				dnsErr := newDNSError(err3, name, server)
				// Set IsTemporary for socket-level errors. Note that this flag
				// may also be used to indicate a SERVFAIL response.
				if _, ok := err3.(*OpError); ok {
					dnsErr.IsTemporary = true
				}
				lastErr = dnsErr
				continue
			}

			if err2 := checkHeader(&p, h); err2 != nil {
				if err2.String() == "no such host" {
					// The name does not exist, so trying
					// another server won't help.
					return p, server, newDNSError(errNoSuchHost(), name, server)
				}
				lastErr = newDNSError(err2, name, server)
				continue
			}

			if err1 := skipToAnswer(&p, qtype); err1 != nil {
				if err1.String() == "no such host" {
					// The name does not exist, so trying
					// another server won't help.
					return p, server, newDNSError(errNoSuchHost(), name, server)
				}
				lastErr = newDNSError(err1, name, server)
				continue
			}

			return p, server, nil
		}
	}
	return dnsmessage.Parser{}, "", lastErr
}

// A resolverConfig represents a DNS stub resolver configuration.
type resolverConfig struct {
	initDone bool // guards init of resolverConfig

	// ch is used as a semaphore that only allows one lookup at a
	// time to recheck resolv.conf.
	ch          chan struct{} // guards lastChecked and modTime
	lastChecked time.Time     // last time resolv.conf was checked

	dnsConfig *dnsConfig // parsed resolv.conf structure used in lookups
}

var resolvConf resolverConfig

func getSystemDNSConfig() (rdnsConfig *dnsConfig) {
	resolvConf.tryUpdate("/etc/resolv.conf")
	return resolvConf.dnsConfig
}

// init initializes conf and is only called via conf.initOnce.
func (conf *resolverConfig) init() {
	// Set dnsConfig and lastChecked so we don't parse
	// resolv.conf twice the first time.
	conf.dnsConfig = dnsReadConfig("/etc/resolv.conf")
	conf.lastChecked = time.Now()

	// Prepare ch so that only one update of resolverConfig may
	// run at once.
	conf.ch = chan struct{}{1}
}

// tryUpdate tries to update conf with the named resolv.conf file.
// The name variable only exists for testing. It is otherwise always
// "/etc/resolv.conf".
func (conf *resolverConfig) tryUpdate(name string) {
	if !conf.initDone { conf.initDone = true; conf.init() }

	if conf.dnsConfig.noReload {
		return
	}

	// Ensure only one update at a time checks resolv.conf.
	if !conf.tryAcquireSema() {
		return
	}
	defer conf.releaseSema()

	now := time.Now()
	if conf.lastChecked.After(now.Add(-5 * time.Second)) {
		return
	}
	conf.lastChecked = now

	var mtime time.Time
	if fi, err := os.Stat(name); err == nil {
		mtime = fi.ModTime()
	}
	if mtime.Equal(conf.dnsConfig.mtime) {
		return
	}

	dnsConf := dnsReadConfig(name)
	conf.dnsConfig = dnsConf
}

func (conf *resolverConfig) tryAcquireSema() (rok bool) {
	select {
	case conf.ch <- struct{}{}:
		return true
	default:
		return false
	}
}

func (conf *resolverConfig) releaseSema() {
	<-conf.ch
}

func (r *Resolver) lookup(ctx context.Context, name string, qtype dnsmessage.Type, conf *dnsConfig) (rparser dnsmessage.Parser, rs string, rerr error) {
	if !isDomainName(name) {
		// We used to use "invalid domain name" as the error,
		// but that is a detail of the specific lookup mechanism.
		// Other lookups might allow broader name syntax
		// (for example Multicast DNS allows UTF-8; see RFC 6762).
		// For consistency with libc resolvers, report no such host.
		return dnsmessage.Parser{}, "", newDNSError(errNoSuchHost(), name, "")
	}

	if conf == nil {
		conf = getSystemDNSConfig()
	}

	var (
		p      dnsmessage.Parser
		server string
		err    error
	)
	for _, fqdn := range conf.nameList(name) {
		p, server, err = r.tryOneName(ctx, conf, fqdn, qtype)
		if err == nil {
			break
		}
		if nerr, ok := err.(Error); ok && nerr.Temporary() && r.strictErrors() {
			// If we hit a temporary error with StrictErrors enabled,
			// stop immediately instead of trying more names.
			break
		}
	}
	if err == nil {
		return p, server, nil
	}
	if err1, ok := err.(*DNSError); ok {
		// Show original name passed to lookup, not suffixed one.
		// In general we might have tried many suffixes; showing
		// just one is misleading. See also golang.org/issue/6324.
		err1.Name = name
	}
	return dnsmessage.Parser{}, "", err
}

// avoidDNS reports whether this is a hostname for which we should not
// use DNS. Currently this includes only .onion, per RFC 7686. See
// golang.org/issue/13705. Does not cover .local names (RFC 6762),
// see golang.org/issue/16739.
func avoidDNS(name string) (rok bool) {
	if name == "" {
		return true
	}
	name = stringslite.TrimSuffix(name, ".")
	return stringsHasSuffixFold(name, ".onion")
}

// nameList returns a list of names for sequential DNS queries.
func (conf *dnsConfig) nameList(name string) (rbyte [][]byte) {
	// Check name length (see isDomainName).
	l := len(name)
	rooted := l > 0 && name[l-1] == '.'
	if l > 254 || l == 254 && !rooted {
		return nil
	}

	// If name is rooted (trailing dot), try only that name.
	if rooted {
		if avoidDNS(name) {
			return nil
		}
		return [][]byte{name}
	}

	hasNdots := bytealg.CountString(name, '.') >= conf.ndots
	name += "."
	l++

	// Build list of search choices.
	names := [][]byte{:0:1+len(conf.search)}
	// If name has enough dots, try unsuffixed first.
	if hasNdots && !avoidDNS(name) {
		names = mxutil.Ensure(names, 1)
		names = push(names, name)
	}
	// Try suffixes that are not too long (see isDomainName).
	for _, suffix := range conf.search {
		fqdn := name + suffix
		if !avoidDNS(fqdn) && len(fqdn) <= 254 {
			names = mxutil.Ensure(names, 1)
			names = push(names, fqdn)
		}
	}
	// Try unsuffixed, if not tried first above.
	if !hasNdots && !avoidDNS(name) {
		names = mxutil.Ensure(names, 1)
		names = push(names, name)
	}
	return names
}

// hostLookupOrder specifies the order of LookupHost lookup strategies.
// It is basically a simplified representation of nsswitch.conf.
// "files" means /etc/hosts.
type hostLookupOrder int32

const (
	// hostLookupCgo means defer to cgo.
	hostLookupCgo      hostLookupOrder = iota
	hostLookupFilesDNS                 // files first
	hostLookupDNSFiles                 // dns first
	hostLookupFiles                    // only files
	hostLookupDNS                      // only DNS
)

func _lookupOrderName() (rm map[hostLookupOrder]string) {
	return map[hostLookupOrder]string{
		hostLookupCgo:      "cgo",
		hostLookupFilesDNS: "files,dns",
		hostLookupDNSFiles: "dns,files",
		hostLookupFiles:    "files",
		hostLookupDNS:      "dns",
	}
}

func (o *hostLookupOrder) String() (rs string) {
	m := _lookupOrderName()
	if s, ok := m[*o]; ok {
		return s
	}
	return "hostLookupOrder=" + itoa.Itoa(int32(*o)) + "??"
}

func (r *Resolver) goLookupHostOrder(ctx context.Context, name string, order hostLookupOrder, conf *dnsConfig) (addrs [][]byte, err error) {
	if order == hostLookupFilesDNS || order == hostLookupFiles {
		// Use entries from /etc/hosts if they match.
		addrs, _ = lookupStaticHost(name)
		if len(addrs) > 0 {
			return
		}

		if order == hostLookupFiles {
			return nil, newDNSError(errNoSuchHost(), name, "")
		}
	}
	ips, _, err := r.goLookupIPCNAMEOrder(ctx, "ip", name, order, conf)
	if err != nil {
		// dnsmessage-based resolver failed - fall back to raw UDP DNS.
		if raw := rawLookupHost(name); len(raw) > 0 {
			return raw, nil
		}
		return
	}
	addrs = [][]byte{:0:len(ips)}
	for _, ip := range ips {
		addrs = mxutil.Ensure(addrs, 1)
		addrs = push(addrs, ip.String())
	}
	return
}

// lookup entries from /etc/hosts
func goLookupIPFiles(name string) (addrs []IPAddr, canonical string) {
	addr2, canonical := lookupStaticHost(name)
	for _, haddr2 := range addr2 {
		haddr1, zone := splitHostZone(haddr2)
		if ip := ParseIP(haddr1); ip != nil {
			addr1 := IPAddr{IP: ip, Zone: zone}
			addrs = mxutil.Ensure(addrs, 1)
			addrs = push(addrs, addr1)
		}
	}
	sortByRFC6724(addrs)
	return addrs, canonical
}

// goLookupIP is the native Go implementation of LookupIP.
// The libc versions are in cgo_*.go.
func (r *Resolver) goLookupIP(ctx context.Context, network, host string, order hostLookupOrder, conf *dnsConfig) (addrs []IPAddr, err error) {
	addrs, _, err = r.goLookupIPCNAMEOrder(ctx, network, host, order, conf)
	return
}

func (r *Resolver) goLookupIPCNAMEOrder(ctx context.Context, network, name string, order hostLookupOrder, conf *dnsConfig) (addrs []IPAddr, cname dnsmessage.Name, err error) {
	if order == hostLookupFilesDNS || order == hostLookupFiles {
		var canonical string
		addrs, canonical = goLookupIPFiles(name)

		if len(addrs) > 0 {
			var err7 error
			cname, err7 = dnsmessage.NewName(canonical)
			if err7 != nil {
				return nil, dnsmessage.Name{}, err7
			}
			return addrs, cname, nil
		}

		if order == hostLookupFiles {
			return nil, dnsmessage.Name{}, newDNSError(errNoSuchHost(), name, "")
		}
	}

	if !isDomainName(name) {
		// See comment in func lookup above about use of errNoSuchHost.
		return nil, dnsmessage.Name{}, newDNSError(errNoSuchHost(), name, "")
	}
	type result struct {
		p      dnsmessage.Parser
		server string
		error
	}

	if conf == nil {
		conf = getSystemDNSConfig()
	}

	qtypes := []dnsmessage.Type{dnsmessage.TypeA, dnsmessage.TypeAAAA}
	if network == "CNAME" {
		qtypes = mxutil.Ensure(qtypes, 1)
		qtypes = push(qtypes, dnsmessage.TypeCNAME)
	}
	switch ipVersion(network) {
	case '4':
		qtypes = []dnsmessage.Type{dnsmessage.TypeA}
	case '6':
		qtypes = []dnsmessage.Type{dnsmessage.TypeAAAA}
	}
	// The Go original routes these through queryFn/responseFn closures for
	// httptrace. Moxie closures do not capture the enclosing scope, and the
	// trace hooks have no context value bag to arrive through, so call the
	// resolver directly.
	var lastErr2 error
	for _, fqdn := range conf.nameList(name) {
		hitStrictError := false
		for _, qtype := range qtypes {
			p, server, rerr := r.tryOneName(ctx, conf, fqdn, qtype)
			res := result{p, server, rerr}
			if res.error != nil {
				if nerr, ok := res.error.(Error); ok && nerr.Temporary() && r.strictErrors() {
					// This error will abort the nameList loop.
					hitStrictError = true
					lastErr2 = res.error
				} else if lastErr2 == nil || fqdn == name+"." {
					// Prefer error for original name.
					lastErr2 = res.error
				}
				continue
			}

			// Presotto says it's okay to assume that servers listed in
			// /etc/resolv.conf are recursive resolvers.
			//
			// We asked for recursion, so it should have included all the
			// answers we need in this one packet.
			//
			// Further, RFC 1034 section 4.3.1 says that "the recursive
			// response to a query will be... The answer to the query,
			// possibly preface by one or more CNAME RRs that specify
			// aliases encountered on the way to an answer."
			//
			// Therefore, we should be able to assume that we can ignore
			// CNAMEs and that the A and AAAA records we requested are
			// for the canonical name.

		loop:
			for {
				h, err6 := res.p.AnswerHeader()
				if err6 != nil && err6 != dnsmessage.ErrSectionDone {
					lastErr2 = &DNSError{
						Err:    errCannotUnmarshalDNSMessage.String(),
						Name:   name,
						Server: res.server,
					}
				}
				if err6 != nil {
					break
				}
				switch h.Type {
				case dnsmessage.TypeA:
					a, err4 := res.p.AResource()
					if err4 != nil {
						lastErr2 = &DNSError{
							Err:    errCannotUnmarshalDNSMessage.String(),
							Name:   name,
							Server: res.server,
						}
						break loop
					}
					addrs = mxutil.Ensure(addrs, 1)
					addrs = push(addrs, IPAddr{IP: IP(a.A[:])})
					if cname.Length == 0 && h.Name.Length != 0 {
						cname = h.Name
					}

				case dnsmessage.TypeAAAA:
					aaaa, err3 := res.p.AAAAResource()
					if err3 != nil {
						lastErr2 = &DNSError{
							Err:    errCannotUnmarshalDNSMessage.String(),
							Name:   name,
							Server: res.server,
						}
						break loop
					}
					addrs = mxutil.Ensure(addrs, 1)
					addrs = push(addrs, IPAddr{IP: IP(aaaa.AAAA[:])})
					if cname.Length == 0 && h.Name.Length != 0 {
						cname = h.Name
					}

				case dnsmessage.TypeCNAME:
					c, err2 := res.p.CNAMEResource()
					if err2 != nil {
						lastErr2 = &DNSError{
							Err:    errCannotUnmarshalDNSMessage.String(),
							Name:   name,
							Server: res.server,
						}
						break loop
					}
					if cname.Length == 0 && c.CNAME.Length > 0 {
						cname = c.CNAME
					}

				default:
					if err1 := res.p.SkipAnswer(); err1 != nil {
						lastErr2 = &DNSError{
							Err:    errCannotUnmarshalDNSMessage.String(),
							Name:   name,
							Server: res.server,
						}
						break loop
					}
					continue
				}
			}
		}
		if hitStrictError {
			// If either family hit an error with StrictErrors enabled,
			// discard all addresses. This ensures that network flakiness
			// cannot turn a dualstack hostname IPv4/IPv6-only.
			addrs = nil
			break
		}
		if len(addrs) > 0 || network == "CNAME" && cname.Length > 0 {
			break
		}
	}
	if lastErr1, ok := lastErr2.(*DNSError); ok {
		// Show original name passed to lookup, not suffixed one.
		// In general we might have tried many suffixes; showing
		// just one is misleading. See also golang.org/issue/6324.
		lastErr1.Name = name
	}
	sortByRFC6724(addrs)
	if len(addrs) == 0 && !(network == "CNAME" && cname.Length > 0) {
		if order == hostLookupDNSFiles {
			var canonical string
			addrs, canonical = goLookupIPFiles(name)
			if len(addrs) > 0 {
				var err5 error
				cname, err5 = dnsmessage.NewName(canonical)
				if err5 != nil {
					return nil, dnsmessage.Name{}, err5
				}
				return addrs, cname, nil
			}
		}
		if lastErr2 != nil {
			return nil, dnsmessage.Name{}, lastErr2
		}
	}
	return addrs, cname, nil
}

// goLookupCNAME is the native Go (non-cgo) implementation of LookupCNAME.
func (r *Resolver) goLookupCNAME(ctx context.Context, host string, order hostLookupOrder, conf *dnsConfig) (rs string, rerr error) {
	_, cname, err := r.goLookupIPCNAMEOrder(ctx, "CNAME", host, order, conf)
	return cname.String(), err
}

// goLookupPTR is the native Go implementation of LookupAddr.
func (r *Resolver) goLookupPTR(ctx context.Context, addr string, order hostLookupOrder, conf *dnsConfig) (rbyte [][]byte, rerr error) {
	if order == hostLookupFiles || order == hostLookupFilesDNS {
		names := lookupStaticAddr(addr)
		if len(names) > 0 {
			return names, nil
		}

		if order == hostLookupFiles {
			return nil, newDNSError(errNoSuchHost(), addr, "")
		}
	}

	arpa, err5 := reverseaddr(addr)
	if err5 != nil {
		return nil, err5
	}
	p, server, err4 := r.lookup(ctx, arpa, dnsmessage.TypePTR, conf)
	if err4 != nil {
		if dnsErr, ok := err4.(*DNSError); ok && dnsErr.IsNotFound {
			if order == hostLookupDNSFiles {
				names := lookupStaticAddr(addr)
				if len(names) > 0 {
					return names, nil
				}
			}
		}
		return nil, err4
	}
	var ptrs [][]byte
	for {
		h, err3 := p.AnswerHeader()
		if err3 == dnsmessage.ErrSectionDone {
			break
		}
		if err3 != nil {
			return nil, &DNSError{
				Err:    errCannotUnmarshalDNSMessage.String(),
				Name:   addr,
				Server: server,
			}
		}
		if h.Type != dnsmessage.TypePTR {
			err1 := p.SkipAnswer()
			if err1 != nil {
				return nil, &DNSError{
					Err:    errCannotUnmarshalDNSMessage.String(),
					Name:   addr,
					Server: server,
				}
			}
			continue
		}
		ptr, err2 := p.PTRResource()
		if err2 != nil {
			return nil, &DNSError{
				Err:    errCannotUnmarshalDNSMessage.String(),
				Name:   addr,
				Server: server,
			}
		}
		ptrs = mxutil.Ensure(ptrs, 1)
		ptrs = push(ptrs, ptr.PTR.String())

	}

	return ptrs, nil
}

var ErrWriteToConnected error
var errCannotMarshalDNSMessage error
var errCannotUnmarshalDNSMessage error
var errInvalidDNSResponse error
var errInvalidInterface error
var errInvalidInterfaceIndex error
var errInvalidInterfaceName error
var errLameReferral error
var errMissingAddress error
var errNoAnswerFromDNSServer error
var errNoSuchInterface error
var errNoSuchMulticastInterface error
var errNoSuitableAddress error
var errServerMisbehaving error
func init() {
	errInvalidInterface = errors.New("invalid network interface")
	errInvalidInterfaceIndex = errors.New("invalid network interface index")
	errInvalidInterfaceName = errors.New("invalid network interface name")
	errNoSuchInterface = errors.New("no such network interface")
	errNoSuchMulticastInterface = errors.New("no such multicast network interface")
	errLameReferral = errors.New("lame referral")
	errCannotUnmarshalDNSMessage = errors.New("cannot unmarshal DNS message")
	errCannotMarshalDNSMessage = errors.New("cannot marshal DNS message")
	errServerMisbehaving = errors.New("server misbehaving")
	errInvalidDNSResponse = errors.New("invalid DNS response")
	errNoAnswerFromDNSServer = errors.New("no answer from DNS server")
	errNoSuitableAddress = errors.New("no suitable address found")
	errMissingAddress = errors.New("missing address")
	ErrWriteToConnected = errors.New("use of WriteTo with pre-connected connection")
}
