//:build !linux

// spliceFrom and spliceTo report that splice is unavailable, mirroring
// $GOROOT/src/net/splice_stub.go. The real implementation lives in
// splice_linux.mx, which the `_linux` filename suffix restricts to linux, so
// this stub is what every other target - js/wasm included - compiles.
package net

import (
	"io"
)

func spliceFrom(c *netFD, r io.Reader) (written int64, err error, handled bool) {
	return 0, nil, false
}

func spliceTo(w io.Writer, c *netFD) (written int64, err error, handled bool) {
	return 0, nil, false
}
