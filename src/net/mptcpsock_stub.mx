//:build !linux

// Multipath TCP is a linux-only feature; this stub mirrors
// $GOROOT/src/net/mptcpsock_stub.go, which is what every other target compiles
// (the real one is mptcpsock_linux.mx, restricted to linux by the `_linux`
// filename suffix). Without it, js/wasm reported `undefined:
// isUsingMultipathTCP` and `dialMPTCP`/`listenMPTCP` were missing too.
package net

import (
	"context"
)

func (sd *sysDialer) dialMPTCP(ctx context.Context, laddr, raddr *TCPAddr) (rconn *TCPConn, rerr error) {
	return sd.dialTCP(ctx, laddr, raddr)
}

func (sl *sysListener) listenMPTCP(ctx context.Context, laddr *TCPAddr) (rln *TCPListener, rerr error) {
	return sl.listenTCP(ctx, laddr)
}

func isUsingMultipathTCP(fd *netFD) (ok bool) {
	return false
}
