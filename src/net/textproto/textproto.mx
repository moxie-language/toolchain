// Package textproto implements generic support for text-based request/response
// protocols in the style of HTTP, NNTP, and SMTP.
//
// This package enforces the HTTP/1.1 character set defined by
// RFC 9112 for header keys and values.
//
// The package provides:
//
// [Error], which represents a numeric error response from
// a server.
//
// [Pipeline], to manage pipelined requests and responses
// in a client.
//
// [Reader], to read numeric response code lines,
// key: value headers, lines wrapped with leading spaces
// on continuation lines, and whole text blocks ending
// with a dot on a line by itself.
//
// [Writer], to write dot-encoded text blocks.
//
// [Conn], a convenient packaging of [Reader], [Writer], and [Pipeline] for use
// with a single network connection.
package textproto

import (
	"bufio"
	"fmt"
	"io"
)

// An Error represents a numeric error response from a server.
type Error struct {
	Code int32
	Msg  []byte
}

func (e *Error) Error() (rs string) {
	return fmt.Sprintf("%03d %s", e.Code, e.Msg)
}

func (e *Error) String() (rs string) { return e.Error() }

// A ProtocolError describes a protocol violation such
// as an invalid response or a hung-up connection. It is a struct rather than
// a named []byte because it must satisfy error, and an alias to []byte cannot
// carry methods.
type ProtocolError struct {
	Msg []byte
}

func (p *ProtocolError) Error() (rs string) { return string(p.Msg) }
func (p *ProtocolError) String() (rs string) { return p.Error() }

// A Conn represents a textual network protocol connection.
// It consists of a [Reader] and [Writer] to manage I/O
// and a [Pipeline] to sequence concurrent requests on the connection.
// These embedded types carry methods with them;
// see the documentation of those types for details.
type Conn struct {
	Reader
	Writer
	Pipeline
	conn io.ReadWriteCloser
}

// NewConn returns a new [Conn] using conn for I/O.
func NewConn(conn io.ReadWriteCloser) (rconn *Conn) {
	return &Conn{
		Reader: Reader{R: bufio.NewReader(conn)},
		Writer: Writer{W: bufio.NewWriter(conn)},
		conn:   conn,
	}
}

// Close closes the connection.
func (c *Conn) Close() (rerr error) {
	return c.conn.Close()
}

// Dial is not available in Moxie - use raw TCP connection instead.

// Cmd is not available in Moxie - use direct protocol methods instead.

// TrimString returns s without leading and trailing ASCII space.
func TrimString(s []byte) (rb []byte) {
	for len(s) > 0 && isASCIISpace(s[0]) {
		s = s[1:]
	}
	for len(s) > 0 && isASCIISpace(s[len(s)-1]) {
		s = resize(s, len(s)-1)
	}
	return s
}

// TrimBytes returns b without leading and trailing ASCII space.
func TrimBytes(b []byte) (rb []byte) {
	for len(b) > 0 && isASCIISpace(b[0]) {
		b = b[1:]
	}
	for len(b) > 0 && isASCIISpace(b[len(b)-1]) {
		b = resize(b, len(b)-1)
	}
	return b
}

func isASCIISpace(b byte) (rok bool) {
	return b == ' ' || b == '\t' || b == '\n' || b == '\r'
}

func isASCIILetter(b byte) (rok bool) {
	b |= 0x20 // make lower case
	return 'a' <= b && b <= 'z'
}
