import "unsafe"

const (
	_SYS_setgroups  = SYS_SETGROUPS
	_SYS_clone3     = 435
	_SYS_faccessat2 = 439
	_SYS_fchmodat2  = 452
)

//sys	EpollWait(epfd int32, events []EpollEvent, msec int32) (n int32, err error) = SYS_EPOLL_PWAIT
