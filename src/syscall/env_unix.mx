//:build unix

// Unix environment variables.

package syscall

import "git.smesh.lol/moxie/pkg/mxutil"

// envStore holds the mutable environment table. It is a self-mutating type so
// that Setenv/Unsetenv/Clearenv write through its methods instead of storing
// into package globals after init.
type envStore struct {
	env  map[string]int32
	envs []string
}

var envsHolder *envStore

func runtime_envs() (rss []string) // in package runtime

var envsLoaded bool

func initEnvs() {
	if !envsLoaded {
		envsLoaded = true
		envsHolder.envs = runtime_envs()
	}
}

var copyenvDone bool

func initCopyenv() {
	if copyenvDone {
		return
	}
	copyenvDone = true
	initEnvs()
	envsHolder.env = map[string]int32{}
	for i, s := range envsHolder.envs {
		for j := 0; j < len(s); j++ {
			if s[j] == '=' {
				key := s[:j]
				if _, ok := envsHolder.env[key]; !ok {
					envsHolder.env[key] = i // first mention of key
				} else {
					// Clear duplicate keys. This permits Unsetenv to
					// safely delete only the first item without
					// worrying about unshadowing a later one,
					// which might be a security problem.
					envsHolder.envs[i] = ""
				}
				break
			}
		}
	}
}

func Unsetenv(key string) (rerr error) {
	initCopyenv()

	if i, ok := envsHolder.env[key]; ok {
		envsHolder.envs[i] = ""
		delete(envsHolder.env, key)
	}
	runtimeUnsetenv(key)
	return nil
}

func Getenv(key string) (value string, found bool) {
	initCopyenv()
	if len(key) == 0 {
		return "", false
	}

	i, ok := envsHolder.env[key]
	if !ok {
		return "", false
	}
	s := envsHolder.envs[i]
	for j := 0; j < len(s); j++ {
		if s[j] == '=' {
			return s[j+1:], true
		}
	}
	return "", false
}

func Setenv(key, value string) (rerr error) {
	initCopyenv()
	if len(key) == 0 {
		return EINVAL
	}
	for ki := 0; ki < len(key); ki++ {
		if key[ki] == '=' || key[ki] == 0 {
			return EINVAL
		}
	}
	for vi := 0; vi < len(value); vi++ {
		if value[vi] == 0 {
			return EINVAL
		}
	}

	i, ok := envsHolder.env[key]
	kv := key | "=" | value
	if ok {
		envsHolder.envs[i] = kv
	} else {
		i = len(envsHolder.envs)
		envsHolder.envs = mxutil.Ensure(envsHolder.envs, 1)
		envsHolder.envs = push(envsHolder.envs, kv)
	}
	envsHolder.env[key] = i
	runtimeSetenv(key, value)
	return nil
}

func Clearenv() {
	initCopyenv()

	for k := range envsHolder.env {
		runtimeUnsetenv(k)
	}
	envsHolder.env = map[string]int32{}
	envsHolder.envs = []string{}
}

func Environ() (rss []string) {
	initCopyenv()
	a := []string{:0:len(envsHolder.envs)}
	for _, e := range envsHolder.envs {
		if e != "" {
			a = mxutil.Ensure(a, 1)
			a = push(a, e)
		}
	}
	return a
}
