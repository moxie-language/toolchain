//:build unix

// Unix environment variables.

package syscall

import "git.smesh.lol/moxie/pkg/mxutil"

var (
	env  map[string]int32
	envs []string
)

func runtime_envs() []string // in package runtime

var envsLoaded bool

func loadenvs() {
	if !envsLoaded {
		envsLoaded = true
		envs = runtime_envs()
	}
}

var copyenvDone bool

func copyenv() {
	if copyenvDone {
		return
	}
	copyenvDone = true
	loadenvs()
	env = map[string]int32{}
	for i, s := range envs {
		for j := 0; j < len(s); j++ {
			if s[j] == '=' {
				key := s[:j]
				if _, ok := env[key]; !ok {
					env[key] = i // first mention of key
				} else {
					// Clear duplicate keys. This permits Unsetenv to
					// safely delete only the first item without
					// worrying about unshadowing a later one,
					// which might be a security problem.
					envs[i] = ""
				}
				break
			}
		}
	}
}

func Unsetenv(key string) error {
	copyenv()

	if i, ok := env[key]; ok {
		envs[i] = ""
		delete(env, key)
	}
	runtimeUnsetenv(key)
	return nil
}

func Getenv(key string) (value string, found bool) {
	copyenv()
	if len(key) == 0 {
		return "", false
	}

	i, ok := env[key]
	if !ok {
		return "", false
	}
	s := envs[i]
	for i := 0; i < len(s); i++ {
		if s[i] == '=' {
			return s[i+1:], true
		}
	}
	return "", false
}

func Setenv(key, value string) error {
	copyenv()
	if len(key) == 0 {
		return EINVAL
	}
	for i := 0; i < len(key); i++ {
		if key[i] == '=' || key[i] == 0 {
			return EINVAL
		}
	}
	for i := 0; i < len(value); i++ {
		if value[i] == 0 {
			return EINVAL
		}
	}

	i, ok := env[key]
	kv := key | "=" | value
	if ok {
		envs[i] = kv
	} else {
		i = len(envs)
		if len(envs) >= cap(envs) { envs = mxutil.GrowCap(envs) }
		envs = push(envs, kv)
	}
	env[key] = i
	runtimeSetenv(key, value)
	return nil
}

func Clearenv() {
	copyenv()

	for k := range env {
		runtimeUnsetenv(k)
	}
	env = map[string]int32{}
	envs = []string{}
}

func Environ() []string {
	copyenv()
	a := []string{:0:len(envs)}
	for _, env := range envs {
		if env != "" {
			if len(a) >= cap(a) { a = mxutil.GrowCap(a) }
			a = push(a, env)
		}
	}
	return a
}
