//:build linux

package syscall

// forkExecPipe atomically opens a pipe with O_CLOEXEC set on both file
// descriptors.
func forkExecPipe(p []int32) (rerr error) {
	return Pipe2(p, O_CLOEXEC)
}

// acquireForkLock is a no-op in single-threaded Moxie.
func acquireForkLock() {}

// releaseForkLock is a no-op in single-threaded Moxie.
func releaseForkLock() {}
