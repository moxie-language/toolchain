// Linux system calls.
// This file is compiled as ordinary Go code,
// but it is also input to mksyscall,
// which parses the //sys lines and generates system call stubs.
// Note that sometimes we use a lowercase //sys name and
// wrap it in our own nicer implementation.

package syscall

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"internal/itoa"
	runtimesyscall "internal/runtime/syscall"
	"unsafe"
)

// Pull in entersyscall/exitsyscall for Syscall/Syscall6.
//
// Note that this can't be a push linkname because the runtime already has a
// nameless linkname to export to assembly here and in x/sys. Additionally,
// entersyscall fetches the caller PC and SP and thus can't have a wrapper
// inbetween.

//:linkname runtime_entersyscall runtime.entersyscall
func runtime_entersyscall()

//:linkname runtime_exitsyscall runtime.exitsyscall
func runtime_exitsyscall()

// N.B. For the Syscall functions below:
//
// //:uintptrkeepalive because the uintptr argument may be converted pointers
// that need to be kept alive in the caller.
//
// //:nosplit because stack copying does not account for uintptrkeepalive, so
// the stack must not grow. Stack copying cannot blindly assume that all
// uintptr arguments are pointers, because some values may look like pointers,
// but not really be pointers, and adjusting their value would break the call.
//
// //:norace, on RawSyscall, to avoid race instrumentation if RawSyscall is
// called after fork, or from a signal handler.
//
// //:linkname to ensure ABI wrappers are generated for external callers
// (notably x/sys/unix assembly).

//:uintptrkeepalive
//:nosplit
//:norace
//:linkname RawSyscall
func RawSyscall(trap, a1, a2, a3 uintptr) (r1, r2 uintptr, err Errno) {
	return RawSyscall6(trap, a1, a2, a3, 0, 0, 0)
}

//:uintptrkeepalive
//:nosplit
//:norace
//:linkname RawSyscall6
func RawSyscall6(trap, a1, a2, a3, a4, a5, a6 uintptr) (r1, r2 uintptr, err Errno) {
	var errno uintptr
	r1, r2, errno = runtimesyscall.Syscall6(trap, a1, a2, a3, a4, a5, a6)
	err = Errno(errno)
	return
}

//:uintptrkeepalive
//:nosplit
//:linkname Syscall
func Syscall(trap, a1, a2, a3 uintptr) (r1, r2 uintptr, err Errno) {
	runtime_entersyscall()
	// N.B. Calling RawSyscall here is unsafe with atomic coverage
	// instrumentation and race mode.
	//
	// Coverage instrumentation will add a sync/atomic call to RawSyscall.
	// Race mode will add race instrumentation to sync/atomic. Race
	// instrumentation requires a P, which we no longer have.
	//
	// RawSyscall6 is fine because it is implemented in assembly and thus
	// has no coverage instrumentation.
	//
	// This is typically not a problem in the runtime because cmd/go avoids
	// adding coverage instrumentation to the runtime in race mode.
	r1, r2, err = RawSyscall6(trap, a1, a2, a3, 0, 0, 0)
	runtime_exitsyscall()
	return
}

//:uintptrkeepalive
//:nosplit
//:linkname Syscall6
func Syscall6(trap, a1, a2, a3, a4, a5, a6 uintptr) (r1, r2 uintptr, err Errno) {
	runtime_entersyscall()
	r1, r2, err = RawSyscall6(trap, a1, a2, a3, a4, a5, a6)
	runtime_exitsyscall()
	return
}

func rawSyscallNoError(trap, a1, a2, a3 uintptr) (r1, r2 uintptr) {
	r1, r2, _ = RawSyscall6(trap, a1, a2, a3, 0, 0, 0)
	return
}

func rawVforkSyscall(trap, a1, a2, a3 uintptr) (r1 uintptr, err Errno) {
	r1, _, err = RawSyscall6(trap, a1, a2, a3, 0, 0, 0)
	return
}

/*
 * Wrapped
 */

func Access(path string, mode uint32) (err error) {
	return Faccessat(_AT_FDCWD, path, mode, 0)
}

func Chmod(path string, mode uint32) (err error) {
	return Fchmodat(_AT_FDCWD, path, mode, 0)
}

func Chown(path string, uid int32, gid int32) (err error) {
	return Fchownat(_AT_FDCWD, path, uid, gid, 0)
}

func Creat(path string, mode uint32) (fd int32, err error) {
	return Open(path, O_CREAT|O_WRONLY|O_TRUNC, mode)
}

func EpollCreate(size int32) (fd int32, err error) {
	if size <= 0 {
		return -1, EINVAL
	}
	return EpollCreate1(0)
}

func isGroupMember(gid int32) (rok bool) {
	groups, err := Getgroups()
	if err != nil {
		return false
	}

	for _, g := range groups {
		if g == gid {
			return true
		}
	}
	return false
}

// SysProcAttr is accepted by os.ProcAttr for API compatibility. Fork/exec
// via syscall was removed; os/exec_linux.mx rejects a non-nil Sys.
type SysProcAttr struct{}

// Capability structures for capget; see linux/capability.h.
// (Previously in exec_linux.mx, which is no longer compiled.)
const _LINUX_CAPABILITY_VERSION_3 = 0x20080522

type capHeader struct {
	version uint32
	pid     int32
}

// capget wants a header and, behind it, two __user_cap_data_struct: each is
// {effective, permitted, inheritable} as three 32-bit words. That is 24 bytes
// at fixed offsets, so it is a buffer read through windows - an `[2]capData`
// field would be two slice headers where the kernel writes words.
const (
	capDataSize      = 12
	capDataEffective = 0
)

// See CAP_TO_MASK in linux/capability.h:
func capToMask(capv uintptr) (rn uint32) { return 1 << uint32(capv&31) }

func isCapDacOverrideSet() (rok bool) {
	const _CAP_DAC_OVERRIDE = 1
	var hdr capHeader
	hdr.version = _LINUX_CAPABILITY_VERSION_3
	data := []byte{:2 * capDataSize}

	_, _, err := RawSyscall(SYS_CAPGET, uintptr(unsafe.Pointer(&hdr)), uintptr(abiBufferOf(data)), 0)

	return err == 0 && abiGet32(data, capDataEffective)&capToMask(_CAP_DAC_OVERRIDE) != 0
}

//sys	faccessat(dirfd int32, path string, mode uint32) (err error)
//sys	faccessat2(dirfd int32, path string, mode uint32, flags int32) (err error) = _SYS_faccessat2

func Faccessat(dirfd int32, path string, mode uint32, flags int32) (err error) {
	if flags == 0 {
		return faccessat(dirfd, path, mode)
	}

	// Attempt to use the newer faccessat2, which supports flags directly,
	// falling back if it doesn't exist.
	if aerr := faccessat2(dirfd, path, mode, flags); aerr != ENOSYS && aerr != EPERM {
		return aerr
	}

	// The Linux kernel faccessat system call does not take any flags.
	// The glibc faccessat implements the flags itself; see
	// https://sourceware.org/git/?p=glibc.git;a=blob;f=sysdeps/unix/sysv/linux/faccessat.c;hb=HEAD
	// Because people naturally expect syscall.Faccessat to act
	// like C faccessat, we do the same.

	if flags & ^(_AT_SYMLINK_NOFOLLOW|_AT_EACCESS) != 0 {
		return EINVAL
	}

	var st Stat_t
	if ferr := fstatat(dirfd, path, &st, flags&_AT_SYMLINK_NOFOLLOW); ferr != nil {
		return ferr
	}

	mode &= 7
	if mode == 0 {
		return nil
	}

	// Fallback to checking permission bits.
	var uid int32
	if flags&_AT_EACCESS != 0 {
		uid = Geteuid()
		if uid != 0 && isCapDacOverrideSet() {
			// If CAP_DAC_OVERRIDE is set, file access check is
			// done by the kernel in the same way as for root
			// (see generic_permission() in the Linux sources).
			uid = 0
		}
	} else {
		uid = Getuid()
	}

	if uid == 0 {
		if mode&1 == 0 {
			// Root can read and write any file.
			return nil
		}
		if st.Mode&0111 != 0 {
			// Root can execute any file that anybody can execute.
			return nil
		}
		return EACCES
	}

	var fmode uint32
	if uint32(uid) == st.Uid {
		fmode = (st.Mode >> 6) & 7
	} else {
		var gid int32
		if flags&_AT_EACCESS != 0 {
			gid = Getegid()
		} else {
			gid = Getgid()
		}

		if uint32(gid) == st.Gid || isGroupMember(int32(st.Gid)) {
			fmode = (st.Mode >> 3) & 7
		} else {
			fmode = st.Mode & 7
		}
	}

	if fmode&mode == mode {
		return nil
	}

	return EACCES
}

//sys	fchmodat(dirfd int32, path string, mode uint32) (err error)
//sys	fchmodat2(dirfd int32, path string, mode uint32, flags int32) (err error) = _SYS_fchmodat2

func Fchmodat(dirfd int32, path string, mode uint32, flags int32) (rerr error) {
	// Linux fchmodat doesn't support the flags parameter, but fchmodat2 does.
	// Try fchmodat2 if flags are specified.
	if flags != 0 {
		err := fchmodat2(dirfd, path, mode, flags)
		if err == ENOSYS {
			// fchmodat2 isn't available. If the flags are known to be valid,
			// return EOPNOTSUPP to indicate that fchmodat doesn't support them.
			if flags&^(_AT_SYMLINK_NOFOLLOW|_AT_EMPTY_PATH) != 0 {
				return EINVAL
			} else if flags&(_AT_SYMLINK_NOFOLLOW|_AT_EMPTY_PATH) != 0 {
				return EOPNOTSUPP
			}
		}
		return err
	}
	return fchmodat(dirfd, path, mode)
}

//sys	linkat(olddirfd int32, oldpath string, newdirfd int32, newpath string, flags int32) (err error)

func Link(oldpath string, newpath string) (err error) {
	return linkat(_AT_FDCWD, oldpath, _AT_FDCWD, newpath, 0)
}

func Mkdir(path string, mode uint32) (err error) {
	return Mkdirat(_AT_FDCWD, path, mode)
}

func Mknod(path string, mode uint32, dev int32) (err error) {
	return Mknodat(_AT_FDCWD, path, mode, dev)
}

func Open(path string, mode int32, perm uint32) (fd int32, err error) {
	return openat(_AT_FDCWD, path, mode|O_LARGEFILE, perm)
}

//sys	openat(dirfd int32, path string, flags int32, mode uint32) (fd int32, err error)

func Openat(dirfd int32, path string, flags int32, mode uint32) (fd int32, err error) {
	return openat(dirfd, path, flags|O_LARGEFILE, mode)
}

func Pipe(p []int32) (rerr error) {
	return Pipe2(p, 0)
}

//sysnb pipe2(p *int32, flags int32) (err error)

func Pipe2(p []int32, flags int32) (rerr error) {
	if len(p) != 2 {
		return EINVAL
	}
	pp := []int32{:2}
	err := pipe2(&pp[0], flags)
	if err == nil {
		p[0] = pp[0]
		p[1] = pp[1]
	}
	return err
}

//sys	readlinkat(dirfd int32, path string, buf []byte) (n int32, err error)

func Readlink(path string, buf []byte) (n int32, err error) {
	return readlinkat(_AT_FDCWD, path, buf)
}

func Rename(oldpath string, newpath string) (err error) {
	return Renameat(_AT_FDCWD, oldpath, _AT_FDCWD, newpath)
}

func Rmdir(path string) (rerr error) {
	return unlinkat(_AT_FDCWD, path, _AT_REMOVEDIR)
}

//sys	symlinkat(oldpath string, newdirfd int32, newpath string) (err error)

func Symlink(oldpath string, newpath string) (err error) {
	return symlinkat(oldpath, _AT_FDCWD, newpath)
}

func Unlink(path string) (rerr error) {
	return unlinkat(_AT_FDCWD, path, 0)
}

//sys	unlinkat(dirfd int32, path string, flags int32) (err error)

func Unlinkat(dirfd int32, path string) (rerr error) {
	return unlinkat(dirfd, path, 0)
}

func Utimes(path string, tv []Timeval) (err error) {
	if len(tv) != 2 {
		return EINVAL
	}
	return utimes(path, &tv[0])
}

//sys	utimensat(dirfd int32, path string, times *Timespec, flag int32) (err error)

func UtimesNano(path string, ts []Timespec) (err error) {
	if len(ts) != 2 {
		return EINVAL
	}
	return utimensat(_AT_FDCWD, path, &ts[0], 0)
}

func Futimesat(dirfd int32, path string, tv []Timeval) (err error) {
	if len(tv) != 2 {
		return EINVAL
	}
	return futimesat(dirfd, path, &tv[0])
}

func Futimes(fd int32, tv []Timeval) (err error) {
	// Believe it or not, this is the best we can do on Linux
	// (and is what glibc does).
	return Utimes("/proc/self/fd/"+itoa.Itoa(fd), tv)
}

const ImplementsGetwd = true

//sys	Getcwd(buf []byte) (n int32, err error)

func Getwd() (wd string, err error) {
	var buf [PathMax]byte
	n, err := Getcwd(buf[0:])
	if err != nil {
		return "", err
	}
	// Getcwd returns the number of bytes written to buf, including the NUL.
	if n < 1 || n > len(buf) || buf[n-1] != 0 {
		return "", EINVAL
	}
	// In some cases, Linux can return a path that starts with the
	// "(unreachable)" prefix, which can potentially be a valid relative
	// path. To work around that, return ENOENT if path is not absolute.
	if buf[0] != '/' {
		return "", ENOENT
	}

	return push([]byte{}, buf[0:n-1]...), nil
}

func Getgroups() (gids []int32, err error) {
	n, err := getgroups(0, nil)
	if err != nil {
		return nil, err
	}
	if n == 0 {
		return nil, nil
	}

	// Sanity check group count. Max is 1<<16 on Linux.
	if n < 0 || n > 1<<20 {
		return nil, EINVAL
	}

	a := []_Gid_t{:n}
	n, err = getgroups(n, &a[0])
	if err != nil {
		return nil, err
	}
	gids = []int32{:n}
	for i, v := range a[0:n] {
		gids[i] = int32(v)
	}
	return
}

func Setgroups(gids []int32) (err error) {
	n := uintptr(len(gids))
	if n == 0 {
		if _, _, e1 := AllThreadsSyscall(_SYS_setgroups, 0, 0, 0); e1 != 0 {
			err = errnoErr(e1)
		}
		return
	}

	a := []_Gid_t{:len(gids)}
	for i, v := range gids {
		a[i] = _Gid_t(v)
	}
	if _, _, e1 := AllThreadsSyscall(_SYS_setgroups, n, uintptr(unsafe.Pointer(&a[0])), 0); e1 != 0 {
		err = errnoErr(e1)
	}
	return
}

type WaitStatus uint32

// Wait status is 7 bits at bottom, either 0 (exited),
// 0x7F (stopped), or a signal number that caused an exit.
// The 0x80 bit is whether there was a core dump.
// An extra number (exit code, signal causing a stop)
// is in the high bits. At least that's the idea.
// There are various irregularities. For example, the
// "continued" status is 0xFFFF, distinguishing itself
// from stopped via the core dump bit.

const (
	mask    = 0x7F
	core    = 0x80
	exited  = 0x00
	stopped = 0x7F
	shift   = 8
)

func (w *WaitStatus) Exited() (rok bool) { return *w&mask == exited }

func (w *WaitStatus) Signaled() (rok bool) { return *w&mask != stopped && *w&mask != exited }

func (w *WaitStatus) Stopped() (rok bool) { return *w&0xFF == stopped }

func (w *WaitStatus) Continued() (rok bool) { return *w == 0xFFFF }

func (w *WaitStatus) CoreDump() (rok bool) { return w.Signaled() && *w&core != 0 }

func (w *WaitStatus) ExitStatus() (rn int32) {
	if !w.Exited() {
		return -1
	}
	return int32(*w>>shift) & 0xFF
}

func (w *WaitStatus) Signal() (rsignal Signal) {
	if !w.Signaled() {
		return -1
	}
	return Signal(*w & mask)
}

func (w *WaitStatus) StopSignal() (rsignal Signal) {
	if !w.Stopped() {
		return -1
	}
	return Signal(*w>>shift) & 0xFF
}

func (w *WaitStatus) TrapCause() (rn int32) {
	if w.StopSignal() != SIGTRAP {
		return -1
	}
	return int32(*w>>shift) >> 8
}

//sys	wait4(pid int32, wstatus *_C_int, options int32, rusage *Rusage) (wpid int32, err error)

func Wait4(pid int32, wstatus *WaitStatus, options int32, rusage *Rusage) (wpid int32, err error) {
	var status _C_int
	wpid, err = wait4(pid, &status, options, rusage)
	if wstatus != nil {
		*wstatus = WaitStatus(status)
	}
	return
}

func Mkfifo(path string, mode uint32) (err error) {
	return Mknod(path, mode|S_IFIFO, 0)
}

func (sa *SockaddrInet4) sockaddr(buf []byte) (r_Socklen _Socklen, rerr error) {
	if len(buf) < SizeofSockaddrInet4 {
		return 0, EINVAL
	}
	if !sockSetPort(buf, sa.Port) {
		return 0, EINVAL
	}
	sockSetFamily(buf, AF_INET)
	copy(sockIPv4Addr(buf), sa.Addr)
	return SizeofSockaddrInet4, nil
}

func (sa *SockaddrInet6) sockaddr(buf []byte) (r_Socklen _Socklen, rerr error) {
	if len(buf) < SizeofSockaddrInet6 {
		return 0, EINVAL
	}
	if !sockSetPort(buf, sa.Port) {
		return 0, EINVAL
	}
	sockSetFamily(buf, AF_INET6)
	abiPut32(buf, sockIn6OffScope, sa.ZoneId)
	copy(sockIPv6Addr(buf), sa.Addr)
	return SizeofSockaddrInet6, nil
}

func (sa *SockaddrUnix) sockaddr(buf []byte) (r_Socklen _Socklen, rerr error) {
	if len(buf) < sockUnOffPath+sockUnPathLen {
		return 0, EINVAL
	}
	name := sa.Name
	n := len(name)
	if n > sockUnPathLen {
		return 0, EINVAL
	}
	// Abstract addresses start with NUL.
	// '@' is also a valid way to specify abstract addresses.
	isAbstract := n > 0 && (name[0] == '@' || name[0] == '\x00')

	// Non-abstract named addresses are NUL terminated.
	// The length can't use the full capacity as we need to add NUL.
	if n == sockUnPathLen && !isAbstract {
		return 0, EINVAL
	}
	sockSetFamily(buf, AF_UNIX)
	path := sockUnixPath(buf)
	for i := int32(0); i < n; i++ {
		path[i] = name[i]
	}
	// Length is family + name (+ NUL if non-abstract).
	// Family is of type uint16 (2 bytes).
	sl := _Socklen(2 + n)
	if isAbstract {
		// Abstract addresses are not NUL terminated.
		// We rewrite '@' prefix to NUL here.
		path[0] = 0
	} else if n > 0 {
		// Add NUL for non-abstract named addresses.
		sl++
	}

	return sl, nil
}

type SockaddrLinklayer struct {
	Protocol uint16
	Ifindex  int32
	Hatype   uint16
	Pkttype  uint8
	Halen    uint8
	Addr     []byte // 8 bytes, allocated by newSockaddrLinklayer
}

// newSockaddrLinklayer returns a link-layer sockaddr with Addr allocated at its
// ABI length.
func newSockaddrLinklayer() (sa SockaddrLinklayer) {
	sa.Addr = []byte{:linkAddrLen}
	return sa
}

// NewSockaddrLinklayer returns a link-layer sockaddr with the given address.
func NewSockaddrLinklayer(ifindex int32, halen uint8, addr []byte) (sa SockaddrLinklayer) {
	sa = newSockaddrLinklayer()
	sa.Ifindex = ifindex
	sa.Halen = halen
	copy(sa.Addr, addr)
	return sa
}

func (sa *SockaddrLinklayer) sockaddr(buf []byte) (r_Socklen _Socklen, rerr error) {
	if len(buf) < SizeofSockaddrLinklayer {
		return 0, EINVAL
	}
	if sa.Ifindex < 0 || sa.Ifindex > 0x7fffffff {
		return 0, EINVAL
	}
	sockSetFamily(buf, AF_PACKET)
	abiPut16(buf, sockLlOffProtocol, sa.Protocol)
	abiPut32(buf, sockLlOffIfindex, uint32(sa.Ifindex))
	abiPut16(buf, sockLlOffHatype, sa.Hatype)
	abiPut8(buf, sockLlOffPkttype, sa.Pkttype)
	abiPut8(buf, sockLlOffHalen, sa.Halen)
	copy(abiWindow(buf, sockLlOffAddr, sockLlAddrLen), sa.Addr)
	return SizeofSockaddrLinklayer, nil
}

type SockaddrNetlink struct {
	Family uint16
	Pad    uint16
	Pid    uint32
	Groups uint32
}

func (sa *SockaddrNetlink) sockaddr(buf []byte) (r_Socklen _Socklen, rerr error) {
	if len(buf) < SizeofSockaddrNetlink {
		return 0, EINVAL
	}
	sockSetFamily(buf, AF_NETLINK)
	abiPut16(buf, sockNlOffPad, sa.Pad)
	abiPut32(buf, sockNlOffPid, sa.Pid)
	abiPut32(buf, sockNlOffGroups, sa.Groups)
	return SizeofSockaddrNetlink, nil
}

func anyToSockaddr(rsa []byte) (rsockaddr Sockaddr, rerr error) {
	switch sockFamily(rsa) {
	case AF_NETLINK:
		sa := &SockaddrNetlink{}
		sa.Family = sockFamily(rsa)
		sa.Pad = abiGet16(rsa, sockNlOffPad)
		sa.Pid = abiGet32(rsa, sockNlOffPid)
		sa.Groups = abiGet32(rsa, sockNlOffGroups)
		return sa, nil

	case AF_PACKET:
		sa := &SockaddrLinklayer{}
		*sa = newSockaddrLinklayer()
		sa.Protocol = abiGet16(rsa, sockLlOffProtocol)
		sa.Ifindex = int32(abiGet32(rsa, sockLlOffIfindex))
		sa.Hatype = abiGet16(rsa, sockLlOffHatype)
		sa.Pkttype = abiGet8(rsa, sockLlOffPkttype)
		sa.Halen = abiGet8(rsa, sockLlOffHalen)
		copy(sa.Addr, abiWindow(rsa, sockLlOffAddr, sockLlAddrLen))
		return sa, nil

	case AF_UNIX:
		sa := &SockaddrUnix{}
		path := sockUnixPath(rsa)
		if path == nil {
			return nil, EINVAL
		}
		if path[0] == 0 {
			// "Abstract" Unix domain socket.
			// Rewrite leading NUL as @ for textual display.
			// (This is the standard convention.)
			path[0] = '@'
		}

		// Assume path ends at NUL.
		// This is not technically the Linux semantics for
		// abstract Unix domain sockets--they are supposed
		// to be uninterpreted fixed-size binary blobs--but
		// everyone uses this convention.
		n := 0
		for n < int32(len(path)) && path[n] != 0 {
			n++
		}
		sa.Name = string(path[:n])
		return sa, nil

	case AF_INET:
		sa := &SockaddrInet4{}
		*sa = newSockaddrInet4()
		sa.Port = sockPort(rsa)
		copy(sa.Addr, sockIPv4Addr(rsa))
		return sa, nil

	case AF_INET6:
		sa := &SockaddrInet6{}
		*sa = newSockaddrInet6()
		sa.Port = sockPort(rsa)
		sa.ZoneId = abiGet32(rsa, sockIn6OffScope)
		copy(sa.Addr, sockIPv6Addr(rsa))
		return sa, nil
	}
	return nil, EAFNOSUPPORT
}

func Accept(fd int32) (nfd int32, sa Sockaddr, err error) {
	return Accept4(fd, 0)
}

func Accept4(fd int32, flags int32) (nfd int32, sa Sockaddr, err error) {
	rsa := sockaddrBuf()
	slen := _Socklen(SizeofSockaddrAny)
	nfd, err = accept4(fd, rsa, &slen, flags)
	if err != nil {
		return
	}
	if slen > SizeofSockaddrAny {
		panic("sockaddr buffer too small")
	}
	sa, err = anyToSockaddr(rsa)
	if err != nil {
		Close(nfd)
		nfd = 0
	}
	return
}

func Getsockname(fd int32) (sa Sockaddr, err error) {
	rsa := sockaddrBuf()
	slen := _Socklen(SizeofSockaddrAny)
	if err = getsockname(fd, rsa, &slen); err != nil {
		return
	}
	return anyToSockaddr(rsa)
}

func GetsockoptIPv6MTUInfo(fd, level, opt int32) (riPv6MTUInfo *IPv6MTUInfo, rerr error) {
	var value IPv6MTUInfo
	vallen := _Socklen(SizeofIPv6MTUInfo)
	err := getsockopt(fd, level, opt, unsafe.Pointer(&value), &vallen)
	return &value, err
}

func GetsockoptUcred(fd, level, opt int32) (rucred *Ucred, rerr error) {
	var value Ucred
	vallen := _Socklen(SizeofUcred)
	err := getsockopt(fd, level, opt, unsafe.Pointer(&value), &vallen)
	return &value, err
}

func SetsockoptIPMreqn(fd, level, opt int32, mreq *IPMreqn) (err error) {
	return setsockopt(fd, level, opt, unsafe.Pointer(mreq), unsafe.Sizeof(*mreq))
}

func recvmsgRaw(fd int32, p, oob []byte, flags int32, rsa []byte) (n, oobn int32, recvflags int32, err error) {
	var msg Msghdr
	msg.Name = (*byte)(abiBufferOf(rsa))
	msg.Namelen = uint32(SizeofSockaddrAny)
	var iov Iovec
	if len(p) > 0 {
		iov.Base = &p[0]
		iov.SetLen(len(p))
	}
	var dummy byte
	if len(oob) > 0 {
		if len(p) == 0 {
			var sockType int32
			sockType, err = GetsockoptInt(fd, SOL_SOCKET, SO_TYPE)
			if err != nil {
				return
			}
			// receive at least one normal byte
			if sockType != SOCK_DGRAM {
				iov.Base = &dummy
				iov.SetLen(1)
			}
		}
		msg.Control = &oob[0]
		msg.SetControllen(len(oob))
	}
	msg.Iov = &iov
	msg.Iovlen = 1
	if n, err = recvmsg(fd, &msg, flags); err != nil {
		return
	}
	oobn = int32(msg.Controllen)
	recvflags = int32(msg.Flags)
	return
}

func sendmsgN(fd int32, p, oob []byte, ptr unsafe.Pointer, salen _Socklen, flags int32) (n int32, err error) {
	var msg Msghdr
	msg.Name = (*byte)(ptr)
	msg.Namelen = uint32(salen)
	var iov Iovec
	if len(p) > 0 {
		iov.Base = &p[0]
		iov.SetLen(len(p))
	}
	var dummy byte
	if len(oob) > 0 {
		if len(p) == 0 {
			var sockType int32
			sockType, err = GetsockoptInt(fd, SOL_SOCKET, SO_TYPE)
			if err != nil {
				return 0, err
			}
			// send at least one normal byte
			if sockType != SOCK_DGRAM {
				iov.Base = &dummy
				iov.SetLen(1)
			}
		}
		msg.Control = &oob[0]
		msg.SetControllen(len(oob))
	}
	msg.Iov = &iov
	msg.Iovlen = 1
	if n, err = sendmsg(fd, &msg, flags); err != nil {
		return 0, err
	}
	if len(oob) > 0 && len(p) == 0 {
		n = 0
	}
	return n, nil
}

// BindToDevice binds the socket associated with fd to device.
func BindToDevice(fd int32, device string) (err error) {
	return SetsockoptString(fd, SOL_SOCKET, SO_BINDTODEVICE, device)
}

//sys	ptrace(request int32, pid int32, addr uintptr, data uintptr) (err error)
//sys	ptracePtr(request int32, pid int32, addr uintptr, data unsafe.Pointer) (err error) = SYS_PTRACE

func ptracePeek(req int32, pid int32, addr uintptr, out []byte) (count int32, err error) {
	// The peek requests are machine-size oriented, so we wrap it
	// to retrieve arbitrary-length data.

	// The ptrace syscall differs from glibc's ptrace.
	// Peeks returns the word in *data, not as the return value.

	var buf [sizeofPtr]byte

	// Leading edge. PEEKTEXT/PEEKDATA don't require aligned
	// access (PEEKUSER warns that it might), but if we don't
	// align our reads, we might straddle an unmapped page
	// boundary and not get the bytes leading up to the page
	// boundary.
	n := 0
	pos := int32(0)
	if addr%sizeofPtr != 0 {
		err = ptracePtr(req, pid, addr-addr%sizeofPtr, unsafe.Pointer(&buf[0]))
		if err != nil {
			return 0, err
		}
		n += mxutil.CopyFrom(out, buf[:], int32(addr%sizeofPtr))
		pos = n
	}

	// Remainder.
	for len(out)-pos > 0 {
		// We use an internal buffer to guarantee alignment.
		// It's not documented if this is necessary, but we're paranoid.
		err = ptracePtr(req, pid, addr+uintptr(n), unsafe.Pointer(&buf[0]))
		if err != nil {
			return n, err
		}
		copied := mxutil.CopyAt(out, pos, buf[:])
		n += copied
		pos += copied
	}

	return n, nil
}

func PtracePeekText(pid int32, addr uintptr, out []byte) (count int32, err error) {
	return ptracePeek(PTRACE_PEEKTEXT, pid, addr, out)
}

func PtracePeekData(pid int32, addr uintptr, out []byte) (count int32, err error) {
	return ptracePeek(PTRACE_PEEKDATA, pid, addr, out)
}

func ptracePoke(pokeReq int32, peekReq int32, pid int32, addr uintptr, data []byte) (count int32, err error) {
	// As for ptracePeek, we need to align our accesses to deal
	// with the possibility of straddling an invalid page.

	// Leading edge.
	n := 0
	if addr%sizeofPtr != 0 {
		var buf [sizeofPtr]byte
		err = ptracePtr(peekReq, pid, addr-addr%sizeofPtr, unsafe.Pointer(&buf[0]))
		if err != nil {
			return 0, err
		}
		n += mxutil.CopyAt(buf[:], int32(addr%sizeofPtr), data)
		word := *((*uintptr)(unsafe.Pointer(&buf[0])))
		err = ptrace(pokeReq, pid, addr-addr%sizeofPtr, word)
		if err != nil {
			return 0, err
		}
		data = data[n:]
	}

	// Interior.
	pos := 0
	for len(data)-pos > sizeofPtr {
		word := *((*uintptr)(unsafe.Pointer(&data[pos])))
		err = ptrace(pokeReq, pid, addr+uintptr(n), word)
		if err != nil {
			return n, err
		}
		n += sizeofPtr
		pos += sizeofPtr
	}

	// Trailing edge.
	if len(data)-pos > 0 {
		var buf [sizeofPtr]byte
		err = ptracePtr(peekReq, pid, addr+uintptr(n), unsafe.Pointer(&buf[0]))
		if err != nil {
			return n, err
		}
		mxutil.CopyAt(buf[:], 0, data)
		word := *((*uintptr)(unsafe.Pointer(&buf[0])))
		err = ptrace(pokeReq, pid, addr+uintptr(n), word)
		if err != nil {
			return n, err
		}
		n += len(data)
	}

	return n, nil
}

func PtracePokeText(pid int32, addr uintptr, data []byte) (count int32, err error) {
	return ptracePoke(PTRACE_POKETEXT, PTRACE_PEEKTEXT, pid, addr, data)
}

func PtracePokeData(pid int32, addr uintptr, data []byte) (count int32, err error) {
	return ptracePoke(PTRACE_POKEDATA, PTRACE_PEEKDATA, pid, addr, data)
}

