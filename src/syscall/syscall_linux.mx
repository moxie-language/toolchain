func Getrlimit(resource int32, rlim *Rlimit) (err error) {
	// prlimit1 is the same as prlimit when newlimit == nil
	return prlimit1(0, resource, nil, rlim)
}

// setrlimit sets a resource limit.
// The Setrlimit function is in rlimit.go, and calls this one.
func setrlimit(resource int32, rlim *Rlimit) (err error) {
	return prlimit1(0, resource, rlim, nil)
}

// prlimit changes a resource limit. We use a single definition so that
// we can tell StartProcess to not restore the original NOFILE limit.
//
// golang.org/x/sys linknames prlimit.
// Do not remove or change the type signature.
//
//:linkname prlimit
func prlimit(pid int32, resource int32, newlimit *Rlimit, old *Rlimit) (err error) {
	err = prlimit1(pid, resource, newlimit, old)
	if err == nil && newlimit != nil && resource == RLIMIT_NOFILE && (pid == 0 || pid == Getpid()) {
		rlimitHolder.clear()
	}
	return err
}

// CloseOnExec marks fd close-on-exec. Lives here because exec_unix.mx
// (the Go home of this function) is excluded from the moxie build.
func CloseOnExec(fd int32) { fcntl(fd, F_SETFD, FD_CLOEXEC) }

// SetNonblock sets the O_NONBLOCK flag on fd.
func SetNonblock(fd int32, nonblocking bool) (err error) {
	flag, err := fcntl(fd, F_GETFL, 0)
	if err != nil {
		return err
	}
	if (flag&O_NONBLOCK != 0) == nonblocking {
		return nil
	}
	if nonblocking {
		flag |= O_NONBLOCK
	} else {
		flag &^= O_NONBLOCK
	}
	_, err = fcntl(fd, F_SETFL, flag)
	return err
}
