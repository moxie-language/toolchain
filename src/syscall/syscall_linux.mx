// mmap varies by architecture; see syscall_linux_*.go.
//sys	munmap(addr uintptr, length uintptr) (err error)

// mapperState holds the lazily-created mmap manager. It is a self-mutating
// type so _getMapper writes through its method instead of storing into
// package globals after init.
type mapperState struct {
	mapper mmapper
	done   bool
}

var mapperHolder *mapperState

func init() {
	errnoText = _errors()
	signalText = _signals()
	envsHolder = &envStore{}
	rlimitHolder = &rlimitState{}
	mapperHolder = &mapperState{}
}

func (ms *mapperState) get() (rmapper *mmapper) {
	if !ms.done {
		ms.done = true
		ms.mapper = mmapper{
			active: map[*byte][]byte{},
			mmap:   mmap,
			munmap: munmap,
		}
	}
	return &ms.mapper
}

func _getMapper() (rmmapper *mmapper) {
	return mapperHolder.get()
}

func Mmap(fd int32, offset int64, length int32, prot int32, flags int32) (data []byte, err error) {
	return _getMapper().Mmap(fd, offset, length, prot, flags)
}

func Munmap(b []byte) (err error) {
	return _getMapper().Munmap(b)
}

