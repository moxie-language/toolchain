func ReadDirent(fd int32, buf []byte) (n int32, err error) {
	return Getdents(fd, buf)
}

func direntIno(buf []byte) (rn uint64, rok bool) {
	return readInt(buf, DirentInoOff, 8)
}

func direntReclen(buf []byte) (rn uint64, rok bool) {
	return readInt(buf, DirentReclenOff, 2)
}

func direntNamlen(buf []byte) (rn uint64, rok bool) {
	reclen, ok := direntReclen(buf)
	if !ok {
		return 0, false
	}
	return reclen - uint64(DirentNameOff), true
}

//sys	mount(source string, target string, fstype string, flags uintptr, data *byte) (err error)

func Mount(source string, target string, fstype string, flags uintptr, data string) (err error) {
	// Certain file systems get rather angry and EINVAL if you give
	// them an empty string of data, rather than NULL.
	if data == "" {
		return mount(source, target, fstype, flags, nil)
	}
	datap, err := BytePtrFromString(data)
	if err != nil {
		return err
	}
	return mount(source, target, fstype, flags, datap)
}

