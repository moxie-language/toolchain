package syscall

// RawConnAction is the work a RawConn runs with the file descriptor. It is an
// interface rather than a function value because the work carries the state of
// the operation it performs, which a function value cannot hold.
type RawConnAction interface {
	// rawAction runs while fd is valid. Returning true ends Read or Write.
	rawAction(fd uintptr) bool
}

// RawConnControlAction is the Control variant: its work reports nothing.
type RawConnControlAction interface {
	rawControlAction(fd uintptr)
}

// A RawConn is a raw network connection.
type RawConn interface {
	// Control invokes f on the underlying connection's file
	// descriptor or handle.
	// The file descriptor fd is guaranteed to remain valid while
	// f executes but not after f returns.
	Control(f RawConnControlAction) error

	// Read invokes f on the underlying connection's file
	// descriptor or handle; f is expected to try to read from the
	// file descriptor.
	// If f returns true, Read returns. Otherwise Read blocks
	// waiting for the connection to be ready for reading and
	// tries again repeatedly.
	// The file descriptor is guaranteed to remain valid while f
	// executes but not after f returns.
	Read(f RawConnAction) error

	// Write is like Read but for writing.
	Write(f RawConnAction) error
}

// Conn is implemented by some types in the net and os packages to provide
// access to the underlying file descriptor or handle.
type Conn interface {
	// SyscallConn returns a raw network connection.
	SyscallConn() (RawConn, error)
}
