//go:build unix

package syscall

// origRlimitNofile, if non-nil, is the original soft RLIMIT_NOFILE.
var origRlimitNofile *Rlimit
var rlimitInited bool

func ensureRlimit() {
	if rlimitInited {
		return
	}
	rlimitInited = true
	var lim Rlimit
	if err := Getrlimit(RLIMIT_NOFILE, &lim); err == nil && lim.Max > 0 && lim.Cur < lim.Max-1 {
		origRlimitNofile = &lim
		nlim := lim
		nlim.Cur = nlim.Max - 1
		adjustFileLimit(&nlim)
		setrlimit(RLIMIT_NOFILE, &nlim)
	}
}

func Setrlimit(resource int, rlim *Rlimit) error {
	if resource == RLIMIT_NOFILE {
		origRlimitNofile = nil
	}
	return setrlimit(resource, rlim)
}
