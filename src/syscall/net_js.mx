//:build js && wasm

// Network stubs for the js/wasm target, mirroring $GOROOT/src/syscall/net_js.go.
//
// This file was missing from the port. Its absence did not show up as "undefined:
// syscall.Accept" in net: it showed up as `cannot resolve type of short var ns in
// accept` while compiling internal/poll, because internal/poll's js build
// (fd_unix.mx and sys_cloexec.mx are tagged for js, exactly as Go tags them) calls
// syscall.Accept, and an unresolved call made the short var's type nil, which then
// became a void parameter. net/http for wasm could not build.
//
// Go's js target has no sockets: every one of these returns ENOSYS, except
// SetSockoptInt and SetNonblock, which are no-ops that return nil.
package syscall

func Socket(proto, sotype, unused int32) (fd int32, err error) {
	return 0, ENOSYS
}

func Bind(fd int32, sa Sockaddr) (rerr error) {
	return ENOSYS
}

func StopIO(fd int32) (rerr error) {
	return ENOSYS
}

func Listen(fd int32, backlog int32) (rerr error) {
	return ENOSYS
}

func Accept(fd int32) (newfd int32, sa Sockaddr, err error) {
	return 0, nil, ENOSYS
}

func Connect(fd int32, sa Sockaddr) (rerr error) {
	return ENOSYS
}

func Recvfrom(fd int32, p []byte, flags int32) (n int32, from Sockaddr, err error) {
	return 0, nil, ENOSYS
}

func Sendto(fd int32, p []byte, flags int32, to Sockaddr) (rerr error) {
	return ENOSYS
}

func Recvmsg(fd int32, p, oob []byte, flags int32) (n int32, oobn int32, recvflags int32, from Sockaddr, err error) {
	return 0, 0, 0, nil, ENOSYS
}

func SendmsgN(fd int32, p, oob []byte, to Sockaddr, flags int32) (n int32, err error) {
	return 0, ENOSYS
}

func GetsockoptInt(fd int32, level int32, opt int32) (value int32, err error) {
	return 0, ENOSYS
}

func SetsockoptInt(fd int32, level int32, opt int32, value int32) (rerr error) {
	return nil
}

func SetReadDeadline(fd int32, t int64) (rerr error) {
	return ENOSYS
}

func SetWriteDeadline(fd int32, t int64) (rerr error) {
	return ENOSYS
}

func Shutdown(fd int32, how int32) (rerr error) {
	return ENOSYS
}

func SetNonblock(fd int32, nonblocking bool) (rerr error) {
	return nil
}
