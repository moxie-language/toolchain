//:build js && wasm

package js

import (
	"internal/synctest"
)

// The function table and its counter are runtime-mutable: FuncOf and Release
// change them, and handleEvent reads them. They live in the bridge object (see
// js.mx) so that the package's mutable state is one named thing, not globals.
func funcsInit() {
	if br.funcs != nil { return }
	br.funcs = map[uint32]func(Value, []Value) Value{}
	br.nextFuncID = 1
}

// Func is a wrapped Go function to be called by JavaScript.
type Func struct {
	Value  // the JavaScript function that invokes the Go function
	bubble *synctest.Bubble
	id     uint32
}

// FuncOf returns a function to be used by JavaScript.
//
// The Go function fn is called with the value of JavaScript's "this" keyword and the
// arguments of the invocation. The return value of the invocation is
// the result of the Go function mapped back to JavaScript: it is already a Value.
//
// Invoking the wrapped Go function from JavaScript will
// pause the event loop and spawn a new goroutine.
// Other wrapped functions which are triggered during a call from Go to JavaScript
// get executed on the same goroutine.
//
// As a consequence, if one wrapped function blocks, JavaScript's event loop
// is blocked until that function returns. Hence, calling any async JavaScript
// API, which requires the event loop, like fetch (http.Client), will cause an
// immediate deadlock. Therefore a blocking function should explicitly start a
// new goroutine.
//
// Func.Release must be called to free up resources when the function will not be invoked any more.
func FuncOf(fn func(this Value, args []Value) Value) Func {
	jsInit()
	funcsInit()
	ensureEventHandler()
	id := br.nextFuncID
	br.nextFuncID++
	bubble := synctest.Acquire()
	if bubble != nil {
		origFn := fn
		fn = func(this Value, args []Value) Value {
			var r Value
			bubble.Run(func() {
				r = origFn(this, args)
			})
			return r
		}
	}
	br.funcs[id] = fn
	return Func{
		id:     id,
		bubble: bubble,
		Value:  jsGo.Call("_makeFuncWrapper", ValueOfUint(uint64(id))),
	}
}

// Release frees up resources allocated for the function.
// The function must not be invoked after calling Release.
// It is allowed to call Release while the function is still running.
//
// A package function, not a method: it releases a handle and removes an entry
// from the bridge's table, and the receiver is not the thing being changed.
func Release(c Func) {
	c.bubble.Release()
	delete(br.funcs, c.id)
}

// setEventHandler is defined in the runtime package.
func setEventHandler(fn func() bool)

func ensureEventHandler() {
	if br.eventHandlerSet {
		return
	}
	br.eventHandlerSet = true
	setEventHandler(handleEvent)
}

// handleEvent retrieves the pending event (window._pendingEvent) and calls the js.Func on it.
// It returns true if an event was handled.
func handleEvent() bool {
	jsInit()
	funcsInit()
	// Retrieve the event from js
	cb := jsGo.Get("_pendingEvent")
	if cb.IsNull() {
		return false
	}
	Set(jsGo, "_pendingEvent", Null())

	id := uint32(cb.Get("id").Int())
	if id == 0 { // zero indicates deadlock
		select {}
	}

	// Retrieve the associated js.Func
	f, ok := br.funcs[id]
	if !ok {
		Global().Get("console").Call("error", ValueOfString("call to released function"))
		return true
	}

	// Call the js.Func with arguments
	this := cb.Get("this")
	argsObj := cb.Get("args")
	args := []Value{:argsObj.Length()}
	for i := range args {
		args[i] = argsObj.Index(i)
	}
	result := f(this, args)

	// Return the result to js
	Set(cb, "result", result)
	return true
}
