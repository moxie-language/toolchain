//:build ignore

// This file assumes there is a libc available that runs on a real operating
// system.

package syscall

func Getuid() (rn int32) { return int32(libc_getuid()) }
func Geteuid() (rn int32) { return int32(libc_geteuid()) }
func Getgid() (rn int32) { return int32(libc_getgid()) }
func Getegid() (rn int32) { return int32(libc_getegid()) }
func Getpid() (rn int32) { return int32(libc_getpid()) }
func Getppid() (rn int32) { return int32(libc_getppid()) }

// uid_t getuid(void)
//
//export getuid
func libc_getuid() (rn int32)

// gid_t getgid(void)
//
//export getgid
func libc_getgid() (rn int32)

// uid_t geteuid(void)
//
//export geteuid
func libc_geteuid() (rn int32)

// gid_t getegid(void)
//
//export getegid
func libc_getegid() (rn int32)

// gid_t getpid(void)
//
//export getpid
func libc_getpid() (rn int32)

// gid_t getppid(void)
//
//export getppid
func libc_getppid() (rn int32)
