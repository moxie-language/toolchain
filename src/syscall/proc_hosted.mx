//go:build ignore

// This file assumes there is a libc available that runs on a real operating
// system.

package syscall

func Getuid() int32  { return int32(libc_getuid()) }
func Geteuid() int32 { return int32(libc_geteuid()) }
func Getgid() int32  { return int32(libc_getgid()) }
func Getegid() int32 { return int32(libc_getegid()) }
func Getpid() int32  { return int32(libc_getpid()) }
func Getppid() int32 { return int32(libc_getppid()) }

// uid_t getuid(void)
//
//export getuid
func libc_getuid() int32

// gid_t getgid(void)
//
//export getgid
func libc_getgid() int32

// uid_t geteuid(void)
//
//export geteuid
func libc_geteuid() int32

// gid_t getegid(void)
//
//export getegid
func libc_getegid() int32

// gid_t getpid(void)
//
//export getpid
func libc_getpid() int32

// gid_t getppid(void)
//
//export getppid
func libc_getppid() int32
