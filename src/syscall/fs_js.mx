//go:build js && wasm
//:build js && wasm

package syscall


// Provided by package runtime.
func now() (sec int64, nsec int32)

type jsFile struct {
	path    string
	entries []string
	dirIdx  int32
	pos     int64
	seeked  bool
}

var files map[int32]*jsFile
var filesDone bool

func _files() map[int32]*jsFile {
	if !filesDone {
		filesDone = true
		files = map[int32]*jsFile{
			0: {},
			1: {},
			2: {},
		}
	}
	return files
}

func fdToFile(fd int32) (*jsFile, error) {
	f, ok := _files()[fd]
	if !ok {
		return nil, EBADF
	}
	return f, nil
}

func Open(path string, openmode int32, perm uint32) (int32, error) { return 0, ENOSYS }
func Close(fd int32) error {
	delete(_files(), fd)
	return nil
}
func CloseOnExec(fd int32) {}

func Mkdir(path string, perm uint32) error              { return ENOSYS }
func ReadDirent(fd int32, buf []byte) (int32, error)        { return 0, ENOSYS }
func Stat(path string, st *Stat_t) error                { return ENOSYS }
func Lstat(path string, st *Stat_t) error               { return ENOSYS }
func Fstat(fd int32, st *Stat_t) error                    { return ENOSYS }
func Unlink(path string) error                          { return ENOSYS }
func Rmdir(path string) error                           { return ENOSYS }
func Chmod(path string, mode uint32) error              { return ENOSYS }
func Fchmod(fd int32, mode uint32) error                  { return ENOSYS }
func Chown(path string, uid, gid int32) error             { return ENOSYS }
func Fchown(fd int32, uid, gid int32) error                 { return ENOSYS }
func Lchown(path string, uid, gid int32) error            { return ENOSYS }
func UtimesNano(path string, ts []Timespec) error       { return ENOSYS }
func Rename(from, to string) error                      { return ENOSYS }
func Truncate(path string, length int64) error          { return ENOSYS }
func Ftruncate(fd int32, length int64) error              { return ENOSYS }
func Chdir(path string) error                           { return ENOSYS }
func Fchdir(fd int32) error                               { return ENOSYS }
func Readlink(path string, buf []byte) (n int32, err error) { return 0, ENOSYS }
func Link(path, link string) error                      { return ENOSYS }
func Symlink(path, link string) error                   { return ENOSYS }
func Fsync(fd int32) error                                { return ENOSYS }
func Read(fd int32, b []byte) (int32, error)                { return 0, ENOSYS }
func Write(fd int32, b []byte) (int32, error)               { return 0, ENOSYS }
func Pread(fd int32, b []byte, offset int64) (int32, error) { return 0, ENOSYS }
func Pwrite(fd int32, b []byte, offset int64) (int32, error) { return 0, ENOSYS }
func Seek(fd int32, offset int64, whence int32) (int64, error) { return 0, ENOSYS }
func Dup(fd int32) (int32, error)                           { return 0, ENOSYS }
func Dup2(fd, newfd int32) error                          { return ENOSYS }
func Pipe(fd []int32) error                               { return ENOSYS }

func Getcwd(buf []byte) (n int32, err error) {
	n = copy(buf, "/")
	return
}
