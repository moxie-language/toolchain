//:build js && wasm

package syscall


// Provided by package runtime.
func now() (sec int64, nsec int32)

type jsFile struct {
	path    string
	entries []string
	dirIdx  int32
	pos     int64
	seeked  bool
}

var files map[int32]*jsFile
var filesDone bool

// initFiles allocates the fd table kept in a package global.
//
// init-prefixed because only initialisation code allocates in the root arena.
func initFiles() {
	files = map[int32]*jsFile{
		0: {},
		1: {},
		2: {},
	}
}

func _files() (rm map[int32]*jsFile) {
	if !filesDone {
		filesDone = true
		initFiles()
	}
	return files
}

func fdToFile(fd int32) (rjsFile *jsFile, rerr error) {
	f, ok := _files()[fd]
	if !ok {
		return nil, EBADF
	}
	return f, nil
}

func Open(path string, openmode int32, perm uint32) (rn int32, rerr error) { return 0, ENOSYS }
func Close(fd int32) (rerr error) {
	delete(_files(), fd)
	return nil
}
func CloseOnExec(fd int32) {}

func Mkdir(path string, perm uint32) (rerr error) { return ENOSYS }
func ReadDirent(fd int32, buf []byte) (rn int32, rerr error)        { return 0, ENOSYS }
func Stat(path string, st *Stat_t) (rerr error) { return ENOSYS }
func Lstat(path string, st *Stat_t) (rerr error) { return ENOSYS }
func Fstat(fd int32, st *Stat_t) (rerr error) { return ENOSYS }
func Unlink(path string) (rerr error) { return ENOSYS }
func Rmdir(path string) (rerr error) { return ENOSYS }
func Chmod(path string, mode uint32) (rerr error) { return ENOSYS }
func Fchmod(fd int32, mode uint32) (rerr error) { return ENOSYS }
func Chown(path string, uid, gid int32) (rerr error) { return ENOSYS }
func Fchown(fd int32, uid, gid int32) (rerr error) { return ENOSYS }
func Lchown(path string, uid, gid int32) (rerr error) { return ENOSYS }
func UtimesNano(path string, ts []Timespec) (rerr error) { return ENOSYS }
func Rename(from, to string) (rerr error) { return ENOSYS }
func Truncate(path string, length int64) (rerr error) { return ENOSYS }
func Ftruncate(fd int32, length int64) (rerr error) { return ENOSYS }
func Chdir(path string) (rerr error) { return ENOSYS }
func Fchdir(fd int32) (rerr error) { return ENOSYS }
func Readlink(path string, buf []byte) (n int32, err error) { return 0, ENOSYS }
func Link(path, link string) (rerr error) { return ENOSYS }
func Symlink(path, link string) (rerr error) { return ENOSYS }
func Fsync(fd int32) (rerr error) { return ENOSYS }
func Read(fd int32, b []byte) (rn int32, rerr error)                { return 0, ENOSYS }
func Write(fd int32, b []byte) (rn int32, rerr error)               { return 0, ENOSYS }
func Pread(fd int32, b []byte, offset int64) (rn int32, rerr error) { return 0, ENOSYS }
func Pwrite(fd int32, b []byte, offset int64) (rn int32, rerr error) { return 0, ENOSYS }
func Seek(fd int32, offset int64, whence int32) (rn int64, rerr error) { return 0, ENOSYS }
func Dup(fd int32) (rn int32, rerr error)                           { return 0, ENOSYS }
func Dup2(fd, newfd int32) (rerr error) { return ENOSYS }
func Pipe(fd []int32) (rerr error) { return ENOSYS }

func Getcwd(buf []byte) (n int32, err error) {
	n = copy(buf, "/")
	return
}
