//:build unix

package syscall

import (
	errorspkg "errors"
	"internal/asan"
	"internal/bytealg"
	"internal/itoa"
	"internal/msan"
	"internal/oserror"
	"internal/race"
	"unsafe"
)

const (
	Stdin  = 0
	Stdout = 1
	Stderr = 2
)

func ErrEAGAIN() (rerr error) { return EAGAIN }
func ErrEINVAL() (rerr error) { return EINVAL }
func ErrENOENT() (rerr error) { return ENOENT }

// clen returns the index of the first NULL byte in n or len(n) if n contains no NULL byte.
func clen(n []byte) (rn int32) {
	if i := bytealg.IndexByte(n, 0); i != -1 {
		return i
	}
	return len(n)
}

// Mmap manager, for use by operating system-specific implementations.

type mmapper struct {
	active map[*byte][]byte // active mappings; key is last byte in mapping
	mmap   func(addr, length uintptr, prot, flags, fd int32, offset int64) (uintptr, error)
	munmap func(addr uintptr, length uintptr) error
}

func (m *mmapper) Mmap(fd int32, offset int64, length int32, prot int32, flags int32) (data []byte, err error) {
	if length <= 0 {
		return nil, EINVAL
	}

	// Map the requested memory.
	addr, errno := m.mmap(0, uintptr(length), prot, flags, fd, offset)
	if errno != nil {
		return nil, errno
	}

	// Use unsafe to turn addr into a []byte.
	b := unsafe.Slice((*byte)(unsafe.Pointer(addr)), length)

	// Register mapping in m and return it.
	p := &b[cap(b)-1]
	m.active[p] = b
	return b, nil
}

func (m *mmapper) Munmap(data []byte) (err error) {
	if len(data) == 0 || len(data) != cap(data) {
		return EINVAL
	}

	// Find the base of the mapping.
	p := &data[cap(data)-1]
	b := m.active[p]
	if b == nil || &b[0] != &data[0] {
		return EINVAL
	}

	// Unmap the memory and update m.
	if errno := m.munmap(uintptr(unsafe.Pointer(&b[0])), uintptr(len(b))); errno != nil {
		return errno
	}
	delete(m.active, p)
	return nil
}

// An Errno is an unsigned number describing an error condition.
// It implements the error interface. The zero Errno is by convention
// a non-error, so code to convert from Errno to error should use:
//
//	err = nil
//	if errno != 0 {
//		err = errno
//	}
//
// Errno values can be tested against error values using [errors.Is].
// For example:
//
//	_, _, err := syscall.Syscall(...)
//	if errors.Is(err, fs.ErrNotExist) ...
type Errno uintptr

func (e *Errno) Error() (rs string) {
	errTable := _errors()
	if 0 <= int32(*e) && int32(*e) < len(errTable) {
		s := errTable[*e]
		if s != "" {
			return s
		}
	}
	return "errno " | itoa.Itoa(int32(*e))
}

func (e *Errno) String() (rs string) { return e.Error() }

func (e *Errno) Is(target error) (rok bool) {
	switch target {
	case oserror.ErrPermission:
		return *e == EACCES || *e == EPERM
	case oserror.ErrExist:
		return *e == EEXIST || *e == ENOTEMPTY
	case oserror.ErrNotExist:
		return *e == ENOENT
	case errorspkg.ErrUnsupported:
		return *e == ENOSYS || *e == ENOTSUP || *e == EOPNOTSUPP
	}
	return false
}

func (e *Errno) Temporary() (rok bool) {
	return *e == EINTR || *e == EMFILE || *e == ENFILE || e.Timeout()
}

func (e *Errno) Timeout() (rok bool) {
	return *e == EAGAIN || *e == EWOULDBLOCK || *e == ETIMEDOUT
}

// errnoErr returns common boxed Errno values, to prevent
// allocations at runtime.
func errnoErr(e Errno) (rerr error) {
	switch e {
	case 0:
		return nil
	case EAGAIN:
		return ErrEAGAIN()
	case EINVAL:
		return ErrEINVAL()
	case ENOENT:
		return ErrENOENT()
	}
	return e
}

// A Signal is a number describing a process signal.
// It implements the [os.Signal] interface.
type Signal int32

func (s *Signal) Signal() {}

func (s *Signal) String() (rs string) {
	signals := _signals()
	if 0 <= *s && int32(*s) < len(signals) {
		str := signals[*s]
		if str != "" {
			return str
		}
	}
	return "signal " | itoa.Itoa(int32(*s))
}

func Read(fd int32, p []byte) (n int32, err error) {
	n, err = read(fd, p)
	if race.Enabled {
		if n > 0 {
			race.WriteRange(unsafe.Pointer(&p[0]), n)
		}
		if err == nil {
			race.Acquire(unsafe.Pointer(&ioSync))
		}
	}
	if msan.Enabled && n > 0 {
		msan.Write(unsafe.Pointer(&p[0]), uintptr(n))
	}
	if asan.Enabled && n > 0 {
		asan.Write(unsafe.Pointer(&p[0]), uintptr(n))
	}
	return
}

func Write(fd int32, p []byte) (n int32, err error) {
	if race.Enabled {
		race.ReleaseMerge(unsafe.Pointer(&ioSync))
	}
	if faketime && (fd == 1 || fd == 2) {
		n = faketimeWrite(fd, p)
		if n < 0 {
			n, err = 0, errnoErr(Errno(-n))
		}
	} else {
		n, err = write(fd, p)
	}
	if race.Enabled && n > 0 {
		race.ReadRange(unsafe.Pointer(&p[0]), n)
	}
	if msan.Enabled && n > 0 {
		msan.Read(unsafe.Pointer(&p[0]), uintptr(n))
	}
	if asan.Enabled && n > 0 {
		asan.Read(unsafe.Pointer(&p[0]), uintptr(n))
	}
	return
}

func Pread(fd int32, p []byte, offset int64) (n int32, err error) {
	n, err = pread(fd, p, offset)
	if race.Enabled {
		if n > 0 {
			race.WriteRange(unsafe.Pointer(&p[0]), n)
		}
		if err == nil {
			race.Acquire(unsafe.Pointer(&ioSync))
		}
	}
	if msan.Enabled && n > 0 {
		msan.Write(unsafe.Pointer(&p[0]), uintptr(n))
	}
	if asan.Enabled && n > 0 {
		asan.Write(unsafe.Pointer(&p[0]), uintptr(n))
	}
	return
}

func Pwrite(fd int32, p []byte, offset int64) (n int32, err error) {
	if race.Enabled {
		race.ReleaseMerge(unsafe.Pointer(&ioSync))
	}
	n, err = pwrite(fd, p, offset)
	if race.Enabled && n > 0 {
		race.ReadRange(unsafe.Pointer(&p[0]), n)
	}
	if msan.Enabled && n > 0 {
		msan.Read(unsafe.Pointer(&p[0]), uintptr(n))
	}
	if asan.Enabled && n > 0 {
		asan.Read(unsafe.Pointer(&p[0]), uintptr(n))
	}
	return
}

// For testing: clients can set this flag to force
// creation of IPv6 sockets to return [EAFNOSUPPORT].
var SocketDisableIPv6 bool

type Sockaddr interface {
	// sockaddr writes the kernel form into buf and returns the address length.
	// The buffer belongs to the CALLER because the kernel reads or writes those
	// bytes after this returns: a buffer allocated here would live in this
	// call's frame arena and die with it (the RawSockaddr* mirrors are buffers
	// for the same reason, see abi_sockaddr.mx).
	sockaddr(buf []byte) (slen _Socklen, err error) // lowercase; only we can define Sockaddrs
}

type SockaddrInet4 struct {
	Port int32
	Addr [4]byte
}

type SockaddrInet6 struct {
	Port   int32
	ZoneId uint32
	Addr   [16]byte
}

type SockaddrUnix struct {
	Name string
}

// sockaddrBuf is the storage a Sockaddr conversion fills. SizeofSockaddrAny
// covers every family the tree speaks, and the caller owns it.
func sockaddrBuf() (b []byte) {
	return []byte{:SizeofSockaddrAny}
}

func Bind(fd int32, sa Sockaddr) (err error) {
	buf := sockaddrBuf()
	n, err := sa.sockaddr(buf)
	if err != nil {
		return err
	}
	return bind(fd, abiBufferOf(buf), n)
}

func Connect(fd int32, sa Sockaddr) (err error) {
	buf := sockaddrBuf()
	n, err := sa.sockaddr(buf)
	if err != nil {
		return err
	}
	return connect(fd, abiBufferOf(buf), n)
}

func Getpeername(fd int32) (sa Sockaddr, err error) {
	rsa := sockaddrBuf()
	slen := _Socklen(SizeofSockaddrAny)
	if err = getpeername(fd, rsa, &slen); err != nil {
		return
	}
	return anyToSockaddr(rsa)
}

func GetsockoptInt(fd, level, opt int32) (value int32, err error) {
	var n int32
	vallen := _Socklen(4)
	err = getsockopt(fd, level, opt, unsafe.Pointer(&n), &vallen)
	return int32(n), err
}

func Recvfrom(fd int32, p []byte, flags int32) (n int32, from Sockaddr, err error) {
	rsa := sockaddrBuf()
	slen := _Socklen(SizeofSockaddrAny)
	if n, err = recvfrom(fd, p, flags, rsa, &slen); err != nil {
		return
	}
	if sockFamily(rsa) != AF_UNSPEC {
		from, err = anyToSockaddr(rsa)
	}
	return
}

func recvfromInet4(fd int32, p []byte, flags int32, from *SockaddrInet4) (n int32, err error) {
	rsa := sockaddrBuf()
	socklen := _Socklen(SizeofSockaddrAny)
	if n, err = recvfrom(fd, p, flags, rsa, &socklen); err != nil {
		return
	}
	from.Port = sockPort(rsa)
	copy(from.Addr[:], sockIPv4Addr(rsa))
	return
}

func recvfromInet6(fd int32, p []byte, flags int32, from *SockaddrInet6) (n int32, err error) {
	rsa := sockaddrBuf()
	socklen := _Socklen(SizeofSockaddrAny)
	if n, err = recvfrom(fd, p, flags, rsa, &socklen); err != nil {
		return
	}
	from.Port = sockPort(rsa)
	from.ZoneId = abiGet32(rsa, sockIn6OffScope)
	copy(from.Addr[:], sockIPv6Addr(rsa))
	return
}

func recvmsgInet4(fd int32, p, oob []byte, flags int32, from *SockaddrInet4) (n, oobn int32, recvflags int32, err error) {
	rsa := sockaddrBuf()
	n, oobn, recvflags, err = recvmsgRaw(fd, p, oob, flags, rsa)
	if err != nil {
		return
	}
	from.Port = sockPort(rsa)
	copy(from.Addr[:], sockIPv4Addr(rsa))
	return
}

func recvmsgInet6(fd int32, p, oob []byte, flags int32, from *SockaddrInet6) (n, oobn int32, recvflags int32, err error) {
	rsa := sockaddrBuf()
	n, oobn, recvflags, err = recvmsgRaw(fd, p, oob, flags, rsa)
	if err != nil {
		return
	}
	from.Port = sockPort(rsa)
	from.ZoneId = abiGet32(rsa, sockIn6OffScope)
	copy(from.Addr[:], sockIPv6Addr(rsa))
	return
}

func Recvmsg(fd int32, p, oob []byte, flags int32) (n, oobn int32, recvflags int32, from Sockaddr, err error) {
	rsa := sockaddrBuf()
	n, oobn, recvflags, err = recvmsgRaw(fd, p, oob, flags, rsa)
	// source address is only specified if the socket is unconnected
	if sockFamily(rsa) != AF_UNSPEC {
		from, err = anyToSockaddr(rsa)
	}
	return
}

func Sendmsg(fd int32, p, oob []byte, to Sockaddr, flags int32) (err error) {
	_, err = SendmsgN(fd, p, oob, to, flags)
	return
}

func SendmsgN(fd int32, p, oob []byte, to Sockaddr, flags int32) (n int32, err error) {
	var buf []byte
	var salen _Socklen
	if to != nil {
		buf = sockaddrBuf()
		salen, err = to.sockaddr(buf)
		if err != nil {
			return 0, err
		}
	}
	return sendmsgN(fd, p, oob, abiBufferOf(buf), salen, flags)
}

func sendmsgNInet4(fd int32, p, oob []byte, to *SockaddrInet4, flags int32) (n int32, err error) {
	buf := sockaddrBuf()
	salen, err := to.sockaddr(buf)
	if err != nil {
		return 0, err
	}
	return sendmsgN(fd, p, oob, abiBufferOf(buf), salen, flags)
}

func sendmsgNInet6(fd int32, p, oob []byte, to *SockaddrInet6, flags int32) (n int32, err error) {
	buf := sockaddrBuf()
	salen, err := to.sockaddr(buf)
	if err != nil {
		return 0, err
	}
	return sendmsgN(fd, p, oob, abiBufferOf(buf), salen, flags)
}

func sendtoInet4(fd int32, p []byte, flags int32, to *SockaddrInet4) (err error) {
	buf := sockaddrBuf()
	n, err := to.sockaddr(buf)
	if err != nil {
		return err
	}
	return sendto(fd, p, flags, abiBufferOf(buf), n)
}

func sendtoInet6(fd int32, p []byte, flags int32, to *SockaddrInet6) (err error) {
	buf := sockaddrBuf()
	n, err := to.sockaddr(buf)
	if err != nil {
		return err
	}
	return sendto(fd, p, flags, abiBufferOf(buf), n)
}

func Sendto(fd int32, p []byte, flags int32, to Sockaddr) (err error) {
	var buf []byte
	var salen _Socklen
	if to != nil {
		buf = sockaddrBuf()
		salen, err = to.sockaddr(buf)
		if err != nil {
			return err
		}
	}
	return sendto(fd, p, flags, abiBufferOf(buf), salen)
}

func SetsockoptByte(fd, level, opt int32, value byte) (err error) {
	return setsockopt(fd, level, opt, unsafe.Pointer(&value), 1)
}

func SetsockoptInt(fd, level, opt int32, value int32) (err error) {
	var n = int32(value)
	return setsockopt(fd, level, opt, unsafe.Pointer(&n), 4)
}

func SetsockoptInet4Addr(fd, level, opt int32, value [4]byte) (err error) {
	return setsockopt(fd, level, opt, unsafe.Pointer(&value[0]), 4)
}

func SetsockoptIPMreq(fd, level, opt int32, mreq *IPMreq) (err error) {
	return setsockopt(fd, level, opt, unsafe.Pointer(mreq), SizeofIPMreq)
}

func SetsockoptIPv6Mreq(fd, level, opt int32, mreq *IPv6Mreq) (err error) {
	return setsockopt(fd, level, opt, unsafe.Pointer(mreq), SizeofIPv6Mreq)
}

func SetsockoptICMPv6Filter(fd, level, opt int32, filter *ICMPv6Filter) (rerr error) {
	return setsockopt(fd, level, opt, unsafe.Pointer(filter), SizeofICMPv6Filter)
}

func SetsockoptLinger(fd, level, opt int32, l *Linger) (err error) {
	return setsockopt(fd, level, opt, unsafe.Pointer(l), SizeofLinger)
}

func SetsockoptString(fd, level, opt int32, s string) (err error) {
	var p unsafe.Pointer
	if len(s) > 0 {
		p = unsafe.Pointer(&[]byte(s)[0])
	}
	return setsockopt(fd, level, opt, p, uintptr(len(s)))
}

func SetsockoptTimeval(fd, level, opt int32, tv *Timeval) (err error) {
	return setsockopt(fd, level, opt, unsafe.Pointer(tv), unsafe.Sizeof(*tv))
}

func Socket(domain, typ, proto int32) (fd int32, err error) {
	if domain == AF_INET6 && SocketDisableIPv6 {
		return -1, EAFNOSUPPORT
	}
	fd, err = socket(domain, typ, proto)
	return
}

func Socketpair(domain, typ, proto int32) (fd [2]int32, err error) {
	var fdx [2]int32
	err = socketpair(domain, typ, proto, &fdx)
	if err == nil {
		fd[0] = int32(fdx[0])
		fd[1] = int32(fdx[1])
	}
	return
}

func Sendfile(outfd int32, infd int32, offset *int64, count int32) (written int32, err error) {
	if race.Enabled {
		race.ReleaseMerge(unsafe.Pointer(&ioSync))
	}
	return sendfile(outfd, infd, offset, count)
}

var ioSync int64
