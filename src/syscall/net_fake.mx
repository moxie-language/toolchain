//:build js && wasm

// Socket address types and the socket constants for the js/wasm target,
// mirroring $GOROOT/src/syscall/net_fake.go.
//
// The constants are part of the same file upstream and are the reason net's js
// arm did not compile: without them every `syscall.AF_INET`-style argument
// failed to resolve, the builder DROPPED the argument from the call, and the
// arity check then reported "not enough arguments in call (want 8, have 7)" in
// *_posix.mx - a misleading symptom that pointed at the callers, not at the
// missing constants. Go declares them with iota; the values here are what those
// iota blocks produce.
//
// Go also declares `type Sockaddr any` here. Moxie has no empty interface, so
// that cannot be ported literally. The interface below has the same shape the
// unix build uses (one unexported method, so only this package can define a
// Sockaddr), and the js implementations report ENOSYS because this target has no
// sockets: every function in net_js.mx returns ENOSYS too.
//
// The Addr fields stay arrays, exactly as Go declares them and as the unix
// definitions in syscall_unix.mx do: they are address layout, not a slice
// bypass.
package syscall

const (
	AF_UNSPEC = 0x0
	AF_UNIX   = 0x1
	AF_INET   = 0x2
	AF_INET6  = 0x3
)

const (
	SOCK_STREAM    = 0x1
	SOCK_DGRAM     = 0x2
	SOCK_RAW       = 0x3
	SOCK_SEQPACKET = 0x4
)

const (
	IPPROTO_IP   = 0x0
	IPPROTO_IPV4 = 0x4
	IPPROTO_IPV6 = 0x29
	IPPROTO_TCP  = 0x6
	IPPROTO_UDP  = 0x11
)

const (
	SOMAXCONN = 0x80
)

const (
	IPV6_V6ONLY = 0x1
	SO_ERROR    = 0x2
)

// Misc constants expected by package net but not supported.
const (
	F_DUPFD_CLOEXEC = 0x1
	SYS_FCNTL       = 500
)

type Sockaddr interface {
	sockaddr(buf []byte) (slen uint32, err error)
}

type SockaddrInet4 struct {
	Port int32
	Addr []byte
}

// NewSockaddrInet4 has the unix build's shape (syscall_unix.mx): the Addr
// buffer is allocated at its ABI length and filled from addr. net's
// udpsock_posix.mx is compiled on js/wasm too and calls this, so without it the
// call had no target, its argument silently disappeared, and the arity check
// reported the shifted call - "not enough arguments in call (want 1, have 0)"
// at the caller, and then "Port undefined (type int32 ...)" one line later.
func NewSockaddrInet4(port int32, addr []byte) (sa SockaddrInet4) {
	sa.Addr = []byte{:4}
	sa.Port = port
	copy(sa.Addr, addr)
	return
}

func (sa *SockaddrInet4) sockaddr(buf []byte) (slen uint32, err error) {
	return 0, ENOSYS
}

type SockaddrInet6 struct {
	Port   int32
	ZoneId uint32
	Addr   []byte
}

// NewSockaddrInet6 is NewSockaddrInet4's IPv6 twin.
func NewSockaddrInet6(port int32, zoneId uint32, addr []byte) (sa SockaddrInet6) {
	sa.Addr = []byte{:16}
	sa.Port = port
	sa.ZoneId = zoneId
	copy(sa.Addr, addr)
	return
}

func (sa *SockaddrInet6) sockaddr(buf []byte) (slen uint32, err error) {
	return 0, ENOSYS
}

type SockaddrUnix struct {
	Name string
}

func (sa *SockaddrUnix) sockaddr(buf []byte) (slen uint32, err error) {
	return 0, ENOSYS
}
