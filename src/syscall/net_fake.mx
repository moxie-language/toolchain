//:build js && wasm

// Socket address types for the js/wasm target, mirroring
// $GOROOT/src/syscall/net_fake.go.
//
// Go declares `type Sockaddr any` here. Moxie has no empty interface, so that
// cannot be ported literally - which is why this file was missing and why
// syscall.Sockaddr did not resolve for js at all. The interface below has the
// same shape the unix build uses (one unexported method, so only this package
// can define a Sockaddr), and the js implementations report ENOSYS because this
// target has no sockets: every function in net_js.mx returns ENOSYS too.
//
// The Addr fields stay arrays, exactly as Go declares them and as the unix
// definitions in syscall_unix.mx do: they are address layout, not a slice
// bypass.
package syscall

import "unsafe"

type Sockaddr interface {
	sockaddr() (ptr unsafe.Pointer, slen uint32, err error)
}

type SockaddrInet4 struct {
	Port int32
	Addr [4]byte
}

func (sa *SockaddrInet4) sockaddr() (ptr unsafe.Pointer, slen uint32, err error) {
	return nil, 0, ENOSYS
}

type SockaddrInet6 struct {
	Port   int32
	ZoneId uint32
	Addr   [16]byte
}

func (sa *SockaddrInet6) sockaddr() (ptr unsafe.Pointer, slen uint32, err error) {
	return nil, 0, ENOSYS
}

type SockaddrUnix struct {
	Name string
}

func (sa *SockaddrUnix) sockaddr() (ptr unsafe.Pointer, slen uint32, err error) {
	return nil, 0, ENOSYS
}
