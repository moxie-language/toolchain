package zip

import (
	"compress/flate"
	"errors"
	"io"
)

// A Compressor returns a new compressing writer, writing to w.
// The WriteCloser's Close method must be used to flush pending data to w.
type Compressor func(w io.Writer) (wc io.WriteCloser, cerr error)

// A Decompressor returns a new decompressing reader, reading from r.
// The [io.ReadCloser]'s Close method must be used to release associated resources.
type Decompressor func(r io.Reader) (rc io.ReadCloser)

func newFlateWriter(w io.Writer) (wc io.WriteCloser) {
	fw, _ := flate.NewWriter(w, 5)
	return &pooledFlateWriter{fw: fw}
}

type pooledFlateWriter struct {
	fw *flate.Writer
}

func (w *pooledFlateWriter) Write(p []byte) (n int32, err error) {
	if w.fw == nil {
		return 0, errors.New("Write after Close")
	}
	return w.fw.Write(p)
}

func (w *pooledFlateWriter) Close() (cerr error) {
	var err error
	if w.fw != nil {
		err = w.fw.Close()
		w.fw = nil
	}
	return err
}

func newFlateReader(r io.Reader) (rc io.ReadCloser) {
	return &pooledFlateReader{fr: flate.NewReader(r)}
}

type pooledFlateReader struct {
	fr io.ReadCloser
}

func (r *pooledFlateReader) Read(p []byte) (n int32, err error) {
	if r.fr == nil {
		return 0, errors.New("Read after Close")
	}
	return r.fr.Read(p)
}

func (r *pooledFlateReader) Close() (cerr error) {
	var err error
	if r.fr != nil {
		err = r.fr.Close()
		r.fr = nil
	}
	return err
}

func compressor(method uint16) (comp Compressor) {
	switch method {
	case Store:
		return func(w io.Writer) (wc io.WriteCloser, cerr error) { return &nopCloser{w}, nil }
	case Deflate:
		return func(w io.Writer) (wc io.WriteCloser, cerr error) { return newFlateWriter(w), nil }
	}
	return nil
}

func decompressor(method uint16) (dcomp Decompressor) {
	switch method {
	case Store:
		return Decompressor(io.NopCloser)
	case Deflate:
		return Decompressor(newFlateReader)
	}
	return nil
}
