//:build unix

package tar

import (
	"io/fs"
	"os/user"
	"strconv"
	"syscall"
)

var _userMapDone bool
var _userMap map[int32][]byte

// initUserMap lazily creates the uid -> user name cache. The function name
// starts with "init" because it stores into package globals, which Moxie
// permits only in init-like functions.
func initUserMap() (m map[int32][]byte) {
	if !_userMapDone {
		_userMapDone = true
		_userMap = map[int32][]byte{}
	}
	return _userMap
}

var _groupMapDone bool
var _groupMap map[int32][]byte

// initGroupMap lazily creates the gid -> group name cache.
func initGroupMap() (m map[int32][]byte) {
	if !_groupMapDone {
		_groupMapDone = true
		_groupMap = map[int32][]byte{}
	}
	return _groupMap
}

func sysStat(fi fs.FileInfo, h *Header, doNameLookups bool) (werr error) {
	sys := (*syscall.Stat_t)(fi.Sys())
	if sys == nil {
		return nil
	}
	h.Uid = int32(sys.Uid)
	h.Gid = int32(sys.Gid)
	if doNameLookups {
		// Best effort at populating Uname and Gname.
		// The os/user functions may fail for any number of reasons
		// (not implemented on that platform, cgo not enabled, etc).
		um := initUserMap()
		if u, ok := um[h.Uid]; ok {
			h.Uname = u
		} else if u2, err := user.LookupId(strconv.Itoa(h.Uid)); err == nil {
			h.Uname = u2.Username
			um[h.Uid] = h.Uname
		}
		gm := initGroupMap()
		if g, ok := gm[h.Gid]; ok {
			h.Gname = g
		} else if g2, err := user.LookupGroupId(strconv.Itoa(h.Gid)); err == nil {
			h.Gname = g2.Name
			gm[h.Gid] = h.Gname
		}
	}
	h.AccessTime = statAtime(sys)
	h.ChangeTime = statCtime(sys)

	// Best effort at populating Devmajor and Devminor.
	if h.Typeflag == TypeChar || h.Typeflag == TypeBlock {
		dev := uint64(sys.Rdev) // May be int32 or uint32
		major := uint32((dev & 0x00000000000fff00) >> 8)
		major |= uint32((dev & 0xfffff00000000000) >> 32)
		minor := uint32((dev & 0x00000000000000ff) >> 0)
		minor |= uint32((dev & 0x00000ffffff00000) >> 12)
		h.Devmajor, h.Devminor = int64(major), int64(minor)
	}
	return nil
}
