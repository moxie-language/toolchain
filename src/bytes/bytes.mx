// Package bytes implements functions for the manipulation of byte slices.
// It is analogous to the facilities of the [strings] package.
package bytes

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"internal/bytealg"
	"math/bits"
	"unicode/utf8"
)

// Equal reports whether a and b
// are the same length and contain the same bytes.
// A nil argument is equivalent to an empty slice.
func Equal(a, b []byte) (okay bool) {
	return bytealg.Equal(a, b)
}

// Repeat returns a new byte slice consisting of count copies of b.
//
// It panics if count is negative or if the result of (len(b) * count)
// overflows.
func Repeat(b []byte, count int32) (ret []byte) {
	if count == 0 {
		return []byte{}
	}

	// Since we cannot return an error on overflow,
	// we should panic if the repeat will generate an overflow.
	// See golang.org/issue/16237.
	if count < 0 {
		panic("bytes: negative Repeat count")
	}
	hi, lo := bits.Mul(uint32(len(b)), uint32(count))
	if hi > 0 || lo > uint32(maxInt) {
		panic("bytes: Repeat output length overflow")
	}
	n := int32(lo) // lo = len(b) * count

	if len(b) == 0 {
		return []byte{}
	}

	// Past a certain chunk size it is counterproductive to use
	// larger chunks as the source of the write, as when the source
	// is too large we are basically just thrashing the CPU D-cache.
	// So if the result length is larger than an empirically-found
	// limit (8KB), we stop growing the source string once the limit
	// is reached and keep reusing the same source string - that
	// should therefore be always resident in the L1 cache - until we
	// have completed the construction of the result.
	// This yields significant speedups (up to +100%) in cases where
	// the result length is large (roughly, over L2 cache size).
	const chunkLimit = 8 * 1024
	chunkMax := n
	if chunkMax > chunkLimit {
		chunkMax = chunkLimit / len(b) * len(b)
		if chunkMax == 0 {
			chunkMax = len(b)
		}
	}
	nb := bytealg.MakeNoZero(n)[:n:n]
	bp := copy(nb, b)
	for bp < n {
		chunk := min(bp, chunkMax)
		bp += mxutil.CopyAt(nb, bp, nb[:chunk])
	}
	return nb
}

// Compare returns an integer comparing two byte slices lexicographically.
// The result will be 0 if a == b, -1 if a < b, and +1 if a > b.
// A nil argument is equivalent to an empty slice.
func Compare(a, b []byte) (ret int32) {
	return bytealg.Compare(a, b)
}

// explode splits s into a slice of UTF-8 sequences, one per Unicode code point (still slices of bytes),
// up to a maximum of n byte slices. Invalid UTF-8 sequences are chopped into individual bytes.
func explode(s []byte, n int32) (ret [][]byte) {
	if n <= 0 || n > len(s) {
		n = len(s)
	}
	a := [][]byte{:n}
	var size int32
	na := 0
	off := int32(0)
	for off < len(s) {
		if na+1 >= n {
			a[na] = s[off:]
			na++
			break
		}
		_, size = utf8.DecodeRuneInStringAt(s, off)
		a[na] = s[off : off+size : off+size]
		off += size
		na++
	}
	return a[0:na]
}

// Count counts the number of non-overlapping instances of sep in s.
// If sep is an empty slice, Count returns 1 + the number of UTF-8-encoded code points in s.
func Count(s, sep []byte) (ret int32) {
	// special case
	if len(sep) == 0 {
		return utf8.RuneCount(s) + 1
	}
	if len(sep) == 1 {
		return bytealg.Count(s, sep[0])
	}
	n := 0
	// off walks s: `s = s[i+len(sep):]` per match is a copy of the rest.
	off := int32(0)
	for {
		i := bytealg.IndexFrom(s, sep, off)
		if i == -1 {
			return n
		}
		n++
		off = i + len(sep)
	}
}

// Contains reports whether subslice is within b.
func Contains(b, subslice []byte) (okay bool) {
	return Index(b, subslice) != -1
}

// ContainsAny reports whether any of the UTF-8-encoded code points in chars are within b.
func ContainsAny(b []byte, chars []byte) (okay bool) {
	return IndexAny(b, chars) >= 0
}

// ContainsRune reports whether the rune is contained in the UTF-8-encoded byte slice b.
func ContainsRune(b []byte, r rune) (okay bool) {
	return IndexRune(b, r) >= 0
}

// ContainsFunc reports whether any of the UTF-8-encoded code points r within b satisfy f(r).
func ContainsFunc(b []byte, f func(rune) bool) (okay bool) {
	return IndexFunc(b, f) >= 0
}

// IndexByte returns the index of the first instance of c in b, or -1 if c is not present in b.
func IndexByte(b []byte, c byte) (ret int32) {
	return bytealg.IndexByte(b, c)
}

// IndexByteFrom returns the index of the first instance of c in b at or after
// from, or -1 if c is not present. A parser that walks a buffer keeps an
// offset instead of trimming the slice: a sub-slice is a copy, so searching
// b[from:] would allocate and copy the whole remainder at every step.
func IndexByteFrom(b []byte, from int32, c byte) (ret int32) {
	if from < 0 {
		from = 0
	}
	for i := from; i < len(b); i++ {
		if b[i] == c {
			return i
		}
	}
	return -1
}

func indexBytePortable(s []byte, c byte) (ret int32) {
	for i, b := range s {
		if b == c {
			return i
		}
	}
	return -1
}

// LastIndex returns the index of the last instance of sep in s, or -1 if sep is not present in s.
func LastIndex(s, sep []byte) (ret int32) {
	n := len(sep)
	switch {
	case n == 0:
		return len(s)
	case n == 1:
		return bytealg.LastIndexByte(s, sep[0])
	case n == len(s):
		if Equal(s, sep) {
			return 0
		}
		return -1
	case n > len(s):
		return -1
	}
	return bytealg.LastIndexRabinKarp(s, sep)
}

// LastIndexByte returns the index of the last instance of c in s, or -1 if c is not present in s.
func LastIndexByte(s []byte, c byte) (ret int32) {
	return bytealg.LastIndexByte(s, c)
}

// IndexRune interprets s as a sequence of UTF-8-encoded code points.
// It returns the byte index of the first occurrence in s of the given rune.
// It returns -1 if rune is not present in s.
// If r is [utf8.RuneError], it returns the first instance of any
// invalid UTF-8 byte sequence.
// IndexRuneFrom is IndexRune from a byte offset, for a cursor that walks a
// buffer instead of trimming it.
func IndexRuneFrom(s []byte, from int32, r rune) (ret int32) {
	if r < utf8.RuneSelf {
		return IndexByteFrom(s, from, byte(r))
	}
	for i := from; i < len(s); {
		runeAt, size := utf8.DecodeRuneInStringAt(s, i)
		if runeAt == r {
			return i
		}
		i += size
	}
	return -1
}

func IndexRune(s []byte, r rune) (ret int32) {
	const haveFastIndex = bytealg.MaxBruteForce > 0
	switch {
	case 0 <= r && r < utf8.RuneSelf:
		return IndexByte(s, byte(r))
	case r == utf8.RuneError:
		for i := 0; i < len(s); {
			r1, n := utf8.DecodeRuneInStringAt(s, i)
			if r1 == utf8.RuneError {
				return i
			}
			i += n
		}
		return -1
	case !utf8.ValidRune(r):
		return -1
	default:
		// Search for rune r using the last byte of its UTF-8 encoded form.
		// The distribution of the last byte is more uniform compared to the
		// first byte which has a 78% chance of being [240, 243, 244].
		var b [utf8.UTFMax]byte
		n := utf8.EncodeRuneAt(b[:], 0, r)
		last := n - 1
		i := last
		fails := 0
		for i < len(s) {
			if s[i] != b[last] {
				o := IndexByte(s[i+1:], b[last])
				if o < 0 {
					return -1
				}
				i += o + 1
			}
			// Step backwards comparing bytes.
			for j := 1; j < n; j++ {
				if s[i-j] != b[last-j] {
					goto next
				}
			}
			return i - last
		next:
			fails++
			i++
			if (haveFastIndex && fails > bytealg.Cutover(i)) && i < len(s) ||
				(!haveFastIndex && fails >= 4+i>>4 && i < len(s)) {
				goto fallback
			}
		}
		return -1

	fallback:
		// Switch to bytealg.Index, if available, or a brute force search when
		// IndexByte returns too many false positives.
		if haveFastIndex {
			if j := bytealg.Index(s[i-last:], b[:n]); j >= 0 {
				return i + j - last
			}
		} else {
			// If bytealg.Index is not available a brute force search is
			// ~1.5-3x faster than Rabin-Karp since n is small.
			c0 := b[last]
			c1 := b[last-1] // There are at least 2 chars to match
		loop:
			for ; i < len(s); i++ {
				if s[i] == c0 && s[i-1] == c1 {
					for k := 2; k < n; k++ {
						if s[i-k] != b[last-k] {
							continue loop
						}
					}
					return i - last
				}
			}
		}
		return -1
	}
}

// IndexAny interprets s as a sequence of UTF-8-encoded Unicode code points.
// It returns the byte index of the first occurrence in s of any of the Unicode
// code points in chars. It returns -1 if chars is empty or if there is no code
// point in common.
// IndexAnyFrom is IndexAny from a byte offset, for a cursor that walks a
// buffer instead of trimming it.
func IndexAnyFrom(s []byte, from int32, chars []byte) (ret int32) {
	if chars == "" {
		return -1
	}
	for i := from; i < len(s); {
		r, size := utf8.DecodeRuneInStringAt(s, i)
		for ci := int32(0); ci < len(chars); {
			cr, cw := utf8.DecodeRuneInStringAt(chars, ci)
			if cr == r {
				return i
			}
			ci += cw
		}
		i += size
	}
	return -1
}

func IndexAny(s []byte, chars []byte) (ret int32) {
	if chars == "" {
		// Avoid scanning all of s.
		return -1
	}
	if len(s) == 1 {
		r := rune(s[0])
		if r >= utf8.RuneSelf {
			// search utf8.RuneError.
			for ci := int32(0); ci < len(chars); {
				cr, cw := utf8.DecodeRuneInStringAt(chars, ci)
				if cr == utf8.RuneError {
					return 0
				}
				ci += cw
			}
			return -1
		}
		if bytealg.IndexByteString(chars, s[0]) >= 0 {
			return 0
		}
		return -1
	}
	if len(chars) == 1 {
		r := rune(chars[0])
		if r >= utf8.RuneSelf {
			r = utf8.RuneError
		}
		return IndexRune(s, r)
	}
	if len(s) > 8 {
		if as, isASCII := makeASCIISet(chars); isASCII {
			for i, c := range s {
				if as.contains(c) {
					return i
				}
			}
			return -1
		}
	}
	var width int32
	for i := 0; i < len(s); i += width {
		r := rune(s[i])
		if r < utf8.RuneSelf {
			if bytealg.IndexByteString(chars, s[i]) >= 0 {
				return i
			}
			width = 1
			continue
		}
		r, width = utf8.DecodeRuneInStringAt(s, i)
		if r != utf8.RuneError {
			// r is 2 to 4 bytes
			if len(chars) == width {
				if Equal(chars, s[i:i+width]) {
					return i
				}
				continue
			}
			// Use bytealg.IndexString for performance if available.
			if bytealg.MaxLen >= width {
				if bytealg.IndexString(chars, s[i:i+width]) >= 0 {
					return i
				}
				continue
			}
		}
		for ci := int32(0); ci < len(chars); {
			ch, cw := utf8.DecodeRuneInStringAt(chars, ci)
			if r == ch {
				return i
			}
			ci += cw
		}
	}
	return -1
}

// LastIndexAny interprets s as a sequence of UTF-8-encoded Unicode code
// points. It returns the byte index of the last occurrence in s of any of
// the Unicode code points in chars. It returns -1 if chars is empty or if
// there is no code point in common.
func LastIndexAny(s []byte, chars []byte) (ret int32) {
	if chars == "" {
		// Avoid scanning all of s.
		return -1
	}
	if len(s) > 8 {
		if as, isASCII := makeASCIISet(chars); isASCII {
			for i := len(s) - 1; i >= 0; i-- {
				if as.contains(s[i]) {
					return i
				}
			}
			return -1
		}
	}
	if len(s) == 1 {
		r := rune(s[0])
		if r >= utf8.RuneSelf {
			for ci := int32(0); ci < len(chars); {
				cr, cw := utf8.DecodeRuneInStringAt(chars, ci)
				if cr == utf8.RuneError {
					return 0
				}
				ci += cw
			}
			return -1
		}
		if bytealg.IndexByteString(chars, s[0]) >= 0 {
			return 0
		}
		return -1
	}
	if len(chars) == 1 {
		cr := rune(chars[0])
		if cr >= utf8.RuneSelf {
			cr = utf8.RuneError
		}
		for i := len(s); i > 0; {
			r, size := utf8.DecodeLastRuneInStringAt(s, i)
			i -= size
			if r == cr {
				return i
			}
		}
		return -1
	}
	for i := len(s); i > 0; {
		r := rune(s[i-1])
		if r < utf8.RuneSelf {
			if bytealg.IndexByteString(chars, s[i-1]) >= 0 {
				return i - 1
			}
			i--
			continue
		}
		r, size := utf8.DecodeLastRuneInStringAt(s, i)
		i -= size
		if r != utf8.RuneError {
			// r is 2 to 4 bytes
			if len(chars) == size {
				if Equal(chars, s[i:i+size]) {
					return i
				}
				continue
			}
			// Use bytealg.IndexString for performance if available.
			if bytealg.MaxLen >= size {
				if bytealg.IndexString(chars, s[i:i+size]) >= 0 {
					return i
				}
				continue
			}
		}
		for ci := int32(0); ci < len(chars); {
			ch, cw := utf8.DecodeRuneInStringAt(chars, ci)
			if r == ch {
				return i
			}
			ci += cw
		}
	}
	return -1
}

// Generic split: splits after each instance of sep,
// including sepSave bytes of sep in the subslices.
func genSplit(s, sep []byte, sepSave, n int32) (ret [][]byte) {
	if n == 0 {
		return nil
	}
	if len(sep) == 0 {
		return explode(s, n)
	}
	if n < 0 {
		n = Count(s, sep) + 1
	}
	if n > len(s)+1 {
		n = len(s) + 1
	}

	a := [][]byte{:n}
	n--
	i := 0
	off := int32(0)
	for i < n {
		m := bytealg.IndexFrom(s, sep, off)
		if m < 0 {
			break
		}
		a[i] = s[off : m+sepSave : m+sepSave]
		off = m + len(sep)
		i++
	}
	a[i] = s[off:]
	return a[:i+1]
}

// SplitN slices s into subslices separated by sep and returns a slice of
// the subslices between those separators.
// If sep is empty, SplitN splits after each UTF-8 sequence.
// The count determines the number of subslices to return:
//   - n > 0: at most n subslices; the last subslice will be the unsplit remainder;
//   - n == 0: the result is nil (zero subslices);
//   - n < 0: all subslices.
//
// To split around the first instance of a separator, see [Cut].
func SplitN(s, sep []byte, n int32) (ret [][]byte) { return genSplit(s, sep, 0, n) }

// SplitAfterN slices s into subslices after each instance of sep and
// returns a slice of those subslices.
// If sep is empty, SplitAfterN splits after each UTF-8 sequence.
// The count determines the number of subslices to return:
//   - n > 0: at most n subslices; the last subslice will be the unsplit remainder;
//   - n == 0: the result is nil (zero subslices);
//   - n < 0: all subslices.
func SplitAfterN(s, sep []byte, n int32) (ret [][]byte) {
	return genSplit(s, sep, len(sep), n)
}

// Split slices s into all subslices separated by sep and returns a slice of
// the subslices between those separators.
// If sep is empty, Split splits after each UTF-8 sequence.
// It is equivalent to SplitN with a count of -1.
//
// To split around the first instance of a separator, see [Cut].
func Split(s, sep []byte) (ret [][]byte) { return genSplit(s, sep, 0, -1) }

// SplitAfter slices s into all subslices after each instance of sep and
// returns a slice of those subslices.
// If sep is empty, SplitAfter splits after each UTF-8 sequence.
// It is equivalent to SplitAfterN with a count of -1.
func SplitAfter(s, sep []byte) (ret [][]byte) {
	return genSplit(s, sep, len(sep), -1)
}

func _asciiSpace() (ret []uint8) {
	// 256 entries, not the 33 a keyed slice literal would produce: callers
	// index this by any byte value.
	ret = []uint8{:256}
	ret['\t'] = 1
	ret['\n'] = 1
	ret['\v'] = 1
	ret['\f'] = 1
	ret['\r'] = 1
	ret[' '] = 1
	return ret
}

// Fields interprets s as a sequence of UTF-8-encoded code points.
