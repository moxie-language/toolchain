package bytes

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"io"
)

// Replacer replaces a list of strings with replacements.
// It is safe for concurrent use by multiple goroutines.
type Replacer struct {
	done   bool // guards buildOnce method
	r      replacer
	oldnew [][]byte
}

// replacer is the interface that a replacement algorithm needs to implement.
type replacer interface {
	Replace(s []byte) []byte
	WriteString(w io.Writer, s []byte) (n int32, err error)
}

// NewReplacer returns a new [Replacer] from a list of old, new string
// pairs. Replacements are performed in the order they appear in the
// target string, without overlapping matches. The old string
// comparisons are done in argument order.
//
// NewReplacer panics if given an odd number of arguments.
func NewReplacer(oldnew ...[]byte) (rep *Replacer) {
	if len(oldnew)%2 == 1 {
		panic("bytes.NewReplacer: odd argument count")
	}
	return &Replacer{oldnew: push([][]byte(nil), oldnew...)}
}

func (r *Replacer) buildOnce() {
	r.r = r.build()
	r.oldnew = nil
}

func (b *Replacer) build() (rp replacer) {
	oldnew := b.oldnew
	if len(oldnew) == 2 && len(oldnew[0]) > 1 {
		return makeSingleStringReplacer(oldnew[0], oldnew[1])
	}

	allNewBytes := true
	for i := 0; i < len(oldnew); i += 2 {
		if len(oldnew[i]) != 1 {
			return makeGenericReplacer(oldnew)
		}
		if len(oldnew[i+1]) != 1 {
			allNewBytes = false
		}
	}

	if allNewBytes {
		br := byteReplacer{r: []byte{:256}}
		for i := range br.r {
			br.r[i] = byte(i)
		}
		// The first occurrence of old->new map takes precedence
		// over the others with the same old string.
		for i := len(oldnew) - 2; i >= 0; i -= 2 {
			o := oldnew[i][0]
			n := oldnew[i+1][0]
			br.r[o] = n
		}
		return &br
	}

	r := byteStringReplacer{
		replacements: [][]byte{:256},
		present:      []bool{:256},
		toReplace:    [][]byte{:0:len(oldnew) / 2},
	}
	// The first occurrence of old->new map takes precedence
	// over the others with the same old string.
	for i := len(oldnew) - 2; i >= 0; i -= 2 {
		o := oldnew[i][0]
		n := oldnew[i+1]
		// To avoid counting repetitions multiple times.
		if !r.present[o] {
			// We need to use string([]byte{o}) instead of string(o),
			// to avoid utf8 encoding of o.
			// E. g. byte(150) produces string of length 2.
			r.toReplace = mxutil.Ensure(r.toReplace, 1)
			r.toReplace = push(r.toReplace, []byte([]byte{o}))
		}
		r.replacements[o] = []byte(n)
		r.present[o] = true

	}
	return &r
}

// Replace returns a copy of s with all replacements performed.
func (r *Replacer) Replace(s []byte) (out []byte) {
	if !r.done { r.done = true; r.buildOnce() }
	return r.r.Replace(s)
}

// WriteString writes s to w with all replacements performed.
func (r *Replacer) WriteString(w io.Writer, s []byte) (n int32, err error) {
	if !r.done { r.done = true; r.buildOnce() }
	return r.r.WriteString(w, s)
}

// trieNode is a node in a lookup trie for prioritized key/value pairs. Keys
// and values may be empty. For example, the trie containing keys "ax", "ay",
// "bcbc", "x" and "xy" could have eight nodes:
//
//	n0  -
//	n1  a-
//	n2  .x+
//	n3  .y+
//	n4  b-
//	n5  .cbc+
//	n6  x+
//	n7  .y+
//
// n0 is the root node, and its children are n1, n4 and n6; n1's children are
// n2 and n3; n4's child is n5; n6's child is n7. Nodes n0, n1 and n4 (marked
// with a trailing "-") are partial keys, and nodes n2, n3, n5, n6 and n7
// (marked with a trailing "+") are complete keys.
type trieNode struct {
	// value is the value of the trie node's key/value pair. It is empty if
	// this node is not a complete key.
	value []byte
	// priority is the priority (higher is more important) of the trie node's
	// key/value pair; keys are not necessarily matched shortest- or longest-
	// first. Priority is positive if this node is a complete key, and zero
	// otherwise. In the example above, positive/zero priorities are marked
	// with a trailing "+" or "-".
	priority int32

	// A trie node may have zero, one or more child nodes:
	//  * if the remaining fields are zero, there are no children.
	//  * if prefix and next are non-zero, there is one child in next.
	//  * if table is non-zero, it defines all the children.
	//
	// Prefixes are preferred over tables when there is one child, but the
	// root node always uses a table for lookup efficiency.

	// prefix is the difference in keys between this trie node and the next.
	// In the example above, node n4 has prefix "cbc" and n4's next node is n5.
	// Node n5 has no children and so has zero prefix, next and table fields.
	prefix []byte
	next   *trieNode

	// table is a lookup table indexed by the next byte in the key, after
	// remapping that byte through genericReplacer.mapping to create a dense
	// index. In the example above, the keys only use 'a', 'b', 'c', 'x' and
	// 'y', which remap to 0, 1, 2, 3 and 4. All other bytes remap to 5, and
	// genericReplacer.tableSize will be 5. Node n0's table will be
	// []*trieNode{ 0:n1, 1:n4, 3:n6 }, where the 0, 1 and 3 are the remapped
	// 'a', 'b' and 'x'.
	table []*trieNode
}

// trieAdd inserts key=val into the trie at t.
//
// A free function, not a method on trieNode: a mutating method borrows the
// receiver's sovereign arena, so every node the insertion allocates lands in
// the arena of the node it hangs off - a tree scattered over one arena per
// node, which cannot be relocated as one value. The replacer is built in a
// frame and returned, so the nodes must be in that frame and move with it;
// `add` as a method left the deeper nodes behind in groups keyed by the
// addresses of the copies' originals, and lookup read a dead node's priority
// as zero (bytes.NewReplacer with two multi-byte keys replaced nothing).
func trieAdd(t *trieNode, key, val []byte, priority int32, r *genericReplacer) {
	if key == "" {
		if t.priority == 0 {
			t.value = val
			t.priority = priority
		}
		return
	}

	if t.prefix != "" {
		// Need to split the prefix among multiple nodes.
		var n int32 // length of the longest common prefix
		for ; n < len(t.prefix) && n < len(key); n++ {
			if t.prefix[n] != key[n] {
				break
			}
		}
		if n == len(t.prefix) {
			trieAdd(t.next, key[n:], val, priority, r)
		} else if n == 0 {
			// First byte differs, start a new lookup table here. Looking up
			// what is currently t.prefix[0] will lead to prefixNode, and
			// looking up key[0] will lead to keyNode.
			var prefixNode *trieNode
			if len(t.prefix) == 1 {
				prefixNode = t.next
			} else {
				prefixNode = &trieNode{
					prefix: t.prefix[1:],
					next:   t.next,
				}
			}
			keyNode := &trieNode{}
			t.table = []*trieNode{:r.tableSize}
			t.table[r.mapping[t.prefix[0]]] = prefixNode
			t.table[r.mapping[key[0]]] = keyNode
			t.prefix = ""
			t.next = nil
			trieAdd(keyNode, key[1:], val, priority, r)
		} else {
			// Insert new node after the common section of the prefix.
			next := &trieNode{
				prefix: t.prefix[n:],
				next:   t.next,
			}
			t.prefix = resize(t.prefix, n)
			t.next = next
			trieAdd(next, key[n:], val, priority, r)
		}
	} else if t.table != nil {
		// Insert into existing table.
		m := r.mapping[key[0]]
		if t.table[m] == nil {
			t.table[m] = &trieNode{}
		}
		trieAdd(t.table[m], key[1:], val, priority, r)
	} else {
		t.prefix = key
		t.next = &trieNode{}
		trieAdd(t.next, "", val, priority, r)
	}
}

// hasPrefixAt reports whether s[ip:] starts with prefix, without slicing s.
func hasPrefixAt(s []byte, ip int32, prefix []byte) (ok bool) {
	if len(s)-ip < len(prefix) {
		return false
	}
	for k := int32(0); k < len(prefix); k++ {
		if s[ip+k] != prefix[k] {
			return false
		}
	}
	return true
}

func (r *genericReplacer) lookup(s []byte, ignoreRoot bool) (val []byte, keylen int32, found bool) {
	// Iterate down the trie to the end, and grab the value and keylen with
	// the highest priority. ip walks s: the trie descent trimmed one key at a
	// time, and a trim is a copy of the whole remaining input.
	bestPriority := 0
	node := &r.root
	n := 0
	ip := int32(0)
	for node != nil {
		if node.priority > bestPriority && !(ignoreRoot && node == &r.root) {
			bestPriority = node.priority
			val = node.value
			keylen = n
			found = true
		}

		if ip == len(s) {
			break
		}
		if node.table != nil {
			index := r.mapping[s[ip]]
			if int32(index) == r.tableSize {
				break
			}
			node = node.table[index]
			ip++
			n++
		} else if node.prefix != "" && hasPrefixAt(s, ip, node.prefix) {
			n += len(node.prefix)
			ip += len(node.prefix)
			node = node.next
		} else {
			break
		}
	}
	return
}

// genericReplacer is the fully generic algorithm.
// It's used as a fallback when nothing faster can be used.
type genericReplacer struct {
	root trieNode
	// tableSize is the size of a trie node's lookup table. It is the number
	// of unique key bytes.
	tableSize int32
	// mapping maps from key bytes to a dense index for trieNode.table.
	mapping []byte
}

func makeGenericReplacer(oldnew [][]byte) (rep *genericReplacer) {
	r := &genericReplacer{mapping: []byte{:256}}
	// Find each byte used, then assign them each an index.
	for i := 0; i < len(oldnew); i += 2 {
		key := oldnew[i]
		for j := 0; j < len(key); j++ {
			r.mapping[key[j]] = 1
		}
	}

	for _, b := range r.mapping {
		r.tableSize += int32(b)
	}

	var index byte
	for i, b := range r.mapping {
		if b == 0 {
			r.mapping[i] = byte(r.tableSize)
		} else {
			r.mapping[i] = index
			index++
		}
	}
	// Ensure root node uses a lookup table (for performance).
	r.root.table = []*trieNode{:r.tableSize}

	for i := 0; i < len(oldnew); i += 2 {
		trieAdd(&r.root, oldnew[i], oldnew[i+1], len(oldnew)-i, r)
	}
	return r
}

type stringWriter struct {
	w io.Writer
}

func (w *stringWriter) WriteString(s []byte) (n int32, rerr error) {
	return w.w.Write([]byte(s))
}

func getStringWriter(w io.Writer) (out io.StringWriter) {
	sw, ok := w.(io.StringWriter)
	if !ok {
		sw = &stringWriter{w}
	}
	return sw
}

func (r *genericReplacer) Replace(s []byte) (out []byte) {
	var buf Buffer
	r.WriteString(&buf, s)
	return buf.Bytes()
}

func (r *genericReplacer) WriteString(w io.Writer, s []byte) (n int32, err error) {
	sw := getStringWriter(w)
	var last, wn int32
	var prevMatchEmpty bool
	for i := 0; i <= len(s); {
		// Fast path: s[i] is not a prefix of any pattern.
		if i != len(s) && r.root.priority == 0 {
			index := int32(r.mapping[s[i]])
			if index == r.tableSize || r.root.table[index] == nil {
				i++
				continue
			}
		}

		// Ignore the empty match iff the previous loop found the empty match.
		val, keylen, match := r.lookup(s[i:], prevMatchEmpty)
		prevMatchEmpty = match && keylen == 0
		if match {
			wn, err = sw.WriteString(s[last:i])
			n += wn
			if err != nil {
				return
			}
			wn, err = sw.WriteString(val)
			n += wn
			if err != nil {
				return
			}
			i += keylen
			last = i
			continue
		}
		i++
	}
	if last != len(s) {
		wn, err = sw.WriteString(s[last:])
		n += wn
	}
	return
}

// singleStringReplacer is the implementation that's used when there is only
// one string to replace (and that string has more than one byte).
type singleStringReplacer struct {
	finder *stringFinder
	// value is the new string that replaces that pattern when it's found.
	value []byte
}

func makeSingleStringReplacer(pattern []byte, value []byte) (rep *singleStringReplacer) {
	return &singleStringReplacer{finder: makeStringFinder(pattern), value: value}
}

func (r *singleStringReplacer) Replace(s []byte) (out []byte) {
	var buf Buffer
	i, matched := 0, false
	for {
		match := r.finder.next(s[i:])
		if match == -1 {
			break
		}
		matched = true
		buf.Grow(match + len(r.value))
		buf.WriteString(s[i : i+match])
		buf.WriteString(r.value)
		i += match + len(r.finder.pattern)
	}
	if !matched {
		return s
	}
	buf.WriteString(s[i:])
	return []byte(buf.String())
}

func (r *singleStringReplacer) WriteString(w io.Writer, s []byte) (n int32, err error) {
	sw := getStringWriter(w)
	var i, wn int32
	for {
		match := r.finder.next(s[i:])
		if match == -1 {
			break
		}
		wn, err = sw.WriteString(s[i : i+match])
		n += wn
		if err != nil {
			return
		}
		wn, err = sw.WriteString(r.value)
		n += wn
		if err != nil {
			return
		}
		i += match + len(r.finder.pattern)
	}
	wn, err = sw.WriteString(s[i:])
	n += wn
	return
}

// byteReplacer is the implementation that's used when all the "old"
// and "new" values are single ASCII bytes.
// r contains replacement bytes indexed by old byte.
//
// A slice, not a [256]byte array: the table is built once, stored in the
// replacer the caller keeps, and belongs to whoever owns the replacer.
type byteReplacer struct {
	r []byte
}

func (r *byteReplacer) Replace(s []byte) (out []byte) {
	var buf []byte // lazily allocated
	for i := 0; i < len(s); i++ {
		b := s[i]
		if r.r[b] != b {
			if buf == nil {
				// A real copy: in Moxie string and []byte are one mutable
				// type, so `[]byte(s)` is not a copy and writing through it
				// replaces the CALLER's bytes in place. This one mutated the
				// input slice, and because a string CONSTANT converted to
				// []byte points at the constant's backing, a second
				// bytes.NewReplacer(...).Replace([]byte("abcab")) saw the bytes
				// the first call had already rewritten ("12c12").
				buf = Clone(s)
			}
			buf[i] = r.r[b]
		}
	}
	if buf == nil {
		return s
	}
	return []byte(buf)
}

func (r *byteReplacer) WriteString(w io.Writer, s []byte) (n int32, err error) {
	sw := getStringWriter(w)
	last := 0
	for i := 0; i < len(s); i++ {
		b := s[i]
		if r.r[b] == b {
			continue
		}
		if last != i {
			wn, werr1 := sw.WriteString(s[last:i])
			n += wn
			if werr1 != nil {
				return n, werr1
			}
		}
		last = i + 1
		nw, werr2 := w.Write(r.r[b : int32(b)+1])
		n += nw
		if werr2 != nil {
			return n, werr2
		}
	}
	if last != len(s) {
		nw2, werr3 := sw.WriteString(s[last:])
		n += nw2
		if werr3 != nil {
			return n, werr3
		}
	}
	return n, nil
}

// byteStringReplacer is the implementation that's used when all the
// "old" values are single ASCII bytes but the "new" values vary in size.
type byteStringReplacer struct {
	// replacements contains replacement byte slices indexed by old byte.
	replacements [][]byte
	// present records which bytes have a replacement. An empty slice cannot
	// mean "no replacement": "a" -> "" is a valid, distinct replacement, and in
	// Moxie every empty slice compares equal to nil (slice == is content
	// equality), so the old nil test made an empty replacement indeciferable
	// from an absent one and Replace left the input untouched.
	present []bool
	// toReplace keeps a list of bytes to replace. Depending on length of toReplace
	// and length of target string it may be faster to use Count, or a plain loop.
	// We store single byte as a string, because Count takes a string.
	toReplace [][]byte
}

// countCutOff controls the ratio of a string length to a number of replacements
// at which (*byteStringReplacer).Replace switches algorithms.
// For strings with higher ration of length to replacements than that value,
// we call Count, for each replacement from toReplace.
// For strings, with a lower ratio we use simple loop, because of Count overhead.
// countCutOff is an empirically determined overhead multiplier.
// TODO(tocarip) revisit once we have register-based abi/mid-stack inlining.
const countCutOff = 8

func (r *byteStringReplacer) Replace(s []byte) (out []byte) {
	newSize := len(s)
	anyChanges := false
	// Is it faster to use Count?
	if len(r.toReplace)*countCutOff <= len(s) {
		for _, x := range r.toReplace {
			if c := Count(s, x); c != 0 {
				// The -1 is because we are replacing 1 byte with len(replacements[b]) bytes.
				newSize += c * (len(r.replacements[x[0]]) - 1)
				anyChanges = true
			}

		}
	} else {
		for i := 0; i < len(s); i++ {
			b := s[i]
			if r.present[b] {
				// See above for explanation of -1
				newSize += len(r.replacements[b]) - 1
				anyChanges = true
			}
		}
	}
	if !anyChanges {
		return s
	}
	buf := []byte{:newSize}
	j := 0
	for i := 0; i < len(s); i++ {
		b := s[i]
		if r.present[b] {
			j += mxutil.CopyAt(buf, j, r.replacements[b])
		} else {
			buf[j] = b
			j++
		}
	}
	return []byte(buf)
}

func (r *byteStringReplacer) WriteString(w io.Writer, s []byte) (n int32, err error) {
	sw := getStringWriter(w)
	last := 0
	for i := 0; i < len(s); i++ {
		b := s[i]
		if !r.present[b] {
			continue
		}
		if last != i {
			wn, werr1 := sw.WriteString(s[last:i])
			n += wn
			if werr1 != nil {
				return n, werr1
			}
		}
		last = i + 1
		wn2, werr2 := w.Write(r.replacements[b])
		n += wn2
		if werr2 != nil {
			return n, werr2
		}
	}
	if last != len(s) {
		var nw int32
		nw, err = sw.WriteString(s[last:])
		n += nw
	}
	return
}
