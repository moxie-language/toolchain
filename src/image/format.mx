package image

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"bufio"
	"errors"
	"io"
)

// ErrFormat indicates that decoding encountered an unknown format.
const ErrFormat = errors.Const("image: unknown format")

// A format holds an image format's name, magic header and how to decode it.
type format struct {
	name, magic  []byte
	decode       func(io.Reader) (Image, error)
	decodeConfig func(io.Reader) (Config, error)
}

// Decoder holds registered image formats and dispatches decoding.
type Decoder struct {
	formats []format
}

// NewDecoder returns a Decoder with no registered formats.
func NewDecoder() *Decoder {
	return &Decoder{}
}

// Register adds an image format. Name is the format name (e.g. "jpeg").
// Magic is the prefix that identifies the encoding; "?" matches any byte.
func (d *Decoder) Register(name, magic []byte, decode func(io.Reader) (Image, error), decodeConfig func(io.Reader) (Config, error)) {
	d.formats = mxutil.Ensure(d.formats, 1)
	d.formats = push(d.formats, format{name, magic, decode, decodeConfig})
}

// A reader is an io.Reader that can also peek ahead.
type reader interface {
	io.Reader
	Peek(int32) ([]byte, error)
}

// asReader converts an io.Reader to a reader.
func asReader(r io.Reader) reader {
	if rr, ok := r.(reader); ok {
		return rr
	}
	return bufio.NewReader(r)
}

// match reports whether magic matches b. Magic may contain "?" wildcards.
func match(magic []byte, b []byte) bool {
	if len(magic) != len(b) {
		return false
	}
	for i, c := range b {
		if magic[i] != c && magic[i] != '?' {
			return false
		}
	}
	return true
}

func (d *Decoder) sniff(r reader) format {
	for _, f := range d.formats {
		b, err := r.Peek(len(f.magic))
		if err == nil && match(f.magic, b) {
			return f
		}
	}
	return format{}
}

// Decode decodes an image in one of the registered formats.
// Returns the decoded image, the format name, and any error.
func (d *Decoder) Decode(r io.Reader) (Image, []byte, error) {
	rr := asReader(r)
	f := d.sniff(rr)
	if f.decode == nil {
		return nil, "", ErrFormat
	}
	m, err := f.decode(rr)
	return m, f.name, err
}

// DecodeConfig decodes the color model and dimensions of an image
// in one of the registered formats without decoding the entire image.
func (d *Decoder) DecodeConfig(r io.Reader) (Config, []byte, error) {
	rr := asReader(r)
	f := d.sniff(rr)
	if f.decodeConfig == nil {
		return Config{}, "", ErrFormat
	}
	c, err := f.decodeConfig(rr)
	return c, f.name, err
}
