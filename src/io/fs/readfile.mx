package fs

import "io"

// ReadFileFS is the interface implemented by a file system
// that provides an optimized implementation of [ReadFile].
type ReadFileFS interface {
	FS

	// ReadFile reads the named file and returns its contents.
	// A successful call returns a nil error, not io.EOF.
	// (Because ReadFile reads the whole file, the expected EOF
	// from the final Read is not treated as an error to be reported.)
	//
	// The caller is permitted to modify the returned byte slice.
	// This method should return a copy of the underlying data.
	ReadFile(name []byte) ([]byte, error)
}

// ReadFile reads the named file from the file system fs and returns its contents.
// A successful call returns a nil error, not [io.EOF].
// (Because ReadFile reads the whole file, the expected EOF
// from the final Read is not treated as an error to be reported.)
//
// If fs implements [ReadFileFS], ReadFile calls fs.ReadFile.
// Otherwise ReadFile calls fs.Open and uses Read and Close
// on the returned [File].
func ReadFile(fsys FS, name []byte) (out []byte, oerr error) {
	if rfs, ok := fsys.(ReadFileFS); ok {
		return rfs.ReadFile(name)
	}

	file, err := fsys.Open(name)
	if err != nil {
		return nil, err
	}
	defer file.Close()

	var size int32
	if info, serr := file.Stat(); serr == nil {
		size64 := info.Size()
		if int64(int32(size64)) == size64 {
			size = int32(size64)
		}
	}

	data := []byte{:0:size+1}
	for {
		if len(data) >= cap(data) {
			// Grow: allocate a new backing array of doubled capacity,
			// copy the read bytes, and adopt it. Explicit - no auto-grow.
			nb := []byte{:len(data):cap(data) * 2}
			copy(nb, data)
			data = nb
		}
		lb := len(data)
		n, rerr := io.ReadIntoN(file, resize(data, cap(data)), lb)
		data = resize(data, lb+n)
		if rerr != nil {
			if rerr == io.EOF {
				rerr = nil
			}
			return data, rerr
		}
	}
}
