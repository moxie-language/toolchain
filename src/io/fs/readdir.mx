package fs

import (
	"errors"
	"internal/bytealg"
)

// ReadDirFS is the interface implemented by a file system
// that provides an optimized implementation of [ReadDir].
type ReadDirFS interface {
	FS

	// ReadDir reads the named directory
	// and returns a list of directory entries sorted by filename.
	ReadDir(name []byte) ([]DirEntry, error)
}

// ReadDir reads the named directory
// and returns a list of directory entries sorted by filename.
//
// If fs implements [ReadDirFS], ReadDir calls fs.ReadDir.
// Otherwise ReadDir calls fs.Open and uses ReadDir and Close
// on the returned file.
func ReadDir(fsys FS, name []byte) (entries []DirEntry, rerr error) {
	if rfs, rok := fsys.(ReadDirFS); rok {
		return rfs.ReadDir(name)
	}

	file, err := fsys.Open(name)
	if err != nil {
		return nil, err
	}
	defer file.Close()

	dir, ok := file.(ReadDirFile)
	if !ok {
		return nil, &PathError{Op: "readdir", Path: name, Err: errors.New("not implemented")}
	}

	list, err := dir.ReadDir(-1)
	for i := int32(1); i < len(list); i++ {
		for j := i; j > 0 && bytealg.CompareString(list[j].Name(), list[j-1].Name()) < 0; j-- {
			list[j], list[j-1] = list[j-1], list[j]
		}
	}
	return list, err
}

// dirInfo is a DirEntry based on a FileInfo.
type dirInfo struct {
	fileInfo FileInfo
}

func (di *dirInfo) IsDir() (isDir bool) {
	return di.fileInfo.IsDir()
}

func (di *dirInfo) Type() (modeType FileMode) {
	fm := di.fileInfo.Mode()
	return fm.Type()
}

func (di *dirInfo) Info() (info FileInfo, ierr error) {
	return di.fileInfo, nil
}

func (di *dirInfo) Name() (name []byte) {
	return di.fileInfo.Name()
}

func (di *dirInfo) String() (s string) {
	return FormatDirEntry(di)
}

// FileInfoToDirEntry returns a [DirEntry] that returns information from info.
// If info is nil, FileInfoToDirEntry returns nil.
func FileInfoToDirEntry(info FileInfo) (rdirEntry DirEntry) {
	if info == nil {
		return nil
	}
	return &dirInfo{fileInfo: info}
}
