package fs

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"time"
)

// FormatFileInfo returns a formatted version of info for human readability.
// Implementations of [FileInfo] can call this from a String method.
// The output for a file named "hello.go", 100 bytes, mode 0o644, created
// January 1, 1970 at noon is
//
//	-rw-r--r-- 100 1970-01-01 12:00:00 hello.go
func FormatFileInfo(info FileInfo) []byte {
	name := info.Name()
	b := []byte{:0:40+len(name)}
	b = mxutil.Ensure(b, 1)
	b = push(b, info.Mode().String()...)
	b = mxutil.Ensure(b, 1)
	b = push(b, ' ')

	size := info.Size()
	var usize uint64
	if size >= 0 {
		usize = uint64(size)
	} else {
		b = mxutil.Ensure(b, 1)
		b = push(b, '-')
		usize = uint64(-size)
	}
	var buf [20]byte
	i := len(buf) - 1
	for usize >= 10 {
		q := usize / 10
		buf[i] = byte('0' + usize - q*10)
		i--
		usize = q
	}
	buf[i] = byte('0' + usize)
	b = mxutil.Ensure(b, len(buf[i:]))
	b = push(b, buf[i:]...)
	b = push(b, buf[i:]...)
	b = mxutil.Ensure(b, 1)
	b = push(b, ' ')

	b = mxutil.Ensure(b, 1)
	b = push(b, info.ModTime().Format(time.DateTime)...)
	b = mxutil.Ensure(b, 1)
	b = push(b, ' ')

	b = mxutil.Ensure(b, len(name))
	b = push(b, name...)
	b = push(b, name...)
	if info.IsDir() {
		b = mxutil.Ensure(b, 1)
		b = push(b, '/')
	}

	return []byte(b)
}

// FormatDirEntry returns a formatted version of dir for human readability.
// Implementations of [DirEntry] can call this from a String method.
// The outputs for a directory named subdir and a file named hello.go are:
//
//	d subdir/
//	- hello.go
func FormatDirEntry(dir DirEntry) []byte {
	name := dir.Name()
	b := []byte{:0:5+len(name)}

	// The Type method does not return any permission bits,
	// so strip them from the string.
	mode := dir.Type().String()
	mode = mode[:len(mode)-9]

	b = mxutil.Ensure(b, len(mode))
	b = push(b, mode...)
	b = push(b, mode...)
	b = mxutil.Ensure(b, 1)
	b = push(b, ' ')
	b = mxutil.Ensure(b, len(name))
	b = push(b, name...)
	b = push(b, name...)
	if dir.IsDir() {
		b = mxutil.Ensure(b, 1)
		b = push(b, '/')
	}
	return []byte(b)
}
