func SetAttribute(el Element, name, value string) {
	wasmSetAttribute(int32(el),
		unsafe.StringData(name), int32(len(name)), int32(len(name)),
		unsafe.StringData(value), int32(len(value)), int32(len(value)))
}

func RemoveAttribute(el Element, name string) {
	wasmRemoveAttribute(int32(el), unsafe.StringData(name), int32(len(name)), int32(len(name)))
}

func GetAttribute(el Element, name string) (s string) {
	var rPtr, rLen int32
	wasmGetAttribute(int32(el), unsafe.StringData(name), int32(len(name)), int32(len(name)), &rPtr, &rLen)
	return ptrToString(rPtr, rLen)
}

func SetTextContent(el Element, text string) {
	wasmSetTextContent(int32(el), unsafe.StringData(text), int32(len(text)), int32(len(text)))
}

func SetInnerHTML(el Element, html string) {
	wasmSetInnerHTML(int32(el), unsafe.StringData(html), int32(len(html)), int32(len(html)))
}

func SetStyle(el Element, prop, value string) {
	wasmSetStyle(int32(el),
		unsafe.StringData(prop), int32(len(prop)), int32(len(prop)),
		unsafe.StringData(value), int32(len(value)), int32(len(value)))
}

func AddClass(el Element, cls string) {
	wasmAddClass(int32(el), unsafe.StringData(cls), int32(len(cls)), int32(len(cls)))
}

func RemoveClass(el Element, cls string) {
	wasmRemoveClass(int32(el), unsafe.StringData(cls), int32(len(cls)), int32(len(cls)))
}

func Focus(el Element) { wasmFocus(int32(el)) }

func SetProperty(el Element, prop, value string) {
	wasmSetProperty(int32(el),
		unsafe.StringData(prop), int32(len(prop)), int32(len(prop)),
		unsafe.StringData(value), int32(len(value)), int32(len(value)))
}

func GetProperty(el Element, prop string) (s string) {
	var rPtr, rLen int32
	wasmGetProperty(int32(el), unsafe.StringData(prop), int32(len(prop)), int32(len(prop)), &rPtr, &rLen)
	return ptrToString(rPtr, rLen)
}

