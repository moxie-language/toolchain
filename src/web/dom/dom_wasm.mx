}

func UnobserveResize(el Element) {
	wasmUnobserveResize(int32(el))
}

func RequestAnimationFrame(fn func()) {
	wasmRequestAnimationFrame(callback.Register0Once(fn))
}

// OnKeydown has a nested callback: fn(key, preventDefault).
// Uses a custom hook so preventDefault can be signaled synchronously.
// keydownReg is a self-mutating holder: registrations mutate it through a
// method, so the map and the handler values live in its own arena rather than
// in the frame of whichever wasm export registered them (and a package global
// cannot be written outside a method).
type keydownReg struct {
	handlers map[int32]func(string, func())
	nextID   int32
}

var keydown keydownReg

func (k *keydownReg) add(fn func(string, func())) (id int32) {
	if k.handlers == nil {
		k.handlers = map[int32]func(string, func()){}
	}
	k.nextID++
	id = k.nextID
	k.handlers[id] = fn
	return
}

func (k *keydownReg) get(id int32) (fn func(string, func()), ok bool) {
	fn, ok = k.handlers[id]
	return
}

//:wasmimport bridge dom_on_keydown
func wasmOnKeydown(el int32, handlerID int32)

func OnKeydown(el Element, fn func(string, func())) {
	id := keydown.add(fn)
	wasmOnKeydown(int32(el), id)
}

//:wasmexport __hook_keydown
func hookKeydown(handlerID int32, keyPtr *byte, keyLen int32) (n int32) {
	fn, ok := keydown.get(handlerID)
	if !ok {
		return 0
	}
	key := ptrToStringLocal(keyPtr, keyLen)
	prevented := int32(0)
	fn(key, func() { prevented = 1 })
	return prevented
}

