func ptrToString(ptr int32, length int32) (s string) {
	if length <= 0 {
		return ""
	}
	return unsafe.String((*byte)(unsafe.Pointer(uintptr(ptr))), length)
}

func ptrToStringLocal(ptr *byte, length int32) (s string) {
	if ptr == nil || length <= 0 {
		return ""
	}
	return unsafe.String(ptr, length)
}
