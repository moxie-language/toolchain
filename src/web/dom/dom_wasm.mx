//:build wasm

package dom

import (
	"web/callback"
	"unsafe"
)

// --- Element creation/query ---

//:wasmimport bridge dom_body
func wasmBody() (n int32)

//:wasmimport bridge dom_create_element
func wasmCreateElement(ptr *byte, length int32, capacity int32) (n int32)

//:wasmimport bridge dom_create_text_node
func wasmCreateTextNode(ptr *byte, length int32, capacity int32) (n int32)

//:wasmimport bridge dom_get_element_by_id
func wasmGetElementById(ptr *byte, length int32, capacity int32) (n int32)

//:wasmimport bridge dom_query_selector
func wasmQuerySelector(ptr *byte, length int32, capacity int32) (n int32)

//:wasmimport bridge dom_query_selector_from
func wasmQuerySelectorFrom(root int32, ptr *byte, length int32, capacity int32) (n int32)

func Body() (e Element) { return Element(wasmBody()) }
func CreateElement(tag string) (e Element) { return Element(wasmCreateElement(unsafe.StringData(tag), int32(len(tag)), int32(len(tag)))) }
func CreateTextNode(text string) (e Element) { return Element(wasmCreateTextNode(unsafe.StringData(text), int32(len(text)), int32(len(text)))) }
func GetElementById(id string) (e Element) { return Element(wasmGetElementById(unsafe.StringData(id), int32(len(id)), int32(len(id)))) }
func QuerySelector(sel string) (e Element) { return Element(wasmQuerySelector(unsafe.StringData(sel), int32(len(sel)), int32(len(sel)))) }
func QuerySelectorFrom(root Element, sel string) (e Element) { return Element(wasmQuerySelectorFrom(int32(root), unsafe.StringData(sel), int32(len(sel)), int32(len(sel)))) }

// --- Tree manipulation ---

//:wasmimport bridge dom_append_child
func wasmAppendChild(parent int32, child int32)

//:wasmimport bridge dom_remove_child
func wasmRemoveChild(parent int32, child int32)

//:wasmimport bridge dom_remove
func wasmRemove(el int32)

//:wasmimport bridge dom_insert_before
func wasmInsertBefore(parent int32, newChild int32, refChild int32)

//:wasmimport bridge dom_first_child
func wasmFirstChild(el int32) (n int32)

//:wasmimport bridge dom_first_element_child
func wasmFirstElementChild(el int32) (n int32)

//:wasmimport bridge dom_next_sibling
func wasmNextSibling(el int32) (n int32)

//:wasmimport bridge dom_release_element
func wasmReleaseElement(el int32)

//:wasmimport bridge dom_release_all
func wasmReleaseAll(ptr *int32, length int32)

func AppendChild(parent, child Element)                   { wasmAppendChild(int32(parent), int32(child)) }
func RemoveChild(parent, child Element)                   { wasmRemoveChild(int32(parent), int32(child)) }
func Remove(el Element)                                   { wasmRemove(int32(el)) }
func InsertBefore(parent, newChild, refChild Element)     { wasmInsertBefore(int32(parent), int32(newChild), int32(refChild)) }
func FirstChild(el Element) (e Element) { return Element(wasmFirstChild(int32(el))) }
func FirstElementChild(el Element) (e Element) { return Element(wasmFirstElementChild(int32(el))) }
func NextSibling(el Element) (e Element) { return Element(wasmNextSibling(int32(el))) }
func ReleaseElement(el Element)                           { wasmReleaseElement(int32(el)) }
func ReleaseAll(ids []int32)                              { if len(ids) > 0 { wasmReleaseAll(&ids[0], int32(len(ids))) } }

//:wasmimport bridge dom_release_children
func wasmReleaseChildren(el int32)

func ReleaseChildren(el Element)                          { wasmReleaseChildren(int32(el)) }

