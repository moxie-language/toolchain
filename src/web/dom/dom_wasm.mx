}

func RemoveEventListener(el Element, event string, callbackId int32) {
	wasmRemoveEventListener(int32(el), unsafe.StringData(event), int32(len(event)), int32(len(event)), callbackId)
}

func ObserveResize(el Element, callbackId int32) {
