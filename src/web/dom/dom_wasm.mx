// --- IDB ---

//:wasmimport bridge dom_idb_set_enc_key
func wasmIDBSetEncKey(ptr *byte, length int32, capacity int32)

//:wasmimport bridge dom_idb_get
func wasmIDBGet(storePtr *byte, storeLen int32, storeCap int32, keyPtr *byte, keyLen int32, keyCap int32, cbID int32)

//:wasmimport bridge dom_idb_put
func wasmIDBPut(storePtr *byte, storeLen int32, storeCap int32, keyPtr *byte, keyLen int32, keyCap int32, valPtr *byte, valLen int32, valCap int32)

//:wasmimport bridge dom_idb_get_all
func wasmIDBGetAll(storePtr *byte, storeLen int32, storeCap int32, fnID int32, doneID int32)

func IDBSetEncKey(hexKey string) {
	wasmIDBSetEncKey(unsafe.StringData(hexKey), int32(len(hexKey)), int32(len(hexKey)))
}

func IDBGet(store, key string, fn func(string)) {
	wasmIDBGet(
		unsafe.StringData(store), int32(len(store)), int32(len(store)),
		unsafe.StringData(key), int32(len(key)), int32(len(key)),
		callback.RegisterSOnce(fn))
}

func IDBPut(store, key, value string) {
	wasmIDBPut(
		unsafe.StringData(store), int32(len(store)), int32(len(store)),
		unsafe.StringData(key), int32(len(key)), int32(len(key)),
		unsafe.StringData(value), int32(len(value)), int32(len(value)))
}

func IDBGetAll(store string, fn func(string, string), done func()) {
	fnID := callback.RegisterSS(fn)
	doneID := callback.Register0Once(func() {
		callback.Release(fnID)
		done()
	})
	wasmIDBGetAll(unsafe.StringData(store), int32(len(store)), int32(len(store)), fnID, doneID)
}

