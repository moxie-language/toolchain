func RegisterCallback(fn func()) (n int32) {
	return callback.Register0(fn)
}

func ReleaseCallback(id int32) {
	callback.Release(id)
}

func AddEventListener(el Element, event string, callbackId int32) {
	wasmAddEventListener(int32(el), unsafe.StringData(event), int32(len(event)), int32(len(event)), callbackId)
}

func AddSelfEventListener(el Element, event string, callbackId int32) {
	wasmAddSelfEventListener(int32(el), unsafe.StringData(event), int32(len(event)), int32(len(event)), callbackId)
}

func AddEnterKeyListener(el Element, callbackId int32) {
