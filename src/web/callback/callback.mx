//:build wasm

package callback

// The callback registry maps a host-visible integer id to a Moxie function
// value. The host (JS) keeps the id and calls back through the Dispatch*
// exports in dispatch.mx.
//
// Table is a self-mutating type: every registration mutates it through a
// method, so the maps and the function values they hold live in the
// registry's sovereign arena instead of the frame of whichever wasm export
// happened to register the callback. Writes to a package global outside a
// method - and the empty interface this registry used to store callbacks
// through - are both forbidden in Moxie.
type Table struct {
	nextID int32
	once   map[int32]bool
	f0     map[int32]func()
	fS     map[int32]func(string)
	fB     map[int32]func(bool)
	fI     map[int32]func(int32)
	fIS    map[int32]func(int32, string)
	fIIS   map[int32]func(int32, int32, string)
	fSS    map[int32]func(string, string)
	f6I    map[int32]func(int32, int32, int32, int32, int32, int32)
	fII    map[int32]func(int32, int32)
	fIII   map[int32]func(int32, int32, int32)
	fBytes map[int32]func([]byte)
}

var table Table

// add allocates the next id and records whether it fires once.
func (t *Table) add(once bool) (id int32) {
	if t.once == nil {
		t.once = map[int32]bool{}
	}
	t.nextID++
	id = t.nextID
	if once {
		t.once[id] = true
	}
	return
}

// Release drops every entry for id.
func (t *Table) Release(id int32) {
	delete(t.f0, id)
	delete(t.fS, id)
	delete(t.fB, id)
	delete(t.fI, id)
	delete(t.fIS, id)
	delete(t.fIIS, id)
	delete(t.fSS, id)
	delete(t.f6I, id)
	delete(t.fII, id)
	delete(t.fIII, id)
	delete(t.fBytes, id)
	delete(t.once, id)
}

func (t *Table) Register0(fn func()) (n int32) {
	n = t.add(false)
	if t.f0 == nil {
		t.f0 = map[int32]func(){}
	}
	t.f0[n] = fn
	return
}
func (t *Table) Register0Once(fn func()) (n int32) {
	n = t.add(true)
	if t.f0 == nil {
		t.f0 = map[int32]func(){}
	}
	t.f0[n] = fn
	return
}
func (t *Table) RegisterS(fn func(string)) (n int32) {
	n = t.add(false)
	if t.fS == nil {
		t.fS = map[int32]func(string){}
	}
	t.fS[n] = fn
	return
}
func (t *Table) RegisterSOnce(fn func(string)) (n int32) {
	n = t.add(true)
	if t.fS == nil {
