// --- typed lookups: one per signature, so the dispatcher calls the callback
// directly instead of asserting an interface{} back to a function type.

func (t *Table) Lookup0(id int32) (fn func(), ok bool) {
	fn, ok = t.f0[id]
	if ok && t.once[id] {
		t.Release(id)
	}
	return
}
func (t *Table) LookupS(id int32) (fn func(string), ok bool) {
	fn, ok = t.fS[id]
	if ok && t.once[id] {
		t.Release(id)
	}
	return
}
