// --- package-level entry points used by the jsbridge packages.

func Register0(fn func()) (n int32)              { return table.Register0(fn) }
func Register0Once(fn func()) (n int32)          { return table.Register0Once(fn) }
func RegisterS(fn func(string)) (n int32)        { return table.RegisterS(fn) }
func RegisterSOnce(fn func(string)) (n int32)    { return table.RegisterSOnce(fn) }
func RegisterB(fn func(bool)) (n int32)          { return table.RegisterB(fn) }
func RegisterBOnce(fn func(bool)) (n int32)      { return table.RegisterBOnce(fn) }
func RegisterI(fn func(int32)) (n int32)         { return table.RegisterI(fn) }
func RegisterIOnce(fn func(int32)) (n int32)     { return table.RegisterIOnce(fn) }
func RegisterIS(fn func(int32, string)) (n int32)  { return table.RegisterIS(fn) }
func RegisterISOnce(fn func(int32, string)) (n int32) { return table.RegisterISOnce(fn) }
func RegisterIIS(fn func(int32, int32, string)) (n int32) { return table.RegisterIIS(fn) }
func RegisterIISOnce(fn func(int32, int32, string)) (n int32) { return table.RegisterIISOnce(fn) }
func RegisterSS(fn func(string, string)) (n int32) { return table.RegisterSS(fn) }
func RegisterSSOnce(fn func(string, string)) (n int32) { return table.RegisterSSOnce(fn) }
func Register6I(fn func(int32, int32, int32, int32, int32, int32)) (n int32) {
	return table.Register6I(fn)
}
func Register6IOnce(fn func(int32, int32, int32, int32, int32, int32)) (n int32) {
	return table.Register6IOnce(fn)
}
func RegisterII(fn func(int32, int32)) (n int32)      { return table.RegisterII(fn) }
func RegisterIIOnce(fn func(int32, int32)) (n int32)  { return table.RegisterIIOnce(fn) }
func RegisterIII(fn func(int32, int32, int32)) (n int32) { return table.RegisterIII(fn) }
func RegisterIIIOnce(fn func(int32, int32, int32)) (n int32) { return table.RegisterIIIOnce(fn) }
func RegisterBytes(fn func([]byte)) (n int32)     { return table.RegisterBytes(fn) }
func RegisterBytesOnce(fn func([]byte)) (n int32) { return table.RegisterBytesOnce(fn) }

// Release drops a registration (the host releases ids it no longer needs).
func Release(id int32) { table.Release(id) }
