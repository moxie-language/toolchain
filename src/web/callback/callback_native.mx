//:build !wasm

package callback

// The callback registry exists only on wasm: its whole job is to hand a JS host
// an integer id for a Moxie function value and let the host call back through
// the Dispatch* wasm exports. A native build gets these stubs so that a package
// which imports the web framework still COMPILES natively - calling one is a
// bug, and it says so.
//
// This mirrors the stub/wasm split every web package uses (see web/dom: stub in
// dom.mx, body in dom_wasm.mx).

func Register0(fn func()) (n int32)                              { panic(nativeStub) }
func Register0Once(fn func()) (n int32)                          { panic(nativeStub) }
func RegisterS(fn func(string)) (n int32)                        { panic(nativeStub) }
func RegisterSOnce(fn func(string)) (n int32)                    { panic(nativeStub) }
func RegisterB(fn func(bool)) (n int32)                          { panic(nativeStub) }
func RegisterBOnce(fn func(bool)) (n int32)                      { panic(nativeStub) }
func RegisterI(fn func(int32)) (n int32)                         { panic(nativeStub) }
func RegisterIOnce(fn func(int32)) (n int32)                     { panic(nativeStub) }
func RegisterIS(fn func(int32, string)) (n int32)                { panic(nativeStub) }
func RegisterISOnce(fn func(int32, string)) (n int32)            { panic(nativeStub) }
func RegisterIIS(fn func(int32, int32, string)) (n int32)        { panic(nativeStub) }
func RegisterIISOnce(fn func(int32, int32, string)) (n int32)    { panic(nativeStub) }
func RegisterSS(fn func(string, string)) (n int32)               { panic(nativeStub) }
func RegisterSSOnce(fn func(string, string)) (n int32)           { panic(nativeStub) }
func Register6I(fn func(int32, int32, int32, int32, int32, int32)) (n int32) {
	panic(nativeStub)
}
func Register6IOnce(fn func(int32, int32, int32, int32, int32, int32)) (n int32) {
	panic(nativeStub)
}
func RegisterII(fn func(int32, int32)) (n int32)                  { panic(nativeStub) }
func RegisterIIOnce(fn func(int32, int32)) (n int32)              { panic(nativeStub) }
func RegisterIII(fn func(int32, int32, int32)) (n int32)          { panic(nativeStub) }
func RegisterIIIOnce(fn func(int32, int32, int32)) (n int32)      { panic(nativeStub) }
func RegisterBytes(fn func([]byte)) (n int32)                     { panic(nativeStub) }
func RegisterBytesOnce(fn func([]byte)) (n int32)                 { panic(nativeStub) }
func Release(id int32)                                            { panic(nativeStub) }

const nativeStub = "callback: the browser callback registry is wasm-only"
