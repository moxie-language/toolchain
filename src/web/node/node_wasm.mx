//:build wasm

package node

import (
	"web/callback"
	"unsafe"
)

//:wasmimport bridge node_on_line
func wasmOnLine(cbID int32)

//:wasmimport bridge node_on_close
func wasmOnClose(cbID int32)

//:wasmimport bridge node_write_line
func wasmWriteLine(ptr *byte, length int32, capacity int32)

//:wasmimport bridge node_write_err
func wasmWriteErr(ptr *byte, length int32, capacity int32)

//:wasmimport bridge node_exit
func wasmExit(code int32)

//:wasmimport bridge node_now_seconds
func wasmNowSeconds() (n int64)

func OnLine(fn func(string)) {
	wasmOnLine(callback.RegisterS(fn))
}

func OnClose(fn func()) {
	wasmOnClose(callback.Register0(fn))
}

func WriteLine(s string) {
	wasmWriteLine(unsafe.StringData(s), int32(len(s)), int32(len(s)))
}

func WriteErr(s string) {
	wasmWriteErr(unsafe.StringData(s), int32(len(s)), int32(len(s)))
}

func Exit(code int32) {
	wasmExit(code)
}

func NowSeconds() (n int64) {
	return wasmNowSeconds()
}
