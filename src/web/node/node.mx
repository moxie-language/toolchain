//:build !wasm

package node

// Node jsbridge - stdin/stdout/stderr line-oriented IO for Node.js CLI targets.
// Runtime implementation lives in moxiejs jsruntime/node.mjs.

// OnLine registers a line-handler for stdin. Called per line (no trailing newline).
// If stdin closes, the runtime closes any channel the handler sends to.
func OnLine(fn func(string)) { panic("jsbridge") }

// OnClose registers a handler called once when stdin hits EOF.
func OnClose(fn func()) { panic("jsbridge") }

// WriteLine writes a line to stdout (newline appended). Flushed immediately.
func WriteLine(s string) { panic("jsbridge") }

// WriteErr writes a line to stderr (newline appended).
func WriteErr(s string) { panic("jsbridge") }

// Exit terminates the process with the given code.
func Exit(code int32) { panic("jsbridge") }

// NowSeconds returns current time as Unix seconds (Node wall clock).
func NowSeconds() (n int64) { panic("jsbridge") }
