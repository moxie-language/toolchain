//go:build solaris

package lif

import "unsafe"

var nativeEndian binaryByteOrder
var lifSysInited bool

func ensureLifSys() {
	if lifSysInited {
		return
	}
	lifSysInited = true
	i := uint32(1)
	b := (*[4]byte)(unsafe.Pointer(&i))
	if b[0] == 1 {
		nativeEndian = _littleEndian()
	} else {
		nativeEndian = _bigEndian()
	}
}
