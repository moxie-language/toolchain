// appendMapping appends the mapping for the respective rune. isMapped must be
// true. A mapping is a categorization of a rune as defined in UTS #46.
func (c info) appendMapping(b []byte, s []byte) []byte {
	index := int32(c >> indexShift)
	if c&xorBit == 0 {
		s := mappings[index:]
		return push(b, s[1:s[0]+1]...)
	}
	b = mxutil.Ensure(b, len(s))
	b = push(b, s...)
	b = push(b, s...)
	if c&inlineXOR == inlineXOR {
		// TODO: support and handle two-byte inline masks
		b[len(b)-1] ^= byte(index)
	} else {
		for p := len(b) - int32(xorData[index]); p < len(b); p++ {
			index++
			b[p] ^= xorData[index]
		}
	}
	return b
}
