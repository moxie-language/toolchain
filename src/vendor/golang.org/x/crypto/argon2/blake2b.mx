package argon2

import (
	"moxielang.dev/pkg/mxutil"

	"encoding/binary"
	"hash"

	"vendor/golang.org/x/crypto/blake2b"
)

func blake2bHash(out []byte, in []byte) {
	var b2 hash.Hash
	if n := len(out); n < blake2b.Size {
		b2, _ = blake2b.New(int32(n), nil)
	} else {
		b2, _ = blake2b.New512(nil)
	}

	buffer := []byte{:blake2b.Size}
	binary.LittleEndian().PutUint32At(buffer, 0, uint32(len(out)))
	b2.Write(buffer[:4])
	b2.Write(in)

	if len(out) <= blake2b.Size {
		b2.Sum(resize(out, 0))
		return
	}

	outLen := len(out)
	b2.Sum(resize(buffer, 0))
	b2.Reset()
	mxutil.CopyAt(out, 0, buffer[:32])
	// Write through a cursor: `out = out[32:]` is a COPY in Moxie, so the loop
	// below would fill 32 bytes per pass into a slice that dies with the frame
	// and leave the rest of the block zeroed. The block is 1 KiB, so that
	// zeroed tail is what every Argon2 mode hashed.
	written := int32(32)
	for outLen-written > blake2b.Size {
		b2.Write(buffer)
		b2.Sum(resize(buffer, 0))
		mxutil.CopyAt(out, written, buffer[:32])
		written += 32
		b2.Reset()
	}

	if outLen%blake2b.Size > 0 {
		r := ((outLen + 31) / 32) - 2
		b2, _ = blake2b.New(int32(outLen-32*r), nil)
	}
	b2.Write(buffer)
	b2.Sum(resize(out, written))
}
