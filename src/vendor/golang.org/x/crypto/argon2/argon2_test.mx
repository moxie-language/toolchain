package argon2

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"testing"
)

func hexEncode(b []byte) (s string) {
	const hextable = "0123456789abcdef"
	buf := []byte{:0:len(b) * 2}
	for i := 0; i < len(b); i++ {
		buf = mxutil.Ensure(buf, 1)
		push(buf, hextable[b[i]>>4])
		buf = mxutil.Ensure(buf, 1)
		push(buf, hextable[b[i]&0x0f])
	}
	s = string(buf)
	return
}

func TestArgon2i(t *testing.T) {
	password := []byte{
		0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
		0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
		0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
		0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
	}
	salt := []byte{
		0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02,
		0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02,
	}
	key := Key(password, salt, 3, 32, 4, 32)
	got := hexEncode(key)
	want := "a9a7510e6db4d588ba3414cd0e094d480d683f97b9ccb612a544fe8ef65ba8e0"
	if got != want {
		t.Fatal("Argon2i: got " | got | ", want " | want)
	}
}

func TestArgon2id(t *testing.T) {
	password := []byte{
		0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
		0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
		0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
		0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
	}
	salt := []byte{
		0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02,
		0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02,
	}
	key := IDKey(password, salt, 3, 32, 4, 32)
	got := hexEncode(key)
	want := "03aab965c12001c9d7d0d2de33192c0494b684bb148196d73c1df1acaf6d0c2e"
	if got != want {
		t.Fatal("Argon2id: got " | got | ", want " | want)
	}
}

func TestArgon2idMinimal(t *testing.T) {
	key := IDKey([]byte("pass"), []byte("salt1234salt1234"), 1, 64, 1, 32)
	got := hexEncode(key)
	want := "11553abbacd3babd76f56bbb244aafc188ada10b0307dd9a993e9569be86f927"
	if got != want {
		t.Fatal("Argon2id minimal: got " | got | ", want " | want)
	}
}
