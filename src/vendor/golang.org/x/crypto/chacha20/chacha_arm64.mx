//:build gc && !purego

package chacha20

const bufSize = 256

//:noescape
func xorKeyStreamVX(dst, src []byte, key *[8]uint32, nonce *[3]uint32, counter *uint32)

// The offset form is the package contract; this backend cannot honour it
// without an asm entry point that takes offsets, and Moxie has no assembler
// backend, so the file is not built (chacha_noasm.mx supplies the symbol).
func (c *Cipher) xorKeyStreamBlocks(dst []byte, dstOff int32, src []byte, srcOff int32, n int32) {
	xorKeyStreamVX(dst, src, &c.key, &c.nonce, &c.counter)
}
