package chacha20

import "runtime"

// Platforms that have fast unaligned 32-bit little endian accesses.
//
// A function, not a const: Moxie folds the `runtime.GOARCH == ...` chain into
// its internal string-equality builtin, which legacy's go/types cannot evaluate
// in a constant expression ("value of type bool is not constant") and so
// refused to build any package importing this one; the same chain as a
// package-var initializer hit a stage4 compare-emission bug (an i64 compared
// with `icmp ne ptr`). The two arms of addXor are equivalent, so evaluating the
// flag at the call site costs a branch at most.
func unaligned() (ok bool) {
	return runtime.GOARCH == "386" ||
		runtime.GOARCH == "amd64" ||
		runtime.GOARCH == "arm64" ||
		runtime.GOARCH == "ppc64le" ||
		runtime.GOARCH == "s390x"
}

// addXor reads a little endian uint32 from src at srcOff, XORs it with (a + b)
// and places the result in little endian byte order in dst at dstOff. It takes
// offsets because a sub-slice is a copy: dst[o:o+4] would be a copy of the
// block and the store would be lost.
func addXor(dst []byte, dstOff int32, src []byte, srcOff int32, a, b uint32) {
	if unaligned() {
		// The compiler should optimize this code into
		// 32-bit unaligned little endian loads and stores.
		// TODO: delete once the compiler does a reliably
		// good job with the generic code below.
		// See issue #25111 for more details.
		v := uint32(src[srcOff+0])
		v |= uint32(src[srcOff+1]) << 8
		v |= uint32(src[srcOff+2]) << 16
		v |= uint32(src[srcOff+3]) << 24
		v ^= a + b
		dst[dstOff+0] = byte(v)
		dst[dstOff+1] = byte(v >> 8)
		dst[dstOff+2] = byte(v >> 16)
		dst[dstOff+3] = byte(v >> 24)
	} else {
		a += b
		dst[dstOff+0] = src[srcOff+0] ^ byte(a)
		dst[dstOff+1] = src[srcOff+1] ^ byte(a>>8)
		dst[dstOff+2] = src[srcOff+2] ^ byte(a>>16)
		dst[dstOff+3] = src[srcOff+3] ^ byte(a>>24)
	}
}
