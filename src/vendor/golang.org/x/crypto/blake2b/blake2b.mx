// Package blake2b implements the BLAKE2b hash algorithm defined by RFC 7693.
// BLAKE2b is optimized for 64-bit platforms and produces digests of any size
// between 1 and 64 bytes.
package blake2b

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"encoding/binary"
	"errors"
	"hash"
	"math/bits"
)

const (
	BlockSize = 128
	Size      = 64
	Size384   = 48
	Size256   = 32
)


var (
	ivTbl        []uint64
	precomputedTbl [][]byte
)

// _ivCopy returns the initialization vector as mutable state; the table itself
// is shared read-only, so a caller that XORs into it gets its own copy.
func _ivCopy() (v []uint64) {
	v = []uint64{:8}
	copy(v, ivTbl)
	return v
}

func _ivTable() (iv []uint64) {
	return []uint64{
		0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
		0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179,
	}
}

func _precomputedTable() (p [][]byte) {
	return [][]byte{
		{0, 2, 4, 6, 1, 3, 5, 7, 8, 10, 12, 14, 9, 11, 13, 15},
		{14, 4, 9, 13, 10, 8, 15, 6, 1, 0, 11, 5, 12, 2, 7, 3},
		{11, 12, 5, 15, 8, 0, 2, 13, 10, 3, 7, 9, 14, 6, 1, 4},
		{7, 3, 13, 11, 9, 1, 12, 14, 2, 5, 4, 15, 6, 10, 0, 8},
		{9, 5, 2, 10, 0, 7, 4, 15, 14, 11, 6, 3, 1, 12, 8, 13},
		{2, 6, 0, 8, 12, 10, 11, 3, 4, 7, 15, 1, 13, 5, 14, 9},
		{12, 1, 14, 4, 5, 15, 13, 10, 0, 6, 9, 8, 7, 3, 2, 11},
		{13, 7, 12, 3, 11, 14, 1, 9, 5, 15, 8, 2, 0, 4, 6, 10},
		{6, 14, 11, 0, 15, 9, 3, 8, 12, 13, 1, 10, 2, 7, 4, 5},
		{10, 8, 7, 1, 2, 4, 6, 5, 15, 9, 3, 13, 11, 14, 12, 0},
		{0, 2, 4, 6, 1, 3, 5, 7, 8, 10, 12, 14, 9, 11, 13, 15},
		{14, 4, 9, 13, 10, 8, 15, 6, 1, 0, 11, 5, 12, 2, 7, 3},
	}
}

func Sum512(data []byte) (sum []byte) {
	sum = []byte{:Size}
	checkSum(sum, Size, data)
	return
}

func Sum384(data []byte) (sum384 []byte) {
	sum := []byte{:Size}
	checkSum(sum, Size384, data)
	sum384 = sum[:Size384]
	return
}

func Sum256(data []byte) (sum256 []byte) {
	sum := []byte{:Size}
	checkSum(sum, Size256, data)
	sum256 = sum[:Size256]
	return
}

func New512(key []byte) (h hash.Hash, err error) { return newDigest(Size, key) }
func New384(key []byte) (h hash.Hash, err error) { return newDigest(Size384, key) }
func New256(key []byte) (h hash.Hash, err error) { return newDigest(Size256, key) }

func New(size int32, key []byte) (h hash.Hash, err error) { return newDigest(size, key) }

func newDigest(hashSize int32, key []byte) (d *digest, err error) {
	if hashSize < 1 || hashSize > Size {
		return nil, errHashSize
	}
	if len(key) > Size {
		return nil, errKeySize
	}
	d = &digest{
		size:   hashSize,
		keyLen: len(key),
		h:      []uint64{:8},
		c:      []uint64{:2},
		block:  []byte{:BlockSize},
		key:    []byte{:BlockSize},
	}
	copy(d.key, key)
	d.Reset()
	return
}

func checkSum(sum []byte, hashSize int32, data []byte) {
	h := _ivCopy()
	h[0] ^= uint64(hashSize) | (1 << 16) | (1 << 24)
	c := []uint64{:2}

	if length := len(data); length > BlockSize {
		n := length &^ (BlockSize - 1)
		if length == n {
			n -= BlockSize
		}
		hashBlocks(h, c, 0, data[:n])
		data = data[n:]
	}

	block := []byte{:BlockSize}
	offset := copy(block, data)
	remaining := uint64(BlockSize - offset)
	if c[0] < remaining {
		c[1]--
	}
	c[0] -= remaining

	hashBlocks(h, c, 0xFFFFFFFFFFFFFFFF, block)

	for i, v := range h[:(hashSize+7)/8] {
		binary.LittleEndian().PutUint64At(sum, 8*i, v)
	}
}

type digest struct {
	h      []uint64
	c      []uint64
	size   int32
	block  []byte
	offset int32
	key    []byte
	keyLen int32
}

func (d *digest) BlockSize() (n int32) { return BlockSize }
func (d *digest) Size() (n int32)      { return d.size }

func (d *digest) Reset() {
	copy(d.h, ivTbl)
	d.h[0] ^= uint64(d.size) | (uint64(d.keyLen) << 8) | (1 << 16) | (1 << 24)
	d.offset, d.c[0], d.c[1] = 0, 0, 0
	if d.keyLen > 0 {
		copy(d.block, d.key)
		d.offset = BlockSize
	}
}

func (d *digest) Write(p []byte) (n int32, err error) {
	n = len(p)

	if d.offset > 0 {
		remaining := BlockSize - d.offset
		if n <= remaining {
			d.offset += mxutil.CopyAt(d.block, d.offset, p)
			return
		}
		mxutil.CopyAt(d.block, d.offset, p[:remaining])
		hashBlocks(d.h, d.c, 0, d.block)
		d.offset = 0
		p = p[remaining:]
	}

	if length := len(p); length > BlockSize {
		nn := length &^ (BlockSize - 1)
		if length == nn {
			nn -= BlockSize
		}
		hashBlocks(d.h, d.c, 0, p[:nn])
		p = p[nn:]
	}

	if len(p) > 0 {
		d.offset += copy(d.block, p)
	}

	return
}

func (d *digest) Sum(sum []byte) (out []byte) {
	hVal := []byte{:Size}
	d.finalize(hVal)
	out = sum | hVal[:d.size]
	return
}

// finalize works on copies of the counters and the chaining value: Sum must not
// disturb the state a caller keeps writing to.
func (d *digest) finalize(hVal []byte) {
	block := []byte{:BlockSize}
	copy(block, d.block[:d.offset])
	remaining := uint64(BlockSize - d.offset)

	c := []uint64{:2}
	copy(c, d.c)
	if c[0] < remaining {
		c[1]--
	}
	c[0] -= remaining

	h := []uint64{:8}
	copy(h, d.h)
	hashBlocks(h, c, 0xFFFFFFFFFFFFFFFF, block)

	for i, v := range h {
		binary.LittleEndian().PutUint64At(hVal, 8*i, v)
	}
}

func hashBlocks(h, c []uint64, flag uint64, blocks []byte) {
	m := []uint64{:16}
	c0, c1 := c[0], c[1]

	for i := 0; i < len(blocks); {
		c0 += BlockSize
		if c0 < BlockSize {
			c1++
		}

		v0, v1, v2, v3, v4, v5, v6, v7 := h[0], h[1], h[2], h[3], h[4], h[5], h[6], h[7]
		v8, v9, v10, v11, v12, v13, v14, v15 := ivTbl[0], ivTbl[1], ivTbl[2], ivTbl[3], ivTbl[4], ivTbl[5], ivTbl[6], ivTbl[7]
		v12 ^= c0
		v13 ^= c1
		v14 ^= flag

		for j := range m {
			m[j] = binary.LittleEndian().Uint64(blocks[i:])
			i += 8
		}

		for j := range precomputedTbl {
			s := precomputedTbl[j]

			v0 += m[s[0]]
			v0 += v4
			v12 ^= v0
			v12 = bits.RotateLeft64(v12, -32)
			v8 += v12
			v4 ^= v8
			v4 = bits.RotateLeft64(v4, -24)
			v1 += m[s[1]]
			v1 += v5
			v13 ^= v1
			v13 = bits.RotateLeft64(v13, -32)
			v9 += v13
			v5 ^= v9
			v5 = bits.RotateLeft64(v5, -24)
			v2 += m[s[2]]
			v2 += v6
			v14 ^= v2
			v14 = bits.RotateLeft64(v14, -32)
			v10 += v14
			v6 ^= v10
			v6 = bits.RotateLeft64(v6, -24)
			v3 += m[s[3]]
			v3 += v7
			v15 ^= v3
			v15 = bits.RotateLeft64(v15, -32)
			v11 += v15
			v7 ^= v11
			v7 = bits.RotateLeft64(v7, -24)

			v0 += m[s[4]]
			v0 += v4
			v12 ^= v0
			v12 = bits.RotateLeft64(v12, -16)
			v8 += v12
			v4 ^= v8
			v4 = bits.RotateLeft64(v4, -63)
			v1 += m[s[5]]
			v1 += v5
			v13 ^= v1
			v13 = bits.RotateLeft64(v13, -16)
			v9 += v13
			v5 ^= v9
			v5 = bits.RotateLeft64(v5, -63)
			v2 += m[s[6]]
			v2 += v6
			v14 ^= v2
			v14 = bits.RotateLeft64(v14, -16)
			v10 += v14
			v6 ^= v10
			v6 = bits.RotateLeft64(v6, -63)
			v3 += m[s[7]]
			v3 += v7
			v15 ^= v3
			v15 = bits.RotateLeft64(v15, -16)
			v11 += v15
			v7 ^= v11
			v7 = bits.RotateLeft64(v7, -63)

			v0 += m[s[8]]
			v0 += v5
			v15 ^= v0
			v15 = bits.RotateLeft64(v15, -32)
			v10 += v15
			v5 ^= v10
			v5 = bits.RotateLeft64(v5, -24)
			v1 += m[s[9]]
			v1 += v6
			v12 ^= v1
			v12 = bits.RotateLeft64(v12, -32)
			v11 += v12
			v6 ^= v11
			v6 = bits.RotateLeft64(v6, -24)
			v2 += m[s[10]]
			v2 += v7
			v13 ^= v2
			v13 = bits.RotateLeft64(v13, -32)
			v8 += v13
			v7 ^= v8
			v7 = bits.RotateLeft64(v7, -24)
			v3 += m[s[11]]
			v3 += v4
			v14 ^= v3
			v14 = bits.RotateLeft64(v14, -32)
			v9 += v14
			v4 ^= v9
			v4 = bits.RotateLeft64(v4, -24)

			v0 += m[s[12]]
			v0 += v5
			v15 ^= v0
			v15 = bits.RotateLeft64(v15, -16)
			v10 += v15
			v5 ^= v10
			v5 = bits.RotateLeft64(v5, -63)
			v1 += m[s[13]]
			v1 += v6
			v12 ^= v1
			v12 = bits.RotateLeft64(v12, -16)
			v11 += v12
			v6 ^= v11
			v6 = bits.RotateLeft64(v6, -63)
			v2 += m[s[14]]
			v2 += v7
			v13 ^= v2
			v13 = bits.RotateLeft64(v13, -16)
			v8 += v13
			v7 ^= v8
			v7 = bits.RotateLeft64(v7, -63)
			v3 += m[s[15]]
			v3 += v4
			v14 ^= v3
			v14 = bits.RotateLeft64(v14, -16)
			v9 += v14
			v4 ^= v9
			v4 = bits.RotateLeft64(v4, -63)
		}

		h[0] ^= v0 ^ v8
		h[1] ^= v1 ^ v9
		h[2] ^= v2 ^ v10
		h[3] ^= v3 ^ v11
		h[4] ^= v4 ^ v12
		h[5] ^= v5 ^ v13
		h[6] ^= v6 ^ v14
		h[7] ^= v7 ^ v15
	}
	c[0], c[1] = c0, c1
}

var errHashSize error
var errKeySize error
func init() {
	errKeySize = errors.New("blake2b: invalid key size")
	errHashSize = errors.New("blake2b: invalid hash size")
	ivTbl = _ivTable()
	precomputedTbl = _precomputedTable()
}
