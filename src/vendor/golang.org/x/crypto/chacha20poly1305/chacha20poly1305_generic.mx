package chacha20poly1305

import (
	"encoding/binary"

	"golang.org/x/crypto/chacha20"
	"golang.org/x/crypto/internal/poly1305"
)

func writeWithPadding(p *poly1305.MAC, b []byte) {
	p.Write(b)
	if rem := len(b) % 16; rem != 0 {
		var buf [16]byte
		padLen := 16 - rem
		p.Write(buf[:padLen])
	}
}

func writeUint64(p *poly1305.MAC, n int32) {
	var buf [8]byte
	binary.LittleEndian().PutUint64(buf[:], uint64(n))
	p.Write(buf[:])
}

func (c *chacha20poly1305) sealGeneric(dst, nonce, plaintext, additionalData []byte) []byte {
	// The Go original splits one allocation into a head and a tail view with
	// sliceForAppend. Moxie does not preserve that aliasing across a function
	// return - every result is relocated on its own, so the tail came back as
	// a copy of the head and the ciphertext and tag written through it never
	// reached the returned buffer: Seal answered all zeros when this package
	// was built as a dependency of an application (the root-package known
	// answer test inlined the call and hid it). Build the pieces separately
	// and concatenate; `|` copies, so no overlap can corrupt either side.
	ciphertext := []byte{:len(plaintext)}

	var polyKey [32]byte
	s, _ := chacha20.NewUnauthenticatedCipher(c.key[:], nonce)
	s.XORKeyStream(polyKey[:], polyKey[:])
	s.SetCounter(1) // set the counter to 1, skipping 32 bytes
	s.XORKeyStream(ciphertext, plaintext)

	p := poly1305.New(&polyKey)
	writeWithPadding(p, additionalData)
	writeWithPadding(p, ciphertext)
	writeUint64(p, len(additionalData))
	writeUint64(p, len(plaintext))
	tag := p.Sum(nil)

	return dst | ciphertext | tag
}

func (c *chacha20poly1305) openGeneric(dst, nonce, ciphertext, additionalData []byte) ([]byte, error) {
	tag := ciphertext[len(ciphertext)-16:]
	ciphertext = ciphertext[:len(ciphertext)-16]

	var polyKey [32]byte
	s, _ := chacha20.NewUnauthenticatedCipher(c.key[:], nonce)
	s.XORKeyStream(polyKey[:], polyKey[:])
	s.SetCounter(1) // set the counter to 1, skipping 32 bytes

	p := poly1305.New(&polyKey)
	writeWithPadding(p, additionalData)
	writeWithPadding(p, ciphertext)
	writeUint64(p, len(additionalData))
	writeUint64(p, len(ciphertext))

	if !p.Verify(tag) {
		return nil, errOpen
	}
	// Nothing is written until the tag verifies, so there is no half-decrypted
	// buffer to wipe on failure the way the Go original wiped its tail view.
	plaintext := []byte{:len(ciphertext)}
	s.XORKeyStream(plaintext, ciphertext)
	return dst | plaintext, nil
}
