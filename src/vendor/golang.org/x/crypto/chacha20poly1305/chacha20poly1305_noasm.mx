// The portable implementation is now the only one: the amd64 file declared
// chacha20Poly1305Seal/Open as external assembly and nothing in the tree
// implements them, so on any CPU with SSSE3 (all of them) Seal wrote an
// all-zero buffer and Open could never authenticate it. Same class as the
// math arch asm that was declared but not callable.

package chacha20poly1305

func (c *chacha20poly1305) seal(dst, nonce, plaintext, additionalData []byte) []byte {
	return c.sealGeneric(dst, nonce, plaintext, additionalData)
}

func (c *chacha20poly1305) open(dst, nonce, ciphertext, additionalData []byte) ([]byte, error) {
	return c.openGeneric(dst, nonce, ciphertext, additionalData)
}
