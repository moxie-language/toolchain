package norm

import (
	"unicode/utf8"
	"moxielang.dev/pkg/mxutil"
)

type input struct {
	str   []byte
	bytes []byte
}

func inputBytes(str []byte) input {
	return input{bytes: str}
}

func inputString(str []byte) input {
	return input{str: str}
}

func (in *input) setBytes(str []byte) {
	in.str = ""
	in.bytes = str
}

func (in *input) setString(str []byte) {
	in.str = str
	in.bytes = nil
}

func (in *input) _byte(p int32) byte {
	if in.bytes == nil {
		return in.str[p]
	}
	return in.bytes[p]
}

func (in *input) skipASCII(p, hi int32) int32 {
	if in.bytes == nil {
		for ; p < hi && in.str[p] < utf8.RuneSelf; p++ {
		}
	} else {
		for ; p < hi && in.bytes[p] < utf8.RuneSelf; p++ {
		}
	}
	return p
}

func (in *input) skipContinuationBytes(p int32) int32 {
	if in.bytes == nil {
		for ; p < len(in.str) && !utf8.RuneStart(in.str[p]); p++ {
		}
	} else {
		for ; p < len(in.bytes) && !utf8.RuneStart(in.bytes[p]); p++ {
		}
	}
	return p
}

func (in *input) appendSlice(buf []byte, b, e int32) []byte {
	if in.bytes != nil {
		return push(buf, in.bytes[b:e]...)
	}
	for i := b; i < e; i++ {
		buf = mxutil.Ensure(buf, 1)
		buf = push(buf, in.str[i])
	}
	return buf
}

func (in *input) copySlice(buf []byte, b, e int32) int32 {
	if in.bytes == nil {
		return copy(buf, in.str[b:e])
	}
	return copy(buf, in.bytes[b:e])
}

func (in *input) charinfoNFC(p int32) (uint16, int32) {
	if in.bytes == nil {
		return _nfcData().lookupString(in.str[p:])
	}
	return _nfcData().lookup(in.bytes[p:])
}

func (in *input) charinfoNFKC(p int32) (uint16, int32) {
	if in.bytes == nil {
		return _nfkcData().lookupString(in.str[p:])
	}
	return _nfkcData().lookup(in.bytes[p:])
}

func (in *input) hangul(p int32) (r rune) {
	var size int32
	if in.bytes == nil {
		if !isHangulString(in.str[p:]) {
			return 0
		}
		r, size = utf8.DecodeRuneInString(in.str[p:])
	} else {
		if !isHangul(in.bytes[p:]) {
			return 0
		}
		r, size = utf8.DecodeRune(in.bytes[p:])
	}
	if size != hangulUTF8Size {
		return 0
	}
	return r
}
