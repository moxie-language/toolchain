// Package base64 implements base64 encoding as specified by RFC 4648.
package base64

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"internal/byteorder"
	"io"
	"strconv"
)

/*
 * Encodings
 */

// An Encoding is a radix 64 encoding/decoding scheme, defined by a
// 64-character alphabet. The most common encoding is the "base64"
// encoding defined in RFC 4648 and used in MIME (RFC 2045) and PEM
// (RFC 1421).  RFC 4648 also defines an alternate encoding, which is
// the standard encoding with - and _ substituted for + and /.
type Encoding struct {
	encode    []byte // mapping of symbol index to symbol byte value
	decodeMap []byte // mapping of symbol byte value to symbol index
	padChar   rune
	strict    bool
}

const (
	StdPadding rune = '=' // Standard padding character
	NoPadding  rune = -1  // No padding
)

const (
	decodeMapInitialize = "" |
		"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff" |
		"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff" |
		"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff" |
		"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff" |
		"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff" |
		"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff" |
		"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff" |
		"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff" |
		"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff" |
		"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff" |
		"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff" |
		"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff" |
		"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff" |
		"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff" |
		"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff" |
		"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff"
	invalidIndex = uint8(0xff)
)

// NewEncoding returns a new padded Encoding defined by the given alphabet,
// which must be a 64-byte string that contains unique byte values and
// does not contain the padding character or CR / LF ('\r', '\n').
// The alphabet is treated as a sequence of byte values
// without any special treatment for multi-byte UTF-8.
// The resulting Encoding uses the default padding character ('='),
// which may be changed or disabled via [Encoding.WithPadding].
func NewEncoding(alphabet []byte) (enc *Encoding) {
	if len(alphabet) != 64 {
		panic("encoding alphabet is not 64-bytes long")
	}

	e := &Encoding{
		encode:    []byte{:64},
		decodeMap: []byte{:256},
	}
	e.padChar = StdPadding
	copy(e.encode, alphabet)
	copy(e.decodeMap, decodeMapInitialize)

	for i := 0; i < len(alphabet); i++ {
		// Note: While we document that the alphabet cannot contain
		// the padding character, we do not enforce it since we do not know
		// if the caller intends to switch the padding from StdPadding later.
		switch {
		case alphabet[i] == '\n' || alphabet[i] == '\r':
			panic("encoding alphabet contains newline character")
		case e.decodeMap[alphabet[i]] != invalidIndex:
			panic("encoding alphabet includes duplicate symbols")
		}
		e.decodeMap[alphabet[i]] = uint8(i)
	}
	return e
}

// WithPadding creates a new encoding identical to enc except
// with a specified padding character, or [NoPadding] to disable padding.
// The padding character must not be '\r' or '\n',
// must not be contained in the encoding's alphabet,
// must not be negative, and must be a rune equal or below '\xff'.
// Padding characters above '\x7f' are encoded as their exact byte value
// rather than using the UTF-8 representation of the codepoint.
func (enc *Encoding) WithPadding(padding rune) (out *Encoding) {
	switch {
	case padding < NoPadding || padding == '\r' || padding == '\n' || padding > 0xff:
		panic("invalid padding")
	case padding != NoPadding && enc.decodeMap[byte(padding)] != invalidIndex:
		panic("padding contained in alphabet")
	}
	e := *enc
	e.padChar = padding
	return &e
}

// Strict creates a new encoding identical to enc except with
// strict decoding enabled. In this mode, the decoder requires that
// trailing padding bits are zero, as described in RFC 4648 section 3.5.
//
// Note that the input is still malleable, as new line characters
// (CR and LF) are still ignored.
func (enc *Encoding) Strict() (out *Encoding) {
	e := *enc
	e.strict = true
	return &e
}

func StdEncoding() (enc *Encoding) {
	return NewEncoding("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
}

func URLEncoding() (enc *Encoding) {
	return NewEncoding("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_")
}

func RawStdEncoding() (enc *Encoding) {
	return StdEncoding().WithPadding(NoPadding)
}

func RawURLEncoding() (enc *Encoding) {
	return URLEncoding().WithPadding(NoPadding)
}

/*
 * Encoder
 */

// Encode encodes src using the encoding enc,
// writing [Encoding.EncodedLen](len(src)) bytes to dst.
//
// The encoding pads the output to a multiple of 4 bytes,
// so Encode is not appropriate for use on individual blocks
// of a large data stream. Use [NewEncoder] instead.
func (enc *Encoding) Encode(dst, src []byte) {
	enc.EncodeFrom(dst, 0, src, 0, len(src))
}

// EncodeFrom encodes src[soff:soff+n] into dst at doff. dst must be at least
// doff+EncodedLen(n) long, not merely that capacity, because the writes are
// indexed.
//
// It exists so a streaming writer can encode a window of its input without
// slicing it: a sub-slice is a copy, so Encode(out, p[off:off+nn]) would
// allocate nn bytes per chunk.
func (enc *Encoding) EncodeFrom(dst []byte, doff int32, src []byte, soff, n int32) {
	if n == 0 {
		return
	}
	// enc is a pointer receiver, so the use of enc.encode within the hot
	// loop below means a nil check at every operation. Lift that nil check
	// outside of the loop to speed up the encoder.
	_ = enc.encode

	di, si := doff, soff
	end := soff + n
	stop := soff + (n/3)*3
	for si < stop {
		// Convert 3x 8bit source bytes into 4 bytes
		v3 := uint32(src[si+0])<<16 | uint32(src[si+1])<<8 | uint32(src[si+2])

		dst[di+0] = enc.encode[v3>>18&0x3F]
		dst[di+1] = enc.encode[v3>>12&0x3F]
		dst[di+2] = enc.encode[v3>>6&0x3F]
		dst[di+3] = enc.encode[v3&0x3F]

		si += 3
		di += 4
	}

	remain := end - si
	if remain == 0 {
		return
	}
	// Add the remaining small block
	val := uint32(src[si+0]) << 16
	if remain == 2 {
		val |= uint32(src[si+1]) << 8
	}

	dst[di+0] = enc.encode[val>>18&0x3F]
	dst[di+1] = enc.encode[val>>12&0x3F]

	switch remain {
	case 2:
		dst[di+2] = enc.encode[val>>6&0x3F]
		if enc.padChar != NoPadding {
			dst[di+3] = byte(enc.padChar)
		}
	case 1:
		if enc.padChar != NoPadding {
			dst[di+2] = byte(enc.padChar)
			dst[di+3] = byte(enc.padChar)
		}
	}
}

// AppendEncode appends the base64 encoded src to dst
// and returns the extended buffer.
func (enc *Encoding) AppendEncode(dst, src []byte) (out []byte) {
	n := enc.EncodedLen(len(src))
	if cap(dst)-len(dst) < n {
		dst = push([]byte{:0:len(dst)+n}, dst...)
	}
	base := len(dst)
	dst = resize(dst, base+n)
	enc.EncodeFrom(dst, base, src, 0, len(src))
	return dst
}

// EncodeToString returns the base64 encoding of src.
func (enc *Encoding) EncodeToString(src []byte) (out []byte) {
	buf := []byte{:enc.EncodedLen(len(src))}
	enc.Encode(buf, src)
	return []byte(buf)
}

type encoder struct {
	err  error
	enc  *Encoding
	w    io.Writer
	buf  []byte    // buffered data waiting to be encoded
	nbuf int32        // number of bytes in buf
	out  []byte // output buffer
}

func (e *encoder) Write(p []byte) (n int32, err error) {
	if e.err != nil {
		return 0, e.err
	}

	// off walks p. `p = p[nn:]` per chunk would copy the whole remainder.
	off := int32(0)

	// Leading fringe.
	if e.nbuf > 0 {
		var i int32
		for i = 0; i < len(p) && e.nbuf < 3; i++ {
			e.buf[e.nbuf] = p[i]
			e.nbuf++
		}
		n += i
		off = i
		if e.nbuf < 3 {
			return
		}
		e.enc.Encode(e.out, e.buf)
		if _, e.err = e.w.Write(e.out[:4]); e.err != nil {
			return n, e.err
		}
		e.nbuf = 0
	}

	// Large interior chunks. nn lives outside the loop: a ':=' in the body of
	// a self-mutating method allocates in the sovereign arena on every
	// iteration and that allocation is never reclaimed.
	var nn int32
	for len(p)-off >= 3 {
		nn = len(e.out) / 4 * 3
		if nn > len(p)-off {
			nn = len(p) - off
			nn -= nn % 3
		}
		e.enc.EncodeFrom(e.out, 0, p, off, nn)
		if _, e.err = e.w.Write(e.out[:nn/3*4]); e.err != nil {
			return n, e.err
		}
		n += nn
		off += nn
	}

	// Trailing fringe.
	rest := len(p) - off
	for k := int32(0); k < rest; k++ {
		e.buf[k] = p[off+k]
	}
	e.nbuf = rest
	n += rest
	return
}

// Close flushes any pending output from the encoder.
// It is an error to call Write after calling Close.
func (e *encoder) Close() (err error) {
	// If there's anything left in the buffer, flush it out
	if e.err == nil && e.nbuf > 0 {
		e.enc.EncodeFrom(e.out, 0, e.buf, 0, e.nbuf)
		_, e.err = e.w.Write(e.out[:e.enc.EncodedLen(e.nbuf)])
		e.nbuf = 0
	}
	return e.err
}

// NewEncoder returns a new base64 stream encoder. Data written to
// the returned writer will be encoded using enc and then written to w.
// Base64 encodings operate in 4-byte blocks; when finished
// writing, the caller must Close the returned encoder to flush any
// partially written blocks.
func NewEncoder(enc *Encoding, w io.Writer) (out io.WriteCloser) {
	return &encoder{
		enc: enc,
		w:   w,
		buf: []byte{:3},
		out: []byte{:1024},
	}
}

// EncodedLen returns the length in bytes of the base64 encoding
// of an input buffer of length n.
func (enc *Encoding) EncodedLen(n int32) (out int32) {
	if enc.padChar == NoPadding {
		return n/3*4 + (n%3*8+5)/6 // minimum # chars at 6 bits per char
	}
	return (n + 2) / 3 * 4 // minimum # 4-char quanta, 3 bytes each
}

/*
 * Decoder
 */

type CorruptInputError int64

func (e *CorruptInputError) Error() (msg string) {
	return "illegal base64 data at input byte " | strconv.FormatInt(int64(*e), 10)
}

func (e *CorruptInputError) String() (s string) { return e.Error() }

// corruptInputError returns a CorruptInputError as an error.
func corruptInputError(n int32) (cerr error) {
	ce := CorruptInputError(n)
	cerr = &ce
	return
}

// decodeQuantum decodes up to 4 base64 bytes. The received parameters are
// the destination buffer dst, the source buffer src and an index in the
// source buffer si.
// It returns the number of bytes read from src, the number of bytes written
// to dst, and an error, if any.
// decodeQuantum decodes one quantum from src[0:sn] at si into dst at doff.
func (enc *Encoding) decodeQuantum(dst []byte, doff int32, src []byte, si int32, sn int32) (nsi, n int32, err error) {
	// Decode quantum using the base64 alphabet. A slice stands in for the
	// fixed buffer Go would have used; there is one allocation, sized here.
	dbuf := []byte{:4}
	dlen := int32(4)

	// Lift the nil check outside of the loop.
	_ = enc.decodeMap

	for j := 0; j < len(dbuf); j++ {
		if sn == si {
			switch {
			case j == 0:
				return si, 0, nil
			case j == 1, enc.padChar != NoPadding:
				return si, 0, corruptInputError(si - j)
			}
			dlen = j
			break
		}
		in := src[si]
		si++

		out := enc.decodeMap[in]
		if out != 0xff {
			dbuf[j] = out
			continue
		}

		if in == '\n' || in == '\r' {
			j--
			continue
		}

		if rune(in) != enc.padChar {
			return si, 0, corruptInputError(si - 1)
		}

		// We've reached the end and there's padding
		switch j {
		case 0, 1:
			// incorrect padding
			return si, 0, corruptInputError(si - 1)
		case 2:
			// "==" is expected, the first "=" is already consumed.
			// skip over newlines
			for si < sn && (src[si] == '\n' || src[si] == '\r') {
				si++
			}
			if si == sn {
				// not enough padding
				return si, 0, corruptInputError(sn)
			}
			if rune(src[si]) != enc.padChar {
				// incorrect padding
				return si, 0, corruptInputError(si - 1)
			}

			si++
		}

		// skip over newlines
		for si < sn && (src[si] == '\n' || src[si] == '\r') {
			si++
		}
		if si < sn {
			// trailing garbage
			err = corruptInputError(si)
		}
		dlen = j
		break
	}

	// Convert 4x 6bit source bytes into 3 bytes
	val := uint32(dbuf[0])<<18 | uint32(dbuf[1])<<12 | uint32(dbuf[2])<<6 | uint32(dbuf[3])
	dbuf[2], dbuf[1], dbuf[0] = byte(val>>0), byte(val>>8), byte(val>>16)
	switch dlen {
	case 4:
		dst[doff+2] = dbuf[2]
		dbuf[2] = 0
		dst[doff+1] = dbuf[1]
		if enc.strict && dbuf[2] != 0 {
			return si, 0, corruptInputError(si - 1)
		}
		dbuf[1] = 0
		dst[doff+0] = dbuf[0]
		if enc.strict && (dbuf[1] != 0 || dbuf[2] != 0) {
			return si, 0, corruptInputError(si - 2)
		}
	case 3:
		dst[doff+1] = dbuf[1]
		if enc.strict && dbuf[2] != 0 {
			return si, 0, corruptInputError(si - 1)
		}
		dbuf[1] = 0
		dst[doff+0] = dbuf[0]
		if enc.strict && (dbuf[1] != 0 || dbuf[2] != 0) {
			return si, 0, corruptInputError(si - 2)
		}
	case 2:
		dst[doff+0] = dbuf[0]
		if enc.strict && (dbuf[1] != 0 || dbuf[2] != 0) {
			return si, 0, corruptInputError(si - 2)
		}
	}

	return si, dlen - 1, err
}

// AppendDecode appends the base64 decoded src to dst
// and returns the extended buffer.
// If the input is malformed, it returns the partially decoded src and an error.
// New line characters (\r and \n) are ignored.
func (enc *Encoding) AppendDecode(dst, src []byte) (out []byte, derr error) {
	// Compute the output size without padding to avoid over allocating.
	n := len(src)
	for n > 0 && rune(src[n-1]) == enc.padChar {
		n--
	}
	n = decodedLen(n, NoPadding)

	if cap(dst)-len(dst) < n {
		dst = push([]byte{:0:len(dst)+n}, dst...)
	}
	base := len(dst)
	dst = resize(dst, base+n)
	n, err := enc.DecodeAt(dst, base, src)
	return dst[:base+n], err
}

// DecodeString returns the bytes represented by the base64 string s.
// If the input is malformed, it returns the partially decoded data and
// [CorruptInputError]. New line characters (\r and \n) are ignored.
func (enc *Encoding) DecodeString(s []byte) (out []byte, derr error) {
	dbuf := []byte{:enc.DecodedLen(len(s))}
	n, err := enc.Decode(dbuf, []byte(s))
	return dbuf[:n], err
}

type decoder struct {
	err     error
	readErr error // error from r.Read
	enc     *Encoding
	r       io.Reader
	buf    []byte // leftover input
	nbuf    int32
	out     []byte // leftover decoded output
	outOff  int32  // read cursor into out
	outbuf []byte
}

func (d *decoder) Read(p []byte) (n int32, err error) {
	// Use leftover decoded output from last read.
	if d.outOff < len(d.out) {
		n = mxutil.CopyFrom(p, d.out, d.outOff)
		d.outOff += n
		return n, nil
	}

	if d.err != nil {
		return 0, d.err
	}

	// This code assumes that d.r strips supported whitespace ('\r' and '\n').

	// Refill buffer. nn lives outside the loop: a ':=' in the body of a
	// self-mutating method allocates in the sovereign arena on every
	// iteration and that allocation is never reclaimed.
	var nn int32
	for d.nbuf < 4 && d.readErr == nil {
		nn = len(p) / 3 * 4
		if nn < 4 {
			nn = 4
		}
		if nn > len(d.buf) {
			nn = len(d.buf)
		}
		nn, d.readErr = d.r.Read(d.buf[d.nbuf:nn])
		d.nbuf += nn
	}

	if d.nbuf < 4 {
		if d.enc.padChar == NoPadding && d.nbuf > 0 {
			// Decode final fragment, without padding.
			var fw int32
			fw, d.err = d.enc.Decode(d.outbuf, d.buf[:d.nbuf])
			d.nbuf = 0
			d.out = d.outbuf[:fw]
			d.outOff = 0
			n = mxutil.CopyFrom(p, d.out, d.outOff)
			d.outOff += n
			if n > 0 || len(p) == 0 && len(d.out)-d.outOff > 0 {
				return n, nil
			}
			if d.err != nil {
				return 0, d.err
			}
		}
		d.err = d.readErr
		if d.err == io.EOF && d.nbuf > 0 {
			d.err = io.ErrUnexpectedEOF
		}
		return 0, d.err
	}

	// Decode chunk into p, or d.out and then p if p is too small.
	nr := d.nbuf / 4 * 4
	nw := d.nbuf / 4 * 3
	if nw > len(p) {
		nw, d.err = d.enc.decodeAtLen(d.outbuf, 0, d.buf, nr)
		d.out = d.outbuf[:nw]
		d.outOff = 0
		n = mxutil.CopyFrom(p, d.out, d.outOff)
		d.outOff += n
	} else {
		n, d.err = d.enc.decodeAtLen(p, 0, d.buf, nr)
	}
	d.nbuf -= nr
	// Index loop, not copy(d.buf[:d.nbuf], d.buf[nr:]): a sub-slice is a copy.
	for k := int32(0); k < d.nbuf; k++ {
		d.buf[k] = d.buf[nr+k]
	}
	return n, d.err
}

// Decode decodes src using the encoding enc. It writes at most
// [Encoding.DecodedLen](len(src)) bytes to dst and returns the number of bytes
// written. The caller must ensure that dst is large enough to hold all
// the decoded data. If src contains invalid base64 data, it will return the
// number of bytes successfully written and [CorruptInputError].
// New line characters (\r and \n) are ignored.
func (enc *Encoding) Decode(dst, src []byte) (n int32, err error) {
	return enc.DecodeAt(dst, 0, src)
}

// DecodeAt decodes src into dst at offset doff. dst must be doff+DecodedLen at
// least long, not merely that capacity: the writes are indexed.
func (enc *Encoding) DecodeAt(dst []byte, doff int32, src []byte) (n int32, err error) {
	return enc.decodeAtLen(dst, doff, src, len(src))
}

// decodeAtLen is DecodeAt over src[0:sn], so a streaming decoder can name a
// length inside its fixed input buffer without slicing it.
func (enc *Encoding) decodeAtLen(dst []byte, doff int32, src []byte, sn int32) (n int32, err error) {
	if sn == 0 {
		return 0, nil
	}

	// Lift the nil check outside of the loop. enc.decodeMap is directly
	// used later in this function, to let the compiler know that the
	// receiver can't be nil.
	_ = enc.decodeMap

	// si and n walk src and dst. Every window is indexed: src[si:si+8] is a
	// copy of the quantum and dst[n:] is a copy of the whole remaining output,
	// so the slice forms move the same bytes again per quantum.
	n = doff
	si := 0
	for strconv.IntSize >= 64 && sn-si >= 8 && len(dst)-n >= 8 {
		if dn, ok := assemble64(
			enc.decodeMap[src[si+0]],
			enc.decodeMap[src[si+1]],
			enc.decodeMap[src[si+2]],
			enc.decodeMap[src[si+3]],
			enc.decodeMap[src[si+4]],
			enc.decodeMap[src[si+5]],
			enc.decodeMap[src[si+6]],
			enc.decodeMap[src[si+7]],
		); ok {
			byteorder.BEPutUint64At(dst, n, dn)
			n += 6
			si += 8
		} else {
			var ninc int32
			si, ninc, err = enc.decodeQuantum(dst, n, src, si, sn)
			n += ninc
			if err != nil {
				return n - doff, err
			}
		}
	}

	for sn-si >= 4 && len(dst)-n >= 4 {
		if dn, ok := assemble32(
			enc.decodeMap[src[si+0]],
			enc.decodeMap[src[si+1]],
			enc.decodeMap[src[si+2]],
			enc.decodeMap[src[si+3]],
		); ok {
			byteorder.BEPutUint32At(dst, n, dn)
			n += 3
			si += 4
		} else {
			var ninc int32
			si, ninc, err = enc.decodeQuantum(dst, n, src, si, sn)
			n += ninc
			if err != nil {
				return n - doff, err
			}
		}
	}

	for si < sn {
		var ninc int32
		si, ninc, err = enc.decodeQuantum(dst, n, src, si, sn)
		n += ninc
		if err != nil {
			return n - doff, err
		}
	}
	return n - doff, err
}

// assemble32 assembles 4 base64 digits into 3 bytes.
// Each digit comes from the decode map, and will be 0xff
// if it came from an invalid character.
func assemble32(n1, n2, n3, n4 byte) (dn uint32, ok bool) {
	// Check that all the digits are valid. If any of them was 0xff, their
	// bitwise OR will be 0xff.
	if n1|n2|n3|n4 == 0xff {
		return 0, false
	}
	return uint32(n1)<<26 |
			uint32(n2)<<20 |
			uint32(n3)<<14 |
			uint32(n4)<<8,
		true
}

// assemble64 assembles 8 base64 digits into 6 bytes.
// Each digit comes from the decode map, and will be 0xff
// if it came from an invalid character.
func assemble64(n1, n2, n3, n4, n5, n6, n7, n8 byte) (dn uint64, ok bool) {
	// Check that all the digits are valid. If any of them was 0xff, their
	// bitwise OR will be 0xff.
	if n1|n2|n3|n4|n5|n6|n7|n8 == 0xff {
		return 0, false
	}
	return uint64(n1)<<58 |
			uint64(n2)<<52 |
			uint64(n3)<<46 |
			uint64(n4)<<40 |
			uint64(n5)<<34 |
			uint64(n6)<<28 |
			uint64(n7)<<22 |
			uint64(n8)<<16,
		true
}

type newlineFilteringReader struct {
	wrapped io.Reader
}

func (r *newlineFilteringReader) Read(p []byte) (nread int32, rerr error) {
	n, err := r.wrapped.Read(p)
	for n > 0 {
		offset := 0
		for i, b := range p[:n] {
			if b != '\r' && b != '\n' {
				if i != offset {
					p[offset] = b
				}
				offset++
			}
		}
		if offset > 0 {
			return offset, err
		}
		// Previous buffer entirely whitespace, read again
		n, err = r.wrapped.Read(p)
	}
	return n, err
}

// NewDecoder constructs a new base64 stream decoder.
func NewDecoder(enc *Encoding, r io.Reader) (dec io.Reader) {
	return &decoder{
		enc:    enc,
		r:      &newlineFilteringReader{r},
		buf:    []byte{:1024},
		outbuf: []byte{:768},
	}
}

// DecodedLen returns the maximum length in bytes of the decoded data
// corresponding to n bytes of base64-encoded data.
func (enc *Encoding) DecodedLen(n int32) (out int32) {
	return decodedLen(n, enc.padChar)
}

func decodedLen(n int32, padChar rune) (out int32) {
	if padChar == NoPadding {
		// Unpadded data may end with partial block of 2-3 characters.
		return n/4*3 + n%4*6/8
	}
	// Padded base64 should always be a multiple of 4 characters in length.
	return n / 4 * 3
}
