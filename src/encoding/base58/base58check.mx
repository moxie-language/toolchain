package base58

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"errors"

	"crypto/sha256"
)

// ErrChecksum indicates that the checksum of a check-encoded string does not verify against
// the checksum.
var ErrChecksum error

// ErrInvalidFormat indicates that the check-encoded string has an invalid format.
var ErrInvalidFormat error

// checksum: first four bytes of sha256^2
func checksum(input []byte) (cksum []byte) {
	h := sha256.Sum256(input)
	h2 := sha256.Sum256(h)
	cksum = []byte{:4}
	copy(cksum, h2[:4])
	return
}

// CheckEncode prepends a version byte and appends a four byte checksum.
func CheckEncode(input []byte, version byte) (out string) {
	b := []byte{:0:1+len(input)+4}
	b = mxutil.Ensure(b, 1)
	b = push(b, version)
	b = mxutil.Ensure(b, len(input))
	b = push(b, input...)
	cksum := checksum(b)
	b = mxutil.Ensure(b, len(cksum))
	b = push(b, cksum...)
	return Encode(b)
}

// CheckDecode decodes a string that was encoded with CheckEncode and verifies the checksum.
func CheckDecode(input string) (result []byte, version byte, err error) {
	decoded := Decode(input)
	if len(decoded) < 5 {
		return nil, 0, ErrInvalidFormat
	}
	version = decoded[0]
	cksum := []byte{:4}
	copy(cksum, decoded[len(decoded)-4:])
	if checksum(decoded[:len(decoded)-4]) != cksum {
		return nil, 0, ErrChecksum
	}
	payload := decoded[1 : len(decoded)-4]
	result = mxutil.Ensure(result, len(payload))
	result = push(result, payload...)
	return
}

func init() {
	ErrChecksum = errors.New("checksum error")
	ErrInvalidFormat = errors.New("invalid format: version and/or checksum bytes missing")
}
