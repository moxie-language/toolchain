package asn1

import (
	"strconv"
	"bytes"
)

// ASN.1 objects have metadata preceding them:
//   the tag: the type of the object
//   a flag denoting if this object is compound or not
//   the class type: the namespace of the tag
//   the length of the object, in bytes

// Here are some standard tags and classes

// ASN.1 tags represent the type of the following object.
const (
	TagBoolean         = 1
	TagInteger         = 2
	TagBitString       = 3
	TagOctetString     = 4
	TagNull            = 5
	TagOID             = 6
	TagEnum            = 10
	TagUTF8String      = 12
	TagSequence        = 16
	TagSet             = 17
	TagNumericString   = 18
	TagPrintableString = 19
	TagT61String       = 20
	TagIA5String       = 22
	TagUTCTime         = 23
	TagGeneralizedTime = 24
	TagGeneralString   = 27
	TagBMPString       = 30
)

// ASN.1 class types represent the namespace of the tag.
const (
	ClassUniversal       = 0
	ClassApplication     = 1
	ClassContextSpecific = 2
	ClassPrivate         = 3
)

type tagAndLength struct {
	class, tag, length int32
	isCompound         bool
}

// ASN.1 has IMPLICIT and EXPLICIT tags, which can be translated as "instead
// of" and "in addition to". When not specified, every primitive type has a
// default tag in the UNIVERSAL class.
//
// For example: a BIT STRING is tagged [UNIVERSAL 3] by default (although ASN.1
// doesn't actually have a UNIVERSAL keyword). However, by saying [IMPLICIT
// CONTEXT-SPECIFIC 42], that means that the tag is replaced by another.
//
// On the other hand, if it said [EXPLICIT CONTEXT-SPECIFIC 10], then an
// /additional/ tag would wrap the default tag. This explicit tag will have the
// compound flag set.
//
// (This is used in order to remove ambiguity with optional elements.)
//
// You can layer EXPLICIT and IMPLICIT tags to an arbitrary depth, however we
// don't support that here. We support a single layer of EXPLICIT or IMPLICIT
// tagging with tag strings on the fields of a structure.

// fieldParameters is the parsed representation of tag string from a structure field.
type fieldParameters struct {
	optional     bool   // true iff the field is OPTIONAL
	explicit     bool   // true iff an EXPLICIT tag is in use.
	application  bool   // true iff an APPLICATION tag is in use.
	private      bool   // true iff a PRIVATE tag is in use.
	defaultValue *int64 // a default value for INTEGER typed fields (maybe nil).
	tag          *int32   // the EXPLICIT or IMPLICIT tag (maybe nil).
	stringType   int32    // the string tag to use when marshaling.
	stringLike   bool   // true iff an akBytes value is a character string (printable or UTF-8).
	timeType     int32    // the time tag to use when marshaling.
	set          bool   // true iff this should be encoded as a SET
	omitEmpty    bool   // true iff this should be omitted if empty when marshaling.

	// Invariants:
	//   if explicit is set, tag is non-nil.
}

// Given a tag string with the format specified in the package comment,
// parseFieldParameters will parse it into a fieldParameters structure,
// ignoring unknown parts of the string.
func parseFieldParameters(str []byte) (ret fieldParameters) {
	var part []byte
	for len(str) > 0 {
		part, str, _ = bytes.Cut(str, ",")
		switch {
		case part == "optional":
			ret.optional = true
		case part == "explicit":
			ret.explicit = true
			if ret.tag == nil {
				var zero int32
				ret.tag = &zero
			}
		case part == "generalized":
			ret.timeType = TagGeneralizedTime
		case part == "utc":
			ret.timeType = TagUTCTime
		case part == "ia5":
			ret.stringType = TagIA5String
		case part == "printable":
			ret.stringType = TagPrintableString
		case part == "numeric":
			ret.stringType = TagNumericString
		case part == "utf8":
			ret.stringType = TagUTF8String
		case part == "string":
			// string and []byte are one type in Moxie (akBytes), so the
			// by-value spelling no longer says which ASN.1 type is meant.
			// "string" asks for a character string, choosing PrintableString
			// when the value is printable and UTF8String otherwise - the
			// default Go gave an interface{} holding a string.
			ret.stringLike = true
		case bytes.HasPrefix(part, "default:"):
			i, err := strconv.ParseInt(part[8:], 10, 64)
			if err == nil {
				dv := i
				ret.defaultValue = &dv
			}
		case bytes.HasPrefix(part, "tag:"):
			i, err := strconv.Atoi(part[4:])
			if err == nil {
				tag := i
				ret.tag = &tag
			}
		case part == "set":
			ret.set = true
		case part == "application":
			ret.application = true
			if ret.tag == nil {
				var zero int32
				ret.tag = &zero
			}
		case part == "private":
			ret.private = true
			if ret.tag == nil {
				var zero int32
				ret.tag = &zero
			}
		case part == "omitempty":
			ret.omitEmpty = true
		}
	}
	return
}

// getUniversalType returns the default ASN.1 tag number and expected compound
// flag for a type identified by its raw type code pointer.
func getUniversalType(t *_rawType) (matchAny bool, tagNumber int32, isCompound, ok bool) {
	switch t {
	case _rawValueTC():
		return true, -1, false, true
	case _objectIdentifierTC():
		return false, TagOID, false, true
	case _bitStringTC():
		return false, TagBitString, false, true
	case _timeTC():
		return false, TagUTCTime, false, true
	case _enumeratedTC():
		return false, TagEnum, false, true
	case _bigIntPtrTC():
		return false, TagInteger, false, true
	}
	switch t.kind() {
	case akBool:
		return false, TagBoolean, false, true
	case akInt, akInt8, akInt16, akInt32, akInt64:
		return false, TagInteger, false, true
	case akStruct:
		return false, TagSequence, true, true
	case akSlice:
		if t.elem().kind() == akUint8 {
			return false, TagOctetString, false, true
		}
		if bytes.HasSuffix(t.typeName(), "SET") {
			return false, TagSet, true, true
		}
		return false, TagSequence, true, true
	case akBytes:
		// akBytes is the unified string=[]byte type. The Go spelling that
		// carried the meaning (string -> PrintableString, []byte -> OCTET
		// STRING) is erased before the descriptor exists, so the byte-string
		// meaning is the default. A field that means a character string says
		// so with an asn1 parameter: "string" (printable or UTF-8), "printable",
		// "utf8", "ia5" or "numeric".
		return false, TagOctetString, false, true
	}
	return false, 0, false, false
}
