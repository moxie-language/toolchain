package asn1

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"bytes"
	"errors"
	"fmt"
	"math/big"
	"slices"
	"time"
	"unicode/utf8"
	"unsafe"
)

func _byte00Encoder() (e encoder) { return &byteEncoder{v: 0x00} }
func _byteFFEncoder() (e encoder) { return &byteEncoder{v: 0xff} }

// encoder represents an ASN.1 element that is waiting to be marshaled.
type encoder interface {
	// Len returns the number of bytes needed to marshal this element.
	Len() int32
	// Encode writes this element's Len() bytes at dst[off:]. The offset form
	// is required: a sub-slice is a copy, so `x.Encode(dst[off:])` wrote the
	// copy and the marshalled element stayed zero.
	Encode(dst []byte, off int32)
}

type byteEncoder struct{ v byte }

func (c *byteEncoder) Len() (n int32) {
	return 1
}

func (c *byteEncoder) Encode(dst []byte, off int32) {
	dst[off] = c.v
}

type bytesEncoder struct{ b []byte }

func (e *bytesEncoder) Len() (n int32) {
	return len(e.b)
}

func (e *bytesEncoder) Encode(dst []byte, off int32) {
	if mxutil.CopyAt(dst, off, e.b) != len(e.b) {
		panic("internal error")
	}
}

type stringEncoder struct{ s []byte }

func (e *stringEncoder) Len() (n int32) {
	return len(e.s)
}

func (e *stringEncoder) Encode(dst []byte, off int32) {
	if mxutil.CopyAt(dst, off, e.s) != len(e.s) {
		panic("internal error")
	}
}

type multiEncoder struct{ m []encoder }

func (e *multiEncoder) Len() (size int32) {
	for _, x := range e.m {
		size += x.Len()
	}
	return size
}

func (e *multiEncoder) Encode(dst []byte, off int32) {
	for _, x := range e.m {
		x.Encode(dst, off)
		off += x.Len()
	}
}

type setEncoder struct{ s []encoder }

func (e *setEncoder) Len() (size int32) {
	for _, x := range e.s {
		size += x.Len()
	}
	return size
}

func (e *setEncoder) Encode(dst []byte, off0 int32) {
	// Per X690 Section 11.6: The encodings of the component values of a
	// set-of value shall appear in ascending order, the encodings being
	// compared as octet strings with the shorter components being padded
	// at their trailing end with 0-octets.
	//
	// First we encode each element to its TLV encoding and then use
	// octetSort to get the ordering expected by X690 DER rules before
	// writing the sorted encodings out to dst.
	l := [][]byte{:len(e.s)}
	for i, x := range e.s {
		l[i] = []byte{:x.Len()}
		x.Encode(l[i], 0)
	}

	// Since we are using bytes.Compare to compare TLV encodings we
	// don't need to right pad s[i] and s[j] to the same length as
	// suggested in X690. If len(s[i]) < len(s[j]) the length octet of
	// s[i], which is the first determining byte, will inherently be
	// smaller than the length octet of s[j]. This lets us skip the
	// padding step.
	slices.SortFunc(l, bytes.Compare)

	off := off0
	for _, b := range l {
		mxutil.CopyAt(dst, off, b)
		off += len(b)
	}
}

func newBytesEncoder(b []byte) (e *bytesEncoder)  { return &bytesEncoder{b: b} }
func newStringEncoder(s []byte) (e *stringEncoder) { return &stringEncoder{s: s} }
func newMultiEncoder(m []encoder) (e *multiEncoder) { return &multiEncoder{m: m} }
func newSetEncoder(m []encoder) (e *setEncoder)    { return &setEncoder{s: m} }

type taggedEncoder struct {
	// The tag and length bytes are their own allocation, NOT a slice of an
	// array field of this struct. A struct-field scratch buffer makes the tag
	// encoder point into the struct that owns it, and a pointer into the
	// middle of a struct is an interior pointer the arena codec cannot
	// rewrite: the struct is copied into the caller's arena at return and
	// `tag` keeps pointing at the copy in the frame being released. The codec
	// cannot know the pointee's extent, so it preserves the address and leaks
	// that frame - one leaked frame per tag, per Marshal. Sixteen bytes from
	// Ensure costs nothing next to that.
	tag  encoder
	body encoder
}

func (t *taggedEncoder) Len() (n int32) {
	return t.tag.Len() + t.body.Len()
}

func (t *taggedEncoder) Encode(dst []byte, off int32) {
	t.tag.Encode(dst, off)
	t.body.Encode(dst, off+t.tag.Len())
}

type int64Encoder struct{ v int64 }

func (e *int64Encoder) Len() (n int32) {
	v := e.v
	n = 1

	for v > 127 {
		n++
		v >>= 8
	}

	for v < -128 {
		n++
		v >>= 8
	}

	return n
}

func (e *int64Encoder) Encode(dst []byte, off int32) {
	n := e.Len()

	for j := 0; j < n; j++ {
		dst[off+j] = byte(e.v >> uint32((n-1-j)*8))
	}
}

func newInt64Encoder(v int64) (e *int64Encoder) { return &int64Encoder{v: v} }

func base128IntLength(n int64) (out int32) {
	if n == 0 {
		return 1
	}

	l := 0
	for i := n; i > 0; i >>= 7 {
		l++
	}

	return l
}

func appendBase128Int(dst []byte, n int64) (out []byte) {
	l := base128IntLength(n)

	for i := l - 1; i >= 0; i-- {
		o := byte(n >> uint32(i*7))
		o &= 0x7f
		if i != 0 {
			o |= 0x80
		}

		dst = mxutil.Ensure(dst, 1)
		dst = push(dst, o)
	}

	return dst
}

func makeBigInt(n *big.Int) (e encoder, derr error) {
	if n == nil {
		return nil, &StructuralError{"empty integer"}
	}

	if n.Sign() < 0 {
		// A negative number has to be converted to two's-complement
		// form. So we'll invert and subtract 1. If the
		// most-significant-bit isn't set then we'll need to pad the
		// beginning with 0xff in order to keep the number negative.
		nMinus1 := (&big.Int{}).Neg(n)
		nMinus1.Sub(nMinus1, big.NewInt(1))
		der := nMinus1.Bytes()
		for i := range der {
			der[i] ^= 0xff
		}
		if len(der) == 0 || der[0]&0x80 == 0 {
			return newMultiEncoder([]encoder{_byteFFEncoder(), newBytesEncoder(der)}), nil
		}
		return newBytesEncoder(der), nil
	} else if n.Sign() == 0 {
		// Zero is written as a single 0 zero rather than no bytes.
		return _byte00Encoder(), nil
	} else {
		der := n.Bytes()
		if len(der) > 0 && der[0]&0x80 != 0 {
			// We'll have to pad this with 0x00 in order to stop it
			// looking like a negative number.
			return newMultiEncoder([]encoder{_byte00Encoder(), newBytesEncoder(der)}), nil
		}
		return newBytesEncoder(der), nil
	}
}

func appendLength(dst []byte, i int32) (out []byte) {
	n := lengthLength(i)

	for ; n > 0; n-- {
		dst = mxutil.Ensure(dst, 1)
		dst = push(dst, byte(i>>uint32((n-1)*8)))
	}

	return dst
}

func lengthLength(i int32) (numBytes int32) {
	numBytes = 1
	for i > 255 {
		numBytes++
		i >>= 8
	}
	return
}

func appendTagAndLength(dst []byte, t tagAndLength) (out []byte) {
	b := uint8(t.class) << 6
	if t.isCompound {
		b |= 0x20
	}
	if t.tag >= 31 {
		b |= 0x1f
		dst = mxutil.Ensure(dst, 1)
		dst = push(dst, b)
		dst = appendBase128Int(dst, int64(t.tag))
	} else {
		b |= uint8(t.tag)
		dst = mxutil.Ensure(dst, 1)
		dst = push(dst, b)
	}

	if t.length >= 128 {
		l := lengthLength(t.length)
		dst = mxutil.Ensure(dst, 1)
		dst = push(dst, 0x80|byte(l))
		dst = appendLength(dst, t.length)
	} else {
		dst = mxutil.Ensure(dst, 1)
		dst = push(dst, byte(t.length))
	}

	return dst
}

type bitStringEncoder struct{ b BitString }

func (e *bitStringEncoder) Len() (n int32) {
	return len(e.b.Bytes) + 1
}

func (e *bitStringEncoder) Encode(dst []byte, off int32) {
	dst[off] = byte((8 - e.b.BitLength%8) % 8)
	if mxutil.CopyAt(dst, off+1, e.b.Bytes) != len(e.b.Bytes) {
		panic("internal error")
	}
}

func newBitStringEncoder(b BitString) (e *bitStringEncoder) { return &bitStringEncoder{b: b} }

type oidEncoder struct{ oid []int32 }

func (e *oidEncoder) Len() (l int32) {
	l = base128IntLength(int64(e.oid[0]*40 + e.oid[1]))
	for i := 2; i < len(e.oid); i++ {
		l += base128IntLength(int64(e.oid[i]))
	}
	return l
}

// writeBase128Int writes n into dst starting at off and returns the next free
// offset. It writes IN PLACE because Moxie has no aliasing: a subslice is a
// copy, so the Go idiom `dst = appendBase128Int(dst[:0], n)` mutates a fresh
// buffer and throws it away, leaving the real dst untouched - every
// ObjectIdentifier marshalled as 00 00 00. The encoder contract gives dst
// exactly Len() bytes, so the cursor is what bounds the writes.
func writeBase128Int(dst []byte, off int32, n int64) (next int32) {
	l := base128IntLength(n)
	for i := l - 1; i >= 0; i-- {
		o := byte(n >> uint32(i*7))
		o &= 0x7f
		if i != 0 {
			o |= 0x80
		}
		dst[off] = o
		off++
	}
	return off
}

func (e *oidEncoder) Encode(dst []byte, off0 int32) {
	off := writeBase128Int(dst, off0, int64(e.oid[0]*40+e.oid[1]))
	for i := 2; i < len(e.oid); i++ {
		off = writeBase128Int(dst, off, int64(e.oid[i]))
	}
}

func newOidEncoder(oid []int32) (e *oidEncoder) { return &oidEncoder{oid: oid} }

func makeObjectIdentifier(oid ObjectIdentifier) (e encoder, err error) {
	if len(oid.OID) < 2 || oid.OID[0] > 2 || (oid.OID[0] < 2 && oid.OID[1] >= 40) {
		return nil, &StructuralError{"invalid object identifier"}
	}

	return newOidEncoder(oid.OID), nil
}

func makePrintableString(s []byte) (e encoder, err error) {
	for i := 0; i < len(s); i++ {
		// The asterisk is often used in PrintableString, even though
		// it is invalid. If a PrintableString was specifically
		// requested then the asterisk is permitted by this code.
		// Ampersand is allowed in parsing due a handful of CA
		// certificates, however when making new certificates
		// it is rejected.
		if !isPrintable(s[i], allowAsterisk, rejectAmpersand) {
			return nil, &StructuralError{"PrintableString contains invalid character"}
		}
	}

	return newStringEncoder(s), nil
}

func makeIA5String(s []byte) (e encoder, err error) {
	for i := 0; i < len(s); i++ {
		if s[i] > 127 {
			return nil, &StructuralError{"IA5String contains invalid character"}
		}
	}

	return newStringEncoder(s), nil
}

func makeNumericString(s []byte) (e encoder, err error) {
	for i := 0; i < len(s); i++ {
		if !isNumeric(s[i]) {
			return nil, &StructuralError{"NumericString contains invalid character"}
		}
	}

	return newStringEncoder(s), nil
}

func makeUTF8String(s []byte) (e encoder) {
	return newStringEncoder(s)
}

func appendTwoDigits(dst []byte, v int32) (out []byte) {
	return push(dst, byte('0'+(v/10)%10), byte('0'+v%10))
}

func appendFourDigits(dst []byte, v int32) (out []byte) {
	return push(dst,
		byte('0'+(v/1000)%10),
		byte('0'+(v/100)%10),
		byte('0'+(v/10)%10),
		byte('0'+v%10))
}

func outsideUTCRange(t time.Time) (ok bool) {
	year := t.Year()
	return year < 1950 || year >= 2050
}

func makeUTCTime(t time.Time) (e encoder, err error) {
	dst := []byte{:0:18}

	dst, err = appendUTCTime(dst, t)
	if err != nil {
		return nil, err
	}

	return newBytesEncoder(dst), nil
}

func makeGeneralizedTime(t time.Time) (e encoder, err error) {
	dst := []byte{:0:20}

	dst, err = appendGeneralizedTime(dst, t)
	if err != nil {
		return nil, err
	}

	return newBytesEncoder(dst), nil
}

func appendUTCTime(dst []byte, t time.Time) (ret []byte, err error) {
	year := t.Year()

	switch {
	case 1950 <= year && year < 2000:
		dst = appendTwoDigits(dst, year-1900)
	case 2000 <= year && year < 2050:
		dst = appendTwoDigits(dst, year-2000)
	default:
		return nil, &StructuralError{"cannot represent time as UTCTime"}
	}

	return appendTimeCommon(dst, t), nil
}

func appendGeneralizedTime(dst []byte, t time.Time) (ret []byte, err error) {
	year := t.Year()
	if year < 0 || year > 9999 {
		return nil, &StructuralError{"cannot represent time as GeneralizedTime"}
	}

	dst = appendFourDigits(dst, year)

	return appendTimeCommon(dst, t), nil
}

func appendTimeCommon(dst []byte, t time.Time) (out []byte) {
	_, month, day := t.Date()

	dst = appendTwoDigits(dst, int32(month))
	dst = appendTwoDigits(dst, day)

	hour, minute, sec := t.Clock()

	dst = appendTwoDigits(dst, hour)
	dst = appendTwoDigits(dst, minute)
	dst = appendTwoDigits(dst, sec)

	_, offset := t.Zone()

	switch {
	case offset/60 == 0:
		return push(dst, 'Z')
	case offset > 0:
		dst = mxutil.Ensure(dst, 1)
		dst = push(dst, '+')
	case offset < 0:
		dst = mxutil.Ensure(dst, 1)
		dst = push(dst, '-')
	}

	offsetMinutes := offset / 60
	if offsetMinutes < 0 {
		offsetMinutes = -offsetMinutes
	}

	dst = appendTwoDigits(dst, offsetMinutes/60)
	dst = appendTwoDigits(dst, offsetMinutes%60)

	return dst
}

func stripTagAndLength(in []byte) (out []byte) {
	_, offset, err := parseTagAndLength(in, 0)
	if err != nil {
		return in
	}
	return in[offset:]
}


func makeBody(typ *_rawType, ptr unsafe.Pointer, params fieldParameters) (e encoder, err error) {
	// Known concrete types by type code pointer comparison.
	if typ == _flagTC() {
		return newBytesEncoder(nil), nil
	}
	if typ == _timeTC() {
		t := *(*time.Time)(ptr)
		if params.timeType == TagGeneralizedTime || outsideUTCRange(t) {
			return makeGeneralizedTime(t)
		}
		return makeUTCTime(t)
	}
	if typ == _bitStringTC() {
		return newBitStringEncoder(*(*BitString)(ptr)), nil
	}
	if typ == _objectIdentifierTC() {
		return makeObjectIdentifier(*(*ObjectIdentifier)(ptr))
	}
	if typ == _bigIntPtrTC() {
		return makeBigInt(*(**big.Int)(ptr))
	}

	// Kind-based dispatch.
	switch typ.kind() {
	case akBool:
		if *(*bool)(ptr) {
			return _byteFFEncoder(), nil
		}
		return _byte00Encoder(), nil
	case akInt, akInt8, akInt16, akInt32, akInt64:
		var intVal int64
		switch typ.size() {
		case 1:
			intVal = int64(*(*int8)(ptr))
		case 2:
			intVal = int64(*(*int16)(ptr))
		case 4:
			intVal = int64(*(*int32)(ptr))
		default:
			intVal = *(*int64)(ptr)
		}
		return newInt64Encoder(intVal), nil
	case akStruct:
		for i := 0; i < typ.numField(); i++ {
			if !typ.fieldExported(i) {
				return nil, &StructuralError{"struct contains unexported fields"}
			}
		}

		startingField := 0
		n := typ.numField()
		if n == 0 {
			return newBytesEncoder(nil), nil
		}

		if typ.fieldType(0) == _rawContentsTC() {
			rc := *(*RawContent)(unsafe.Add(ptr, typ.fieldOffset(0)))
			if len(rc.Bytes) > 0 {
				return newBytesEncoder(stripTagAndLength(rc.Bytes)), nil
			}
			startingField = 1
		}

		switch n1 := n - startingField; n1 {
		case 0:
			return newBytesEncoder(nil), nil
		case 1:
			ft := typ.fieldType(startingField)
			fp := unsafe.Add(ptr, typ.fieldOffset(startingField))
			tag := getASN1Tag(typ.fieldTag(startingField))
			return makeField(ft, fp, parseFieldParameters(tag))
		default:
			m := []encoder{:n1}
			for i := 0; i < n1; i++ {
				fi := i + startingField
				ft := typ.fieldType(fi)
				fp := unsafe.Add(ptr, typ.fieldOffset(fi))
				tag := getASN1Tag(typ.fieldTag(fi))
				m[i], err = makeField(ft, fp, parseFieldParameters(tag))
				if err != nil {
					return nil, err
				}
			}
			return newMultiEncoder(m), nil
		}
	case akSlice:
		if typ.elem().kind() == akUint8 {
			return newBytesEncoder(*(*[]byte)(ptr)), nil
		}
		hdr := (*_sliceHeader)(ptr)
		l := hdr.len
		elemType := typ.elem()
		var fp fieldParameters
		switch l {
		case 0:
			return newBytesEncoder(nil), nil
		case 1:
			return makeField(elemType, sliceIndex(ptr, elemType, 0), fp)
		default:
			m := []encoder{:l}
			for i := 0; i < l; i++ {
				m[i], err = makeField(elemType, sliceIndex(ptr, elemType, i), fp)
				if err != nil {
					return nil, err
				}
			}
			if params.set {
				return newSetEncoder(m), nil
			}
			return newMultiEncoder(m), nil
		}
	case akBytes:
		s := *(*[]byte)(ptr)
		switch params.stringType {
		case TagIA5String:
			return makeIA5String(s)
		case TagPrintableString:
			return makePrintableString(s)
		case TagNumericString:
			return makeNumericString(s)
		case TagUTF8String:
			return makeUTF8String(s), nil
		default:
			// No string parameter: the value is a byte string.
			return newBytesEncoder(s), nil
		}
	}

	return nil, &StructuralError{"unknown Go type"}
}

// isZeroValue reports whether the value at ptr is all zero bytes.
func isZeroValue(typ *_rawType, ptr unsafe.Pointer) (ok bool) {
	sz := typ.size()
	for i := uintptr(0); i < sz; i++ {
		if *(*byte)(unsafe.Add(ptr, i)) != 0 {
			return false
		}
	}
	return true
}

func makeField(typ *_rawType, ptr unsafe.Pointer, params fieldParameters) (e encoder, err error) {
	if typ == nil || ptr == nil {
		return nil, fmt.Errorf("asn1: cannot marshal nil value")
	}
	// The empty interface is absent in Moxie; interface{} fields are not
	// representable, so encoding one is a compile-time-unreachable error.
	if typ.kind() == akInterface {
		return nil, fmt.Errorf("asn1: interface{} fields are not supported in Moxie")
	}

	if typ.kind() == akSlice && (*_sliceHeader)(ptr).len == 0 && params.omitEmpty {
		return newBytesEncoder(nil), nil
	}

	if params.optional && params.hasDefault {
		k := typ.kind()
		if k == akInt || k == akInt8 || k == akInt16 || k == akInt32 || k == akInt64 {
			var current int64
			switch typ.size() {
			case 1:
				current = int64(*(*int8)(ptr))
			case 2:
				current = int64(*(*int16)(ptr))
			case 4:
				current = int64(*(*int32)(ptr))
			default:
				current = *(*int64)(ptr)
			}
			if current == params.defaultValue {
				return newBytesEncoder(nil), nil
			}
		}
	}

	if params.optional && !params.hasDefault {
		if isZeroValue(typ, ptr) {
			return newBytesEncoder(nil), nil
		}
	}

	if typ == _rawValueTC() {
		rv := *(*RawValue)(ptr)
		if len(rv.FullBytes) != 0 {
			return newBytesEncoder(rv.FullBytes), nil
		}
		rt := &taggedEncoder{}
		rt.tag = newBytesEncoder(appendTagAndLength(nil, tagAndLength{rv.Class, rv.Tag, len(rv.Bytes), rv.IsCompound}))
		rt.body = newBytesEncoder(rv.Bytes)
		return rt, nil
	}

	matchAny, tag, isCompound, ok := getUniversalType(typ)
	if !ok || matchAny {
		return nil, &StructuralError{fmt.Sprintf("unknown Go type (kind %d)", typ.kind())}
	}

	if params.timeType != 0 && tag != TagUTCTime {
		return nil, &StructuralError{"explicit time type given to non-time member"}
	}

	// akBytes is the unified string=[]byte type: getUniversalType makes it an
	// OCTET STRING, and a string parameter promotes it to a character string.
	// The tag is set to PrintableString so the block below applies the
	// printable-or-UTF8 choice for "string" or the explicit type for
	// "printable"/"utf8"/"ia5"/"numeric".
	if typ.kind() == akBytes && (params.stringLike || params.stringType != 0) {
		tag = TagPrintableString
	}

	if params.stringType != 0 && tag != TagPrintableString {
		return nil, &StructuralError{"explicit string type given to non-string member"}
	}

	switch tag {
	case TagPrintableString:
		if params.stringType == 0 {
			s := *(*[]byte)(ptr)
			for _, r := range s {
				if r >= utf8.RuneSelf || !isPrintable(r, rejectAsterisk, rejectAmpersand) {
					if !utf8.Valid(s) {
						return nil, errors.New("asn1: string not valid UTF-8")
					}
					tag = TagUTF8String
					break
				}
			}
		} else {
			tag = params.stringType
		}
	case TagUTCTime:
		if params.timeType == TagGeneralizedTime || outsideUTCRange(*(*time.Time)(ptr)) {
			tag = TagGeneralizedTime
		}
	}

	if params.set {
		if tag != TagSequence {
			return nil, &StructuralError{"non sequence tagged as set"}
		}
		tag = TagSet
	}

	if tag == TagSet && !params.set {
		params.set = true
	}

	t := &taggedEncoder{}

	t.body, err = makeBody(typ, ptr, params)
	if err != nil {
		return nil, err
	}

	bodyLen := t.body.Len()

	class := ClassUniversal
	if params.hasTag {
		if params.application {
			class = ClassApplication
		} else if params.private {
			class = ClassPrivate
		} else {
			class = ClassContextSpecific
		}

		if params.explicit {
			t.tag = newBytesEncoder(appendTagAndLength(nil, tagAndLength{ClassUniversal, tag, bodyLen, isCompound}))

			tt := &taggedEncoder{}
			tt.body = t
			tt.tag = newBytesEncoder(appendTagAndLength(nil, tagAndLength{
				class:      class,
				tag:        params.tag,
				length:     bodyLen + t.tag.Len(),
				isCompound: true,
			}))

			return tt, nil
		}

		// implicit tag.
		tag = params.tag
	}

	t.tag = newBytesEncoder(appendTagAndLength(nil, tagAndLength{class, tag, bodyLen, isCompound}))

	return t, nil
}

// Marshal returns the ASN.1 encoding of the value at data, whose static type
// is described by typ (the descriptor returned by unsafe.TypeOf of the value).
func Marshal(typ, data unsafe.Pointer) (out []byte, derr error) {
	return MarshalWithParams(typ, data, "")
}

// MarshalWithParams allows field parameters to be specified for the
// top-level element. The form of the params is the same as the field tags.
func MarshalWithParams(typ, data unsafe.Pointer, params []byte) (out []byte, derr error) {
	tc := (*_rawType)(typ)
	if tc == nil || data == nil {
		return nil, fmt.Errorf("asn1: cannot marshal nil value")
	}
	e, err := makeField(tc, data, parseFieldParameters(params))
	if err != nil {
		return nil, err
	}
	b := []byte{:e.Len()}
	e.Encode(b, 0)
	return b, nil
}
