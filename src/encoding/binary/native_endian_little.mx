//go:build amd64 || arm64 || wasm
//:build amd64 || arm64 || wasm

package binary

type nativeEndian struct {
	littleEndian
}

// NativeEndian returns the native-endian implementation of [ByteOrder] and [AppendByteOrder].
func NativeEndian() nativeEndian { return nativeEndian{} }
