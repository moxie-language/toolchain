// Package binary implements simple translation between numbers and byte
// sequences and encoding and decoding of varints.
//
// Numbers are translated by reading and writing fixed-size values.
// A fixed-size value is either a fixed-size arithmetic
// type (bool, int8, uint8, int16, float32, complex64, ...)
// or an array or struct containing only fixed-size values.
//
// The varint functions encode and decode single integer values using
// a variable-length encoding; smaller values require fewer bytes.
// For a specification, see
// https://developers.google.com/protocol-buffers/docs/encoding.
//
// This package favors simplicity over efficiency. Clients that require
// high-performance serialization, especially for large data structures,
// should look at more advanced solutions such as the [encoding/gob]
// package or [google.golang.org/protobuf] for protocol buffers.
package binary

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"errors"
	"io"
	"math"
	"runtime"
	"unsafe"
)

var errBufferTooSmall error

// A ByteOrder specifies how to convert byte slices into
// 16-, 32-, or 64-bit unsigned integers.
//
// It is implemented by [LittleEndian], [BigEndian], and [NativeEndian].
type ByteOrder interface {
	Uint16([]byte) uint16
	Uint32([]byte) uint32
	Uint64([]byte) uint64
	// The At forms read at an offset without slicing. A caller that walks a
	// table - debug/gosym does, once per symbol - cannot use b[off:] because a
	// sub-slice is a copy: it re-copies the rest of the table for every field.
	Uint16At([]byte, int32) uint16
	Uint32At([]byte, int32) uint32
	Uint64At([]byte, int32) uint64
	PutUint16([]byte, uint16)
	PutUint32([]byte, uint32)
	PutUint64([]byte, uint64)
	PutUint16At([]byte, int32, uint16)
	PutUint32At([]byte, int32, uint32)
	PutUint64At([]byte, int32, uint64)
	String() string
}

// AppendByteOrder specifies how to append 16-, 32-, or 64-bit unsigned integers
// into a byte slice.
//
// It is implemented by [LittleEndian], [BigEndian], and [NativeEndian].
type AppendByteOrder interface {
	AppendUint16([]byte, uint16) []byte
	AppendUint32([]byte, uint32) []byte
	AppendUint64([]byte, uint64) []byte
	String() string
}

// Singletons keep two calls to LittleEndian/BigEndian compare-equal, since
// callers compare ByteOrder values with ==.
var littleEndianInst *littleEndian
var bigEndianInst *bigEndian

func init() {
	littleEndianInst = &littleEndian{}
	bigEndianInst = &bigEndian{}
	errBufferTooSmall = errors.New("buffer too small")
	errOverflow = errors.New("binary: varint overflows a 64-bit integer")
}

// LittleEndian returns the little-endian implementation of [ByteOrder] and [AppendByteOrder].
func LittleEndian() (le *littleEndian) { return littleEndianInst }

// BigEndian returns the big-endian implementation of [ByteOrder] and [AppendByteOrder].
func BigEndian() (be *bigEndian) { return bigEndianInst }

type littleEndian struct{}

// Uint16 returns the uint16 representation of b[0:2].
func (l *littleEndian) Uint16(b []byte) (out uint16) {
	_ = b[1] // bounds check hint to compiler; see golang.org/issue/14808
	return uint16(b[0]) | uint16(b[1])<<8
}

// PutUint16 stores v into b[0:2].
func (l *littleEndian) PutUint16(b []byte, v uint16) {
	_ = b[1] // early bounds check to guarantee safety of writes below
	b[0] = byte(v)
	b[1] = byte(v >> 8)
}

// AppendUint16 appends the bytes of v to b and returns the appended slice.
func (l *littleEndian) AppendUint16(b []byte, v uint16) (out []byte) {
	return push(b,
		byte(v),
		byte(v>>8),
	)
}

// Uint32 returns the uint32 representation of b[0:4].
func (l *littleEndian) Uint32(b []byte) (out uint32) {
	_ = b[3] // bounds check hint to compiler; see golang.org/issue/14808
	return uint32(b[0]) | uint32(b[1])<<8 | uint32(b[2])<<16 | uint32(b[3])<<24
}

// Uint16At returns the uint16 at b[off:off+2].
func (l *littleEndian) Uint16At(b []byte, off int32) (out uint16) {
	return uint16(b[off]) | uint16(b[off+1])<<8
}

// Uint32At returns the uint32 at b[off:off+4].
func (l *littleEndian) Uint32At(b []byte, off int32) (out uint32) {
	return uint32(b[off]) | uint32(b[off+1])<<8 | uint32(b[off+2])<<16 | uint32(b[off+3])<<24
}

// Uint64At returns the uint64 at b[off:off+8].
func (l *littleEndian) Uint64At(b []byte, off int32) (out uint64) {
	return uint64(b[off]) | uint64(b[off+1])<<8 | uint64(b[off+2])<<16 | uint64(b[off+3])<<24 |
		uint64(b[off+4])<<32 | uint64(b[off+5])<<40 | uint64(b[off+6])<<48 | uint64(b[off+7])<<56
}

// PutUint32 stores v into b[0:4].
func (l *littleEndian) PutUint32(b []byte, v uint32) {
	_ = b[3] // early bounds check to guarantee safety of writes below
	b[0] = byte(v)
	b[1] = byte(v >> 8)
	b[2] = byte(v >> 16)
	b[3] = byte(v >> 24)
}

// AppendUint32 appends the bytes of v to b and returns the appended slice.
func (l *littleEndian) AppendUint32(b []byte, v uint32) (out []byte) {
	return push(b,
		byte(v),
		byte(v>>8),
		byte(v>>16),
		byte(v>>24),
	)
}

// Uint64 returns the uint64 representation of b[0:8].
func (l *littleEndian) Uint64(b []byte) (out uint64) {
	_ = b[7] // bounds check hint to compiler; see golang.org/issue/14808
	return uint64(b[0]) | uint64(b[1])<<8 | uint64(b[2])<<16 | uint64(b[3])<<24 |
		uint64(b[4])<<32 | uint64(b[5])<<40 | uint64(b[6])<<48 | uint64(b[7])<<56
}

// PutUint64 stores v into b[0:8].
func (l *littleEndian) PutUint64(b []byte, v uint64) {
	_ = b[7] // early bounds check to guarantee safety of writes below
	b[0] = byte(v)
	b[1] = byte(v >> 8)
	b[2] = byte(v >> 16)
	b[3] = byte(v >> 24)
	b[4] = byte(v >> 32)
	b[5] = byte(v >> 40)
	b[6] = byte(v >> 48)
	b[7] = byte(v >> 56)
}

// AppendUint64 appends the bytes of v to b and returns the appended slice.
func (l *littleEndian) AppendUint64(b []byte, v uint64) (out []byte) {
	return push(b,
		byte(v),
		byte(v>>8),
		byte(v>>16),
		byte(v>>24),
		byte(v>>32),
		byte(v>>40),
		byte(v>>48),
		byte(v>>56),
	)
}

func (l *littleEndian) String() (s string) { return "LittleEndian" }

func (l *littleEndian) GoString() (out []byte) { return "binary.LittleEndian()" }

type bigEndian struct{}

// Uint16 returns the uint16 representation of b[0:2].
func (b *bigEndian) Uint16(bin []byte) (out uint16) {
	_ = bin[1] // bounds check hint to compiler; see golang.org/issue/14808
	return uint16(bin[1]) | uint16(bin[0])<<8
}

// PutUint16 stores v into b[0:2].
func (b *bigEndian) PutUint16(bin []byte, v uint16) {
	_ = bin[1] // early bounds check to guarantee safety of writes below
	bin[0] = byte(v >> 8)
	bin[1] = byte(v)
}

// AppendUint16 appends the bytes of v to b and returns the appended slice.
func (b *bigEndian) AppendUint16(bin []byte, v uint16) (out []byte) {
	return push(bin,
		byte(v>>8),
		byte(v),
	)
}

// Uint32 returns the uint32 representation of b[0:4].
func (b *bigEndian) Uint32(bin []byte) (out uint32) {
	_ = bin[3] // bounds check hint to compiler; see golang.org/issue/14808
	return uint32(bin[3]) | uint32(bin[2])<<8 | uint32(bin[1])<<16 | uint32(bin[0])<<24
}

// Uint16At returns the uint16 at b[off:off+2].
func (b *bigEndian) Uint16At(bin []byte, off int32) (out uint16) {
	return uint16(bin[off+1]) | uint16(bin[off])<<8
}

// Uint32At returns the uint32 at b[off:off+4].
func (b *bigEndian) Uint32At(bin []byte, off int32) (out uint32) {
	return uint32(bin[off+3]) | uint32(bin[off+2])<<8 | uint32(bin[off+1])<<16 | uint32(bin[off])<<24
}

// Uint64At returns the uint64 at b[off:off+8].
func (b *bigEndian) Uint64At(bin []byte, off int32) (out uint64) {
	return uint64(bin[off+7]) | uint64(bin[off+6])<<8 | uint64(bin[off+5])<<16 | uint64(bin[off+4])<<24 |
		uint64(bin[off+3])<<32 | uint64(bin[off+2])<<40 | uint64(bin[off+1])<<48 | uint64(bin[off])<<56
}

// PutUint32 stores v into b[0:4].
func (b *bigEndian) PutUint32(bin []byte, v uint32) {
	_ = bin[3] // early bounds check to guarantee safety of writes below
	bin[0] = byte(v >> 24)
	bin[1] = byte(v >> 16)
	bin[2] = byte(v >> 8)
	bin[3] = byte(v)
}

// AppendUint32 appends the bytes of v to b and returns the appended slice.
func (b *bigEndian) AppendUint32(bin []byte, v uint32) (out []byte) {
	return push(bin,
		byte(v>>24),
		byte(v>>16),
		byte(v>>8),
		byte(v),
	)
}

// Uint64 returns the uint64 representation of b[0:8].
func (b *bigEndian) Uint64(bin []byte) (out uint64) {
	_ = bin[7] // bounds check hint to compiler; see golang.org/issue/14808
	return uint64(bin[7]) | uint64(bin[6])<<8 | uint64(bin[5])<<16 | uint64(bin[4])<<24 |
		uint64(bin[3])<<32 | uint64(bin[2])<<40 | uint64(bin[1])<<48 | uint64(bin[0])<<56
}

// PutUint64 stores v into b[0:8].
func (b *bigEndian) PutUint64(bin []byte, v uint64) {
	_ = bin[7] // early bounds check to guarantee safety of writes below
	bin[0] = byte(v >> 56)
	bin[1] = byte(v >> 48)
	bin[2] = byte(v >> 40)
	bin[3] = byte(v >> 32)
	bin[4] = byte(v >> 24)
	bin[5] = byte(v >> 16)
	bin[6] = byte(v >> 8)
	bin[7] = byte(v)
}

// AppendUint64 appends the bytes of v to b and returns the appended slice.
func (b *bigEndian) AppendUint64(bin []byte, v uint64) (out []byte) {
	return push(bin,
		byte(v>>56),
		byte(v>>48),
		byte(v>>40),
		byte(v>>32),
		byte(v>>24),
		byte(v>>16),
		byte(v>>8),
		byte(v),
	)
}


// PutUint16At, PutUint32At and PutUint64At store v at b[off:].
//
// A caller with a buffer and an offset - a decoder writing a field at a known
// position - used to pass b[off:off+n], which under the slice rule is a COPY, so
// the write went into a throwaway. Every one of those call sites silently wrote
// nothing (poly1305's tag, argon2's parameter block, binary.Write's own field
// store), which is why the forms exist.
func (l *littleEndian) PutUint16At(b []byte, off int32, v uint16) {
	b[off] = byte(v)
	b[off+1] = byte(v >> 8)
}

// PutUint32At stores v into b[off:off+4].
func (l *littleEndian) PutUint32At(b []byte, off int32, v uint32) {
	b[off] = byte(v)
	b[off+1] = byte(v >> 8)
	b[off+2] = byte(v >> 16)
	b[off+3] = byte(v >> 24)
}

// PutUint64At stores v into b[off:off+8].
func (l *littleEndian) PutUint64At(b []byte, off int32, v uint64) {
	b[off] = byte(v)
	b[off+1] = byte(v >> 8)
	b[off+2] = byte(v >> 16)
	b[off+3] = byte(v >> 24)
	b[off+4] = byte(v >> 32)
	b[off+5] = byte(v >> 40)
	b[off+6] = byte(v >> 48)
	b[off+7] = byte(v >> 56)
}

// PutUint16At stores v into b[off:off+2].
func (b *bigEndian) PutUint16At(bin []byte, off int32, v uint16) {
	bin[off] = byte(v >> 8)
	bin[off+1] = byte(v)
}

// PutUint32At stores v into b[off:off+4].
func (b *bigEndian) PutUint32At(bin []byte, off int32, v uint32) {
	bin[off] = byte(v >> 24)
	bin[off+1] = byte(v >> 16)
	bin[off+2] = byte(v >> 8)
	bin[off+3] = byte(v)
}

// PutUint64At stores v into b[off:off+8].
func (b *bigEndian) PutUint64At(bin []byte, off int32, v uint64) {
	bin[off] = byte(v >> 56)
	bin[off+1] = byte(v >> 48)
	bin[off+2] = byte(v >> 40)
	bin[off+3] = byte(v >> 32)
	bin[off+4] = byte(v >> 24)
	bin[off+5] = byte(v >> 16)
	bin[off+6] = byte(v >> 8)
	bin[off+7] = byte(v)
}

func (b *bigEndian) String() (s string) { return "BigEndian" }

func (b *bigEndian) GoString() (out []byte) { return "binary.BigEndian()" }

func (n *nativeEndian) String() (s string) { return "NativeEndian" }

func (n *nativeEndian) GoString() (out []byte) { return "binary.NativeEndian()" }

// Read reads structured binary data from r into data.
// Read reads structured binary data from r into the value at data, whose
// static type is described by typ. data must be the address of a fixed-size
// value (a pointer to a fixed-size value also works, with typ describing the
// pointed-to type), or the address of a slice header of fixed-size values.
// Bytes read from r are decoded using the specified byte order and written to
// successive fields of the value.
//
// The error is [io.EOF] only if no bytes were read.
// If an [io.EOF] happens after reading some but not all the bytes,
// Read returns [io.ErrUnexpectedEOF].
func Read(r io.Reader, order ByteOrder, typ, data unsafe.Pointer) (rerr error) {
	t := (*runtime.RawType)(typ)
	n := valueSize(t, data)
	if n < 0 {
		return errors.New("binary.Read: unsupported type")
	}
	bs := []byte{:n}
	if _, err := io.ReadFull(r, bs); err != nil {
		return err
	}
	d := decoder{off: 0, order: order}
	d.value(bs, t, data)
	return nil
}

// Decode decodes binary data from buf into the value at data, whose static
// type is described by typ. It returns an error if buf is too small,
// otherwise the number of bytes consumed from buf.
func Decode(buf []byte, order ByteOrder, typ, data unsafe.Pointer) (out int32, derr error) {
	t := (*runtime.RawType)(typ)
	n := valueSize(t, data)
	if n < 0 {
		return 0, errors.New("binary.Decode: unsupported type")
	}
	if int32(len(buf)) < n {
		return 0, errBufferTooSmall
	}
	d := decoder{off: 0, order: order}
	d.value(buf, t, data)
	return n, nil
}

// Write writes the binary encoding of the value at data to w. data and typ
// follow the same rules as for [Read].
func Write(w io.Writer, order ByteOrder, typ, data unsafe.Pointer) (werr error) {
	t := (*runtime.RawType)(typ)
	n := valueSize(t, data)
	if n < 0 {
		return errors.New("binary.Write: unsupported type")
	}
	bs := []byte{:n}
	e := encoder{off: 0, order: order}
	e.value(bs, t, data)
	_, err := w.Write(bs)
	return err
}

// Encode writes the binary encoding of the value at data into buf. It returns
// an error if buf is too small, otherwise the number of bytes written.
func Encode(buf []byte, order ByteOrder, typ, data unsafe.Pointer) (out int32, derr error) {
	t := (*runtime.RawType)(typ)
	n := valueSize(t, data)
	if n < 0 {
		return 0, errors.New("binary.Encode: unsupported type")
	}
	if int32(len(buf)) < n {
		return 0, errBufferTooSmall
	}
	e := encoder{off: 0, order: order}
	e.value(buf, t, data)
	return n, nil
}

// Append appends the binary encoding of the value at data to buf.
func Append(buf []byte, order ByteOrder, typ, data unsafe.Pointer) (res []byte, derr error) {
	t := (*runtime.RawType)(typ)
	n := valueSize(t, data)
	if n < 0 {
		return buf, errors.New("binary.Append: unsupported type")
	}
	bs := []byte{:n}
	e := encoder{off: 0, order: order}
	e.value(bs, t, data)
	out := []byte{:int32(len(buf)) + n}
	copy(out, buf)
	mxutil.CopyAt(out, int32(len(buf)), bs)
	return out, nil
}

// Size returns how many bytes [Write] would generate to encode the value at
// data, whose static type is described by typ. If the type is not a
// fixed-size value or a slice of fixed-size values, Size returns -1.
func Size(typ, data unsafe.Pointer) (out int32) {
	return valueSize((*runtime.RawType)(typ), data)
}

// valueSize returns the encoded size in bytes for the value at data of type
// typ: the fixed width for fixed-size types, or len*elemSize for a slice of
// fixed-size elements. Returns -1 for unsupported (variable) types.
func valueSize(typ *runtime.RawType, data unsafe.Pointer) (out int32) {
	if typ.MinLen() == typ.MaxLen() {
		return int32(typ.MinLen())
	}
	if typ.Kind() == runtime.KindSlice {
		es := typ.Elem()
		if es.MinLen() != es.MaxLen() {
			return -1
		}
		sl := *(*sliceHeader)(data)
		return int32(sl.length) * int32(es.MinLen())
	}
	return -1
}

// sliceHeader is the in-memory representation of a slice/string value.
type sliceHeader struct {
	ptr    *byte
	length uintptr
	cap    uintptr
}

// decoder walks a type descriptor, decoding fixed-size binary data into the
// pointed-to storage. The running offset lives in the receiver.
type decoder struct {
	off   int32
	order ByteOrder
}

func (d *decoder) value(bs []byte, typ *runtime.RawType, ptr unsafe.Pointer) {
	switch typ.Kind() {
	case runtime.Bool:
		*(*bool)(ptr) = bs[d.off] != 0
		d.off++
	case runtime.Int8, runtime.Uint8:
		*(*uint8)(ptr) = bs[d.off]
		d.off++
	case runtime.Int16, runtime.Uint16:
		v := d.order.Uint16(bs[d.off:])
		d.off += 2
		if typ.Kind() == runtime.Int16 {
			*(*int16)(ptr) = int16(v)
		} else {
			*(*uint16)(ptr) = v
		}
	case runtime.Int32, runtime.Uint32, runtime.Float32:
		v := d.order.Uint32(bs[d.off:])
		d.off += 4
		switch typ.Kind() {
		case runtime.Int32:
			*(*int32)(ptr) = int32(v)
		case runtime.Uint32:
			*(*uint32)(ptr) = v
		default:
			*(*float32)(ptr) = math.Float32frombits(v)
		}
	case runtime.Int64, runtime.Uint64, runtime.Float64:
		v := d.order.Uint64(bs[d.off:])
		d.off += 8
		switch typ.Kind() {
		case runtime.Int64:
			*(*int64)(ptr) = int64(v)
		case runtime.Uint64:
			*(*uint64)(ptr) = v
		default:
			*(*float64)(ptr) = math.Float64frombits(v)
		}
	case runtime.KindStruct:
		nf := typ.NumField()
		for i := int32(0); i < nf; i++ {
			d.value(bs, typ.StructFieldType(i), unsafe.Add(ptr, typ.StructFieldOffset(i)))
		}
	case runtime.KindArray:
		elem := typ.Elem()
		esz := uintptr(elem.Size())
		for i := int32(0); i < typ.ArrayLen(); i++ {
			d.value(bs, elem, unsafe.Add(ptr, uintptr(i)*esz))
		}
	case runtime.KindSlice:
		sl := (*sliceHeader)(ptr)
		elem := typ.Elem()
		esz := uintptr(elem.Size())
		if sl.ptr == nil && sl.cap > 0 {
			back := []byte{:int32(sl.cap * esz)}
			sl.ptr = (*byte)(unsafe.Pointer(&back[0]))
		}
		for i := int32(0); i < int32(sl.length); i++ {
			d.value(bs, elem, unsafe.Add(unsafe.Pointer(sl.ptr), uintptr(i)*esz))
		}
	default:
		panic("binary: unsupported type in decode")
	}
}

// encoder walks a type descriptor, encoding the pointed-to storage into a
// fixed-size byte buffer. The running offset lives in the receiver.
type encoder struct {
	off   int32
	order ByteOrder
}

func (e *encoder) value(bs []byte, typ *runtime.RawType, ptr unsafe.Pointer) {
	switch typ.Kind() {
	case runtime.Bool:
		if *(*bool)(ptr) {
			bs[e.off] = 1
		} else {
			bs[e.off] = 0
		}
		e.off++
	case runtime.Int8, runtime.Uint8:
		bs[e.off] = *(*uint8)(ptr)
		e.off++
	case runtime.Int16, runtime.Uint16:
		e.order.PutUint16At(bs, e.off, *(*uint16)(ptr))
		e.off += 2
	case runtime.Int32, runtime.Uint32, runtime.Float32:
		e.order.PutUint32At(bs, e.off, *(*uint32)(ptr))
		e.off += 4
	case runtime.Int64, runtime.Uint64, runtime.Float64:
		e.order.PutUint64At(bs, e.off, *(*uint64)(ptr))
		e.off += 8
	case runtime.KindStruct:
		nf := typ.NumField()
		for i := int32(0); i < nf; i++ {
			e.value(bs, typ.StructFieldType(i), unsafe.Add(ptr, typ.StructFieldOffset(i)))
		}
	case runtime.KindArray:
		elem := typ.Elem()
		esz := uintptr(elem.Size())
		for i := int32(0); i < typ.ArrayLen(); i++ {
			e.value(bs, elem, unsafe.Add(ptr, uintptr(i)*esz))
		}
	case runtime.KindSlice:
		sl := (*sliceHeader)(ptr)
		elem := typ.Elem()
		esz := uintptr(elem.Size())
		for i := int32(0); i < int32(sl.length); i++ {
			e.value(bs, elem, unsafe.Add(unsafe.Pointer(sl.ptr), uintptr(i)*esz))
		}
	default:
		panic("binary: unsupported type in encode")
	}
}
