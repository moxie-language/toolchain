// Package ascii85 implements the ascii85 data encoding
// as used in the btoa tool and Adobe's PostScript and PDF document formats.
package ascii85

import (
	"moxielang.dev/pkg/mxutil"
	"io"
	"strconv"
)

/*
 * Encoder
 */

// Encode encodes src into at most [MaxEncodedLen](len(src))
// bytes of dst, returning the actual number of bytes written.
//
// The encoding handles 4-byte chunks, using a special encoding
// for the last fragment, so Encode is not appropriate for use on
// individual blocks of a large data stream. Use [NewEncoder] instead.
//
// Often, ascii85-encoded data is wrapped in <~ and ~> symbols.
// Encode does not add these.
func Encode(dst, src []byte) (nout int32) {
	return EncodeFrom(dst, src, 0, len(src))
}

// EncodeFrom encodes src[off:off+n] into dst. It exists so a streaming writer
// can encode a window of its input without slicing it: a sub-slice is a copy,
// so `Encode(out, p[off:off+nn])` would allocate nn bytes per chunk.
func EncodeFrom(dst, src []byte, off, n int32) (nout int32) {
	dp, sp := int32(0), off
	end := off + n
	for sp < end {
		var dp2 int32
		dp2, sp = encodeBlock(dst, dp, src, sp, end)
		nout += dp2 - dp
		dp = dp2
	}
	return
}

// encodeBlock writes one group of at most 4 source bytes from src[sp:end] into
// dst at dp and returns the advanced cursors.
func encodeBlock(dst []byte, dp int32, src []byte, sp, end int32) (dnext, snext int32) {
	dst[dp+0] = 0
	dst[dp+1] = 0
	dst[dp+2] = 0
	dst[dp+3] = 0
	dst[dp+4] = 0

	// Unpack 4 bytes into uint32 to repack into base 85 5-byte.
	var v uint32
	rem := end - sp
	switch rem {
	default:
		v |= uint32(src[sp+3])
		v |= uint32(src[sp+2]) << 8
		v |= uint32(src[sp+1]) << 16
		v |= uint32(src[sp+0]) << 24
	case 3:
		v |= uint32(src[sp+2]) << 8
		v |= uint32(src[sp+1]) << 16
		v |= uint32(src[sp+0]) << 24
	case 2:
		v |= uint32(src[sp+1]) << 16
		v |= uint32(src[sp+0]) << 24
	case 1:
		v |= uint32(src[sp+0]) << 24
	}

	// Special case: zero (!!!!!) shortens to z.
	if v == 0 && rem >= 4 {
		dst[dp] = 'z'
		return dp + 1, sp + 4
	}

	// Otherwise, 5 base 85 digits starting at !.
	for i := int32(4); i >= 0; i-- {
		dst[dp+i] = '!' + byte(v%85)
		v /= 85
	}

	// If src was short, discard the low destination bytes.
	if rem < 4 {
		return dp + 5 - (4 - rem), end
	}
	return dp + 5, sp + 4
}

// MaxEncodedLen returns the maximum length of an encoding of n source bytes.
func MaxEncodedLen(n int32) (out int32) { return (n + 3) / 4 * 5 }

// NewEncoder returns a new ascii85 stream encoder. Data written to
// the returned writer will be encoded and then written to w.
// Ascii85 encodings operate in 32-bit blocks; when finished
// writing, the caller must Close the returned encoder to flush any
// trailing partial block.
func NewEncoder(w io.Writer) (enc io.WriteCloser) {
	return &encoder{w: w, buf: []byte{:4}, out: []byte{:1024}}
}

type encoder struct {
	err  error
	w    io.Writer
	buf  []byte // buffered data waiting to be encoded
	nbuf int32  // number of bytes in buf
	out  []byte // output buffer
}

func (e *encoder) Write(p []byte) (n int32, err error) {
	if e.err != nil {
		return 0, e.err
	}

	// off walks p. `p = p[nn:]` per chunk would copy the whole remainder.
	off := int32(0)

	// Leading fringe.
	if e.nbuf > 0 {
		var i int32
		for i = 0; i < len(p) && e.nbuf < 4; i++ {
			e.buf[e.nbuf] = p[i]
			e.nbuf++
		}
		n += i
		off = i
		if e.nbuf < 4 {
			return
		}
		nout := Encode(e.out, e.buf)
		if _, e.err = e.w.Write(e.out[:nout]); e.err != nil {
			return n, e.err
		}
		e.nbuf = 0
	}

	// Large interior chunks.
	// Declared once, outside the loop: declarations in a loop in a
	// self-mutating method are rejected, and the scratch would otherwise be
	// allocated into the sovereign arena on every iteration.
	var nn int32
	var chunkOut int32
	for len(p)-off >= 4 {
		nn = len(e.out) / 5 * 4
		if nn > len(p)-off {
			nn = len(p) - off
		}
		nn -= nn % 4
		if nn > 0 {
			chunkOut = EncodeFrom(e.out, p, off, nn)
			if _, e.err = e.w.Write(e.out[:chunkOut]); e.err != nil {
				return n, e.err
			}
		}
		n += nn
		off += nn
	}

	// Trailing fringe.
	rest := len(p) - off
	for k := int32(0); k < rest; k++ {
		e.buf[k] = p[off+k]
	}
	e.nbuf = rest
	n += rest
	return
}

// Close flushes any pending output from the encoder.
// It is an error to call Write after calling Close.
func (e *encoder) Close() (err error) {
	// If there's anything left in the buffer, flush it out
	if e.err == nil && e.nbuf > 0 {
		nout := EncodeFrom(e.out, e.buf, 0, e.nbuf)
		e.nbuf = 0
		_, e.err = e.w.Write(e.out[0:nout])
	}
	return e.err
}

/*
 * Decoder
 */

type CorruptInputError int64

func (e *CorruptInputError) Error() (msg string) {
	return "illegal ascii85 data at input byte " + strconv.FormatInt(int64(*e), 10)
}

func (e *CorruptInputError) String() (s string) { return e.Error() }

// corruptInputError returns a CorruptInputError as an error.
func corruptInputError(n int32) (cerr error) {
	ce := CorruptInputError(n)
	cerr = &ce
	return
}

// Decode decodes src into dst, returning both the number
// of bytes written to dst and the number consumed from src.
// If src contains invalid ascii85 data, Decode will return the
// number of bytes successfully written and a [CorruptInputError].
// Decode ignores space and control characters in src.
// Often, ascii85-encoded data is wrapped in <~ and ~> symbols.
// Decode expects these to have been stripped by the caller.
//
// If flush is true, Decode assumes that src represents the
// end of the input stream and processes it completely rather
// than wait for the completion of another 32-bit block.
//
// [NewDecoder] wraps an [io.Reader] interface around Decode.
func Decode(dst, src []byte, flush bool) (ndst, nsrc int32, err error) {
	return DecodeFrom(dst, src, len(src), flush)
}

// DecodeFrom is Decode over src[0:sn], so a streaming decoder can name a
// length inside its fixed input buffer without slicing it.
func DecodeFrom(dst, src []byte, sn int32, flush bool) (ndst, nsrc int32, err error) {
	var v uint32
	var nb int32
	for i := int32(0); i < sn; i++ {
		b := src[i]
		if len(dst)-ndst < 4 {
			return
		}
		switch {
		case b <= ' ':
			continue
		case b == 'z' && nb == 0:
			nb = 5
			v = 0
		case '!' <= b && b <= 'u':
			v = v*85 + uint32(b-'!')
			nb++
		default:
			return 0, 0, corruptInputError(i)
		}
		if nb == 5 {
			nsrc = i + 1
			dst[ndst] = byte(v >> 24)
			dst[ndst+1] = byte(v >> 16)
			dst[ndst+2] = byte(v >> 8)
			dst[ndst+3] = byte(v)
			ndst += 4
			nb = 0
			v = 0
		}
	}
	if flush {
		nsrc = sn
		if nb > 0 {
			// The number of output bytes in the last fragment
			// is the number of leftover input bytes - 1:
			// the extra byte provides enough bits to cover
			// the inefficiency of the encoding for the block.
			if nb == 1 {
				return 0, 0, corruptInputError(sn)
			}
			for i := nb; i < 5; i++ {
				// The short encoding truncated the output value.
				// We have to assume the worst case values (digit 84)
				// in order to ensure that the top bits are correct.
				v = v*85 + 84
			}
			for i := 0; i < nb-1; i++ {
				dst[ndst] = byte(v >> 24)
				v <<= 8
				ndst++
			}
		}
	}
	return
}

// NewDecoder constructs a new ascii85 stream decoder.
func NewDecoder(r io.Reader) (dec io.Reader) {
	return &decoder{r: r, buf: []byte{:1024}, outbuf: []byte{:1024}}
}

type decoder struct {
	err     error
	readErr error
	r       io.Reader
	buf     []byte // leftover input
	nbuf    int32
	out     []byte // leftover decoded output
	outOff  int32  // read cursor into out
	outbuf  []byte
}

func (d *decoder) Read(p []byte) (n int32, err error) {
	if len(p) == 0 {
		return 0, nil
	}
	if d.err != nil {
		return 0, d.err
	}

	// Declared once, outside the loop: declarations in a loop in a
	// self-mutating method are rejected, and the scratch would otherwise be
	// allocated into the sovereign arena on every iteration.
	var nn int32
	var nsrc int32
	var ndst int32
	var off int32
	var rest int32
	for {
		// Copy leftover output from last decode.
		if d.outOff < len(d.out) {
			n = mxutil.CopyFrom(p, d.out, d.outOff)
			d.outOff += n
			return
		}

		// Decode leftover input from last read.
		if d.nbuf > 0 {
			ndst, nsrc, d.err = DecodeFrom(d.outbuf, d.buf, d.nbuf, d.readErr != nil)
			if ndst > 0 {
				d.out = d.outbuf[0:ndst]
				d.outOff = 0
				// Compact the unread input to the front by index:
				// copy(d.buf, d.buf[nsrc:d.nbuf]) reads a sub-slice, which
				// is a copy, so it would move the remains through a
				// temporary.
				rest = d.nbuf - nsrc
				for k := int32(0); k < rest; k++ {
					d.buf[k] = d.buf[nsrc+k]
				}
				d.nbuf = rest
				continue // copy out and return
			}
			if ndst == 0 && d.err == nil {
				// Special case: input buffer is mostly filled with non-data bytes.
				// Filter out such bytes to make room for more input.
				off = 0
				for i := 0; i < d.nbuf; i++ {
					if d.buf[i] > ' ' {
						d.buf[off] = d.buf[i]
						off++
					}
				}
				d.nbuf = off
			}
		}

		// Out of input, out of decoded output. Check errors.
		if d.err != nil {
			return 0, d.err
		}
		if d.readErr != nil {
			d.err = d.readErr
			return 0, d.err
		}

		// Read more data.
		nn, d.readErr = d.r.Read(d.buf[d.nbuf:])
		d.nbuf += nn
	}
}
