package moxie moxie
iface Codec EncodeTo=interface{}->error;DecodeFrom=interface{}->error
type PipeWriter struct{Buf:[]uint8}
method PipeWriter Write []uint8->int32,error 1
type PipeReader struct{Buf:[]uint8;Pos:int32}
method PipeReader Read []uint8->int32,error 1
type HashmapAlgorithm uint8
const HashmapAlgorithmBinary uint8 0
const HashmapAlgorithmContent uint8 1
const HashmapAlgorithmInterface uint8 2
const PanicStrategyPrint int32 1
const PanicStrategyTrap int32 2
