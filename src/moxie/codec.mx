package moxie

import (
	"moxielang.dev/pkg/mxutil"
	"io"
	"unsafe"
)

// Codec is the interface that types must satisfy to cross a spawn boundary.
// Channel element types and direct arguments to spawn must implement both
// methods. The compiler enforces this statically.
type Codec interface {
	EncodeTo(w io.Writer) error
	DecodeFrom(r io.Reader) error
}

// PipeWriter is an io.Writer that appends to an internal byte buffer. The
// compiler emits a stack alloca of this struct on the send side of every
// spawn-boundary chan op, then invokes T.EncodeTo with &PipeWriter wrapped
// as io.Writer. The buffered bytes are then handed off to the runtime
// PipeChanSend helper.
//
// Lives in moxie (next to Codec) so the compiler can Lookup it and emit
// IR that references it without circularity. Both runtime and user code
// can import moxie freely.
type PipeWriter struct {
	Buf []byte
}

func (w *PipeWriter) Write(p []byte) (n int32, err error) {
	need := len(w.Buf) + len(p)
	if need > cap(w.Buf) {
		// Grow with the existing content already materialized: make() with
		// length 0 would make copy(nb, w.Buf) a no-op and drop everything
		// already encoded.
		nb := []byte{:len(w.Buf):need * 2}
		copy(nb, w.Buf)
		w.Buf = nb
	}
	w.Buf = resize(w.Buf, need)
	mxutil.CopyAt(w.Buf, need-len(p), p)
	return int32(len(p)), nil
}

// PipeReader is an io.Reader over a fixed byte buffer. The compiler emits
// a stack alloca on the recv side, fills its Buf with the bytes drained
// from the pipe, and invokes (*T).DecodeFrom with &PipeReader wrapped as
// io.Reader.
type PipeReader struct {
	Buf []byte
	Pos int32
}

func (r *PipeReader) Read(p []byte) (n int32, err error) {
	if r.Pos >= len(r.Buf) {
		return 0, io.EOF
	}
	n = int32(mxutil.CopyFrom(p, r.Buf, r.Pos))
	r.Pos += int32(n)
	return n, nil
}

// ── single-byte types (no endianness) ──────────────────────────

type Bool bool

func (v *Bool) EncodeTo(w io.Writer) (err error) {
	b := []byte{:1}
	if *v {
		b[0] = 1
	}
	_, err = w.Write(b)
	return
}

func (v *Bool) DecodeFrom(r io.Reader) (err error) {
	b := []byte{:1}
	_, err = io.ReadFull(r, b)
	*v = b[0] != 0
	return
}

type Int8 int8

func (v *Int8) EncodeTo(w io.Writer) (err error) {
	_, err = w.Write([]byte{byte(*v)})
	return
}

func (v *Int8) DecodeFrom(r io.Reader) (err error) {
	b := []byte{:1}
	_, err = io.ReadFull(r, b)
	*v = Int8(b[0])
	return
}

type Uint8 uint8

func (v *Uint8) EncodeTo(w io.Writer) (err error) {
	_, err = w.Write([]byte{byte(*v)})
	return
}

func (v *Uint8) DecodeFrom(r io.Reader) (err error) {
	b := []byte{:1}
	_, err = io.ReadFull(r, b)
	*v = Uint8(b[0])
	return
}

// ── 16-bit ─────────────────────────────────────────────────────

type Int16 int16

func (v *Int16) EncodeTo(w io.Writer) (err error) {
	b := []byte{:2}
	b[0] = byte(*v)
	b[1] = byte(*v >> 8)
	_, err = w.Write(b)
	return
}

func (v *Int16) DecodeFrom(r io.Reader) (err error) {
	b := []byte{:2}
	_, err = io.ReadFull(r, b)
	*v = Int16(b[0]) | Int16(b[1])<<8
	return
}

type Uint16 uint16

func (v *Uint16) EncodeTo(w io.Writer) (err error) {
	b := []byte{:2}
	b[0] = byte(*v)
	b[1] = byte(*v >> 8)
	_, err = w.Write(b)
	return
}

func (v *Uint16) DecodeFrom(r io.Reader) (err error) {
	b := []byte{:2}
	_, err = io.ReadFull(r, b)
	*v = Uint16(b[0]) | Uint16(b[1])<<8
	return
}

type BigInt16 int16

func (v *BigInt16) EncodeTo(w io.Writer) (err error) {
	b := []byte{:2}
	b[0] = byte(*v >> 8)
	b[1] = byte(*v)
	_, err = w.Write(b)
	return
}

func (v *BigInt16) DecodeFrom(r io.Reader) (err error) {
	b := []byte{:2}
	_, err = io.ReadFull(r, b)
	*v = BigInt16(b[0])<<8 | BigInt16(b[1])
	return
}

type BigUint16 uint16

func (v *BigUint16) EncodeTo(w io.Writer) (err error) {
	b := []byte{:2}
	b[0] = byte(*v >> 8)
	b[1] = byte(*v)
	_, err = w.Write(b)
	return
}

func (v *BigUint16) DecodeFrom(r io.Reader) (err error) {
	b := []byte{:2}
	_, err = io.ReadFull(r, b)
	*v = BigUint16(b[0])<<8 | BigUint16(b[1])
	return
}

// ── 32-bit ─────────────────────────────────────────────────────

type Int32 int32

func (v *Int32) EncodeTo(w io.Writer) (err error) {
	b := []byte{:4}
	b[0] = byte(*v)
	b[1] = byte(*v >> 8)
	b[2] = byte(*v >> 16)
	b[3] = byte(*v >> 24)
	_, err = w.Write(b)
	return
}

func (v *Int32) DecodeFrom(r io.Reader) (err error) {
	b := []byte{:4}
	_, err = io.ReadFull(r, b)
	*v = Int32(b[0]) | Int32(b[1])<<8 | Int32(b[2])<<16 | Int32(b[3])<<24
	return
}

type Uint32 uint32

func (v *Uint32) EncodeTo(w io.Writer) (err error) {
	b := []byte{:4}
	b[0] = byte(*v)
	b[1] = byte(*v >> 8)
	b[2] = byte(*v >> 16)
	b[3] = byte(*v >> 24)
	_, err = w.Write(b)
	return
}

func (v *Uint32) DecodeFrom(r io.Reader) (err error) {
	b := []byte{:4}
	_, err = io.ReadFull(r, b)
	*v = Uint32(b[0]) | Uint32(b[1])<<8 | Uint32(b[2])<<16 | Uint32(b[3])<<24
	return
}

type BigInt32 int32

func (v *BigInt32) EncodeTo(w io.Writer) (err error) {
	b := []byte{:4}
	b[0] = byte(*v >> 24)
	b[1] = byte(*v >> 16)
	b[2] = byte(*v >> 8)
	b[3] = byte(*v)
	_, err = w.Write(b)
	return
}

func (v *BigInt32) DecodeFrom(r io.Reader) (err error) {
	b := []byte{:4}
	_, err = io.ReadFull(r, b)
	*v = BigInt32(b[0])<<24 | BigInt32(b[1])<<16 | BigInt32(b[2])<<8 | BigInt32(b[3])
	return
}

type BigUint32 uint32

func (v *BigUint32) EncodeTo(w io.Writer) (err error) {
	b := []byte{:4}
	b[0] = byte(*v >> 24)
	b[1] = byte(*v >> 16)
	b[2] = byte(*v >> 8)
	b[3] = byte(*v)
	_, err = w.Write(b)
	return
}

func (v *BigUint32) DecodeFrom(r io.Reader) (err error) {
	b := []byte{:4}
	_, err = io.ReadFull(r, b)
	*v = BigUint32(b[0])<<24 | BigUint32(b[1])<<16 | BigUint32(b[2])<<8 | BigUint32(b[3])
	return
}

// ── 64-bit ─────────────────────────────────────────────────────

type Int64 int64

func (v *Int64) EncodeTo(w io.Writer) (err error) {
	b := []byte{:8}
	b[0] = byte(*v)
	b[1] = byte(*v >> 8)
	b[2] = byte(*v >> 16)
	b[3] = byte(*v >> 24)
	b[4] = byte(*v >> 32)
	b[5] = byte(*v >> 40)
	b[6] = byte(*v >> 48)
	b[7] = byte(*v >> 56)
	_, err = w.Write(b)
	return
}

func (v *Int64) DecodeFrom(r io.Reader) (err error) {
	b := []byte{:8}
	_, err = io.ReadFull(r, b)
	*v = Int64(b[0]) | Int64(b[1])<<8 | Int64(b[2])<<16 | Int64(b[3])<<24 |
		Int64(b[4])<<32 | Int64(b[5])<<40 | Int64(b[6])<<48 | Int64(b[7])<<56
	return
}

type Uint64 uint64

func (v *Uint64) EncodeTo(w io.Writer) (err error) {
	b := []byte{:8}
	b[0] = byte(*v)
	b[1] = byte(*v >> 8)
	b[2] = byte(*v >> 16)
	b[3] = byte(*v >> 24)
	b[4] = byte(*v >> 32)
	b[5] = byte(*v >> 40)
	b[6] = byte(*v >> 48)
	b[7] = byte(*v >> 56)
	_, err = w.Write(b)
	return
}

func (v *Uint64) DecodeFrom(r io.Reader) (err error) {
	b := []byte{:8}
	_, err = io.ReadFull(r, b)
	*v = Uint64(b[0]) | Uint64(b[1])<<8 | Uint64(b[2])<<16 | Uint64(b[3])<<24 |
		Uint64(b[4])<<32 | Uint64(b[5])<<40 | Uint64(b[6])<<48 | Uint64(b[7])<<56
	return
}

type BigInt64 int64

func (v *BigInt64) EncodeTo(w io.Writer) (err error) {
	b := []byte{:8}
	b[0] = byte(*v >> 56)
	b[1] = byte(*v >> 48)
	b[2] = byte(*v >> 40)
	b[3] = byte(*v >> 32)
	b[4] = byte(*v >> 24)
	b[5] = byte(*v >> 16)
	b[6] = byte(*v >> 8)
	b[7] = byte(*v)
	_, err = w.Write(b)
	return
}

func (v *BigInt64) DecodeFrom(r io.Reader) (err error) {
	b := []byte{:8}
	_, err = io.ReadFull(r, b)
	*v = BigInt64(b[0])<<56 | BigInt64(b[1])<<48 | BigInt64(b[2])<<40 | BigInt64(b[3])<<32 |
		BigInt64(b[4])<<24 | BigInt64(b[5])<<16 | BigInt64(b[6])<<8 | BigInt64(b[7])
	return
}

type BigUint64 uint64

func (v *BigUint64) EncodeTo(w io.Writer) (err error) {
	b := []byte{:8}
	b[0] = byte(*v >> 56)
	b[1] = byte(*v >> 48)
	b[2] = byte(*v >> 40)
	b[3] = byte(*v >> 32)
	b[4] = byte(*v >> 24)
	b[5] = byte(*v >> 16)
	b[6] = byte(*v >> 8)
	b[7] = byte(*v)
	_, err = w.Write(b)
	return
}

func (v *BigUint64) DecodeFrom(r io.Reader) (err error) {
	b := []byte{:8}
	_, err = io.ReadFull(r, b)
	*v = BigUint64(b[0])<<56 | BigUint64(b[1])<<48 | BigUint64(b[2])<<40 | BigUint64(b[3])<<32 |
		BigUint64(b[4])<<24 | BigUint64(b[5])<<16 | BigUint64(b[6])<<8 | BigUint64(b[7])
	return
}

// ── float ──────────────────────────────────────────────────────

type Float32 float32

func (v *Float32) EncodeTo(w io.Writer) (err error) {
	return (*Uint32)(unsafe.Pointer(v)).EncodeTo(w)
}

func (v *Float32) DecodeFrom(r io.Reader) (err error) {
	return (*Uint32)(unsafe.Pointer(v)).DecodeFrom(r)
}

type Float64 float64

func (v *Float64) EncodeTo(w io.Writer) (err error) {
	return (*Uint64)(unsafe.Pointer(v)).EncodeTo(w)
}

func (v *Float64) DecodeFrom(r io.Reader) (err error) {
	return (*Uint64)(unsafe.Pointer(v)).DecodeFrom(r)
}

type BigFloat32 float32

func (v *BigFloat32) EncodeTo(w io.Writer) (err error) {
	return (*BigUint32)(unsafe.Pointer(v)).EncodeTo(w)
}

func (v *BigFloat32) DecodeFrom(r io.Reader) (err error) {
	return (*BigUint32)(unsafe.Pointer(v)).DecodeFrom(r)
}

type BigFloat64 float64

func (v *BigFloat64) EncodeTo(w io.Writer) (err error) {
	return (*BigUint64)(unsafe.Pointer(v)).EncodeTo(w)
}

func (v *BigFloat64) DecodeFrom(r io.Reader) (err error) {
	return (*BigUint64)(unsafe.Pointer(v)).DecodeFrom(r)
}

// ── bytes (string = []byte in moxie) ───────────────────────────

// EncodeBytes writes v as a Uint32 (LE) length prefix followed by the bytes.
func EncodeBytes(w io.Writer, v []byte) (err error) {
	n := Uint32(len(v))
	if err = n.EncodeTo(w); err != nil {
		return err
	}
	_, err = w.Write(v)
	return
}

// DecodeBytes reads a Uint32 (LE) length prefix and then that many bytes.
func DecodeBytes(r io.Reader) (v []byte, err error) {
	var n Uint32
	if err = n.DecodeFrom(r); err != nil {
		return
	}
	v = []byte{:int32(n)}
	_, err = io.ReadFull(r, v)
	return
}
