//:build baremetal || moxie.wasm || nintendoswitch

package os

const (
	PathSeparator     = '/'
	PathListSeparator = ':'
)

func IsPathSeparator(c uint8) (rok bool) {
	return PathSeparator == c
}

func basename(name string) (rs string) {
	i := len(name) - 1
	for ; i > 0 && name[i] == '/'; i-- {
		name = resize(name, i)
	}
	for i--; i >= 0; i-- {
		if name[i] == '/' {
			name = name[i+1:]
			break
		}
	}
	return name
}

func fixRootDirectory(p string) (rs string) {
	return p
}
