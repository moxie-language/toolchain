package os

import (
	"errors"
	"io/fs"
	"syscall"
	"unsafe"
)


type Signal interface {
	String() string
	Signal() // to distinguish from other Stringers
}

var ErrNotImplementedDir error
var ErrNotImplementedSys error
var ErrNotImplementedFiles error

// Getpid returns the process id of the caller, or -1 if unavailable.
func Getpid() (rn int32) {
	return syscall.Getpid()
}

// Getppid returns the process id of the caller's parent, or -1 if unavailable.
func Getppid() (rn int32) {
	return syscall.Getppid()
}

type ProcAttr struct {
	Dir   string
	Env   []string
	Files []*File
	Sys   *syscall.SysProcAttr
}

// ErrProcessDone indicates a Process has finished.
var ErrProcessDone error

// ProcessState holds what wait4 reported. The methods were TODO stubs that
// answered "" and false for every process, so nothing above them could tell a
// successful child from a failed one - which is why exec.Cmd could not exist.
type ProcessState struct {
	status syscall.WaitStatus
	pid    int32
}

func (p *ProcessState) String() (rs string) {
	if p == nil {
		return "process not started"
	}
	if p.status.Exited() {
		code := p.status.ExitStatus()
		if code == 0 {
			return "exit status 0"
		}
		return "exit status " | code.String()
	}
	if p.status.Signaled() {
		return "signal " | p.status.Signal().String()
	}
	return "process state unknown"
}

func (p *ProcessState) Success() (rok bool) {
	return p.status.Exited() && p.status.ExitStatus() == 0
}

// Sys returns system-dependent exit information about
// the process. Convert it to the appropriate underlying
// type, such as syscall.WaitStatus on Unix, to access its contents.
func (p *ProcessState) Sys() (rpointer unsafe.Pointer) {
	return unsafe.Pointer(&p.status)
}

func (p *ProcessState) Exited() (rok bool) {
	return p.status.Exited()
}

// ExitCode returns the exit code of the exited process, or -1
// if the process hasn't exited or was terminated by a signal.
func (p *ProcessState) ExitCode() (rn int32) {
	if !p.status.Exited() {
		return -1
	}
	return p.status.ExitStatus()
}

// Pid is the process the state belongs to, -1 after Wait has reaped it.
func (p *ProcessState) Pid() (rn int32) { return p.pid }

type Process struct {
	Pid int32
}

// StartProcess starts a new process with the program, arguments and attributes specified by name, argv and attr.
// Arguments to the process (os.Args) are passed via argv.
func StartProcess(name string, argv []string, attr *ProcAttr) (rprocess *Process, rerr error) {
	return startProcess(name, argv, attr)
}

// Wait reaps the child and reports how it ended. wait4 is the only way to learn
// a child's exit status, and without it every caller saw ErrNotImplemented.
func (p *Process) Wait() (rprocessState *ProcessState, rerr error) {
	if p.Pid == -1 {
		return nil, syscall.EINVAL
	}
	pid := p.Pid
	var st syscall.WaitStatus
	for {
		_, werr := syscall.Wait4(pid, &st, 0, nil)
		if werr == syscall.EINTR {
			// A signal arrived while waiting; the child is still there.
			continue
		}
		if werr != nil {
			return nil, werr
		}
		break
	}
	p.Pid = -1
	return &ProcessState{status: st, pid: pid}, nil
}

func (p *Process) Kill() (rerr error) {
	return syscall.Kill(p.Pid, syscall.SIGKILL)
}

func (p *Process) Signal(sig Signal) (rerr error) {
	s, ok := sig.(syscall.Signal)
	if !ok {
		return syscall.EINVAL
	}
	return syscall.Kill(p.Pid, s)
}

func Ignore(sig ...Signal) {
	// leave all the signals unaltered
	return
}

// Release releases any resources associated with the Process p,
// rendering it unusable in the future.
// Release only needs to be called if Wait is not.
func (p *Process) Release() (rerr error) {
	return p.release()
}

// FindProcess looks for a running process by its pid.
// Keep compatibility with golang and always succeed and return new proc with pid on Linux.
func FindProcess(pid int32) (rprocess *Process, rerr error) {
	return findProcess(pid)
}

func init() {
	mountsHolder = &mountTable{}
	minrandHolder = &minrandState{}
	ErrInvalid = fs.ErrInvalid
	ErrPermission = fs.ErrPermission
	ErrExist = fs.ErrExist
	ErrNotExist = fs.ErrNotExist
	ErrClosed = fs.ErrClosed
	ErrUnsupported = errors.New("operation not supported")
	ErrNotImplemented = errors.New("operation not implemented")
	ErrNoDeadline = errors.New("file type does not support deadline")
	ErrNotImplementedDir = errors.New("directory setting not implemented")
	ErrNotImplementedSys = errors.New("sys setting not implemented")
	ErrNotImplementedFiles = errors.New("files setting not implemented")
	ErrProcessDone = errors.New("os: process already finished")
	errNegativeOffset = errors.New("negative offset")
	errWriteAtInAppendMode = errors.New("os: invalid use of WriteAt on file opened with O_APPEND")
	errPatternHasSeparator = errors.New("pattern contains path separator")
}
