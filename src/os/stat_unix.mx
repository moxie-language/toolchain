package os

import (
	"syscall"
)

// Stat returns the FileInfo structure describing file.
// If there is an error, it will be of type *PathError.
func (f *File) Stat() (FileInfo, error) {
	var st fileStat
	err := ignoringEINTR(func() error {
		return syscall.Fstat(int32(f.handle.(unixFileHandle)), &st.sys)
	})
	if err != nil {
		return nil, &PathError{Op: "fstat", Path: f.name, Err: err}
	}
	fillFileStatFromSys(&st, f.name)
	return &st, nil
}

// statNolog stats a file with no test logging.
func statNolog(name string) (FileInfo, error) {
	var st fileStat
	err := ignoringEINTR(func() error {
		return handleSyscallError(syscall.Stat(name, &st.sys))
	})
	if err != nil {
		return nil, &PathError{Op: "stat", Path: name, Err: err}
	}
	fillFileStatFromSys(&st, name)
	return &st, nil
}

// lstatNolog lstats a file with no test logging.
func lstatNolog(name string) (FileInfo, error) {
	var st fileStat
	err := ignoringEINTR(func() error {
		return handleSyscallError(syscall.Lstat(name, &st.sys))
	})
	if err != nil {
		return nil, &PathError{Op: "lstat", Path: name, Err: err}
	}
	fillFileStatFromSys(&st, name)
	return &st, nil
}
