// Package os implements a subset of the Go "os" package. See
// https://godoc.org/os for details.
//
// Note that the current implementation is blocking. This limitation should be
// removed in a future version.
package os

import (
	"syscall"
)

var Args []string

func runtime_args() (rss []string) // in package runtime

func main() {
	Args = runtime_args()
	initStdio()
	// Mount the root filesystem at startup so the mount table lives in
	// the root arena. initFS inside findMount would allocate the table
	// in whatever arena is current at the first file open - a transient
	// compile arena whose memory later gets reused, zeroing the
	// filesystem interface and breaking all subsequent opens.
	initFS()
}

// Exit causes the current program to exit with the given status code.
// Conventionally, code zero indicates success, non-zero an error.
// The program terminates immediately; deferred functions are not run.
func Exit(code int32) {
	syscall.Exit(code)
}

// Getuid returns the numeric user id of the caller.
//
// On non-POSIX systems, it returns -1.
func Getuid() (rn int32) {
	return syscall.Getuid()
}

// Geteuid returns the numeric effective user id of the caller.
//
// On non-POSIX systems, it returns -1.
func Geteuid() (rn int32) {
	return syscall.Geteuid()
}

// Getgid returns the numeric group id of the caller.
//
// On non-POSIX systems, it returns -1.
func Getgid() (rn int32) {
	return syscall.Getgid()
}

// Getegid returns the numeric effective group id of the caller.
//
// On non-POSIX systems, it returns -1.
func Getegid() (rn int32) {
	return syscall.Getegid()
}
