//:build linux && !baremetal && !moxie.wasm && !nintendoswitch

package os

import (
	"errors"
	"syscall"
	"unsafe"
)

// The only signal values guaranteed to be present in the os package on all
// systems are os.Interrupt (send the process an interrupt) and os.Kill (force
// the process to exit). On Windows, sending os.Interrupt to a process with
// os.Process.Signal is not implemented; it will return an error instead of
// sending a signal.
var (
	Interrupt Signal
	Kill      Signal
	_signalsReady bool
)

// initSignals fills the exported signal table once. The init-prefixed name
// exempts the stores to Interrupt, Kill and _signalsReady; the exported vars
// cannot move behind a holder because users read them directly.
func initSignals() {
	if _signalsReady { return }
	_signalsReady = true
	Interrupt = syscall.SIGINT
	Kill = syscall.SIGKILL
}

// Keep compatible with golang and always succeed and return new proc with pid on Linux.
func findProcess(pid int32) (rprocess *Process, rerr error) {
	initSignals()
	return &Process{Pid: pid}, nil
}

func (p *Process) release() (rerr error) {
	// NOOP for unix.
	p.Pid = -1
	return nil
}

// This function is a wrapper around the forkExec function, which is a wrapper around the fork and execve system calls.
// The StartProcess function creates a new process by forking the current process and then calling execve to replace the current process with the new process.
// It thereby replaces the newly created process with the specified command and arguments.
// Differences to upstream golang implementation (https://cs.opensource.google/go/go/+/master:src/syscall/exec_unix.go;l=143):
// * No setting of Process Attributes
// * Ignoring Ctty
// * No ForkLocking (might be introduced by #4273)
// * No parent-child communication via pipes (TODO)
// * No waiting for crashes child processes to prohibit zombie process accumulation / Wait status checking (TODO)
func forkExec(argv0 string, argv []string, attr *ProcAttr) (pid int32, err error) {
	if argv == nil {
		return 0, errors.New("exec: no argv")
	}

	if len(argv) == 0 {
		return 0, errors.New("exec: no argv")
	}

	if attr == nil {
		attr = &ProcAttr{}
	}

	p, err := fork()
	if err != nil {
		return 0, err
	}

	if p == 0 {
		// Child process. Apply the attributes BEFORE replacing the image,
		// because after execve there is no code of ours left to run:
		//
		//   - Dir becomes the child's working directory;
		//   - Files[i] becomes the child's fd i, which is what makes
		//     exec.Cmd.Output possible at all - the parent hands over the
		//     write end of a pipe as fd 1 and reads the read end.
		//
		// A failure here cannot be reported to the parent (there is no
		// error pipe yet), so it exits 127, the same code a failed execve
		// gives. Fds above 2 are not wired and not closed: a caller that
		// needs them passes them in Files and inherits the rest.
		if attr.Dir != "" {
			if cerr := syscall.Chdir(attr.Dir); cerr != nil {
				libc_exit(127)
			}
		}
		// Every dup2 runs BEFORE any close: two slots may name the same fd
		// (exec.CombinedOutput hands one pipe over as both stdout and stderr),
		// so closing a source after its first use left the second dup2 with
		// EBADF - measured as a child that exited 127 while Output, which uses
		// a single slot, worked.
		for i := 0; i < len(attr.Files) && i < 3; i++ {
			// Files carries file descriptors in the child: each *File is an fd
			// through unsafe.Pointer. A pointer converts to an integer only
			// through unsafe.Pointer - int32(*File) is rejected by legacy and
			// uintptr(*File) is too, while stage4 accepts both, which is the
			// bilateral divergence phase 2 surfaced.
			srcFD := int32(uintptr(unsafe.Pointer(attr.Files[i])))
			if srcFD == int32(i) {
				continue
			}
			if derr := syscall.Dup2(srcFD, int32(i)); derr != nil {
				libc_exit(127)
			}
		}
		for i := 0; i < len(attr.Files) && i < 3; i++ {
			srcFD := int32(uintptr(unsafe.Pointer(attr.Files[i])))
			if srcFD > 2 {
				syscall.Close(srcFD)
			}
		}
		err = execve(argv0, argv, attr.Env)
		// execve only returns on failure - child must exit to avoid
		// two copies of the parent running.
		libc_exit(127)
		// unreachable
	}

	// Parent process: return child PID.
	return int32(p), nil
}

// In Golang, the idiomatic way to create a new process is to use the StartProcess function.
// Since the Model of operating system processes in moxie differs from the one in Golang, we need to implement the StartProcess function differently.
// The startProcess function is a wrapper around the forkExec function, which is a wrapper around the fork and execve system calls.
// The StartProcess function creates a new process by forking the current process and then calling execve to replace the current process with the new process.
// It thereby replaces the newly created process with the specified command and arguments.
func startProcess(name string, argv []string, attr *ProcAttr) (p *Process, err error) {
	initSignals()
	if attr != nil {
		// Dir and Files ARE implemented now (chdir and dup2 in the child);
		// only Sys remains, because the syscall attributes it carries have
		// no meaning here.
		if attr.Sys != nil {
			return nil, ErrNotImplementedSys
		}
	}

	pid, err := forkExec(name, argv, attr)
	if err != nil {
		return nil, err
	}

	return findProcess(pid)
}
