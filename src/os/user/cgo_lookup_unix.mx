//:build cgo && !osusergo && unix

package user

import (
	"fmt"
	"strconv"
	"bytes"
	"syscall"
	"unsafe"
)

// lookupKind selects the C lookup retryWithBuffer performs.
type lookupKind int32

const (
	lookupGetpwnam lookupKind = iota
	lookupGetpwuid
	lookupGetgrnam
	lookupGetgrgid
)

func current() (ruser *User, rerr error) {
	return lookupUnixUid(syscall.Getuid())
}

func lookupUser(username string) (ruser *User, rerr error) {
	initBuffers()
	nameC := []byte{:len(username)+1}
	copy(nameC, username)

	pwd, _, found, err := retryWithBuffer(userBuffer, lookupGetpwnam, nameC, 0)
	if err == syscall.ENOENT || (err == nil && !found) {
		return nil, UnknownUserError(username)
	}
	if err != nil {
		return nil, fmt.Errorf("user: lookup username %s: %v", username, err)
	}
	return buildUser(&pwd), nil
}

func lookupUserId(uid string) (ruser *User, rerr error) {
	i, e := strconv.Atoi(uid)
	if e != nil {
		return nil, e
	}
	return lookupUnixUid(i)
}

func lookupUnixUid(uid int32) (ruser *User, rerr error) {
	initBuffers()
	pwd, _, found, err := retryWithBuffer(userBuffer, lookupGetpwuid, nil, uid)
	if err == syscall.ENOENT || (err == nil && !found) {
		return nil, UnknownUserIdError(uid)
	}
	if err != nil {
		return nil, fmt.Errorf("user: lookup userid %d: %v", uid, err)
	}
	return buildUser(&pwd), nil
}

func buildUser(pwd *_C_struct_passwd) (ruser *User) {
	u := &User{
		Uid:      strconv.FormatUint(uint64(_C_pw_uid(pwd)), 10),
		Gid:      strconv.FormatUint(uint64(_C_pw_gid(pwd)), 10),
		Username: _C_GoString(_C_pw_name(pwd)),
		Name:     _C_GoString(_C_pw_gecos(pwd)),
		HomeDir:  _C_GoString(_C_pw_dir(pwd)),
	}
	// The pw_gecos field isn't quite standardized. Some docs
	// say: "It is expected to be a comma separated list of
	// personal data where the first item is the full name of the
	// user."
	u.Name, _, _ = bytes.Cut(u.Name, ",")
	return u
}

func lookupGroup(groupname string) (rgroup *Group, rerr error) {
	initBuffers()
	cname := []byte{:len(groupname)+1}
	copy(cname, groupname)

	_, grp, found, err := retryWithBuffer(groupBuffer, lookupGetgrnam, cname, 0)
	if err == syscall.ENOENT || (err == nil && !found) {
		return nil, UnknownGroupError(groupname)
	}
	if err != nil {
		return nil, fmt.Errorf("user: lookup groupname %s: %v", groupname, err)
	}
	return buildGroup(&grp), nil
}

func lookupGroupId(gid string) (rgroup *Group, rerr error) {
	i, e := strconv.Atoi(gid)
	if e != nil {
		return nil, e
	}
	return lookupUnixGid(i)
}

func lookupUnixGid(gid int32) (rgroup *Group, rerr error) {
	initBuffers()
	_, grp, found, err := retryWithBuffer(groupBuffer, lookupGetgrgid, nil, gid)
	if err == syscall.ENOENT || (err == nil && !found) {
		return nil, UnknownGroupIdError(strconv.Itoa(gid))
	}
	if err != nil {
		return nil, fmt.Errorf("user: lookup groupid %d: %v", gid, err)
	}
	return buildGroup(&grp), nil
}

func buildGroup(grp *_C_struct_group) (rgroup *Group) {
	g := &Group{
		Gid:  strconv.Itoa(int32(_C_gr_gid(grp))),
		Name: _C_GoString(_C_gr_name(grp)),
	}
	return g
}

type bufferKind _C_int

var (
	userBuffer      bufferKind
	groupBuffer     bufferKind
	_bufferInitDone bool
)

// initBuffers is init-named: the only writer of the buffer-size globals, and
// the immutability rule exempts an initializer.
func initBuffers() {
	if _bufferInitDone {
		return
	}
	_bufferInitDone = true
	userBuffer = bufferKind(_C__SC_GETPW_R_SIZE_MAX)
	groupBuffer = bufferKind(_C__SC_GETGR_R_SIZE_MAX)
}

func (k *bufferKind) initialSize() (rsize _C_size_t) {
	sz := _C_sysconf(_C_int(*k))
	if sz == -1 {
		// DragonFly and FreeBSD do not have _SC_GETPW_R_SIZE_MAX.
		// Additionally, not all Linux systems have it, either. For
		// example, the musl libc returns -1.
		return 1024
	}
	if !isSizeReasonable(int64(sz)) {
		// Truncate.  If this truly isn't enough, retryWithBuffer will error on the first run.
		return maxBufferSize
	}
	return _C_size_t(sz)
}

// retryWithBuffer repeatedly performs the requested C lookup, increasing the
// size of the buffer each time, until it succeeds, fails with a non-ERANGE
// error, or the buffer exceeds a reasonable limit.
//
// The lookup is selected by op and carries its key as parameters rather than
// as a closure: a Moxie function value has no environment, and a parameter
// pointer cannot be written through, so the results are returned.
func retryWithBuffer(kind bufferKind, op lookupKind, name []byte, id int32) (rpwd _C_struct_passwd, rgrp _C_struct_group, rfound bool, rerr error) {
	buf := []byte{:kind.initialSize()}
	for {
		var errno syscall.Errno
		switch op {
		case lookupGetpwnam:
			rpwd, rfound, errno = _C_getpwnam_r((*_C_char)(unsafe.Pointer(&name[0])),
				(*_C_char)(unsafe.Pointer(&buf[0])), _C_size_t(len(buf)))
		case lookupGetpwuid:
			rpwd, rfound, errno = _C_getpwuid_r(_C_uid_t(id),
				(*_C_char)(unsafe.Pointer(&buf[0])), _C_size_t(len(buf)))
		case lookupGetgrnam:
			rgrp, rfound, errno = _C_getgrnam_r((*_C_char)(unsafe.Pointer(&name[0])),
				(*_C_char)(unsafe.Pointer(&buf[0])), _C_size_t(len(buf)))
		case lookupGetgrgid:
			rgrp, rfound, errno = _C_getgrgid_r(_C_gid_t(id),
				(*_C_char)(unsafe.Pointer(&buf[0])), _C_size_t(len(buf)))
		}
		if errno == 0 {
			return
		}
		if errno != syscall.ERANGE {
			return rpwd, rgrp, rfound, errno
		}
		newSize := len(buf) * 2
		if !isSizeReasonable(int64(newSize)) {
			return rpwd, rgrp, rfound, fmt.Errorf("internal buffer exceeds %d bytes", maxBufferSize)
		}
		buf = []byte{:newSize}
	}
}

const maxBufferSize = 1 << 20

func isSizeReasonable(sz int64) (rok bool) {
	return sz > 0 && sz <= maxBufferSize
}

// Because we can't use cgo in tests:
func structPasswdForNegativeTest() (r_C_struct_passwd _C_struct_passwd) {
	sp := _C_struct_passwd{}
	*_C_pw_uidp(&sp) = 1<<32 - 2
	*_C_pw_gidp(&sp) = 1<<32 - 3
	return sp
}
