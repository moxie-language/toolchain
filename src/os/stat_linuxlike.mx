// Note: this file is used for both Linux and WASI.
// Eventually it might be better to spit it up, and make the syscall constants
// match the typical WASI constants instead of the Linux-equivalents used here.

package os

import (
	"syscall"
	"time"
)

func fillFileStatFromSys(st *fileStat, name string) {
	st.name = basename(name)
	st.size = st.sys.Size
	st.modTime = timespecToTime(st.sys.Mtim)
	st.mode = FileMode(st.sys.Mode & 0777)
	switch st.sys.Mode & syscall.S_IFMT {
	case syscall.S_IFBLK:
		st.mode |= ModeDevice
	case syscall.S_IFCHR:
		st.mode |= ModeDevice | ModeCharDevice
	case syscall.S_IFDIR:
		st.mode |= ModeDir
	case syscall.S_IFIFO:
		st.mode |= ModeNamedPipe
	case syscall.S_IFLNK:
		st.mode |= ModeSymlink
	case syscall.S_IFREG:
		// nothing to do
	case syscall.S_IFSOCK:
		st.mode |= ModeSocket
	}
	if st.sys.Mode&syscall.S_ISGID != 0 {
		st.mode |= ModeSetgid
	}
	if st.sys.Mode&syscall.S_ISUID != 0 {
		st.mode |= ModeSetuid
	}
	if st.sys.Mode&syscall.S_ISVTX != 0 {
		st.mode |= ModeSticky
	}
}

func timespecToTime(ts syscall.Timespec) time.Time {
	return time.Unix(int64(ts.Sec), int64(ts.Nsec))
}

// For testing.
func atime(fi FileInfo) time.Time {
	return timespecToTime((*syscall.Stat_t)(fi.Sys()).Atim)
}
