package testing

import (
	"fmt"
	"os"
)

// Moxie has no exceptions: panic is fatal and recover does not exist, so
// testing cannot unwind a test body the way Go's FailNow/SkipNow do.
//   FailNow marks the test failed and exits the run (a failing run is a failing
//   run, and it stops loudly instead of continuing on broken state).
//   SkipNow marks the test skipped and returns, so a test that skips must
//   `return` right after it.
// A panicking test body is fatal for the whole run.
type T struct {
	name    string
	failed  bool
	skipped bool
}

// run executes one test body. A test that panics is FATAL: Moxie has no
// recover, so FailNow and SkipNow cannot unwind the body the way Go's do.
func run(f func(*T), t *T) {
	f(t)
}

// FailNow marks the test failed and ENDS THE RUN. Without recover there is no
// way to unwind just this test body, and a failing run is the correct outcome
// either way, so this is loud rather than silent.
func (t *T) FailNow() {
	t.failed = true
	fmt.Println("--- FAIL:", t.name, "(FailNow)")
	os.Exit(1)
}

func (t *T) Fatal(args ...fmt.Stringer) {
	fmt.Print("    ")
	fmt.Println(args...)
	t.FailNow()
}

func (t *T) Fatalf(format string, args ...fmt.Stringer) {
	fmt.Print("    ")
	fmt.Printf(format, args...)
	fmt.Println()
	t.FailNow()
}

func (t *T) Error(args ...fmt.Stringer) {
	fmt.Print("    ")
	fmt.Println(args...)
	t.failed = true
}

func (t *T) Errorf(format string, args ...fmt.Stringer) {
	fmt.Print("    ")
	fmt.Printf(format, args...)
	fmt.Println()
	t.failed = true
}

func (t *T) Log(args ...fmt.Stringer) {
	fmt.Print("    ")
	fmt.Println(args...)
}

func (t *T) Logf(format string, args ...fmt.Stringer) {
	fmt.Print("    ")
	fmt.Printf(format, args...)
	fmt.Println()
}

func (t *T) Name() string {
	return t.name
}

func (t *T) Failed() bool {
	return t.failed
}

// SkipNow marks the test skipped and RETURNS. Go reaches for a panic here to
// stop the body; Moxie has no recover, so a test that skips must return after
// calling this. The runner reports the skip either way.
func (t *T) SkipNow() {
	t.skipped = true
}

func (t *T) Skip(args ...fmt.Stringer) {
	fmt.Print("    SKIP: ")
	fmt.Println(args...)
	t.SkipNow()
}

func (t *T) Helper() {}

// Short reports whether the test run asked for the short form. Moxie's test
// runner has no -short flag, so it is always false; the function exists so
// tests written against Go's testing package compile unchanged.
func Short() bool { return false }

type InternalTest struct {
	Name string
	F    func(*T)
}

func Main(tests []InternalTest) {
	passed := int32(0)
	failed := int32(0)
	skipped := int32(0)
	for _, test := range tests {
		t := &T{name: test.Name}
		fmt.Println("=== RUN  ", test.Name)
		run(test.F, t)
		if t.skipped {
			fmt.Println("--- SKIP:", test.Name)
			skipped++
		} else if t.failed {
			fmt.Println("--- FAIL:", test.Name)
			failed++
		} else {
			fmt.Println("--- PASS:", test.Name)
			passed++
		}
	}
	fmt.Println()
	if failed > 0 {
		fmt.Println("FAIL:", passed, "passed,", failed, "failed,", skipped, "skipped")
		os.Exit(1)
	}
	fmt.Println("PASS:", passed, "passed,", skipped, "skipped")
}
