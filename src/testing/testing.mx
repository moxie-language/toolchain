package testing

import (
	"fmt"
	"os"
)

type T struct {
	name    string
	failed  bool
	skipped bool
}

func (t *T) Fatal(args ...fmt.Stringer) {
	fmt.Print("    ")
	fmt.Println(args...)
	t.failed = true
}

func (t *T) Fatalf(format string, args ...fmt.Stringer) {
	fmt.Print("    ")
	fmt.Printf(format, args...)
	fmt.Println()
	t.failed = true
}

func (t *T) Error(args ...fmt.Stringer) {
	fmt.Print("    ")
	fmt.Println(args...)
	t.failed = true
}

func (t *T) Errorf(format string, args ...fmt.Stringer) {
	fmt.Print("    ")
	fmt.Printf(format, args...)
	fmt.Println()
	t.failed = true
}

func (t *T) Log(args ...fmt.Stringer) {
	fmt.Print("    ")
	fmt.Println(args...)
}

func (t *T) Logf(format string, args ...fmt.Stringer) {
	fmt.Print("    ")
	fmt.Printf(format, args...)
	fmt.Println()
}

func (t *T) Name() string {
	return t.name
}

func (t *T) Failed() bool {
	return t.failed
}

func (t *T) Skip(args ...fmt.Stringer) {
	fmt.Print("    SKIP: ")
	fmt.Println(args...)
	t.skipped = true
}

func (t *T) Helper() {}

type InternalTest struct {
	Name string
	F    func(*T)
}

func Main(tests []InternalTest) {
	passed := int32(0)
	failed := int32(0)
	skipped := int32(0)
	for _, test := range tests {
		t := &T{name: test.Name}
		fmt.Println("=== RUN  ", test.Name)
		test.F(t)
		if t.skipped {
			fmt.Println("--- SKIP:", test.Name)
			skipped++
		} else if t.failed {
			fmt.Println("--- FAIL:", test.Name)
			failed++
		} else {
			fmt.Println("--- PASS:", test.Name)
			passed++
		}
	}
	fmt.Println()
	if failed > 0 {
		fmt.Println("FAIL:", passed, "passed,", failed, "failed,", skipped, "skipped")
		os.Exit(1)
	}
	fmt.Println("PASS:", passed, "passed,", skipped, "skipped")
}
