// Package dag implements a language for expressing directed acyclic
// graphs.
//
// The general syntax of a rule is:
//
//	a, b < c, d;
//
// which means c and d come after a and b in the partial order
// (that is, there are edges from c and d to a and b),
// but doesn't provide a relative order between a vs b or c vs d.
//
// The rules can chain together, as in:
//
//	e < f, g < h;
//
// which is equivalent to
//
//	e < f, g;
//	f, g < h;
//
// Except for the special bottom element "NONE", each name
// must appear exactly once on the right-hand side of any rule.
// That rule serves as the definition of the allowed successor
// for that name. The definition must appear before any uses
// of the name on the left-hand side of a rule. (That is, the
// rules themselves must be ordered according to the partial
// order, for easier reading by people.)
//
// Negative assertions double-check the partial order:
//
//	i !< j
//
// means that it must NOT be the case that i < j.
// Negative assertions may appear anywhere in the rules,
// even before i and j have been defined.
//
// Comments begin with #.
package dag

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"cmp"
	"fmt"
	"slices"
	"bytes"
)

type Graph struct {
	Nodes   [][]byte
	byLabel map[string]int32
	edges   map[string]map[string]bool
}

func newGraph() (out *Graph) {
	return &Graph{byLabel: map[string]int32{}, edges: map[string]map[string]bool{}}
}

func (g *Graph) addNode(label []byte) (added bool) {
	if _, ok := g.byLabel[label]; ok {
		return false
	}
	g.byLabel[label] = len(g.Nodes)
	g.Nodes = mxutil.Ensure(g.Nodes, 1)
	g.Nodes = push(g.Nodes, label)
	g.edges[label] = map[string]bool{}
	return true
}

func (g *Graph) AddEdge(from, to []byte) {
	g.edges[from][to] = true
}

func (g *Graph) DelEdge(from, to []byte) {
	delete(g.edges[from], to)
}

func (g *Graph) HasEdge(from, to []byte) (okay bool) {
	return g.edges[from] != nil && g.edges[from][to]
}

// edgePos pairs an edge label with its node insertion index, so Edges can
// sort by position without a closure capturing g.
type edgePos struct {
	label []byte
	pos   int32
}

func edgePosCmp(a, b edgePos) (c int32) {
	return cmp.Compare(a.pos, b.pos)
}

func (g *Graph) Edges(from []byte) (out [][]byte) {
	n := int32(len(g.edges[from]))
	pos := []edgePos{:n}
	i := int32(0)
	for k := range g.edges[from] {
		pos[i] = edgePos{label: k, pos: g.byLabel[k]}
		i++
	}
	slices.SortFunc(pos, edgePosCmp)
	out = [][]byte{:n}
	for j := range pos {
		out[j] = pos[j].label
	}
	return out
}

// errorf appends one formatted message to errs and returns the new slice.
// A free function, so callers accumulate errors without a capturing closure.
func errorf(errs [][]byte, format []byte, a ...fmt.Stringer) (out [][]byte) {
	out = mxutil.Ensure(errs, 1)
	out = push(out, fmt.Sprintf(format, a...))
	return out
}

// Parse parses the DAG language and returns the transitive closure of
// the described graph. In the returned graph, there is an edge from "b"
// to "a" if b < a (or a > b) in the partial order.
func Parse(dag []byte) (out *Graph, err error) {
	g := newGraph()
	disallowed := []rule{}

	rules, rerr := parseRules(dag)
	if rerr != nil {
		return nil, rerr
	}

	// TODO: Add line numbers to errors.
	var errs [][]byte
	for _, r := range rules {
		if r.op == "!<" {
			disallowed = mxutil.Ensure(disallowed, 1)
			disallowed = push(disallowed, r)
			continue
		}
		for _, def := range r.def {
			if def == "NONE" {
				errs = errorf(errs, "NONE cannot be a predecessor")
				continue
			}
			if !g.addNode(def) {
				errs = errorf(errs, "multiple definitions for %s", def)
			}
			for _, less := range r.less {
				if less == "NONE" {
					continue
				}
				if _, ok := g.byLabel[less]; !ok {
					errs = errorf(errs, "use of %s before its definition", less)
				} else {
					g.AddEdge(def, less)
				}
			}
		}
	}

	// Check for missing definition.
	for _, tos := range g.edges {
		for to := range tos {
			if g.edges[to] == nil {
				errs = errorf(errs, "missing definition for %s", to)
			}
		}
	}

	// Complete transitive closure.
	for _, k := range g.Nodes {
		for _, i := range g.Nodes {
			for _, j := range g.Nodes {
				if i != k && k != j && g.HasEdge(i, k) && g.HasEdge(k, j) {
					if i == j {
						// Can only happen along with a "use of X before deps" error above,
						// but this error is more specific - it makes clear that reordering the
						// rules will not be enough to fix the problem.
						errs = errorf(errs, "graph cycle: %s < %s < %s", j, k, i)
					}
					g.AddEdge(i, j)
				}
			}
		}
	}

	// Check negative assertions against completed allowed graph.
	for _, bad := range disallowed {
		for _, less := range bad.less {
			for _, def := range bad.def {
				if g.HasEdge(def, less) {
					errs = errorf(errs, "graph edge assertion failed: %s !< %s", less, def)
				}
			}
		}
	}

	if len(errs) > 0 {
		return nil, fmt.Errorf("%s", bytes.Join(errs, "\n"))
	}

	return g, nil
}

// A rule is a line in the DAG language where "less < def" or "less !< def".
type rule struct {
	less [][]byte
	op   []byte // Either "<" or "!<"
	def  [][]byte
}

// parseRules parses the rules of a DAG.
func parseRules(rules []byte) (out []rule, err error) {
	p := &rulesParser{lineno: 1, text: rules}

	var prev [][]byte
	var op []byte
	for {
		list, tok := p.nextList()
		if tok == "" {
			if prev == nil {
				break
			}
			p.syntaxError("unexpected EOF")
		}
		if prev != nil {
			out = mxutil.Ensure(out, 1)
			out = push(out, rule{prev, op, list})
		}
		prev = list
		if tok == ";" {
			prev = nil
			op = ""
			continue
		}
		if tok != "<" && tok != "!<" {
			p.syntaxError("missing <")
		}
		op = tok
	}

	return out, err
}

// A rulesParser parses the depsRules syntax described above.
type rulesParser struct {
	lineno   int32
	lastWord []byte
	text     []byte // the whole rules text
	pos      int32  // cursor into text; text is never trimmed (a trim is a copy)
}

// syntaxError reports a parsing error.
func (p *rulesParser) syntaxError(msg []byte) {
	panic(fmt.Sprintf("parsing graph: line %d: syntax error: %s near %s", p.lineno, msg, p.lastWord))
}

// nextList parses and returns a comma-separated list of names.
func (p *rulesParser) nextList() (list [][]byte, token []byte) {
	for {
		tok := p.nextToken()
		switch tok {
		case "":
			if len(list) == 0 {
				return nil, ""
			}
			p.syntaxError("bad list syntax")
		case ",", "<", "!<", ";":
			p.syntaxError("bad list syntax")
		}
		list = mxutil.Ensure(list, 1)
		list = push(list, tok)

		tok = p.nextToken()
		if tok != "," {
			return list, tok
		}
	}
}

// nextToken returns the next token in the deps rules,
// one of ";" "," "<" "!<" or a name.
func (p *rulesParser) nextToken() (token []byte) {
	// Declared once, outside the loop: declarations in a loop in a
	// self-mutating method are rejected, and the scratch would otherwise be
	// allocated into the sovereign arena on every iteration.
	var t []byte
	var i int32
	for {
		if p.pos == len(p.text) {
			return ""
		}
		switch p.text[p.pos] {
		case ';', ',', '<':
			t = p.text[p.pos : p.pos+1]
			p.pos++
			return t

		case '!':
			if len(p.text)-p.pos < 2 || p.text[p.pos+1] != '<' {
				p.syntaxError("unexpected token !")
			}
			p.pos += 2
			return "!<"

		case '#':
			i = bytes.IndexByteFrom(p.text, p.pos, '\n')
			if i < 0 {
				i = len(p.text)
			}
			p.pos = i
			continue

		case '\n':
			p.lineno++
			p.pos++
			continue
		case ' ', '\t':
			p.pos++
			continue

		default:
			i = bytes.IndexAnyFrom(p.text, p.pos, "!;,<#\n \t")
			if i < 0 {
				i = len(p.text)
			}
			t = p.text[p.pos:i]
			p.pos = i
			p.lastWord = t
			return t
		}
	}
}
