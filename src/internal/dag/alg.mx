package dag

import "moxielang.dev/pkg/mxutil"

// Transpose reverses all edges in g.
func (g *Graph) Transpose() {
	old := g.edges

	g.edges = map[string]map[string]bool{}
	for _, n := range g.Nodes {
		g.edges[n] = map[string]bool{}
	}

	for from, tos := range old {
		for to := range tos {
			g.edges[to][from] = true
		}
	}
}

// topoVisit carries the depth-first scratch for Topo. It is a self-mutating
// type so the walk can recurse without a closure capturing g, marks and topo.
type topoVisit struct {
	g     *Graph
	marks map[string]bool
	topo  [][]byte
}

func (v *topoVisit) visit(n []byte) {
	if v.marks[n] {
		return
	}
	for _, to := range v.g.Edges(n) {
		v.visit(to)
	}
	v.marks[n] = true
	v.topo = mxutil.Ensure(v.topo, 1)
	v.topo = push(v.topo, n)
}

// Topo returns a topological sort of g. This function is deterministic.
func (g *Graph) Topo() (out [][]byte) {
	v := &topoVisit{g: g, marks: map[string]bool{}, topo: [][]byte{:0: len(g.Nodes)}}

	for _, root := range g.Nodes {
		v.visit(root)
	}
	out = v.topo
	for i, j := 0, len(out)-1; i < j; i, j = i+1, j-1 {
		out[i], out[j] = out[j], out[i]
	}
	return out
}

// TransitiveReduction removes edges from g that are transitively
// reachable. g must be transitively closed.
func (g *Graph) TransitiveReduction() {
	// For i -> j -> k, if i -> k exists, delete it.
	for _, i := range g.Nodes {
		for _, j := range g.Nodes {
			if g.HasEdge(i, j) {
				for _, k := range g.Nodes {
					if g.HasEdge(j, k) {
						g.DelEdge(i, k)
					}
				}
			}
		}
	}
}
