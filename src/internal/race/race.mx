//:build race

package race

import (
	"internal/abi"
	"unsafe"
)

const Enabled = true

// Functions below pushed from runtime.

//:linkname Acquire
func Acquire(addr unsafe.Pointer)

//:linkname Release
func Release(addr unsafe.Pointer)

//:linkname ReleaseMerge
func ReleaseMerge(addr unsafe.Pointer)

//:linkname Disable
func Disable()

//:linkname Enable
func Enable()

//:linkname Read
func Read(addr unsafe.Pointer)

//:linkname ReadPC
func ReadPC(addr unsafe.Pointer, callerpc, pc uintptr)

//:linkname ReadObjectPC
func ReadObjectPC(t *abi.Type, addr unsafe.Pointer, callerpc, pc uintptr)

//:linkname Write
func Write(addr unsafe.Pointer)

//:linkname WritePC
func WritePC(addr unsafe.Pointer, callerpc, pc uintptr)

//:linkname WriteObjectPC
func WriteObjectPC(t *abi.Type, addr unsafe.Pointer, callerpc, pc uintptr)

//:linkname ReadRange
func ReadRange(addr unsafe.Pointer, len int32)

//:linkname WriteRange
func WriteRange(addr unsafe.Pointer, len int32)

//:linkname Errors
func Errors() int32
