package task

import "unsafe"

// Task represents the single execution context in a moxie domain.
// Moxie is single-threaded per domain - no goroutines, no scheduler.
type Task struct {
	Next          *Task
	Ptr           unsafe.Pointer
	Data          uint64
	state         state
	FipsIndicator uint8
	DeferFrame    unsafe.Pointer
}

func (t *Task) DataUint32() (r0 uint32) {
	return *(*uint32)(unsafe.Pointer(&t.Data))
}

func (t *Task) SetDataUint32(val uint32) {
	*(*uint32)(unsafe.Pointer(&t.Data)) = val
}

func (t *Task) CompareAndSwapDataUint32(old, new uint32) (r0 bool) {
	p := (*uint32)(unsafe.Pointer(&t.Data))
	if *p == old {
		*p = new
		return true
	}
	return false
}
