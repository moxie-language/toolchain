package task

// state is empty - no stack switching in single-threaded domains.
type state struct{}

// currentTask is the single running task in this domain.
var currentTask Task

func Current() (r0 *Task) {
	return &currentTask
}

func Pause() {
	runtimePanic("deadlock: Pause called in single-threaded domain")
}

func (t *Task) Resume() {
	runtimePanic("deadlock: Resume called in single-threaded domain")
}

func OnSystemStack() (r0 bool) { return true }

// _panicstr is DEFINED in runtime (panicking is what the runtime does); this
// package only needs to reach the same symbol. It is a linkname, not an export:
// //export means "a C function takes this name", and a C function would be
// called without the hidden context argument that every Moxie definition takes.
// On native that distinction is invisible - the extra argument is simply not
// read - and on wasm it is fatal: the call's type did not match the definition's
// and wasm-ld replaced the callee with a trap.
//
//:linkname _panicstr runtime._panicstr
func _panicstr(msg string)

func runtimePanic(str string) {
	_panicstr(str)
}
