//:linkname typedmemclr
func typedmemclr(typ *abi.Type, ptr unsafe.Pointer)

//:linkname newarray
func newarray(typ *abi.Type, n int32) unsafe.Pointer

//:linkname newobject
func newobject(typ *abi.Type) unsafe.Pointer
