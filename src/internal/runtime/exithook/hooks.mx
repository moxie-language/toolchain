// Package exithook provides limited support for on-exit cleanup.
//
// CAREFUL! The expectation is that Add should only be called
// from a safe context (e.g. not an error/panic path or signal
// handler, preemption enabled, allocation allowed, write barriers
// allowed, etc), and that the exit function F will be invoked under
// similar circumstances. That is the say, we are expecting that F
// uses normal / high-level Go code as opposed to one of the more
// restricted dialects used for the trickier parts of the runtime.
package exithook

import "moxielang.dev/pkg/mxutil"

// A Hook is a function to be run at program termination
// (when someone invokes os.Exit, or when main.main returns).
// Hooks are run in reverse order of registration:
// the first hook added is the last one run.
type Hook struct {
	F            func() // func to run
	RunOnFailure bool   // whether to run on non-zero exit code
}

// Hooks holds exit hook state and the runtime functions needed to run them.
// The runtime creates an instance and passes in Gosched, Goid, and Throw.
type Hooks struct {
	locked  int32
	runGoid uint64
	hooks   []Hook
	running bool

	// runtime sets these
	Gosched func()
	Goid    func() uint64
	Throw   func(string)
}

// Add adds a new exit hook.
func (s *Hooks) Add(h Hook) {
	if s.locked != 0 {
		// Single-threaded: if locked, spin via Gosched.
		for s.locked != 0 {
			s.Gosched()
		}
	}
	s.locked = 1
	s.hooks = mxutil.Ensure(s.hooks, 1)
	s.hooks = push(s.hooks, h)
	s.locked = 0
}

// Run runs the exit hooks.
//
// If an exit hook panics, Run will throw with the panic on the stack.
// If an exit hook invokes exit in the same goroutine, the goroutine will throw.
// If an exit hook invokes exit in another goroutine, that exit will block.
// hooksUnlock releases the exit-hook lock. Free functions with the receiver as
// an explicit parameter keep Run's deferred work out of a closure.
func hooksUnlock(s *Hooks) {
	s.locked = 0
}

func hooksClearRunGoid(s *Hooks) {
	s.runGoid = 0
}

func (s *Hooks) Run(code int32) {
	for s.locked != 0 {
		if s.Goid() == s.runGoid {
			s.Throw("exit hook invoked exit")
		}
		s.Gosched()
	}
	s.locked = 1
	// Deferred CALLS, not deferred closures: a closure over s is a capture,
	// and a Moxie function value carries no environment. A direct call's
	// arguments (here the receiver) live in the defer frame instead.
	defer hooksUnlock(s)
	s.runGoid = s.Goid()
	defer hooksClearRunGoid(s)

	// Declared once, outside the loop: a declaration in a loop in a
	// self-mutating method is rejected, and the scratch would otherwise be
	// allocated into the sovereign arena on every iteration.
	var h Hook
	for len(s.hooks) > 0 {
		h = s.hooks[len(s.hooks)-1]
		s.hooks = resize(s.hooks, len(s.hooks)-1)
		if code != 0 && !h.RunOnFailure {
			continue
		}
		h.F()
	}
}

type exitError string

func (e exitError) Error() string  { return string(e) }
func (e exitError) String() string { return e.Error() }
