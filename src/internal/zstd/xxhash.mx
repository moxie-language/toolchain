package zstd

import (
	"encoding/binary"
	"internal/byteorder"
	"math/bits"
)

const (
	xxhPrime64c1 = 0x9e3779b185ebca87
	xxhPrime64c2 = 0xc2b2ae3d27d4eb4f
	xxhPrime64c3 = 0x165667b19e3779f9
	xxhPrime64c4 = 0x85ebca77c2b2ae63
	xxhPrime64c5 = 0x27d4eb2f165667c5
)

// xxhash64 is the state of a xxHash-64 checksum.
type xxhash64 struct {
	len uint64   // total length hashed
	v   []uint64 // accumulators, four of them
	buf []byte   // 32-byte buffer
	cnt int32    // number of bytes in buffer
}

// newXxhash64 returns a checksum state with its storage allocated.
//
// The state is built by a free function, not lazily inside reset: a mutating
// method's allocations land in the receiver's sovereign arena, and the receiver
// here is a field of the Reader, so a lazy first-call allocation is a copy into
// an arena whose lifetime is tied to an address inside another object. This is
// the same shape the hash digests use (md5/sha1's newDigest).
func newXxhash64() (xh xxhash64) {
	xh.v = []uint64{:4}
	xh.buf = []byte{:32}
	return xh
}

// reset discards the current state and prepares to compute a new hash.
// We assume a seed of 0 since that is what zstd uses.
func (xh *xxhash64) reset() {
	xh.len = 0

	// Separate addition for awkward constant overflow.
	xh.v[0] = xxhPrime64c1
	xh.v[0] += xxhPrime64c2

	xh.v[1] = xxhPrime64c2
	xh.v[2] = 0

	// Separate negation for awkward constant overflow.
	xh.v[3] = xxhPrime64c1
	xh.v[3] = -xh.v[3]

	clear(xh.buf)
	xh.cnt = 0
}

// update adds a buffer to the has.
func (xh *xxhash64) update(b []byte) {
	xh.len += uint64(len(b))

	// The walk keeps an offset: b = b[32:] would copy the whole remaining
	// input at every 32-byte lane batch.
	pos := int32(0)
	if xh.cnt+len(b) < len(xh.buf) {
		for i := int32(0); i < int32(len(b)); i++ {
			xh.buf[xh.cnt+i] = b[i]
		}
		xh.cnt += len(b)
		return
	}

	if xh.cnt > 0 {
		n := int32(len(xh.buf)) - xh.cnt
		if n > int32(len(b)) {
			n = int32(len(b))
		}
		for i := int32(0); i < n; i++ {
			xh.buf[xh.cnt+i] = b[i]
		}
		pos = n
		xh.v[0] = xh.round(xh.v[0], byteorder.LEUint64At(xh.buf, 0))
		xh.v[1] = xh.round(xh.v[1], byteorder.LEUint64At(xh.buf, 8))
		xh.v[2] = xh.round(xh.v[2], byteorder.LEUint64At(xh.buf, 16))
		xh.v[3] = xh.round(xh.v[3], byteorder.LEUint64At(xh.buf, 24))
		xh.cnt = 0
	}

	for len(b)-pos >= 32 {
		xh.v[0] = xh.round(xh.v[0], byteorder.LEUint64At(b, pos+0))
		xh.v[1] = xh.round(xh.v[1], byteorder.LEUint64At(b, pos+8))
		xh.v[2] = xh.round(xh.v[2], byteorder.LEUint64At(b, pos+16))
		xh.v[3] = xh.round(xh.v[3], byteorder.LEUint64At(b, pos+24))
		pos += 32
	}

	if len(b)-pos > 0 {
		n := int32(len(b)) - pos
		for i := int32(0); i < n; i++ {
			xh.buf[i] = b[pos+i]
		}
		xh.cnt = n
	}
}

// digest returns the final hash value.
func (xh *xxhash64) digest() (out uint64) {
	var h64 uint64
	if xh.len < 32 {
		h64 = xh.v[2] + xxhPrime64c5
	} else {
		h64 = bits.RotateLeft64(xh.v[0], 1) +
			bits.RotateLeft64(xh.v[1], 7) +
			bits.RotateLeft64(xh.v[2], 12) +
			bits.RotateLeft64(xh.v[3], 18)
		h64 = xh.mergeRound(h64, xh.v[0])
		h64 = xh.mergeRound(h64, xh.v[1])
		h64 = xh.mergeRound(h64, xh.v[2])
		h64 = xh.mergeRound(h64, xh.v[3])
	}

	h64 += xh.len

	nb := xh.len
	nb &= 31
	buf := xh.buf
	for nb >= 8 {
		k1 := xh.round(0, binary.LittleEndian().Uint64(buf))
		buf = buf[8:]
		h64 ^= k1
		h64 = bits.RotateLeft64(h64, 27)*xxhPrime64c1 + xxhPrime64c4
		nb -= 8
	}
	if nb >= 4 {
		h64 ^= uint64(binary.LittleEndian().Uint32(buf)) * xxhPrime64c1
		buf = buf[4:]
		h64 = bits.RotateLeft64(h64, 23)*xxhPrime64c2 + xxhPrime64c3
		nb -= 4
	}
	for nb > 0 {
		h64 ^= uint64(buf[0]) * xxhPrime64c5
		buf = buf[1:]
		h64 = bits.RotateLeft64(h64, 11) * xxhPrime64c1
		nb--
	}

	h64 ^= h64 >> 33
	h64 *= xxhPrime64c2
	h64 ^= h64 >> 29
	h64 *= xxhPrime64c3
	h64 ^= h64 >> 32

	return h64
}

// round updates a value.
func (xh *xxhash64) round(v, n uint64) (out uint64) {
	v += n * xxhPrime64c2
	v = bits.RotateLeft64(v, 31)
	v *= xxhPrime64c1
	return v
}

// mergeRound updates a value in the final round.
func (xh *xxhash64) mergeRound(v, n uint64) (out uint64) {
	n = xh.round(0, n)
	v ^= n
	v = v*xxhPrime64c1 + xxhPrime64c4
	return v
}
