package zstd

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"io"
)

// debug can be set in the source to print debug info using println.
const debug = false

// compressedBlock decompresses a compressed block, storing the decompressed
// data in r.buffer. The blockSize argument is the compressed size.
// RFC 3.1.1.3.
func (r *Reader) compressedBlock(blockSize int32) (rerr error) {
	if len(r.compressedBuf) >= blockSize {
		r.compressedBuf = resize(r.compressedBuf, blockSize)
	} else {
		// We know that blockSize <= 128K,
		// so this won't allocate an enormous amount.
		need := blockSize - len(r.compressedBuf)
		r.compressedBuf = mxutil.Ensure(r.compressedBuf, len([]byte{:need}))
		r.compressedBuf = push(r.compressedBuf, []byte{:need}...)
	}

	if _, ioerr := io.ReadFull(r.r, r.compressedBuf); ioerr != nil {
		return r.wrapNonEOFError(0, ioerr)
	}

	data := r.compressedBuf
	off := 0
	r.buffer = resize(r.buffer, 0)

	// resize, not r.literals[:0]: the empty sub-slice would drop the
	// buffer's capacity and every block would allocate a fresh literal buffer.
	r.literals = resize(r.literals, 0)
	litoff, litbuf, err := r.readLiterals(data, off, r.literals)
	if err != nil {
		return err
	}
	r.literals = litbuf

	off = litoff

	seqCount, off, err := r.initSeqs(data, off)
	if err != nil {
		return err
	}

	if seqCount == 0 {
		// No sequences, just literals.
		if off < len(data) {
			return r.makeError(off, "extraneous data after no sequences")
		}

		r.buffer = mxutil.Ensure(r.buffer, len(litbuf))
		r.buffer = push(r.buffer, litbuf...)

		return nil
	}

	return r.execSeqs(data, off, litbuf, seqCount)
}

// seqCode is the kind of sequence codes we have to handle.
type seqCode int32

const (
	seqLiteral seqCode = iota
	seqOffset
	seqMatch
)

// seqCodeInfoData is the information needed to set up seqTables and
// seqTableBits for a particular kind of sequence code.
type seqCodeInfoData struct {
	predefTable     []fseBaselineEntry // predefined FSE
	predefTableBits int32              // number of bits in predefTable
	maxSym          int32              // max symbol value in FSE
	maxBits         int32              // max bits for FSE
}

func _seqCodeInfo() (out [3]seqCodeInfoData) {
	plt := _predefinedLiteralTable()
	pot := _predefinedOffsetTable()
	pmt := _predefinedMatchTable()
	return [3]seqCodeInfoData{
		seqLiteral: {
			predefTable:     plt[:],
			predefTableBits: 6,
			maxSym:          35,
			maxBits:         9,
		},
		seqOffset: {
			predefTable:     pot[:],
			predefTableBits: 5,
			maxSym:          31,
			maxBits:         8,
		},
		seqMatch: {
			predefTable:     pmt[:],
			predefTableBits: 6,
			maxSym:          52,
			maxBits:         9,
		},
	}
}

// initSeqs reads the Sequences_Section_Header and sets up the FSE
// tables used to read the sequence codes. It returns the number of
// sequences and the new offset. RFC 3.1.1.3.2.1.
func (r *Reader) initSeqs(data []byte, off int32) (count int32, noff int32, rerr error) {
	if off >= len(data) {
		return 0, 0, r.makeEOFError(off)
	}

	seqHdr := data[off]
	off++
	if seqHdr == 0 {
		return 0, off, nil
	}

	var seqCount int32
	if seqHdr < 128 {
		seqCount = int32(seqHdr)
	} else if seqHdr < 255 {
		if off >= len(data) {
			return 0, 0, r.makeEOFError(off)
		}
		seqCount = ((int32(seqHdr) - 128) << 8) + int32(data[off])
		off++
	} else {
		if off+1 >= len(data) {
			return 0, 0, r.makeEOFError(off)
		}
		seqCount = int32(data[off]) + (int32(data[off+1]) << 8) + 0x7f00
		off += 2
	}

	// Read the Symbol_Compression_Modes byte.

	if off >= len(data) {
		return 0, 0, r.makeEOFError(off)
	}
	symMode := data[off]
	if symMode&3 != 0 {
		return 0, 0, r.makeError(off, "invalid symbol compression mode")
	}
	off++

	// Set up the FSE tables used to decode the sequence codes.

	var err error
	off, err = r.setSeqTable(data, off, seqLiteral, (symMode>>6)&3)
	if err != nil {
		return 0, 0, err
	}

	off, err = r.setSeqTable(data, off, seqOffset, (symMode>>4)&3)
	if err != nil {
		return 0, 0, err
	}

	off, err = r.setSeqTable(data, off, seqMatch, (symMode>>2)&3)
	if err != nil {
		return 0, 0, err
	}

	return seqCount, off, nil
}

// setSeqTable uses the Compression_Mode in mode to set up r.seqTables and
// r.seqTableBits for kind. We store these in the Reader because one of
// the modes simply reuses the value from the last block in the frame.
func (r *Reader) setSeqTable(data []byte, off int32, kind seqCode, mode byte) (noff int32, rerr error) {
	sci := _seqCodeInfo()
	info := &sci[kind]
	switch mode {
	case 0:
		// Predefined_Mode
		r.seqTables[kind] = info.predefTable
		r.seqTableBits[kind] = uint8(info.predefTableBits)
		return off, nil

	case 1:
		// RLE_Mode
		if off >= len(data) {
			return 0, r.makeEOFError(off)
		}
		rle := data[off]
		off++

		// Build a simple baseline table that always returns rle.

		entry := []fseEntry{
			{
				sym:  rle,
				bits: 0,
				base: 0,
			},
		}
		if cap(r.seqTableBuffers[kind]) == 0 {
			r.seqTableBuffers[kind] = []fseBaselineEntry{:1<<info.maxBits}
		}
		r.seqTableBuffers[kind] = resize(r.seqTableBuffers[kind], 1)
		if berr := r.toBaseline(kind, off, entry, r.seqTableBuffers[kind]); berr != nil {
			return 0, berr
		}

		r.seqTables[kind] = r.seqTableBuffers[kind]
		r.seqTableBits[kind] = 0
		return off, nil

	case 2:
		// FSE_Compressed_Mode
		if cap(r.fseScratch) < 1<<info.maxBits {
			r.fseScratch = []fseEntry{:1<<info.maxBits}
		}
		r.fseScratch = resize(r.fseScratch, 1<<info.maxBits)

		tableBits, roff, err := r.readFSE(data, off, info.maxSym, info.maxBits, r.fseScratch)
		if err != nil {
			return 0, err
		}
		r.fseScratch = resize(r.fseScratch, 1<<tableBits)

		if cap(r.seqTableBuffers[kind]) == 0 {
			r.seqTableBuffers[kind] = []fseBaselineEntry{:1<<info.maxBits}
		}
		r.seqTableBuffers[kind] = resize(r.seqTableBuffers[kind], 1<<tableBits)

		if ferr := r.toBaseline(kind, roff, r.fseScratch, r.seqTableBuffers[kind]); ferr != nil {
			return 0, ferr
		}

		r.seqTables[kind] = r.seqTableBuffers[kind]
		r.seqTableBits[kind] = uint8(tableBits)
		return roff, nil

	case 3:
		// Repeat_Mode
		if len(r.seqTables[kind]) == 0 {
			return 0, r.makeError(off, "missing repeat sequence FSE table")
		}
		return off, nil
	}
	panic("unreachable")
}

// toBaseline converts kind's FSE table to a baseline table.
func (r *Reader) toBaseline(kind seqCode, off int32, fseTable []fseEntry, baselineTable []fseBaselineEntry) (rerr error) {
	switch kind {
	case seqLiteral:
		return r.makeLiteralBaselineFSE(off, fseTable, baselineTable)
	case seqOffset:
		return r.makeOffsetBaselineFSE(off, fseTable, baselineTable)
	case seqMatch:
		return r.makeMatchBaselineFSE(off, fseTable, baselineTable)
	}
	return r.makeError(off, "unknown sequence code kind")
}

// execSeqs reads and executes the sequences. RFC 3.1.1.3.2.1.2.
func (r *Reader) execSeqs(data []byte, off int32, litbuf []byte, seqCount int32) (rerr error) {
	// Set up the initial states for the sequence code readers.

	rbr, err := r.makeReverseBitReader(data, len(data)-1, off)
	if err != nil {
		return err
	}

	literalState, err := rbr.val(r.seqTableBits[seqLiteral])
	if err != nil {
		return err
	}

	offsetState, err := rbr.val(r.seqTableBits[seqOffset])
	if err != nil {
		return err
	}

	matchState, err := rbr.val(r.seqTableBits[seqMatch])
	if err != nil {
		return err
	}

	// Read and perform all the sequences. RFC 3.1.1.4.

	seq := 0
	// Declared once, outside the loop: declarations in a loop in a
	// self-mutating method are rejected, and the scratch would otherwise be
	// allocated into the sovereign arena on every iteration.
	var ptoffset *fseBaselineEntry
	var ptmatch *fseBaselineEntry
	var ptliteral *fseBaselineEntry
	var add uint32
	var verr error
	var cerr error
	var offset uint32
	var match uint32
	var literal uint32
	for seq < seqCount {
		if len(r.buffer)+len(litbuf) > 128<<10 {
			return rbr.makeError("uncompressed size too big")
		}

		ptoffset = &r.seqTables[seqOffset][offsetState]
		ptmatch = &r.seqTables[seqMatch][matchState]
		ptliteral = &r.seqTables[seqLiteral][literalState]

		add, verr = rbr.val(ptoffset.basebits)
		if verr != nil {
			return verr
		}
		offset = ptoffset.baseline + add

		add, verr = rbr.val(ptmatch.basebits)
		if verr != nil {
			return verr
		}
		match = ptmatch.baseline + add

		add, verr = rbr.val(ptliteral.basebits)
		if verr != nil {
			return verr
		}
		literal = ptliteral.baseline + add

		// Handle repeat offsets. RFC 3.1.1.5.
		// See the comment in makeOffsetBaselineFSE.
		if ptoffset.basebits > 1 {
			r.repeatedOffset3 = r.repeatedOffset2
			r.repeatedOffset2 = r.repeatedOffset1
			r.repeatedOffset1 = offset
		} else {
			if literal == 0 {
				offset++
			}
			switch offset {
			case 1:
				offset = r.repeatedOffset1
			case 2:
				offset = r.repeatedOffset2
				r.repeatedOffset2 = r.repeatedOffset1
				r.repeatedOffset1 = offset
			case 3:
				offset = r.repeatedOffset3
				r.repeatedOffset3 = r.repeatedOffset2
				r.repeatedOffset2 = r.repeatedOffset1
				r.repeatedOffset1 = offset
			case 4:
				offset = r.repeatedOffset1 - 1
				r.repeatedOffset3 = r.repeatedOffset2
				r.repeatedOffset2 = r.repeatedOffset1
				r.repeatedOffset1 = offset
			}
		}

		seq++
		if seq < seqCount {
			// Update the states.
			add, verr = rbr.val(ptliteral.bits)
			if verr != nil {
				return verr
			}
			literalState = uint32(ptliteral.base) + add

			add, verr = rbr.val(ptmatch.bits)
			if verr != nil {
				return verr
			}
			matchState = uint32(ptmatch.base) + add

			add, verr = rbr.val(ptoffset.bits)
			if verr != nil {
				return verr
			}
			offsetState = uint32(ptoffset.base) + add
		}

		// The next sequence is now in literal, offset, match.

		if debug {
			println("literal", literal, "offset", offset, "match", match)
		}

		// Copy literal bytes from litbuf.
		if literal > uint32(len(litbuf)) {
			return rbr.makeError("literal byte overflow")
		}
		if literal > 0 {
			r.buffer = mxutil.Ensure(r.buffer, len(litbuf[:literal]))
			r.buffer = push(r.buffer, litbuf[:literal]...)
			litbuf = litbuf[literal:]
		}

		if match > 0 {
			cerr = r.copyFromWindow(&rbr, offset, match)
			if cerr != nil {
				return cerr
			}
		}
	}

	r.buffer = mxutil.Ensure(r.buffer, len(litbuf))
	r.buffer = push(r.buffer, litbuf...)

	if rbr.cnt != 0 {
		return r.makeError(off, "extraneous data after sequences")
	}

	return nil
}

// Copy match bytes from the decoded output, or the window, at offset.
func (r *Reader) copyFromWindow(rbr *reverseBitReader, offset, match uint32) (rerr error) {
	if offset == 0 {
		return rbr.makeError("invalid zero offset")
	}

	// Offset may point into the buffer or the window and
	// match may extend past the end of the initial buffer.
	// |--r.window--|--r.buffer--|
	//        |<-----offset------|
	//        |------match----------->|
	bufferOffset := uint32(0)
	lenBlock := uint32(len(r.buffer))
	if lenBlock < offset {
		lenWindow := r.window.len()
		pending := offset - lenBlock
		if pending > lenWindow {
			return rbr.makeError("offset past window")
		}
		windowOffset := lenWindow - pending
		if pending > match {
			pending = match
		}
		r.buffer = r.window.appendTo(r.buffer, windowOffset, windowOffset+pending)
		match -= pending
	} else {
		bufferOffset = lenBlock - offset
	}

	// We are being asked to copy data that we are adding to the
	// buffer in the same copy.
	// Declared once, outside the loop: a declaration in a loop in a
	// self-mutating method is rejected, and the scratch would otherwise be
	// allocated into the sovereign arena on every iteration.
	var avail uint32
	for match > 0 {
		avail = uint32(len(r.buffer)) - bufferOffset
		if avail > match {
			avail = match
		}
		r.buffer = mxutil.Ensure(r.buffer, len(r.buffer[bufferOffset:bufferOffset+avail]))
		r.buffer = push(r.buffer, r.buffer[bufferOffset:bufferOffset+avail]...)
		match -= avail
	}
	return nil
}
