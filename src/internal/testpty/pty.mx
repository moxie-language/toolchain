// Package testpty is a simple pseudo-terminal package for Unix systems,
// implemented by calling C functions via cgo.
package testpty

import (
	"errors"
	"fmt"
	"os"
)

type PtyError struct {
	FuncName    []byte
	ErrorString []byte
	Errno       error
}

func ptyError(name []byte, err error) (out *PtyError) {
	return &PtyError{name, err.String(), err}
}

func (e *PtyError) Error() (msg string) {
	return fmt.Sprintf("%s: %s", e.FuncName, e.ErrorString)
}

func (e *PtyError) String() (msg string) { return e.Error() }

func (e *PtyError) Unwrap() (err error) { return e.Errno }

var ErrNotSupported error

// Open returns a control pty and the name of the linked process tty.
//
// If Open is not implemented on this platform, it returns ErrNotSupported.
func Open() (pty *os.File, processTTY []byte, err error) {
	return open()
}

func init() {
	ErrNotSupported = errors.New("testpty.Open not implemented on this platform")
}
