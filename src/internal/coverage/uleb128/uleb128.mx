package uleb128

import "moxielang.dev/pkg/mxutil"

func AppendUleb128(b []byte, v uint32) (out []byte) {
	for {
		c := uint8(v & 0x7f)
		v >>= 7
		if v != 0 {
			c |= 0x80
		}
		b = mxutil.Ensure(b, 1)
		b = push(b, c)
		if c&0x80 == 0 {
			break
		}
	}
	return b
}
