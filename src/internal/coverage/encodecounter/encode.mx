package encodecounter

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"bufio"
	"encoding/binary"
	"fmt"
	"internal/coverage"
	"internal/coverage/slicewriter"
	"internal/coverage/stringtab"
	"internal/coverage/uleb128"
	"io"
	"os"
	"slices"
	"unsafe"
)


// This package contains APIs and helpers for encoding initial portions
// of the counter data files emitted at runtime when coverage instrumentation
// is enabled.  Counter data files may contain multiple segments; the file
// header and first segment are written via the "Write" method below, and
// additional segments can then be added using "AddSegment".

type CoverageDataWriter struct {
	stab    *stringtab.Writer
	w       *bufio.Writer
	csh     coverage.CounterSegmentHeader
	tmp     []byte
	cflavor coverage.CounterFlavor
	segs    uint32
	debug   bool
}

func NewCoverageDataWriter(w io.Writer, flav coverage.CounterFlavor) (r *CoverageDataWriter) {
	r = &CoverageDataWriter{
		stab: &stringtab.Writer{},
		w:    bufio.NewWriter(w),

		tmp:     []byte{:64},
		cflavor: flav,
	}
	r.stab.InitWriter()
	r.stab.Lookup("")
	return r
}

// CounterVisitor describes a helper object used during counter file
// writing; when writing counter data files, clients pass a
// CounterVisitor to the write/emit routines, then the expectation is
// that the VisitFuncs method will then invoke the callback "f" with
// data for each function to emit to the file.
type CounterVisitor interface {
	VisitFuncs(f CounterVisitorFn) error
}

// CounterVisitorFn describes a callback function invoked when writing
// coverage counter data.
type CounterVisitorFn func(pkid uint32, funcid uint32, counters []uint32) error

// Write writes the contents of the count-data file to the writer
// previously supplied to NewCoverageDataWriter. Returns an error
// if something went wrong somewhere with the write.
func (cfw *CoverageDataWriter) Write(metaFileHash [16]byte, args map[string][]byte, visitor CounterVisitor) (derr error) {
	if err := cfw.writeHeader(metaFileHash); err != nil {
		return err
	}
	return cfw.AppendSegment(args, visitor)
}

func padToFourByteBoundary(ws *slicewriter.WriteSeeker) (derr error) {
	sz := len(ws.BytesWritten())
	zeros := []byte{0, 0, 0, 0}
	rem := uint32(sz) % 4
	if rem != 0 {
		pad := zeros[:(4 - rem)]
		if nw, err := ws.Write(pad); err != nil {
			return err
		} else if nw != len(pad) {
			return fmt.Errorf("error: short write")
		}
	}
	return nil
}

func (cfw *CoverageDataWriter) patchSegmentHeader(ws *slicewriter.WriteSeeker) (derr error) {
	var err error
	var off int64
	// record position
	off, err = ws.Seek(0, io.SeekCurrent)
	if err != nil {
		return fmt.Errorf("error seeking in patchSegmentHeader: %v", err)
	}
	// seek back to start so that we can update the segment header
	if _, err = ws.Seek(0, io.SeekStart); err != nil {
		return fmt.Errorf("error seeking in patchSegmentHeader: %v", err)
	}
	if cfw.debug {
		fmt.Fprintf(os.Stderr, "=-= writing counter segment header: %+v", cfw.csh)
	}
	if err = binary.Write(ws, binary.LittleEndian(), unsafe.TypeOf(cfw.csh), unsafe.Pointer(&cfw.csh)); err != nil {
		return err
	}
	// ... and finally return to the original offset.
	if _, err = ws.Seek(off, io.SeekStart); err != nil {
		return fmt.Errorf("error seeking in patchSegmentHeader: %v", err)
	}
	return nil
}

// writeULEB128 writes one uleb128 value into ws. Standalone rather than a
// closure: Moxie closures cannot capture the enclosing scope.
func writeULEB128(cfw *CoverageDataWriter, ws *slicewriter.WriteSeeker, v uint32) (derr error) {
	cfw.tmp = resize(cfw.tmp, 0)
	cfw.tmp = uleb128.AppendUleb128(cfw.tmp, v)
	if _, err := ws.Write(cfw.tmp); err != nil {
		return err
	}
	return nil
}

func (cfw *CoverageDataWriter) writeSegmentPreamble(args map[string][]byte, ws *slicewriter.WriteSeeker) (derr error) {
	if err := binary.Write(ws, binary.LittleEndian(), unsafe.TypeOf(cfw.csh), unsafe.Pointer(&cfw.csh)); err != nil {
		return err
	}
	hdrsz := uint32(len(ws.BytesWritten()))

	// Write string table and args to a byte slice (since we need
	// to capture offsets at various points), then emit the slice
	// once we are done.
	cfw.stab.Freeze()
	if err := cfw.stab.Write(ws); err != nil {
		return err
	}
	cfw.csh.StrTabLen = uint32(len(ws.BytesWritten())) - hdrsz

	akeys := []string{}
	for k := range args {
		akeys = mxutil.Ensure(akeys, 1)
		akeys = push(akeys, k)
	}
	slices.Sort(akeys)

	// Count of arg pairs.
	if err := writeULEB128(cfw, ws, uint32(len(args))); err != nil {
		return err
	}
	// Arg pairs themselves.
	// Declared once, outside the loop: declarations in a loop in a
	// self-mutating method are rejected, and the scratch would otherwise be
	// allocated into the sovereign arena on every iteration.
	var ki uint32
	var argval []byte
	var vi uint32
	for _, k := range akeys {
		ki = uint32(cfw.stab.Lookup(k))
		if err := writeULEB128(cfw, ws, ki); err != nil {
			return err
		}
		argval = args[k]
		vi = uint32(cfw.stab.Lookup(argval))
		if err := writeULEB128(cfw, ws, vi); err != nil {
			return err
		}
	}
	if err := padToFourByteBoundary(ws); err != nil {
		return err
	}
	cfw.csh.ArgsLen = uint32(len(ws.BytesWritten())) - (cfw.csh.StrTabLen + hdrsz)

	return nil
}

// AppendSegment appends a new segment to a counter data, with a new
// args section followed by a payload of counter data clauses.
func (cfw *CoverageDataWriter) AppendSegment(args map[string][]byte, visitor CounterVisitor) (derr error) {
	cfw.stab = &stringtab.Writer{}
	cfw.stab.InitWriter()
	cfw.stab.Lookup("")

	for k, v := range args {
		cfw.stab.Lookup(k)
		cfw.stab.Lookup(v)
	}

	ws := &slicewriter.WriteSeeker{}
	if derr = cfw.writeSegmentPreamble(args, ws); derr != nil {
		return derr
	}
	if derr = cfw.writeCounters(visitor, ws); derr != nil {
		return derr
	}
	if derr = cfw.patchSegmentHeader(ws); derr != nil {
		return derr
	}
	if err := cfw.writeBytes(ws.BytesWritten()); err != nil {
		return err
	}
	if derr = cfw.writeFooter(); derr != nil {
		return derr
	}
	if err := cfw.w.Flush(); err != nil {
		return fmt.Errorf("write error: %v", err)
	}
	cfw.stab = nil
	return nil
}

func (cfw *CoverageDataWriter) writeHeader(metaFileHash [16]byte) (derr error) {
	// Emit file header.
	ch := coverage.CounterFileHeader{
		Version:   coverage.CounterFileVersion,
		MetaHash:  metaFileHash,
		CFlavor:   cfw.cflavor,
		BigEndian: false,
	}
	// Magic is a fixed extent because it is 4 bytes of the file header, and
	// the header is written with binary.Write over the struct's memory. The
	// constant is text ([]byte), so it is copied in rather than assigned.
	copy(ch.Magic[:], coverage.CovCounterMagic())
	if err := binary.Write(cfw.w, binary.LittleEndian(), unsafe.TypeOf(ch), unsafe.Pointer(&ch)); err != nil {
		return err
	}
	return nil
}

func (cfw *CoverageDataWriter) writeBytes(b []byte) (derr error) {
	if len(b) == 0 {
		return nil
	}
	nw, err := cfw.w.Write(b)
	if err != nil {
		return fmt.Errorf("error writing counter data: %v", err)
	}
	if len(b) != nw {
		return fmt.Errorf("error writing counter data: short write")
	}
	return nil
}

// emitCounterValue encodes one counter value into ws. Standalone rather than
// a closure: Moxie closures cannot capture the enclosing scope.
func emitCounterValue(cfw *CoverageDataWriter, ws *slicewriter.WriteSeeker, val uint32) (derr error) {
	ctrb := []byte{:4}
	var buf []byte
	var towr int32
	if cfw.cflavor == coverage.CtrRaw {
		binary.LittleEndian().PutUint32(ctrb, val)
		buf = ctrb
		towr = 4
	} else if cfw.cflavor == coverage.CtrULeb128 {
		cfw.tmp = resize(cfw.tmp, 0)
		cfw.tmp = uleb128.AppendUleb128(cfw.tmp, uint32(val))
		buf = cfw.tmp
		towr = len(buf)
	} else {
		panic("internal error: bad counter flavor")
	}
	if sz, err := ws.Write(buf); err != nil {
		return err
	} else if sz != towr {
		return fmt.Errorf("writing counters: short write")
	}
	return nil
}

// emitCounterEntry emits one function's counter clause: the counter count, the
// package and function ids, then each counter value.
func emitCounterEntry(cfw *CoverageDataWriter, ws *slicewriter.WriteSeeker, pkid uint32, funcid uint32, counters []uint32) (derr error) {
	cfw.csh.FcnEntries++
	if err := emitCounterValue(cfw, ws, uint32(len(counters))); err != nil {
		return err
	}
	if err := emitCounterValue(cfw, ws, pkid); err != nil {
		return err
	}
	if err := emitCounterValue(cfw, ws, funcid); err != nil {
		return err
	}
	for _, val := range counters {
		if err := emitCounterValue(cfw, ws, val); err != nil {
			return err
		}
	}
	return nil
}

// counterBuf collects the entries a CounterVisitor emits. CounterVisitorFn is
// a bare function type, so the callback the visitor invokes carries no room
// for the writer state, and Moxie has no closure environment to capture it.
// The visitor can therefore hand its entries nowhere but here; the encoder is
// single-threaded and writeCounters is not reentrant, so one holder serves.
type counterBuf struct {
	pkids    []uint32
	funcids  []uint32
	counters [][]uint32
}

var cbHolder counterBuf

func (cb *counterBuf) reset() {
	cb.pkids = resize(cb.pkids, 0)
	cb.funcids = resize(cb.funcids, 0)
	cb.counters = resize(cb.counters, 0)
}

func (cb *counterBuf) add(pkid uint32, funcid uint32, counters []uint32) (derr error) {
	cb.pkids = mxutil.Ensure(cb.pkids, 1)
	cb.pkids = push(cb.pkids, pkid)
	cb.funcids = mxutil.Ensure(cb.funcids, 1)
	cb.funcids = push(cb.funcids, funcid)
	cb.counters = mxutil.Ensure(cb.counters, 1)
	cb.counters = push(cb.counters, cloneCounters(counters))
	return nil
}

// cloneCounters copies a visitor's counter slice into fresh storage. The
// visitor's slice is backed by its frame arena, which is released when it
// returns; the encoder reads it afterwards.
func cloneCounters(in []uint32) (out []uint32) {
	out = []uint32{:len(in)}
	for i := 0; i < len(in); i++ {
		out[i] = in[i]
	}
	return out
}

// cbAdd records one visitor callback. A free function reading only package
// state: no capture, so it is a legal CounterVisitorFn.
func cbAdd(pkid uint32, funcid uint32, counters []uint32) (derr error) {
	return cbHolder.add(pkid, funcid, counters)
}

func (cfw *CoverageDataWriter) writeCounters(visitor CounterVisitor, ws *slicewriter.WriteSeeker) (derr error) {
	// Notes:
	// - this version writes everything little-endian, which means
	//   a call is needed to encode every value (expensive)
	// - we may want to move to a model in which we just blast out
	//   all counters, or possibly mmap the file and do the write
	//   implicitly.

	// Collect entries for each live function, then write them out.
	cbHolder.reset()
	if err := visitor.VisitFuncs(cbAdd); err != nil {
		return err
	}
	for i := 0; i < len(cbHolder.pkids); i++ {
		if err := emitCounterEntry(cfw, ws, cbHolder.pkids[i], cbHolder.funcids[i], cbHolder.counters[i]); err != nil {
			return err
		}
	}
	return nil
}

func (cfw *CoverageDataWriter) writeFooter() (derr error) {
	cfw.segs++
	cf := coverage.CounterFileFooter{
		NumSegments: cfw.segs,
	}
	copy(cf.Magic[:], coverage.CovCounterMagic())
	if err := binary.Write(cfw.w, binary.LittleEndian(), unsafe.TypeOf(cf), unsafe.Pointer(&cf)); err != nil {
		return err
	}
	return nil
}
