// Package lazyregexp is a thin wrapper over regexp, allowing the use of global
// regexp variables without forcing them to be compiled at init.
package lazyregexp

import (
	"os"
	"regexp"
	"bytes"
)

// Regexp is a wrapper around regexp.Regexp, where the underlying regexp will be
// compiled the first time it is needed.
type Regexp struct {
	str  []byte
	done bool
	rx   *regexp.Regexp
}

func (r *Regexp) re() *regexp.Regexp {
	if !r.done { r.done = true; r.build() }
	return r.rx
}

func (r *Regexp) build() {
	r.rx = regexp.MustCompile(r.str)
	r.str = ""
}

func (r *Regexp) FindSubmatch(s []byte) [][]byte {
	return r.re().FindSubmatch(s)
}

func (r *Regexp) FindStringSubmatch(s []byte) [][]byte {
	return r.re().FindStringSubmatch(s)
}

func (r *Regexp) FindStringSubmatchIndex(s []byte) []int32 {
	return r.re().FindStringSubmatchIndex(s)
}

func (r *Regexp) ReplaceAllString(src, repl []byte) []byte {
	return r.re().ReplaceAllString(src, repl)
}

func (r *Regexp) FindString(s []byte) []byte {
	return r.re().FindString(s)
}

func (r *Regexp) FindAllString(s []byte, n int32) [][]byte {
	return r.re().FindAllString(s, n)
}

func (r *Regexp) MatchString(s []byte) bool {
	return r.re().MatchString(s)
}

func (r *Regexp) SubexpNames() [][]byte {
	return r.re().SubexpNames()
}

func inTest() bool {
	return len(os.Args()) > 0 && bytes.HasSuffix(bytes.TrimSuffix(os.Args()[0], ".exe"), ".test")
}

// New creates a new lazy regexp, delaying the compiling work until it is first
// needed. If the code is being run as part of tests, the regexp compiling will
// happen immediately.
func New(str []byte) *Regexp {
	lr := &Regexp{str: str}
	if inTest() {
		// In tests, always compile the regexps early.
		lr.re()
	}
	return lr
}
