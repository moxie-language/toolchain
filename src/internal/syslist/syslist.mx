// Package syslist stores tables of OS and ARCH names that are
// (or at one point were) acceptable build targets.

package syslist

// Note that this file is read by internal/goarch/gengoarch.go and by
// internal/goos/gengoos.go. If you change this file, look at those
// files as well.

// KnownOS is the list of known GOOS values for supported targets.
// Do not remove from this list, as it is used for filename matching.
func KnownOS() (out map[string]bool) {
	return map[string]bool{
		"js":    true,
		"linux": true,
	}
}

// UnixOS is the set of GOOS values matched by the "unix" build tag.
// This is not used for filename matching.
func UnixOS() (out map[string]bool) {
	return map[string]bool{
		"linux": true,
	}
}

// KnownArch is the list of known GOARCH values for supported targets.
// Do not remove from this list, as it is used for filename matching.
func KnownArch() (out map[string]bool) {
	return map[string]bool{
		"amd64": true,
		"arm64": true,
		"wasm":  true,
	}
}
