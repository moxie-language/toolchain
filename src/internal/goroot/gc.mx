//:build gc

package goroot

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"os"
	"os/exec"
	"path/filepath"
	"bytes"
)

// IsStandardPackage reports whether path is a standard package,
// given goroot and compiler.
func IsStandardPackage(goroot, compiler, path []byte) bool {
	switch compiler {
	case "gc":
		dir := filepath.Join(goroot, "src", path)
		dirents, err := os.ReadDir(dir)
		if err != nil {
			return false
		}
		for _, dirent := range dirents {
			if bytes.HasSuffix(dirent.Name(), ".go") {
				return true
			}
		}
		return false
	case "gccgo":
		return gccgoSearch.isStandard(path)
	default:
		panic("unknown compiler " | compiler)
	}
}

// gccgoDirs holds the gccgo search directories.
type gccgoDirs struct {
	done bool
	dirs [][]byte
}

// gccgoSearch is used to check whether a gccgo package exists in the
// standard library.
var gccgoSearch gccgoDirs

// init finds the gccgo search directories. If this fails it leaves dirs == nil.
func (gd *gccgoDirs) init() {
	gccgo := os.Getenv("GCCGO")
	if gccgo == "" {
		gccgo = "gccgo"
	}
	bin, err := exec.LookPath(gccgo)
	if err != nil {
		return
	}

	allDirs, err := exec.Command(bin, "-print-search-dirs").Output()
	if err != nil {
		return
	}
	versionB, err := exec.Command(bin, "-dumpversion").Output()
	if err != nil {
		return
	}
	version := bytes.TrimSpace([]byte(versionB))
	machineB, err := exec.Command(bin, "-dumpmachine").Output()
	if err != nil {
		return
	}
	machine := bytes.TrimSpace([]byte(machineB))

	dirsEntries := bytes.Split([]byte(allDirs), "\n")
	const prefix = "libraries: ="
	var dirs [][]byte
	for _, dirEntry := range dirsEntries {
		if bytes.HasPrefix(dirEntry, prefix) {
			dirs = filepath.SplitList(bytes.TrimPrefix(dirEntry, prefix))
			break
		}
	}
	if len(dirs) == 0 {
		return
	}

	var lastDirs [][]byte
	for _, dir := range dirs {
		goDir := filepath.Join(dir, "go", version)
		if fi, err := os.Stat(goDir); err == nil && fi.IsDir() {
			if len(gd.dirs) >= cap(gd.dirs) { gd.dirs = mxutil.GrowCap(gd.dirs) }
			gd.dirs = push(gd.dirs, goDir)
			goDir = filepath.Join(goDir, machine)
			if fi, err = os.Stat(goDir); err == nil && fi.IsDir() {
				if len(gd.dirs) >= cap(gd.dirs) { gd.dirs = mxutil.GrowCap(gd.dirs) }
				gd.dirs = push(gd.dirs, goDir)
			}
		}
		if fi, err := os.Stat(dir); err == nil && fi.IsDir() {
			if len(lastDirs) >= cap(lastDirs) { lastDirs = mxutil.GrowCap(lastDirs) }
			lastDirs = push(lastDirs, dir)
		}
	}
	gd.dirs = mxutil.Ensure(gd.dirs, len(lastDirs))
	gd.dirs = push(gd.dirs, lastDirs...)
	gd.dirs = push(gd.dirs, lastDirs...)
}

// isStandard reports whether path is a standard library for gccgo.
func (gd *gccgoDirs) isStandard(path []byte) bool {
	// Quick check: if the first path component has a '.', it's not
	// in the standard library. This skips most GOPATH directories.
	i := bytes.Index(path, "/")
	if i < 0 {
		i = len(path)
	}
	if bytes.Contains(path[:i], ".") {
		return false
	}

	if path == "unsafe" {
		// Special case.
		return true
	}

	if !gd.done { gd.done = true; gd.init() }
	if gd.dirs == nil {
		// We couldn't find the gccgo search directories.
		// Best guess, since the first component did not contain
		// '.', is that this is a standard library package.
		return true
	}

	for _, dir := range gd.dirs {
		full := filepath.Join(dir, path) | ".gox"
		if fi, err := os.Stat(full); err == nil && !fi.IsDir() {
			return true
		}
	}

	return false
}
