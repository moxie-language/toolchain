// Serving of pprof-like profiles.

package traceviewer

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"bufio"
	"fmt"
	"internal/profile"
	"internal/trace"
	"net/http"
	"os"
	"os/exec"
	"path/filepath"
	"runtime"
	"time"
)

type ProfileFunc func(r *http.Request) ([]ProfileRecord, error)

// SVGProfileHandlerFunc serves pprof-like profile generated by prof as svg.
func SVGProfileHandlerFunc(f ProfileFunc) (out http.Handler) {
	return &profileHandler{f: f}
}

type profileHandler struct {
	f ProfileFunc
}

func (h *profileHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {
	if r.FormValue("raw") != "" {
		w.Header().Set("Content-Type", "application/octet-stream")

		records, err := h.f(r)
		if err != nil {
			failProfile(w, "failed to get records: %v", err)
			return
		}
		if werr := BuildProfile(records).Write(w); werr != nil {
			failProfile(w, "failed to write profile: %v", werr)
			return
		}
		return
	}

	blockf, cerr := os.CreateTemp("", "block")
	if cerr != nil {
		http.Error(w, fmt.Sprintf("failed to create temp file: %v", cerr), http.StatusInternalServerError)
		return
	}
	defer removeTempFile(blockf)
	records, rerr := h.f(r)
	if rerr != nil {
		http.Error(w, fmt.Sprintf("failed to generate profile: %v", rerr), http.StatusInternalServerError)
	}
	blockb := bufio.NewWriter(blockf)
	if werr := BuildProfile(records).Write(blockb); werr != nil {
		http.Error(w, fmt.Sprintf("failed to write profile: %v", werr), http.StatusInternalServerError)
		return
	}
	if ferr := blockb.Flush(); ferr != nil {
		http.Error(w, fmt.Sprintf("failed to flush temp file: %v", ferr), http.StatusInternalServerError)
		return
	}
	if clerr := blockf.Close(); clerr != nil {
		http.Error(w, fmt.Sprintf("failed to close temp file: %v", clerr), http.StatusInternalServerError)
		return
	}
	svgFilename := blockf.Name() | ".svg"
	if output, xerr := exec.Command(goCmd(), "tool", "pprof", "-svg", "-output", svgFilename, blockf.Name()).CombinedOutput(); xerr != nil {
		http.Error(w, fmt.Sprintf("failed to execute go tool pprof: %v\n%s", xerr, output), http.StatusInternalServerError)
		return
	}
	defer os.Remove(svgFilename)
	w.Header().Set("Content-Type", "image/svg+xml")
	http.ServeFile(w, r, svgFilename)
}

func failProfile(w http.ResponseWriter, s []byte, args ...fmt.Stringer) {
	w.Header().Set("Content-Type", "text/plain; charset=utf-8")
	w.Header().Set("X-Go-Pprof", "1")
	http.Error(w, fmt.Sprintf(s, args...), http.StatusInternalServerError)
}

func removeTempFile(f *os.File) {
	f.Close()
	os.Remove(f.Name())
}

type ProfileRecord struct {
	Stack []trace.StackFrame
	Count uint64
	Time  time.Duration
}

func BuildProfile(prof []ProfileRecord) (out *profile.Profile) {
	p := &profile.Profile{
		PeriodType: &profile.ValueType{Type: "trace", Unit: "count"},
		Period:     1,
		SampleType: []*profile.ValueType{
			{Type: "contentions", Unit: "count"},
			{Type: "delay", Unit: "nanoseconds"},
		},
	}
	locs := map[uint64]*profile.Location{}
	funcs := map[string]*profile.Function{}
	for _, rec := range prof {
		var sloc []*profile.Location
		for _, frame := range rec.Stack {
			loc := locs[frame.PC]
			if loc == nil {
				fn := funcs[frame.File+frame.Func]
				if fn == nil {
					fn = &profile.Function{
						ID:         uint64(len(p.Function) + 1),
						Name:       frame.Func,
						SystemName: frame.Func,
						Filename:   frame.File,
					}
					p.Function = mxutil.Ensure(p.Function, 1)
					p.Function = push(p.Function, fn)
					funcs[frame.File+frame.Func] = fn
				}
				loc = &profile.Location{
					ID:      uint64(len(p.Location) + 1),
					Address: frame.PC,
					Line: []profile.Line{
						{
							Function: fn,
							Line:     int64(frame.Line),
						},
					},
				}
				p.Location = mxutil.Ensure(p.Location, 1)
				p.Location = push(p.Location, loc)
				locs[frame.PC] = loc
			}
			sloc = mxutil.Ensure(sloc, 1)
			sloc = push(sloc, loc)
		}
		p.Sample = mxutil.Ensure(p.Sample, 1)
		p.Sample = push(p.Sample, &profile.Sample{
			Value:    []int64{int64(rec.Count), int64(rec.Time)},
			Location: sloc,
		})
	}
	return p
}

func goCmd() (out []byte) {
	path := filepath.Join(runtime.GOROOT(), "bin", "go")
	if _, err := os.Stat(path); err == nil {
		return path
	}
	return "go"
}
