// Simple conversions to avoid depending on strconv.

package itoa

// Itoa converts val to a decimal string.
func Itoa(val int32) string {
	if val < 0 {
		return "-" + Uitoa(uint32(-val))
	}
	return Uitoa(uint32(val))
}

// Uitoa converts val to a decimal string.
func Uitoa(val uint32) string {
	if val == 0 {
		return "0"
	}
	var buf [20]byte
	i := len(buf) - 1
	for val >= 10 {
		q := val / 10
		buf[i] = byte('0' + val - q*10)
		i--
		val = q
	}
	buf[i] = byte('0' + val)
	out := []byte{:0:20 - i}
	out = append(out, buf[i:]...)
	return out
}

const hex = "0123456789abcdef"

// Uitox converts val (a uint32) to a hexadecimal string.
func Uitox(val uint32) string {
	if val == 0 {
		return "0x0"
	}
	var buf [20]byte
	i := len(buf) - 1
	for val >= 16 {
		q := val / 16
		buf[i] = hex[val%16]
		i--
		val = q
	}
	buf[i] = hex[val%16]
	i--
	buf[i] = 'x'
	i--
	buf[i] = '0'
	return append([]byte{}, buf[i:]...)
}
