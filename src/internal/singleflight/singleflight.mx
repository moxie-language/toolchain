// Package singleflight provides a duplicate function call suppression
// mechanism.
package singleflight

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"unsafe"
)

// call is an in-flight or completed singleflight.Do call
type call struct {
	val unsafe.Pointer
	err error

	dups  int32
	chans []chan<- Result
}

// Group represents a class of work and forms a namespace in
// which units of work can be executed with duplicate suppression.
type Group struct {
	m  map[string]*call // lazily initialized
}

// Result holds the results of Do, so they can be passed
// on a channel.
type Result struct {
	Val    unsafe.Pointer
	Err    error
	Shared bool
}

// Do executes and returns the results of the given function, making
// sure that only one execution is in-flight for a given key at a
// time. If a duplicate comes in, the duplicate caller waits for the
// original to complete and receives the same results.
// The return value shared indicates whether v was given to multiple callers.
func (g *Group) Do(key []byte, fn func() (unsafe.Pointer, error)) (v unsafe.Pointer, err error, shared bool) {

	if g.m == nil {
		g.m = map[string]*call{}
	}
	if c, ok := g.m[key]; ok {
		c.dups++
		return c.val, c.err, true
	}
	c := &call{}
	g.m[key] = c

	g.doCall(c, key, fn)
	return c.val, c.err, c.dups > 0
}

// DoChan is like Do but returns a channel that will receive the
// results when they are ready.
func (g *Group) DoChan(key []byte, fn func() (unsafe.Pointer, error)) <-chan Result {
	ch := chan Result{1}

	if g.m == nil {
		g.m = map[string]*call{}
	}
	if c, ok := g.m[key]; ok {
		c.dups++
		if len(c.chans) >= cap(c.chans) { c.chans = mxutil.GrowCap(c.chans) }
		c.chans = push(c.chans, ch)

		return ch
	}
	c := &call{chans: []chan<- Result{ch}}
	g.m[key] = c

	g.doCall(c, key, fn)

	return ch
}

// doCall handles the single call for a key.
func (g *Group) doCall(c *call, key []byte, fn func() (unsafe.Pointer, error)) {
	c.val, c.err = fn()

	if g.m[key] == c {
		delete(g.m, key)
	}
	for _, ch := range c.chans {
		ch <- Result{c.val, c.err, c.dups > 0}
	}
}

// ForgetUnshared tells the singleflight to forget about a key if it is not
// shared with any other goroutines. Future calls to Do for a forgotten key
// will call the function rather than waiting for an earlier call to complete.
// Returns whether the key was forgotten or unknown--that is, whether no
// other goroutines are waiting for the result.
func (g *Group) ForgetUnshared(key []byte) bool {


	c, ok := g.m[key]
	if !ok {
		return true
	}
	if c.dups == 0 {
		delete(g.m, key)
		return true
	}
	return false
}
