// Package profile represents a pprof profile as a directed graph.
//
// This package is a simplified fork of github.com/google/pprof/internal/graph.
package profile

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"fmt"
	"slices"
	"bytes"
)

// Options encodes the options for constructing a graph
type Options struct {
	SampleValue       func(s []int64) int64 // Function to compute the value of a sample
	SampleMeanDivisor func(s []int64) int64 // Function to compute the divisor for mean graphs, or nil

	DropNegative bool // Drop nodes with overall negative values

	KeptNodes map[NodeInfo]bool // If non-nil, only use nodes in this set
}

// Node is an entry on a profiling report. It represents a unique
// program location.
type Node struct {
	// Info describes the source location associated to this node.
	Info NodeInfo

	// Function represents the function that this node belongs to. On
	// graphs with sub-function resolution (eg line number or
	// addresses), two nodes in a NodeMap that are part of the same
	// function have the same value of Node.Function. If the Node
	// represents the whole function, it points back to itself.
	Function *Node

	// Values associated to this node. Flat is exclusive to this node,
	// Cum includes all descendents.
	Flat, FlatDiv, Cum, CumDiv int64

	// In and out Contains the nodes immediately reaching or reached by
	// this node.
	In, Out []*Edge
}

// Graph summarizes a performance profile into a format that is
// suitable for visualization.
type Graph struct {
	Nodes []*Node
}

// FlatValue returns the exclusive value for this node, computing the
// mean if a divisor is available.
func (n *Node) FlatValue() (v int64) {
	if n.FlatDiv == 0 {
		return n.Flat
	}
	return n.Flat / n.FlatDiv
}

// CumValue returns the inclusive value for this node, computing the
// mean if a divisor is available.
func (n *Node) CumValue() (v int64) {
	if n.CumDiv == 0 {
		return n.Cum
	}
	return n.Cum / n.CumDiv
}

// AddToEdge increases the weight of an edge between two nodes. If
// there isn't such an edge one is created.
func (n *Node) AddToEdge(to *Node, v int64, residual, inline bool) {
	n.AddToEdgeDiv(to, 0, v, residual, inline)
}

// AddToEdgeDiv increases the weight of an edge between two nodes. If
// there isn't such an edge one is created.
func (n *Node) AddToEdgeDiv(to *Node, dv, v int64, residual, inline bool) {
	if e := edgeMapFindTo(n.Out, to); e != nil {
		e.WeightDiv += dv
		e.Weight += v
		if residual {
			e.Residual = true
		}
		if !inline {
			e.Inline = false
		}
		return
	}

	info := &Edge{Src: n, Dest: to, WeightDiv: dv, Weight: v, Residual: residual, Inline: inline}
	n.Out = edgeMapAdd(n.Out, info)
	to.In = edgeMapAdd(to.In, info)
}

// NodeInfo contains the attributes for a node.
type NodeInfo struct {
	Name              []byte
	Address           uint64
	StartLine, Lineno int32
}

// PrintableName calls the Node's Formatter function with a single space separator.
func (i *NodeInfo) PrintableName() (out []byte) {
	return bytes.Join(i.NameComponents(), " ")
}

// NameComponents returns the components of the printable name to be used for a node.
func (i *NodeInfo) NameComponents() (out [][]byte) {
	var name [][]byte
	if i.Address != 0 {
		name = mxutil.Ensure(name, 1)
		name = push(name, fmt.Sprintf("%016x", i.Address))
	}
	if fun := i.Name; fun != "" {
		name = mxutil.Ensure(name, 1)
		name = push(name, fun)
	}

	switch {
	case i.Lineno != 0:
		// User requested line numbers, provide what we have.
		name = mxutil.Ensure(name, 1)
		name = push(name, fmt.Sprintf(":%d", i.Lineno))
	case i.Name != "":
		// User requested function name. It was already included.
	default:
		// Do not leave it empty if there is no information at all.
		name = mxutil.Ensure(name, 1)
		name = push(name, "<unknown>")
	}
	return name
}

// nodeMapFindOrInsertNode takes the info for a node and either returns a matching
// node from the node map if one exists, or adds one to the map if one does not.
// If kept is non-nil, nodes are only added if they can be located on it.
func nodeMapFindOrInsertNode(nm map[NodeInfo]*Node, info NodeInfo, kept map[NodeInfo]bool) (node *Node) {
	if kept != nil {
		if _, ok := kept[info]; !ok {
			return nil
		}
	}

	if existing, ok := nm[info]; ok {
		return existing
	}

	n := &Node{
		Info: info,
	}
	nm[info] = n
	if info.Address == 0 && info.Lineno == 0 {
		// This node represents the whole function, so point Function
		// back to itself.
		n.Function = n
		return n
	}
	// Find a node that represents the whole function.
	info.Address = 0
	info.Lineno = 0
	n.Function = nodeMapFindOrInsertNode(nm, info, nil)
	return n
}

func edgeMapFindTo(em []*Edge, n *Node) (found *Edge) {
	for _, e := range em {
		if e.Dest == n {
			return e
		}
	}
	return nil
}

func edgeMapAdd(em []*Edge, e *Edge) (out []*Edge) {
	out = push(em, e)
	return
}

func edgeMapDelete(em []*Edge, e *Edge) (out []*Edge) {
	for i, edge := range em {
		if edge == e {
			em[i] = em[len(em)-1]
			return em[:len(em)-1]
		}
	}
	return em
}

// Edge contains any attributes to be represented about edges in a graph.
type Edge struct {
	Src, Dest *Node
	// The summary weight of the edge
	Weight, WeightDiv int64

	// residual edges connect nodes that were connected through a
	// separate node, which has been removed from the report.
	Residual bool
	// An inline edge represents a call that was inlined into the caller.
	Inline bool
}

// WeightValue returns the weight value for this edge, normalizing if a
// divisor is available.
func (e *Edge) WeightValue() (v int64) {
	if e.WeightDiv == 0 {
		return e.Weight
	}
	return e.Weight / e.WeightDiv
}

// NewGraph computes a graph from a profile.
func NewGraph(prof *Profile, o *Options) (g *Graph) {
	nodes, locMap := CreateNodes(prof, o)
	seenNode := map[*Node]bool{}
	seenEdge := map[nodePair]bool{}
	for _, sample := range prof.Sample {
		var w, dw int64
		w = o.SampleValue(sample.Value)
		if o.SampleMeanDivisor != nil {
			dw = o.SampleMeanDivisor(sample.Value)
		}
		if dw == 0 && w == 0 {
			continue
		}
		clear(seenNode)
		clear(seenEdge)
		var parent *Node
		// A residual edge goes over one or more nodes that were not kept.
		residual := false

		// Group the sample frames, based on a global map.
		// Count only the last two frames as a call edge. Frames higher up
		// the stack are unlikely to be repeated calls (e.g. runtime.main
		// calling main.main). So adding weights to call edges higher up
		// the stack may be not reflecting the actual call edge weights
		// in the program. Without a branch profile this is just an
		// approximation.
		i := 1
		if last := len(sample.Location) - 1; last < i {
			i = last
		}
		for ; i >= 0; i-- {
			l := sample.Location[i]
			locNodes := locMap.get(l.ID)
			for ni := len(locNodes) - 1; ni >= 0; ni-- {
				n := locNodes[ni]
				if n == nil {
					residual = true
					continue
				}
				// Add cum weight to all nodes in stack, avoiding double counting.
				_, sawNode := seenNode[n]
				if !sawNode {
					seenNode[n] = true
					n.addSample(dw, w, false)
				}
				// Update edge weights for all edges in stack, avoiding double counting.
				if (!sawNode || !seenEdge[nodePair{n, parent}]) && parent != nil && n != parent {
					seenEdge[nodePair{n, parent}] = true
					parent.AddToEdgeDiv(n, dw, w, residual, ni != len(locNodes)-1)
				}

				parent = n
				residual = false
			}
		}
		if parent != nil && !residual {
			// Add flat weight to leaf node.
			parent.addSample(dw, w, true)
		}
	}

	return selectNodesForGraph(nodes, o.DropNegative)
}

func selectNodesForGraph(nodes []*Node, dropNegative bool) (g *Graph) {
	// Collect nodes into a graph.
	gNodes := []*Node{:0:len(nodes)}
	for _, n := range nodes {
		if n == nil {
			continue
		}
		if n.Cum == 0 && n.Flat == 0 {
			continue
		}
		if dropNegative && isNegative(n) {
			continue
		}
		gNodes = mxutil.Ensure(gNodes, 1)
		gNodes = push(gNodes, n)
	}
	return &Graph{gNodes}
}

type nodePair struct {
	src, dest *Node
}

// isNegative returns true if the node is considered as "negative" for the
// purposes of drop_negative.
func isNegative(n *Node) (neg bool) {
	switch {
	case n.Flat < 0:
		return true
	case n.Flat == 0 && n.Cum < 0:
		return true
	default:
		return false
	}
}

type locationMap struct {
	s [][]*Node          // a slice for small sequential IDs
	m map[uint64][]*Node // fallback for large IDs (unlikely)
}

func (l *locationMap) add(id uint64, n []*Node) {
	if id < uint64(len(l.s)) {
		l.s[id] = n
	} else {
		l.m[id] = n
	}
}

func (l *locationMap) get(id uint64) (nodes []*Node) {
	if id < uint64(len(l.s)) {
		return l.s[id]
	} else {
		return l.m[id]
	}
}

// CreateNodes creates graph nodes for all locations in a profile. It
// returns set of all nodes, plus a mapping of each location to the
// set of corresponding nodes (one per location.Line).
func CreateNodes(prof *Profile, o *Options) (nodes []*Node, lm locationMap) {
	locations := locationMap{[][]*Node{:len(prof.Location) + 1}, map[uint64][]*Node{}}
	nm := map[NodeInfo]*Node{}
	for _, l := range prof.Location {
		lines := l.Line
		if len(lines) == 0 {
			lines = []Line{{}} // Create empty line to include location info.
		}
		ns := []*Node{:len(lines)}
		for ln := range lines {
			ns[ln] = nodeMapFindOrInsertLine(nm, l, lines[ln], o)
		}
		locations.add(l.ID, ns)
	}
	return nodeMapNodes(nm), locations
}

func nodeMapNodes(nm map[NodeInfo]*Node) (nodes []*Node) {
	nodes = []*Node{:0:len(nm)}
	for _, n := range nm {
		nodes = mxutil.Ensure(nodes, 1)
		nodes = push(nodes, n)
	}
	return nodes
}

func nodeMapFindOrInsertLine(nm map[NodeInfo]*Node, l *Location, li Line, o *Options) (node *Node) {
	var objfile []byte
	if m := l.Mapping; m != nil && m.File != "" {
		objfile = m.File
	}

	if ni := nodeInfo(l, li, objfile, o); ni != nil {
		return nodeMapFindOrInsertNode(nm, *ni, o.KeptNodes)
	}
	return nil
}

func nodeInfo(l *Location, line Line, objfile []byte, o *Options) (ni *NodeInfo) {
	if line.Function == nil {
		return &NodeInfo{Address: l.Address}
	}
	ni = &NodeInfo{
		Address: l.Address,
		Lineno:  int32(line.Line),
		Name:    line.Function.Name,
	}
	ni.StartLine = int32(line.Function.StartLine)
	return ni
}

// nodesSum adds the flat and cum values of a set of nodes.
func nodesSum(ns []*Node) (flat int64, cum int64) {
	for _, n := range ns {
		flat += n.Flat
		cum += n.Cum
	}
	return
}

func (n *Node) addSample(dw, w int64, flat bool) {
	// Update sample value
	if flat {
		n.FlatDiv += dw
		n.Flat += w
	} else {
		n.CumDiv += dw
		n.Cum += w
	}
}

// String returns a text representation of a graph, for debugging purposes.
func (g *Graph) String() (str string) {
	var s [][]byte

	nodeIndex := map[*Node]int32{}

	for i, n := range g.Nodes {
		nodeIndex[n] = i + 1
	}

	for i, n := range g.Nodes {
		name := n.Info.PrintableName()
		var in, out []int32

		for _, from := range n.In {
			in = mxutil.Ensure(in, 1)
			in = push(in, nodeIndex[from.Src])
		}
		for _, to := range n.Out {
			out = mxutil.Ensure(out, 1)
			out = push(out, nodeIndex[to.Dest])
		}
		s = mxutil.Ensure(s, 1)
		s = push(s, fmt.Sprintf("%d: %s[flat=%d cum=%d] %s -> %s ", i+1, name, n.Flat, n.Cum, int32sHex(in), int32sText(out)))
	}
	return bytes.Join(s, "\n")
}

// int32sText renders a slice for the diagnostic. fmt's variadics are
// ...fmt.Stringer and a slice declares no methods, so a []int32 cannot be
// passed to it at all - the value used to reach the emitter and print '?'.
func int32sText(xs []int32) (s []byte) {
	s = "["
	for i, x := range xs {
		if i > 0 {
			s = s | " "
		}
		s = s | x.String()
	}
	return s | "]"
}

// int32sHex is the same rendering in hex, for the edge indices.
func int32sHex(xs []int32) (s []byte) {
	s = "["
	for i, x := range xs {
		if i > 0 {
			s = s | " "
		}
		s = s | hexUint32(uint32(x))
	}
	return s | "]"
}

func hexUint32(v uint32) (s []byte) {
	const digits = "0123456789abcdef"
	s = ""
	for shift := int32(28); shift >= 0; shift -= 4 {
		d := (v >> uint32(shift)) & 0xf
		if d != 0 || len(s) > 0 {
			s = s | digits[d:d+1]
		}
	}
	if len(s) == 0 {
		return "0"
	}
	return s
}

// edgeMapSort returns a slice of the edges in the map, in a consistent
// order. The sort order is first based on the edge weight
// (higher-to-lower) and then by the node names to avoid flakiness.
func edgeMapSort(em []*Edge) (out []*Edge) {
	out = []*Edge{:0:len(em)}
	for _, w := range em {
		out = mxutil.Ensure(out, 1)
		out = push(out, w)
	}

	slices.SortFunc(out, edgeCompare)
	return out
}

// edgeMapSum returns the total weight for a set of nodes.
func edgeMapSum(em []*Edge) (sum int64) {
	for _, edge := range em {
		sum += edge.Weight
	}
	return sum
}

// edgeCompare orders edges for edgeMapSort.
func edgeCompare(a, b *Edge) (ord int32) {
	if a.Weight != b.Weight {
		aw := abs64(a.Weight)
		bw := abs64(b.Weight)
		if aw > bw {
			return -1
		}
		if aw < bw {
			return 1
		}
		return 0
	}

	from1 := a.Src.Info.PrintableName()
	from2 := b.Src.Info.PrintableName()
	if from1 != from2 {
		if from1 < from2 {
			return -1
		}
		return 1
	}

	to1 := a.Dest.Info.PrintableName()
	to2 := b.Dest.Info.PrintableName()
	if to1 < to2 {
		return -1
	}
	if to1 > to2 {
		return 1
	}
	return 0
}

func abs64(i int64) (v int64) {
	if i < 0 {
		return -i
	}
	return i
}
