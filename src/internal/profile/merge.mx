package profile

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"fmt"
	"sort"
	"strconv"
	"bytes"
)

// Merge merges all the profiles in profs into a single Profile.
// Returns a new profile independent of the input profiles. The merged
// profile is compacted to eliminate unused samples, locations,
// functions and mappings. Profiles must have identical profile sample
// and period types or the merge will fail. profile.Period of the
// resulting profile will be the maximum of all profiles, and
// profile.TimeNanos will be the earliest nonzero one.
func Merge(srcs []*Profile) (out *Profile, rerr error) {
	if len(srcs) == 0 {
		return nil, fmt.Errorf("no profiles to merge")
	}
	p, err := combineHeaders(srcs)
	if err != nil {
		return nil, err
	}

	pm := &profileMerger{
		p:         p,
		samples:   map[sampleKey]*Sample{},
		locations: map[locationKey]*Location{},
		functions: map[functionKey]*Function{},
		mappings:  map[mappingKey]*Mapping{},
	}

	for _, src := range srcs {
		// Clear the profile-specific hash tables
		pm.locationsByID = map[uint64]*Location{}
		pm.functionsByID = map[uint64]*Function{}
		pm.mappingsByID = map[uint64]mapInfo{}

		if len(pm.mappings) == 0 && len(src.Mapping) > 0 {
			// The Mapping list has the property that the first mapping
			// represents the main binary. Take the first Mapping we see,
			// otherwise the operations below will add mappings in an
			// arbitrary order.
			pm.mapMapping(src.Mapping[0])
		}

		for _, s := range src.Sample {
			if !isZeroSample(s) {
				pm.mapSample(s)
			}
		}
	}

	for _, s := range p.Sample {
		if isZeroSample(s) {
			// If there are any zero samples, re-merge the profile to GC
			// them.
			return Merge([]*Profile{p})
		}
	}

	return p, nil
}

// Normalize normalizes the source profile by multiplying each value in profile by the
// ratio of the sum of the base profile's values of that sample type to the sum of the
// source profile's value of that sample type.
func (p *Profile) Normalize(pb *Profile) (rerr error) {

	if err := p.compatible(pb); err != nil {
		return err
	}

	baseVals := []int64{:len(p.SampleType)}
	for _, s := range pb.Sample {
		for i, v := range s.Value {
			baseVals[i] += v
		}
	}

	srcVals := []int64{:len(p.SampleType)}
	for _, s := range p.Sample {
		for i, v := range s.Value {
			srcVals[i] += v
		}
	}

	normScale := []float64{:len(baseVals)}
	for i := range baseVals {
		if srcVals[i] == 0 {
			normScale[i] = 0.0
		} else {
			normScale[i] = float64(baseVals[i]) / float64(srcVals[i])
		}
	}
	p.ScaleN(normScale)
	return nil
}

func isZeroSample(s *Sample) (zero bool) {
	for _, v := range s.Value {
		if v != 0 {
			return false
		}
	}
	return true
}

type profileMerger struct {
	p *Profile

	// Memoization tables within a profile.
	locationsByID map[uint64]*Location
	functionsByID map[uint64]*Function
	mappingsByID  map[uint64]mapInfo

	// Memoization tables for profile entities.
	samples   map[sampleKey]*Sample
	locations map[locationKey]*Location
	functions map[functionKey]*Function
	mappings  map[mappingKey]*Mapping
}

type mapInfo struct {
	m      *Mapping
	offset int64
}

func (pm *profileMerger) mapSample(src *Sample) (out *Sample) {
	s := &Sample{
		Location: []*Location{:len(src.Location)},
		Value:    []int64{:len(src.Value)},
		Label:    map[string][][]byte{},
		NumLabel: map[string][]int64{},
		NumUnit:  map[string][][]byte{},
	}
	for i, l := range src.Location {
		s.Location[i] = pm.mapLocation(l)
	}
	var lvs [][]byte
	for lk, lv := range src.Label {
		lvs = [][]byte{:len(lv)}
		copy(lvs, lv)
		s.Label[lk] = lvs
	}
	var u [][]byte
	var nvs []int64
	var uvs [][]byte
	for nk, nv := range src.NumLabel {
		u = src.NumUnit[nk]
		nvs = []int64{:len(nv)}
		uvs = [][]byte{:len(u)}
		copy(nvs, nv)
		copy(uvs, u)
		s.NumLabel[nk] = nvs
		s.NumUnit[nk] = uvs
	}
	// Check memoization table. Must be done on the remapped location to
	// account for the remapped mapping. Add current values to the
	// existing sample.
	k := s.key()
	if ss, ok := pm.samples[k]; ok {
		for i, v := range src.Value {
			ss.Value[i] += v
		}
		return ss
	}
	copy(s.Value, src.Value)
	pm.samples[k] = s
	pm.p.Sample = mxutil.Ensure(pm.p.Sample, 1)
	pm.p.Sample = push(pm.p.Sample, s)
	return s
}

// key generates sampleKey to be used as a key for maps.
func (sample *Sample) key() (out sampleKey) {
	ids := [][]byte{:len(sample.Location)}
	for i, l := range sample.Location {
		ids[i] = strconv.FormatUint(l.ID, 16)
	}

	labels := [][]byte{:0:len(sample.Label)}
	for k, v := range sample.Label {
		labels = mxutil.Ensure(labels, 1)
		labels = push(labels, fmt.Sprintf("%q%s", k, labelValuesText(v)))
	}
	sort.Strings(labels)

	numlabels := [][]byte{:0:len(sample.NumLabel)}
	for k, v := range sample.NumLabel {
		numlabels = mxutil.Ensure(numlabels, 1)
		numlabels = push(numlabels, fmt.Sprintf("%q%s%s", k, int64sHexText(v), labelValuesText(sample.NumUnit[k])))
	}
	sort.Strings(numlabels)

	return sampleKey{
		bytes.Join(ids, "|"),
		bytes.Join(labels, ""),
		bytes.Join(numlabels, ""),
	}
}

type sampleKey struct {
	locations []byte
	labels    []byte
	numlabels []byte
}

func (pm *profileMerger) mapLocation(src *Location) (out *Location) {
	if src == nil {
		return nil
	}

	if lc, ok := pm.locationsByID[src.ID]; ok {
		pm.locationsByID[src.ID] = lc
		return lc
	}

	mi := pm.mapMapping(src.Mapping)
	l := &Location{
		ID:       uint64(len(pm.p.Location) + 1),
		Mapping:  mi.m,
		Address:  uint64(int64(src.Address) + mi.offset),
		Line:     []Line{:len(src.Line)},
		IsFolded: src.IsFolded,
	}
	for i, ln := range src.Line {
		l.Line[i] = pm.mapLine(ln)
	}
	// Check memoization table. Must be done on the remapped location to
	// account for the remapped mapping ID.
	k := l.key()
	if ll, ok := pm.locations[k]; ok {
		pm.locationsByID[src.ID] = ll
		return ll
	}
	pm.locationsByID[src.ID] = l
	pm.locations[k] = l
	pm.p.Location = mxutil.Ensure(pm.p.Location, 1)
	pm.p.Location = push(pm.p.Location, l)
	return l
}

// key generates locationKey to be used as a key for maps.
func (l *Location) key() (out locationKey) {
	key := locationKey{
		addr:     l.Address,
		isFolded: l.IsFolded,
	}
	if l.Mapping != nil {
		// Normalizes address to handle address space randomization.
		key.addr -= l.Mapping.Start
		key.mappingID = l.Mapping.ID
	}
	lines := [][]byte{:len(l.Line)*2}
	for i, line := range l.Line {
		if line.Function != nil {
			lines[i*2] = strconv.FormatUint(line.Function.ID, 16)
		}
		lines[i*2+1] = strconv.FormatInt(line.Line, 16)
	}
	key.lines = bytes.Join(lines, "|")
	return key
}

type locationKey struct {
	addr, mappingID uint64
	lines           []byte
	isFolded        bool
}

func (pm *profileMerger) mapMapping(src *Mapping) (out mapInfo) {
	if src == nil {
		return mapInfo{}
	}

	if cached, ok := pm.mappingsByID[src.ID]; ok {
		return cached
	}

	// Check memoization tables.
	mk := src.key()
	if known, ok := pm.mappings[mk]; ok {
		res := mapInfo{known, int64(known.Start) - int64(src.Start)}
		pm.mappingsByID[src.ID] = res
		return res
	}
	m := &Mapping{
		ID:              uint64(len(pm.p.Mapping) + 1),
		Start:           src.Start,
		Limit:           src.Limit,
		Offset:          src.Offset,
		File:            src.File,
		BuildID:         src.BuildID,
		HasFunctions:    src.HasFunctions,
		HasFilenames:    src.HasFilenames,
		HasLineNumbers:  src.HasLineNumbers,
		HasInlineFrames: src.HasInlineFrames,
	}
	pm.p.Mapping = mxutil.Ensure(pm.p.Mapping, 1)
	pm.p.Mapping = push(pm.p.Mapping, m)

	// Update memoization tables.
	pm.mappings[mk] = m
	info := mapInfo{m, 0}
	pm.mappingsByID[src.ID] = info
	return info
}

// key generates encoded strings of Mapping to be used as a key for
// maps.
func (m *Mapping) key() (out mappingKey) {
	// Normalize addresses to handle address space randomization.
	// Round up to next 4K boundary to avoid minor discrepancies.
	const mapsizeRounding = 0x1000

	size := m.Limit - m.Start
	size = size + mapsizeRounding - 1
	size = size - (size % mapsizeRounding)
	key := mappingKey{
		size:   size,
		offset: m.Offset,
	}

	switch {
	case m.BuildID != "":
		key.buildIDOrFile = m.BuildID
	case m.File != "":
		key.buildIDOrFile = m.File
	default:
		// A mapping containing neither build ID nor file name is a fake mapping. A
		// key with empty buildIDOrFile is used for fake mappings so that they are
		// treated as the same mapping during merging.
	}
	return key
}

type mappingKey struct {
	size, offset  uint64
	buildIDOrFile []byte
}

func (pm *profileMerger) mapLine(src Line) (out Line) {
	ln := Line{
		Function: pm.mapFunction(src.Function),
		Line:     src.Line,
	}
	return ln
}

func (pm *profileMerger) mapFunction(src *Function) (out *Function) {
	if src == nil {
		return nil
	}
	if cached, ok := pm.functionsByID[src.ID]; ok {
		return cached
	}
	k := src.key()
	if known, ok := pm.functions[k]; ok {
		pm.functionsByID[src.ID] = known
		return known
	}
	f := &Function{
		ID:         uint64(len(pm.p.Function) + 1),
		Name:       src.Name,
		SystemName: src.SystemName,
		Filename:   src.Filename,
		StartLine:  src.StartLine,
	}
	pm.functions[k] = f
	pm.functionsByID[src.ID] = f
	pm.p.Function = mxutil.Ensure(pm.p.Function, 1)
	pm.p.Function = push(pm.p.Function, f)
	return f
}

// key generates a struct to be used as a key for maps.
func (f *Function) key() (out functionKey) {
	return functionKey{
		f.StartLine,
		f.Name,
		f.SystemName,
		f.Filename,
	}
}

type functionKey struct {
	startLine                  int64
	name, systemName, fileName []byte
}

// combineHeaders checks that all profiles can be merged and returns
// their combined profile.
func combineHeaders(srcs []*Profile) (out *Profile, rerr error) {
	for _, s := range srcs[1:] {
		if err := srcs[0].compatible(s); err != nil {
			return nil, err
		}
	}

	var timeNanos, durationNanos, period int64
	var comments [][]byte
	seenComments := map[string]bool{}
	var defaultSampleType []byte
	for _, s := range srcs {
		if timeNanos == 0 || s.TimeNanos < timeNanos {
			timeNanos = s.TimeNanos
		}
		durationNanos += s.DurationNanos
		if period == 0 || period < s.Period {
			period = s.Period
		}
		for _, c := range s.Comments {
			if seen := seenComments[c]; !seen {
				comments = mxutil.Ensure(comments, 1)
				comments = push(comments, c)
				seenComments[c] = true
			}
		}
		if defaultSampleType == "" {
			defaultSampleType = s.DefaultSampleType
		}
	}

	p := &Profile{
		SampleType: []*ValueType{:len(srcs[0].SampleType)},

		DropFrames: srcs[0].DropFrames,
		KeepFrames: srcs[0].KeepFrames,

		TimeNanos:     timeNanos,
		DurationNanos: durationNanos,
		PeriodType:    srcs[0].PeriodType,
		Period:        period,

		Comments:          comments,
		DefaultSampleType: defaultSampleType,
	}
	copy(p.SampleType, srcs[0].SampleType)
	return p, nil
}

// compatible determines if two profiles can be compared/merged.
// returns nil if the profiles are compatible; otherwise an error with
// details on the incompatibility.
func (p *Profile) compatible(pb *Profile) (rerr error) {
	if !equalValueType(p.PeriodType, pb.PeriodType) {
		return fmt.Errorf("incompatible period types %s and %s", valueTypeText(p.PeriodType), valueTypeText(pb.PeriodType))
	}

	if len(p.SampleType) != len(pb.SampleType) {
		return fmt.Errorf("incompatible sample types %s and %s", valueTypesText(p.SampleType), valueTypesText(pb.SampleType))
	}

	for i := range p.SampleType {
		if !equalValueType(p.SampleType[i], pb.SampleType[i]) {
			return fmt.Errorf("incompatible sample types %s and %s", valueTypesText(p.SampleType), valueTypesText(pb.SampleType))
		}
	}
	return nil
}

// valueTypesText renders the sample types for the diagnostic. fmt takes
// ...fmt.Stringer, and a slice of ValueType declares no methods, so the slice
// itself cannot be an argument; each element can.
// valueTypeText renders one sample type as it is written ("cpu:nanoseconds").
// ValueType has no String of its own - the builtin String is injected for types
// the renderer needs, and this one is not among them - so the two fields are
// joined here.
func valueTypeText(t *ValueType) (s []byte) {
	if t == nil {
		return "<nil>"
	}
	return t.Type | ":" | t.Unit
}

func valueTypesText(ts []*ValueType) (s []byte) {
	s = "["
	for i, t := range ts {
		if i > 0 {
			s = s | " "
		}
		s = s | valueTypeText(t)
	}
	return s | "]"
}

// equalValueType returns true if the two value types are semantically
// equal. It ignores the internal fields used during encode/decode.
func equalValueType(st1, st2 *ValueType) (eq bool) {
	return st1.Type == st2.Type && st1.Unit == st2.Unit
}

// labelValuesText renders one numeric-label key's string values. fmt's
// variadics are ...fmt.Stringer, and a [][]byte declares no methods, so the
// slice cannot be an argument; each element can (string and []byte are one type
// and it carries the builtin String).
func labelValuesText(vs [][]byte) (s []byte) {
	for _, v := range vs {
		s = s | fmt.Sprintf("%q", v)
	}
	return s
}

// int64sHexText renders a numeric-label key's values in hex, which is what the
// key's text used to say.
func int64sHexText(vs []int64) (s []byte) {
	for i, v := range vs {
		if i > 0 {
			s = s | " "
		}
		s = s | hexUint64(uint64(v))
	}
	return s
}

func hexUint64(v uint64) (s []byte) {
	const digits = "0123456789abcdef"
	s = ""
	for shift := int32(60); shift >= 0; shift -= 4 {
		d := (v >> uint32(shift)) & 0xf
		if d != 0 || len(s) > 0 {
			s = s | digits[d:d+1]
		}
	}
	if len(s) == 0 {
		return "0"
	}
	return s
}
