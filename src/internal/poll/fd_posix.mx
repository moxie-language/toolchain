//:build unix || (js && wasm)

package poll

import (
	"io"
	"syscall"
)

// eofError returns io.EOF when fd is available for reading end of
// file.
func (fd *FD) eofError(n int32, err error) (rerr error) {
	if n == 0 && err == nil && fd.ZeroReadIsEOF {
		return io.EOF
	}
	return err
}

// Shutdown wraps syscall.Shutdown.
func (fd *FD) Shutdown(how int32) (rerr error) {
	if err := fd.incref(); err != nil {
		return err
	}
	defer fd.decref()
	return syscall.Shutdown(fd.Sysfd, how)
}

// Fchown wraps syscall.Fchown.
func (fd *FD) Fchown(uid, gid int32) (rerr error) {
	if err := fd.incref(); err != nil {
		return err
	}
	defer fd.decref()
	for {
		rerr = syscall.Fchown(fd.Sysfd, uid, gid)
		if rerr != syscall.EINTR {
			return rerr
		}
	}
}

// Ftruncate wraps syscall.Ftruncate.
func (fd *FD) Ftruncate(size int64) (rerr error) {
	if err := fd.incref(); err != nil {
		return err
	}
	defer fd.decref()
	for {
		rerr = syscall.Ftruncate(fd.Sysfd, size)
		if rerr != syscall.EINTR {
			return rerr
		}
	}
}

// RawControl invokes the user-defined function f for a non-IO
// operation.
func (fd *FD) RawControl(f syscall.RawConnControlAction) (rerr error) {
	if err := fd.incref(); err != nil {
		return err
	}
	defer fd.decref()
	f.RawControlAction(uintptr(fd.Sysfd))
	return nil
}
