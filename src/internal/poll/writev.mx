//:build unix

package poll

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"io"
	"syscall"
)

// Writev wraps the writev system call.
func (fd *FD) Writev(v *[][]byte) (rn int64, rerr error) {
	if werr := fd.writeLock(); werr != nil {
		return 0, werr
	}
	defer fd.writeUnlock()
	if werr := fd.pd.prepareWrite(fd.isFile); werr != nil {
		return 0, werr
	}

	var iovecs []syscall.Iovec
	if fd.iovecs != nil {
		iovecs = *fd.iovecs
	}
	// TODO: read from sysconf(_SC_IOV_MAX)? The Linux default is
	// 1024 and this seems conservative enough for now.
	maxVec := 1024

	var n int64
	var err error
	// Declared outside the loop: a declaration in the body of a self-mutating
	// method allocates in the sovereign arena on every iteration.
	var wrote uintptr
	for len(*v) > 0 {
		iovecs = resize(iovecs, 0)
		for _, chunk := range *v {
			if len(chunk) == 0 {
				continue
			}
			iovecs = mxutil.Ensure(iovecs, 1)
			iovecs = push(iovecs, newIovecWithBase(&chunk[0]))
			if fd.IsStream && len(chunk) > 1<<30 {
				iovecs[len(iovecs)-1].SetLen(1 << 30)
				break // continue chunk on next writev
			}
			iovecs[len(iovecs)-1].SetLen(len(chunk))
			if len(iovecs) == maxVec {
				break
			}
		}
		if len(iovecs) == 0 {
			break
		}
		if fd.iovecs == nil {
			fd.iovecs = &[]syscall.Iovec{}
		}
		*fd.iovecs = iovecs // cache

		wrote, err = writev(fd.Sysfd, iovecs)
		if wrote == ^uintptr(0) {
			wrote = 0
		}
		n += int64(wrote)
		consume(v, int64(wrote))
		clear(iovecs)
		if err != nil {
			if err == syscall.EINTR {
				continue
			}
			if err == syscall.EAGAIN {
				if err = fd.pd.waitWrite(fd.isFile); err == nil {
					continue
				}
			}
			break
		}
		if n == 0 {
			err = io.ErrUnexpectedEOF
			break
		}
	}
	return n, err
}
