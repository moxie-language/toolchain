//:build (js && wasm) || linux

package poll

import "syscall"

// Fsync wraps syscall.Fsync.
func (fd *FD) Fsync() (rerr error) {
	if err := fd.incref(); err != nil {
		return err
	}
	defer fd.decref()
	for {
		rerr = syscall.Fsync(fd.Sysfd)
		if rerr != syscall.EINTR {
			return rerr
		}
	}
}
