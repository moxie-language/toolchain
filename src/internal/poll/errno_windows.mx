//go:build windows

package poll

import "syscall"

// errnoErr returns common boxed Errno values.
func errnoErr(e syscall.Errno) error {
	switch e {
	case 0:
		return nil
	case syscall.ERROR_IO_PENDING:
		return syscall.Errno(syscall.ERROR_IO_PENDING)
	}
	return e
}
