//:build unix

package poll

import "syscall"

// errnoErr returns common boxed Errno values.
func errnoErr(e syscall.Errno) (rerr error) {
	switch e {
	case 0:
		return nil
	case syscall.EAGAIN:
		return syscall.EAGAIN
	case syscall.EINVAL:
		return syscall.EINVAL
	case syscall.ENOENT:
		return syscall.ENOENT
	}
	return e
}
