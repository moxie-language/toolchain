//go:build unix
//:build unix

package unix

import (
	"syscall"
)

// Implemented in the runtime package.
//
//:linkname fcntl runtime.fcntl
func fcntl(fd int32, cmd int32, arg int32) (int32, int32)

func Fcntl(fd int32, cmd int32, arg int32) (int32, error) {
	val, errno := fcntl(int32(fd), int32(cmd), int32(arg))
	if val == -1 {
		return int32(val), syscall.Errno(errno)
	}
	return int32(val), nil
}
