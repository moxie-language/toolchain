//go:build unix
//:build unix

package unix

import (
	"syscall"
	_ "unsafe"
)

//:linkname RecvfromInet4 syscall.recvfromInet4
//:noescape
func RecvfromInet4(fd int32, p []byte, flags int32, from *syscall.SockaddrInet4) (int32, error)

//:linkname RecvfromInet6 syscall.recvfromInet6
//:noescape
func RecvfromInet6(fd int32, p []byte, flags int32, from *syscall.SockaddrInet6) (n int32, err error)

//:linkname SendtoInet4 syscall.sendtoInet4
//:noescape
func SendtoInet4(fd int32, p []byte, flags int32, to *syscall.SockaddrInet4) (err error)

//:linkname SendtoInet6 syscall.sendtoInet6
//:noescape
func SendtoInet6(fd int32, p []byte, flags int32, to *syscall.SockaddrInet6) (err error)

//:linkname SendmsgNInet4 syscall.sendmsgNInet4
//:noescape
func SendmsgNInet4(fd int32, p, oob []byte, to *syscall.SockaddrInet4, flags int32) (n int32, err error)

//:linkname SendmsgNInet6 syscall.sendmsgNInet6
//:noescape
func SendmsgNInet6(fd int32, p, oob []byte, to *syscall.SockaddrInet6, flags int32) (n int32, err error)

//:linkname RecvmsgInet4 syscall.recvmsgInet4
//:noescape
func RecvmsgInet4(fd int32, p, oob []byte, flags int32, from *syscall.SockaddrInet4) (n, oobn int32, recvflags int32, err error)

//:linkname RecvmsgInet6 syscall.recvmsgInet6
//:noescape
func RecvmsgInet6(fd int32, p, oob []byte, flags int32, from *syscall.SockaddrInet6) (n, oobn int32, recvflags int32, err error)
