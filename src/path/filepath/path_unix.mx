//:build unix || (js && wasm)

package filepath

import (
	"bytes"
)

// HasPrefix exists for historical compatibility and should not be used.
//
// Deprecated: HasPrefix does not respect path boundaries and
// does not ignore case when required.
func HasPrefix(p, prefix []byte) (ok bool) {
	return bytes.HasPrefix(p, prefix)
}

func splitList(path []byte) (out [][]byte) {
	if path == "" {
		return [][]byte{}
	}
	return bytes.Split(path, []byte{byte(ListSeparator)})
}

func abs(path []byte) (out []byte, aerr error) {
	return unixAbs(path)
}

func join(elem [][]byte) (out []byte) {
	// If there's a bug here, fix the logic in ./path_plan9.go too.
	for i, e := range elem {
		if e != "" {
			return Clean(bytes.Join(elem[i:], []byte{byte(Separator)}))
		}
	}
	return ""
}

func sameWord(a, b []byte) (ok bool) {
	return a == b
}
