package filepath

import (
	"github.com/moxie-language/toolchain/pkg/mxutil"
	"io/fs"
	"os"
	stdpath "path"
	"bytes"
	"unicode/utf8"
)

// ErrBadPattern indicates a pattern was malformed.
var ErrBadPattern error

// Match reports whether name matches the shell file name pattern.
// The pattern syntax is:
//
//	pattern:
//		{ term }
//	term:
//		'*'         matches any sequence of non-Separator characters
//		'?'         matches any single non-Separator character
//		'[' [ '^' ] { character-range } ']'
//		            character class (must be non-empty)
//		c           matches character c (c != '*', '?', '\\', '[')
//		'\\' c      matches character c
//
//	character-range:
//		c           matches character c (c != '\\', '-', ']')
//		'\\' c      matches character c
//		lo '-' hi   matches character c for lo <= c <= hi
//
// Match requires pattern to match all of name, not just a substring.
// The only possible returned error is [ErrBadPattern], when pattern
// is malformed.
//
// On Windows, escaping is disabled. Instead, '\\' is treated as
// path separator.
func Match(pattern, name []byte) (matched bool, err error) {
	// ppos and npos walk pattern and name. Neither is ever trimmed: a
	// sub-slice is a copy, so `pattern = pattern[n:]` in a match loop would
	// allocate the rest of the input once per chunk.
	var ppos, npos int32
Pattern:
	for ppos < len(pattern) {
		var star bool
		var cstart, cend int32
		star, cstart, cend, ppos = scanChunk(pattern, ppos)
		if star && cend == cstart {
			// Trailing * matches rest of string unless it has a /.
			return bytes.IndexByteFrom(name, npos, byte(Separator)) < 0, nil
		}
		// Look for match at current position.
		tpos, ok, cerr := matchChunk(pattern, cstart, cend, name, npos)
		// if we're the last chunk, make sure we've exhausted the name
		// otherwise we'll give a false result even if we could still match
		// using the star
		if ok && (tpos == len(name) || ppos < len(pattern)) {
			npos = tpos
			continue
		}
		if cerr != nil {
			return false, cerr
		}
		if star {
			// Look for match skipping i+1 bytes.
			// Cannot skip /.
			for i := npos; i < len(name) && name[i] != Separator; i++ {
				nt, nok, nerr := matchChunk(pattern, cstart, cend, name, i+1)
				if nok {
					// if we're the last chunk, make sure we exhausted the name
					if ppos == len(pattern) && nt < len(name) {
						continue
					}
					npos = nt
					continue Pattern
				}
				if nerr != nil {
					return false, nerr
				}
			}
		}
		return false, nil
	}
	return npos == len(name), nil
}

// scanChunk gets the next segment of pattern, which is a non-star string
// possibly preceded by a star. The chunk is pattern[cstart:cend] and the next
// chunk starts at rest.
func scanChunk(pattern []byte, pos int32) (star bool, cstart, cend, rest int32) {
	for pos < len(pattern) && pattern[pos] == '*' {
		pos++
		star = true
	}
	inrange := false
	var i int32
	cstart = pos
Scan:
	for i = pos; i < len(pattern); i++ {
		switch pattern[i] {
		case '\\':
			// error check handled in matchChunk: bad pattern.
			if i+1 < len(pattern) {
				i++
			}
		case '[':
			inrange = true
		case ']':
			inrange = false
		case '*':
			if !inrange {
				break Scan
			}
		}
	}
	return star, cstart, i, i
}

// matchChunk checks whether pattern[pstart:pend] matches the beginning of s at
// byte offset spos. If so, it returns the offset after the match. Chunk is all
// single-character operators: literals, char classes, and ?.
func matchChunk(pattern []byte, pstart, pend int32, s []byte, spos int32) (rest int32, ok bool, err error) {
	// failed records whether the match has failed.
	// After the match fails, the loop continues on processing chunk,
	// checking that the pattern is well-formed but no longer reading s.
	failed := false
	cp, sp := pstart, spos
	for cp < pend {
		if !failed && sp == len(s) {
			failed = true
		}
		switch pattern[cp] {
		case '[':
			// character class
			var r rune
			if !failed {
				var n int32
				r, n = utf8.DecodeRuneInStringAt(s, sp)
				sp += n
			}
			cp++
			// possibly negated
			negated := false
			if cp < pend && pattern[cp] == '^' {
				negated = true
				cp++
			}
			// parse all ranges
			match := false
			nrange := 0
			for {
				if cp < pend && pattern[cp] == ']' && nrange > 0 {
					cp++
					break
				}
				var lo, hi rune
				if lo, cp, err = getEsc(pattern, cp, pend); err != nil {
					return 0, false, err
				}
				hi = lo
				if pattern[cp] == '-' {
					if hi, cp, err = getEsc(pattern, cp+1, pend); err != nil {
						return 0, false, err
					}
				}
				if lo <= r && r <= hi {
					match = true
				}
				nrange++
			}
			if match == negated {
				failed = true
			}

		case '?':
			if !failed {
				if s[sp] == Separator {
					failed = true
				}
				_, n := utf8.DecodeRuneInStringAt(s, sp)
				sp += n
			}
			cp++

		case '\\':
			cp++
			if cp == pend {
				return 0, false, ErrBadPattern
			}
			if !failed {
				if pattern[cp] != s[sp] {
					failed = true
				}
				sp++
			}
			cp++

		default:
			if !failed {
				if pattern[cp] != s[sp] {
					failed = true
				}
				sp++
			}
			cp++
		}
	}
	if failed {
		return 0, false, nil
	}
	return sp, true, nil
}

// getEsc gets a possibly-escaped character from pattern[pos:end], for a
// character class. It returns the rune and the offset after it.
func getEsc(pattern []byte, pos, end int32) (r rune, npos int32, err error) {
	if pos == end || pattern[pos] == '-' || pattern[pos] == ']' {
		err = ErrBadPattern
		return
	}
	if pattern[pos] == '\\' {
		pos++
		if pos == end {
			err = ErrBadPattern
			return
		}
	}
	r, n := utf8.DecodeRuneInStringAt(pattern, pos)
	if r == utf8.RuneError && n == 1 {
		err = ErrBadPattern
	}
	npos = pos + n
	if npos == end {
		err = ErrBadPattern
	}
	return
}

// Glob returns the names of all files matching pattern or nil
// if there is no matching file. The syntax of patterns is the same
// as in [Match]. The pattern may describe hierarchical names such as
// /usr/*/bin/ed (assuming the [Separator] is '/').
//
// Glob ignores file system errors such as I/O errors reading directories.
// The only possible returned error is [ErrBadPattern], when pattern
// is malformed.
func Glob(pattern []byte) (matches [][]byte, err error) {
	return globWithLimit(pattern, 0)
}

func globWithLimit(pattern []byte, depth int32) (matches [][]byte, err error) {
	// This limit is used prevent stack exhaustion issues. See CVE-2022-30632.
	const pathSeparatorsLimit = 10000
	if depth == pathSeparatorsLimit {
		return nil, ErrBadPattern
	}

	// Check pattern is well-formed.
	if _, merr := Match(pattern, ""); merr != nil {
		return nil, merr
	}
	if !hasMeta(pattern) {
		if _, err = os.Lstat(pattern); err != nil {
			return nil, nil
		}
		return [][]byte{pattern}, nil
	}

	dir, file := Split(pattern)
	volumeLen := 0
	dir = cleanGlobPath(dir)

	if !hasMeta(dir[volumeLen:]) {
		return glob(dir, file, nil)
	}

	// Prevent infinite recursion. See issue 15879.
	if dir == pattern {
		return nil, ErrBadPattern
	}

	var m [][]byte
	m, err = globWithLimit(dir, depth+1)
	if err != nil {
		return
	}
	for _, d := range m {
		matches, err = glob(d, file, matches)
		if err != nil {
			return
		}
	}
	return
}

// cleanGlobPath prepares path for glob matching.
func cleanGlobPath(path []byte) (out []byte) {
	switch path {
	case "":
		return "."
	case []byte{byte(Separator)}:
		// do nothing to the path
		return path
	default:
		return path[0 : len(path)-1] // chop off trailing separator
	}
}

// glob searches for files matching pattern in the directory dir
// and appends them to matches. If the directory cannot be
// opened, it returns the existing matches. New matches are
// added in lexicographical order.
func glob(dir, pattern []byte, matches [][]byte) (m [][]byte, e error) {
	m = matches
	fi, err := os.Stat(dir)
	if err != nil {
		return // ignore I/O error
	}
	if !fi.IsDir() {
		return // ignore I/O error
	}
	d, err := os.Open(dir)
	if err != nil {
		return // ignore I/O error
	}
	defer d.Close()

	names, _ := d.Readdirnames(-1)
	for i := int32(1); i < len(names); i++ {
		for j := i; j > 0 && names[j] < names[j-1]; j-- {
			names[j], names[j-1] = names[j-1], names[j]
		}
	}

	for _, n := range names {
		matched, merr := Match(pattern, n)
		if merr != nil {
			return m, merr
		}
		if matched {
			m = mxutil.Ensure(m, 1)
			m = push(m, Join(dir, n))
		}
	}
	return
}

// hasMeta reports whether path contains any of the magic characters
// recognized by Match.
func hasMeta(path []byte) (ok bool) {
	return bytes.ContainsAny(path, `*?[\`)
}

func init() {
	ErrBadPattern = stdpath.ErrBadPattern
	SkipDir = fs.SkipDir
	SkipAll = fs.SkipAll
}
