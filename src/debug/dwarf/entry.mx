// DWARF debug information entry parser.
// An entry is a sequence of data items of a given format.
// The first word in the entry is an index into what DWARF
// calls the ``abbreviation table.''  An abbreviation is really
// just a type descriptor: it's an array of attribute tag/value format pairs.

package dwarf

import (
	"moxielang.dev/pkg/mxutil"
	"encoding/binary"
	"errors"
	"fmt"
	"strconv"
)

// a single entry's description: a sequence of attributes
type abbrev struct {
	tag      Tag
	children bool
	field    []afield
}

type afield struct {
	attr  Attr
	fmt   format
	class Class
	val   int64 // for formImplicitConst
}


// parseAbbrev returns the abbreviation table that starts at byte off
// in the .debug_abbrev section.
func (d *Data) parseAbbrev(off uint64, vers int32) (_r0 map[uint32]abbrev, _r1 error) {
	if cached, ok := d.abbrevCache[off]; ok {
		return cached, nil
	}

	data := d.abbrev
	if off > uint64(len(data)) {
		data = nil
	} else {
		data = data[off:]
	}
	b := makeBuf(d, &unknownFormat{}, "abbrev", 0, data)

	// Error handling is simplified by the buf getters
	// returning an endless stream of 0s after an error.
	//
	// The loop scratch is declared once, outside the loop: this is a
	// self-mutating method (it stores into d.abbrevCache), and a declaration in
	// a loop body in one is rejected - the allocation would land in the
	// sovereign arena on every iteration.
	m := map[uint32]abbrev{}
	var id uint32
	var n int32
	var b1 buf
	var tag, fm uint64
	var a abbrev
	var i int32
	for {
		// Table ends with id == 0.
		id = uint32(b.uint32())
		if id == 0 {
			break
		}

		// Walk over attributes, counting.
		n = 0
		b1 = b // Read from copy of b.
		b1.uintVar()
		b1.uint8()
		for {
			tag = b1.uintVar()
			fm = b1.uintVar()
			if tag == 0 && fm == 0 {
				break
			}
			if format(fm) == formImplicitConst {
				b1.int32()
			}
			n++
		}
		if b1.err != nil {
			return nil, b1.err
		}

		// Walk over attributes again, this time writing them down.
		a = abbrev{}
		a.tag = Tag(b.uintVar())
		a.children = b.uint8() != 0
		a.field = []afield{:n}
		for i = 0; i < int32(len(a.field)); i++ {
			a.field[i].attr = Attr(b.uintVar())
			a.field[i].fmt = format(b.uintVar())
			a.field[i].class = formToClass(a.field[i].fmt, a.field[i].attr, vers, &b)
			if a.field[i].fmt == formImplicitConst {
				a.field[i].val = b.int32()
			}
		}
		b.uintVar()
		b.uintVar()

		m[id] = a
	}
	if b.err != nil {
		return nil, b.err
	}
	d.abbrevCache[off] = m
	return m, nil
}

// attrIsExprloc indicates attributes that allow exprloc values that
// are encoded as block values in DWARF 2 and 3. See DWARF 4, Figure
// 20.
func _attrIsExprloc() (_r0 map[Attr]bool) { return map[Attr]bool{
	AttrLocation:      true,
	AttrByteSize:      true,
	AttrBitOffset:     true,
	AttrBitSize:       true,
	AttrStringLength:  true,
	AttrLowerBound:    true,
	AttrReturnAddr:    true,
	AttrStrideSize:    true,
	AttrUpperBound:    true,
	AttrCount:         true,
	AttrDataMemberLoc: true,
	AttrFrameBase:     true,
	AttrSegment:       true,
	AttrStaticLink:    true,
	AttrUseLocation:   true,
	AttrVtableElemLoc: true,
	AttrAllocated:     true,
	AttrAssociated:    true,
	AttrDataLocation:  true,
	AttrStride:        true,
} }

// attrPtrClass indicates the *ptr class of attributes that have
// encoding formSecOffset in DWARF 4 or formData* in DWARF 2 and 3.
func _attrPtrClass() (_r0 map[Attr]Class) { return map[Attr]Class{
	AttrLocation:      ClassLocListPtr,
	AttrStmtList:      ClassLinePtr,
	AttrStringLength:  ClassLocListPtr,
	AttrReturnAddr:    ClassLocListPtr,
	AttrStartScope:    ClassRangeListPtr,
	AttrDataMemberLoc: ClassLocListPtr,
	AttrFrameBase:     ClassLocListPtr,
	AttrMacroInfo:     ClassMacPtr,
	AttrSegment:       ClassLocListPtr,
	AttrStaticLink:    ClassLocListPtr,
	AttrUseLocation:   ClassLocListPtr,
	AttrVtableElemLoc: ClassLocListPtr,
	AttrRanges:        ClassRangeListPtr,
	// The following are new in DWARF 5.
	AttrStrOffsetsBase: ClassStrOffsetsPtr,
	AttrAddrBase:       ClassAddrPtr,
	AttrRnglistsBase:   ClassRngListsPtr,
	AttrLoclistsBase:   ClassLocListPtr,
} }

// formToClass returns the DWARF 4 Class for the given form. If the
// DWARF version is less then 4, it will disambiguate some forms
// depending on the attribute.
func formToClass(form format, attr Attr, vers int32, b *buf) (_r0 Class) {
	aie := _attrIsExprloc()
	apc := _attrPtrClass()
	switch form {
	default:
		b.error("cannot determine class of unknown attribute form")
		return 0

	case formIndirect:
		return ClassUnknown

	case formAddr, formAddrx, formAddrx1, formAddrx2, formAddrx3, formAddrx4:
		return ClassAddress

	case formDwarfBlock1, formDwarfBlock2, formDwarfBlock4, formDwarfBlock:
		// In DWARF 2 and 3, ClassExprLoc was encoded as a
		// block. DWARF 4 distinguishes ClassBlock and
		// ClassExprLoc, but there are no attributes that can
		// be both, so we also promote ClassBlock values in
		// DWARF 4 that should be ClassExprLoc in case
		// producers get this wrong.
		if aie[attr] {
			return ClassExprLoc
		}
		return ClassBlock

	case formData1, formData2, formData4, formData8, formSdata, formUdata, formData16, formImplicitConst:
		// In DWARF 2 and 3, ClassPtr was encoded as a
		// constant. Unlike ClassExprLoc/ClassBlock, some
		// DWARF 4 attributes need to distinguish Class*Ptr
		// from ClassConstant, so we only do this promotion
		// for versions 2 and 3.
		if class, ok := apc[attr]; vers < 4 && ok {
			return class
		}
		return ClassConstant

	case formFlag, formFlagPresent:
		return ClassFlag

	case formRefAddr, formRef1, formRef2, formRef4, formRef8, formRefUdata, formRefSup4, formRefSup8:
		return ClassReference

	case formRefSig8:
		return ClassReferenceSig

	case formString, formStrp, formStrx, formStrpSup, formLineStrp, formStrx1, formStrx2, formStrx3, formStrx4:
		return ClassString

	case formSecOffset:
		// DWARF 4 defines four *ptr classes, but doesn't
		// distinguish them in the encoding. Disambiguate
		// these classes using the attribute.
		if class, ok := apc[attr]; ok {
			return class
		}
		return ClassUnknown

	case formExprloc:
		return ClassExprLoc

	case formGnuRefAlt:
		return ClassReferenceAlt

	case formGnuStrpAlt:
		return ClassStringAlt

	case formLoclistx:
		return ClassLocList

	case formRnglistx:
		return ClassRngList
	}
}

// An entry is a sequence of attribute/value pairs.
type Entry struct {
	Offset   Offset // offset of Entry in DWARF info
	Tag      Tag    // tag (kind of Entry)
	Children bool   // whether Entry is followed by children
	Field    []Field
}

// A Field is a single attribute/value pair in an [Entry].
//
// A value can be one of several "attribute classes" defined by DWARF.
// The Go types corresponding to each class are:
//
//	DWARF class       Go type        Class
//	-----------       -------        -----
//	address           uint64         ClassAddress
//	block             []byte         ClassBlock
//	constant          int64          ClassConstant
//	flag              bool           ClassFlag
//	reference
//	  to info         dwarf.Offset   ClassReference
//	  to type unit    uint64         ClassReferenceSig
//	string            string         ClassString
//	exprloc           []byte         ClassExprLoc
//	lineptr           int64          ClassLinePtr
//	loclistptr        int64          ClassLocListPtr
//	macptr            int64          ClassMacPtr
//	rangelistptr      int64          ClassRangeListPtr
//
// For unrecognized or vendor-defined attributes, [Class] may be
// [ClassUnknown].
// fieldValue is a decoded DWARF attribute value: one of address, block,
// constant, flag, reference, or string. The concrete types are enumerated as
// named wrappers implementing the marker.
type fieldValue interface {
	isFieldValue()
}

type valUint64 uint64

func (*valUint64) isFieldValue() {}

type valBytes struct {
	b []byte
}

func (*valBytes) isFieldValue() {}

type valInt64 int64

func (*valInt64) isFieldValue() {}

type valBool bool

func (*valBool) isFieldValue() {}

type valOffset Offset

func (*valOffset) isFieldValue() {}

type valStr struct {
	b []byte
}

func (*valStr) isFieldValue() {}

// valInt unwraps a valInt64 field value.
func valInt(v fieldValue) (out int64, ok bool) {
	if t, isInt := v.(*valInt64); isInt {
		return int64(*t), true
	}
	return 0, false
}

// valUint unwraps a valUint64 field value.
func valUint(v fieldValue) (out uint64, ok bool) {
	if t, isUint := v.(*valUint64); isUint {
		return uint64(*t), true
	}
	return 0, false
}

// valOff unwraps a valOffset field value.
func valOff(v fieldValue) (out Offset, ok bool) {
	if t, isOff := v.(*valOffset); isOff {
		return Offset(*t), true
	}
	return 0, false
}

// valString unwraps a valStr field value.
func valString(v fieldValue) (out []byte, ok bool) {
	if t, isStr := v.(*valStr); isStr {
		return t.b, true
	}
	return nil, false
}

type Field struct {
	Attr  Attr
	Val   fieldValue
	Class Class
}

// A Class is the DWARF 4 class of an attribute value.
//
// In general, a given attribute's value may take on one of several
// possible classes defined by DWARF, each of which leads to a
// slightly different interpretation of the attribute.
//
// DWARF version 4 distinguishes attribute value classes more finely
// than previous versions of DWARF. The reader will disambiguate
// coarser classes from earlier versions of DWARF into the appropriate
// DWARF 4 class. For example, DWARF 2 uses "constant" for constants
// as well as all types of section offsets, but the reader will
// canonicalize attributes in DWARF 2 files that refer to section
// offsets to one of the Class*Ptr classes, even though these classes
// were only defined in DWARF 3.
type Class int32

const (
	// ClassUnknown represents values of unknown DWARF class.
	ClassUnknown Class = iota

	// ClassAddress represents values of type uint64 that are
	// addresses on the target machine.
	ClassAddress

	// ClassBlock represents values of type []byte whose
	// interpretation depends on the attribute.
	ClassBlock

	// ClassConstant represents values of type int64 that are
	// constants. The interpretation of this constant depends on
	// the attribute.
	ClassConstant

	// ClassExprLoc represents values of type []byte that contain
	// an encoded DWARF expression or location description.
	ClassExprLoc

	// ClassFlag represents values of type bool.
	ClassFlag

	// ClassLinePtr represents values that are an int64 offset
	// into the "line" section.
	ClassLinePtr

	// ClassLocListPtr represents values that are an int64 offset
	// into the "loclist" section.
	ClassLocListPtr

	// ClassMacPtr represents values that are an int64 offset into
	// the "mac" section.
	ClassMacPtr

	// ClassRangeListPtr represents values that are an int64 offset into
	// the "rangelist" section.
	ClassRangeListPtr

	// ClassReference represents values that are an Offset offset
	// of an Entry in the info section (for use with Reader.Seek).
	// The DWARF specification combines ClassReference and
	// ClassReferenceSig into class "reference".
	ClassReference

	// ClassReferenceSig represents values that are a uint64 type
	// signature referencing a type Entry.
	ClassReferenceSig

	// ClassString represents values that are strings. If the
	// compilation unit specifies the AttrUseUTF8 flag (strongly
	// recommended), the string value will be encoded in UTF-8.
	// Otherwise, the encoding is unspecified.
	ClassString

	// ClassReferenceAlt represents values of type int64 that are
	// an offset into the DWARF "info" section of an alternate
	// object file.
	ClassReferenceAlt

	// ClassStringAlt represents values of type int64 that are an
	// offset into the DWARF string section of an alternate object
	// file.
	ClassStringAlt

	// ClassAddrPtr represents values that are an int64 offset
	// into the "addr" section.
	ClassAddrPtr

	// ClassLocList represents values that are an int64 offset
	// into the "loclists" section.
	ClassLocList

	// ClassRngList represents values that are a uint64 offset
	// from the base of the "rnglists" section.
	ClassRngList

	// ClassRngListsPtr represents values that are an int64 offset
	// into the "rnglists" section. These are used as the base for
	// ClassRngList values.
	ClassRngListsPtr

	// ClassStrOffsetsPtr represents values that are an int64
	// offset into the "str_offsets" section.
	ClassStrOffsetsPtr
)

//:generate stringer -type=Class

func (i *Class) GoString() (_r0 string) {
	return "dwarf." + i.String()
}

// Val returns the value associated with attribute [Attr] in [Entry],
// or nil if there is no such attribute.
//
// A common idiom is to merge the check for nil return with
// the check that the value has the expected dynamic type, as in:
//
//	v, ok := valInt(e.Val(AttrSibling))
func (e *Entry) Val(a Attr) (_r0 fieldValue) {
	if f := e.AttrField(a); f != nil {
		return f.Val
	}
	return nil
}

// AttrField returns the [Field] associated with attribute [Attr] in
// [Entry], or nil if there is no such attribute.
func (e *Entry) AttrField(a Attr) (_r0 *Field) {
	for i, f := range e.Field {
		if f.Attr == a {
			return &e.Field[i]
		}
	}
	return nil
}

// An Offset represents the location of an [Entry] within the DWARF info.
// (See [Reader.Seek].)
type Offset uint32

// resolveStrx reads a DW_FORM_strx indirect string offset and returns the
// resolved string. Errors are recorded on b.
func (b *buf) resolveStrx(strBase, stroff uint64) (sval []byte) {
	stroff += strBase
	if uint64(int32(stroff)) != stroff {
		b.error("DW_FORM_strx offset out of range")
	}

	b1 := makeBuf(b.dwarf, b.format, "str_offsets", 0, b.dwarf.strOffsets)
	b1.skip(int32(stroff))
	c64, _ := b.format.dwarf64()
	if c64 {
		stroff = b1.uint64()
	} else {
		stroff = uint64(b1.uint32())
	}
	if b1.err != nil {
		b.err = b1.err
		return ""
	}
	if uint64(int32(stroff)) != stroff {
		b.error("DW_FORM_strx indirect offset out of range")
	}
	b1 = makeBuf(b.dwarf, b.format, "str", 0, b.dwarf.str)
	b1.skip(int32(stroff))
	sval = b1.string()
	if b1.err != nil {
		b.err = b1.err
	}
	return sval
}

// resolveRnglistx reads a DW_FORM_rnglistx indirect range-list offset and
// returns the resolved offset. Errors are recorded on b.
func (b *buf) resolveRnglistx(rnglistsBase, rngoff uint64) (out uint64) {
	d64, _ := b.format.dwarf64()
	if d64 {
		rngoff *= 8
	} else {
		rngoff *= 4
	}
	rngoff += rnglistsBase
	if uint64(int32(rngoff)) != rngoff {
		b.error("DW_FORM_rnglistx offset out of range")
	}

	b1 := makeBuf(b.dwarf, b.format, "rnglists", 0, b.dwarf.rngLists)
	b1.skip(int32(rngoff))
	if d64 {
		rngoff = b1.uint64()
	} else {
		rngoff = uint64(b1.uint32())
	}
	if b1.err != nil {
		b.err = b1.err
		return 0
	}
	if uint64(int32(rngoff)) != rngoff {
		b.error("DW_FORM_rnglistx indirect offset out of range")
	}
	return rnglistsBase + rngoff
}

// Entry reads a single entry from buf, decoding
// according to the given abbreviation table.
func (b *buf) entry(cu *Entry, u *unit) (_r0 *Entry) {
	atab, ubase, vers := u.atable, u.base, u.vers
	off := b.off
	id := uint32(b.uint32())
	if id == 0 {
		return &Entry{}
	}
	a, ok := atab[id]
	if !ok {
		b.error("unknown abbreviation table index")
		return nil
	}
	e := &Entry{
		Offset:   off,
		Tag:      a.tag,
		Children: a.children,
		Field:    []Field{:len(a.field)},
	}

	// Declared once, outside the loop: declarations in a loop in a
	// self-mutating method are rejected, and the scratch would otherwise be
	// allocated into the sovereign arena on every iteration.
	var fm format
	var val fieldValue
	var aoff uint64
	var addr uint64
	var addrBase int64
	var err error
	var fvers int32
	var is64 bool
	var known bool
	var soff uint64
	var sbuf buf
	var uStrBase int64
	var loff uint64
	var uRngBase int64

	for i := range e.Field {
		e.Field[i].Attr = a.field[i].attr
		e.Field[i].Class = a.field[i].class
		fm = a.field[i].fmt
		if fm == formIndirect {
			fm = format(b.uintVar())
			e.Field[i].Class = formToClass(fm, a.field[i].attr, vers, b)
		}
		switch fm {
		default:
			b.error("unknown entry attr format 0x" + strconv.FormatInt(int64(fm), 16))

		// address
		case formAddr:
			val = &valUint64(b.addr())
		case formAddrx, formAddrx1, formAddrx2, formAddrx3, formAddrx4:
			switch fm {
			case formAddrx:
				aoff = uint64(b.uint32())
			case formAddrx1:
				aoff = uint64(b.uint8())
			case formAddrx2:
				aoff = uint64(b.uint16())
			case formAddrx3:
				aoff = uint64(b.uint24())
			case formAddrx4:
				aoff = uint64(b.uint32())
			}
			if b.dwarf.addr == nil {
				b.error("DW_FORM_addrx with no .debug_addr section")
			}
			if b.err != nil {
				return nil
			}

			addrBase = int64(u.addrBase())
			addr, err = b.dwarf.debugAddr(b.format, uint64(addrBase), aoff)
			if err != nil {
				if b.err == nil {
					b.err = err
				}
				return nil
			}
			// debugAddr resolves the address to a plain uint64, and a
			// fieldValue is only satisfied by the wrapper types (valUint64 and
			// friends), so the value is wrapped like every other integer form.
			val = &valUint64(addr)

		// block
		case formDwarfBlock1:
			val = &valBytes{b.bytes(int32(b.uint8()))}
		case formDwarfBlock2:
			val = &valBytes{b.bytes(int32(b.uint16()))}
		case formDwarfBlock4:
			val = &valBytes{b.bytes(int32(b.uint32()))}
		case formDwarfBlock:
			val = &valBytes{b.bytes(int32(b.uint32()))}
		// constant
		case formData1:
			val = &valInt64(int64(b.uint8()))
		case formData2:
			val = &valInt64(int64(b.uint16()))
		case formData4:
			val = &valInt64(int64(b.uint32()))
		case formData8:
			val = &valInt64(int64(b.uint64()))
		case formData16:
			val = &valBytes{b.bytes(16)}
		case formSdata:
			val = &valInt64(int64(b.int32()))
		case formUdata:
			val = &valInt64(int64(b.uintVar()))
		case formImplicitConst:
			val = &valInt64(a.field[i].val)

		// flag
		case formFlag:
			val = &valBool(b.uint8() == 1)
		// New in DWARF 4.
		case formFlagPresent:
			// The attribute is implicitly indicated as present, and no value is
			// encoded in the debugging information entry itself.
			val = &valBool(true)

		// reference to other entry
		case formRefAddr:
			fvers = b.format.version()
			if fvers == 0 {
				b.error("unknown version for DW_FORM_ref_addr")
			} else if fvers == 2 {
				val = &valOffset(Offset(b.addr()))
			} else {
				is64, known = b.format.dwarf64()
				if !known {
					b.error("unknown size for DW_FORM_ref_addr")
				} else if is64 {
					val = &valOffset(Offset(b.uint64()))
				} else {
					val = &valOffset(Offset(b.uint32()))
				}
			}
		case formRef1:
			val = &valOffset(Offset(b.uint8()) + ubase)
		case formRef2:
			val = &valOffset(Offset(b.uint16()) + ubase)
		case formRef4:
			val = &valOffset(Offset(b.uint32()) + ubase)
		case formRef8:
			val = &valOffset(Offset(b.uint64()) + ubase)
		case formRefUdata:
			val = &valOffset(Offset(b.uint32()) + ubase)

		// string
		case formString:
			val = &valStr{b.string()}
		case formStrp, formLineStrp:
			// soff is an offset into .debug_str
			is64, known = b.format.dwarf64()
			if !known {
				b.error("unknown size for DW_FORM_strp/line_strp")
			} else if is64 {
				soff = b.uint64()
			} else {
				soff = uint64(b.uint32())
			}
			if uint64(int32(soff)) != soff {
				b.error("DW_FORM_strp/line_strp offset out of range")
			}
			if b.err != nil {
				return nil
			}
			if fm == formStrp {
				sbuf = makeBuf(b.dwarf, b.format, "str", 0, b.dwarf.str)
			} else {
				if len(b.dwarf.lineStr) == 0 {
					b.error("DW_FORM_line_strp with no .debug_line_str section")
					return nil
				}
				sbuf = makeBuf(b.dwarf, b.format, "line_str", 0, b.dwarf.lineStr)
			}
			sbuf.skip(int32(soff))
			val = &valStr{sbuf.string()}
			if sbuf.err != nil {
				b.err = sbuf.err
				return nil
			}
		case formStrx, formStrx1, formStrx2, formStrx3, formStrx4:
			switch fm {
			case formStrx:
				soff = b.uintVar()
			case formStrx1:
				soff = uint64(b.uint8())
			case formStrx2:
				soff = uint64(b.uint16())
			case formStrx3:
				soff = uint64(b.uint24())
			case formStrx4:
				soff = uint64(b.uint32())
			}
			if len(b.dwarf.strOffsets) == 0 {
				b.error("DW_FORM_strx with no .debug_str_offsets section")
			}
			is64, known = b.format.dwarf64()
			if !known {
				b.error("unknown offset size for DW_FORM_strx")
			}
			if b.err != nil {
				return nil
			}
			if is64 {
				soff *= 8
			} else {
				soff *= 4
			}

			uStrBase = int64(u.strOffsetsBase())
			val = &valStr{b.resolveStrx(uint64(uStrBase), soff)}
		case formStrpSup:
			is64, known = b.format.dwarf64()
			if !known {
				b.error("unknown size for DW_FORM_strp_sup")
			} else if is64 {
				val = &valInt64(int64(b.uint64()))
			} else {
				val = &valInt64(int64(b.uint32()))
			}

		// lineptr, loclistptr, macptr, rangelistptr
		// New in DWARF 4, but clang can generate them with -gdwarf-2.
		// Section reference, replacing use of formData4 and formData8.
		case formSecOffset, formGnuRefAlt, formGnuStrpAlt:
			is64, known = b.format.dwarf64()
			if !known {
				b.error("unknown size for form 0x" + strconv.FormatInt(int64(fm), 16))
			} else if is64 {
				val = &valInt64(int64(b.uint64()))
			} else {
				val = &valInt64(int64(b.uint32()))
			}

		// exprloc
		// New in DWARF 4.
		case formExprloc:
			val = &valBytes{b.bytes(int32(b.uint32()))}
		// reference
		// New in DWARF 4.
		case formRefSig8:
			// 64-bit type signature.
			val = &valUint64(b.uint64())
		case formRefSup4:
			val = &valUint64(b.uint32())
		case formRefSup8:
			val = &valUint64(b.uint64())

		// loclist
		case formLoclistx:
			val = &valInt64(int64(b.uintVar()))

		// rnglist
		case formRnglistx:
			loff = b.uintVar()

			uRngBase = int64(u.rngListsBase())
			val = &valUint64(b.resolveRnglistx(uint64(uRngBase), uint64(loff)))
		}

		e.Field[i].Val = val
	}
	if b.err != nil {
		return nil
	}
	return e
}

// A Reader allows reading [Entry] structures from a DWARF "info" section.
// The [Entry] structures are arranged in a tree. The [Reader.Next] function
// return successive entries from a pre-order traversal of the tree.
// If an entry has children, its Children field will be true, and the children
// follow, terminated by an [Entry] with [Tag] 0.
type Reader struct {
	b            buf
	d            *Data
	err          error
	unit         int32
	lastUnit     bool   // set if last entry returned by Next is TagCompileUnit/TagPartialUnit
	lastChildren bool   // .Children of last entry returned by Next
	lastSibling  Offset // .Val(AttrSibling) of last entry returned by Next
	cu           *Entry // current compilation unit
}

// Reader returns a new Reader for [Data].
// The reader is positioned at byte offset 0 in the DWARF "info" section.
func (d *Data) Reader() (_r0 *Reader) {
	r := &Reader{d: d}
	r.Seek(0)
	return r
}

// AddressSize returns the size in bytes of addresses in the current compilation
// unit.
func (r *Reader) AddressSize() (_r0 int32) {
	return r.d.unit[r.unit].asize
}

// ByteOrder returns the byte order in the current compilation unit.
func (r *Reader) ByteOrder() (_r0 binary.ByteOrder) {
	return r.b.order
}

// Seek positions the [Reader] at offset off in the encoded entry stream.
// Offset 0 can be used to denote the first entry.
func (r *Reader) Seek(off Offset) {
	d := r.d
	r.err = nil
	r.lastChildren = false
	if off == 0 {
		if len(d.unit) == 0 {
			return
		}
		u0 := &d.unit[0]
		r.unit = 0
		r.b = makeBuf(r.d, u0, "info", u0.off, u0.data)
		r.collectDwarf5BaseOffsets(u0)
		r.cu = nil
		return
	}

	i := d.offsetToUnit(off)
	if i == -1 {
		r.err = errors.New("offset out of range")
		return
	}
	if i != r.unit {
		r.cu = nil
	}
	u := &d.unit[i]
	r.unit = i
	r.b = makeBuf(r.d, u, "info", off, u.data[off-u.off:])
	r.collectDwarf5BaseOffsets(u)
}

// maybeNextUnit advances to the next unit if this one is finished.
func (r *Reader) maybeNextUnit() {
	for len(r.b.data) == 0 && r.unit+1 < len(r.d.unit) {
		r.nextUnit()
	}
}

// nextUnit advances to the next unit.
func (r *Reader) nextUnit() {
	r.unit++
	u := &r.d.unit[r.unit]
	r.b = makeBuf(r.d, u, "info", u.off, u.data)
	r.cu = nil
	r.collectDwarf5BaseOffsets(u)
}

func (r *Reader) collectDwarf5BaseOffsets(u *unit) {
	if u.vers < 5 || u.unit5 != nil {
		return
	}
	u.unit5 = &unit5{}
	if err := r.d.collectDwarf5BaseOffsets(u); err != nil {
		r.err = err
	}
}

// Next reads the next entry from the encoded entry stream.
// It returns nil, nil when it reaches the end of the section.
// It returns an error if the current offset is invalid or the data at the
// offset cannot be decoded as a valid [Entry].
func (r *Reader) Next() (_r0 *Entry, _r1 error) {
	if r.err != nil {
		return nil, r.err
	}
	r.maybeNextUnit()
	if len(r.b.data) == 0 {
		return nil, nil
	}
	u := &r.d.unit[r.unit]
	e := r.b.entry(r.cu, u)
	if r.b.err != nil {
		r.err = r.b.err
		return nil, r.err
	}
	r.lastUnit = false
	if e != nil {
		r.lastChildren = e.Children
		if r.lastChildren {
			if off, ok := e.Val(AttrSibling).(*valOffset); ok {
				r.lastSibling = Offset(*off)
			}
		}
		if e.Tag == TagCompileUnit || e.Tag == TagPartialUnit {
			r.lastUnit = true
			r.cu = e
		}
	} else {
		r.lastChildren = false
	}
	return e, nil
}

// SkipChildren skips over the child entries associated with
// the last [Entry] returned by [Reader.Next]. If that [Entry] did not have
// children or [Reader.Next] has not been called, SkipChildren is a no-op.
func (r *Reader) SkipChildren() {
	if r.err != nil || !r.lastChildren {
		return
	}

	// If the last entry had a sibling attribute,
	// that attribute gives the offset of the next
	// sibling, so we can avoid decoding the
	// child subtrees.
	if r.lastSibling >= r.b.off {
		r.Seek(r.lastSibling)
		return
	}

	if r.lastUnit && r.unit+1 < len(r.d.unit) {
		r.nextUnit()
		return
	}

	for {
		e, err := r.Next()
		if err != nil || e == nil || e.Tag == 0 {
			break
		}
		if e.Children {
			r.SkipChildren()
		}
	}
}

// clone returns a copy of the reader. This is used by the typeReader
// interface.
func (r *Reader) clone() (_r0 typeReader) {
	return r.d.Reader()
}

// offset returns the current buffer offset. This is used by the
// typeReader interface.
func (r *Reader) offset() (_r0 Offset) {
	return r.b.off
}

// SeekPC returns the [Entry] for the compilation unit that includes pc,
// and positions the reader to read the children of that unit.  If pc
// is not covered by any unit, SeekPC returns [ErrUnknownPC] and the
// position of the reader is undefined.
//
// Because compilation units can describe multiple regions of the
// executable, in the worst case SeekPC must search through all the
// ranges in all the compilation units. Each call to SeekPC starts the
// search at the compilation unit of the last call, so in general
// looking up a series of PCs will be faster if they are sorted. If
// the caller wishes to do repeated fast PC lookups, it should build
// an appropriate index using the Ranges method.
func (r *Reader) SeekPC(pc uint64) (_r0 *Entry, _r1 error) {
	uidx := r.unit
	// Declared once, outside the loop: declarations in a loop in a
	// self-mutating method are rejected, and the scratch would otherwise be
	// allocated into the sovereign arena on every iteration.
	var u *unit
	var e *Entry
	var err error
	var ranges [][]uint64
	for i := 0; i < len(r.d.unit); i++ {
		if uidx >= len(r.d.unit) {
			uidx = 0
		}
		r.err = nil
		r.lastChildren = false
		r.unit = uidx
		r.cu = nil
		u = &r.d.unit[uidx]
		r.b = makeBuf(r.d, u, "info", u.off, u.data)
		r.collectDwarf5BaseOffsets(u)
		e, err = r.Next()
		if err != nil {
			return nil, err
		}
		if e == nil || e.Tag == 0 {
			return nil, ErrUnknownPC
		}
		ranges, err = r.d.Ranges(e)
		if err != nil {
			return nil, err
		}
		for _, pcs := range ranges {
			if pcs[0] <= pc && pc < pcs[1] {
				return e, nil
			}
		}
		uidx++
	}
	return nil, ErrUnknownPC
}

// Ranges returns the PC ranges covered by e, a slice of [low,high) pairs.
// Only some entry types, such as [TagCompileUnit] or [TagSubprogram], have PC
// ranges; for others, this will return nil with no error.
func (d *Data) Ranges(e *Entry) (_r0 [][]uint64, _r1 error) {
	var ret [][]uint64

	low, lowOK := e.Val(AttrLowpc).(*valUint64)
	var lowv uint64
	if lowOK {
		lowv = uint64(*low)
	}

	var high uint64
	var highOK bool
	highField := e.AttrField(AttrHighpc)
	if highField != nil {
		switch highField.Class {
		case ClassAddress:
			hv, hvOK := highField.Val.(*valUint64)
			if hvOK {
				high = uint64(*hv)
				highOK = true
			}
		case ClassConstant:
			off, ok := highField.Val.(*valInt64)
			if ok {
				high = lowv + uint64(*off)
				highOK = true
			}
		}
	}

	if lowOK && highOK {
		ret = mxutil.Ensure(ret, 1)
		ret = push(ret, []uint64{lowv, high})
	}

	var u *unit
	if uidx := d.offsetToUnit(e.Offset); uidx >= 0 && uidx < len(d.unit) {
		u = &d.unit[uidx]
	}

	if u != nil && u.vers >= 5 && d.rngLists != nil {
		// DWARF version 5 and later
		field := e.AttrField(AttrRanges)
		if field == nil {
			return ret, nil
		}
		switch field.Class {
		case ClassRangeListPtr:
			rngOff, rngOK := valInt(field.Val)
			if !rngOK {
				return ret, nil
			}
			cu, base, err := d.baseAddressForEntry(e)
			if err != nil {
				return nil, err
			}
			return d.dwarf5Ranges(u, cu, base, rngOff, ret)

		case ClassRngList:
			rnglist, ok := valUint(field.Val)
			if !ok {
				return ret, nil
			}
			cu, base, err := d.baseAddressForEntry(e)
			if err != nil {
				return nil, err
			}
			return d.dwarf5Ranges(u, cu, base, int64(rnglist), ret)

		default:
			return ret, nil
		}
	}

	// DWARF version 2 through 4
	ranges, rangesOK := e.Val(AttrRanges).(*valInt64)
	if rangesOK && d.ranges != nil {
		_, base, err := d.baseAddressForEntry(e)
		if err != nil {
			return nil, err
		}
		return d.dwarf2Ranges(u, base, int64(*ranges), ret)
	}

	return ret, nil
}

// baseAddressForEntry returns the initial base address to be used when
// looking up the range list of entry e.
// DWARF specifies that this should be the lowpc attribute of the enclosing
// compilation unit, however comments in gdb/dwarf2read.c say that some
// versions of GCC use the entrypc attribute, so we check that too.
func (d *Data) baseAddressForEntry(e *Entry) (_r0 *Entry, _r1 uint64, _r2 error) {
	var cu *Entry
	if e.Tag == TagCompileUnit {
		cu = e
	} else {
		i := d.offsetToUnit(e.Offset)
		if i == -1 {
			return nil, 0, errors.New("no unit for entry")
		}
		u := &d.unit[i]
		b := makeBuf(d, u, "info", u.off, u.data)
		cu = b.entry(nil, u)
		if b.err != nil {
			return nil, 0, b.err
		}
	}

	if cuEntry, cuEntryOK := cu.Val(AttrEntrypc).(*valUint64); cuEntryOK {
		return cu, uint64(*cuEntry), nil
	} else if cuLow, cuLowOK := cu.Val(AttrLowpc).(*valUint64); cuLowOK {
		return cu, uint64(*cuLow), nil
	}

	return cu, 0, nil
}

func (d *Data) dwarf2Ranges(u *unit, base uint64, ranges int64, ret [][]uint64) (_r0 [][]uint64, _r1 error) {
	if ranges < 0 || ranges > int64(len(d.ranges)) {
		return nil, fmt.Errorf("invalid range offset %d (max %d)", ranges, len(d.ranges))
	}
	rb := makeBuf(d, u, "ranges", Offset(ranges), d.ranges[ranges:])
	for len(rb.data) > 0 {
		low := rb.addr()
		high := rb.addr()

		if low == 0 && high == 0 {
			break
		}

		if low == ^uint64(0)>>uint32((8-u.addrsize())*8) {
			base = high
		} else {
			ret = mxutil.Ensure(ret, 1)
			ret = push(ret, []uint64{base + low, base + high})
		}
	}

	return ret, nil
}

// dwarf5Ranges interprets a debug_rnglists sequence, see DWARFv5 section
// 2.17.3 (page 53).
func (d *Data) dwarf5Ranges(u *unit, cu *Entry, base uint64, ranges int64, ret [][]uint64) (_r0 [][]uint64, _r1 error) {
	if ranges < 0 || ranges > int64(len(d.rngLists)) {
		return nil, fmt.Errorf("invalid rnglist offset %d (max %d)", ranges, len(d.ranges))
	}
	var addrBase int64
	if cu != nil {
		if okv, okok := cu.Val(AttrAddrBase).(*valInt64); okok {
			addrBase = int64(*okv)
		}
	}

	rb := makeBuf(d, u, "rnglists", 0, d.rngLists)
	rb.skip(int32(ranges))
	for {
		opcode := rb.uint8()
		switch opcode {
		case rleEndOfList:
			if rb.err != nil {
				return nil, rb.err
			}
			return ret, nil

		case rleBaseAddressx:
			baseIdx := rb.uintVar()
			var err error
			base, err = d.debugAddr(u, uint64(addrBase), uint64(baseIdx))
			if err != nil {
				return nil, err
			}

		case rleStartxEndx:
			startIdx := rb.uintVar()
			endIdx := rb.uintVar()

			start, err := d.debugAddr(u, uint64(addrBase), uint64(startIdx))
			if err != nil {
				return nil, err
			}
			end, err := d.debugAddr(u, uint64(addrBase), uint64(endIdx))
			if err != nil {
				return nil, err
			}
			ret = mxutil.Ensure(ret, 1)
			ret = push(ret, []uint64{start, end})

		case rleStartxLength:
			startIdx := rb.uintVar()
			ln := rb.uintVar()
			start, err := d.debugAddr(u, uint64(addrBase), uint64(startIdx))
			if err != nil {
				return nil, err
			}
			ret = mxutil.Ensure(ret, 1)
			ret = push(ret, []uint64{start, start + uint64(ln)})

		case rleOffsetPair:
			off1 := rb.uintVar()
			off2 := rb.uintVar()
			ret = mxutil.Ensure(ret, 1)
			ret = push(ret, []uint64{base + uint64(off1), base + uint64(off2)})

		case rleBaseAddress:
			base = rb.addr()

		case rleStartEnd:
			start := rb.addr()
			end := rb.addr()
			ret = mxutil.Ensure(ret, 1)
			ret = push(ret, []uint64{start, end})

		case rleStartLength:
			start := rb.addr()
			ln := rb.uintVar()
			ret = mxutil.Ensure(ret, 1)
			ret = push(ret, []uint64{start, start + uint64(ln)})
		}
	}
}

// debugAddr returns the address at idx in debug_addr
func (d *Data) debugAddr(df dataFormat, addrBase, idx uint64) (_r0 uint64, _r1 error) {
	off := idx*uint64(df.addrsize()) + addrBase

	if uint64(int32(off)) != off {
		return 0, errors.New("offset out of range")
	}

	b := makeBuf(d, df, "addr", 0, d.addr)
	b.skip(int32(off))
	val := b.addr()
	if b.err != nil {
		return 0, b.err
	}
	return val, nil
}
