// Package buildinfo provides access to information embedded in a Go binary
// about how it was built. This includes the Go toolchain version, and the
// set of modules used (for binaries built in module mode).
//
// Build information is available for the currently running binary in
// runtime/debug.ReadBuildInfo.
package buildinfo

import (
	"github.com/moxie-language/toolchain/pkg/mxutil"
	"bytes"
	"debug/elf"
	"encoding/binary"
	"errors"
	"fmt"
	"internal/saferio"
	"io"
	"io/fs"
	"os"
	"runtime/debug"
	"strconv"
)

// Type alias for build info. We cannot move the types here, since
// runtime/debug would need to import this package, which would make it
// a much larger dependency.
type BuildInfo = debug.BuildInfo

// errUnrecognizedFormat is returned when a given executable file doesn't
// appear to be in a known format, or it breaks the rules of that format,
// or when there are I/O errors reading the file.
var errUnrecognizedFormat error

// errNotGoExe is returned when a given executable file is valid but does
// not contain Go build information.
//
// errNotGoExe should be an internal detail,
// but widely used packages access it using linkname.
// Notable members of the hall of shame include:
//   - github.com/quay/claircore
//
// Do not remove or change the type signature.
// See go.dev/issue/67401.
//
//:linkname errNotGoExe
var errNotGoExe error

// The build info blob left by the linker is identified by a 32-byte header,
// consisting of buildInfoMagic (14 bytes), followed by version-dependent
// fields.
const buildInfoMagic = "\xff Go buildinf:"

const (
	buildInfoAlign      = 16
	buildInfoHeaderSize = 32
)

// wrapReadFileErr annotates a build-info read error with the file name.
func wrapReadFileErr(name string, err error) (out error) {
	if _, ok := err.(*fs.PathError); ok {
		return fmt.Errorf("could not read Go build info: %w", err)
	}
	if err != nil {
		return fmt.Errorf("could not read Go build info from %s: %w", name, err)
	}
	return nil
}

// ReadFile returns build information embedded in a Go binary
// file at the given path. Most information is only available for binaries built
// with module support.
func ReadFile(name string) (info *BuildInfo, err error) {
	f, err := os.Open(name)
	if err != nil {
		return nil, wrapReadFileErr(name, err)
	}
	defer f.Close()
	info, err = Read(f)
	if err != nil {
		return nil, wrapReadFileErr(name, err)
	}
	return info, nil
}

// Read returns build information embedded in a Go binary file
// accessed through the given ReaderAt. Most information is only available for
// binaries built with module support.
func Read(r io.ReaderAt) (_r0 *BuildInfo, _r1 error) {
	vers, mod, err := readRawBuildInfo(r)
	if err != nil {
		return nil, err
	}
	bi, err := parseBuildInfo(mod)
	if err != nil {
		return nil, err
	}
	bi.GoVersion = vers
	return bi, nil
}

type exe interface {
	// DataStart returns the virtual address and size of the segment or section that
	// should contain build information. This is either a specially named section
	// or the first writable non-zero data segment.
	DataStart() (uint64, uint64)

	// DataReader returns an io.ReaderAt that reads from addr until the end
	// of segment or section that contains addr.
	DataReader(addr uint64) (io.ReaderAt, error)
}

// readRawBuildInfo extracts the Go toolchain version and module information
// strings from a Go binary. On success, vers should be non-empty. mod
// is empty if the binary was not built with modules enabled.
func readRawBuildInfo(r io.ReaderAt) (vers, mod string, err error) {
	// Read the first bytes of the file to identify the format, then delegate to
	// a format-specific function to load segment and section headers.
	ident := []byte{:16}
	if n, rerr := r.ReadAt(ident, 0); n < len(ident) || rerr != nil {
		return "", "", errUnrecognizedFormat
	}

	var x exe
	if !bytes.HasPrefix(ident, []byte("\x7FELF")) {
		return "", "", errUnrecognizedFormat
	}
	f, err := elf.NewFile(r)
	if err != nil {
		return "", "", errUnrecognizedFormat
	}
	x = &elfExe{f}

	// Read segment or section to find the build info blob.
	// On some platforms, the blob will be in its own section, and DataStart
	// returns the address of that section. On others, it's somewhere in the
	// data segment; the linker puts it near the beginning.
	// See cmd/link/internal/ld.Link.buildinfo.
	dataAddr, dataSize := x.DataStart()
	if dataSize == 0 {
		return "", "", errNotGoExe
	}

	addr, err := searchMagic(x, dataAddr, dataSize)
	if err != nil {
		return "", "", err
	}

	// Read in the full header first.
	header, err := readData(x, addr, buildInfoHeaderSize)
	if err == io.EOF {
		return "", "", errNotGoExe
	} else if err != nil {
		return "", "", err
	}
	if len(header) < buildInfoHeaderSize {
		return "", "", errNotGoExe
	}

	const (
		ptrSizeOffset = 14
		flagsOffset   = 15
		versPtrOffset = 16

		flagsEndianMask   = 0x1
		flagsEndianLittle = 0x0
		flagsEndianBig    = 0x1

		flagsVersionMask = 0x2
		flagsVersionPtr  = 0x0
		flagsVersionInl  = 0x2
	)

	// Decode the blob. The blob is a 32-byte header, optionally followed
	// by 2 varint-prefixed string contents.
	//
	// type buildInfoHeader struct {
	// 	magic       [14]byte
	// 	ptrSize     uint8 // used if flagsVersionPtr
	// 	flags       uint8
	// 	versPtr     targetUintptr // used if flagsVersionPtr
	// 	modPtr      targetUintptr // used if flagsVersionPtr
	// }
	//
	// The version bit of the flags field determines the details of the format.
	//
	// Prior to 1.18, the flags version bit is flagsVersionPtr. In this
	// case, the header includes pointers to the version and modinfo Go
	// strings in the header. The ptrSize field indicates the size of the
	// pointers and the endian bit of the flag indicates the pointer
	// endianness.
	//
	// Since 1.18, the flags version bit is flagsVersionInl. In this case,
	// the header is followed by the string contents inline as
	// length-prefixed (as varint) string contents. First is the version
	// string, followed immediately by the modinfo string.
	flags := header[flagsOffset]
	if flags&flagsVersionMask == flagsVersionInl {
		vers, addr, err = decodeString(x, addr+buildInfoHeaderSize)
		if err != nil {
			return "", "", err
		}
		mod, _, err = decodeString(x, addr)
		if err != nil {
			return "", "", err
		}
	} else {
		// flagsVersionPtr (<1.18)
		ptrSize := int32(header[ptrSizeOffset])
		bigEndian := flags&flagsEndianMask == flagsEndianBig
		var bo binary.ByteOrder
		if bigEndian {
			bo = binary.BigEndian()
		} else {
			bo = binary.LittleEndian()
		}
		if ptrSize != 4 && ptrSize != 8 {
			return "", "", errNotGoExe
		}
		vers = readString(x, ptrSize, bo, readPtrAt(bo, ptrSize, header[versPtrOffset:]))
		mod = readString(x, ptrSize, bo, readPtrAt(bo, ptrSize, header[versPtrOffset+ptrSize:]))
	}
	if vers == "" {
		return "", "", errNotGoExe
	}
	if len(mod) >= 33 && mod[len(mod)-17] == '\n' {
		// Strip module framing: sentinel strings delimiting the module info.
		// These are cmd/go/internal/modload.infoStart and infoEnd.
		mod = mod[16 : len(mod)-16]
	} else {
		mod = ""
	}

	return vers, mod, nil
}

func decodeString(x exe, addr uint64) (_r0 string, _r1 uint64, _r2 error) {
	// varint length followed by length bytes of data.

	// N.B. ReadData reads _up to_ size bytes from the section containing
	// addr. So we don't need to check that size doesn't overflow the
	// section.
	b, err := readData(x, addr, binary.MaxVarintLen64)
	if err == io.EOF {
		return "", 0, errNotGoExe
	} else if err != nil {
		return "", 0, err
	}

	length, n := binary.Uvarint(b)
	if n <= 0 {
		return "", 0, errNotGoExe
	}
	addr += uint64(n)

	b, err = readData(x, addr, length)
	if err == io.EOF {
		return "", 0, errNotGoExe
	} else if err == io.ErrUnexpectedEOF {
		// Length too large to allocate. Clearly bogus value.
		return "", 0, errNotGoExe
	} else if err != nil {
		return "", 0, err
	}
	if uint64(len(b)) < length {
		// Section ended before we could read the full string.
		return "", 0, errNotGoExe
	}

	return string(b), addr + length, nil
}

// readPtrAt reads a pointer of ptrSize bytes from b using byte order bo.
func readPtrAt(bo binary.ByteOrder, ptrSize int32, b []byte) (out uint64) {
	if ptrSize == 4 {
		return uint64(bo.Uint32(b))
	}
	return bo.Uint64(b)
}

// readString returns the string at address addr in the executable x.
func readString(x exe, ptrSize int32, bo binary.ByteOrder, addr uint64) (_r0 string) {
	hdr, err := readData(x, addr, uint64(2*ptrSize))
	if err != nil || len(hdr) < 2*ptrSize {
		return ""
	}
	dataAddr := readPtrAt(bo, ptrSize, hdr)
	dataLen := readPtrAt(bo, ptrSize, hdr[ptrSize:])
	data, err := readData(x, dataAddr, dataLen)
	if err != nil || uint64(len(data)) < dataLen {
		return ""
	}
	return string(data)
}

const searchChunkSize = 1 << 20 // 1 MB

// searchMagic returns the aligned first instance of buildInfoMagic in the data
// range [addr, addr+size). Returns false if not found.
func searchMagic(x exe, start, size uint64) (_r0 uint64, _r1 error) {
	end := start + size
	if end < start {
		// Overflow.
		return 0, errUnrecognizedFormat
	}

	// Round up start; magic can't occur in the initial unaligned portion.
	start = (start + buildInfoAlign - 1) &^ (buildInfoAlign - 1)
	if start >= end {
		return 0, errNotGoExe
	}

	var buf []byte
	for start < end {
		// Read in chunks to avoid consuming too much memory if data is large.
		//
		// Normally it would be somewhat painful to handle the magic crossing a
		// chunk boundary, but since it must be 16-byte aligned we know it will
		// fall within a single chunk.
		remaining := end - start
		chunkSize := uint64(searchChunkSize)
		if chunkSize > remaining {
			chunkSize = remaining
		}

		if buf == nil {
			buf = []byte{:chunkSize}
		} else {
			// N.B. chunkSize can only decrease, and only on the
			// last chunk.
			buf = resize(buf, chunkSize)
			clear(buf)
		}

		n, err := readDataInto(x, start, buf)
		if err == io.EOF {
			// EOF before finding the magic; must not be a Go executable.
			return 0, errNotGoExe
		} else if err != nil {
			return 0, err
		}

		data := buf[:n]
		for len(data) > 0 {
			i := bytes.Index(data, buildInfoMagic)
			if i < 0 {
				break
			}
			if remaining-uint64(i) < buildInfoHeaderSize {
				// Found magic, but not enough space left for the full header.
				return 0, errNotGoExe
			}
			if i%buildInfoAlign != 0 {
				// Found magic, but misaligned. Keep searching.
				next := (i + buildInfoAlign - 1) &^ (buildInfoAlign - 1)
				if next > len(data) {
					// Corrupt object file: the remaining
					// count says there is more data,
					// but we didn't read it.
					return 0, errNotGoExe
				}
				data = data[next:]
				continue
			}
			// Good match!
			return start + uint64(i), nil
		}

		start += chunkSize
	}

	return 0, errNotGoExe
}

func readData(x exe, addr, size uint64) (_r0 []byte, _r1 error) {
	r, err := x.DataReader(addr)
	if err != nil {
		return nil, err
	}

	b, err := saferio.ReadDataAt(r, size, 0)
	if len(b) > 0 && err == io.EOF {
		err = nil
	}
	return b, err
}

func readDataInto(x exe, addr uint64, b []byte) (_r0 int32, _r1 error) {
	r, err := x.DataReader(addr)
	if err != nil {
		return 0, err
	}

	n, err := r.ReadAt(b, 0)
	if n > 0 && err == io.EOF {
		err = nil
	}
	return n, err
}

// elfExe is the ELF implementation of the exe interface.
type elfExe struct {
	f *elf.File
}

func (x *elfExe) DataReader(addr uint64) (_r0 io.ReaderAt, _r1 error) {
	for _, prog := range x.f.Progs {
		if prog.Vaddr <= addr && addr <= prog.Vaddr+prog.Filesz-1 {
			remaining := prog.Vaddr + prog.Filesz - addr
			return io.NewSectionReader(prog, int64(addr-prog.Vaddr), int64(remaining)), nil
		}
	}
	return nil, errUnrecognizedFormat
}

func (x *elfExe) DataStart() (_r0 uint64, _r1 uint64) {
	for _, s := range x.f.Sections {
		if s.Name == ".go.buildinfo" {
			return s.Addr, s.Size
		}
	}
	for _, p := range x.f.Progs {
		if p.Type == elf.PT_LOAD && p.Flags&(elf.PF_X|elf.PF_W) == elf.PF_W {
			return p.Vaddr, p.Memsz
		}
	}
	return 0, 0
}

func init() {
	errUnrecognizedFormat = errors.New("unrecognized file format")
	errNotGoExe = errors.New("not a Go executable")
}

// parseBuildInfo parses the string returned by [*BuildInfo.String],
// restoring the original [BuildInfo], except that the GoVersion field is
// not set. Ported from runtime/debug.ParseBuildInfo.
func parseBuildInfo(data string) (bi *BuildInfo, perr error) {
	const (
		pathLine  = "path\t"
		modLine   = "mod\t"
		depLine   = "dep\t"
		repLine   = "=>\t"
		buildLine = "build\t"
		newline   = "\n"
		tab       = "\t"
	)

	bi = &BuildInfo{}
	lineNum := int32(1)
	var last *debug.Module
	var line []byte
	var ok bool
	for len(data) > 0 {
		line, data, ok = bytes.Cut(data, newline)
		if !ok {
			break
		}
		switch {
		case bytes.HasPrefix(line, pathLine):
			bi.Path = line[len(pathLine):]
		case bytes.HasPrefix(line, modLine):
			elem := bytes.Split(line[len(modLine):], tab)
			m, merr := biReadModuleLine(elem)
			if merr != nil {
				return nil, biParseErr(lineNum, merr)
			}
			bi.Main = m
			last = &bi.Main
		case bytes.HasPrefix(line, depLine):
			elem := bytes.Split(line[len(depLine):], tab)
			m, merr := biReadModuleLine(elem)
			if merr != nil {
				return nil, biParseErr(lineNum, merr)
			}
			bi.Deps = mxutil.Ensure(bi.Deps, 1)
			bi.Deps = push(bi.Deps, &m)
			last = bi.Deps[len(bi.Deps)-1]
		case bytes.HasPrefix(line, repLine):
			elem := bytes.Split(line[len(repLine):], tab)
			if len(elem) != 3 {
				return nil, biParseErr(lineNum, fmt.Errorf("expected 3 columns for replacement; got %d", len(elem)))
			}
			if last == nil {
				return nil, biParseErr(lineNum, errors.New("replacement with no module on previous line"))
			}
			last.Replace = &debug.Module{
				Path:    elem[0],
				Version: elem[1],
				Sum:     elem[2],
			}
			last = nil
		case bytes.HasPrefix(line, buildLine):
			kv := line[len(buildLine):]
			if len(kv) < 1 {
				return nil, biParseErr(lineNum, errors.New("build line missing '='"))
			}

			var key []byte
			var rawValue []byte
			switch kv[0] {
			case '=':
				return nil, biParseErr(lineNum, errors.New("build line with missing key"))
			case '`', '"':
				rawKey, kerr := strconv.QuotedPrefix(kv)
				if kerr != nil {
					return nil, biParseErr(lineNum, errors.New("invalid quoted key in build line"))
				}
				if len(kv) == len(rawKey) {
					return nil, biParseErr(lineNum, errors.New("build line missing '=' after quoted key"))
				}
				if c := kv[len(rawKey)]; c != '=' {
					return nil, biParseErr(lineNum, fmt.Errorf("unexpected character after quoted key: %q", c))
				}
				key, _ = strconv.Unquote(rawKey)
				rawValue = kv[len(rawKey)+1:]
			default:
				var cutOK bool
				key, rawValue, cutOK = bytes.Cut(kv, "=")
				if !cutOK {
					return nil, biParseErr(lineNum, errors.New("build line missing '=' after key"))
				}
				if biQuoteKey(key) {
					return nil, biParseErr(lineNum, fmt.Errorf("unquoted key %q must be quoted", key))
				}
			}

			var value []byte
			if len(rawValue) > 0 {
				switch rawValue[0] {
				case '`', '"':
					uv, uerr := strconv.Unquote(rawValue)
					if uerr != nil {
						return nil, biParseErr(lineNum, errors.New("invalid quoted value in build line"))
					}
					value = uv
				default:
					value = rawValue
					if biQuoteValue(value) {
						return nil, biParseErr(lineNum, fmt.Errorf("unquoted value %q must be quoted", value))
					}
				}
			}

			bi.Settings = mxutil.Ensure(bi.Settings, 1)
			bi.Settings = push(bi.Settings, debug.BuildSetting{Key: key, Value: value})
		}
		lineNum++
	}
	return bi, nil
}

// biReadModuleLine parses one "mod" or "dep" line's fields.
func biReadModuleLine(elem [][]byte) (m debug.Module, rerr error) {
	if len(elem) != 2 && len(elem) != 3 {
		return debug.Module{}, fmt.Errorf("expected 2 or 3 columns; got %d", len(elem))
	}
	m.Path = elem[0]
	m.Version = elem[1]
	if len(elem) == 3 {
		m.Sum = elem[2]
	}
	return m, nil
}

// biParseErr wraps a parse error with its line number.
func biParseErr(lineNum int32, err error) (out error) {
	return fmt.Errorf("could not parse Go build info: line %d: %w", lineNum, err)
}

// biQuoteKey reports whether key is required to be quoted.
func biQuoteKey(key []byte) (out bool) {
	return len(key) == 0 || bytes.ContainsAny(key, "= \t\r\n\"`")
}

// biQuoteValue reports whether value is required to be quoted.
func biQuoteValue(value []byte) (out bool) {
	return bytes.ContainsAny(value, " \t\r\n\"`")
}
