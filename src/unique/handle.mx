// Package unique implements the upstream Go unique package for Moxie.
//
// It is not a full implementation: while it should behave the same way, it
// doesn't free unreferenced uniqued objects.
package unique

import (
	"unsafe"
)

// handleMapIface is implemented by every type-specific handle map wrapper.
// The global map is keyed by the type descriptor (unsafe.TypeOf of the value),
// so each instantiated type gets its own map - the find-or-create-map
// operation keyed by type identity.
type handleMapIface interface {
	handleMapIface()
}

// handleMap wraps the per-type map so it can be stored behind the marker
// interface. T is monomorphized per instantiation, so handleMap[T] is a
// distinct type for every T.
type handleMap[T comparable] struct {
	m map[T]Handle[T]
}

func (h *handleMap[T]) handleMapIface() {}

// globalMapStore is the per-type handle-map registry. It is a sovereign
// self-mutating holder: the package-level value itself is only read, and every
// write goes through a pointer-receiver method, so it is never stored to
// outside init.
type globalMapStore struct {
	m map[unsafe.Pointer]handleMapIface
}

var (
	// We use a two-level map because that way it's easier to store and retrieve
	// values.
	globalMaps globalMapStore
)

func (g *globalMapStore) ensure() {
	if g.m == nil {
		g.m = map[unsafe.Pointer]handleMapIface{}
	}
}

func (g *globalMapStore) get(typeptr unsafe.Pointer) (hm handleMapIface, ok bool) {
	hm, ok = g.m[typeptr]
	return
}

func (g *globalMapStore) set(typeptr unsafe.Pointer, hm handleMapIface) {
	g.m[typeptr] = hm
}

// Unique handle for the given value. Comparing two handles is cheap.
type Handle[T comparable] struct {
	value *T
}

// Value returns a shallow copy of the T value that produced the Handle.
func (h *Handle[T]) Value() (out T) {
	return *h.value
}

// Make a new unqique handle for the given value.
func Make[T comparable](value T) (out Handle[T]) {
	// Very simple implementation of the unique package. This is much, *much*
	// simpler than the upstream implementation. Sadly it's not possible to
	// reuse the upstream version because it relies on implementation details of
	// the upstream runtime.
	// It probably isn't as efficient as the upstream version, but the first
	// goal here is compatibility. If the performance is a problem, it can be
	// optimized later.

	// The map isn't initialized at program startup (and after a test run), so
	// create it.
	globalMaps.ensure()

	// Find or create the per-type map, keyed by the type descriptor.
	typeptr := unsafe.TypeOf(value)
	var hm handleMap[T]
	if typeSpecificMapValue, ok := globalMaps.get(typeptr); ok {
		hm = typeSpecificMapValue.(handleMap[T])
	} else {
		hm.m = map[T]Handle[T]{}
		globalMaps.set(typeptr, hm)
	}

	// Retrieve the handle for the value, creating it if it isn't created yet.
	var handle Handle[T]
	if h, ok := hm.m[value]; !ok {
		var clone T = value
		handle.value = &clone
		hm.m[value] = handle
	} else {
		handle = h
	}

	out = handle
	return
}
