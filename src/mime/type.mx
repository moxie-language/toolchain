// Package mime implements parts of the MIME spec.
package mime

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"bytes"
	"fmt"
)

var (
	mimeTypes      map[string][]byte   // ".Z" => "application/x-compress"
	mimeTypesLower map[string][]byte   // ".z" => "application/x-compress"

	// extensions maps from MIME type to list of lowercase file
	// extensions: "image/jpeg" => [".jpg", ".jpeg"]
	extensions map[string][][]byte // slice values are append-only.
)

// setMimeTypes is used by initMime's non-test path, and by tests.
func setMimeTypes(lowerExt, mixExt map[string][]byte) {
	if mimeTypes == nil {
		mimeTypes = map[string][]byte{}
		mimeTypesLower = map[string][]byte{}
		extensions = map[string][][]byte{}
	}
	for k := range mimeTypes {
		delete(mimeTypes, k)
	}
	for k := range mimeTypesLower {
		delete(mimeTypesLower, k)
	}
	for k := range extensions {
		delete(extensions, k)
	}

	for k, v := range lowerExt {
		mimeTypesLower[k] = v
	}
	for k, v := range mixExt {
		mimeTypes[k] = v
	}

	for k, v := range lowerExt {
		justType, _, err := ParseMediaType(v)
		if err != nil {
			panic(err.Error())
		}
		extensions[justType] = push(extensions[justType], k)
	}
}

func _builtinTypesLower() map[string][]byte {
	return map[string][]byte{
		".avif": "image/avif",
		".css":  "text/css; charset=utf-8",
		".gif":  "image/gif",
		".htm":  "text/html; charset=utf-8",
		".html": "text/html; charset=utf-8",
		".jpeg": "image/jpeg",
		".jpg":  "image/jpeg",
		".js":   "text/javascript; charset=utf-8",
		".json": "application/json",
		".mjs":  "text/javascript; charset=utf-8",
		".pdf":  "application/pdf",
		".png":  "image/png",
		".svg":  "image/svg+xml",
		".wasm": "application/wasm",
		".webp": "image/webp",
		".xml":  "text/xml; charset=utf-8",
	}
}

var mimeInited bool

func initMime() {
	b := _builtinTypesLower()
	setMimeTypes(b, b)
	osInitMime()
}

// TypeByExtension returns the MIME type associated with the file extension ext.
// The extension ext should begin with a leading dot, as in ".html".
// When ext has no associated type, TypeByExtension returns "".
//
// Extensions are looked up first case-sensitively, then case-insensitively.
//
// The built-in table is small but on unix it is augmented by the local
// system's MIME-info database or mime.types file(s) if available under one or
// more of these names:
//
//	/usr/local/share/mime/globs2
//	/usr/share/mime/globs2
//	/etc/mime.types
//	/etc/apache2/mime.types
//	/etc/apache/mime.types
//
// On Windows, MIME types are extracted from the registry.
//
// Text types have the charset parameter set to "utf-8" by default.
func TypeByExtension(ext []byte) []byte {
	if !mimeInited {
		mimeInited = true
		initMime()
	}

	// Case-sensitive lookup.
	if v, ok := mimeTypes[string(ext)]; ok {
		return v
	}

	// Case-insensitive lookup.
	// Optimistically assume a short ASCII extension and be
	// allocation-free in that case.
	var buf [10]byte
	lower := buf[:0]
	const utf8RuneSelf = 0x80 // from utf8 package, but not importing it.
	for i := 0; i < len(ext); i++ {
		c := ext[i]
		if c >= utf8RuneSelf {
			// Slow path.
			return mimeTypesLower[string(bytes.ToLower(ext))]
		}
		if 'A' <= c && c <= 'Z' {
			if len(lower) >= cap(lower) { lower = mxutil.GrowCap(lower) }
			lower = push(lower, c+('a'-'A'))
		} else {
			if len(lower) >= cap(lower) { lower = mxutil.GrowCap(lower) }
			lower = push(lower, c)
		}
	}
	return mimeTypesLower[string(lower)]
}

// ExtensionsByType returns the extensions known to be associated with the MIME
// type typ. The returned extensions will each begin with a leading dot, as in
// ".html". When typ has no associated extensions, ExtensionsByType returns an
// nil slice.
func ExtensionsByType(typ []byte) ([][]byte, error) {
	justType, _, err := ParseMediaType(typ)
	if err != nil {
		return nil, err
	}

	if !mimeInited {
		mimeInited = true
		initMime()
	}
	s, ok := extensions[justType]
	if !ok {
		return nil, nil
	}
	ret := push([][]byte(nil), s...)
	for i := 1; i < len(ret); i++ {
		for j := i; j > 0 && bytes.Compare(ret[j], ret[j-1]) < 0; j-- {
			ret[j], ret[j-1] = ret[j-1], ret[j]
		}
	}
	return ret, nil
}

// AddExtensionType sets the MIME type associated with
// the extension ext to typ. The extension should begin with
// a leading dot, as in ".html".
func AddExtensionType(ext, typ []byte) error {
	if !bytes.HasPrefix(ext, ".") {
		return fmt.Errorf("mime: extension %q missing leading dot", ext)
	}
	if !mimeInited {
		mimeInited = true
		initMime()
	}
	return setExtensionType(ext, typ)
}

func setExtensionType(extension, mimeType []byte) error {
	justType, param, err := ParseMediaType(mimeType)
	if err != nil {
		return err
	}
	if bytes.HasPrefix(mimeType, "text/") && param["charset"] == "" {
		param["charset"] = "utf-8"
		mimeType = FormatMediaType(mimeType, param)
	}
	extLower := bytes.ToLower(extension)

	mimeTypes[string(extension)] = mimeType
	mimeTypesLower[string(extLower)] = mimeType

	exts := extensions[justType]
	for _, v := range exts {
		if v == extLower {
			return nil
		}
	}
	extensions[justType] = push(exts, extLower)
	return nil
}
