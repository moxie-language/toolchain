// Package mime implements parts of the MIME spec.
package mime

import (
	"git.smesh.lol/moxie/pkg/mxutil"
	"bytes"
	"fmt"
)

// mimeTypesStore owns the MIME type tables. It is a self-mutating value so the
// runtime extension registration writes go through its methods rather than
// storing into package globals outside init.
type mimeTypesStore struct {
	// types maps ".Z" => "application/x-compress".
	types map[string][]byte
	// typesLower maps ".z" => "application/x-compress".
	typesLower map[string][]byte
	// extensions maps "image/jpeg" => [".jpg", ".jpeg"].
	extensions map[string][][]byte
	inited     bool
}

var mimeStore *mimeTypesStore

// setTypes is used by init's non-test path, and by tests.
func (m *mimeTypesStore) setTypes(lowerExt, mixExt map[string][]byte) {
	if m.types == nil {
		m.types = map[string][]byte{}
		m.typesLower = map[string][]byte{}
		m.extensions = map[string][][]byte{}
	}
	for k := range m.types {
		delete(m.types, k)
	}
	for k := range m.typesLower {
		delete(m.typesLower, k)
	}
	for k := range m.extensions {
		delete(m.extensions, k)
	}

	for k, v := range lowerExt {
		m.typesLower[k] = v
	}
	for k, v := range mixExt {
		m.types[k] = v
	}

	var justType []byte
	var perr error
	for k, v := range lowerExt {
		justType, _, perr = ParseMediaType(v)
		if perr != nil {
			panic(perr.Error())
		}
		m.extensions[justType] = push(m.extensions[justType], k)
	}
}

func _builtinTypesLower() (rm map[string][]byte) {
	return map[string][]byte{
		".avif": "image/avif",
		".css":  "text/css; charset=utf-8",
		".gif":  "image/gif",
		".htm":  "text/html; charset=utf-8",
		".html": "text/html; charset=utf-8",
		".jpeg": "image/jpeg",
		".jpg":  "image/jpeg",
		".js":   "text/javascript; charset=utf-8",
		".json": "application/json",
		".mjs":  "text/javascript; charset=utf-8",
		".pdf":  "application/pdf",
		".png":  "image/png",
		".svg":  "image/svg+xml",
		".wasm": "application/wasm",
		".webp": "image/webp",
		".xml":  "text/xml; charset=utf-8",
	}
}

func (m *mimeTypesStore) init() {
	b := _builtinTypesLower()
	m.setTypes(b, b)
	osInitMime(m)
}

// TypeByExtension returns the MIME type associated with the file extension ext.
// The extension ext should begin with a leading dot, as in ".html".
// When ext has no associated type, TypeByExtension returns "".
//
// Extensions are looked up first case-sensitively, then case-insensitively.
//
// The built-in table is small but on unix it is augmented by the local
// system's MIME-info database or mime.types file(s) if available under one or
// more of these names:
//
//	/usr/local/share/mime/globs2
//	/usr/share/mime/globs2
//	/etc/mime.types
//	/etc/apache2/mime.types
//	/etc/apache/mime.types
//
// On Windows, MIME types are extracted from the registry.
//
// Text types have the charset parameter set to "utf-8" by default.
func TypeByExtension(ext []byte) (rb []byte) {
	m := mimeStore
	if !m.inited {
		m.inited = true
		m.init()
	}

	// Case-sensitive lookup.
	if v, ok := m.types[string(ext)]; ok {
		return v
	}

	// Case-insensitive lookup.
	// Optimistically assume a short ASCII extension and be
	// allocation-free in that case.
	var buf [10]byte
	lower := buf[:0]
	const utf8RuneSelf = 0x80 // from utf8 package, but not importing it.
	for i := 0; i < len(ext); i++ {
		c := ext[i]
		if c >= utf8RuneSelf {
			// Slow path.
			return m.typesLower[string(bytes.ToLower(ext))]
		}
		if 'A' <= c && c <= 'Z' {
			lower = mxutil.Ensure(lower, 1)
			lower = push(lower, c+('a'-'A'))
		} else {
			lower = mxutil.Ensure(lower, 1)
			lower = push(lower, c)
		}
	}
	return m.typesLower[string(lower)]
}

// ExtensionsByType returns the extensions known to be associated with the MIME
// type typ. The returned extensions will each begin with a leading dot, as in
// ".html". When typ has no associated extensions, ExtensionsByType returns an
// nil slice.
func ExtensionsByType(typ []byte) (rbyte [][]byte, rerr error) {
	justType, _, err := ParseMediaType(typ)
	if err != nil {
		return nil, err
	}

	m := mimeStore
	if !m.inited {
		m.inited = true
		m.init()
	}
	s, ok := m.extensions[justType]
	if !ok {
		return nil, nil
	}
	ret := push([][]byte(nil), s...)
	for i := 1; i < len(ret); i++ {
		for j := i; j > 0 && bytes.Compare(ret[j], ret[j-1]) < 0; j-- {
			ret[j], ret[j-1] = ret[j-1], ret[j]
		}
	}
	return ret, nil
}

// AddExtensionType sets the MIME type associated with
// the extension ext to typ. The extension should begin with
// a leading dot, as in ".html".
func AddExtensionType(ext, typ []byte) (rerr error) {
	if !bytes.HasPrefix(ext, ".") {
		return fmt.Errorf("mime: extension %q missing leading dot", ext)
	}
	m := mimeStore
	if !m.inited {
		m.inited = true
		m.init()
	}
	return m.setExtensionType(ext, typ)
}

func (m *mimeTypesStore) setExtensionType(extension, mimeType []byte) (rerr error) {
	justType, param, err := ParseMediaType(mimeType)
	if err != nil {
		return err
	}
	if bytes.HasPrefix(mimeType, "text/") && param["charset"] == "" {
		param["charset"] = "utf-8"
		mimeType = FormatMediaType(mimeType, param)
	}
	extLower := bytes.ToLower(extension)

	m.types[string(extension)] = mimeType
	m.typesLower[string(extLower)] = mimeType

	exts := m.extensions[justType]
	for _, v := range exts {
		if v == extLower {
			return nil
		}
	}
	m.extensions[justType] = push(exts, extLower)
	return nil
}
