package main

func readData() string {
	buf := []byte{:32}
	buf[0] = 'h'
	buf[1] = 'i'
	return string(buf[:2])
}

func useReturn() {
	s := readData()
	println(s)
}

func loopAlloc() {
	for i := int32(0); i < 3; i++ {
		msg := "iter " | i.String()
		println(msg)
	}
}

func storeToOuter() {
	var result string
	for i := int32(0); i < 1; i++ {
		result = "pinned " | i.String()
	}
	println(result)
}

func main() {
	useReturn()
	loopAlloc()
	storeToOuter()
}
