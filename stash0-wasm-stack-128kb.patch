+// Moxie: implemented via libc syscall(2) instead of raw assembly.
+func Syscall6(num, a1, a2, a3, a4, a5, a6 uintptr) (r1, r2, errno uintptr) {
+	r := libc_syscall(int32(num), a1, a2, a3, a4, a5, a6)
+	if r < 0 {
+		return 0, 0, uintptr(-r)
+	}
+	return uintptr(r), 0, 0
+}
