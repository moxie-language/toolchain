// A stdlib net/http server for the network smoke phase. The phase starts it,
// connects to it with a foreign client (curl) and with the Moxie client, and
// checks that both saw this handler's body. Before the embedded-interface
// dispatch arm existed, net/http.(*Server).Serve panicked on the first
// connection with "interface dispatch: no impl for Accept (6 impl(s), none
// matches)" because onceCloseListener reaches Accept only by promotion.
package main

import (
	"fmt"
	"net/http"
	"os"
)

func handleRoot(w http.ResponseWriter, r *http.Request) {
	fmt.Fprintf(w, "hello path=%s\n", r.URL.Path)
}

func main() {
	addr := "127.0.0.1:39128"
	if len(os.Args) > 1 {
		addr = os.Args[1]
	}
	fmt.Printf("listening on %s\n", addr)
	err := http.ListenAndServe(addr, nil)
	fmt.Printf("server returned err=%v\n", err)
	os.Exit(1)
}
