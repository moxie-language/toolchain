// A stdlib net/http server for the network smoke phase, on the channel handler
// path: the shell owns the socket and the framing, the handler is a pure
// stream function that receives decoded request messages and sends response
// messages. No closures, no io in the handler, and the router is a plain table
// built at startup.
//
// usage: server [addr] [inline|spawned]
package main

import (
	"fmt"
	"net/http"
	"os"
)

// helloHandler answers every request with the path it was asked for. It reads
// exactly the message the shell offers (head, then body chunks, then end) and
// answers on the head, which is the shape keep-alive relies on.
type helloHandler struct{}

func (h *helloHandler) Serve(in chan http.Msg, out chan http.Msg) {
	m := <-in
	if m.Kind != http.MsgReqHead {
		return
	}
	// The body goes into the buffer the shell offered, by index - a subslice
	// would be a copy - and the reply carries only its length. Nothing the
	// handler allocates in its own frame is handed to the shell.
	n := int32(0)
	n = putInto(m.Scratch, n, "hello path=")
	n = putInto(m.Scratch, n, m.Path)
	n = putInto(m.Scratch, n, "\n")
	out <- http.Msg{Kind: http.MsgRespHead, Status: 200}
	out <- http.Msg{Kind: http.MsgRespBody, Len: n}
	out <- http.Msg{Kind: http.MsgRespEnd}
}

// putInto writes s into dst at off and returns the offset after it.
func putInto(dst []byte, off int32, s string) (n int32) {
	n = off
	for i := 0; i < len(s); i++ {
		dst[n] = s[i]
		n = n + 1
	}
	return n
}

func main() {
	addr := "127.0.0.1:39128"
	mode := "inline"
	if len(os.Args) > 1 {
		addr = os.Args[1]
	}
	if len(os.Args) > 2 {
		mode = os.Args[2]
	}
	dispatch := http.DispatchInline
	if mode == "spawned" {
		dispatch = http.DispatchSpawned
	}
	mux := http.NewChanMux()
	mux.Handle("/", &helloHandler{})
	fmt.Printf("listening on %s mode=%s\n", addr, mode)
	err := http.ChanServeMode(addr, mux, dispatch, 4)
	fmt.Printf("server returned err=%v\n", err)
	os.Exit(1)
}
