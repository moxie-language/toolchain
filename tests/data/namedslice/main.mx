package main

// A named slice type is not allowed: use []T directly. Both compilers reject
// this shape, and it is why []T directly has no methods.
type Names []string

func main() {
	// Termination: a batch program must still be stoppable, so the entry
	// handles the channel the runtime closes on SIGINT/SIGTERM.
	select {
	case <-sigint:
		return
	default:
	}

	var n Names
	println("names:", len(n))
}
