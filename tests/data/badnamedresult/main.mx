package main

// A named result needs parentheses. Without them the parser used to recover by
// swallowing the body, so this function's local `n` landed at package scope and
// the only complaint was "unnamed return values" - for a signature that names
// one. It must fail with the syntax error instead.
func counter() n int32 {
	n = 41
	return
}

func main() {
	// Termination: a batch program must still be stoppable, so the entry
	// handles the channel the runtime closes on SIGINT/SIGTERM.
	select {
	case <-shutdown:
		return
	default:
	}

	println(counter())
}
