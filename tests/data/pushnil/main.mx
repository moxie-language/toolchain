// push needs a slice: the first argument supplies the element type. An untyped
// nil supplies none, and stage4 used to type the call untyped nil, default it
// to int32, and then emit either IR clang refuses (an i32 where a slice header
// belongs) or - in a short declaration - an empty slice with no error at all.
// Legacy rejects it, so this fixture must fail to compile with both compilers.
package main

func main() {
	var b []string
	b = push(nil, "y")
	println("len", len(b))
}
