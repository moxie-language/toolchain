// Package-level float initializers must survive in both compilers.
//
// The legacy interp read a constant float through LLVMConstRealGetDouble.
// That C function returns double in XMM0, but the purego binding read the
// return register RAX, so every package-level float32/float64 initializer
// came out 0 while integers (returned in RAX) survived. stage4 never used
// the binding, so the two compilers disagreed. The shapes below are the
// exact ones that were measured: single and multi-value, both widths, and a
// negative value.
package main

var a1 float64 = 1.5
var b1, b2 float64 = 2.5, -3.5
var e1 float32 = 7.5
var c1 int32 = 4
var d1, d2 int32 = 5, 6

func main() {
	if a1 != 1.5 {
		panic("float64 single initializer")
	}
	if b1 != 2.5 || b2 != -3.5 {
		panic("float64 pair initializer")
	}
	if e1 != 7.5 {
		panic("float32 single initializer")
	}
	if c1 != 4 || d1 != 5 || d2 != 6 {
		panic("int initializer")
	}
	println("ok")
}
