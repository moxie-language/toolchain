package main

// A package-level var carries no initializer: declare the zero value and
// assign it in init(). Both compilers reject this shape.
var counter = 5

func main() {
	// Termination: a batch program must still be stoppable, so the entry
	// handles the channel the runtime closes on SIGINT/SIGTERM.
	select {
	case <-shutdown:
		return
	default:
	}

	println("counter:", counter)
}
