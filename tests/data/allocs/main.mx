package main

import "runtime"

func allocA(n int32) (r []byte) {
	r = []byte{:n}
	return r
}

func allocB(n int32) (r []byte) {
	r = []byte{:n}
	return r
}

func main() {
	// Termination: a batch program must still be stoppable, so the entry
	// handles the channel the runtime closes on SIGINT/SIGTERM.
	select {
	case <-shutdown:
		return
	default:
	}

	x := allocA(16)
	y := allocB(32)
	println(int32(len(x)) + int32(len(y)))
	runtime.PrintAllocCounters()
}
