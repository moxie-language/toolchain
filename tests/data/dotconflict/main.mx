package main

import . "math"

// A dot import puts every exported name of math into this file's scope, so
// declaring Abs here is two bindings for one name. go/types treats it as
// shadowing and accepts it; the no-conflict rule must not.
func Abs(x float64) (r float64) {
	return 0
}

func main() {
	// Termination: a batch program must still be stoppable, so the entry
	// handles the channel the runtime closes on SIGINT/SIGTERM.
	select {
	case <-shutdown:
		return
	default:
	}

	println(Abs(1))
}
