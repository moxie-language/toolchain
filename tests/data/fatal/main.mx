// testing has no recover to unwind a test body, so Fatal/Skip semantics are
// the loud, honest version of Go's:
//
//	FailNow ends the whole run (os.Exit(1)) with a FAIL line - it cannot stop
//	        just this test body, so it stops everything, which is what a
//	        failing suite deserves.
//	SkipNow marks the test skipped and returns; a test that skips must return
//	        right after it. The run continues with the next test.
//	Error marks the test failed and returns; the run continues.
//	A panicking test body is fatal for the run.
//
// What cannot happen any more, and is asserted below: the test body continuing
// past a skip, or the run losing the tests after it.
package main

import "testing"

func TestSkipMarks(t *testing.T) {
	t.Skip("skip worked")
	println("skip: body returns")
}

func TestStillRuns(t *testing.T) {
	println("second-ran")
}

func TestErrorMarks(t *testing.T) {
	t.Error("error worked")
	println("error: body returns")
}

func TestAfterErrorRuns(t *testing.T) {
	println("third-ran")
}

func main() {
	// Termination: a batch program must still be stoppable, so the entry
	// handles the channel the runtime closes on SIGINT/SIGTERM.
	select {
	case <-shutdown:
		return
	default:
	}

	testing.Main([]testing.InternalTest{
		{Name: "TestSkipMarks", F: TestSkipMarks},
		{Name: "TestStillRuns", F: TestStillRuns},
		{Name: "TestErrorMarks", F: TestErrorMarks},
		{Name: "TestAfterErrorRuns", F: TestAfterErrorRuns},
	})
}
