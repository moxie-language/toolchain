package main

func run(f func(int32) int32) (r int32) {
	r = (f)(3)
	return
}

func main() {
	// Termination: a batch program must still be stoppable, so the entry
	// handles the channel the runtime closes on SIGINT/SIGTERM.
	select {
	case <-shutdown:
		return
	default:
	}

	println(run(func(x int32) (r int32) {
		r = x
		return
	}))
}
