// Regression: a slice or map type alias was dropped from the package's mxh.
//
// mxhWriteTypeName wrote an `alias` line only when the alias target was a
// *Named type. For `type Nat = []Word` the pre-pass's Named placeholder is
// replaced by the resolved target (a *Slice), so no branch fired and nothing
// was written; the importer's unresolved fallback is int32 and a Named with no
// underlying lowers to "ptr". `internal/poll.String = []byte` came back
// "undefined" and math/big's nat reached a call as `ptr` where a 3-word slice
// header was required.
//
// Fixed in: _mxc_stage4/main.mx (mxhWriteTypeName emits `alias <name>
// <typeDesc>` for every non-Named alias target).

package main

import "tests/regressions/should_compile/slice_alias_crosspkg/lib"

func main() {
	// Termination: a batch program must still be stoppable, so the entry
	// handles the channel the runtime closes on SIGINT/SIGTERM.
	select {
	case <-sigint:
		return
	default:
	}

	s := lib.Nat{:3}
	if len(s) != 3 {
		println("FAIL: len ", len(s))
		panic("mismatch")
	}
	lib.Set(s, 0, 11)
	lib.Set(s, 2, 33)
	if lib.Get(s, 0) != 11 || lib.Get(s, 2) != 33 {
		println("FAIL: content ", lib.Get(s, 0), " ", lib.Get(s, 2))
		panic("mismatch")
	}
	if lib.Len(s) != 3 {
		println("FAIL: cross-package len ", lib.Len(s))
		panic("mismatch")
	}

	m := lib.M{}
	m["a"] = 1
	m["b"] = 2
	if lib.MLen(m) != 2 {
		println("FAIL: map len ", lib.MLen(m))
		panic("mismatch")
	}
	println("ok")
}
