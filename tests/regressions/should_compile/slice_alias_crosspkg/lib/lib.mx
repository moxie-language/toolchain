package lib

type Word uint32

// An alias to a slice: the mxh writer emitted nothing for it (it only wrote
// `alias` lines when the target was a named type), so the importer lost the
// name and fell back to int32, and a Named with no underlying lowers to "ptr".
type Nat = []Word

// Same for a map target, which failed in name-resolution positions.
type M = map[string]int32

func Len(x Nat) (n int32) {
	return int32(len(x))
}

func Set(x Nat, i int32, v Word) {
	x[i] = v
}

func Get(x Nat, i int32) (v Word) {
	return x[i]
}

func MLen(x M) (n int32) {
	return int32(len(x))
}
