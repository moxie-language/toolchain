// Regression: `var a, b T = x, y` gives each name its own value. stage4 built
// the value list once and stored the first value to every name (a list that
// built to nil left them all zero), which is what broke
// `var pow, sq uint32 = 1, PrimeRK` in bytealg.HashStrBytes: the rolling-hash
// factor came out wrong and bytealg.IndexRabinKarp answered -1 for needles
// that are present, so bytes.Index could miss a present substring.
package main

import "fmt"

func main() {
	var a, b int32 = 3, 4
	if a != 3 || b != 4 {
		panic("int32 pair")
	}
	var pow, sq uint32 = 1, 16777619
	if pow != 1 || sq != 16777619 {
		panic("uint32 pair")
	}
	var f, g float64 = 1.5, 2.5
	if f != 1.5 || g != 2.5 {
		panic("float64 pair")
	}
	var s, t []byte = []byte("x"), []byte("yz")
	if len(s) != 1 || len(t) != 2 {
		panic("slice pair")
	}
	// The same shape inside a loop body, which is where HashStrBytes uses it.
	total := int32(0)
	for k := int32(0); k < 3; k++ {
		var p, q int32 = k, k + 10
		total += p + q
	}
	if total != 3+33 {
		panic("loop pair")
	}
	fmt.Println("ok")
}
