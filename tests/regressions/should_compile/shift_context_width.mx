// A shift whose left operand is an untyped constant takes its type from the
// context, not from the count. `r = 1 << m` with r uint64 is a 64-bit shift;
// stage4 typed it from the uint32 count and shifted at 32 bits, so 1<<52 came
// out as 1<<20 (and the assignment was rejected outright as uint32 to uint64).
// strconv's atofHex has exactly this shape (mantissa = 1 << flt.mantbits,
// mantbits 52 for float64).
package main

func wide(m uint32) (r uint64) {
	r = 1 << m
	return r
}

func narrow(m uint32) (r int32) {
	r = 1 << m
	return r
}

func mixed(m uint32, bias int32) (r int32) {
	r = 1<<m + bias
	return r
}

func main() {
	// Termination: a batch program must still be stoppable, so the entry
	// handles the channel the runtime closes on SIGINT/SIGTERM.
	select {
	case <-sigint:
		return
	default:
	}

	if wide(52) != 4503599627370496 {
		panic("uint64 shift computed at the wrong width")
	}
	if wide(23) != 8388608 {
		panic("uint64 shift by 23 wrong")
	}
	if narrow(10) != 1024 {
		panic("int32 shift wrong")
	}
	if mixed(4, 5) != 21 {
		panic("shift plus int32 sibling wrong")
	}
	println(wide(52))
}
