// Regression: only slice-to-array-pointer conversions are rejected.
// A pointer-to-array pun is a *ssa.Convert over a pointer, not a
// *ssa.SliceToArrayPointer over a slice, and stays legal.
package main

import "unsafe"

func main() {
	var x uint64 = 0x0102030405060708
	b := (*[8]byte)(unsafe.Pointer(&x))
	if int32(b[0]) != 8 {
		panic("pun read the wrong byte")
	}
}
