//:wasmtest skip
// Wasm spawn is REFUSED at build time (both compilers): a spawned domain's
// `closed` breaker result is not threaded into the child, so the body's select
// would receive through a null channel - undefined behaviour that passes any
// test which never delivers, and it exhausted the child's root arena when it
// did run. Natively this program passes: "wasm spawn struct ok 12 14".
// The file stays as the native assertion and the reproduction; when the breaker
// handle is threaded through __spawn_entry, remove the skip and make it run.
package main

type Msg struct {
	N    int32
	Body []byte
}

func worker(in chan Msg, out chan int32) (closed chan struct{}) {
	select {
	case <-closed:
		return closed
	default:
	}
	for i := 0; i < 2; i++ {
		select {
		case <-closed:
			return closed
		case m := <-in:
			out <- m.N + int32(len(m.Body))
		}
	}
	return closed
}

func main() {
	select {
	case <-sigint:
		return
	default:
	}
	in := chan Msg{:2}
	out := chan int32{:2}
	done := spawn(worker, in, out)
	in <- Msg{N: 7, Body: []byte("hello")}
	in <- Msg{N: 9, Body: []byte("world")}
	a := <-out
	b := <-out
	<-done
	if a != 12 || b != 14 {
		panic("wasm spawn struct values wrong")
	}
	println("wasm spawn struct ok", a, b)
}
