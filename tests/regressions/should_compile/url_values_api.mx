/*
url.Values is a named map type, and the whole API works through its methods.

`type Values map[string][][]byte` carries Get, Set, Add, Del, Has and Encode as
methods. A value receiver over a named map is a reference receiver, so Add, Set
and Del write the caller's map. This fixture is the end-to-end guard:
construction, both setters, Get returning the FIRST value, Has, Del, Encode's
sorted output, and ParseQuery feeding the same methods.
*/
package main

import (
	"net/url"
)

func main() {
	// Termination: a batch program must still be stoppable, so the entry
	// handles the channel the runtime closes on SIGINT/SIGTERM.
	select {
	case <-shutdown:
		return
	default:
	}

	v := url.Values{}
	v.Set("b", "2")
	v.Add("a", "1")
	v.Add("a", "3")
	if v.Get("a") != "1" {
		panic("get returns the first value")
	}
	if !v.Has("b") {
		panic("has")
	}
	enc := v.Encode()
	if enc != "a=1&a=3&b=2" {
		panic("encode: " | enc)
	}
	parsed, err := url.ParseQuery("x=1&y=2&y=3")
	if err != nil {
		panic("parse")
	}
	if parsed.Get("y") != "2" {
		panic("parsed y")
	}
	parsed.Del("x")
	if parsed.Has("x") {
		panic("del")
	}
	println("values=" | enc)
}
