/*
net.Buffers is a named slice of runs, and its consuming methods consume.

`type Buffers [][]byte` carries pointer-receiver methods, so Read and WriteTo
see the caller's value and the consumption persists: a slice assigned through a
free function's parameter would not write back. Construction is an ordinary
slice literal, `net.Buffers{...}`, and the runs are reached as elements.

This fixture pins the semantics: WriteTo drains the runs it wrote, and Read
drains whole runs and the consumed part of a partial one, leaving the remainder
in element 0.
*/
package main

import (
	"bytes"
	"net"
)

func main() {
	// Termination: a batch program must still be stoppable, so the entry
	// handles the channel the runtime closes on SIGINT/SIGTERM.
	select {
	case <-sigint:
		return
	default:
	}

	b := net.Buffers{[]byte("ab"), []byte("cd"), []byte("ef")}
	var buf bytes.Buffer
	n, err := b.WriteTo(&buf)
	if err != nil {
		panic("writeto")
	}
	if n != 6 {
		panic("writeto n")
	}
	if buf.String() != "abcdef" {
		panic("out: " | buf.String())
	}
	if len(b) != 0 {
		panic("writeto does not consume")
	}
	c := net.Buffers{[]byte("ab"), []byte("cd")}
	p := []byte{:3}
	rn, rerr := c.Read(p)
	if rerr != nil {
		panic("read err")
	}
	if rn != 3 {
		panic("read n")
	}
	if string(p) != "abc" {
		panic("read: " | string(p))
	}
	if len(c) != 1 || string(c[0]) != "d" {
		panic("remainder")
	}
	println("buffers ok")
}
