// Regression: range over a slice whose element type is from an imported package.
//
// The stage4 type checker produced "WARN: unresolved range type" when
// iterating over a slice whose element type was defined in a different
// package. The unresolved type became nil, causing nil pointer crashes
// in the IR emitter during range-loop codegen.
//
// Reproduces: import a library, range over its exported []T.
// Fixes: pkg/ssa unified builder (cross-package type resolution).

package main

import "tests/regressions/should_compile/range_over_imported_slice/lib"

func main() {
	for _, it := range lib.Items {
		println(it.N)
	}
}
