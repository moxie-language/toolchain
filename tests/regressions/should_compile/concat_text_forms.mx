/*
Every legal shape of '|', and the bitwise OR it still is for numbers.

The mixed text/other case is rejected (reject_concat_non_text); this fixture
pins the other side of the same rule, because a check that rejects too much is
as wrong as one that rejects too little: text is BOTH spellings (string and
[]byte are one type), a named string type is text through its underlying type,
and two non-text operands are a bitwise OR and must keep working.
*/
package main

type label string

func main() {
	var n int64 = 5
	var raw []byte = "y"
	var l label = "L"

	s := "x=" | "a" | raw | l
	if s != "x=ayL" {
		panic("string|[]byte|named-string = " | s)
	}

	or := (n | 2) | 8
	if or != 15 {
		// No .String() here on purpose: the builtin Stringer bodies are native
		// only (moxie.stringer is off for wasm), so a fixture that prints a
		// number cannot compile for the wasm target - and this one should.
		panic("bitwise OR is wrong")
	}

	println("concat text forms ok")
}
