package lib

var g int32

// Go order: `return expr` assigns the named results, defers run, the slots are
// returned. ReturnLit want 11, TwoResults want 7,2, ReadSlot slot want 5.
func ReturnLit() (n int32) {
	defer func() {
		n = n + 6
	}()
	return 5
}

func TwoResults() (a int32, b int32) {
	defer func() {
		a = a + 6
	}()
	a = 1
	b = 2
	return a, b
}

func ReadSlot() (n int32) {
	defer func() {
		g = n
	}()
	return 5
}

func BareReturn() (n int32) {
	n = 1
	defer func() {
		n = n + 6
	}()
	return
}

func WriteBack() (n int32) {
	n = 1
	defer func() {
		n = n + 6
	}()
	return n
}

func Chain() (n int32) {
	n = 1
	defer func() {
		g = n + 100
	}()
	defer func() {
		n = n + 6
	}()
	return n
}

func ViaLocal() (n int32) {
	n = 1
	inc := func() {
		n = n + 1
	}
	inc()
	inc()
	return n
}

func NoDefer() (n int32) {
	return 5
}

func G() (n int32) {
	return g
}

func Reset() {
	g = 0
}
