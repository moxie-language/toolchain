package main

import (
	"tests/regressions/should_compile/named_result_defers/lib"
)

func main() {
	println("ReturnLit=" | lib.ReturnLit().String() | " (want 11)")
	a, b := lib.TwoResults()
	println("TwoResults=" | a.String() | "," | b.String() | " (want 7,2)")
	lib.Reset()
	r := lib.ReadSlot()
	println("ReadSlot=" | r.String() | " slotInDefer=" | lib.G().String() | " (want 5,5)")
	println("BareReturn=" | lib.BareReturn().String() | " (want 7)")
	println("WriteBack=" | lib.WriteBack().String() | " (want 7)")
	lib.Reset()
	c := lib.Chain()
	println("Chain=" | c.String() | " g=" | lib.G().String() | " (want 7,107)")
	println("ViaLocal=" | lib.ViaLocal().String() | " (want 3)")
	println("NoDefer=" | lib.NoDefer().String() | " (want 5)")
}
