// Regression: sovereign receiver arena persists maps, slices and linked
// nodes across mutating method calls.
//
// Sum = linked list (3+2+1) + items (3+2+1) = 12.
// KeyName resolves through the receiver-owned interface-valued map.

package main

import "tests/regressions/should_compile/sovereign_arena/lib"

func main() {
	// Termination: a batch program must still be stoppable, so the entry
	// handles the channel the runtime closes on SIGINT/SIGTERM.
	select {
	case <-sigint:
		return
	default:
	}

	var s lib.Store
	s.Add("a", 1)
	s.Add("b", 2)
	s.Add("a", 3)
	println("sum:", s.Sum())
	println("key a:", s.KeyName("a"))
	println("key b:", s.KeyName("b"))
}
