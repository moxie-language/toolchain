/*
Returning an untyped numeric constant from a function whose result is a float,
run rather than described.

The SSA builder coerced a stored untyped constant (assignments) but not a
returned one, so `return 1` from a func() (r float64) left an integer operand
where the caller read a double and got 0. math.Tanh was the visible victim: its
two saturated branches are `return 1` and `return -1`, so tanh(100) was 0 while
tanh(1) was right - only the branches that return a bare constant were wrong.
The same shape through a switch case, a named result, an explicit float literal
and a negative constant all have to agree, because a fix that special-cases one
spelling is not a fix.
*/
package main

func one() (r float64) {
	return 1
}

func conditional(x float64) (r float64) {
	if x > 44 {
		return 1
	}
	return 3
}

func negative(x float64) (r float64) {
	if x > 44 {
		return -1
	}
	return 3
}

func assigned(x float64) (r float64) {
	if x > 44 {
		r = 1
		return r
	}
	return 3
}

func viaSwitch(x float64) (r float64) {
	switch {
	case x > 44:
		return 1
	case x > 1:
		return 2
	}
	return 3
}

func literal() (r float64) {
	return 1.0
}

func main() {
	if one() != 1 {
		panic("return 1 from a float64 func is not 1")
	}
	if conditional(100) != 1 || conditional(0) != 3 {
		panic("a conditional return of 1 from a float64 func is wrong")
	}
	if negative(100) != -1 || negative(0) != 3 {
		panic("a conditional return of -1 from a float64 func is wrong")
	}
	if assigned(100) != 1 || assigned(0) != 3 {
		panic("assignment through the named result is wrong")
	}
	if viaSwitch(100) != 1 || viaSwitch(10) != 2 || viaSwitch(0) != 3 {
		panic("a return of 1 inside a switch case is wrong")
	}
	if literal() != 1 {
		panic("an explicit float literal return is wrong")
	}
	println("untyped constant returns ok")
}
