package lib

// Moxie functions are not closures: a function literal has no environment and
// captures nothing. Everything it reads is a parameter or a package global, and
// everything it writes goes through a pointer parameter or a receiver. This
// fixture pins the shapes the stdlib actually uses - function literals passed
// on, pointer parameters, deferred literals, method values - at run time, in a
// dependency package, so the code generator is measured rather than argued
// about.

// ReadOuter: a literal receives the value it used to have to capture.
func ReadOuter() (n int32) {
	f := func(x, base int32) (y int32) {
		return x + base
	}
	return f(1, 41)
}

// Escaped: the same literal passed to another function.
func Escaped() (n int32) {
	f := func(x, base int32) (y int32) {
		return x + base
	}
	return apply(f, 1, 41)
}

func apply(f func(int32, int32) int32, x, base int32) (y int32) {
	return f(x, base)
}

// WriteOuter: a write through a pointer parameter reaches the enclosing frame.
func WriteOuter() (n int32) {
	n = 1
	inc := func(p *int32) {
		*p = *p + 1
	}
	inc(&n)
	inc(&n)
	return n
}

// WriteThroughPointer: a pointer parameter writing its pointee.
func WriteThroughPointer() (n int32) {
	v := int32(10)
	add := func(p *int32) {
		*p = *p + 5
	}
	applyVoid(add, &v)
	return v
}

func applyVoid(f func(*int32), p *int32) {
	f(p)
}

// Aliasing: the callee reads the value the caller passes at the call, not a
// copy frozen at literal-creation time.
func Aliasing() (n int32) {
	k := int32(100)
	read := func(k int32) (y int32) {
		return k
	}
	k = 200
	return read(k)
}

// Deferred: a deferred literal writes through a pointer parameter at return.
func Deferred() (n int32) {
	m := int32(7)
	defer func(n *int32, m int32) {
		*n = *n + m
	}(&n, 7)
	n = 1
	return n
}

// MethodValue: a bound method value carries its receiver, which is the one
// context a function value is allowed to have.
type counter struct {
	n int32
}

func (c *counter) bump() {
	c.n++
}

func MethodValue() (n int32) {
	c := &counter{}
	b := c.bump
	b()
	b()
	return c.n
}

// LoopVar: every literal receives its own iteration's value as a parameter.
// There is no shared loop variable to observe, because there is nothing to
// capture: the two saved literals are the same code with different arguments.
func LoopVar() (first, last int32) {
	var fs []func(int32) int32
	for i := int32(0); i < 3; i++ {
		fs = addOne(fs, func(i int32) (y int32) {
			return i
		})
	}
	return fs[0](0), fs[2](2)
}

func addOne(fs []func(int32) int32, f func(int32) int32) (out []func(int32) int32) {
	// `[]T{:n}` presizes len == cap == n, so this is not `make([]T, 0, n)`:
	// growing means allocating the new length and writing through a cursor.
	// (A hand-written capacity guard on top of `{:n}` appends past the
	// presized nil elements instead.)
	out = []func(int32) int32{:len(fs) + 1}
	for i := int32(0); i < len(fs); i++ {
		out[i] = fs[i]
	}
	out[len(fs)] = f
	return out
}

// SliceElement: the element is passed as a slice argument and read at call
// time, so the caller's later write is visible.
func SliceElement() (n int32) {
	xs := []int32{1, 2, 3}
	f := func(xs []int32) (y int32) {
		return xs[1]
	}
	xs[1] = 20
	return f(xs)
}
