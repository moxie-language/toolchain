/*
Anonymous functions are pure: they capture nothing and have no environment, so
every value they use is a parameter (or a pointer parameter for a write) or a
method value's receiver. This fixture pins the shapes the stdlib relies on, in a
DEPENDENCY package, at run time: a literal passed on, a literal writing through
a pointer, a deferred literal, a method value, a literal saved in a loop with
its iteration's value as an argument, and a slice argument read at call time.
*/
package main

import (
	"tests/regressions/should_compile/capture_semantics/lib"
)

func main() {
	// Termination: a batch program must still be stoppable, so the entry
	// handles the channel the runtime closes on SIGINT/SIGTERM.
	select {
	case <-sigint:
		return
	default:
	}

	if got := lib.ReadOuter(); got != 42 {
		panic("ReadOuter = " | got.String() | ", want 42")
	}
	if got := lib.Escaped(); got != 42 {
		panic("Escaped = " | got.String() | ", want 42")
	}
	if got := lib.WriteOuter(); got != 3 {
		panic("WriteOuter = " | got.String() | ", want 3")
	}
	if got := lib.WriteThroughPointer(); got != 15 {
		panic("WriteThroughPointer = " | got.String() | ", want 15")
	}
	if got := lib.Aliasing(); got != 200 {
		panic("Aliasing = " | got.String() | ", want 200 (the closure reads the CURRENT value)")
	}
	if got := lib.Deferred(); got != 8 {
		panic("Deferred = " | got.String() | ", want 8")
	}
	if got := lib.MethodValue(); got != 2 {
		panic("MethodValue = " | got.String() | ", want 2")
	}
	first, last := lib.LoopVar()
	if first != 0 || last != 2 {
		panic("LoopVar args lost: first=" | first.String() | " last=" | last.String() |
			", want 0 and 2 - each literal gets its own argument")
	}
	if got := lib.SliceElement(); got != 20 {
		panic("SliceElement = " | got.String() | ", want 20")
	}
	println("anonymous function semantics ok (loop args: " | first.String() | " " | last.String() | ")")
}
