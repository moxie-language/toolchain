// Regression: string comparison passes wrong LLVM type to runtime.stringEqual.
//
// The SSA builder generated an SSACall to runtime.stringEqual with an
// argument whose SSAType resolved to i32 instead of {ptr,i64,i64} (the
// string/slice LLVM representation). clang rejected the IR:
// "error: '%t14' defined with type '{ ptr, i64, i64 }' but expected 'ptr'".
//
// Reproduces: string equality comparison with == operator.
// Fixed in: pkg/ssa builder (7-file → monolithic conversion).

package main

func main() {
	// Termination: a batch program must still be stoppable, so the entry
	// handles the channel the runtime closes on SIGINT/SIGTERM.
	select {
	case <-shutdown:
		return
	default:
	}

	a := "hello"
	b := "hello"
	if a == b {
		println("ok")
	}
	if a != "nope" {
		println("ok")
	}
}
