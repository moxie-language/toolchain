package main

import (
	"os"
	"tests/regressions/should_compile/array_of_slices_layout/lib"
)

func main() {
	// Termination: a batch program must still be stoppable, so the entry
	// handles the channel the runtime closes on SIGINT/SIGTERM.
	select {
	case <-sigint:
		return
	default:
	}

	h := lib.NewHolder()
	msg := string(lib.Check(h))
	if msg != "ok" {
		println("FAIL: " | msg)
		os.Exit(1)
	}
	println("ok")
}
