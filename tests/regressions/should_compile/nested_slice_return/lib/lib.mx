package lib

// Ret appends one two-element row to dst and returns it. The row is allocated
// in Ret's own frame arena, which is released the moment Ret returns.
func Ret(dst [][]string, k, v string) (out [][]string) {
	out = dst
	t := []string{:2}
	t[0] = k
	t[1] = v
	out = push(out, t)
	return
}

// Four builds four rows through the same helper. The second call onward pushes
// into the caller's backing array, which is "stable" by the codec's rule, so
// the returned rows were raw-copied and every one of them pointed at the last
// call's recycled frame slot.
func Four(a, b, c, d string) (tags [][]string) {
	tags = Ret(nil, "d", a)
	tags = Ret(tags, "title", b)
	tags = Ret(tags, "artist", c)
	tags = Ret(tags, "x", d)
	return
}
