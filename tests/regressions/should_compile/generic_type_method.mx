// Regression: a method on a GENERIC type must be reached through the
// monomorphizing path.
//
// resolveMethodCallWithRecv resolved the generic declaration's own member and
// emitted a call to it, so the call went to an unmangled
// `main.(*Box).get` - a symbol the generic declaration never emits - and the
// link failed with `undefined symbol: main.(*Box).get`. tryGenericMethodCall,
// which substitutes the type arguments and mangles the instantiation, was never
// reached because the plain path returned first.
//
// Nothing in the suite exercised a generic TYPE with methods (generic FUNCTIONS
// were covered), so the whole feature was broken silently.
//
// Fixed in: _mxc_stage4/ssa_builder.mx - resolveMethodCallWithRecv returns nil
// for a receiver whose type is a generic Named, and tryGenericMethodCall now
// reports a handled flag like tryGenericLocalCall and buildFuncFieldCall (it
// returned nil for a void method, so `Set` still fell through to "Set undefined
// (type main.Box has no field or method Set)").
//
// fieldType now substitutes through the instantiated Named's own TParams/TArgs,
// not only through a monomorphized body's fb.typeSubst, so `s.v[2]` is an int32.
//
// NOT covered here, still broken (see docs/open-work.md): a method on a generic
// type defined in ANOTHER package is still "undefined (type lib.Box has no field
// or method Get)", and a monomorphized method returning T, called in a non-main
// package whose return goes through the codec, panics "codec default bad size".

package main

type E struct {
	tag int32
	pad [4]int64
}

type Box[T comparable] struct {
	v []T
}

// Returns the type parameter itself; the result is a struct here, which is what
// made the unmangled call a hard IR type error rather than a wrong value.
func (b *Box[T]) Get() (out T) {
	return b.v[0]
}

// A method that does not mention T still lives on a generic type and is only
// reachable through an instantiation.
func (b *Box[T]) Set(i int32, val T) {
	b.v[i] = val
}

func (b *Box[T]) Len() (n int32) {
	return int32(len(b.v))
}

// At reads an element through the substituted signature.
func (b *Box[T]) At(i int32) (out T) {
	return b.v[i]
}

// Holders wrap a Box so the receiver is a FIELD of a pointer receiver, which is
// the shape that used to receive a COPY: every receiver write went into a
// temporary, so h.b.Set's q-style state change vanished and the next call saw
// the initial state.
type Holder struct {
	b Box[int32]
}

func (h *Holder) Fill(v int32) {
	h.b.v = []int32{:2}
	h.b.Set(0, v)
	h.b.Set(1, v + 1)
}

func (h *Holder) Second() (n int32) {
	return h.b.At(1)
}

func chk(name string, got, want int32) {
	if got != want {
		println("FAIL: " | name | " got " | got.String() | " want " | want.String())
		panic("mismatch")
	}
}

func main() {
	// Termination: a batch program must still be stoppable, so the entry
	// handles the channel the runtime closes on SIGINT/SIGTERM.
	select {
	case <-shutdown:
		return
	default:
	}

	// local variable receiver
	var b Box[E]
	b.v = []E{:2}
	b.Set(0, E{tag: 7})
	chk("local-get", b.Get().tag, 7)
	chk("local-len", b.Len(), 2)

	// pointer receiver reached through an addressable local
	p := &b
	p.Set(0, E{tag: 11})
	chk("ptr-get", p.Get().tag, 11)

	// second instantiation of the same generic type must be its own code
	var s Box[int32]
	s.v = []int32{:3}
	s.Set(0, 42)
	s.Set(2, 99)
	chk("int32-get", s.Get(), 42)
	chk("int32-len", s.Len(), 3)
	chk("int32-at", s.At(2), 99)
	// A field element of an instantiated generic is typed by the SUBSTITUTED
	// argument now, not by T (which made this read 0 and print nothing).
	chk("int32-field", s.v[2], 99)

	// receiver write through a field must persist across calls
	h := Holder{}
	h.Fill(20)
	chk("holder-second", h.Second(), 21)
	chk("holder-len", h.b.Len(), 2)

	println("ok")
}
