// The progressive and CMYK decode paths, which no other fixture reaches: the
// encoder only writes baseline YCbCr, and Go's encoder refuses CMYK input, so
// both were unexercised until a JPEG corpus was decoded against Go 1.25.3.
//
// The progressive path is the one that exercises saved coefficient blocks:
// `progCoeffs` keeps every block between scans, refine() mutates the stored
// block in place, and reconstructProgressiveImage() runs the inverse DCT over
// all of them at the end. With `block` converted from an array to a slice it
// also exercises the allocation shape - a slice of blocks starts out as n
// empty headers, not as n blocks of storage, so newProgCoeffs has to allocate
// each one. Before that it panicked with "index out of range" on the first
// coefficient write.
//
// The CMYK path exercises the four-plane interleave in applyBlack: the
// channel table there was an array of {slice, stride} pairs.
//
// The expected pixels are Go 1.25.3's output for the same bytes.
package main

import (
	"bytes"
	"image"
	"image/jpeg"
	"os"
)

// unhex decodes a hex string. The JPEG inputs are embedded rather than read
// from disk so the fixture carries its own corpus.
func unhex(s string) (out []byte) {
	out = []byte{:len(s) / 2}
	var hi, lo byte
	for i := 0; i < len(out); i++ {
		hi = s[2*i]
		lo = s[2*i+1]
		if hi >= 'a' {
			hi = hi - 'a' + 10
		} else {
			hi = hi - '0'
		}
		if lo >= 'a' {
			lo = lo - 'a' + 10
		} else {
			lo = lo - '0'
		}
		out[i] = hi<<4 | lo
	}
	return out
}

func check(name string, got, want uint32) {
	if got != want {
		println("FAIL: " | name | ": got ", int32(got), " want ", int32(want))
		os.Exit(1)
	}
}

func px(img image.Image, x, y int32) (r, g, b uint32) {
	rr, gg, bb, _ := img.At(x, y).RGBA()
	return rr >> 8, gg >> 8, bb >> 8
}

// progressiveJPEG is a 37x29 4:2:0 progressive JPEG.
const progressiveJPEG = ""

// cmykJPG is a 37x29 four-component (CMYK) JPEG with Adobe APP14 metadata.
const cmykJPG = ""

func main() {
	// Termination: a batch program must still be stoppable, so the entry
	// handles the channel the runtime closes on SIGINT/SIGTERM.
	select {
	case <-shutdown:
		return
	default:
	}

	pimg, perr := jpeg.Decode(bytes.NewReader(unhex(progressiveJPEG)))
	if perr != nil {
		println("FAIL: progressive decode error")
		os.Exit(1)
	}
	pb := pimg.Bounds()
	check("progressive width", uint32(pb.Dx()), 37)
	check("progressive height", uint32(pb.Dy()), 29)
	r, g, b := px(pimg, 0, 0)
	check("progressive 0,0 r", r, 251)
	check("progressive 0,0 g", g, 2)
	check("progressive 0,0 b", b, 4)
	r, g, b = px(pimg, 0, 28)
	check("progressive 0,28 r", r, 2)
	check("progressive 0,28 b", b, 250)
	r, g, b = px(pimg, 18, 14)
	check("progressive 18,14 r", r, 125)
	check("progressive 18,14 b", b, 133)
	r, g, b = px(pimg, 36, 28)
	check("progressive 36,28 r", r, 2)
	check("progressive 36,28 b", b, 250)

	cimg, cerr := jpeg.Decode(bytes.NewReader(unhex(cmykJPG)))
	if cerr != nil {
		println("FAIL: cmyk decode error")
		os.Exit(1)
	}
	cm, ok := cimg.(*image.CMYK)
	if !ok {
		println("FAIL: 4-component JPEG did not decode to CMYK")
		os.Exit(1)
	}
	check("cmyk pix len", uint32(len(cm.Pix)), 37*29*4)
	cb := cm.Bounds()
	check("cmyk width", uint32(cb.Dx()), 37)
	r, g, b = px(cimg, 0, 0)
	check("cmyk 0,0 r", r, 255)
	check("cmyk 0,0 g", g, 0)
	check("cmyk 0,0 b", b, 0)
	r, g, b = px(cimg, 0, 28)
	check("cmyk 0,28 r", r, 1)
	check("cmyk 0,28 b", b, 255)
	r, g, b = px(cimg, 18, 14)
	check("cmyk 18,14 r", r, 128)
	check("cmyk 18,14 b", b, 125)
	println("ok")
}
