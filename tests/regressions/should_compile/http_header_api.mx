//:wasmtest skip
// Native-only by COST, measured, not by failure: linking net/http for -target wasm
// makes this fixture the most expensive one in the tree - its native and wasm builds
// together take ~35 minutes, and tests/wasm/validate.sh wipes the per-compiler package
// cache at the start of every run on purpose ("each run measures a cold compile"),
// so the cost is paid on EVERY phase-5 run. It is not hidden: this fixture DOES
// validate in the browser - gojs stubs and all - when run directly, which is how the
// host capability was proved in round 108:
//
//     MOXIE=./moxie bash tests/wasm/validate.sh tests/regressions/should_compile/http_header_api.mx
//
// Header behaviour natively is covered every run (phase 0), and net/http COMPILING for
// wasm is covered every run (phase 1c).
/*
http.Header is an ALIAS with free functions, and the whole API works through it.

A named map type is not allowed in Moxie, so `type Header map[string][][]byte`
became `type Header = map[string][][]byte` (round 100) and its methods became
free functions: HeaderAdd, HeaderSet, HeaderGet, HeaderValues, HeaderDel,
HeaderClone, HeaderWrite, HeaderWriteSubset - plus the unexported helpers
headerGet/headerHas/headerWrite/headerWriteSubset/headerSortedKeyValues that the
package uses internally.

The NAME survives (a Header is still written Header{...}, converted with
Header(...) and read with h[key], and Request/Response fields are unchanged);
what callers write changes from h.Get(k) to http.HeaderGet(h, k).

This is a MAIN-package fixture deliberately: an unresolved call inside a library
package's body is dropped SILENTLY (round 99), so only a main package proves the
free functions exist. It pins canonicalization, first-value Get, all-values,
Del, Clone independence, and both writers.

NATIVE-ONLY, and the reason is the TARGET, not this fixture: linking net/http
for `-target wasm` pulls its `js && wasm` files, so the module imports the
`gojs` bridge, and the standalone-wasm validator host does not provide that
module - the browser run dies at instantiation with

    WebAssembly.instantiate(): Import #18 "gojs": module is not an object or function

That is true of ANY fixture importing net/http; net/http's wasm COMPILATION is
covered by phase 1c (`wasm:net/http PASS`), and this fixture covers the API
behaviour natively. Recorded in docs/OPEN_WORK.md.
*/
package main

import (
	"bytes"
	"net/http"
)

func main() {
	h := http.Header{}
	http.HeaderSet(h, "Content-Type", "text/plain")
	http.HeaderAdd(h, "X-Multi", "one")
	http.HeaderAdd(h, "X-Multi", "two")
	if http.HeaderGet(h, "content-type") != "text/plain" {
		panic("get canonicalized key")
	}
	vs := http.HeaderValues(h, "x-multi")
	if len(vs) != 2 || string(vs[1]) != "two" {
		panic("values keeps every value in order")
	}
	c := http.HeaderClone(h)
	http.HeaderDel(c, "X-Multi")
	if http.HeaderGet(c, "x-multi") != "" {
		panic("del removes every value")
	}
	if http.HeaderGet(h, "x-multi") == "" {
		panic("clone must be independent of the original")
	}
	var buf bytes.Buffer
	if err := http.HeaderWrite(h, &buf); err != nil {
		panic("write")
	}
	if buf.Len() == 0 {
		panic("write produced nothing")
	}
	var buf2 bytes.Buffer
	if err := http.HeaderWriteSubset(h, &buf2, map[string]bool{"X-Multi": true}); err != nil {
		panic("writesubset")
	}
	println("header ok")
}
