/*
ML-KEM-768 against a fixed Go vector, built as an application.

The KEM had a silent failure that only showed up here: its ring encoders used
Go's sliceForAppend, which hands back the grown buffer and a tail view of it.
Moxie relocates each returned slice on its own, so the tail the encoders wrote
through was a copy and the buffer they returned was zeros. In-package the helper
happened to keep the aliasing, so a package test passed; built as a dependency of
an application, decapsulation failed its own re-encryption check and fell back to
implicit rejection, returning a deterministic but wrong shared key for every
ciphertext. That is why this fixture is an application, not a package test, and
why it pins bytes rather than round tripping.

Reference (Go 1.25.3, crypto/mlkem): seed 0x00,0x03,.. gives this decapsulation
key and encapsulation key, and decapsulating this ciphertext gives this shared
key.
*/
package main

import (
	"bytes"
	"crypto/mlkem"
	"os"
)

const seedHex = "000306090c0f1215181b1e2124272a2d303336393c3f4245484b4e5154575a5d606366696c6f7275787b7e8184878a8d909396999c9fa2a5a8abaeb1b4b7babd"
const wantDK = "000306090c0f1215181b1e2124272a2d303336393c3f4245484b4e5154575a5d606366696c6f7275787b7e8184878a8d909396999c9fa2a5a8abaeb1b4b7babd"
const wantEK = ""
const ctHex = ""
const wantSS = "f789c54d4e79dbc0c871f44fbc38e56c1cc7b0ef8a314cb3bc6aea2611a9b1e5"

func hex(b []byte) (s string) {
	const t = "0123456789abcdef"
	o := []byte{:len(b) * 2}
	for i := 0; i < len(b); i++ {
		o[2*i] = t[b[i]>>4]
		o[2*i+1] = t[b[i]&0xf]
	}
	return string(o)
}

func unhex(s string) (out []byte) {
	out = []byte{:len(s) / 2}
	var hi, lo byte
	for i := 0; i < len(out); i++ {
		hi = s[2*i]
		lo = s[2*i+1]
		if hi >= 'a' {
			hi = hi - 'a' + 10
		} else {
			hi = hi - '0'
		}
		if lo >= 'a' {
			lo = lo - 'a' + 10
		} else {
			lo = lo - '0'
		}
		out[i] = hi<<4 | lo
	}
	return out
}

func check(name string, got, want string) {
	if got != want {
		println("FAIL: " | name)
		println("  got  " | got)
		println("  want " | want)
		os.Exit(1)
	}
}

func main() {
	// Termination: a batch program must still be stoppable, so the entry
	// handles the channel the runtime closes on SIGINT/SIGTERM.
	select {
	case <-shutdown:
		return
	default:
	}

	dk, err := mlkem.NewDecapsulationKey768(unhex(seedHex))
	if err != nil {
		println("FAIL: NewDecapsulationKey768")
		os.Exit(1)
	}
	check("decapsulation key", hex(dk.Bytes()), wantDK)
	ek := dk.EncapsulationKey()
	check("encapsulation key", hex(ek.Bytes()), wantEK)
	ss, derr := dk.Decapsulate(unhex(ctHex))
	if derr != nil {
		println("FAIL: Decapsulate returned an error for a valid ciphertext")
		os.Exit(1)
	}
	check("shared key", hex(ss), wantSS)

	// The same key rebuilt from its seed and from its encapsulation key bytes
	// must behave identically: this is the path an application takes.
	dk2, err2 := mlkem.NewDecapsulationKey768(unhex(seedHex))
	if err2 != nil {
		println("FAIL: NewDecapsulationKey768 (second)")
		os.Exit(1)
	}
	ek2, err3 := mlkem.NewEncapsulationKey768(unhex(wantEK))
	if err3 != nil {
		println("FAIL: NewEncapsulationKey768")
		os.Exit(1)
	}
	check("rebuilt encapsulation key", hex(ek2.Bytes()), wantEK)
	ss2, derr2 := dk2.Decapsulate(unhex(ctHex))
	if derr2 != nil {
		println("FAIL: Decapsulate (second)")
		os.Exit(1)
	}
	check("rebuilt shared key", hex(ss2), wantSS)

	// Its own encapsulation must round trip, and a tampered ciphertext must
	// take the implicit-rejection path: 32 bytes, no error, not the real key.
	ssA, ct := ek2.Encapsulate()
	ssB, derr3 := dk2.Decapsulate(ct)
	if derr3 != nil || !bytes.Equal(ssA, ssB) {
		println("FAIL: encapsulate/decapsulate round trip")
		os.Exit(1)
	}
	bad := unhex(ctHex)
	bad[10] = bad[10] ^ 0x01
	ssR, derr4 := dk2.Decapsulate(bad)
	if derr4 != nil || len(ssR) != 32 || bytes.Equal(ssR, ss) {
		println("FAIL: tampered ciphertext did not take implicit rejection")
		os.Exit(1)
	}
	// ML-KEM-1024 has no Go 1.25 reference, so only its round trip is pinned:
	// a key derived from the seed must decapsulate what its own encapsulation
	// key produced. The same sliceForAppend and stored-slice bugs would break
	// it the same way, and this is the only coverage it has.
	dk3, err4 := mlkem.NewDecapsulationKey1024(unhex(seedHex))
	if err4 != nil {
		println("FAIL: NewDecapsulationKey1024")
		os.Exit(1)
	}
	ek3 := dk3.EncapsulationKey()
	ssC, ctC := ek3.Encapsulate()
	ssD, derr5 := dk3.Decapsulate(ctC)
	if derr5 != nil || !bytes.Equal(ssC, ssD) || len(ctC) != 1568 {
		println("FAIL: ML-KEM-1024 round trip")
		os.Exit(1)
	}
	println("ok")
}
