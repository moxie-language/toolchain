package lib

type MW struct {
	S string
	I int32
}

func New(s string) (m MW) {
	w := MW{S: s}
	for w.I < len(s) && s[w.I] != '[' {
		w.I++
	}
	if w.I < len(s) {
		w.I++
	}
	return w
}

type Pair struct {
	S string
	I int32
}

func NewPair(s string) (m Pair) {
	w := Pair{S: s}
	w.I = 7
	return w
}

type IntFirst struct {
	I int32
	S string
}

func NewIntFirst(s string) (m IntFirst) {
	w := IntFirst{S: s}
	w.I = 7
	return w
}
