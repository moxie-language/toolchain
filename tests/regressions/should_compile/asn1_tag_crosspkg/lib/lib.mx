package lib

// Tagged carries two field tags that asn1 must see from the IMPORTING package:
// Name is a character string (without the tag a plain string field is an OCTET
// STRING under Moxie's unified string=[]byte) and Skip is optional.
type Tagged struct {
	Name string `asn1:"string"`
	Raw  []byte
	Skip []byte `asn1:"optional"`
}

func New() (t Tagged) {
	t.Name = "x"
	t.Raw = []byte("abc")
	return
}
