/*
A method's parameter typed by its generic RECEIVER's type parameter must not be
reported as undefined.

The bare-undefined rule added in round 86 reports every name in a parameter type
that does not resolve, for a non-generic top-level function. It cannot be applied
to a method: when a generic receiver's signature is resolved, the receiver's type
parameters are not in that scope, so `V` in `func (b *Box[K,V]) Set(k K, val V)`
resolves to nothing and the rule would call it undefined. This fixture is the
guard: it must compile and run, and the rule must stay at the non-generic
top-level site until a generic receiver's type params are threaded into its
signature resolution.
*/
package main

type Box[K comparable, V comparable] struct {
	k K
	v V
}

func (b *Box[K, V]) Get() (out V) {
	return b.v
}

func (b *Box[K, V]) Key() (out K) {
	return b.k
}

func (b *Box[K, V]) Set(k K, val V) {
	b.k = k
	b.v = val
}

func main() {
	// Termination: a batch program must still be stoppable, so the entry
	// handles the channel the runtime closes on SIGINT/SIGTERM.
	select {
	case <-shutdown:
		return
	default:
	}

	var b Box[int32, string]
	b.Set(1, "hi")
	if b.Get() != "hi" {
		panic("get")
	}
	if b.Key() != 1 {
		panic("key")
	}
	var p Box[string, int32]
	p.Set("n", 7)
	if p.Get() != 7 {
		panic("second instantiation")
	}
}
