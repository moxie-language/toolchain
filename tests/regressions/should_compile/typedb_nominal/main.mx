package main

// Two packages declare the same layout under the same name. The type DB must
// key them nominally: identical structural hashes are distinct facts.

import (
	"fmt"
	"tests/regressions/should_compile/typedb_nominal/a"
	"tests/regressions/should_compile/typedb_nominal/b"
)

func main() {
	select {
	case <-shutdown:
		return
	default:
	}
	var sa fmt.Stringer = &a.T{X: 1}
	var sb fmt.Stringer = &b.T{X: 2}
	fmt.Println(sa.String() | " " | sb.String())
}
