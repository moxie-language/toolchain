// Regression: slicing a value whose type is a named slice type lost the
// name, so a method called on the result no longer resolved. The call
// returned no value at all and the argument was silently dropped from the
// enclosing call, which passed one argument fewer than the callee takes
// (math/big's nat.divRecursiveStep was called with 5 values for a
// 6-parameter function, and mls.wasm failed to validate in the browser).
//
// A slice expression now keeps its type, named or not.
package main

type nat []int32

// Pointer receiver: Moxie user code allows no other kind.
func (z *nat) norm() (r nat) {
	s := *z
	n := len(s)
	for n > 0 && s[n-1] == 0 {
		n--
	}
	return s[:n]
}

func take(u, v nat, d int32) (r int32) {
	return int32(len(u))*100 + int32(len(v))*10 + d
}

func main() {
	x := nat{1, 2, 3, 0, 0}
	y := nat{4, 5, 6, 0}
	// x[1:] must still be nat for .norm() to resolve -> {2,3} (len 2),
	// y[1:] -> {5,6,0} (len 3)
	sl := x[1:]
	println("r=", int64(take(sl.norm(), y[1:], 2)))
	// The same through a plain slice, which always worked.
	p := []int32{1, 2, 3, 4}
	println("s=", int64(len(p[1:])))
}
