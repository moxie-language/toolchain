// Reading an instantiated generic type's slice field, and calling through the
// element's pointer field, resolves when the method is declared ON the
// instantiated generic receiver (`*table[string, *node]`).
//
// That shape compiled even while src/net/http needed two one-line helpers
// (nodeMatchesPath/nodeEntryKey) to launder the same read in a NON-generic
// method, because the receiver carries the instantiation in a form the
// compiler always bound. This fixture therefore pins the receiver shape only;
// it is not the pin for the routing tree. The package context - a non-generic
// struct field of an instantiated generic whose generic is declared later in
// the file - is pinned by generic_forward_field.mx, which failed before the
// compiler fix and passes after it.
package main

import (
	"fmt"
	"os"
)

type pair[K comparable, V comparable] struct {
	key   K
	value V
}

type table[K comparable, V comparable] struct {
	rows []pair[K, V]
}

type node struct {
	name string
	hits int32
}

func (n *node) match(want string) (got *node, ok bool) {
	if n.name == want {
		return n, true
	}
	return nil, false
}

func (n *node) bump() {
	n.hits = n.hits + 1
}

// scan is the shape: a method ranging the instantiated generic slice field and
// calling through the element's pointer field.
func (t *table[string, *node]) scan(want string) (name string, hits int32) {
	for _, e := range t.rows {
		if got, ok := e.value.match(want); ok {
			got.bump()
			name = got.name
			hits = got.hits
		}
	}
	return name, hits
}

func main() {
	t := &table[string, *node]{}
	t.rows = []pair[string, *node]{}
	t.rows = push(t.rows, pair[string, *node]{key: "a", value: &node{name: "a"}})
	t.rows = push(t.rows, pair[string, *node]{key: "b", value: &node{name: "b"}})

	name, hits := t.scan("b")
	if name != "b" || hits != 1 {
		fmt.Printf("FAIL generic field: name=[%s] hits=%d want b/1\n", name, hits)
		os.Exit(1)
	}
	fmt.Printf("ok   generic field read: %s %d\n", name, hits)
	fmt.Printf("generic_field_read ok\n")
}
