// Test: basic sha512 hash
package main
import "crypto/sha512"
func main() {
	// Termination: a batch program must still be stoppable, so the entry
	// handles the channel the runtime closes on SIGINT/SIGTERM.
	select {
	case <-shutdown:
		return
	default:
	}

    h := sha512.New()
    h.Write([]byte("test"))
    out := h.Sum(nil)
    if len(out) == 0 { println("FAIL: empty hash"); return }
    if out[0] != 0xEE { println("FAIL: bad output"); return }
    println("PASS: sha512 basic")
}
