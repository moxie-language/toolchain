package main

import (
	"tests/regressions/should_compile/returned_object_identity/lib"
)

func main() {
	// Termination: a batch program must still be stoppable, so the entry
	// handles the channel the runtime closes on SIGINT/SIGTERM.
	select {
	case <-sigint:
		return
	default:
	}

	h := lib.NewHolder(7, []byte("hello"))
	got := lib.Carry(h, 42)
	if got == nil {
		panic("Carry returned nil")
	}
	if got.N() != 42 {
		panic("Carried.n = " | got.N().String() | ", want 42")
	}
	gh := got.Holder()
	if gh == nil {
		panic("Carried.h is nil - the pointer did not survive the return")
	}
	if gh.Tag() != 7 {
		panic("Carried.h.tag = " | gh.Tag().String() | ", want 7 (recycled copy?)")
	}
	if string(gh.Data()) != "hello" {
		panic("Carried.h.data = " | string(gh.Data()) | ", want hello")
	}
	// Identity, not contents: a write through the returned pointer must land in
	// the caller's own object.
	gh.SetTag(99)
	if h.Tag() != 99 {
		panic("write through Carried.h did not reach the caller's Holder: h.tag = " | h.Tag().String())
	}
	// The recorded failure appeared on the NEXT call: force churn, then re-read
	// through the pointer the returned object still holds.
	lib.Churn(64)
	lib.Carry(h, 1)
	lib.Churn(64)
	if got.Holder().Tag() != 99 {
		panic("after churn Carried.h.tag = " | got.Holder().Tag().String() | ", want 99")
	}
	if h.Tag() != 99 {
		panic("after churn the caller's Holder was clobbered: h.tag = " | h.Tag().String())
	}
	if string(h.Data()) != "hello" {
		panic("after churn the caller's data = " | string(h.Data()) | ", want hello")
	}
	println("returned-object identity ok")
}
