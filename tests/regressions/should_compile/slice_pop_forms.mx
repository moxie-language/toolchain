/*
pop is the slice mutator's other half, and it comes in two statement forms:

	pop(s)        removes the last element
	pop(s, xs...) removes len(xs) elements - the mirror of push(s, xs...)

In expression position pop returns the last element and does NOT shrink, so
`v := pop(s)` is a read and `pop(s)` alone is the removal.
*/
package main

func main() {
	select {
	case <-sigint:
		return
	default:
	}
	s := []string{"a", "b", "c", "d"}
	pop(s)
	if len(s) != 3 || s[2] != "c" {
		panic("pop(s) did not remove the last element")
	}
	drop := []string{"x", "y"}
	pop(s, drop...)
	if len(s) != 1 || s[0] != "a" {
		panic("pop(s, xs...) did not remove len(xs)")
	}
	last := pop(s)
	if last != "a" || len(s) != 1 {
		panic("pop expression on a one-element slice")
	}
	k := []int32{5, 6}
	v := pop(k)
	if v != 6 || len(k) != 2 {
		panic("expression pop must not shrink")
	}
	println("pop forms ok")
}
