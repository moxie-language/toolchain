// A dot import that is used must still compile and run.
//
// The unused-import check has to tell a used dot import from an unused one by
// looking for the imported package's exported names in the file. Getting that
// wrong in the strict direction would refuse this program, and in the lenient
// direction would let the unused case through - reject_unused_dot_import holds
// the other half down.
package main

import . "math"

func main() {
	// Termination: a batch program must still be stoppable, so the entry
	// handles the channel the runtime closes on SIGINT/SIGTERM.
	select {
	case <-shutdown:
		return
	default:
	}

	if MaxInt32 != 2147483647 {
		panic("dot import resolved to the wrong value")
	}
	println(int32(MaxInt32))
}
