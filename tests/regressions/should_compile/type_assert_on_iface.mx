// Regression: SSATypeAssert on interface value produces i32 vs {i64,ptr} mismatch.
//
// Reproduces: receive a named interface value, type-assert to a concrete type.
// Fixed in: pkg/ssa builder (type resolution for imported package types).

package main

type V interface {
	IsV()
}

type Impl struct{}
func (mi *Impl) IsV() {}

type Other struct{}
func (mo *Other) IsV() {}

func assertInt(v V) (ok bool) {
	_, ok = v.(*Impl)
	return
}

func main() {
	// Termination: a batch program must still be stoppable, so the entry
	// handles the channel the runtime closes on SIGINT/SIGTERM.
	select {
	case <-sigint:
		return
	default:
	}

	if !assertInt(&Impl{}) {
		println("FAIL: expected Impl to match")
	}
	if assertInt(&Other{}) {
		println("FAIL: expected Other not to match")
	}
	println("ok")
}
