// Regression: SSATypeAssert on interface value produces i32 vs {i64,ptr} mismatch.
//
// The 7-file pkg/ssa builder generated SSATypeAssert instructions on
// concrete-typed values instead of interface-typed values. The emitter
// assumed the asserted value was {i64,ptr} (LLVM interface repr) but the
// value was i32. clang rejected with:
// "error: '%t382' defined with type 'i32' but expected '{ i64, ptr }'".
//
// Reproduces: receive an interface{}, type-assert to a concrete type.
// Fixed in: pkg/ssa builder (type resolution for imported package types).

package main

func assertInt(v interface{}) {
	n, ok := v.(int32)
	if ok {
		println("ok:", n)
	}
}

func main() {
	assertInt(int32(42))
	assertInt("nope")
}
