// A cross-package alias: os.FileMode = fs.FileMode. The alias must resolve to
// fs.FileMode, so a value assigns across the boundary and a method call
// mangles to the fs definition, not to a clone in the re-exporting package.
// stage4's mxh export carries an `alias` line for this; the earlier fallback
// wrote the target's underlying and methods under the alias name, and
// crypto/ec.(*FieldVal).Equals failed to link against secp256k1's definition.
package main

import (
	"io/fs"
	"os"
)

func main() {
	// Termination: a batch program must still be stoppable, so the entry
	// handles the channel the runtime closes on SIGINT/SIGTERM.
	select {
	case <-sigint:
		return
	default:
	}

	var m os.FileMode = 420 // 0o644
	var f fs.FileMode = m
	if f != m {
		panic("cross-package alias is not the same type")
	}
	if f.IsDir() {
		panic("regular file reported as a directory")
	}
	if f.Perm() != 420 {
		panic("method through the alias returned the wrong bits")
	}
	if !f.IsRegular() {
		panic("regular file not reported as regular")
	}
	println(f.Perm())
}
