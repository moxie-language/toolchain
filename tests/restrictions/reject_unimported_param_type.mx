// expected: undefined: fmt
//
// The NON-variadic form of the unimported-qualifier rule: a parameter type
// whose package is not imported is undefined.
//
// Stage4 used to accept this source and miscompile it. The checker's type
// resolver answered a qualified name that was not in scope from the global
// short-name map, so it looked like a legitimate type - and when that map did
// not have the package either (an unimported package is not loaded at all, so
// it is not in the Registry), the resolver returned nil and NO error was
// raised. The parameter ended up with an empty type, the function still
// type-checked, and the call returned an empty string at runtime:
//
//	panic: got [] want [7]
//
// The variadic form is pinned by reject_unimported_pkg_type; it was caught
// earlier only because the DotsType branch reports an unresolved element type.
// Both resolvers now report `undefined: <pkg>` when a qualified name is in no
// scope, instead of resolving it by name, so the two compilers agree: legacy
// rejects this source with `undefined: fmt`.
package main

func f(x fmt.Stringer) (s string) {
	return x.String()
}

func main() {
	s := f(int32(7))
	if s != "7" {
		panic(s)
	}
}
