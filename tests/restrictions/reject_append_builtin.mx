// expected: undefined: append
//
// append is not a builtin in Moxie in any spelling. push, pop and resize are
// the slice mutators, and the compiler keeps no append lowering at all - the
// internal __moxie_append alias that used to survive for the compiler's own
// packages is gone too (pinned by reject_internal_append.mx). The name has to
// be undefined rather than a special error so that a user may declare its own
// `append`.
package main

func main() {
	xs := []byte{:1}
	_ = append(xs, 'a')
}
