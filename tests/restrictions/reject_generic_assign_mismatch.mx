// An instantiated generic is identified by its ORIGIN AND ITS ARGUMENTS:
// Box[int32] and Box[uint32] are different types even though they share one
// declaration. stage4 used to compare only the origin, so this assignment was
// accepted while legacy (go/types) rejected it.
//
// expected: cannot use
package main

type Box[T comparable] struct {
	V T
}

func main() {
	select {
	case <-shutdown:
		return
	default:
	}
	var a Box[int32]
	a.V = 7
	var b Box[uint32] = a
	println(b.V)
}
