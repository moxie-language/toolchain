// expected: cannot refer to unexported method seal
//
// An interface method whose name is unexported belongs to the package that
// declares the interface; another package cannot name it. Legacy reports
// "s.seal undefined (cannot refer to unexported method seal)" and stage4 used
// to compile the call and dispatch on the name.
package main

import "tests/restrictions/lib/unexported"

func main() {
	s := unexported.Make(1)
	println(s.seal())
}
