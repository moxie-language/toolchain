// expected: undefined: fmt.Stringer
//
// The QUALIFIED form of the field-type rule: `fmt` is not imported, so the
// field type is undefined and the declaration must be rejected rather than
// accepted with a nil field.
package main

type S struct {
	n fmt.Stringer
}

func main() {
	s := S{}
	println("n=[" | s.n.String() | "]")
}
