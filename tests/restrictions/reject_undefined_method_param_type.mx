// expected: undefined: Undefined
//
// A METHOD's signature, not a function's. `func (s *S) m(x Undefined)` built
// with rc=0 and then crashed at run time (the same nil-parameter-type leak as
// reject_undefined_param_type), because the signature rule only ran for
// non-generic top-level functions.
//
// It applies here for the same reason and with the same limit: a method on a
// non-generic receiver cannot declare type parameters, so every name in its
// signature must resolve. A method on a GENERIC receiver is excluded - its
// receiver's type params are not in scope when the signature is resolved - and
// generic_receiver_param_type is the guard that keeps that true.
package main

type S struct {
	n int32
}

func (s *S) m(x Undefined) (r string) {
	return x.String()
}

func main() {
	s := S{n: 1}
	if s.m(int32(7)) != "7" {
		panic("m")
	}
}
