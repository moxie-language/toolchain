// expected: cannot refer to unexported field tag
//
// Unexported names are package-private at the composite-literal boundary too:
// lib.Holder's `tag` may be written only inside package lib. stage4 used to
// compile this and write the field.
package main

import "tests/restrictions/reject_unexported_field_literal/lib"

func main() {
	select {
	case <-shutdown:
		return
	default:
	}
	h := &lib.Holder{tag: 7}
	println(lib.Tag(h).String())
}
