// expected: has no field or method
//
// A selector that is neither a field nor a method on a struct must be an
// error. stage4 used to drop the failed lookup and let the emitter dereference
// nothing, which turned a typo into invalid wasm (the relay-proxy worker was
// rejected by the browser's validator with "popping value from empty stack").
package main

type inner struct {
	a int32
}

type outer struct {
	in inner
}

func main() {
	o := outer{}
	o.in.b = 5
	println(o.in.a)
}
