// D19 rule 5 through an Edge field: e.Send is a Sender (send-only) and e.Recv
// is a Receiver (receive-only), so the opposite operation is a compile error
// whether it is written against a bare end or through the pair.
//
// expected: cannot receive from send-only channel
package main

func main() {
	select {
	case <-shutdown:
		return
	default:
	}
	var e Edge[int32, int32]
	v := <-e.Send
	println(v)
}
