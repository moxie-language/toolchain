// expected: undefined: Undefined
//
// A type ARGUMENT that resolves to nothing, in a parameter type. The walker that
// explains a nil parameter type has to reach the index list of a multi-argument
// instantiation: the single-argument form is caught (`Box[Undefined]` recurses
// into a plain name), but `Pair[Undefined, string]` is a list, and this built
// with rc=0 before the ListExpr case was added.
//
// Gated the same way as reject_undefined_param_type: this rule runs only for a
// non-generic top-level function, where no type parameter of the declaration
// itself can appear in the type.
package main

type Pair[K comparable, V comparable] struct {
	k K
	v V
}

func f(p Pair[Undefined, string]) (n int32) {
	return int32(len(p.v))
}

func main() {
	var p Pair[string, string]
	if f(p) != 0 {
		panic("f")
	}
}
