// expected: cannot use a slice type as a value
package main

func main() {
	// A type is not a value. Both of these used to be ACCEPTED: buildExpr
	// returned nil for the type node, the short-var path printed a diagnostic
	// to stderr and carried on with an Int32 placeholder, and the build exited
	// 0 - so `x` became an int32 and the trailing `+ 1` vanished.
	x := []int32
	y := []chan int32 + 1
	println(len(x), len(y))
}
