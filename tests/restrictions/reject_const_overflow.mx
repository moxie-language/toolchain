// expected: overflows
//
// A constant must fit its target type. stage4 materialized constants at their
// default type and compared only kind classes, so `var x int8 = 1000`
// compiled and printed the wrapped value, where legacy reports "cannot use
// 1000 (untyped int constant) as int8 value in variable declaration
// (overflows)". The same check covers a negative value in an unsigned type.
package main

func main() {
	var x int8 = 1000
	println(x)
}
