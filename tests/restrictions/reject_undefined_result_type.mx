// expected: undefined: Undefined
//
// A BARE undefined RESULT type. Same leak as the parameter form pinned by
// reject_undefined_param_type, and measured the same way: this built with rc=0
// and then failed its own assertion at run time, because the result type came
// back nil and the value it carried was nothing.
//
// The signature report covers parameters and results together at the one site
// where neither can be a type parameter - a non-generic top-level function.
package main

func f() (r Undefined) {
	return r
}

func main() {
	v := f()
	if v.String() != "x" {
		panic("f")
	}
}
