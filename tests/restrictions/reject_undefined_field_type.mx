// expected: undefined: Undefined
//
// A STRUCT FIELD type, in a type declaration. This was a silent miscompile:
//
//     type S struct { n Undefined }
//     s := S{}
//     println("n=[" | s.n.String() | "]")     // built rc=0, printed NOTHING
//
// A struct type resolves even when a field type does not, so the declaration
// was accepted, the field was typed nil, and every use of it compiled away
// without a word. The signature rule cannot see this - it walks parameter and
// result types - so the declaration is checked directly.
package main

type S struct {
	n Undefined
}

func main() {
	s := S{}
	println("n=[" | s.n.String() | "]")
}
