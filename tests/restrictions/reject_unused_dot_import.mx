// expected: "math" imported and not used
//
// A dot import binds the imported package's members in the file scope instead
// of binding a name, so the unused-import check has to look for the members
// rather than for the package name. go/types reports an unused dot import the
// same way it reports a named one; stage4 did not report it at all, which was
// the last gap in this check.
package main

import . "math"

func main() {
	println(int32(1))
}
