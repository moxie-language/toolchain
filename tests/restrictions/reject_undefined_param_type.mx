// expected: undefined: Undefined
//
// A BARE undefined parameter type, in the non-variadic form. This is the leak
// measured in round 85: the source built with rc=0 and only failed at run time
// (the call returned an empty string, so `s != "7"` panicked), because the
// checker left the parameter type nil and nothing reported the name.
//
// The qualified form of the same leak is pinned by reject_unimported_param_type.
// The bare form is reported only for a declaration that cannot have type
// parameters of its own - a non-generic top-level function - because an unbound
// type parameter looks exactly like this to the resolver, and methods are
// excluded for the same reason (a generic receiver's type params are not in
// scope when its signature is resolved).
package main

func f(x Undefined) (s string) {
	return x.String()
}

func main() {
	s := f(int32(7))
	if s != "7" {
		panic(s)
	}
}
