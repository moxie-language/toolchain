// expected: undefined: Undefined
//
// The undefined name is not always at the top of the parameter type: `*Undefined`
// failed to resolve because its ELEMENT did, exactly as `*fmt.Stringer` did in
// reject_unimported_ptr_param_type. Both built with rc=0 before their round and
// died at run time.
//
// This fixture also pins the diagnostic: the reported name is the one that does
// not resolve, not the first name in the type. The walk goes through the
// constructors and asks the resolver about each name it finds, so a type whose
// first name is fine and whose second is not (`map[string]Undefined` below)
// reports the second.
package main

func ptr(x *Undefined) (s string) {
	return x.Name
}

func sliceFn(x []Undefined) (n int32) {
	return int32(len(x))
}

func mapVal(x map[string]Undefined) (n int32) {
	return int32(len(x))
}

func main() {
	ptr(nil)
	sliceFn(nil)
	mapVal(nil)
}
