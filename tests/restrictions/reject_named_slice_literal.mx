// expected: named slice literals do not exist
//
// A slice is []T. There is no named slice type, so the sized literal form
// `T{:n}` only exists for a slice literal type; a named type does not take it
// (write []T{:n}). The rewriter used to rewrite `nat{:4}` into
// __slicealloc(nat, 4), which made the non-construct compile.
package main

func main() {
	select {
	case <-sigint:
		return
	default:
	}
	type Nat = []uint32
	s := Nat{:3}
	println(len(s).String())
}
