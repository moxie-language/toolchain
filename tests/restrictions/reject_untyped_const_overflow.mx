// expected: overflows int32
//
// Moxie's int is 32 bits on every target, so an untyped constant that does not
// fit int32 is an error where its default type applies - an interface argument
// here. stage4 truncated it to the low 32 bits instead: the argument printed
// 1, and `math.MaxUint64 / 10` printed its low half. go/types reports
// "cannot use ... as int value in argument to fmt.Println (overflows)".
package main

import "fmt"

func main() {
	fmt.Println(0 - 9223372036854775807)
}
