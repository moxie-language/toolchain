// expected: undefined: Undefined
//
// A FUNC LITERAL's signature. `f := func(x Undefined) (r string) { ... }` built
// with rc=0 and then aborted at run time - the same nil-parameter-type leak as
// the function and method forms, at the third and last place a signature can be
// written.
//
// The rule applies where the enclosing body is NOT a generic instantiation,
// because a literal there cannot name a type parameter of its own. A literal
// inside a generic body is excluded: it may legitimately use the enclosing type
// parameters, which are not in the resolving scope and look exactly like a typo.
// generic_funclit_param_type is the guard for that exclusion.
package main

func main() {
	f := func(x Undefined) (r string) {
		return x.String()
	}
	if f(int32(7)) != "7" {
		panic("f")
	}
}
