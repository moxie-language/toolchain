package unexported

// Sealed declares an unexported method, so a type from another package can
// never implement it: method identity includes the package for an unexported
// name.
type Sealed interface {
	seal() (n int32)
}

type box struct {
	n int32
}

func (b *box) seal() (n int32) { return b.n }

// Make returns a Sealed so a caller has a value to try the call on.
func Make(n int32) (s Sealed) { return &box{n: n} }
