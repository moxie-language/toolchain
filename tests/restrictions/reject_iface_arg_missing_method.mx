// expected: does not implement fmt.Stringer (missing method String)
//
// A concrete value assigned to a non-empty interface must provide every method
// the interface names. The checker skipped this direction because an
// interface's method set may not be resolved yet, and the skip covered the
// destination as well as the source: `take(xs)` with xs []int32 and
// take(s fmt.Stringer) compiled, and the emitter rendered '?' for the value at
// run time. Legacy reports "[]int32 does not implement fmt.Stringer (missing
// method String)".
//
// The verdict runs in a package post-pass, not at the assignment: os.File.Stat
// is declared in stat_unix.mx, after file.mx, so a method set read while the
// earlier file is being built is missing methods that exist.
package main

import (
	"fmt"
)

func take(s fmt.Stringer) (n int32) { return len(s.String()) }

func main() {
	xs := []int32{1, 2, 3}
	println(take(xs))
}
