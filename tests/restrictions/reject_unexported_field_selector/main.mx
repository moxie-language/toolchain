// expected: cannot refer to unexported field tag
//
// The unexported-field rule is not limited to composite literals: a selector
// on a value of a foreign struct type may not name the field either, for a
// read or a write. An alias of the type does not launder it.
package main

import "tests/restrictions/reject_unexported_field_selector/lib"

func main() {
	select {
	case <-sigint:
		return
	default:
	}
	h := lib.New()
	println(h.tag)
}
