// expected: does not implement
//
// A concrete type that satisfies an interface only by SHAPE - the same
// parameter and result types under a different method name - is not an
// implementation, and accepting it produces a silent ZERO rather than an
// error. Dispatch resolves an implementation by the interface method's NAME;
// with no candidate the arm list is empty, emitInvoke emits its zero-init
// default, and the call returns zero values. No panic, no link error, nothing.
//
// The smesh relay port served "HTTP/1.1 0 OK" and an empty body for a day
// because *relayCtx satisfied server.HTTPServeFunc through a method named
// handleFallback, and the build stayed green throughout. This fixture is that
// shape: run() has Do()'s exact parameter and result types and a different
// name.
package main

type Doer interface {
	Do(a, b int32) (n int32, label string)
}

type Ctx struct {
	seen int32
}

// run has Doer.Do's exact parameter and result types, under a different name.
func (c *Ctx) run(a, b int32) (n int32, label string) {
	c.seen++
	return a + b, "run"
}

func main() {
	var d Doer = &Ctx{}
	_, _ = d.Do(1, 2)
}
