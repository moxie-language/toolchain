// expected: must be declared with exactly one result
package main

// A spawned function reports termination through the breaker channel spawn
// returns, so its one result must be that breaker - not a value.
func worker(in chan int32) (n int32) {
	<-in
	return 0
}

func main() {
	ch := chan int32{}
	done := spawn(worker, ch)
	<-done
}
