// D19 rule 5: a receive-only end cannot be written to. The role is a property
// of the OPERATION, not only of the type. Legacy gets this from go/types;
// stage4 accepted it and emitted a send on the receive ring, which is the
// silent corruption this fixture exists to prevent.
//
// expected: cannot send to receive-only channel
package main

func bad(c <-chan int32) {
	c <- 1
}

func main() {
	select {
	case <-shutdown:
		return
	default:
	}
}
