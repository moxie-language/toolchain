// expected: type int32 has no field or method Nope
//
// A method call on a non-struct value must fail loud. stage4 only checked
// selectors that produce a value (struct fields); the call path returned nil
// on a failed method lookup, so `n.Nope()` fell through to the emitter and
// built a call through garbage. Legacy reports it through go/types:
// "n.Nope undefined (type int32 has no field or method Nope)".
package main

func main() {
	n := int32(5)
	n.Nope()
}
