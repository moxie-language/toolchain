// expected: init() is not allowed in main package
//
// A main package's setup belongs in main(), which is the program entry; an
// init() there would run before it with no defined place in the entry
// sequence. Legacy rejects it outright. stage4 used to print "init() is not
// allowed" and then skip the function, so the program built and the init never
// ran - a silent difference, not a rejection.
//
// A library package may have exactly one init(), which runs after its
// package-level variable initializers and before any importer's.
package main

func init() {
	println("setup")
}

func main() {
	println("body")
}
