// expected: undefined: Undefined
//
// A FUNCTION-LOCAL type declaration with an undefined field. This was a
// compiler CRASH, not just a miscompile: the struct resolved with a nil field
// type, the body built a composite literal of it, and litFullyCovers /
// buildCompositeLit died with SIGSEGV (measured with the committed round-93
// compiler). The local declaration is now checked like a package-level one, and
// a type whose field did not resolve is NOT registered, so the body cannot
// build a value of a type that has a nil field.
package main

func f() (r string) {
	type inner struct {
		n Undefined
	}
	x := inner{}
	return x.n.String()
}

func main() {
	println("lit=[" | f() | "]")
}
