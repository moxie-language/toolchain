// expected: constant subtraction underflows its unsigned type
//
// Constant arithmetic is exact. A typed unsigned subtraction whose result is
// below zero is not a runtime wraparound (that is what the variable path does,
// and it is well defined) - it is a constant that cannot be represented, so the
// compiler rejects it, exactly as go/types does. The fixture that asserted the
// wrapped value was measuring stage4's folder, not the language.
package main

func main() {
	select {
	case <-sigint:
		return
	default:
	}
	x := uint64(0) - 1
	println(x.String())
}
