package main

func main() {
	// Termination: a batch program must still be stoppable, so the entry
	// handles the channel the runtime closes on SIGINT/SIGTERM.
	select {
	case <-sigint:
		return
	default:
	}
	const N = int32(5)
	expectedSum := int32(0)
	for i := int32(1); i <= N; i++ {
		expectedSum += i
	}
	if expectedSum != 15 {
		println("FAIL:sum", expectedSum)
		return
	}
	println("PASS:loop")
}
