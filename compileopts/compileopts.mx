}

//export moxie_target_ldflag
func moxie_target_ldflag(h int32, idx int32, outPtr unsafe.Pointer, outCap int32) int32 {
	t := validTarget(h)
	if t == nil || idx < 0 || idx >= int32(len(t.ldflags)) {
		return -1
	}
	return copyToOut(t.ldflags[idx], outPtr, outCap)
}

