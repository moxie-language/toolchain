package main

import "testpkg/lib"

type pkgInfo struct {
	path    string
	name    string
	files   []string
	imports []string
}

func discoverPkg(path string) (p *pkgInfo) {
	return &pkgInfo{path: path, name: "test", files: []string{"existing.mx"}}
}

func hasImportStr(imports []string, pkg string) (ok bool) {
	for _, imp := range imports {
		if imp == pkg {
			return true
		}
	}
	return false
}

func cmdTest() {
	testPkgDir := "/tmp/test"
	testFiles := lib.ListFiles(testPkgDir)
	if len(testFiles) == 0 {
		println("no files")
		return
	}

	var allTestFuncs []string
	for _, tf := range testFiles {
		_ = tf
		allTestFuncs = append(allTestFuncs, "TestX")
	}
	println("funcs: " | int32(len(allTestFuncs)).String())

	var pkgName string
	for _, tf := range testFiles {
		if pkgName == "" {
			_ = tf
			pkgName = "main"
		}
	}

	testMainFile := "/tmp/testmain.mx"

	pkg := discoverPkg("test")

	for _, tf := range testFiles {
		pkg.files = append(pkg.files, tf)
	}
	pkg.files = append(pkg.files, testMainFile)
	pkg.name = "main"

	if !hasImportStr(pkg.imports, "testing") {
		pkg.imports = append(pkg.imports, "testing")
	}

	println("files: " | int32(len(pkg.files)).String())
}

func main() {
	cmdTest()
}
