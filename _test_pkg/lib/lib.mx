package lib

func Hello() (s string) {
	return "hello from lib"
}

func MakeNames() (ss []string) {
	return []string{"alice", "bob", "carol"}
}

func ListFiles(dir string) (ss []string) {
	return []string{dir | "/a.mx", dir | "/b.mx", dir | "/c.mx"}
}

type Item struct {
	Name  string
	Value int32
}

func NewItem(name string, val int32) (i *Item) {
	return &Item{Name: name, Value: val}
}
