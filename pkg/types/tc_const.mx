package types

import (
	"math/big"
	"strconv"

	"git.smesh.lol/moxie/pkg/mxutil"
	"git.smesh.lol/moxie/pkg/syntax"
	"git.smesh.lol/moxie/pkg/token"
)







func EvalBasicLitLocal(e *syntax.BasicLit) (c ConstVal) {
	switch e.Kind {
	case token.IntLit:
		// A literal whose exact value is >= 2^63 (0xFFFFFFFFFFFFFFFF, 1<<63's
		// decimal spelling) keeps its low bits in V, so it must carry the
		// unsigned mark like any other folded constant: without it a float
		// comparison against `9223372036854775808` used the signed text and
		// was true for every value.
		return intConst(uint64(ParseIntLocal(e.Value)))
	case token.FloatLit:
		f := parseFloatLocal(e.Value)
		return &ConstFloat{V:f, Lit:e.Value, Exact:ExactFloatText(e.Value)}
	case token.StringLit:
		s := interpStringLocal(e.Value)
		return &ConstStr{S:s}
	case token.RuneLit:
		s := interpStringLocal(e.Value)
		if len(s) > 0 {
			return &ConstInt{V:int64(decodeFirstRune(s))}
		}
		return &ConstInt{V:0}
	}
	return nil
}

func ParseIntLocal(s string) (n int64) {
	if len(s) == 0 {
		return 0
	}
	neg := false
	i := 0
	if s[0] == '-' {
		neg = true
		i = 1
	} else if s[0] == '+' {
		i = 1
	}
	base := int64(10)
	if i < len(s)-1 && s[i] == '0' {
		c := s[i+1]
		if c == 'x' || c == 'X' {
			base = 16
			i += 2
		} else if c == 'o' || c == 'O' {
			base = 8
			i += 2
		} else if c == 'b' || c == 'B' {
			base = 2
			i += 2
		} else if c >= '0' && c <= '7' {
			base = 8
			i += 1
		}
	}
	for ; i < len(s); i++ {
		ch := s[i]
		if ch == '_' {
			continue
		}
		var d int64
		if ch >= '0' && ch <= '9' {
			d = int64(ch - '0')
		} else if ch >= 'a' && ch <= 'f' {
			d = int64(ch-'a') + 10
		} else if ch >= 'A' && ch <= 'F' {
			d = int64(ch-'A') + 10
		} else {
			break
		}
		n = n*base + d
	}
	if neg {
		return -n
	}
	return n
}

// parseFloatLocal reads a floating-point literal. The hand-rolled decimal
// scan that used to live here had no hex-float support (0x1p1023 parsed as 0)
// and built its decimal exponent by repeated multiplication (imprecise for
// negative exponents and overflowing for large ones), so math.MaxFloat64
// folded to 0 and every constant derived from it was wrong. strconv's parser
// is correctly rounded and covers every Go literal form.
func parseFloatLocal(s string) (f float64) {
	v, err := strconv.ParseFloat(s, 64)
	if err != nil {
		return 0.0
	}
	return v
}

func interpStringLocal(s string) (sv string) {
	if len(s) < 2 {
		return s
	}
	if s[0] == '`' {
		return s[1 : len(s)-1]
	}
	quote := s[0]
	if quote != '"' && quote != '\'' {
		return s
	}
	s = s[1 : len(s)-1]
	hasEsc := false
	for i := 0; i < len(s); i++ {
		if s[i] == '\\' {
			hasEsc = true
			break
		}
	}
	if !hasEsc {
		return s
	}
	var buf []byte
	for i := 0; i < len(s); i++ {
		if s[i] != '\\' {
			buf = mxutil.Ensure(buf, 1)
			push(buf, s[i])
			continue
		}
		i++
		if i >= len(s) {
			break
		}
		switch s[i] {
		case 'n':
			buf = mxutil.Ensure(buf, 1)
			push(buf, '\n')
		case 't':
			buf = mxutil.Ensure(buf, 1)
			push(buf, '\t')
		case 'r':
			buf = mxutil.Ensure(buf, 1)
			push(buf, '\r')
		case '\\':
			buf = mxutil.Ensure(buf, 1)
			push(buf, '\\')
		case '\'':
			buf = mxutil.Ensure(buf, 1)
			push(buf, '\'')
		case '"':
			buf = mxutil.Ensure(buf, 1)
			push(buf, '"')
		case '0':
			buf = mxutil.Ensure(buf, 1)
			push(buf, 0)
		case 'a':
			buf = mxutil.Ensure(buf, 1)
			push(buf, '\a')
		case 'b':
			buf = mxutil.Ensure(buf, 1)
			push(buf, '\b')
		case 'f':
			buf = mxutil.Ensure(buf, 1)
			push(buf, '\f')
		case 'v':
			buf = mxutil.Ensure(buf, 1)
			push(buf, '\v')
		case 'x':
			if i+2 < len(s) {
				h := hexDigit(s[i+1])*16 + hexDigit(s[i+2])
				buf = mxutil.Ensure(buf, 1)
				push(buf, byte(h))
				i += 2
			}
		case 'u':
			if i+4 < len(s) {
				r := rune(hexDigit(s[i+1]))*4096 + rune(hexDigit(s[i+2]))*256 + rune(hexDigit(s[i+3]))*16 + rune(hexDigit(s[i+4]))
				buf = appendRuneUTF8(buf, r)
				i += 4
			}
		case 'U':
			if i+8 < len(s) {
				var r rune
				for j := 1; j <= 8; j++ {
					r = r*16 + rune(hexDigit(s[i+j]))
				}
				buf = appendRuneUTF8(buf, r)
				i += 8
			}
		default:
			if s[i] >= '0' && s[i] <= '7' {
				v := int32(s[i] - '0')
				if i+1 < len(s) && s[i+1] >= '0' && s[i+1] <= '7' {
					v = v*8 + int32(s[i+1]-'0')
					i++
					if i+1 < len(s) && s[i+1] >= '0' && s[i+1] <= '7' {
						v = v*8 + int32(s[i+1]-'0')
						i++
					}
				}
				buf = mxutil.Ensure(buf, 1)
				push(buf, byte(v))
			} else {
				buf = mxutil.Ensure(buf, 1)
				push(buf, s[i])
			}
		}
	}
	return string(buf)
}

func hexDigit(c byte) (n int32) {
	if c >= '0' && c <= '9' {
		return int32(c - '0')
	}
	if c >= 'a' && c <= 'f' {
		return int32(c-'a') + 10
	}
	if c >= 'A' && c <= 'F' {
		return int32(c-'A') + 10
	}
	return 0
}

func appendRuneUTF8(buf []byte, r rune) (buf2 []byte) {
	if r < 0x80 {
		buf = mxutil.Ensure(buf, 1)
		push(buf, byte(r))
		return buf
	}
	if r < 0x800 {
		buf = mxutil.Ensure(buf, 1)
		push(buf, byte(0xC0|(r>>6)), byte(0x80|(r&0x3F)))
		return buf
	}
	if r < 0x10000 {
		buf = mxutil.Ensure(buf, 1)
		push(buf, byte(0xE0|(r>>12)), byte(0x80|((r>>6)&0x3F)), byte(0x80|(r&0x3F)))
		return buf
	}
	buf = mxutil.Ensure(buf, 1)
	push(buf, byte(0xF0|(r>>18)), byte(0x80|((r>>12)&0x3F)), byte(0x80|((r>>6)&0x3F)), byte(0x80|(r&0x3F)))
	return buf
}


func EvalUnaryLocal(op token.Operator, x ConstVal) (c ConstVal) {
	switch op {
	case token.Add:
		return x
	case token.Sub:
		if ci, ok := x.(*ConstInt); ok {
			return &ConstInt{V:-ci.V}
		}
		if cf, ok := x.(*ConstFloat); ok {
			neg := ""
			if cf.Lit != "" {
				neg = "-" | cf.Lit
			}
			r := floatExact(cf)
			if r == nil {
				return &ConstFloat{V:-cf.V, Lit:neg}
			}
			nr := big.NewRat(0, 1)
			nr.Neg(r)
			f, _ := nr.Float64()
			return &ConstFloat{V:f, Lit:neg, Exact:nr}
		}
	case token.Xor:
		if ci, ok := x.(*ConstInt); ok {
			if ci.Unsigned {
				return intConst(^uint64(ci.V))
			}
			return &ConstInt{V:^ci.V}
		}
	case token.Not:
		if cb, ok := x.(*ConstBool); ok {
			return &ConstBool{V:!cb.V}
		}
	}
	return nil
}

// cvUnsigned reports whether an integer constant's exact value is
// non-negative but too large for the signed 64-bit slot.
func cvUnsigned(v ConstVal) (ok bool) {
	if ci, matched := v.(*ConstInt); matched {
		return ci.Unsigned
	}
	return false
}

// cvUint reads the low 64 bits of an integer constant without sign extension.
func cvUint(v ConstVal) (u uint64) {
	return uint64(cvInt(v))
}

// intConst rebuilds a folded integer constant, marking it unsigned when the
// exact mathematical value stays non-negative but does not fit in an int64.
// Shedding the mark when the value fits signed keeps genuinely negative
// constants (a literal -1) on the signed path.
func intConst(v uint64) (c ConstVal) {
	if v > 1<<63-1 {
		return &ConstInt{V:int64(v), Unsigned:true}
	}
	return &ConstInt{V:int64(v)}
}

// unsignedFold reports whether integer arithmetic between x and y must be done
// in the unsigned domain: either side already carries a value >= 2^63.
func unsignedFold(x ConstVal, y ConstVal) (ok bool) {
	return cvUnsigned(x) || cvUnsigned(y)
}


// floatExact returns a constant's exact value as a rational. Integer constants
// are exact by construction; a float constant carries the rational its folds
// produced, and one that has none falls back to the exact value of its float64
// (every finite float64 is a rational). A non-finite value has no rational, so
// the caller falls back to float64 arithmetic.
func floatExact(v ConstVal) (r *big.Rat) {
	if cf, isFloat := v.(*ConstFloat); isFloat {
		if cf.Exact != nil {
			return cf.Exact
		}
		q := big.NewRat(0, 1)
		if q.SetFloat64(cf.V) == nil {
			return nil
		}
		return q
	}
	if ci, isInt := v.(*ConstInt); isInt {
		if ci.Unsigned && ci.V < 0 {
			q := big.NewRat(0, 1)
			q.SetUint64(uint64(ci.V))
			return q
		}
		return big.NewRat(ci.V, 1)
	}
	return nil
}

// floatConstOf re-presents a constant as a float constant carrying its exact
// value, so a mixed int/float operation stays in the float domain without
// rounding the integer through float64 first.
func floatConstOf(v ConstVal) (c ConstVal) {
	r := floatExact(v)
	if r == nil {
		return &ConstFloat{V:cvFloat(v)}
	}
	f, _ := r.Float64()
	return &ConstFloat{V:f, Exact:r}
}

// floatOp folds a float binary operation exactly, as go/types does. The
// difference is visible: 0.1+0.2 == 0.3 is true as constants and
// 1.0/3.0 == 0.3333333333333333 is false.
func floatOp(op token.Operator, x ConstVal, y ConstVal) (c ConstVal) {
	xr := floatExact(x)
	yr := floatExact(y)
	if xr == nil || yr == nil {
		xf := cvFloat(x)
		yf := cvFloat(y)
		switch op {
		case token.Add:
			return &ConstFloat{V:xf + yf}
		case token.Sub:
			return &ConstFloat{V:xf - yf}
		case token.Mul:
			return &ConstFloat{V:xf * yf}
		case token.Div:
			if yf == 0.0 {
				return &ConstFloat{V:0.0}
			}
			return &ConstFloat{V:xf / yf}
		}
		return nil
	}
	r := big.NewRat(0, 1)
	switch op {
	case token.Add:
		r.Add(xr, yr)
	case token.Sub:
		r.Sub(xr, yr)
	case token.Mul:
		r.Mul(xr, yr)
	case token.Div:
		if yr.Sign() == 0 {
			return &ConstFloat{V:0.0}
		}
		r.Quo(xr, yr)
	default:
		return nil
	}
	f, _ := r.Float64()
	return &ConstFloat{V:f, Exact:r}
}

// floatCompare compares two numeric constants exactly. Comparing the rounded
// float64 made `math.MaxFloat64 == 1.7976931348623157e308` true - the decimal
// rounds to the binary value - while go/types compares the exact rationals.
func floatCompare(x ConstVal, y ConstVal) (cmp int32) {
	xr := floatExact(x)
	yr := floatExact(y)
	if xr == nil || yr == nil {
		xf := cvFloat(x)
		yf := cvFloat(y)
		if xf < yf {
			return -1
		}
		if xf > yf {
			return 1
		}
		return 0
	}
	return xr.Cmp(yr)
}

// ExactFloatText parses a constant's exported text into its exact value:
// "num/den" from a folded constant, a decimal float, or a C99 hex float. The
// .mxh round trip carries the value through this, so an imported constant
// compares exactly rather than as the nearest float64.
func ExactFloatText(s string) (r *big.Rat) {
	if r = hexFloatRat(s); r != nil {
		return r
	}
	q := big.NewRat(0, 1)
	if _, ok := q.SetString([]byte(s)); ok {
		return q
	}
	return nil
}

// hexFloatRat parses 0x<hex>[.<hex>][p<exp>] exactly, which Rat.SetString does
// not accept; the stdlib writes its IEEE boundaries this way (0x1p1023). The
// mantissa is an integer and the exponent a binary shift, so no step rounds.
func hexFloatRat(s string) (r *big.Rat) {
	i := 0
	neg := false
	if len(s) > 0 && (s[0] == '-' || s[0] == '+') {
		neg = s[0] == '-'
		i = 1
	}
	if i+2 > len(s) || s[i] != '0' || (s[i+1] != 'x' && s[i+1] != 'X') {
		return nil
	}
	i += 2
	digits := []byte{}
	frac := int32(0)
	seenDot := false
	for i < len(s) {
		c := s[i]
		if c == '.' {
			seenDot = true
			i++
			continue
		}
		if c == 'p' || c == 'P' {
			break
		}
		if !isHexDigit(c) {
			return nil
		}
		digits = mxutil.Ensure(digits, 1)
		digits = push(digits, c)
		if seenDot {
			frac++
		}
		i++
	}
	if len(digits) == 0 {
		return nil
	}
	exp := int32(0)
	if i < len(s) && (s[i] == 'p' || s[i] == 'P') {
		exp = decTextInt32(s[i+1:])
	}
	num := big.NewInt(0)
	if _, ok := num.SetString(digits, 16); !ok {
		return nil
	}
	q := big.NewRat(0, 1)
	shift := exp - 4*frac
	if shift >= 0 {
		num.Lsh(num, uint32(shift))
		q.SetInt(num)
	} else {
		den := big.NewInt(1)
		den.Lsh(den, uint32(-shift))
		q.SetFrac(num, den)
	}
	if neg {
		q.Neg(q)
	}
	return q
}

func isHexDigit(c byte) (ok bool) {
	return c >= '0' && c <= '9' || c >= 'a' && c <= 'f' || c >= 'A' && c <= 'F'
}

func decTextInt32(s string) (n int32) {
	i := 0
	neg := false
	if i < len(s) && (s[i] == '-' || s[i] == '+') {
		neg = s[i] == '-'
		i++
	}
	for i < len(s) {
		c := s[i]
		if c < '0' || c > '9' {
			break
		}
		n = n*10 + int32(c-'0')
		i++
	}
	if neg {
		return -n
	}
	return
}

func EvalBinaryLocal(op token.Operator, x ConstVal, y ConstVal) (c ConstVal) {
	// Untyped constant arithmetic mixes kinds: an integer operand against a
	// float operand is a float operation. Every branch below tests the left
	// operand first, so `1 - 0x1p-52` ran in integer space (cvInt of the float
	// is 0) and folded to 1; math.MaxFloat64 is 0x1p1023*(1+(1-0x1p-52)), so
	// it folded 2^1023 * 2 and overflowed to +Inf, taking Pow, the float64
	// Stringer and everything else that reads MaxFloat64 with it.
	if _, xFloat := x.(*ConstFloat); xFloat {
		if _, yInt := y.(*ConstInt); yInt {
			y = floatConstOf(y)
		}
	} else if _, yFloat := y.(*ConstFloat); yFloat {
		if _, xInt := x.(*ConstInt); xInt {
			x = floatConstOf(x)
		}
	}
	switch op {
	case token.Add:
		if xi, ok := x.(*ConstInt); ok {
			if unsignedFold(x, y) {
				return intConst(uint64(xi.V) + cvUint(y))
			}
			return &ConstInt{V:xi.V + cvInt(y)}
		}
		if xf, ok := x.(*ConstFloat); ok {
			return floatOp(op, xf, y)
		}
		if xs, ok := x.(*ConstStr); ok {
			return &ConstStr{S:xs.S | cvStr(y)}
		}
	case token.Sub:
		if xi, ok := x.(*ConstInt); ok {
			if unsignedFold(x, y) {
				return intConst(uint64(xi.V) - cvUint(y))
			}
			return &ConstInt{V:xi.V - cvInt(y)}
		}
		if xf, ok := x.(*ConstFloat); ok {
			return floatOp(op, xf, y)
		}
	case token.Mul:
		if xi, ok := x.(*ConstInt); ok {
			if unsignedFold(x, y) {
				return intConst(uint64(xi.V) * cvUint(y))
			}
			return &ConstInt{V:xi.V * cvInt(y)}
		}
		if xf, ok := x.(*ConstFloat); ok {
			return floatOp(op, xf, y)
		}
	case token.Div:
		if xi, ok := x.(*ConstInt); ok {
			if unsignedFold(x, y) {
				du := cvUint(y)
				if du == 0 {
					return &ConstInt{V:0}
				}
				return intConst(uint64(xi.V) / du)
			}
			d := cvInt(y)
			if d == 0 {
				return &ConstInt{V:0}
			}
			return &ConstInt{V:xi.V / d}
		}
		if xf, ok := x.(*ConstFloat); ok {
			return floatOp(op, xf, y)
		}
	case token.Rem:
		if xi, ok := x.(*ConstInt); ok {
			if unsignedFold(x, y) {
				du := cvUint(y)
				if du == 0 {
					return &ConstInt{V:0}
				}
				return intConst(uint64(xi.V) % du)
			}
			d := cvInt(y)
			if d == 0 {
				return &ConstInt{V:0}
			}
			return &ConstInt{V:xi.V % d}
		}
	case token.And:
		if xi, ok := x.(*ConstInt); ok {
			if unsignedFold(x, y) {
				return intConst(uint64(xi.V & cvInt(y)))
			}
			return &ConstInt{V:xi.V & cvInt(y)}
		}
	case token.Or:
		if xi, ok := x.(*ConstInt); ok {
			if unsignedFold(x, y) {
				return intConst(uint64(xi.V | cvInt(y)))
			}
			return &ConstInt{V:xi.V | cvInt(y)}
		}
		if xs, ok := x.(*ConstStr); ok {
			return &ConstStr{S:xs.S | cvStr(y)}
		}
	case token.Xor:
		if xi, ok := x.(*ConstInt); ok {
			if unsignedFold(x, y) {
				return intConst(uint64(xi.V ^ cvInt(y)))
			}
			return &ConstInt{V:xi.V ^ cvInt(y)}
		}
	case token.Shl:
		if xi, ok := x.(*ConstInt); ok {
			shift := uint32(cvInt(y))
			var uv uint64
			if shift < 64 {
				uv = uint64(xi.V) << shift
			}
			if xi.Unsigned {
				return &ConstInt{V:int64(uv), Unsigned:true}
			}
			if shift >= 64 && xi.V != 0 {
				// The exact value is a positive multiple of 2^64, which is
				// at least 2^63 even though the low bits are zero.
				return &ConstInt{V:0, Unsigned:true}
			}
			return intConst(uv)
		}
	case token.Shr:
		if xi, ok := x.(*ConstInt); ok {
			shift := uint32(cvInt(y))
			if xi.Unsigned {
				if shift >= 64 {
					return &ConstInt{V:0}
				}
				return intConst(uint64(xi.V) >> shift)
			}
			if shift >= 64 {
				if xi.V < 0 {
					return &ConstInt{V:-1}
				}
				return &ConstInt{V:0}
			}
			return &ConstInt{V:xi.V >> shift}
		}
	case token.AndNot:
		if xi, ok := x.(*ConstInt); ok {
			if unsignedFold(x, y) {
				return intConst(uint64(xi.V &^ cvInt(y)))
			}
			return &ConstInt{V:xi.V &^ cvInt(y)}
		}
	case token.Eql:
		return &ConstBool{V:constEqual(x, y)}
	case token.Neq:
		return &ConstBool{V:!constEqual(x, y)}
	case token.Lss:
		return &ConstBool{V:constLess(x, y)}
	case token.Leq:
		return &ConstBool{V:constLess(x, y) || constEqual(x, y)}
	case token.Gtr:
		return &ConstBool{V:constLess(y, x)}
	case token.Geq:
		return &ConstBool{V:constLess(y, x) || constEqual(x, y)}
	case token.OrOr:
		xb, xok := x.(*ConstBool)
		yb, yok := y.(*ConstBool)
		if xok && yok {
			return &ConstBool{V:xb.V || yb.V}
		}
	case token.AndAnd:
		xb, xok := x.(*ConstBool)
		yb, yok := y.(*ConstBool)
		if xok && yok {
			return &ConstBool{V:xb.V && yb.V}
		}
	}
	return nil
}

func constEqual(x ConstVal, y ConstVal) (eq bool) {
	if xi, matched := x.(*ConstInt); matched {
		if _, yFloat := y.(*ConstFloat); !yFloat {
			if unsignedFold(x, y) {
				return uint64(xi.V) == cvUint(y)
			}
			return xi.V == cvInt(y)
		}
	}
	if _, matched := x.(*ConstFloat); matched {
		return floatCompare(x, y) == 0
	}
	if xs, matched := x.(*ConstStr); matched {
		return xs.S == cvStr(y)
	}
	if xb, matched := x.(*ConstBool); matched {
		if yb, matched2 := y.(*ConstBool); matched2 {
			return xb.V == yb.V
		}
	}
	return false
}

func constLess(x ConstVal, y ConstVal) (lt bool) {
	if xi, matched := x.(*ConstInt); matched {
		if _, yFloat := y.(*ConstFloat); !yFloat {
			if unsignedFold(x, y) {
				return uint64(xi.V) < cvUint(y)
			}
			return xi.V < cvInt(y)
		}
	}
	if _, matched := x.(*ConstFloat); matched {
		return floatCompare(x, y) < 0
	}
	if xs, matched := x.(*ConstStr); matched {
		return xs.S < cvStr(y)
	}
	return false
}

func ConvertConstLocal(v ConstVal, target Type) (c ConstVal) {
	b, isBasic := SafeUnderlying(target).(*Basic)
	if !isBasic {
		return v
	}
	switch {
	case b.Info&IsInteger != 0:
		iv := cvInt(v)
		return MaskConstToBasic(&ConstInt{V:iv}, b)
	case b.Info&IsFloat != 0:
		// An untyped target keeps the exact value; a sized one rounds to it
		// (float32(0.1) is the float32 value, not the decimal literal).
		if b.Info&IsUntyped != 0 {
			return floatConstOf(v)
		}
		fv := cvFloat(v)
		if b.Kind == Float32 {
			fv = float64(float32(fv))
		}
		q := big.NewRat(0, 1)
		if q.SetFloat64(fv) == nil {
			return &ConstFloat{V:fv}
		}
		return &ConstFloat{V:fv, Exact:q}
	case b.Info&IsString != 0:
		if cvKind(v) == 3 {
			n := cvInt(v)
			return &ConstStr{S:runeToStr(rune(n))}
		}
		return v
	}
	return v
}

// MaskConstToBasic truncates a ConstInt to the width and signedness of the
// given sized basic integer type.  Untyped and non-integer types pass
// through unchanged.
func MaskConstToBasic(v ConstVal, b *Basic) (c ConstVal) {
	ci, ok := v.(*ConstInt)
	if !ok || b == nil || b.Info&IsInteger == 0 || b.Info&IsUntyped != 0 {
		return v
	}
	n := ci.V
	switch b.Kind {
	case Int8:
		n = int64(int8(n))
	case Int16:
		n = int64(int16(n))
	case Int32:
		n = int64(int32(n))
	case Uint8:
		n = int64(uint8(n))
	case Uint16:
		n = int64(uint16(n))
	case Uint32:
		n = int64(uint32(n))
	case Int64:
		// A signed 64-bit target is a genuinely signed value.
		return &ConstInt{V:n}
	case Uint64:
		// 64-bit: int64 bit pattern is already exact. Keep the unsigned mark
		// when the exact value is >= 2^63, so a later fold divides it unsigned.
		if ci.Unsigned && n < 0 {
			return &ConstInt{V:n, Unsigned:true}
		}
		return &ConstInt{V:n}
	default:
		return v
	}
	return &ConstInt{V:n}
}

// constExprBasic resolves the basic type of a constant expression, used to
// apply width masking to typed constant operations.  Returns nil when the
// type cannot be determined (untyped literals and untracked forms).

func UntypedTypeOfCV(v ConstVal) (t Type) {
	switch cvKind(v) {
	case 1:
		return Typ[UntypedBool]
	case 3:
		return Typ[UntypedInt]
	case 4:
		return Typ[UntypedFloat]
	case 2:
		return Typ[UntypedString]
	}
	return nil
}

func cvKind(val ConstVal) (n int32) {
	switch val.(type) {
	case *ConstBool:
		return 1
	case *ConstStr:
		return 2
	case *ConstInt:
		return 3
	case *ConstFloat:
		return 4
	case *ConstNil:
		return 0
	}
	return 0
}




func cvInt(v ConstVal) (n int64) {
	if ci, ok := v.(*ConstInt); ok {
		return ci.V
	}
	if cf, ok := v.(*ConstFloat); ok {
		return int64(cf.V)
	}
	return 0
}

func cvFloat(v ConstVal) (f float64) {
	if cf, ok := v.(*ConstFloat); ok {
		return cf.V
	}
	if ci, ok := v.(*ConstInt); ok {
		// An unsigned-marked constant's exact value is >= 2^63 and V holds its
		// low bits, so the signed conversion flips it: `10.0 >= 1<<63` folded
		// to `10.0 >= -9223372036854775808.0` and was true.
		if ci.Unsigned {
			return float64(uint64(ci.V))
		}
		return float64(ci.V)
	}
	return 0
}

func cvStr(v ConstVal) (s string) {
	if cs, ok := v.(*ConstStr); ok {
		return cs.S
	}
	return ""
}

func decodeFirstRune(s string) (n int32) {
	b := s[0]
	if b < 0x80 {
		return int32(b)
	}
	if b < 0xC0 {
		return int32(b)
	}
	if b < 0xE0 && len(s) >= 2 {
		return int32(b&0x1F)<<6 | int32(s[1]&0x3F)
	}
	if b < 0xF0 && len(s) >= 3 {
		return int32(b&0x0F)<<12 | int32(s[1]&0x3F)<<6 | int32(s[2]&0x3F)
	}
	if len(s) >= 4 {
		return int32(b&0x07)<<18 | int32(s[1]&0x3F)<<12 | int32(s[2]&0x3F)<<6 | int32(s[3]&0x3F)
	}
	return int32(b)
}

func runeToStr(r rune) (s string) {
	if r < 0 || r > 0x10FFFF {
		r = 0xFFFD
	}
	var out []byte
	if r <= 0x7F {
		out = mxutil.Ensure(out, 1)
		push(out, byte(r))
	} else if r <= 0x7FF {
		out = mxutil.Ensure(out, 1)
		push(out, byte(0xC0|(r>>6)), byte(0x80|(r&0x3F)))
	} else if r <= 0xFFFF {
		out = mxutil.Ensure(out, 1)
		push(out, byte(0xE0|(r>>12)), byte(0x80|((r>>6)&0x3F)), byte(0x80|(r&0x3F)))
	} else {
		out = mxutil.Ensure(out, 1)
		push(out, byte(0xF0|(r>>18)), byte(0x80|((r>>12)&0x3F)), byte(0x80|((r>>6)&0x3F)), byte(0x80|(r&0x3F)))
	}
	return string(out)
}
