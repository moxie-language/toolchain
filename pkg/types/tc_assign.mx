package types

// predeclaredAlias returns the underlying type of the predeclared aliases
// byte (uint8) and rune (int32), or ok=false for anything else.
func predeclaredAlias(T Type) (u Type, ok bool) {
	n, isNamed := T.(*Named)
	if !isNamed || n.Obj == nil {
		return nil, false
	}
	if n.Obj.Name == "byte" || n.Obj.Name == "rune" {
		return n.Under, true
	}
	return nil, false
}

// basicOf returns T's Basic after unwrapping the predeclared aliases byte and
// rune, or nil. []byte's element is the named byte in stage4, so a plain
// type assertion to *Basic missed the string/[]byte unification for []string
// against [][]byte.
func basicOf(T Type) (b *Basic) {
	if a, isAlias := predeclaredAlias(T); isAlias {
		T = a
	}
	b, _ = SafeUnderlying(T).(*Basic)
	return b
}

// TextType reports whether T is Moxie text: string or []byte.
func TextType(T Type) (ok bool) {
	return isTextType(T)
}

// Identical reports whether T and U are identical types under Moxie rules:
// - string = []byte (Moxie text unification)
// - int32 = int32, uint32 = uint32 (enforced via universe scope, but checked here too)
func Identical(T, U Type) (ok bool) {
	if T == U {
		return true
	}
	if T == nil || U == nil {
		return false
	}
	// byte and rune are ALIASES in Go (uint8 and int32); stage4 models them as
	// named types with those underlying types, so identity has to look through
	// the name or [32]byte and [32]uint8 stop matching - which is exactly the
	// mismatch the assignability check found in smesh's nip44.
	if a, isAlias := predeclaredAlias(T); isAlias {
		T = a
	}
	if a, isAlias := predeclaredAlias(U); isAlias {
		U = a
	}
	switch t := T.(type) {
	case *Basic:
		var u *Basic
		u, ok = U.(*Basic)
		if !ok {
			if t.Info&IsString != 0 {
				sl, slOk := U.(*Slice)
				if slOk {
					eb := basicOf(sl.Elem)
					if eb != nil && eb.Kind == Uint8 {
						return true
					}
				}
			}
			return false
		}
		tk := normaliseKind(t.Kind)
		uk := normaliseKind(u.Kind)
		if tk == uk {
			return true
		}
		if t.Info&IsString != 0 && u.Info&IsString != 0 {
			return true
		}
		return false
	case *Pointer:
		var u *Pointer
		u, ok = U.(*Pointer)
		return ok && Identical(t.Base, u.Base)
	case *Array:
		var u *Array
		u, ok = U.(*Array)
		return ok && t.Len == u.Len && Identical(t.Elem, u.Elem)
	case *Slice:
		var u *Slice
		u, ok = U.(*Slice)
		if !ok {
			// []byte = string in Moxie (including untyped string)
			b, bOk := U.(*Basic)
			if bOk && b.Info&IsString != 0 {
				eb := basicOf(t.Elem)
				if eb != nil && eb.Kind == Uint8 {
					return true
				}
			}
			return false
		}
		return Identical(t.Elem, u.Elem)
	case *TCMap:
		var u *TCMap
		u, ok = U.(*TCMap)
		return ok && Identical(t.Key, u.Key) && Identical(t.Elem, u.Elem)
	case *TCChan:
		var u *TCChan
		u, ok = U.(*TCChan)
		return ok && t.Dir == u.Dir && Identical(t.Elem, u.Elem)
	case *TCStruct:
		var u *TCStruct
		u, ok = U.(*TCStruct)
		if !ok || t.NumFields() != u.NumFields() {
			return false
		}
		for i := range t.Fields {
			tf := t.Fields[i]
			uf := u.Fields[i]
			if tf.Name != uf.Name || tf.Anonymous != uf.Anonymous {
				return false
			}
			if !Identical(tf.Typ, uf.Typ) {
				return false
			}
		}
		return true
	case *TCInterface:
		var u *TCInterface
		u, ok = U.(*TCInterface)
		if !ok {
			return false
		}
		if t.NumMethods() != u.NumMethods() {
			return false
		}
		for i, tm := range t.AllMethods {
			um := u.AllMethods[i]
			if tm.Name != um.Name || !Identical(tm.Sig, um.Sig) {
				return false
			}
		}
		return true
	case *Signature:
		var u *Signature
		u, ok = U.(*Signature)
		if !ok {
			return false
		}
		if t.Variadic != u.Variadic {
			return false
		}
		if !identicalTuples(t.Params, u.Params) || !identicalTuples(t.Results, u.Results) {
			return false
		}
		return true
	case *Named:
		var u *Named
		u, ok = U.(*Named)
		return ok && t.Obj == u.Obj
	case *TypeParam:
		var u *TypeParam
		u, ok = U.(*TypeParam)
		return ok && t.Id == u.Id
	case *Tuple:
		var u *Tuple
		u, ok = U.(*Tuple)
		return ok && identicalTuples(t, u)
	}
	return false
}

func identicalTuples(a, b *Tuple) (ok bool) {
	la, lb := tupleLen(a), tupleLen(b)
	if la != lb {
		return false
	}
	for i := 0; i < la; i++ {
		if !Identical(a.Vars[i].Typ, b.Vars[i].Typ) {
			return false
		}
	}
	return true
}

func tupleLen(t *Tuple) (n int32) {
	if t == nil {
		return 0
	}
	return t.Len()
}

// normaliseKind maps int32/uint32 to their 32-bit equivalents for identity checks.
func normaliseKind(k BasicKind) (b BasicKind) {
	return k // int32=int32 is handled by the universe scope; no extra mapping needed
}

// Assignable reports whether a value of type V is assignable to type T
// under Moxie's type rules (spec Assignability, plus Moxie extensions).
func Assignable(V, T Type) (ok bool) {
	if V == nil || T == nil {
		return V == T
	}
	// Identical types are always assignable.
	if Identical(V, T) {
		return true
	}
	// Moxie extension: string = []byte anywhere.
	if isTextType(V) && isTextType(T) {
		return true
	}
	// Untyped constants are assignable to any numeric/bool/string type they fit in.
	bv, bvOk := V.(*Basic)
	if bvOk && bv.Info&IsUntyped != 0 {
		return untypedAssignable(bv, T)
	}
	// nil is assignable to pointer, slice, map, chan, func, interface.
	if V == Typ[UntypedNil] {
		return isNilable(T)
	}
	// V's underlying type identical to T's underlying type, and at least one is unnamed.
	vu, tu := SafeUnderlying(V), SafeUnderlying(T)
	if Identical(vu, tu) {
		_, vNamed := V.(*Named)
		_, tNamed := T.(*Named)
		if !vNamed || !tNamed {
			return true
		}
	}
	// T is an interface and V implements it.
	iface, ifOk := SafeUnderlying(T).(*TCInterface)
	if ifOk {
		return Implements(V, iface)
	}
	// Directional channel: bidirectional chan is assignable to directed chan.
	tc, tcOk := T.(*TCChan)
	if tcOk {
		vc, vcOk := V.(*TCChan)
		if vcOk {
			if Identical(tc.Elem, vc.Elem) {
				return vc.Dir == TCSendRecv || vc.Dir == tc.Dir
			}
		}
	}
	return false
}

// ConcreteAssignTypes reports whether both types are resolved enough for
// Assignable to be trusted in the compiler's build path. Interfaces and type
// parameters are skipped there: their method sets and instantiations may not
// be resolved yet, and a false error is worse than a missing one.
func ConcreteAssignTypes(V, T Type) (ok bool) {
	if V == nil || T == nil {
		return false
	}
	if _, isTP := V.(*TypeParam); isTP {
		return false
	}
	if _, isTP := T.(*TypeParam); isTP {
		return false
	}
	if _, isTP := SafeUnderlying(V).(*TypeParam); isTP {
		return false
	}
	if _, isTP := SafeUnderlying(T).(*TypeParam); isTP {
		return false
	}
	if _, isIface := SafeUnderlying(V).(*TCInterface); isIface {
		return false
	}
	if _, isIface := SafeUnderlying(T).(*TCInterface); isIface {
		return false
	}
	// An untyped type anywhere on either side means the type is not resolved
	// yet (a bare constant, or a pointer to a constant's default-less type:
	// stage4 produced `*untyped bool` in smesh's nostr package). Untyped
	// values are handled by checkAssignable's constant rule.
	if hasUntyped(V) || hasUntyped(T) {
		return false
	}
	return true
}

// hasUntyped reports whether an untyped basic type appears anywhere in T.
func hasUntyped(T Type) (ok bool) {
	if T == nil {
		return false
	}
	switch u := SafeUnderlying(T).(type) {
	case *Basic:
		return u.Info&IsUntyped != 0
	case *Pointer:
		return hasUntyped(u.Base)
	case *Slice:
		return hasUntyped(u.Elem)
	case *Array:
		return hasUntyped(u.Elem)
	case *TCMap:
		return hasUntyped(u.Key) || hasUntyped(u.Elem)
	}
	return false
}

// Nilable reports whether nil is a value of T. Exported for the stage4 SSA
// builder, which has to judge a nil comparison and cannot reach the
// unexported predicate from another package.
func Nilable(T Type) (ok bool) {
	return isNilable(T)
}

func isNilable(T Type) (ok bool) {
	switch SafeUnderlying(T).(type) {
	case *Pointer, *Slice, *TCMap, *TCChan, *Signature, *TCInterface:
		return true
	}
	// string and []byte are one type in Moxie, so nil is a valid empty
	// string just as it is a valid empty byte slice. Go's checker has no nil
	// string; the runtime's Goexit passes nil for "no message".
	return isTextType(T)
}

func untypedAssignable(V *Basic, T Type) (ok bool) {
	var b *Basic
	b, ok = SafeUnderlying(T).(*Basic)
	if !ok {
		return false
	}
	switch V.Kind {
	case UntypedBool:
		return b.Info&IsBoolean != 0
	case UntypedInt, UntypedRune:
		return b.Info&IsInteger != 0 || b.Info&IsFloat != 0
	case UntypedFloat:
		return b.Info&IsFloat != 0
	case UntypedString:
		return b.Info&IsString != 0
	}
	return false
}

// isTextType returns true if T is string or []byte under Moxie's unified model.
func isTextType(T Type) (ok bool) {
	b, bOk := SafeUnderlying(T).(*Basic)
	if bOk && b.Info&IsString != 0 {
		return true
	}
	sl, slOk := SafeUnderlying(T).(*Slice)
	if slOk {
		eb := basicOf(sl.Elem)
		if eb != nil && eb.Kind == Uint8 {
			return true
		}
	}
	return false
}

// Implements reports whether type T implements interface I.
func Implements(T Type, I *TCInterface) (ok bool) {
	if I.IsEmpty() {
		return true
	}
	// Collect T's method set.
	ms := methodSet(T)
	for _, im := range I.AllMethods {
		var m *TCFunc
		m, ok = ms[im.Name]
		if !ok {
			return false
		}
		if !Identical(m.Signature(), im.Sig) {
			return false
		}
	}
	return true
}

// methodSet returns the named method set of T as a name->Func map.
// Includes methods from *T if T is a named type (pointer receiver methods).
func methodSet(T Type) (m map[string]*TCFunc) {
	ms := map[string]*TCFunc{}
	collectMethods(T, ms, false)
	return ms
}

func collectMethods(T Type, ms map[string]*TCFunc, ptrOk bool) {
	collectMethodsDepth(T, ms, ptrOk, 0)
}

// collectMethodsDepth is collectMethods plus a promotion depth bound. An
// embedded field promotes its type's methods to the outer type, and an
// embedded INTERFACE promotes the methods it declares - io's nopCloser reaches
// Read only that way - so a method set that ignores embedded fields answers
// "missing method Read" for a type that has had Read all along. Each level
// costs two steps through the chain (a Named and its underlying struct), and
// pkg/syntax's ExprStmt reaches node's Pos() six steps down.
func collectMethodsDepth(T Type, ms map[string]*TCFunc, ptrOk bool, depth int32) {
	if depth > 12 {
		return
	}
	if u, isSlice := SafeUnderlying(T).(*Slice); isSlice && isTextType(T) {
		// string and []byte are one type, so an UNNAMED []byte carries the
		// string method set: a channel of []byte handed to fmt was "missing
		// method String" while `string(x)` of the same bytes never was. A
		// NAMED slice over byte has its own method set - that is the reason
		// the name exists - so it must not be replaced by string's.
		if _, isNamed := T.(*Named); !isNamed {
			collectMethodsDepth(Typ[TCString], ms, false, depth+1)
			return
		}
	}
	switch t := T.(type) {
	case *Basic:
		// Every predeclared type declares String() string (the runtime owns the
		// bodies), so an int32 IS a Stringer.
		for _, m := range t.Methods {
			if _, dup := ms[m.Name]; !dup {
				ms[m.Name] = m
			}
		}
	case *Named:
		for _, m := range t.Methods {
			if _, dup := ms[m.Name]; !dup {
				ms[m.Name] = m
			}
		}
		if ptrOk {
			collectMethodsDepth(NewPointer(T), ms, false, depth+1)
		}
		collectMethodsDepth(t.Under, ms, ptrOk, depth+1)
	case *Pointer:
		if named, ok := t.Base.(*Named); ok {
			for _, m := range named.Methods {
				if _, dup := ms[m.Name]; !dup {
					ms[m.Name] = m
				}
			}
		}
		if t.Base != nil {
			collectMethodsDepth(t.Base, ms, false, depth+1)
		}
	case *TCStruct:
		for _, f := range t.Fields {
			if f == nil || !f.Anonymous || f.Typ == nil {
				continue
			}
			base := f.Typ
			if p, isP := base.(*Pointer); isP && p.Base != nil {
				base = p.Base
			}
			collectMethodsDepth(base, ms, true, depth+1)
		}
	case *TCInterface:
		t.Complete()
		for _, m := range t.AllMethods {
			if m == nil {
				continue
			}
			if _, dup := ms[m.Name]; !dup {
				ms[m.Name] = NewTCFunc(nil, m.Name, m.Sig)
			}
		}
	}
}

// IfaceMethodSetLocal reports whether T's method set is complete enough to say
// that a method is absent. Stage4 fills an imported package's method list from
// what its own compilation needed, not from every declaration that package has,
// so an imported Named type can look method-less. A type that cannot carry a
// method at all, and a type declared in this package (every file of which is
// built by the time the post-pass runs), are the cases where "absent" means
// absent. Arrays are judged too: Moxie is removing them in favour of slices, and
// an array carries no methods, so passing one into a Stringer slot is the same
// defect as passing a slice.
func IfaceMethodSetLocal(T Type, localPkg *TCPackage) (ok bool) {
	if T == nil {
		return false
	}
	switch u := T.(type) {
	case *Named:
		return localPkg != nil && u.Obj != nil && u.Obj.Pkg == localPkg
	case *Pointer:
		if named, isN := u.Base.(*Named); isN {
			return localPkg != nil && named.Obj != nil && named.Obj.Pkg == localPkg
		}
		switch SafeUnderlying(u).(type) {
		case *Basic, *Slice, *Array, *TCMap, *TCChan, *Signature:
			return true
		}
		return false
	}
	switch SafeUnderlying(T).(type) {
	case *Basic, *Slice, *Array, *TCMap, *TCChan, *Signature:
		return true
	}
	return false
}

// IfaceCheckConclusive reports whether a missing-method verdict can be trusted
// for this pair. A generic body still carries type parameters in its method
// signatures until the instantiation substitutes them, and an untyped value's
// type belongs to the constant rule, so both are skipped rather than guessed.
func IfaceCheckConclusive(T Type, I *TCInterface) (ok bool) {
	if T == nil || I == nil {
		return false
	}
	I.Complete()
	if I.IsEmpty() {
		return false
	}
	for _, m := range I.AllMethods {
		if m == nil || m.Sig == nil {
			return false
		}
	}
	if hasUntyped(T) || hasUntyped(I) {
		return false
	}
	if hasTypeParams(T) || hasTypeParams(I) {
		return false
	}
	return true
}

// HasMethod reports whether T's method set declares a method with this name,
// at the same bounded promotion depth IfaceMissingMethod uses. An interface
// dispatch arm is only reachable for a dynamic type that implements the static
// interface, so emission uses this to drop candidates that could never carry
// the value.
func HasMethod(T Type, name string) (ok bool) {
	if T == nil || name == "" {
		return false
	}
	return hasMethodNamed(T, name, 0)
}

// IfaceMissingMethod returns the name of the first method I requires that T's
// method set does not declare at all, or "" when every name is present. It does
// not compare signatures: an alias of an interface gets its own Named wrapper
// (os.FileInfo = fs.FileInfo exists because interface typing depends on
// Named-ness), so a signature reached through such an alias compares unequal and
// a false "does not implement" would follow. A missing NAME cannot be produced
// by that aliasing.
func IfaceMissingMethod(T Type, I *TCInterface) (missing string) {
	if I == nil {
		return ""
	}
	I.Complete()
	if I.IsEmpty() {
		return ""
	}
	for _, im := range I.AllMethods {
		if im == nil {
			continue
		}
		if !hasMethodNamed(T, im.Name, 0) {
			return im.Name
		}
	}
	return ""
}

// hasMethodNamed reports whether T's method set declares a method with this
// name, at a bounded promotion depth. It walks the same edges as
// collectMethodsDepth but stops at the first match and allocates nothing: the
// compiler has no collector and its arena is per function, so a map per checked
// assignment filled the arena region table on the 45-package stdlib sweep.
func hasMethodNamed(T Type, name string, depth int32) (ok bool) {
	if T == nil || depth > 12 {
		return false
	}
	if u, isSlice := SafeUnderlying(T).(*Slice); isSlice && isTextType(T) {
		if _, isNamed := T.(*Named); !isNamed {
			return hasMethodNamed(Typ[TCString], name, depth+1)
		}
	}
	switch t := T.(type) {
	case *Basic:
		for _, m := range t.Methods {
			if m.Name == name {
				return true
			}
		}
	case *Named:
		for _, m := range t.Methods {
			if m.Name == name {
				return true
			}
		}
		if hasMethodNamed(t.Under, name, depth+1) {
			return true
		}
	case *Pointer:
		if named, isN := t.Base.(*Named); isN {
			for _, m := range named.Methods {
				if m.Name == name {
					return true
				}
			}
		}
		if t.Base != nil {
			return hasMethodNamed(t.Base, name, depth+1)
		}
	case *TCStruct:
		for _, f := range t.Fields {
			if f == nil || !f.Anonymous || f.Typ == nil {
				continue
			}
			base := f.Typ
			if p, isP := base.(*Pointer); isP && p.Base != nil {
				base = p.Base
			}
			if hasMethodNamed(base, name, depth+1) {
				return true
			}
		}
	case *TCInterface:
		t.Complete()
		for _, m := range t.AllMethods {
			if m != nil && m.Name == name {
				return true
			}
		}
	}
	return false
}

// hasTypeParams reports whether a type parameter or an instantiation appears
// anywhere in T, to a bounded depth. The bound is what stops the walk at a
// recursive interface: `Equal(x I) (ok bool)` on I makes I's own method
// signature contain I.
func hasTypeParams(T Type) (ok bool) {
	return hasTypeParamsDepth(T, 0)
}

func hasTypeParamsDepth(T Type, depth int32) (ok bool) {
	if T == nil || depth > 12 {
		return false
	}
	switch u := T.(type) {
	case *TypeParam:
		return true
	case *Named:
		if u.TArgs != nil {
			return true
		}
	}
	switch u := SafeUnderlying(T).(type) {
	case *TypeParam:
		return true
	case *Named:
		return u.TArgs != nil
	case *Pointer:
		return hasTypeParamsDepth(u.Base, depth+1)
	case *Slice:
		return hasTypeParamsDepth(u.Elem, depth+1)
	case *Array:
		return hasTypeParamsDepth(u.Elem, depth+1)
	case *TCMap:
		return hasTypeParamsDepth(u.Key, depth+1) || hasTypeParamsDepth(u.Elem, depth+1)
	case *TCChan:
		return hasTypeParamsDepth(u.Elem, depth+1)
	case *Signature:
		if hasTypeParamsDepth(u.Params, depth+1) {
			return true
		}
		return hasTypeParamsDepth(u.Results, depth+1)
	case *Tuple:
		if u == nil {
			return false
		}
		for i := int32(0); i < u.Len(); i++ {
			if v := u.At(i); v != nil && hasTypeParamsDepth(v.Typ, depth+1) {
				return true
			}
		}
	case *TCInterface:
		u.Complete()
		for _, m := range u.AllMethods {
			if m != nil && hasTypeParamsDepth(m.Sig, depth+1) {
				return true
			}
		}
	}
	return false
}
