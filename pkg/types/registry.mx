package types

import "moxielang.dev/pkg/mxutil"

// ImportRegistry is the deprecated global bridge the legacy compiler's
// codegen reads. Stage4 reads cctx.universe.Registry. It is only ever written
// by initUniverseGlobals and only read here and in tc_types.
var ImportRegistry map[string]*TCPackage

// PkgDirectImports mirrors UniverseState.DirectImports for InitUniverse's
// re-entry branch. Written only by initUniverseGlobals.
var PkgDirectImports map[string][]string

// DirectImportPaths on UniverseState - the correct path.
func (u *UniverseState) DirectImportPaths(pkg *TCPackage) (paths []string) {
	if pkg == nil || u == nil {
		return nil
	}
	if ps, ok := u.DirectImports[pkg.Path]; ok {
		return ps
	}
	var out []string
	for _, ip := range pkg.Imports {
		out = mxutil.Ensure(out, 1)
		push(out, ip.Path)
	}
	if len(out) == 0 {
		sc := pkg.Scope
		if sc == nil {
			return nil
		}
		for _, n := range sc.Names() {
			if pn, ok := sc.Lookup(n).(*PkgName); ok && pn.Imported != nil {
				out = mxutil.Ensure(out, 1)
				push(out, pn.Imported.Path)
			}
		}
	}
	u.DirectImports[pkg.Path] = out
	return out
}
