package types

import (
	"git.smesh.lol/moxie/pkg/syntax"
	"git.smesh.lol/moxie/pkg/token"
)
// TypeBaseName returns the name of the base type for an anonymous field.
// EmbeddedFieldName returns the field name of an embedded type: the type's
// name as written. Deriving it from the resolved type instead loses the name
// of the predeclared interfaces, so an embedded `error` field was registered
// with an empty name and res.error could not be selected.
func EmbeddedFieldName(e syntax.Expr) (s string) {
	switch t := e.(type) {
	case *syntax.Name:
		return t.Value
	case *syntax.SelectorExpr:
		if t.Sel != nil {
			return t.Sel.Value
		}
	case *syntax.IndexExpr:
		return EmbeddedFieldName(t.X)
	case *syntax.Operation:
		if t.Y == nil && t.Op == token.Mul {
			return EmbeddedFieldName(t.X)
		}
	}
	return ""
}

func TypeBaseName(t Type) (s string) {
	if t == nil {
		return ""
	}
	switch tt := t.(type) {
	case *Named:
		if tt.Obj != nil {
			return tt.Obj.Name
		}
	case *Pointer:
		return TypeBaseName(tt.Base)
	case *Basic:
		return tt.Name
	}
	return ""
}
