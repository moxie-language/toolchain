package types

import (
	"math"
	"math/big"
	"strconv"

	"moxielang.dev/pkg/mxutil"
	"runtime"
)

// UniverseState holds all predeclared type system state.
// Owned by the caller. No globals - all access through this struct.
type UniverseState struct {
	Scope         *Scope
	Typ           [UntypedNil + 1]*Basic
	Error         *TypeName
	// Uintptr is the universe's uintptr: a named type over Uint32 on wasm32
	// and Uint64 elsewhere, so a value typed with it takes the target's word
	// width in the backend. Compiler-folded sizes use it for that reason.
	Uintptr       *TypeName
	Registry      map[string]*TCPackage
	DirectImports map[string][]string
	ByName        map[string]*TCPackage // name -> package cache
	byNameSeq     int32
}

// LookupByName returns the package with the given short name, or nil.
func (u *UniverseState) LookupByName(name string) (pkg *TCPackage) {
	if u.ByName == nil || u.byNameSeq != int32(len(u.Registry)) {
		u.rebuildByName()
	}
	p := u.ByName[name]
	if p == nil {
		return nil
	}
	// A Registry write that REPLACES a package does not change its length, so the
	// check above cannot see it. That replacement is the normal path, not an
	// exotic one: registerBuiltins installs Synthetic stubs, and loadMxh later
	// overwrites the same key with the real package read from a dependency's
	// .mxh (main.mx, workerLoadDeps - "existing != nil && !existing.Synthetic").
	// The cache then still answered with the stub, whose Scope holds almost none
	// of the real package's declarations, for the rest of the build. Verify the
	// cached entry is the object the Registry holds now, and rebuild once if it
	// is not.
	if cur, live := u.Registry[p.Path]; live && cur == p {
		return p
	}
	u.rebuildByName()
	return u.ByName[name]
}

// rebuildByName rebuilds the name->package cache.
//
// Two loaded packages can share a name - crypto/ecdsa and
// crypto/internal/fips140/ecdsa - and the winner used to be whichever the map
// yielded last, i.e. map iteration order, so the same source could resolve
// differently between runs. The order is now a total, reproducible policy:
// shorter path first, then lexicographic. That is not what disambiguates a real
// collision (import-scoped resolution does, see resolveTypeExprWithSubst); it is
// what stops the answer from being random.
func (u *UniverseState) rebuildByName() {
	// The ByName cache must outlive any single package compile, so build it in
	// the root arena (the caller's arena owns the state).
	saved := runtime.CurrentArena()
	runtime.SetCurrentArena(runtime.RootArena())
	u.ByName = map[string]*TCPackage{}
	// Scratch declared OUTSIDE the loop: a `:=` in the body of a loop in a
	// self-mutating method lands in the sovereign arena on every iteration, which
	// the compiler rejects by name.
	var cur *TCPackage
	for _, p := range u.Registry {
		if p == nil {
			continue
		}
		cur = u.ByName[p.Name]
		if cur == nil || betterPkgName(p, cur) {
			u.ByName[p.Name] = p
		}
	}
	u.byNameSeq = int32(len(u.Registry))
	runtime.SetCurrentArena(saved)
}

// betterPkgName reports whether a should win a name collision against b.
func betterPkgName(a *TCPackage, b *TCPackage) (ok bool) {
	if len(a.Path) != len(b.Path) {
		return len(a.Path) < len(b.Path)
	}
	return a.Path < b.Path
}

// Global bridge - DEPRECATED. Will be removed once all call sites
// thread UniverseState as a parameter. Do not add new reads.
var Universe *Scope
var Typ [UntypedNil + 1]*Basic
var universeError *TypeName


// InitUniverse creates the universe scope with predeclared types.
// Returns all products. Caller owns the returned state.
// Also sets globals for backward compat during migration.
func InitUniverse() (u *UniverseState) {
	if Universe != nil {
		return &UniverseState{
			Scope:         Universe,
			Typ:           Typ,
			Error:         universeError,
			Registry:      ImportRegistry,
			DirectImports: PkgDirectImports,
		}
	}
	// The universe (scope, types, the error interface) is referenced by
	// every package compile in this process. Build it in the root arena
	// in manual-arena mode so the allocations below survive this
	// function's own fn-arena pop.
	runtime.SovereignSetArena(runtime.RootArena())
	u = buildUniverse()
	runtime.SovereignRestoreArena(runtime.RootArena())
	return u
}

// SetUniverseGlobals sets the package-level globals from a UniverseState.
// Called by the program's main after receiving the return value from
// InitUniverse; the caller's arena owns the data.
func SetUniverseGlobals(u *UniverseState) {
	initUniverseGlobals(u)
}

// initUniverseGlobals performs the stores. It is the one-time initialiser for
// these globals - main calls it once, before any read - so it is named init*,
// which is the immutability rule's own exemption: "package initialization code
// may set globals ... the constructor an app calls to build its state lives in
// the root arena and is named initState/initX". The exported wrapper above
// exists only because pkg/types is imported with a dot and an unexported name
// is not visible through it. Threading the universe through the 207 Typ[ reads
// instead is the real end state and is not this change.
func initUniverseGlobals(u *UniverseState) {
	Universe = u.Scope
	Typ = u.Typ
	universeError = u.Error
	ImportRegistry = u.Registry
	PkgDirectImports = u.DirectImports
}

// buildUniverse constructs the universe scope. No globals touched.
// All products returned by value.
func buildUniverse() (u *UniverseState) {
	u = &UniverseState{}
	u.Registry = map[string]*TCPackage{}
	u.DirectImports = map[string][]string{}
	u.Scope = NewScope(nil)

	// Initialize Basic types in Typ table.
	infos := [...]struct {
		kind BasicKind
		info BasicInfo
		name string
	}{
		{Invalid, 0, "invalid type"},

		{Bool, IsBoolean, "bool"},

		{Int8, IsInteger | IsOrdered | IsNumeric, "int8"},
		{Int16, IsInteger | IsOrdered | IsNumeric, "int16"},
		{Int32, IsInteger | IsOrdered | IsNumeric, "int32"},
		{Int64, IsInteger | IsOrdered | IsNumeric, "int64"},
		{Uint8, IsInteger | IsUnsigned | IsOrdered | IsNumeric, "uint8"},
		{Uint16, IsInteger | IsUnsigned | IsOrdered | IsNumeric, "uint16"},
		{Uint32, IsInteger | IsUnsigned | IsOrdered | IsNumeric, "uint32"},
		{Uint64, IsInteger | IsUnsigned | IsOrdered | IsNumeric, "uint64"},
		{Uintptr, IsInteger | IsUnsigned | IsOrdered, "uintptr"},

		{Float32, IsFloat | IsOrdered | IsNumeric, "float32"},
		{Float64, IsFloat | IsOrdered | IsNumeric, "float64"},

		// string and []byte share kind TCString in Moxie.
		{TCString, IsString | IsOrdered, "string"},

		{UnsafePointer, 0, "Pointer"}, // lives in unsafe package

		{UntypedBool, IsBoolean | IsUntyped, "untyped bool"},
		{UntypedInt, IsInteger | IsNumeric | IsUntyped, "untyped int32"},
		{UntypedRune, IsInteger | IsNumeric | IsUntyped, "untyped rune"},
		{UntypedFloat, IsFloat | IsNumeric | IsUntyped, "untyped float"},
		{UntypedString, IsString | IsUntyped, "untyped string"},
		{UntypedNil, IsUntyped, "untyped nil"},
	}
	for i, info := range infos {
		u.Typ[i] = &Basic{Kind: info.kind, Info: info.info, Name: info.name}
	}

	s := u.Scope
	s.Insert(NewTypeName(nil, "bool", u.Typ[Bool]))
	s.Insert(NewTypeName(nil, "int8", u.Typ[Int8]))
	s.Insert(NewTypeName(nil, "int16", u.Typ[Int16]))
	s.Insert(NewTypeName(nil, "int32", u.Typ[Int32]))
	s.Insert(NewTypeName(nil, "int64", u.Typ[Int64]))
	s.Insert(NewTypeName(nil, "uint8", u.Typ[Uint8]))
	s.Insert(NewTypeName(nil, "uint16", u.Typ[Uint16]))
	s.Insert(NewTypeName(nil, "uint32", u.Typ[Uint32]))
	s.Insert(NewTypeName(nil, "uint64", u.Typ[Uint64]))
	s.Insert(NewTypeName(nil, "float32", u.Typ[Float32]))
	s.Insert(NewTypeName(nil, "float64", u.Typ[Float64]))
	s.Insert(NewTypeName(nil, "string", u.Typ[TCString]))

	for _, b := range []*Basic{
		u.Typ[Bool],
		u.Typ[Int8], u.Typ[Int16], u.Typ[Int32], u.Typ[Int64],
		u.Typ[Uint8], u.Typ[Uint16], u.Typ[Uint32], u.Typ[Uint64],
		u.Typ[Float32], u.Typ[Float64],
		u.Typ[TCString],
	} {
		addBasicStringMethod(b, u.Typ[TCString])
	}

	// byte and rune are aliases of uint8 and int32 in Go, and so in the
	// legacy compiler (go/types unaliases them). Stage4 keeps them as named
	// types over the same underlying kinds, so their String() is the
	// underlying type's method: the runtime declares only uint8.String and
	// int32.String, and resolution maps the alias name to it.
	byteType := NewNamed(NewTypeName(nil, "byte", nil), u.Typ[Uint8])
	s.Insert(byteType.Obj)
	byteType.Obj.Typ = byteType
	addStringMethod(byteType, u.Typ[TCString])

	runeType := NewNamed(NewTypeName(nil, "rune", nil), u.Typ[Int32])
	s.Insert(runeType.Obj)
	runeType.Obj.Typ = runeType
	addStringMethod(runeType, u.Typ[TCString])

	uintptrUnderlying := u.Typ[Uint64]
	if mxutil.TargetArch() == "wasm" {
		uintptrUnderlying = u.Typ[Uint32]
	}
	uintptrType := NewNamed(NewTypeName(nil, "uintptr", nil), uintptrUnderlying)
	s.Insert(uintptrType.Obj)
	uintptrType.Obj.Typ = uintptrType
	u.Uintptr = uintptrType.Obj
	addStringMethod(uintptrType, u.Typ[TCString])

	errSig := NewSignature(nil, nil, NewTuple(NewTCVar(nil, "", u.Typ[TCString])), false)
	strMeth := &IfaceMethod{Name: "String", Sig: errSig}
	errMeth := &IfaceMethod{Name: "Error", Sig: errSig}
	errIface := NewTCInterface([]*IfaceMethod{errMeth, strMeth}, nil)
	errIface.Complete()
	u.Error = NewTypeName(nil, "error", errIface)
	s.Insert(u.Error)

	
	comparableIface := NewTCInterface(nil, nil)
	comparableIface.Complete()
	s.Insert(NewTypeName(nil, "comparable", comparableIface))

	s.Insert(NewTCConst(nil, "true", u.Typ[UntypedBool], untypedBool(true)))
	s.Insert(NewTCConst(nil, "false", u.Typ[UntypedBool], untypedBool(false)))
	s.Insert(NewTCConst(nil, "iota", u.Typ[UntypedInt], untypedInt(0)))
	s.Insert(NewTCConst(nil, "nil", u.Typ[UntypedNil], untypedNil()))

	builtinNames := []string{
		BuiltinCap:     "cap",
		BuiltinClear:   "clear",
		BuiltinClose:   "close",
		BuiltinComplex: "complex",
		BuiltinCopy:    "copy",
		BuiltinDelete:  "delete",
		BuiltinImag:    "imag",
		BuiltinLen:     "len",
		BuiltinMake:    "__slicealloc",
		BuiltinNew:     "__ptralloc",
		BuiltinPanic:   "panic",
		BuiltinPrint:   "print",
		BuiltinPrintln: "println",
		BuiltinReal:    "real",
		BuiltinRecover: "recover",
		BuiltinSpawn:   "spawn",
	}
	for id, name := range builtinNames {
		// complex/real/imag are removed from Moxie: the names stay in the
		// dense slice (so explicit indices are preserved) but are not
		// registered, so they resolve as undefined. append has no entry at
		// all - there is no append builtin in any spelling.
		if BuiltinID(id) == BuiltinComplex || BuiltinID(id) == BuiltinReal || BuiltinID(id) == BuiltinImag {
			continue
		}
		s.Insert(newBuiltin(name, BuiltinID(id)))
	}
	s.Insert(newBuiltin("min", BuiltinMin))
	s.Insert(newBuiltin("max", BuiltinMax))
	s.Insert(newBuiltin("push", BuiltinPush))
	s.Insert(newBuiltin("pop", BuiltinPop))
	s.Insert(newBuiltin("resize", BuiltinResize))
	s.Insert(newBuiltin("__shutdown", BuiltinShutdown))
	return u
}



func addStringMethod(named *Named, strType *Basic) {
	stringSig := NewSignature(
		NewTCVar(nil, "", named),
		nil,
		NewTuple(NewTCVar(nil, "", strType)),
		false,
	)
	stringFn := NewTCFunc(nil, "String", stringSig)
	if named.Methods == nil {
		named.Methods = []*TCFunc{:0:1}
	}
	named.AddMethod(stringFn)
}

func addBasicStringMethod(b *Basic, strType *Basic) {
	stringSig := NewSignature(
		NewTCVar(nil, "", b),
		nil,
		NewTuple(NewTCVar(nil, "", strType)),
		false,
	)
	stringFn := NewTCFunc(nil, "String", stringSig)
	if b.Methods == nil {
		b.Methods = []*TCFunc{:0:1}
	}
	b.AddMethod(stringFn)
}




// Placeholder constant values. These wrap go/constant values. In B4 they
// become native Moxie values.
type ConstBool struct{ V bool }
// ConstInt holds an untyped or typed integer constant in a 64-bit slot. Go
// evaluates untyped constants exactly, without a width, so a value such as
// `1<<64 - 1` is 2^64-1; V can only carry its low 64 bits (-1). Unsigned marks
// a constant whose exact value is non-negative but at least 2^63, so folding
// knows to divide, take a remainder and right-shift it in the unsigned domain
// (maxUint64/10 is 1844674407370955161, not the signed -1/10 == 0).
type ConstInt struct {
	V        int64
	Unsigned bool
	// Exact carries the value when it does not fit 64 bits. Untyped integer
	// constants are arbitrary-precision in Go and V alone loses the high bits:
	// `1 << 129` folded to 0, so `x > 1<<129` was true for every positive x and
	// J0/J1/Y0/Y1/Yn/Jn took their asymptotic branch permanently. V holds the
	// low 64 bits so every existing reader keeps working; Exact is authoritative
	// when non-nil.
	Exact *big.Int
}
type ConstFloat struct {
	V     float64
	Lit   string
	Exact *big.Rat
}
type ConstStr struct{ S string }
type ConstNil struct{}

func untypedBool(v bool) (c ConstVal) { return &ConstBool{V: v} }
func untypedInt(v int64) (c ConstVal) { return &ConstInt{V: v} }
func untypedNil() (c ConstVal) { return &ConstNil{} }

func (c *ConstBool) String() (s string) { if c.V { return "true" }; return "false" }
func (c *ConstInt) String() (s string) {
	// Exact is authoritative when the value does not fit 64 bits. Rendering V
	// gave "0" for `1<<129`, so intConstToFloat materialised the constant as 0.0
	// and `x > 1<<129` was true for every positive x - the last consumer of the
	// over-64-bit limitation.
	if c.Exact != nil {
		return c.Exact.String()
	}
	// An unsigned constant's exact value is non-negative and does not fit the
	// signed slot (math.MaxUint64 is V=-1, Unsigned=true). Printing the signed
	// -1 made the .mxh round trip lose it: the reader saw "-1", stopped at the
	// sign, and re-exported 0. Print the exact value instead.
	if c.Unsigned && c.V < 0 {
		return uint64Str(uint64(c.V))
	}
	return int64Str(c.V)
}

// uint64Str formats a non-negative 64-bit value in decimal.
func uint64Str(u uint64) (s string) {
	if u == 0 {
		return "0"
	}
	buf := []byte{:0:20}
	for u > 0 {
		buf = mxutil.Ensure(buf, 1)
		push(buf, byte('0'+u%10))
		u /= 10
	}
	for i, j := 0, len(buf)-1; i < j; i, j = i+1, j-1 {
		buf[i], buf[j] = buf[j], buf[i]
	}
	return string(buf)
}

// int64Str formats a signed value in decimal.
func int64Str(n int64) (s string) {
	if n == 0 {
		return "0"
	}
	neg := n < 0
	if neg {
		n = -n
		if n < 0 {
			return "-9223372036854775808"
		}
	}
	buf := []byte{:0:20}
	for n > 0 {
		buf = mxutil.Ensure(buf, 1)
		push(buf, byte('0'+n%10))
		n /= 10
	}
	if neg {
		buf = mxutil.Ensure(buf, 1)
		push(buf, '-')
	}
	for i, j := 0, len(buf)-1; i < j; i, j = i+1, j-1 {
		buf[i], buf[j] = buf[j], buf[i]
	}
	return string(buf)
}
// MxhText is the .mxh spelling of a float constant: the exact rational for a
// folded value, so the importer reconstructs the same constant instead of the
// nearest float64. That is what makes `math.MaxFloat64 ==
// 1.7976931348623157e308` false across packages, as it is in Go. String()
// stays the human decimal form - the truncation diagnostic reads it.
func (c *ConstFloat) MxhText() (s string) {
	if c.Exact != nil {
		return string(c.Exact.RatString())
	}
	if c.Lit != "" {
		return c.Lit
	}
	if c.V == 0.0 {
		return "0.0"
	}
	return string(strconv.FormatFloat(c.V, 'g', -1, 64))
}
func (c *ConstFloat) String() (s string) {
	// The .mxh reader parses this text with strconv.ParseFloat, so it must be
	// a Go literal: the original Lit verbatim, or the shortest round-tripping
	// form for a constant folded from an expression. Returning "0.0" for
	// every folded value wrote `const MaxFloat64 untyped_float 0.0`, so an
	// importer read the largest float64 as zero. IR text is a separate
	// concern - the emitter normalizes Lit itself (NormalizeLLVMFloat).
	if c.Lit != "" {
		return c.Lit
	}
	if c.V == 0.0 {
		return "0.0"
	}
	return string(strconv.FormatFloat(c.V, 'g', -1, 64))
}
func (c *ConstStr) String() (s string) { return c.S }
func (c *ConstNil) String() (s string) { return "nil" }

// llvmFloatBits renders a float64 as the hexadecimal bit pattern LLVM's IR
// parser accepts as a double literal.
func llvmFloatBits(f float64) (sv string) {
	digits := "0123456789abcdef"
	bits := math.Float64bits(f)
	buf := []byte{:16}
	for i := int32(15); i >= 0; i-- {
		buf[i] = digits[bits&0xF]
		bits >>= 4
	}
	return "0x" | string(buf)
}

// llvmSpecialFloat renders an infinity or NaN as the hexadecimal bits LLVM's
// IR parser accepts. The textual spellings strconv produces ("+Inf", "NaN")
// are not float literals to clang: `bitcast double +Inf.0 to i64` fails with
// "expected value token", and appending ".0" to them produced exactly that.
func llvmSpecialFloat(neg bool) (sv string) {
	if neg {
		return llvmFloatBits(math.Inf(-1))
	}
	return llvmFloatBits(math.Inf(1))
}

func isSpecialFloatText(s string) (neg bool, ok bool) {
	i := 0
	neg = false
	if len(s) > 0 && (s[0] == '-' || s[0] == '+') {
		neg = s[0] == '-'
		i = 1
	}
	rest := s[i:]
	if len(rest) == 0 {
		return false, false
	}
	if rest[0] == 'I' || rest[0] == 'i' {
		// Inf, Infinity, inf
		return neg, true
	}
	if rest[0] == 'N' || rest[0] == 'n' {
		// NaN, nan
		return false, true
	}
	return false, false
}

func NormalizeLLVMFloat(s string) (sv string) {
	if len(s) == 0 {
		return "0.0"
	}
	if neg, special := isSpecialFloatText(s); special {
		return llvmSpecialFloat(neg)
	}
	// A hexadecimal float literal (0x1p1023) is a C99 spelling; LLVM wants the
	// bit pattern (0xK...K), and it has no '.'/'e' for the normalizer below, so
	// appending ".0" produced "0x1p1023.0", which clang rejects ("expected ','
	// after store operand"). math.MaxFloat64 is built from 0x1p1023, so parse
	// it and hand the emitter the bit pattern it accepts.
	hexStart := 0
	if s[0] == '-' || s[0] == '+' {
		hexStart = 1
	}
	if hexStart+1 < len(s) && s[hexStart] == '0' && (s[hexStart+1] == 'x' || s[hexStart+1] == 'X') {
		f, err := strconv.ParseFloat(s, 64)
		if err != nil {
			return "0.0"
		}
		return llvmFloatBits(f)
	}
	start := 0
	if s[0] == '-' || s[0] == '+' {
		start = 1
	}
	hasDot := false
	ePos := -1
	for i := start; i < len(s); i++ {
		if s[i] == '.' {
			hasDot = true
		}
		if s[i] == 'e' || s[i] == 'E' {
			ePos = i
			break
		}
	}
	if !hasDot {
		if ePos >= 0 {
			return s[:ePos] | ".0" | s[ePos:]
		}
		return s | ".0"
	}
	dotIdx := -1
	for i := start; i < len(s); i++ {
		if s[i] == '.' {
			dotIdx = i
			break
		}
	}
	if dotIdx == start {
		s = s[:start] | "0" | s[start:]
		dotIdx++
	}
	afterDot := dotIdx + 1
	if afterDot >= len(s) || s[afterDot] == 'e' || s[afterDot] == 'E' {
		s = s[:afterDot] | "0" | s[afterDot:]
	}
	return s
}

// Predeclared returns the universe-scope object with the given name, or nil.
func Predeclared(name string) (o Object) {
	return Universe.Lookup(name)
}
