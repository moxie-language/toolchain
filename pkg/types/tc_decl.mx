package types

import (
	"github.com/moxie-language/toolchain/pkg/mxutil"
	"github.com/moxie-language/toolchain/pkg/syntax"
)

// constGroupEntry tracks one const group so iota can be assigned per group.
type constGroupEntry struct {
	group *syntax.Group
	decls []*syntax.ConstDecl
}

// collectFuncTypeParams returns all type parameter names visible in a function
// declaration: explicit type params on the function (TParamList) plus type
// arguments on a generic receiver (func (h Handle[T]) F() needs T in scope).
func collectFuncTypeParams(d *syntax.FuncDecl) (ss []string) {
	seen := map[string]bool{}
	var names []string
	// The names come back as a slice rather than through a callback: a
	// callback would capture `seen` and `names`, and a Moxie closure captures
	// nothing.
	for _, tp := range d.TParamList {
		names = appendUniqueName(names, seen, tp.Name)
	}
	// Extract type args from a generic receiver: func (h Foo[T, U]) ...
	if d.Recv != nil {
		for _, a := range extractTypeArgs(d.Recv.Type) {
			if !seen[a] && a != "" {
				seen[a] = true
				names = mxutil.Ensure(names, 1)
				push(names, a)
			}
		}
	}
	return names
}

// appendUniqueName adds a declaration's name once, in order.
func appendUniqueName(names []string, seen map[string]bool, n *syntax.Name) (out []string) {
	if n == nil || n.Value == "" || seen[n.Value] {
		return names
	}
	seen[n.Value] = true
	names = mxutil.Ensure(names, 1)
	push(names, n.Value)
	return names
}

// extractTypeArgs returns the bare Name nodes of a generic receiver type
// expression like Handle[T] or Ptr[K, V]. It returns them rather than pushing
// them through a callback, which would capture the caller's accumulator.
func extractTypeArgs(e syntax.Expr) (out []string) {
	if e == nil {
		return nil
	}
	switch ev := e.(type) {
	case *syntax.IndexExpr:
		// Handle[T] or Handle[T, U] (ListExpr inside)
		return extractTypeArgs(ev.Index)
	case *syntax.Name:
		out = mxutil.Ensure(out, 1)
		push(out, ev.Value)
		return out
	case *syntax.ListExpr:
		for _, el := range ev.ElemList {
			for _, n := range extractTypeArgs(el) {
				out = mxutil.Ensure(out, 1)
				push(out, n)
			}
		}
		return out
	case *syntax.Operation:
		if ev.Y == nil {
			return extractTypeArgs(ev.X)
		}
	}
	return nil
}
