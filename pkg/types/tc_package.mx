package types

// TCPackage represents a compiled Moxie package.
type TCPackage struct {
	path     string
	name     string
	scope    *Scope
	imports  []*TCPackage
	complete bool
}

func NewTCPackage(path, name string) (t *TCPackage) {
	return &TCPackage{
		path:  path,
		name:  name,
		scope: NewScope(nil),
	}
}

func NewTCPackageWithParent(path, name string, parent *Scope) (t *TCPackage) {
	return &TCPackage{
		path:  path,
		name:  name,
		scope: NewScope(parent),
	}
}

func (p *TCPackage) Path() (s string) { return p.path }
func (p *TCPackage) Name() (s string) { return p.name }
func (p *TCPackage) Scope() (s *Scope) { return p.scope }
func (p *TCPackage) Complete() (ok bool) { return p.complete }
func (p *TCPackage) MarkComplete()   { p.complete = true }
func (p *TCPackage) String() (s string) { return "package " | p.name | " (" | p.path | ")" }

func (p *TCPackage) Imports() (ts []*TCPackage) { return p.imports }
func (p *TCPackage) SetImports(imps []*TCPackage) { p.imports = imps }

func (p *TCPackage) Release() {
	if p.scope != nil {
		p.scope.Release()
		p.scope = nil
	}
	p.imports = nil
}
