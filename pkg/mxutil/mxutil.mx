// ImportSeg is one source file's import block in the concatenated package
// stream, keyed by the concat line its body starts at.
type ImportSeg struct {
	OutStart int32
	Specs    []string
}

// targetConfig holds the mutable build configuration. It is a sovereign
// self-mutating type because SetTarget writes it during a build and package
// globals are immutable outside init(): mutable state must live in a type
// mutated through its methods, not in a bare package variable.
type targetConfig struct {
	os   string
	arch string
	segs []ImportSeg
}

func (c *targetConfig) setTarget(os, arch string) {
	c.os = os
	c.arch = arch
}

func (c *targetConfig) appendSeg(seg ImportSeg) {
	c.segs = Ensure(c.segs, 1)
	push(c.segs, seg)
}

func (c *targetConfig) resetSegs() {
	c.segs = []ImportSeg{:0}
}

// --- -print-allocs site table ---

// allocSiteTable maps the site ids the compiler hands to runtime.logAlloc
// back to the function each one came from.
//
// Like target, it is a package variable of a sovereign self-mutating type.
// The table is filled from inside the IR emitter, whose arena is released
// when the package it belongs to is finished, and read again once every
// package is gone: a plain global slice would be left pointing into a dead
// arena. For the same reason the key and the stored name are rebuilt inside
// the borrowing methods - the caller's copies die with the caller's frame.
type allocSiteTable struct {
	pat   string
	match map[string]bool  // memoised pattern verdict per function: the pattern is a regexp, so re-matching at every site would re-compile it
	seq   map[string]int32 // allocation ordinal within one function, for the name
	names []string         // id -> name, written to <output>.alloc_sites.json
}

func (t *allocSiteTable) reset(pat string) {
	t.pat = copyString(pat)
	t.match = map[string]bool{}
	t.seq = map[string]int32{}
	t.names = []string{:0}
}

// add records fn as an allocation site when the -print-allocs pattern
// matches it. It returns the site id, or -1 when the pattern does not match.
// The match verdict is memoised per function so a pattern is compiled once.
func (t *allocSiteTable) add(fn string) (id int32) {
	key := copyString(fn)
	m, seen := t.match[key]
	if !seen {
		r, _ := mxregexp.Match(t.pat, key)
		t.match[key] = r
		m = r
	}
	if !m {
		return -1
	}
	seq := t.seq[key]
	t.seq[key] = seq + 1
	id = int32(len(t.names))
	t.names = Ensure(t.names, 1)
	// A name is a package path, an identifier and an ordinal, none of which
	// can carry a JSON metacharacter, so it goes into the file verbatim.
	push(t.names, key|"@"|itoa32(seq))
	return id
}

func copyString(s string) (r string) {
	b := []byte{:len(s)}
	copy(b, s)
	return string(b)
}

func itoa32(n int32) (s string) {
	if n == 0 {
		return "0"
	}
	neg := n < 0
	if neg {
		n = -n
	}
	buf := []byte{:0:12}
	for n > 0 {
		buf = Ensure(buf, 1)
		push(buf, byte('0'+n%10))
		n /= 10
	}
	if neg {
		buf = Ensure(buf, 1)
		push(buf, '-')
	}
	for i, j := 0, len(buf)-1; i < j; i, j = i+1, j-1 {
		buf[i], buf[j] = buf[j], buf[i]
	}
	return string(buf)
}

var allocSites allocSiteTable

// ResetAllocSites arms the site table with the -print-allocs pattern and
// reports whether that pattern is one the matcher supports. An empty pattern
// disables instrumentation.
func ResetAllocSites(pat string) (err string) {
	if pat != "" {
		_, err = mxregexp.Match(pat, "")
	}
	allocSites.reset(pat)
	return err
}

// AllocSitesEnabled reports whether -print-allocs is active.
func AllocSitesEnabled() (ok bool) { return len(allocSites.pat) > 0 }

// AllocPattern returns the active -print-allocs pattern, "" when inactive.
func AllocPattern() (s string) { return allocSites.pat }

// AddAllocSite returns the site id for fn, or -1 when the pattern does not
// match it.
func AddAllocSite(fn string) (id int32) { return allocSites.add(fn) }

// AllocSiteCount returns how many sites have been recorded.
func AllocSiteCount() (n int32) { return int32(len(allocSites.names)) }

// AllocSiteName returns the name recorded for a site id.
func AllocSiteName(i int32) (s string) { return allocSites.names[i] }

var target targetConfig

func SetTarget(os, arch string) {
	target.setTarget(os, arch)
}

func TargetOS() (s string) {
	return target.os
}

func TargetArch() (s string) {
	return target.arch
}

func ConcatImportSegs() (segs []ImportSeg) {
	return target.segs
}

// ResetConcatImportSegs drops the per-file import segments of the file set just
// concatenated, so the next package starts from its own. Without this the
// segments accumulate across a build: every package's file scopes were built
// from its own specs plus every earlier package's, so a file could resolve an
// import name it never imported, and the recorded segment line numbers referred
// to another package's text. The reset has to go through the sovereign
// targetConfig, which is why this became a no-op when package globals turned
// immutable - and stayed one until now.
func ResetConcatImportSegs() {
	target.resetSegs()
}

func AppendConcatImportSeg(seg ImportSeg) {
	target.appendSeg(seg)
}

func WriteStr(fd int32, s string) {
	if len(s) > 0 {
		cWrite(fd, unsafe.Pointer(unsafe.SliceData([]byte(s))), uint32(len(s)))
	}
}

func FileExists(path string) (ok bool) {
	if len(path) == 0 {
		return false
	}
	pp := unsafe.Pointer(unsafe.SliceData([]byte(path)))
	pl := int32(len(path))
	return cFilesize(pp, pl) >= 0
}

func ReadFile(path string) (data []byte, ok bool) {
	if len(path) == 0 {
		return nil, false
	}
	pp := unsafe.Pointer(unsafe.SliceData([]byte(path)))
	pl := int32(len(path))
	sz := cFilesize(pp, pl)
	if sz < 0 {
		return nil, false
	}
	if sz == 0 {
		sz = 65536
	}
	buf := []byte{:sz}
	n := cReadfile(pp, pl,
		unsafe.Pointer(unsafe.SliceData(buf)), sz)
	if n < 0 {
		return nil, false
	}
	return buf[:n], true
}

func WriteFile(path string, data []byte, mode uint32) {
	if len(path) == 0 {
		return
	}
	cWritefile(unsafe.Pointer(unsafe.SliceData([]byte(path))), int32(len(path)),
		unsafe.Pointer(unsafe.SliceData(data)), int32(len(data)), mode)
}

func MkdirAll(path string, mode uint32) {
	if len(path) == 0 {
		return
	}
	cMkdir(unsafe.Pointer(unsafe.SliceData([]byte(path))), int32(len(path)), mode)
}

func Getenv(name string) (s string) {
	buf := []byte{:4096}
	n := cGetenv(unsafe.Pointer(unsafe.SliceData([]byte(name))), int32(len(name)), unsafe.Pointer(unsafe.SliceData(buf)), int32(len(buf)))
	if n <= 0 {
		return ""
	}
	return string(buf[:n])
}

// Setenv sets name=val in this process's environment. A child forked later
// inherits it, which is how the test harness points an instrumented run's
// counters at a file it can read back. An empty val still sets the variable
// (to the empty string); callers that mean "unset" pass an empty val and treat
// it as such.
func Setenv(name, val string) (ok bool) {
	// NUL-terminate both: setenv takes C strings, and a Moxie slice is not
	// terminated just because it was built from a literal.
	nb := []byte{:len(name) + 1}
	for i := int32(0); i < int32(len(name)); i++ {
		nb[i] = name[i]
	}
	vb := []byte{:len(val) + 1}
	for i := int32(0); i < int32(len(val)); i++ {
		vb[i] = val[i]
	}
	return cSetenv(unsafe.Pointer(unsafe.SliceData(nb)), unsafe.Pointer(unsafe.SliceData(vb)), 1) == 0
}

//export setenv
func cSetenv(name unsafe.Pointer, val unsafe.Pointer, replace int32) (r0 int32)

//export malloc
func cMalloc(size int32) (r0 unsafe.Pointer)

//export free
func cFree(ptr unsafe.Pointer)

func ListFiles(dir, ext string) (ss []string) {
	buf := []byte{:65536}
	n := cListdir(unsafe.Pointer(unsafe.SliceData([]byte(dir))), int32(len(dir)),
		unsafe.Pointer(unsafe.SliceData(buf)), int32(len(buf)))
	if n <= 0 {
		return nil
	}
	names := []string{:256}
	start := int32(0)
	ni := int32(0)
	for i := int32(0); i < n; i++ {
		if buf[i] == 0 {
			if HasSuffix(string(buf[start:i]), ext) {
				names[ni] = string(buf[start:i])
				ni = ni + 1
			}
			start = i + 1
		}
	}
	if ni == 0 {
		return nil
	}
	total := ni
	result := []string{:total}
	for j := int32(0); j < total; j = j + 1 {
		result[j] = names[j]
	}
	return result
}

func SplitLines(s string) (ss []string) {
	var result []string
	start := int32(0)
	for i := int32(0); i < int32(len(s)); i++ {
		if s[i] == '\n' {
			if i > start {
				result = Ensure(result, 1)
				push(result, s[start:i])
			}
			start = i + 1
		}
	}
	if start < int32(len(s)) {
		result = Ensure(result, 1)
		push(result, s[start:])
	}
	return result
}

func HasPrefix(s, prefix string) (ok bool) {
	return len(s) >= len(prefix) && s[:len(prefix)] == prefix
}

func HasSuffix(s, suffix string) (ok bool) {
	return len(s) >= len(suffix) && s[len(s)-len(suffix):] == suffix
}

func TrimSpace(s string) (sv string) {
	i := int32(0)
	for i < int32(len(s)) && (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r') {
		i++
	}
	j := int32(len(s))
	for j > i && (s[j-1] == ' ' || s[j-1] == '\t' || s[j-1] == '\n' || s[j-1] == '\r') {
		j--
	}
	return s[i:j]
}

func JoinPath(a, b string) (s string) {
	if len(a) == 0 {
		return b
	}
	if a[len(a)-1] == '/' {
		return a | b
	}
	return a | "/" | b
}

func PathBase(path string) (s string) {
	for i := int32(len(path)) - 1; i >= 0; i-- {
		if path[i] == '/' {
			return path[i+1:]
		}
	}
	return path
}

func PathDir(path string) (s string) {
	for i := int32(len(path)) - 1; i >= 0; i-- {
		if path[i] == '/' {
			if i == 0 {
				return "/"
			}
			return path[:i]
		}
	}
	return "."
}

func SplitSlash(s string) (ss []string) {
	var parts []string
	start := int32(0)
	for i := int32(0); i < int32(len(s)); i++ {
		if s[i] == '/' {
			parts = Ensure(parts, 1)
			push(parts, s[start:i])
			start = i + 1
		}
	}
	parts = Ensure(parts, 1)
	push(parts, s[start:])
	return parts
}

func CleanPath(path string) (s string) {
	parts := SplitSlash(path)
	var out []string
	for _, p := range parts {
		if p == "." || p == "" {
			continue
		}
		if p == ".." && len(out) > 0 && out[len(out)-1] != ".." {
			out = out[:len(out)-1]
		} else {
			out = Ensure(out, 1)
			push(out, p)
		}
	}
	if len(out) == 0 {
		return "."
	}
	result := out[0]
	for i := 1; i < len(out); i++ {
		result = result | "/" | out[i]
	}
	if len(path) > 0 && path[0] == '/' {
		result = "/" | result
	}
	return result
}

func JoinStrings(ss []string, sep string) (s string) {
	if len(ss) == 0 {
		return ""
	}
	n := int32(0)
	for _, vs := range ss {
		n += int32(len(vs))
	}
	n += int32(len(sep)) * (int32(len(ss)) - 1)
	buf := []byte{:0:n}
	for i, sv := range ss {
		if i > 0 {
			buf = Ensure(buf, 1)
			push(buf, sep...)
		}
		buf = Ensure(buf, 1)
		push(buf, sv...)
	}
	return string(buf)
}

func AppendUniq(ss []string, s string) (ss2 []string) {
	for _, x := range ss {
		if x == s {
			return ss
		}
	}
	ss = Ensure(ss, 1)
	push(ss, s)
	return ss
}

func SplitBySpace(s string) (ss []string) {
	var result []string
	start := int32(0)
	inWord := false
	for i := int32(0); i < int32(len(s)); i++ {
		if s[i] == ' ' || s[i] == '\t' {
			if inWord {
				result = Ensure(result, 1)
				push(result, s[start:i])
				inWord = false
			}
		} else {
			if !inWord {
				start = i
				inWord = true
			}
		}
	}
	if inWord {
		result = Ensure(result, 1)
		push(result, s[start:])
	}
	return result
}

func SafeName(pkg string) (s string) {
	b := []byte{:len(pkg)}
	for i := int32(0); i < int32(len(pkg)); i++ {
		if pkg[i] == '/' {
			b[i] = '_'
		} else {
			b[i] = pkg[i]
		}
	}
	return string(b)
}

func SimpleItoa(n int32) (s string) {
	if n == 0 {
		return "0"
	}
	neg := false
	if n < 0 {
		neg = true
		n = -n
	}
	buf := []byte{:20}
	i := int32(19)
	for n > 0 {
		buf[i] = byte(n%10) + '0'
		n /= 10
		i--
	}
	if neg {
		buf[i] = '-'
		i--
	}
	return string(buf[i+1:])
}

func SimpleItoa64(n int64) (s string) {
	if n == 0 {
		return "0"
	}
	neg := false
	if n < 0 {
		neg = true
		n = -n
	}
	buf := []byte{:20}
	i := int32(19)
	for n > 0 {
		buf[i] = byte(n%10) + '0'
		n /= 10
		i--
	}
	if neg {
		buf[i] = '-'
		i--
	}
	return string(buf[i+1:])
}

func ParseInt64(s string) (n int64) {
	for i := int32(0); i < int32(len(s)); i++ {
		c := s[i]
		if c < '0' || c > '9' {
			break
		}
		n = n*10 + int64(c-'0')
	}
	return n
}

func FnvHash(data []byte) (s string) {
	h := uint32(2166136261)
	for i := int32(0); i < int32(len(data)); i++ {
		h ^= uint32(data[i])
		h *= uint32(16777619)
	}
	hex := "0123456789abcdef"
	buf := []byte{:8}
	for i := int32(7); i >= 0; i-- {
		buf[i] = hex[h&0xf]
		h >>= 4
	}
	return string(buf)
}

func FileContainsPart(base string, part string) (ok bool) {
	plen := len(part)
	for i := 0; i <= len(base)-plen; i++ {
		if base[i:i+plen] == part {
			before := i == 0 || base[i-1] == '_'
			after := i+plen == len(base) || base[i+plen] == '_'
			if before && after {
				return true
			}
		}
	}
	return false
}

func ExtractQuoted(s string) (sv string) {
	start := int32(-1)
	for i := int32(0); i < int32(len(s)); i++ {
		if s[i] == '"' {
			if start < 0 {
				start = i + 1
			} else {
				return s[start:i]
			}
		}
	}
	return ""
}

func IsRemotePath(path string) (ok bool) {
	slash := int32(-1)
	for i := int32(0); i < int32(len(path)); i++ {
		if path[i] == '/' {
			slash = i
			break
		}
	}
	if slash < 0 {
		return false
	}
	host := path[:slash]
	for i := int32(0); i < int32(len(host)); i++ {
		if host[i] == '.' {
			return true
		}
	}
	return false
}

// GrowCap returns s with capacity at least len(s)+1, doubling (min 16)
// when full. Explicit growth only - no automatic grow. Old backing
// arrays are left to the arena.
// Ensure returns s with at least n spare elements of capacity, growing
// geometrically when it must. push does not grow and its bound check fails
// loud, so a spread push needs Ensure(s, len(src)): the older
// `if len(s) >= cap(s) { GrowCap(s) }` idiom only reserves ONE element and
// panics for any longer spread.
func Ensure[T comparable](s []T, n int32) (r0 []T) {
	if n <= 0 || cap(s)-len(s) >= n {
		return s
	}
	nc := cap(s) * 2
	if nc < 16 {
		nc = 16
	}
	for nc-len(s) < n {
		nc = nc * 2
	}
	nb := []T{:0:nc}
	copy(nb[:len(s)], s)
	return nb[:len(s)]
}

// Reserve returns s with capacity for at least total elements, allocating
// exactly that much when it has to grow. Use it when the final size is known:
// unlike Ensure it leaves no doubling slack, and an arena is never reused
// within a frame, so slack is spent space rather than spare space.
func Reserve[T comparable](s []T, total int32) (r0 []T) {
	if total <= cap(s) {
		return s
	}
	nb := []T{:0:total}
	copy(nb[:len(s)], s)
	return nb[:len(s)]
}

func GrowCap[T comparable](s []T) (r0 []T) {
	if len(s) < cap(s) {
		return s
	}
	nc := cap(s) * 2
	if nc < 16 {
		nc = 16
	}
	nb := []T{:0:nc}
	copy(nb[:len(s)], s)
	return nb[:len(s)]
}
