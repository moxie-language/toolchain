package mxutil

import "unsafe"

//export write
func cWrite(fd int32, buf unsafe.Pointer, count uint32) (n int32)

//export mxc_readfile
func cReadfile(path unsafe.Pointer, pathLen int32, buf unsafe.Pointer, bufCap int32) (n int32)

//export mxc_filesize
func cFilesize(path unsafe.Pointer, pathLen int32) (n int32)

//export mxc_getenv
func cGetenv(name unsafe.Pointer, nameLen int32, buf unsafe.Pointer, bufCap int32) (n int32)

//export mxc_listdir
func cListdir(dir unsafe.Pointer, dirLen int32, buf unsafe.Pointer, bufCap int32) (n int32)

//export mxc_writefile
func cWritefile(path unsafe.Pointer, pathLen int32, data unsafe.Pointer, dataLen int32, mode uint32) (n int32)

//export mxc_mkdir
func cMkdir(path unsafe.Pointer, pathLen int32, mode uint32) (n int32)

var TargetOS string
var TargetArch string

type ImportSeg struct {
	OutStart int32
	Specs    []string
}

var ConcatImportSegs []ImportSeg

func SetTarget(os, arch string) {
	TargetOS = os
	TargetArch = arch
}

func ResetConcatImportSegs() {
}

func AppendConcatImportSeg(seg ImportSeg) {
	if len(ConcatImportSegs) >= cap(ConcatImportSegs) { ConcatImportSegs = GrowCap(ConcatImportSegs) }
	push(ConcatImportSegs, seg)
}

func WriteStr(fd int32, s string) {
	if len(s) > 0 {
		cWrite(fd, unsafe.Pointer(unsafe.SliceData([]byte(s))), uint32(len(s)))
	}
}

func FileExists(path string) (ok bool) {
	if len(path) == 0 {
		return false
	}
	pp := unsafe.Pointer(unsafe.SliceData([]byte(path)))
	pl := int32(len(path))
	return cFilesize(pp, pl) >= 0
}

func ReadFile(path string) (data []byte, ok bool) {
	if len(path) == 0 {
		return nil, false
	}
	pp := unsafe.Pointer(unsafe.SliceData([]byte(path)))
	pl := int32(len(path))
	sz := cFilesize(pp, pl)
	if sz < 0 {
		return nil, false
	}
	if sz == 0 {
		sz = 65536
	}
	buf := []byte{:sz}
	n := cReadfile(pp, pl,
		unsafe.Pointer(unsafe.SliceData(buf)), sz)
	if n < 0 {
		return nil, false
	}
	return buf[:n], true
}

func WriteFile(path string, data []byte, mode uint32) {
	if len(path) == 0 {
		return
	}
	cWritefile(unsafe.Pointer(unsafe.SliceData([]byte(path))), int32(len(path)),
		unsafe.Pointer(unsafe.SliceData(data)), int32(len(data)), mode)
}

func MkdirAll(path string, mode uint32) {
	if len(path) == 0 {
		return
	}
	cMkdir(unsafe.Pointer(unsafe.SliceData([]byte(path))), int32(len(path)), mode)
}

func Getenv(name string) (s string) {
	buf := []byte{:4096}
	n := cGetenv(unsafe.Pointer(unsafe.SliceData([]byte(name))), int32(len(name)), unsafe.Pointer(unsafe.SliceData(buf)), int32(len(buf)))
	if n <= 0 {
		return ""
	}
	return string(buf[:n])
}

//export malloc
func cMalloc(size int32) (r0 unsafe.Pointer)

//export free
func cFree(ptr unsafe.Pointer)

func ListFiles(dir, ext string) (ss []string) {
	buf := []byte{:65536}
	n := cListdir(unsafe.Pointer(unsafe.SliceData([]byte(dir))), int32(len(dir)),
		unsafe.Pointer(unsafe.SliceData(buf)), int32(len(buf)))
	if n <= 0 {
		return nil
	}
	names := []string{:256}
	start := int32(0)
	ni := int32(0)
	for i := int32(0); i < n; i++ {
		if buf[i] == 0 {
			if HasSuffix(string(buf[start:i]), ext) {
				names[ni] = string(buf[start:i])
				ni = ni + 1
			}
			start = i + 1
		}
	}
	if ni == 0 {
		return nil
	}
	total := ni
	result := []string{:total}
	for j := int32(0); j < total; j = j + 1 {
		result[j] = names[j]
	}
	return result
}

func SplitLines(s string) (ss []string) {
	var result []string
	start := int32(0)
	for i := int32(0); i < int32(len(s)); i++ {
		if s[i] == '\n' {
			if i > start {
				if len(result) >= cap(result) { result = GrowCap(result) }
				push(result, s[start:i])
			}
			start = i + 1
		}
	}
	if start < int32(len(s)) {
		if len(result) >= cap(result) { result = GrowCap(result) }
		push(result, s[start:])
	}
	return result
}

func HasPrefix(s, prefix string) (ok bool) {
	return len(s) >= len(prefix) && s[:len(prefix)] == prefix
}

func HasSuffix(s, suffix string) (ok bool) {
	return len(s) >= len(suffix) && s[len(s)-len(suffix):] == suffix
}

func TrimSpace(s string) (sv string) {
	i := int32(0)
	for i < int32(len(s)) && (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r') {
		i++
	}
	j := int32(len(s))
	for j > i && (s[j-1] == ' ' || s[j-1] == '\t' || s[j-1] == '\n' || s[j-1] == '\r') {
		j--
	}
	return s[i:j]
}

func JoinPath(a, b string) (s string) {
	if len(a) == 0 {
		return b
	}
	if a[len(a)-1] == '/' {
		return a | b
	}
	return a | "/" | b
}

func PathBase(path string) (s string) {
	for i := int32(len(path)) - 1; i >= 0; i-- {
		if path[i] == '/' {
			return path[i+1:]
		}
	}
	return path
}

func PathDir(path string) (s string) {
	for i := int32(len(path)) - 1; i >= 0; i-- {
		if path[i] == '/' {
			if i == 0 {
				return "/"
			}
			return path[:i]
		}
	}
	return "."
}

func SplitSlash(s string) (ss []string) {
	var parts []string
	start := int32(0)
	for i := int32(0); i < int32(len(s)); i++ {
		if s[i] == '/' {
			if len(parts) >= cap(parts) { parts = GrowCap(parts) }
			push(parts, s[start:i])
			start = i + 1
		}
	}
	if len(parts) >= cap(parts) { parts = GrowCap(parts) }
	push(parts, s[start:])
	return parts
}

func CleanPath(path string) (s string) {
	parts := SplitSlash(path)
	var out []string
	for _, p := range parts {
		if p == "." || p == "" {
			continue
		}
		if p == ".." && len(out) > 0 && out[len(out)-1] != ".." {
			out = out[:len(out)-1]
		} else {
			if len(out) >= cap(out) { out = GrowCap(out) }
			push(out, p)
		}
	}
	if len(out) == 0 {
		return "."
	}
	result := out[0]
	for i := 1; i < len(out); i++ {
		result = result | "/" | out[i]
	}
	if len(path) > 0 && path[0] == '/' {
		result = "/" | result
	}
	return result
}

func JoinStrings(ss []string, sep string) (s string) {
	if len(ss) == 0 {
		return ""
	}
	n := int32(0)
	for _, vs := range ss {
		n += int32(len(vs))
	}
	n += int32(len(sep)) * (int32(len(ss)) - 1)
	buf := []byte{:0:n}
	for i, sv := range ss {
		if i > 0 {
			if len(buf) >= cap(buf) { buf = GrowCap(buf) }
			push(buf, sep...)
		}
		if len(buf) >= cap(buf) { buf = GrowCap(buf) }
		push(buf, sv...)
	}
	return string(buf)
}

func AppendUniq(ss []string, s string) (ss2 []string) {
	for _, x := range ss {
		if x == s {
			return ss
		}
	}
	if len(ss) >= cap(ss) { ss = GrowCap(ss) }
	push(ss, s)
	return ss
}

func SplitBySpace(s string) (ss []string) {
	var result []string
	start := int32(0)
	inWord := false
	for i := int32(0); i < int32(len(s)); i++ {
		if s[i] == ' ' || s[i] == '\t' {
			if inWord {
				if len(result) >= cap(result) { result = GrowCap(result) }
				push(result, s[start:i])
				inWord = false
			}
		} else {
			if !inWord {
				start = i
				inWord = true
			}
		}
	}
	if inWord {
		if len(result) >= cap(result) { result = GrowCap(result) }
		push(result, s[start:])
	}
	return result
}

func SafeName(pkg string) (s string) {
	b := []byte{:len(pkg)}
	for i := int32(0); i < int32(len(pkg)); i++ {
		if pkg[i] == '/' {
			b[i] = '_'
		} else {
			b[i] = pkg[i]
		}
	}
	return string(b)
}

func SimpleItoa(n int32) (s string) {
	if n == 0 {
		return "0"
	}
	neg := false
	if n < 0 {
		neg = true
		n = -n
	}
	buf := []byte{:20}
	i := int32(19)
	for n > 0 {
		buf[i] = byte(n%10) + '0'
		n /= 10
		i--
	}
	if neg {
		buf[i] = '-'
		i--
	}
	return string(buf[i+1:])
}

func SimpleItoa64(n int64) (s string) {
	if n == 0 {
		return "0"
	}
	neg := false
	if n < 0 {
		neg = true
		n = -n
	}
	buf := []byte{:20}
	i := int32(19)
	for n > 0 {
		buf[i] = byte(n%10) + '0'
		n /= 10
		i--
	}
	if neg {
		buf[i] = '-'
		i--
	}
	return string(buf[i+1:])
}

func ParseInt64(s string) (n int64) {
	for i := int32(0); i < int32(len(s)); i++ {
		c := s[i]
		if c < '0' || c > '9' {
			break
		}
		n = n*10 + int64(c-'0')
	}
	return n
}

func FnvHash(data []byte) (s string) {
	h := uint32(2166136261)
	for i := int32(0); i < int32(len(data)); i++ {
		h ^= uint32(data[i])
		h *= uint32(16777619)
	}
	hex := "0123456789abcdef"
	buf := []byte{:8}
	for i := int32(7); i >= 0; i-- {
		buf[i] = hex[h&0xf]
		h >>= 4
	}
	return string(buf)
}

func FileContainsPart(base string, part string) (ok bool) {
	plen := len(part)
	for i := 0; i <= len(base)-plen; i++ {
		if base[i:i+plen] == part {
			before := i == 0 || base[i-1] == '_'
			after := i+plen == len(base) || base[i+plen] == '_'
			if before && after {
				return true
			}
		}
	}
	return false
}

func ExtractQuoted(s string) (sv string) {
	start := int32(-1)
	for i := int32(0); i < int32(len(s)); i++ {
		if s[i] == '"' {
			if start < 0 {
				start = i + 1
			} else {
				return s[start:i]
			}
		}
	}
	return ""
}

func IsRemotePath(path string) (ok bool) {
	slash := int32(-1)
	for i := int32(0); i < int32(len(path)); i++ {
		if path[i] == '/' {
			slash = i
			break
		}
	}
	if slash < 0 {
		return false
	}
	host := path[:slash]
	for i := int32(0); i < int32(len(host)); i++ {
		if host[i] == '.' {
			return true
		}
	}
	return false
}

// GrowCap returns s with capacity at least len(s)+1, doubling (min 16)
// when full. Explicit growth only - no automatic grow. Old backing
// arrays are left to the arena.
func GrowCap[T any](s []T) (r0 []T) {
	if len(s) < cap(s) {
		return s
	}
	nc := cap(s) * 2
	if nc < 16 {
		nc = 16
	}
	nb := []T{:0:nc}
	copy(nb[:len(s)], s)
	return nb[:len(s)]
}
