package mxh

import "git.smesh.lol/moxie/pkg/types"

func TypeDescStr(t types.Type) (s string) {
	if t == nil { return "interface{}" }
	switch v := t.(type) {
	case *types.Basic:
		switch v.Kind {
		case types.TCString: return "string"
		case types.Int32: return "int32"
		case types.Int64: return "int64"
		default: return "basic"
		}
	case *types.Pointer:
		return "*" | TypeDescStr(v.Elem())
	case *types.Named:
		if v.Obj != nil { return v.Obj.Name }
		return "named"
	}
	return "?"
}
