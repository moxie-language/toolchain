package main

func main() {
	// Test free on pointer
	p := &[4]int32{1, 2, 3, 4}
	_ = p[0]
	free(p)

	// Test free on slice
	s := []int32{:0:8}
	s = append(s, 10, 20, 30)
	println("len:", len(s))
	free(s)

	// Test free on string (same as []byte in Moxie)
	buf := []byte{:32}
	buf[0] = 'A'
	free(buf)

	// Test free(nil) is safe
	var np *int32
	free(np)

	// Test slice append grow (exercises sliceGrow free)
	big := []int32{:0:4}
	for i := int32(0); i < 1000; i++ {
		big = append(big, i)
	}
	println("big len:", len(big))
	free(big)

	// Test map operations (exercises hashmap free)
	m := map[int32]int32{}
	for i := int32(0); i < 100; i++ {
		m[i] = i * i
	}
	for i := int32(0); i < 100; i++ {
		delete(m, i)
	}
	println("map len:", len(m))

	println("ok")
}
