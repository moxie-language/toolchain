package main

import "fmt"

func main() {
	fmt.Printf("UntypedNil = %d\n", int32(UntypedNil))
	fmt.Printf("UntypedNil + 1 = %d\n", int32(UntypedNil+1))
	fmt.Printf("Bool = %d\n", int32(Bool))
	fmt.Printf("Int32 = %d\n", int32(Int32))
	fmt.Printf("TCString = %d\n", int32(TCString))
	fmt.Printf("UnsafePointer = %d\n", int32(UnsafePointer))
	fmt.Printf("UntypedBool = %d\n", int32(UntypedBool))
}
