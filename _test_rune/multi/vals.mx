package main

func runeA() int32    { return int32('a') }
func runeB() int32    { return int32('b') }
func runeZ() int32    { return int32('z') }
func rune0() int32    { return int32('0') }
func rune9() int32    { return int32('9') }
func runeAU() int32   { return int32('A') }
func runeZU() int32   { return int32('Z') }
func runeSP() int32   { return int32(' ') }
func runeNL() int32   { return int32('\n') }
func runeTab() int32  { return int32('\t') }
func runeSQ() int32   { return int32('\'') }
func runeDQ() int32   { return int32('"') }
